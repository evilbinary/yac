/* tests/compiler/run.yac — 编译器逐阶段 IR 回归（strict per-stage tests）。
 *
 * 管线每一阶段的 IR / 步骤都在这里被单独断言（全部经真实 yc CLI，因此也
 * 同时覆盖参数解析与各阶段 dump 通道）：
 *
 *   lex    source -> tokens            yc --dump-lex
 *   parse  tokens -> AST               yc --ast
 *   anf    AST    -> ANF               yc --dump-anf
 *   cps    ANF    -> CPS               yc --dump-cps
 *   opt    CPS    -> CPS（--opt 化简）   yc --opt --dump-cps
 *   uncps  CPS    -> ANF               yc --dump-uncps
 *   lir    ANF    -> LIR 指令            yc --dump-lir（顶层项 + 本单元 proc）
 *   lower  ANF -> LIR -> 机器码 -> 可执行  yc -o out; 运行
 *   pack   机器码 -> ELF/PE/Mach-O/yjit  yc --format … -o out; 查首字节
 *
 * 用例输入与期望都放在对应步骤目录：
 *   tests/compiler/<stage>/<name>.yac        输入源程序
 *   tests/compiler/<stage>/<name>.expected   该阶段 IR 的 golden dump
 * lower / pack 的期望写在下方表格里（退出码 / 镜像魔术）。
 *
 * 用法（cwd = 仓库根）：
 *   ./stage_tests                 # 全跑，yc 默认 ./yc
 *   ./stage_tests ./yc            # 指定 yc 路径
 *   ./stage_tests ./yc lir        # 只跑一个阶段（lex…lir/lower/pack）
 *   ./stage_tests --bless         # 用当前 yc 重新记录 IR golden
 *
 * 本文件不 import 任何包：只用内建原语，便于在任何自举阶段编译运行。
 */

let TMP = "build/test_tmp"
let DIR = "tests/compiler/"
let PKG = ["--pkg", "src-self"]

let sh_quote(s) = str_cat("'", str_cat(s, "'"))

let join_cmd(xs) =
  let rec(i, acc) =
    if i >= len(xs) then acc
    else if i == 0 then rec(1, sh_quote(nth(xs, 0)))
    else rec(i + 1, str_cat(acc, str_cat(" ", sh_quote(nth(xs, i))))) in
  rec(0, "")

/* 运行 argv，返回 [rc, stdout, stderr]。 */
let run(argv) =
  let cmd = join_cmd(argv) in
  let tag = int_to_str(time_ns()) in
  let outp = str_cat(TMP, str_cat("/scout.", tag)) in
  let errp = str_cat(TMP, str_cat("/scerr.", tag)) in
  let full = str_cat(cmd, str_cat(" >", str_cat(outp, str_cat(" 2>", errp)))) in
  let rc = system(full) in
  let out = read_file(outp) in
  let err = read_file(errp) in
  let o2 = if out == 0 then "" else out in
  let e2 = if err == 0 then "" else err in
  [rc, o2, e2]

let exists(p) = nth(run(["test", "-f", p]), 0) == 0

/* yc 在 Windows/PE 下会给可执行产物补 .exe；直接探测两种名字。 */
let find_bin(p) = if exists(p) then p else str_cat(p, ".exe")

let strip_cr(s) =
  let b = bytes_new() in
  let rec(i) =
    if i >= str_len(s) then bytes_to_str(b)
    else
      let c = str_ref(s, i) in
      let _ = if c == 13 then 0 else bytes_append(b, c) in
      rec(i + 1) in
  rec(0)

let trim_ws(s, j) =
  if j <= 0 then 0
  else
    let c = str_ref(s, j - 1) in
    if c == 10 then trim_ws(s, j - 1)
    else if c == 13 then trim_ws(s, j - 1)
    else if c == 32 then trim_ws(s, j - 1)
    else if c == 9 then trim_ws(s, j - 1)
    else j

/* NUL 截断 + 去 CR + 去首尾空白。 */
let chomp(s) =
  let n = str_len(s) in
  let rec(i) =
    if i >= n then n
    else if str_ref(s, i) == 0 then i
    else rec(i + 1) in
  let m = rec(0) in
  let t = strip_cr(if m == n then s else str_slice(s, 0, m)) in
  str_slice(t, 0, trim_ws(t, str_len(t)))

let contains(s, sub) =
  let n = str_len(s) in
  let m = str_len(sub) in
  let rec(i) =
    if i + m > n then false
    else if str_slice(s, i, m) == sub then true
    else rec(i + 1) in
  if m == 0 then true
  else if m > n then false
  else rec(0)

let banner(sub, tool) =
  let _ = print("") in
  print(str_cat("=== ", str_cat(sub, str_cat("  ", str_cat(tool, " ====")))))

let check(st, name, want, got) =
  let pass = nth(st, 0) in
  let fail = nth(st, 1) in
  if want == got then
    let _ = print(str_cat("PASS: ", name)) in
    [pass + 1, fail]
  else
    let _ = print(str_cat("FAIL: ", name)) in
    let _ = print(str_cat("  expected: ", want)) in
    let _ = print(str_cat("  actual:   ", got)) in
    [pass, fail + 1]

let suite_done(st) =
  let _ = print("") in
  let _ = print(str_cat(int_to_str(nth(st, 0)),
                 str_cat(" passed, ",
                   str_cat(int_to_str(nth(st, 1)), " failed")))) in
  if nth(st, 1) == 0 then 0 else exit(1)

let case_src(stage, name) =
  str_cat(DIR, str_cat(stage, str_cat("/", str_cat(name, ".yac"))))
let case_gold(stage, name) =
  str_cat(DIR, str_cat(stage, str_cat("/", str_cat(name, ".expected"))))

/* ---- 阶段 -> yc 参数 / 用例表 ---- */

let stage_args(stage) =
  if stage == "lex" then ["--dump-lex"]
  else if stage == "parse" then ["--ast"]
  else if stage == "anf" then ["--dump-anf"]
  else if stage == "cps" then ["--dump-cps"]
  else if stage == "opt" then ["--opt", "--dump-cps"]
  else if stage == "uncps" then ["--dump-uncps"]
  else if stage == "lir" then ["--dump-lir"]
  else []

let stage_cases(stage) =
  if stage == "lex" then
    ["let_bind", "arith", "lambda", "if_else", "comments"]
  else if stage == "parse" then
    ["int", "precedence", "unary_minus", "call_args", "let_fun"]
  else if stage == "anf" then
    ["binop", "if", "call", "lambda", "rec"]
  else if stage == "cps" then
    ["add", "prec", "letfun", "if"]
  else if stage == "opt" then
    ["fold_add", "fold_mul", "fold_sub"]
  else if stage == "uncps" then
    ["add", "letfun", "callcc_err"]
  else if stage == "lir" then
    ["literal", "addition", "precedence", "if_true", "if_var", "let_bind",
     "prim_call", "rt_call", "unary_minus"]
  else []

let all_stages(_) = ["lex", "parse", "anf", "cps", "opt", "uncps", "lir"]

let is_stage(s) = len(stage_cases(s)) > 0

let pick_stages(filt) =
  let xs = all_stages(0) in
  if filt == "" then xs
  else
    let rec(i, n, acc) =
      if i >= n then list_rev(acc)
      else if nth(xs, i) == filt then list_rev(cons(nth(xs, i), acc))
      else rec(i + 1, n, acc) in
    rec(0, len(xs), [])

/* ---- IR 阶段：yc dump 与 golden 逐字符比对 ---- */

let dump_case(st, yc, stage, name, bless) =
  let argv = append(yc, append(PKG,
               append(stage_args(stage), [case_src(stage, name)]))) in
  let r = run(argv) in
  let rc = nth(r, 0) in
  let got = chomp(nth(r, 1)) in
  let tag = str_cat(stage, str_cat(" ", name)) in
  if bless then
    if rc == 0 then
      let _ = write_file(case_gold(stage, name), str_cat(got, "\n")) in
      check(st, tag, "blessed", "blessed")
    else
      check(st, tag, "dump rc 0", str_cat("rc=", int_to_str(rc)))
  else
    let w = read_file(case_gold(stage, name)) in
    if w == 0 then
      check(st, tag, "golden (run --bless)", "missing")
    else if rc != 0 and got == "" then
      check(st, tag, "rc 0", str_cat("rc=", int_to_str(rc)))
    else
      check(st, tag, chomp(w), got)

let stage_all(st, yc, stage, bless) =
  let _ = banner(str_cat("compiler/", stage), nth(yc, 0)) in
  foldl(fun(s, n) -> dump_case(s, yc, stage, n, bless), st, stage_cases(stage))

let front_all(st, yc, filt, bless) =
  foldl(fun(s, g) -> stage_all(s, yc, g, bless), st, pick_stages(filt))

/* ---- lower：编译 -> 运行，比退出码 ---- */

let lower_cases(_) = [
  ["lit42", "rc", "42"],
  ["arith", "rc", "5"],
  ["if_else", "rc", "40"],
  ["fact", "rc", "120"], ["capture_shadow", "rc", "17"],
  /* capRef 回归（见各用例头注释）*/
  ["cap_selfrec", "rc", "300"],
  ["cap_cross_scope", "rc", "25"],
  ["cap_captured_closure", "rc", "42"],
  ["cap_args6_obj", "rc", "31"],
  ["cap_chain3", "rc", "17"]
]

let lower_one(st, yc, c) =
  let name = nth(c, 0) in
  let kind = nth(c, 1) in
  let want = nth(c, 2) in
  let bin = str_cat(TMP, str_cat("/lower_", name)) in
  let cr = run(append(append(yc, [case_src("lower", name)]),
                      append(PKG, ["-o", bin]))) in
  let b = find_bin(bin) in
  if exists(b) == false then
    check(st, str_cat("lower ", name), "wrote binary",
          str_cat("compile rc=", int_to_str(nth(cr, 0))))
  else
    let _ = run(["chmod", "+x", b]) in
    let r = run([b]) in
    if kind == "rc" then
      check(st, str_cat("lower ", name), want, int_to_str(nth(r, 0)))
    else check(st, str_cat("lower ", name), want, chomp(nth(r, 1)))

let lower_all(st, yc) =
  let _ = banner("compiler/lower", nth(yc, 0)) in
  foldl(fun(s, c) -> lower_one(s, yc, c), st, lower_cases(0))

/* ---- negative：必须被编译器拒绝的源 ---- */

let negative_cases(_) = [
  ["dup_def", "rejected"]
]

let negative_one(st, yc, c) =
  let name = nth(c, 0) in
  let want = nth(c, 1) in
  let bin = str_cat(TMP, str_cat("/neg_", name)) in
  let cr = run(append(append(yc, [case_src("lower", name)]),
                      append(PKG, ["-o", bin]))) in
  let rc = nth(cr, 0) in
  check(st, str_cat("neg ", name), want,
        if rc == 0 then "compiled (should have failed)" else "rejected")

let negative_all(st, yc) =
  let _ = banner("compiler/negative", nth(yc, 0)) in
  foldl(fun(s, c) -> negative_one(s, yc, c), st, negative_cases(0))

/* ---- pack：镜像头魔术字节 ---- */

let pack_cases(_) = [
  ["elf", ["--format", "elf", "--arch", "x86_64"], [127, 69, 76, 70]],
  ["pe", ["--format", "pe", "--arch", "x86_64"], [77, 90]],
  ["macho", ["--format", "macho", "--arch", "x86_64"], [207, 250]],
  ["yjit", ["--format", "yjit", "--arch", "x86_64"], [89, 74, 73, 84]]
]

let head_matches(b, want, i, n) =
  if i >= n then true
  else if str_len(b) <= i then false
  else if str_ref(b, i) != nth(want, i) then false
  else head_matches(b, want, i + 1, n)

let head_str(b, i, n, acc) =
  if i >= n then acc
  else if str_len(b) <= i then acc
  else
    let sep = if i == 0 then "" else " " in
    head_str(b, i + 1, n,
      str_cat(acc, str_cat(sep, int_to_str(str_ref(b, i)))))

let pack_one(st, yc, c) =
  let name = nth(c, 0) in
  let flags = nth(c, 1) in
  let want = nth(c, 2) in
  let out = str_cat(TMP, str_cat("/pack_", name)) in
  let _ = run(append(append(yc, [case_src("pack", name)]),
                     append(PKG, append(flags, ["-o", out])))) in
  let b = read_file(find_bin(out)) in
  if b == 0 then
    check(st, str_cat("pack ", name), "wrote image", "missing")
  else
    check(st, str_cat("pack ", name), "magic ok",
          if head_matches(b, want, 0, len(want)) then "magic ok"
          else head_str(b, 0, len(want), ""))

let pack_all(st, yc) =
  let _ = banner("compiler/pack", nth(yc, 0)) in
  foldl(fun(s, c) -> pack_one(s, yc, c), st, pack_cases(0))

/* ---- main ---- */

let known(filt) =
  if filt == "" then true
  else if filt == "lower" then true
  else if filt == "pack" then true
  else is_stage(filt)

let main =
  let _ = system(str_cat("mkdir -p ", TMP)) in
  let argv1 = if argc() >= 2 then argv(1) else "" in
  let bless = argv1 == "--bless" in
  let yc = if bless then ["./yc"] else if argv1 == "" then ["./yc"] else [argv1] in
  let filt = if argc() >= 3 then argv(2) else "" in
  if known(filt) == false then
    let _ = print(str_cat("unknown stage: ", filt)) in
    let _ = print("stages: lex parse anf cps opt uncps lir lower pack") in
    exit(2)
  else
    let st1 = front_all([0, 0], yc, filt, bless) in
    if bless then suite_done(st1)
    else
      let want_lower = filt == "lower" or filt == "" in
      let want_pack = filt == "pack" or filt == "" in
      let st2 = if want_lower then lower_all(st1, yc) else st1 in
      let st3 = if want_lower then negative_all(st2, yc) else st2 in
      let st4 = if want_pack then pack_all(st3, yc) else st3 in
      suite_done(st4)
