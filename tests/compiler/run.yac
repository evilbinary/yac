import rt.os
import front.lexer {tokenize}
import front.parser {parse_program}
import front.anf {anf_all}
import front.cps {cps_all, cps_maybe_opt}
import front.uncps {uncps_all}
import front.lir {env_new, lir_expr, sigma_new, st_no, topfn_reset, topval_reset}

/* tests/compiler/run.yac — 编译器逐阶段 IR 回归（strict per-stage tests）。
 *
 * 管线每一阶段的 IR / 步骤都在这里被单独断言：
 *
 *   lex    source        -> tokens                (front.lexer)
 *   parse  tokens        -> AST                   (front.parser)
 *   anf    AST           -> ANF                   (front.anf)
 *   cps    ANF           -> CPS                   (front.cps)
 *   opt    CPS           -> CPS 化简（常量折叠）    (front.cps)
 *   uncps  CPS           -> ANF（受限 un-CPS）      (front.uncps)
 *   lir    ANF           -> LIR 指令               (front.lir)
 *   lower  ANF -> LIR -> 机器码 -> 可执行镜像        (back.*, 经 yc)
 *   pack   机器码        -> ELF/PE/Mach-O/yjit 头      (back.pack.*, 经 yc)
 *
 * 用例输入与期望都放在对应步骤目录：
 *   tests/compiler/<stage>/<name>.yac        输入源程序
 *   tests/compiler/<stage>/<name>.expected   该阶段 IR 的 golden dump
 *
 * IR 阶段由本程序以 `--dump <stage> <file>` 子进程重新计算并逐字符比对
 * golden（dump 逻辑只有一份，避免 golden 与实现漂移）；backend 阶段调用
 * yc 编译并运行，检查退出码 / 镜像魔术字节。
 *
 * 用法（cwd = 仓库根）：
 *   ./stage_tests                # 全跑，yc 默认 ./yc
 *   ./stage_tests ./yc           # 指定 yc 路径
 *   ./stage_tests ./yc lir       # 只跑一个阶段
 *   ./stage_tests --bless        # 重新记录 IR golden（需要可用的 yc）
 */

let TMP = "build/test_tmp"
let DIR = "tests/compiler/"

let sh_quote(s) = str_cat("'", str_cat(s, "'"))

let join_cmd(xs) =
  let rec(i, acc) =
    if i >= len(xs) then acc
    else if i == 0 then rec(1, sh_quote(nth(xs, 0)))
    else rec(i + 1, str_cat(acc, str_cat(" ", sh_quote(nth(xs, i))))) in
  rec(0, "")

let run(argv) =
  let cmd = join_cmd(argv) in
  let tag = int_to_str(time_ns()) in
  let outp = str_cat(TMP, str_cat("/scout.", tag)) in
  let errp = str_cat(TMP, str_cat("/scerr.", tag)) in
  let full = str_cat(cmd, str_cat(" >", str_cat(outp, str_cat(" 2>", errp)))) in
  let rc = system(full) in
  let out = read_file(outp) in
  let err = read_file(errp) in
  let o2 = if out == 0 then "" else out in
  let e2 = if err == 0 then "" else err in
  [rc, o2, e2]

let native(p) =
  let n = str_len(p) in
  let already =
    if n < 4 then false
    else str_slice(p, n - 4, 4) == ".exe" in
  if already then p
  else if host_os(0) == "windows" then str_cat(p, ".exe")
  else p

let strip_cr(s) =
  let b = bytes_new() in
  let rec(i) =
    if i >= str_len(s) then bytes_to_str(b)
    else
      let c = str_ref(s, i) in
      let _ = if c == 13 then 0 else bytes_append(b, c) in
      rec(i + 1) in
  rec(0)

let trim_ws(s, j) =
  if j <= 0 then 0
  else
    let c = str_ref(s, j - 1) in
    if c == 10 then trim_ws(s, j - 1)
    else if c == 13 then trim_ws(s, j - 1)
    else if c == 32 then trim_ws(s, j - 1)
    else if c == 9 then trim_ws(s, j - 1)
    else j

/* 前导 NUL 截断 + 去 CR + 去尾部换行/空格。 */
let chomp(s) =
  let n = str_len(s) in
  let rec(i) =
    if i >= n then n
    else if str_ref(s, i) == 0 then i
    else rec(i + 1) in
  let m = rec(0) in
  let s1 = if m == n then s else str_slice(s, 0, m) in
  let t = strip_cr(s1) in
  str_slice(t, 0, trim_ws(t, str_len(t)))

let contains(s, sub) =
  let n = str_len(s) in
  let m = str_len(sub) in
  let rec(i) =
    if i + m > n then false
    else if str_slice(s, i, m) == sub then true
    else rec(i + 1) in
  if m == 0 then true
  else if m > n then false
  else rec(0)

let banner(dir, tool) =
  let _ = print("") in
  print(str_cat("=== ", str_cat(dir, str_cat("  ", str_cat(tool, " ====")))))

let check(st, name, want, got) =
  let pass = nth(st, 0) in
  let fail = nth(st, 1) in
  if want == got then
    let _ = print(str_cat("PASS: ", name)) in
    [pass + 1, fail]
  else
    let _ = print(str_cat("FAIL: ", name)) in
    let _ = print(str_cat("  expected: ", want)) in
    let _ = print(str_cat("  actual:   ", got)) in
    [pass, fail + 1]

let suite_done(st) =
  let _ = print("") in
  let _ = print(str_cat(int_to_str(nth(st, 0)),
                 str_cat(" passed, ",
                   str_cat(int_to_str(nth(st, 1)), " failed")))) in
  if nth(st, 1) == 0 then 0 else exit(1)

let case_src(stage, name) =
  str_cat(DIR, str_cat(stage, str_cat("/", str_cat(name, ".yac"))))
let case_gold(stage, name) =
  str_cat(DIR, str_cat(stage, str_cat("/", str_cat(name, ".expected"))))

/* ---- 各阶段 IR 的 dump：唯一实现，`--dump` 子进程与 golden 都由它产生 ---- */

let dump_lir_items(anf, i, n) =
  if i >= n then 0
  else
    let out = lir_expr(nth(anf, i),
                st_no([list_new(), env_new(0), 1, sigma_new(0), 0])) in
    let _ = print(nth(out, 0), true) in
    dump_lir_items(anf, i + 1, n)

let dump_stage(stage, src) =
  if stage == "lex" then
    let _ = print(tokenize(src), true) in 0
  else
    let toks = tokenize(src) in
    let prog = parse_program(toks, 0, []) in
    if stage == "parse" then
      let _ = print(prog, true) in 0
    else
      let anf = anf_all(0, prog, list_new(), len(prog)) in
      if stage == "anf" then
        let _ = print(anf, true) in 0
      else if stage == "cps" then
        let _ = print(cps_all(anf), true) in 0
      else if stage == "opt" then
        let _ = print(cps_maybe_opt(cps_all(anf), true), true) in 0
      else if stage == "uncps" then
        let _ = print(uncps_all(cps_all(anf)), true) in 0
      else if stage == "lir" then
        let _ = topfn_reset() in
        let _ = topval_reset() in
        dump_lir_items(anf, 0, len(anf))
      else
        let _ = print(str_cat("unknown stage: ", stage), true) in 1

/* ---- 阶段用例表 ---- */

let stage_cases(stage) =
  if stage == "lex" then
    ["let_bind", "arith", "lambda", "if_else", "comments"]
  else if stage == "parse" then
    ["int", "precedence", "unary_minus", "call_args", "let_fun"]
  else if stage == "anf" then
    ["binop", "if", "call", "lambda", "rec"]
  else if stage == "cps" then
    ["add", "prec", "letfun", "if"]
  else if stage == "opt" then
    ["fold_add", "fold_mul", "fold_sub"]
  else if stage == "uncps" then
    ["add", "letfun", "callcc_err"]
  else if stage == "lir" then
    ["literal", "addition", "precedence", "if_true", "if_var", "let_bind",
     "call", "unary_minus"]
  else []

let all_stages(_) = ["lex", "parse", "anf", "cps", "opt", "uncps", "lir"]

let is_stage(s) = len(stage_cases(s)) > 0

/* 只跑 filter 命中的阶段；filter 为空则全跑。 */
let pick_stages(filt) =
  let xs = all_stages(0) in
  if filt == "" then xs
  else
    let rec(i, n, acc) =
      if i >= n then list_rev(acc)
      else if nth(xs, i) == filt then list_rev(cons(nth(xs, i), acc))
      else rec(i + 1, n, acc) in
    rec(0, len(xs), [])

/* ---- IR 阶段：自我 dump + golden 比对（--bless 写回 golden） ---- */

let dump_case(st, stage, name, bless) =
  let src = case_src(stage, name) in
  let gold = case_gold(stage, name) in
  let out = str_cat(TMP, str_cat("/st_", str_cat(stage, str_cat("_", name)))) in
  let cmd =
    str_cat(sh_quote(argv(0)),
      str_cat(" --dump ",
        str_cat(stage, str_cat(" ", str_cat(sh_quote(src), str_cat(" >", out)))))) in
  let rc = system(cmd) in
  let tag = str_cat(stage, str_cat(" ", name)) in
  if rc != 0 then
    check(st, tag, "dump rc 0", str_cat("rc=", int_to_str(rc)))
  else
    let got = chomp(read_file(out)) in
    if bless then
      let _ = write_file(gold, str_cat(got, "\n")) in
      check(st, tag, "blessed", "blessed")
    else
      let w = read_file(gold) in
      if w == 0 then check(st, tag, "golden (run --bless)", "missing")
      else check(st, tag, chomp(w), got)

let stage_all(st, stage, bless, tool) =
  let _ = banner(str_cat("compiler/", stage), tool) in
  foldl(fun(s, n) -> dump_case(s, stage, n, bless), st, stage_cases(stage))

let front_all(st, filt, bless, tool) =
  foldl(fun(s, g) -> stage_all(s, g, bless, tool), st, pick_stages(filt))

/* ---- 后端阶段：lower（编译 + 运行） ---- */

let lower_cases(_) = [
  ["lit42", "rc", "42"],
  ["arith", "rc", "5"],
  ["if_else", "rc", "40"],
  ["fact", "rc", "120"]
]

let lower_one(st, yc, c) =
  let name = nth(c, 0) in
  let kind = nth(c, 1) in
  let want = nth(c, 2) in
  let bin = native(str_cat(TMP, str_cat("/lower_", name))) in
  let cr = run(append(yc, [case_src("lower", name), "--pkg", "src-self",
                           "-o", bin])) in
  if nth(run(["test", "-f", bin]), 0) != 0 then
    check(st, str_cat("lower ", name), "wrote binary",
          str_cat("compile rc=", int_to_str(nth(cr, 0))))
  else
    let _ = run(["chmod", "+x", bin]) in
    let r = run([bin]) in
    if kind == "rc" then
      check(st, str_cat("lower ", name), want, int_to_str(nth(r, 0)))
    else check(st, str_cat("lower ", name), want, chomp(nth(r, 1)))

let lower_all(st, yc) =
  let _ = banner("compiler/lower", nth(yc, 0)) in
  foldl(fun(s, c) -> lower_one(s, yc, c), st, lower_cases(0))

/* ---- 后端阶段：pack（镜像头） ---- */

let pack_cases(_) = [
  ["elf", ["--format", "elf", "--arch", "x86_64"], [127, 69, 76, 70]],
  ["pe", ["--format", "pe", "--arch", "x86_64"], [77, 90]],
  ["macho", ["--format", "macho", "--arch", "x86_64"], [207, 250]],
  ["yjit", ["--format", "yjit", "--arch", "x86_64"], [89, 74, 73, 84]]
]

let head_matches(b, want, i, n) =
  if i >= n then true
  else if str_len(b) <= i then false
  else if str_ref(b, i) != nth(want, i) then false
  else head_matches(b, want, i + 1, n)

let head_str(b, i, n, acc) =
  if i >= n then acc
  else if str_len(b) <= i then acc
  else
    let sep = if i == 0 then "" else " " in
    head_str(b, i + 1, n,
      str_cat(acc, str_cat(sep, int_to_str(str_ref(b, i)))))

let pack_one(st, yc, c) =
  let name = nth(c, 0) in
  let flags = nth(c, 1) in
  let want = nth(c, 2) in
  let out = str_cat(TMP, str_cat("/pack_", name)) in
  let _ = run(append(append(yc, [case_src("pack", name), "--pkg", "src-self"]),
                     append(flags, ["-o", out]))) in
  let b = read_file(out) in
  if b == 0 then
    check(st, str_cat("pack ", name), "wrote image", "missing")
  else
    check(st, str_cat("pack ", name), "magic ok",
          if head_matches(b, want, 0, len(want)) then "magic ok"
          else head_str(b, 0, len(want), ""))

let pack_all(st, yc) =
  let _ = banner("compiler/pack", nth(yc, 0)) in
  foldl(fun(s, c) -> pack_one(s, yc, c), st, pack_cases(0))

/* ---- main ---- */

let known(filt) =
  if filt == "" then true
  else if filt == "lower" then true
  else if filt == "pack" then true
  else is_stage(filt)

let main =
  let _ = system(str_cat("mkdir -p ", TMP)) in
  if argc() >= 2 then
    if argv(1) == "--dump" then dump_stage(argv(2), read_file(argv(3)))
    else
      let bless = argv(1) == "--bless" in
      let yc = if bless then ["./yc"] else [argv(1)] in
      let filt = if argc() >= 3 then argv(2) else "" in
      if known(filt) == false then
        let _ = print(str_cat("unknown stage: ", filt)) in
        let _ = print("stages: lex parse anf cps opt uncps lir lower pack") in
        exit(2)
      else
        let st1 = front_all([0, 0], filt, bless, nth(yc, 0)) in
        if bless then suite_done(st1)
        else
          let want_lower = filt == "lower" or filt == "" in
          let want_pack = filt == "pack" or filt == "" in
          let st2 = if want_lower then lower_all(st1, yc) else st1 in
          let st3 = if want_pack then pack_all(st2, yc) else st2 in
          suite_done(st3)
  else
    let st1 = front_all([0, 0], "", false, "./yc") in
    suite_done(pack_all(lower_all(st1, ["./yc"]), ["./yc"]))
