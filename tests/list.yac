-- immutable list primitives: len, nth, cons, append, map, filter, foldl, foldr
print len([1, 2, 3])
print nth([10, 20, 30], 1)
print cons(0, [1, 2])
print append([1], [2, 3])
print map(fun (x) -> x * 2, [1, 2, 3])
print filter(fun (x) -> x > 1, [1, 2, 3, 0])
print foldl(fun (a, x) -> a + x, 0, [1, 2, 3, 4])
print foldr(fun (x, a) -> x - a, 0, [1, 2, 3])
print [1, [2, 3], "x"]
print []
print [1, 2] == [1, 2]
if len(nth([[1], [2, 3]], 1)) == 2 then 42 else 0