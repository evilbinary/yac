/* lang_js.yac — lang.js translator regression (host pkg case).
 *
 * Each translation property is one `test.assert` call, so a failure names the
 * case. Execution is covered by the final program: it prints JS_OK only if
 * break / continue / do-while / switch / i++ / boolean semantics all behave,
 * and tests/run.yac asserts that needle for this case. */

import lang.js
import test.assert
import yc.compiler

/* Substring test (no builtin contains for strings). */
let has(s, sub) =
  let n = str_len(s) in
  let m = str_len(sub) in
  let rec(i) =
    if i + m > n then false
    else if str_slice(s, i, m) == sub then true
    else rec(i + 1) in
  if m == 0 then true else rec(0)

/* One assert: translating `js` must produce source containing `sub`. */
let assert_has(name, js, sub) =
  if has(js_to_yac(js), sub) then 0 else fail(name)

/* Mutable variable -> box; early return -> per-call flag boxes. */
let _ = assert_has("mutable var -> box", "let x = 1; x = x + 1;", "box_new")
let _ = assert_has("early return -> flag", "function f(n){ if (n <= 0) { return 0; } return n; }", "_retf")

/* Arrays -> list_new / list_push; objects -> data.fmap. */
let _ = assert_has("array literal", "let a = [1, 2, 3];", "list_new")
let _ = assert_has("object put", "let o = { a: 1 };", "fmap_put")
let _ = assert_has("object import", "let o = { a: 1 };", "import data.fmap")
let _ = assert_has("object string key", "let o = { a: 1 }; console.log(o[\"a\"]);", "fmap_get")

/* console.log / JS booleans / implicit string conversion. */
let _ = assert_has("multi-arg console", "console.log(\"a\", 1);", "_js_str")
let _ = assert_has("bool -> _js_bool", "console.log(1 < 2);", "_js_bool")
let _ = assert_has("bool helper def", "console.log(true);", "let _js_bool")

/* String variables concatenate; floats stay numeric. */
let _ = assert_has("string +=", "let s = \"a\"; s += 1;", "str_cat")
let _ = assert_has("string +", "let s = \"a\"; console.log(s + 1);", "str_cat")
let _ = assert_has("float numeric +", "console.log(0.5 + 1.5);", "0.5 + 1.5")

/* i++ / Math.PI. */
let _ = assert_has("i++", "let i = 0; i++;", "box_set")
let _ = assert_has("Math.PI", "console.log(Math.PI);", "import num.math")

/* break / continue / do-while / switch use the status-box loop driver. */
let _ = assert_has("break", "while (true) { break; }", "_sc")
let _ = assert_has("do-while", "do { } while (false);", "_sc")
let _ = assert_has("switch", "switch (1) { case 1: break; }", "_sc")

/* Malformed input is reported. */
let _ = assert_has("malformed reported", "let = 1;", "error:")

/* Phase 2: bitwise / shift -> band|bor|bxor|bshl|bshr; typeof / void / in. */
let _ = assert_has("bitwise and", "console.log(6 & 3);", "band(")
let _ = assert_has("bitwise or", "console.log(6 | 1);", "bor(")
let _ = assert_has("bitwise xor", "console.log(6 ^ 3);", "bxor(")
let _ = assert_has("bitwise not", "console.log(~0);", "bxor(")
let _ = assert_has("shift left", "console.log(1 << 4);", "bshl(")
let _ = assert_has("shift right", "console.log(32 >> 2);", "bshr(")
let _ = assert_has("typeof static", "console.log(typeof 1);", "\"number\"")
let _ = assert_has("typeof dynamic", "let x = 1; console.log(typeof x);", "_js_typeof")
let _ = assert_has("void", "console.log(void 1);", "undefined")
let _ = assert_has("in", "let o = { a: 1 }; console.log('a' in o);", "fmap_get")
let _ = assert_has("compound bitand", "let x = 6; x &= 3;", "band(")

/* Execution: prints JS_OK only if the control flow is actually correct. */
let _ = run(js_to_yac("let ok = true;\nlet i=0; while(true){ i=i+1; if(i===3){break;} } if(i!==3){ ok=false; }\nlet s=0; for(let k=0;k<5;k++){ if(k===2){continue;} s=s+k; } if(s!==8){ ok=false; }\nlet d=0; do { d=d+1; } while(d<3); if(d!==3){ ok=false; }\nlet x=2; let r='z'; switch(x){ case 1: r='a'; break; case 2: r='b'; break; default: r='c'; } if(r!=='b'){ ok=false; }\nif(!(3>2)){ ok=false; }\nif((6 & 3) !== 2){ ok=false; }\nif((1 << 4) !== 16){ ok=false; }\nif((~0) !== (0 - 1)){ ok=false; }\nlet oo={a:1}; if(!('a' in oo)){ ok=false; }\nif(typeof 1 !== 'number'){ ok=false; }\nif(ok){ console.log('JS_OK'); } else { console.log('JS_BAD'); }"))
