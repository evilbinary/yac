/* lang_js.yac — lang.js translator regression (host pkg case).
 *
 * Each translation property is one `test.assert` call, so a failure names the
 * case. Execution is covered by the final program: it prints JS_OK only if
 * break / continue / do-while / switch / i++ / boolean semantics all behave,
 * and tests/run.yac asserts that needle for this case. */

import lang.js
import test.assert
import yc.compiler
import fs.io

/* Substring test (no builtin contains for strings). */
let has(s, sub) =
  let n = str_len(s) in
  let m = str_len(sub) in
  let rec(i) =
    if i + m > n then false
    else if str_slice(s, i, m) == sub then true
    else rec(i + 1) in
  if m == 0 then true else rec(0)

/* One assert: translating `js` must produce source containing `sub`. */
let assert_has(name, js, sub) =
  if has(js_to_yac(js), sub) then 0 else fail(name)

/* Mutable variable -> box; early return -> per-call flag boxes. */
let _ = assert_has("mutable var -> box", "let x = 1; x = x + 1;", "box_new")
let _ = assert_has("early return -> flag", "function f(n){ if (n <= 0) { return 0; } return n; }", "_retf")

/* Arrays -> list_new / list_push; objects -> data.fmap. */
let _ = assert_has("array literal", "let a = [1, 2, 3];", "list_new")
let _ = assert_has("object put", "let o = { a: 1 };", "fmap_put")
let _ = assert_has("object import", "let o = { a: 1 };", "import data.fmap")
let _ = assert_has("object string key", "let o = { a: 1 }; console.log(o[\"a\"]);", "fmap_get")

/* console.log / JS booleans / implicit string conversion. */
let _ = assert_has("multi-arg console", "console.log(\"a\", 1);", "_js_str")
let _ = assert_has("bool -> _js_bool", "console.log(1 < 2);", "_js_bool")
let _ = assert_has("bool helper import", "console.log(true);", "import lang.jsrt")

/* String variables concatenate; floats stay numeric. */
let _ = assert_has("string +=", "let s = \"a\"; s += 1;", "str_cat")
let _ = assert_has("string +", "let s = \"a\"; console.log(s + 1);", "str_cat")
let _ = assert_has("float numeric +", "console.log(0.5 + 1.5);", "0.5 + 1.5")

/* i++ / Math.PI. */
let _ = assert_has("i++", "let i = 0; i++;", "box_set")
let _ = assert_has("Math.PI", "console.log(Math.PI);", "import num.math")

/* break / continue / do-while / switch use the status-box loop driver. */
let _ = assert_has("break", "while (true) { break; }", "_sc")
let _ = assert_has("do-while", "do { } while (false);", "_sc")
let _ = assert_has("switch", "switch (1) { case 1: break; }", "_sc")

/* Malformed input is reported. */
let _ = assert_has("malformed reported", "let = 1;", "error:")

/* Phase 2: bitwise / shift -> band|bor|bxor|bshl|bshr; typeof / void / in. */
let _ = assert_has("bitwise and", "console.log(6 & 3);", "band(")
let _ = assert_has("bitwise or", "console.log(6 | 1);", "bor(")
let _ = assert_has("bitwise xor", "console.log(6 ^ 3);", "bxor(")
let _ = assert_has("bitwise not", "console.log(~0);", "bxor(")
let _ = assert_has("shift left", "console.log(1 << 4);", "bshl(")
let _ = assert_has("shift right", "console.log(32 >> 2);", "bshr(")
let _ = assert_has("typeof static", "console.log(typeof 1);", "\"number\"")
let _ = assert_has("typeof dynamic", "let x = 1; console.log(typeof x);", "_js_typeof")
let _ = assert_has("void", "console.log(void 1);", "undefined")
let _ = assert_has("in", "let o = { a: 1 }; console.log('a' in o);", "fmap_get")
let _ = assert_has("compound bitand", "let x = 6; x &= 3;", "band(")

/* Execution: prints JS_OK only if the control flow is actually correct. */
let _ = run(js_to_yac("let ok = true;\nlet i=0; while(true){ i=i+1; if(i===3){break;} } if(i!==3){ ok=false; }\nlet s=0; for(let k=0;k<5;k++){ if(k===2){continue;} s=s+k; } if(s!==8){ ok=false; }\nlet d=0; do { d=d+1; } while(d<3); if(d!==3){ ok=false; }\nlet x=2; let r='z'; switch(x){ case 1: r='a'; break; case 2: r='b'; break; default: r='c'; } if(r!=='b'){ ok=false; }\nif(!(3>2)){ ok=false; }\nif((6 & 3) !== 2){ ok=false; }\nif((1 << 4) !== 16){ ok=false; }\nif((~0) !== (0 - 1)){ ok=false; }\nlet oo={a:1}; if(!('a' in oo)){ ok=false; }\nif(typeof 1 !== 'number'){ ok=false; }\nif(ok){ console.log('JS_OK'); } else { console.log('JS_BAD'); }"))

/* ---- value tests: compile + run each example, compare stdout ---- */

let strip_cr(s) =
  let b = bytes_new() in
  let n = str_len(s) in
  let rec(i) =
    if i >= n then bytes_to_str(b)
    else
      let c = str_ref(s, i) in
      let _ = if c == 13 then 0 else bytes_append(b, c) in
      rec(i + 1) in
  rec(0)

let trim_nl(s) =
  let k = str_len(s) in
  let rec(j) = if j <= 0 then 0 else if str_ref(s, j - 1) == 10 then rec(j - 1) else j in
  str_slice(s, 0, rec(k))

/* Translate, compile to an executable, run it, return its trimmed stdout.
 * Unique temp filenames per call: reusing one path races with the OS still
 * holding the previous executable (a transient extra pkg failure). */
let run_seq = box_new()
let _ = box_set(run_seq, 0)
let run_js(js) =
  let n = box_get(run_seq) in
  let _ = box_set(run_seq, n + 1) in
  let base = str_cat("build/test_tmp/lang_js_val", int_to_str(n)) in
  let src = js_to_yac(js) in
  let yf = str_cat(base, ".yac") in
  let xf = str_cat(base, ".exe") in
  let of = str_cat(base, ".out") in
  let _ = write_file(yf, src) in
  let rc = compile_file(yf, xf) in
  if rc != 0 then "<compile_fail>"
  else
    let _ = system(str_cat(xf, str_cat(" > ", str_cat(of, " 2>&1")))) in
    let o = read_or_0(of) in
    if o == 0 then "<no_out>" else trim_nl(strip_cr(o))

let check(name, js, want) =
  let got = run_js(js) in
  if got == want then 0
  else
    let _ = print(str_cat("FAIL: ", name)) in
    eq(want, got)

/* expressions */
let _ = check("arith", "console.log(1 + 2 * 3);", "7")
let _ = check("concat", "console.log('a' + 'b' + 'c');", "abc")
let _ = check("mixcat", "console.log('x=' + 5);", "x=5")
let _ = check("cmp", "console.log(3 > 2);", "true")
let _ = check("logic", "console.log(true && false);", "false")
let _ = check("not", "console.log(!false);", "true")
let _ = check("ternary", "console.log(1 < 2 ? 'yes' : 'no');", "yes")
let _ = check("mod", "console.log(17 % 5);", "2")
let _ = check("reassign", "let x = 1; x = x + 4; console.log(x);", "5")
let _ = check("compound", "let x = 10; x += 5; x *= 2; console.log(x);", "30")
let _ = check("neg", "console.log(0 - 1);", "-1")
let _ = check("float", "console.log(0.5 + 1.5);", "2")
let _ = check("iplusplus", "let i = 0; i++; console.log(i);", "1")
let _ = check("strvar", "let s = 'a'; let t = s + 'b'; console.log(t + 1);", "ab1")
let _ = check("boolcat", "console.log('r=' + (3 > 2));", "r=true")

/* control flow */
let _ = check("break", "let i=0; while(true){ i=i+1; if(i===3){break;} } console.log(i);", "3")
let _ = check("continue", "let s=0; for(let k=0;k<5;k++){ if(k===2){continue;} s=s+k; } console.log(s);", "8")
let _ = check("dowhile", "let d=0; do { d=d+1; } while(d<3); console.log(d);", "3")
let _ = check("switch", "let x=2; switch(x){ case 1: console.log('a'); break; case 2: console.log('b'); break; default: console.log('c'); }", "b")
let _ = check("switchdef", "let x=9; switch(x){ case 1: console.log('a'); break; default: console.log('c'); }", "c")
let _ = check("nestedbreak", "let s=0; for(let i=0;i<3;i++){ for(let j=0;j<3;j++){ if(j===1){break;} s=s+1; } } console.log(s);", "3")
let _ = check("retloop", "function f(){ let i=0; while(true){ i=i+1; if(i===4){ return i*10; } } } console.log(f());", "40")
let _ = check("ifchain", "let x=3; if(x==1){ console.log('a'); } else if(x==3){ console.log('b'); } else { console.log('c'); }", "b")

/* functions */
let _ = check("fn2", "function add(a, b){ return a + b; } console.log(add(20, 22));", "42")
let _ = check("noparam", "function f(){ return 7; } console.log(f());", "7")
let _ = check("fact", "function f(n){ if(n<=1){ return 1; } return n*f(n-1); } console.log(f(5));", "120")
let _ = check("earlyret", "function f(n){ if(n>0){ return 1; } let z=100; return 2; } console.log(f(5)); console.log(f(0-1));", "1\n2")

/* arrays / objects */
let _ = check("array", "let a=[10,20,30]; a[1]=99; console.log(a[1]); console.log(a.length);", "99\n3")
let _ = check("push", "let a=[1]; a.push(2); a.push(3); console.log(a.length);", "3")
let _ = check("nestedarr", "let a=[[1,2],[3,4]]; console.log(a[1][0]);", "3")
let _ = check("arr_obj", "let a=[{v:5},{v:6}]; console.log(a[0].v + a[1].v);", "11")
let _ = check("object", "let o={a:1,b:2}; o.c=3; console.log(o.a+o.b+o.c);", "6")
let _ = check("objstr", "let o={'x y':5}; console.log(o['x y']);", "5")
let _ = check("obj_arr", "let o={list:[1,2,3]}; console.log(o.list[2]);", "3")

/* booleans / null / multiple args */
let _ = check("multi", "console.log('a', 1, true);", "a 1 true")
let _ = check("zero", "console.log();", "")
let _ = check("null", "console.log(null); console.log(undefined);", "null\nundefined")
let _ = check("strcmp", "console.log('ab' === 'ab');", "true")

/* operators */
let _ = check("band", "console.log(6 & 3);", "2")
let _ = check("bor", "console.log(6 | 1);", "7")
let _ = check("bxor", "console.log(6 ^ 3);", "5")
let _ = check("bnot", "console.log(~0);", "-1")
let _ = check("shl", "console.log(1 << 4);", "16")
let _ = check("shr", "console.log(32 >> 2);", "8")
let _ = check("precshift", "console.log(1 + 2 << 3);", "24")
let _ = check("typeofnum", "console.log(typeof 1);", "number")
let _ = check("typeofstr", "console.log(typeof 's');", "string")
let _ = check("typeofbool", "console.log(typeof true);", "boolean")
let _ = check("typeofnull", "console.log(typeof null);", "object")
let _ = check("typeoffn", "function f(){ return 1; } console.log(typeof f);", "function")
let _ = check("void", "console.log(void 0);", "undefined")
let _ = check("in", "let o={a:1}; console.log('a' in o); console.log('b' in o);", "true\nfalse")
let _ = check("cband", "let x=6; x &= 3; console.log(x);", "2")

/* dynamic typeof via the `kind` prim (params are not statically typed) */
let _ = check("typeof_dyn_str", "function f(s){ return typeof s; } console.log(f('hi'));", "string")
let _ = check("typeof_dyn_num", "function f(n){ return typeof n; } console.log(f(1));", "number")
let _ = check("typeof_dyn_obj", "function f(o){ return typeof o; } console.log(f({a:1}));", "object")

/* JS truthiness: "" and 0 are falsy, non-empty string truthy */
let _ = check("truthy_emptystr", "if ('') { console.log('T'); } else { console.log('F'); }", "F")
let _ = check("truthy_str", "if ('x') { console.log('T'); } else { console.log('F'); }", "T")
let _ = check("truthy_zero", "if (0) { console.log('T'); } else { console.log('F'); }", "F")
let _ = check("truthy_zerofloat", "if (0.0) { console.log('T'); } else { console.log('F'); }", "F")
let _ = check("not_emptystr", "console.log(!'');", "true")

/* && / || short-circuit (RHS must not run) and JS value semantics */
let _ = check("and_sc", "let x=0; let y = false && (x=1); console.log(x);", "0")
let _ = check("or_sc", "let x=0; let y = true || (x=1); console.log(x);", "0")
let _ = check("or_value", "console.log(0 || 'd');", "d")
let _ = check("and_value", "console.log(0 && 'd');", "0")
let _ = check("and_value2", "console.log(1 && 2);", "2")

/* ES6 arrow functions */
let _ = check("arrow1", "let f = x => x + 1; console.log(f(2));", "3")
let _ = check("arrow2", "let g = (a, b) => a * b; console.log(g(3,4));", "12")
let _ = check("arrow0", "let h = () => 5; console.log(h());", "5")
let _ = check("arrowblock", "let k = x => { return x * 2; }; console.log(k(5));", "10")
let _ = check("arrowmap", "console.log([1,2,3].map(x => x * 2).join(','));", "2,4,6")

/* ES6 template literals */
let _ = check("tmpl_plain", "console.log(`hi`);", "hi")
let _ = check("tmpl_expr", "console.log(`a${1+2}b`);", "a3b")
let _ = check("tmpl_num", "console.log(`x=${5}`);", "x=5")
let _ = check("tmpl_str", "let s='q'; console.log(`${s}!`);", "q!")

/* ES6 exponentiation */
let _ = check("pow", "console.log(2 ** 3);", "8")
let _ = check("powr", "console.log(2 ** 3 ** 2);", "512")
let _ = check("powprec", "console.log(2 * 3 ** 2);", "18")
let _ = check("powassign", "let x=2; x **= 3; console.log(x);", "8")

/* ES6 object literal shorthand / computed / method */
let _ = check("obj_shorthand", "let a=1; let o={a}; console.log(o.a);", "1")
let _ = check("obj_computed", "let k='x'; let o={[k]:5}; console.log(o.x);", "5")
let _ = check("obj_method", "let o={m(){ return 7; }}; console.log(o.m());", "7")
let _ = check("obj_mixed", "let k='y'; let o={[k]:1, z:2}; console.log(o.y+o.z);", "3")

/* ES6 default parameters */
let _ = check("default_missing", "function f(a=2){ return a; } console.log(f());", "2")
let _ = check("default_given", "function f(a=2){ return a; } console.log(f(7));", "7")
let _ = check("default_expr", "let g = function(x=1){return x;}; console.log(g());", "1")
let _ = check("default_method", "let o={m(x=3){return x;}}; console.log(o.m());", "3")

/* ES6 destructuring */
let _ = check("destr_arr", "let [a,b] = [1,2]; console.log(a+b);", "3")
let _ = check("destr_obj", "let {x,y} = {x:4,y:5}; console.log(x+y);", "9")
let _ = check("destr_shorthand", "let {p} = {p:6}; console.log(p);", "6")
let _ = check("destr_nested", "let [[a],[b]] = [[1],[2]]; console.log(a+b);", "3")
let _ = check("destr_mixed", "let {a, b:[c]} = {a:1, b:[2]}; console.log(a+c);", "3")
let _ = check("destr_elision", "let [,b] = [1,2]; console.log(b);", "2")

/* ES6 classes */
let _ = check("class_basic", "class A { constructor(x){ this.x = x; } get(){ return this.x; } } let a = new A(5); console.log(a.get());", "5")
let _ = check("class_prop", "class A { constructor(){ this.v = 7; } } let a = new A(); console.log(a.v);", "7")
let _ = check("class_default_ctor", "class A { m(){ return 3; } } let a = new A(); console.log(a.m());", "3")
let _ = check("class_extends", "class B { constructor(x){ this.x = x; } val(){ return this.x; } } class C extends B { constructor(x){ super(x); this.y = 2; } sum(){ return this.x + this.y; } } let c = new C(5); console.log(c.sum());", "7")
let _ = check("class_super_method", "class B { hi(){ return 1; } } class C extends B { hi(){ return super.hi() + 1; } } console.log(new C().hi());", "2")

/* ES6 for...of (arrays) */
let _ = check("forof_sum", "let s=0; for (let x of [1,2,3]) { s = s + x; } console.log(s);", "6")
let _ = check("forof_str", "let s=''; for (let c of ['a','b']) { s = s + c; } console.log(s);", "ab")
let _ = check("forof_continue", "let s=0; for (let x of [1,2,3]) { if (x === 2) { continue; } s = s + x; } console.log(s);", "4")
let _ = check("forof_break", "let n=0; for (let x of [1,2,3]) { n = n + 1; if (n === 2) { break; } } console.log(n);", "2")

/* ES6 spread / rest (arrays + objects) */
let _ = check("spread_arr", "let a=[1,2]; let b=[0,...a,3]; console.log(b.join(','));", "0,1,2,3")
let _ = check("spread_obj", "let o={a:1}; let p={...o, b:2}; console.log(p.a+p.b);", "3")
let _ = check("rest_destr", "let [a,...r] = [1,2,3]; console.log(a + '/' + r.join(','));", "1/2,3")

/* ES6 numeric literals + B-class built-ins */
let _ = check("num_bin", "console.log(0b1010);", "10")
let _ = check("num_oct", "console.log(0o17);", "15")
let _ = check("num_hex", "console.log(0x1F);", "31")
let _ = check("num_sep", "console.log(1_000 + 1);", "1001")
let _ = check("obj_assign", "let t={a:1}; let s={b:2}; Object.assign(t,s); console.log(t.a+t.b);", "3")
let _ = check("obj_values", "let o={a:1,b:2}; console.log(Object.values(o).length);", "2")
let _ = check("arr_from", "console.log(Array.from([1,2,3]).length);", "3")
let _ = check("arr_of", "console.log(Array.of(7,8,9).length);", "3")
let _ = check("pad_start", "console.log('5'.padStart(3,'0'));", "005")
let _ = check("trim_start", "console.log('  x'.trimStart());", "x")
let _ = check("trim_end", "console.log('x  '.trimEnd());", "x")
let _ = check("num_isint", "console.log(Number.isInteger(5));", "true")

/* more ES6 built-ins */
let _ = check("arr_find", "console.log([1,2,3].find(x => x > 1));", "2")
let _ = check("arr_findindex", "console.log([1,2,3].findIndex(x => x > 1));", "1")
let _ = check("arr_includes", "console.log([1,2,3].includes(2));", "true")
let _ = check("arr_fill", "let a=[1,2,3]; a.fill(9,1); console.log(a.join(','));", "1,9,9")
let _ = check("obj_is", "console.log(Object.is(1,1));", "true")
let _ = check("obj_getnames", "let o={a:1,b:2}; console.log(Object.getOwnPropertyNames(o).length);", "2")
let _ = check("codepointat", "console.log('A'.codePointAt(0));", "65")
let _ = check("math_cbrt", "console.log(Math.cbrt(27));", "3")
let _ = check("math_log10", "console.log(Math.log10(1000));", "3")
let _ = check("math_pi", "console.log(Math.PI > 3.14);", "true")

/* ES6 parameter destructuring */
let _ = check("param_obj", "function f({a,b}){ return a+b; } console.log(f({a:1,b:2}));", "3")
let _ = check("param_arr", "function f([x,y]){ return x+y; } console.log(f([3,4]));", "7")
let _ = check("param_obj_method", "let o={m({a}){return a;}}; console.log(o.m({a:5}));", "5")
let _ = check("param_nested", "function f({a:{b}}){ return b; } console.log(f({a:{b:8}}));", "8")
let _ = check("param_pat_default", "function f({a}={a:9}){return a;} console.log(f());", "9")

/* ES6 destructuring assignment (not declaration) */
let _ = check("destass_arr", "let a=0; let b=0; [a,b]=[1,2]; console.log(a+b);", "3")
let _ = check("destass_swap", "let x=1; let y=2; [x,y]=[y,x]; console.log(x + ',' + y);", "2,1")
let _ = check("destass_obj", "let a=0; ({a} = {a:7}); console.log(a);", "7")

/* ES6 static class methods */
let _ = check("class_static", "class A { static s(){ return 3; } } console.log(A.s());", "3")
let _ = check("class_static_args", "class A { static add(a,b){ return a+b; } } console.log(A.add(2,3));", "5")

/* ES6 Map / Set */
let _ = check("map_get", "let m=new Map(); m.set('a',1); m.set('b',2); console.log(m.get('a') + m.get('b'));", "3")
let _ = check("map_size", "let m=new Map(); m.set('a',1); m.set('b',2); console.log(m.size);", "2")
let _ = check("map_has", "let m=new Map(); m.set('a',1); console.log(m.has('a'));", "true")
let _ = check("map_delete", "let m=new Map(); m.set('a',1); m.set('b',2); m.delete('a'); console.log(m.size);", "1")
let _ = check("map_keys", "let m=new Map(); m.set('a',1); m.set('b',2); console.log(m.keys().length);", "2")
let _ = check("map_overwrite", "let m=new Map(); m.set('a',1); m.set('a',9); console.log(m.get('a') + '/' + m.size);", "9/1")
let _ = check("set_size", "let s=new Set(); s.add(1); s.add(2); s.add(1); console.log(s.size);", "2")
let _ = check("set_has", "let s=new Set(); s.add(1); console.log(s.has(1));", "true")
let _ = check("set_delete", "let s=new Set(); s.add(1); s.add(2); s.delete(1); console.log(s.size);", "1")

/* ES6 getter / setter */
let _ = check("getter_obj", "let o = { get x(){ return 5; } }; console.log(o.x);", "5")
let _ = check("accessor_obj", "let o = { _v:1, get v(){ return this._v; }, set v(n){ this._v = n*2; } }; o.v = 3; console.log(o.v);", "6")
let _ = check("getter_class", "class A { constructor(){ this._v = 1; } get v(){ return this._v * 10; } } console.log(new A().v);", "10")
let _ = check("accessor_class", "class A { constructor(){ this._v = 0; } get v(){ return this._v; } set v(n){ this._v = n + 1; } } let a = new A(); a.v = 5; console.log(a.v);", "6")

/* for...of over string / Map / Set */
let _ = check("forof_string", "let s='abc'; let r=''; for (let c of s) { r = r + c; } console.log(r);", "abc")
let _ = check("forof_map", "let m=new Map(); m.set('a',1); m.set('b',2); let t=0; for (let e of m) { t = t + e[1]; } console.log(t);", "3")
let _ = check("forof_set", "let st=new Set(); st.add(1); st.add(2); let t=0; for (let v of st) { t = t + v; } console.log(t);", "3")

/* WeakMap / WeakSet, Math hyperbolics, Number constants */
let _ = check("weakmap", "let w=new WeakMap(); w.set('a',1); console.log(w.get('a'));", "1")
let _ = check("weakset", "let w=new WeakSet(); w.add(5); console.log(w.has(5));", "true")
let _ = check("math_sinh", "console.log(Math.sinh(0));", "0")
let _ = check("math_cosh", "console.log(Math.cosh(0));", "1")
let _ = check("num_maxsafe", "console.log(Number.MAX_SAFE_INTEGER);", "9007199254740991")
let _ = check("num_epsilon", "console.log(Number.EPSILON > 0);", "true")

/* more library coverage */
let _ = check("arr_lastindex", "console.log([1,2,3,2].lastIndexOf(2));", "3")
let _ = check("arr_copywithin", "let a=[1,2,3,4]; a.copyWithin(0,2); console.log(a.join(','));", "3,4,3,4")
let _ = check("obj_defprop_get", "let o={}; Object.defineProperty(o,'x',{get:function(){return 7;}}); console.log(o.x);", "7")
let _ = check("obj_defprop_value", "let o={}; Object.defineProperty(o,'v',{value:5}); console.log(o.v);", "5")
let _ = check("obj_getproto", "let o={}; console.log(Object.getPrototypeOf(o) == 0);", "true")
let _ = check("forof_closure", "let fns=[]; for (let x of [1,2,3]) { fns.push(function(){ return x; }); } console.log(fns[0]() + ',' + fns[1]() + ',' + fns[2]());", "1,2,3")
let _ = check("forin_closure", "let o={a:1,b:2}; let fns=[]; for (let k in o) { fns.push(function(){ return k; }); } console.log(fns.length);", "2")

/* string / array standard library */
let _ = check("charAt", "console.log('abc'.charAt(1));", "b")
let _ = check("charCodeAt", "console.log('abc'.charCodeAt(0));", "97")
let _ = check("upper", "console.log('hello'.toUpperCase());", "HELLO")
let _ = check("lower", "console.log('HELLO'.toLowerCase());", "hello")
let _ = check("trim", "console.log('  hi  '.trim());", "hi")
let _ = check("splitlen", "console.log('a,b,c'.split(',').length);", "3")
let _ = check("strslice", "console.log('hello'.slice(1,3));", "el")
let _ = check("repeat", "console.log('ab'.repeat(3));", "ababab")
let _ = check("strindexof", "console.log('hello'.indexOf('l'));", "2")
let _ = check("strlenvar", "let s='hi'; console.log(s.length);", "2")
let _ = check("starts", "console.log('hello'.startsWith('he'));", "true")
let _ = check("ends", "console.log('hello'.endsWith('lo'));", "true")
let _ = check("includes", "console.log('hello'.includes('ell'));", "true")
let _ = check("aslice", "let a=[1,2,3]; console.log(a.slice(1,3).length);", "2")
let _ = check("aindexof", "let a=[1,2,3]; console.log(a.indexOf(2));", "1")
let _ = check("areverse", "let a=[1,2,3]; console.log(a.reverse().length);", "3")

/* function expressions / closures / higher-order callbacks */
let _ = check("fnexpr", "let f = function(x){ return x + 1; }; console.log(f(41));", "42")
let _ = check("iife", "console.log((function(){ return 5; })());", "5")
let _ = check("closure", "function make(){ let c = 0; return function(){ c = c + 1; return c; }; } let n = make(); console.log(n()); console.log(n());", "1\n2")
let _ = check("adder", "function adder(x){ return function(y){ return x + y; }; } console.log(adder(5)(3));", "8")
let _ = check("mapcb", "console.log([1,2,3].map(function(x){ return x * 2; })[1]);", "4")
let _ = check("filtercb", "console.log([1,2,3,4].filter(function(x){ return x % 2 === 0; }).length);", "2")
let _ = check("reducecb", "let a=[1,2,3,4]; console.log(a.reduce(function(acc,v){ return acc + v; }, 0));", "10")
let _ = check("eachcb", "let s=0; [1,2,3].forEach(function(x){ s = s + x; }); console.log(s);", "6")

/* array stdlib: join / concat / map */
let _ = check("join", "let a=[1,2,3]; console.log(a.join('-'));", "1-2-3")
let _ = check("join_comma", "let a=[1,2,3]; console.log(a.join());", "1,2,3")
let _ = check("aconcat", "let a=[1,2,3]; console.log(a.concat([4,5]).length);", "5")
let _ = check("amap", "let a=[1,2,3]; console.log(a.map(function(x){ return x*2; }).length);", "3")

/* an operator-like string literal must not be parsed as an operator */
let _ = check("opstr", "console.log('!'); console.log('-');", "!\n-")

/* this / new / prototype chain */
let _ = check("ctor", "function Point(x,y){ this.x = x; this.y = y; } Point.prototype.sum = function(){ return this.x + this.y; }; let p = new Point(3,4); console.log(p.sum());", "7")
let _ = check("new_noargs", "function C(){ this.n = 5; } let c = new C(); console.log(c.n);", "5")
let _ = check("proto_method", "function A(){ this.v = 1; } A.prototype.get = function(){ return this.v; }; console.log((new A()).get());", "1")
let _ = check("two_instances", "function P(x){ this.x = x; } P.prototype.dbl = function(){ return this.x*2; }; let a=new P(10); let b=new P(20); console.log(a.dbl()); console.log(b.dbl());", "20\n40")
let _ = check("method_chain", "function Counter(){ this.n = 0; } Counter.prototype.inc = function(){ this.n = this.n + 1; return this; }; let c = new Counter(); c.inc(); c.inc(); console.log(c.n);", "2")

/* throw / try / catch / finally */
let _ = check("throw_catch", "try { throw 1; console.log('no'); } catch(e){ console.log(e); } console.log('after');", "1\nafter")
let _ = check("throw_str", "try { throw 'boom'; } catch(e){ console.log('caught', e); }", "caught boom")
let _ = check("fn_throw", "function f(){ throw 42; } try { f(); console.log('no'); } catch(e){ console.log(e); }", "42")
let _ = check("catch_finally", "try { throw 1; } catch(e){ console.log('c', e); } finally { console.log('fin'); }", "c 1\nfin")
let _ = check("try_finally", "try { console.log('a'); } finally { console.log('fin'); }", "a\nfin")
let _ = check("loop_throw", "try { for(let i=0;i<3;i=i+1){ if(i==1){ throw i; } console.log('i', i); } } catch(e){ console.log('caught', e); }", "i 0\ncaught 1")

/* for...in / Object.keys / Object.create */
let _ = check("objkeys", "let o={a:1,b:2,c:3}; console.log(Object.keys(o).length);", "3")
let _ = check("forin_sum", "let o={a:1,b:2,c:3}; let s=0; for(let k in o){ s = s + o[k]; } console.log(s);", "6")
let _ = check("forin_count", "let o={a:1,b:2}; let n=0; for(k in o){ n=n+1; } console.log(n);", "2")
let _ = check("obj_create", "function A(){} A.prototype.m = function(){ return 5; }; let o = Object.create(A.prototype); console.log(o.m());", "5")
let _ = check("forin_break", "let o={a:1,b:2,c:3}; let n=0; for(let k in o){ n=n+1; if(n==1){break;} } console.log(n);", "1")

/* JSON (via the js_native dispatch) + object/array runtime distinction */
let _ = check("json_str", "console.log(JSON.stringify('hi'));", "\"hi\"")
let _ = check("json_num", "console.log(JSON.stringify(5));", "5")
let _ = check("json_arr", "console.log(JSON.stringify([1,2,3]));", "[1,2,3]")
let _ = check("json_obj", "console.log(JSON.stringify({a:1}));", "{\"a\":1}")
let _ = check("json_parse_num", "console.log(JSON.parse('7'));", "7")
let _ = check("json_parse_str", "console.log(JSON.parse('\"x\"'));", "x")
let _ = check("json_parse_arr", "console.log(JSON.parse('[1,2,3]')[1]);", "2")
let _ = check("json_parse_obj", "console.log(JSON.parse('{\"a\":5}').a);", "5")
let _ = check("isarray", "console.log(Array.isArray([1,2]));", "true")
let _ = check("isarray_obj", "console.log(Array.isArray({a:1}));", "false")

/* Array.sort / String.replace / String.search / isNaN */
let _ = check("sort", "let a=[3,1,2]; a.sort(); console.log(a.join(','));", "1,2,3")
let _ = check("sort_cmp", "let a=[1,3,2]; a.sort(function(x,y){ return y-x; }); console.log(a.join(','));", "3,2,1")
let _ = check("replace", "console.log('hello world'.replace('world','there'));", "hello there")
let _ = check("search", "console.log('hello'.search('ll'));", "2")
let _ = check("isnan", "console.log(isNaN(1)); console.log(isNaN('a'));", "false\nfalse")

/* switch fallthrough (JS semantics) */
let _ = check("sw_fall1", "let x=1; switch(x){ case 1: console.log('a'); case 2: console.log('b'); break; case 3: console.log('c'); }", "a\nb")
let _ = check("sw_fall2", "let x=2; switch(x){ case 1: console.log('a'); case 2: console.log('b'); case 3: console.log('c'); }", "b\nc")
let _ = check("sw_defmid", "let x=9; switch(x){ case 1: console.log('a'); break; default: console.log('d'); case 2: console.log('b'); }", "d\nb")
let _ = check("sw_nomatch", "let x=5; switch(x){ case 1: console.log('a'); break; } console.log('z');", "z")

/* jslib: parseInt / isFinite / String.fromCharCode / Date.now */
let _ = check("parseint", "console.log(parseInt('42'));", "42")
let _ = check("parseint_neg", "console.log(parseInt('-15'));", "-15")
let _ = check("parseint_part", "console.log(parseInt('12abc'));", "12")
let _ = check("isfinite", "console.log(isFinite(1));", "true")
let _ = check("fromcharcode", "console.log(String.fromCharCode(65));", "A")
let _ = check("datenow_type", "console.log(typeof Date.now());", "number")
