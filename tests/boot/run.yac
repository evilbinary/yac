/* tests/boot/run.yac — self-hosted frontend + unit tests (yac, not sh). */
let TMP = "build/test_tmp"
let LOG_STUB = "let log(mod, msg) = 0\nlet log_i(mod, key, n) = 0\n"
let EMIT_STUB = "let emit_program_arm64(p, v, o) = emit_program_x86_64(p, v, o)\nlet emit_program_riscv64(p, v, o) = emit_program_x86_64(p, v, o)\n"

let sh_quote(s) = str_cat("'", str_cat(s, "'"))

let join_cmd(xs) =
  let rec(i, acc) =
    if i >= len(xs) then acc
    else if i == 0 then rec(1, sh_quote(nth(xs, 0)))
    else rec(i + 1, str_cat(acc, str_cat(" ", sh_quote(nth(xs, i))))) in
  rec(0, "")

let run(argv) =
  let cmd = join_cmd(argv) in
  /* Distinct from tests/run.yac (pout/perr): that harness redirects this
   * binary onto those files, so sharing them truncated boot stdout. */
  let outp = str_cat(TMP, "/poutb") in
  let errp = str_cat(TMP, "/perrb") in
  let full = str_cat(cmd, str_cat(" >", str_cat(outp, str_cat(" 2>", errp)))) in
  let rc = system(full) in
  let out = read_file(outp) in
  let err = read_file(errp) in
  let o2 = if out == 0 then "" else out in
  let e2 = if err == 0 then "" else err in
  [rc, o2, e2]

let native(p) =
  let n = str_len(p) in
  let already =
    if n < 4 then false
    else str_slice(p, n - 4, 4) == ".exe" in
  if already then p
  else if nth(run(["test", "-f", "build/test_tmp/yc_a.exe"]), 0) == 0 then str_cat(p, ".exe")
  else p

let chomp(s) =
  let n = str_len(s) in
  if n == 0 then s
  else if str_ref(s, n - 1) == 10 then str_slice(s, 0, n - 1)
  else s

let drop_print0(s) =
  let t = chomp(s) in
  let n = str_len(t) in
  if n < 2 then t
  else if str_ref(t, n - 1) != 48 then t
  else if str_ref(t, n - 2) != 10 then t
  else chomp(str_slice(t, 0, n - 2))

let native_build(src, bin) =
  let yc = native("build/test_tmp/yc_a") in
  let out = native(bin) in
  let cr = run([yc, src, "-o", out]) in
  let _ = run(["chmod", "+x", out]) in
  cr

let interp_out(runner) = drop_print0(nth(run([native("./yac"), runner]), 1))

let native_out(bin) = chomp(nth(run([native(bin)]), 1))

let rchomp(s) =
  let n = str_len(s) in
  if n == 0 then s
  else if str_ref(s, n - 1) == 10 then rchomp(str_slice(s, 0, n - 1))
  else s

let check(st, name, want, got) =
  let pass = nth(st, 0) in
  let fail = nth(st, 1) in
  if want == got then
    let _ = print(str_cat("PASS: ", name)) in
    [pass + 1, fail]
  else
    let _ = print(str_cat("FAIL: ", name)) in
    let _ = print(str_cat("  expected: ", want)) in
    let _ = print(str_cat("  actual:   ", got)) in
    [pass, fail + 1]

let cat_files(xs, dest) =
  let rec(i, acc) =
    if i >= len(xs) then write_file(dest, acc)
    else rec(i + 1, str_cat(acc, read_file(nth(xs, i)))) in
  rec(0, "")

let lex_one(st, c) =
  let _ = write_file(str_cat(TMP, "/lexin.yac"),
                    read_file(str_cat("tests/boot/lex/", str_cat(nth(c, 0), ".yac")))) in
  check(st, str_cat("lex ", nth(c, 0)), nth(c, 1), native_out(str_cat(TMP, "/lex_run")))

let parse_one(st, c) =
  let _ = write_file(str_cat(TMP, "/parin.yac"), nth(c, 1)) in
  check(st, str_cat("parse ", nth(c, 0)), nth(c, 2), rchomp(native_out(str_cat(TMP, "/parse_run"))))

let anf_one(st, c) =
  let _ = write_file(str_cat(TMP, "/anfin.yac"), nth(c, 1)) in
  check(st, str_cat("anf ", nth(c, 0)), nth(c, 2), rchomp(native_out(str_cat(TMP, "/anf_run"))))

let lir_one(st, c) =
  let _ = write_file(str_cat(TMP, "/lirin.yac"), nth(c, 1)) in
  check(st, str_cat("lir ", nth(c, 0)), nth(c, 2), rchomp(native_out(str_cat(TMP, "/lir_run"))))

let pipe_one(st, c) =
  let _ = write_file(str_cat(TMP, "/pipein.yac"), nth(c, 1)) in
  let _ = run([str_cat(TMP, "/pipe_run")]) in
  if nth(run(["test", "-f", str_cat(TMP, "/pipe.bin")]), 0) != 0 then
    check(st, str_cat("pipe rc ", nth(c, 0)), nth(c, 2), "missing pipe.bin")
  else
    let _ = run(["chmod", "+x", str_cat(TMP, "/pipe.bin")]) in
    check(st, str_cat("pipe rc ", nth(c, 0)), nth(c, 2),
          int_to_str(nth(run([str_cat(TMP, "/pipe.bin")]), 0)))

let emit_one(st, c) =
  let _ = write_file(str_cat(TMP, "/emitin.yac"), nth(c, 1)) in
  let cr = run([str_cat(TMP, "/emit_run")]) in
  if nth(cr, 0) != 0 then
    check(st, nth(c, 0), "0", str_cat("emit_run rc=", int_to_str(nth(cr, 0))))
  else if nth(run(["test", "-f", str_cat(TMP, "/emit.bin")]), 0) != 0 then
    check(st, nth(c, 0), "wrote emit.bin", "missing")
  else
    let _ = run(["chmod", "+x", str_cat(TMP, "/emit.bin")]) in
    check(st, nth(c, 0), nth(c, 2), int_to_str(nth(run([str_cat(TMP, "/emit.bin")]), 0)))

let src_self_rel(n) =
  if n == "log.yac" then "lib/log.yac"
  else if n == "pass.yac" then "lib/pass.yac"
  else if n == "map.yac" then "lib/map.yac"
  else if n == "target.yac" then "back/pack/target.yac"
  else if n == "lexer.yac" then "front/lexer.yac"
  else if n == "parser.yac" then "front/parser.yac"
  else if n == "anf.yac" then "front/anf.yac"
  else if n == "cps.yac" then "front/cps.yac"
  else if n == "eval_cps.yac" then "front/eval_cps.yac"
  else if n == "uncps.yac" then "front/uncps.yac"
  else if n == "lir.yac" then "front/lir.yac"
  else if n == "runtime.yac" then "rt/runtime.yac"
  else if n == "elf.yac" then "back/pack/elf.yac"
  else if n == "pe.yac" then "back/pack/pe.yac"
  else if n == "macho.yac" then "back/pack/macho.yac"
  else if n == "pack.yac" then "back/pack/pack.yac"
  else if n == "lower.yac" then "back/lower.yac"
  else if n == "profile.yac" then "back/profile.yac"
  else if n == "backend.yac" then "back/backend.yac"
  else if n == "scheme.yac" then "lang/scheme.yac"
  else if n == "emit.yac" then "back/emit/emit.yac"
  else if str_slice(n, 0, 7) == "encode_" then str_cat("back/encode/", n)
  else if str_slice(n, 0, 5) == "emit_" then str_cat("back/emit/", n)
  else n

let src_self(names) =
  let rec(i, acc) =
    if i >= len(names) then acc
    else rec(i + 1, str_cat(acc, read_file(str_cat("src-self/", src_self_rel(nth(names, i)))))) in
  rec(0, "")

let unit_one(st, c) =
  let src = str_cat(str_cat(LOG_STUB, src_self(nth(c, 1))), nth(c, 2)) in
  let p = str_cat(TMP, "/unit.yac") in
  let _ = write_file(p, src) in
  let use_interp =
    if len(c) > 4 then
      if nth(c, 4) == "i" then true else false
    else false in
  if use_interp then
    let r = run(["./yac", p]) in
    if nth(r, 0) != 0 then
      check(st, nth(c, 0), nth(c, 3), str_cat("rc=", str_cat(int_to_str(nth(r, 0)), str_cat(" ", chomp(nth(r, 2))))))
    else check(st, nth(c, 0), nth(c, 3), chomp(nth(r, 1)))
  else
    let bin = str_cat(TMP, "/unit.bin") in
    let br = native_build(p, bin) in
    if nth(br, 0) != 0 then
      check(st, nth(c, 0), nth(c, 3), str_cat("yc_a rc=", int_to_str(nth(br, 0))))
    else
      let r = run([bin]) in
      let g = rchomp(nth(r, 1)) in
      let w = nth(c, 3) in
      let ok =
        if g == rchomp(w) then true
        else if g == rchomp(drop_print0(w)) then true
        else false in
      if ok then check(st, nth(c, 0), g, g)
      else check(st, nth(c, 0), w, g)

let lex_suite(st) =
  foldl(lex_one, st, [
    ["basic_let", "kw let\nident x\nop =\nnum 5\nkw in\nident x\nop +\nnum 1"],
    ["kw_fun", "kw let\nident f\nlparen (\nident x\nrparen )\nop =\nkw if\nident x\nop ==\nnum 0\nkw then\nnum 0\nkw else\nident f\nlparen (\nident x\nop -\nnum 1\nrparen )\nkw print\nstr hi"],
    ["scientific", "num 2.5e-3\nnum 1e10\nnum 1E5\nnum 1e2\nop -\nnum 3\nnum 2e-0\nnum 1.5e+3"],
    ["exp_ident", "ident e\nnum 5\nident e\nnum 1\nident e\nop +\nnum 1\nident e"],
    ["comments", "kw let\nident a\nop =\nnum 1\nkw let\nident b\nop =\nnum 2"],
    ["lambda", "kw let\nident g\nop =\nkw fun\nlparen (\nident a\ncomma ,\nident b\nrparen )\nop ->\nident a\nop >=\nnum 3.14\nkw and\nkw not\nlparen (\nident a\nop <\nident b\nrparen )"],
    ["starstar", "kw let\nident x\nop =\nnum 1"]])

let parse_suite(st) =
  foldl(parse_one, st, [
    ["int literal", "42", "[[int, 42]]"],
    ["var", "x", "[[var, x]]"],
    ["string", "\"hi\"", "[[str, hi]]"],
    ["bool", "true", "[[bool, true]]"],
    ["addition", "1 + 2", "[[binop, +, [int, 1], [int, 2]]]"],
    ["precedence", "1 + 2 * 3", "[[binop, +, [int, 1], [binop, *, [int, 2], [int, 3]]]]"],
    ["left assoc", "a - b - c", "[[binop, -, [binop, -, [var, a], [var, b]], [var, c]]]"],
    ["and or", "a and b or c", "[[binop, or, [binop, and, [var, a], [var, b]], [var, c]]]"],
    ["comparison", "x <= 1", "[[binop, <=, [var, x], [int, 1]]]"],
    ["unary minus", "-1", "[[binop, -, [int, 0], [int, 1]]]"],
    ["unary minus mul", "-x * 2", "[[binop, *, [binop, -, [int, 0], [var, x]], [int, 2]]]"],
    ["call", "f(1, 2)", "[[call, [var, f], [[int, 1], [int, 2]]]]"],
    ["nested call", "f(g(1))", "[[call, [var, f], [[call, [var, g], [[int, 1]]]]]]"],
    ["not", "not true", "[[not, [bool, true]]]"],
    ["list literal", "[1, 2, 3]", "[[list, [[int, 1], [int, 2], [int, 3]]]]"],
    ["if", "if a then b else c", "[[if, [var, a], [var, b], [var, c]]]"],
    ["lambda", "fun (x) -> x + 1", "[[fun, [x], [binop, +, [var, x], [int, 1]]]]"],
    ["lambda multi param", "fun (a, b) -> a * b", "[[fun, [a, b], [binop, *, [var, a], [var, b]]]]"],
    ["let bind", "let x = 5 in x + 1", "[[let, x, [int, 5], [binop, +, [var, x], [int, 1]]]]"],
    ["let fun", "let f(x) = if x == 0 then 0 else f(x - 1)", "[[let, f, [fun, [x], [if, [binop, ==, [var, x], [int, 0]], [int, 0], [call, [var, f], [[binop, -, [var, x], [int, 1]]]]]], [unit]]]"],
    ["let empty params", "let f() = 42 in f()", "[[let, f, [fun, [], [int, 42]], [call, [var, f], []]]]"],
    ["multi statement", "let x = 1;\nlet y = 2;\nx + y", "[[let, x, [int, 1], [unit]], [let, y, [int, 2], [unit]], [binop, +, [var, x], [var, y]]]"],
    ["newline statements", "1\n2", "[[int, 1], [int, 2]]"],
    ["factorial", "let fact(n) = if n <= 1 then 1 else n * fact(n - 1)\nprint fact(5)", "[[let, fact, [fun, [n], [if, [binop, <=, [var, n], [int, 1]], [int, 1], [binop, *, [var, n], [call, [var, fact], [[binop, -, [var, n], [int, 1]]]]]]], [unit]], [call, [var, print], [[call, [var, fact], [[int, 5]]], [bool, true]]]]"]])

let anf_suite(st) =
  foldl(anf_one, st, [
    ["literal", "42", "[[], [int, 42]]"],
    ["var", "x", "[[], [var, x]]"],
    ["addition", "1 + 2", "[[[letbin, t0, +, [int, 1], [int, 2]]], [var, t0]]"],
    ["precedence", "1 + 2 * 3", "[[[letbin, t0, *, [int, 2], [int, 3]], [letbin, t1, +, [int, 1], [var, t0]]], [var, t1]]"],
    ["if", "if x then 1 else 2", "[[[letif, t0, [var, x], [[], [int, 1]], [[], [int, 2]]]], [var, t0]]"],
    ["call", "f(1, 2)", "[[[letcall, t0, [var, f], [[int, 1], [int, 2]]]], [var, t0]]"],
    ["lambda", "fun (a) -> a + 1", "[[[letfun, t1, [a], [[[letbin, t0, +, [var, a], [int, 1]]], [var, t0]]]], [var, t1]]"],
    ["let bind", "let x = 5 in x + 1", "[[[let, x, [int, 5]], [letbin, t0, +, [var, x], [int, 1]]], [var, t0]]"],
    ["let if", "let x = if c then 1 else 2 in x + 1", "[[[letif, t0, [var, c], [[], [int, 1]], [[], [int, 2]]], [let, x, [var, t0]], [letbin, t1, +, [var, x], [int, 1]]], [var, t1]]"],
    ["nested if", "if a then if b then 1 else 2 else 3", "[[[letif, t1, [var, a], [[[letif, t0, [var, b], [[], [int, 1]], [[], [int, 2]]]], [var, t0]], [[], [int, 3]]]], [var, t1]]"],
    ["recursive fun", "let f(n) = if n == 0 then 0 else f(n - 1)", "[[[letfun, f, [n], [[[letbin, t0, ==, [var, n], [int, 0]], [letif, t3, [var, t0], [[], [int, 0]], [[[letbin, t1, -, [var, n], [int, 1]], [letcall, t2, [var, f], [[var, t1]]]], [var, t2]]]], [var, t3]]]], [unit]]"],
    ["curried closure", "let y = fun (a) -> fun (b) -> a + b in y(1)", "[[[letfun, y, [a], [[[letfun, t1, [b], [[[letbin, t0, +, [var, a], [var, b]]], [var, t0]]]], [var, t1]]], [letcall, t2, [var, y], [[int, 1]]]], [var, t2]]"],
    ["unary minus", "-5", "[[[letbin, t0, -, [int, 0], [int, 5]]], [var, t0]]"]])

let lir_suite(st) =
  foldl(lir_one, st, [
    ["literal", "42", "[[mov_imm, 1, 84]]"],
    ["addition", "1 + 2", "[[mov_imm, 1, 2], [mov_imm, 2, 4], [fcall, 3, yac_num_add, [1, 2]]]"],
    ["precedence", "1 + 2 * 3",
     "[[mov_imm, 1, 4], [mov_imm, 2, 6], [fcall, 3, yac_num_mul, [1, 2]], [mov_imm, 4, 2], [fcall, 5, yac_num_add, [4, 3]]]"],
    ["if true", "if true then 1 else 2",
     "[[mov_imm, 1, 2], [cmpjmp, 1, LIF0, LIF1], [label, LIF0], [mov_imm, 3, 2], [mov, 2, 3], [jmp, LIF2], [label, LIF1], [mov_imm, 3, 4], [mov, 2, 3], [label, LIF2]]"],
    ["if var", "if x then 1 else 2",
     "[[cmpjmp, 0, LIF0, LIF1], [label, LIF0], [mov_imm, 2, 2], [mov, 1, 2], [jmp, LIF2], [label, LIF1], [mov_imm, 2, 4], [mov, 1, 2], [label, LIF2]]"],
    ["let bind", "let x = 5 in x + 1",
     "[[mov_imm, 1, 10], [mov_imm, 2, 2], [fcall, 3, yac_num_add, [1, 2]]]"],
    ["letfun call", "let f(x) = x + 1 in f(2)",
     "[[closure, 1, f, []], [mov_imm, 2, 4], [fcall, 3, f, [2]]]"],
    ["unary minus", "-5", "[[mov_imm, 1, 0], [mov_imm, 2, 10], [fcall, 3, yac_num_sub, [1, 2]]]"],
    ["call", "f(1, 2)", "[[mov_imm, 1, 2], [mov_imm, 2, 4], [fcall, 3, f, [1, 2]]]"],
    ["lambda", "fun (a) -> a + 1", "[[closure, 1, t1, []]]"]])

let pipe_suite(st) =
  foldl(pipe_one, st, [
    ["1+2", "1 + 2\n", "3"],
    ["lit 42", "42\n", "42"],
    ["1+2*3", "1 + 2 * 3\n", "7"],
    ["if true", "if true then 1 else 2\n", "1"],
    ["let x+1", "let x = 5 in x + 1\n", "6"],
    ["letfun f(2)", "let f(x) = x + 1 in f(2)\n", "3"]])

let elf_suite(st) =
  let _ = cat_files(["src-self/back/pack/elf.yac", "src-self/drivers/driver_elf.yac"], str_cat(TMP, "/elf_run.yac")) in
  let br = native_build(str_cat(TMP, "/elf_run.yac"), str_cat(TMP, "/elf_run")) in
  if nth(br, 0) != 0 then
    check(st, "ELF magic", "ok", str_cat("yc_a rc=", int_to_str(nth(br, 0))))
  else
    let _ = run([str_cat(TMP, "/elf_run")]) in
    let elf = read_file(str_cat(TMP, "/elf.bin")) in
    let mag =
      if str_len(elf) < 5 then "short"
      else if str_ref(elf, 0) == 127 then
        if str_ref(elf, 1) == 69 then "ok" else "bad"
      else "bad" in
    let st1 = check(st, "ELF magic", "ok", mag) in
    let _ = run(["chmod", "+x", str_cat(TMP, "/elf.bin")]) in
    let st2 = check(st1, "ELF runs and exits 42", "42", int_to_str(nth(run([str_cat(TMP, "/elf.bin")]), 0))) in
    check(st2, "ELF size 136", "136", int_to_str(str_len(elf)))

let emit_suite(st) =
  let br = native_build(str_cat(TMP, "/emit_run.yac"), str_cat(TMP, "/emit_run")) in
  if nth(br, 0) != 0 then
    check(st, "emit_run yc_a", "ok", str_cat("yc_a rc=", int_to_str(nth(br, 0))))
  else
    let _ = write_file(str_cat(TMP, "/emitin.yac"),
      "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",2,0],[\"mov_imm\",1,21],[\"exit\",1]],\"_start\"]],\"_start\"]") in
    let mr = run([str_cat(TMP, "/emit_run")]) in
    if nth(mr, 0) != 0 then
      check(st, "emit ELF magic", "ok", str_cat("emit_run rc=", int_to_str(nth(mr, 0))))
    else
    let elf = read_file(str_cat(TMP, "/emit.bin")) in
    let mag =
      if str_len(elf) < 5 then "short"
      else if str_ref(elf, 0) == 127 then
        if str_ref(elf, 1) == 69 then
          if str_ref(elf, 2) == 76 then
            if str_ref(elf, 3) == 70 then
              if str_ref(elf, 4) == 2 then "ok" else "bad e_ident"
            else "bad e_ident"
          else "bad e_ident"
        else "bad e_ident"
      else "bad e_ident" in
    let st0 = check(st, "emit ELF magic", "ok", mag) in
    foldl(emit_one, st0, [
    ["mul 5*6", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",2,0],[\"mov_imm\",1,10],[\"mov_imm\",2,12],[\"mul\",1,1,2],[\"exit\",1]],\"_start\"]],\"_start\"]", "30"],
    ["div 17/5", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",3,0],[\"mov_imm\",1,34],[\"mov_imm\",2,10],[\"div\",3,1,2],[\"exit\",3]],\"_start\"]],\"_start\"]", "3"],
    ["mod 17%5", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",3,0],[\"mov_imm\",1,34],[\"mov_imm\",2,10],[\"rem\",3,1,2],[\"exit\",3]],\"_start\"]],\"_start\"]", "2"],
    ["expr (100-30)+2*4", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",5,0],[\"mov_imm\",1,200],[\"mov_imm\",2,60],[\"sub\",3,1,2],[\"mov_imm\",4,4],[\"mov_imm\",5,8],[\"mul\",4,4,5],[\"add\",3,3,4],[\"exit\",3]],\"_start\"]],\"_start\"]", "78"],
    ["branch 5<10 (true)", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",4,0],[\"mov_imm\",1,10],[\"mov_imm\",2,20],[\"cmp\",\"<\",3,1,2],[\"cmpjmp\",3,\"L1\",\"L2\"],[\"label\",\"L1\"],[\"mov_imm\",4,2],[\"exit\",4],[\"label\",\"L2\"],[\"mov_imm\",4,4],[\"exit\",4]],\"_start\"]],\"_start\"]", "1"],
    ["branch 20<10 (false)", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",4,0],[\"mov_imm\",1,40],[\"mov_imm\",2,20],[\"cmp\",\"<\",3,1,2],[\"cmpjmp\",3,\"L1\",\"L2\"],[\"label\",\"L1\"],[\"mov_imm\",4,2],[\"exit\",4],[\"label\",\"L2\"],[\"mov_imm\",4,4],[\"exit\",4]],\"_start\"]],\"_start\"]", "2"],
    ["branch 7==7 (true)", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",4,0],[\"mov_imm\",1,14],[\"mov_imm\",2,14],[\"cmp\",\"==\",3,1,2],[\"cmpjmp\",3,\"L1\",\"L2\"],[\"label\",\"L1\"],[\"mov_imm\",4,2],[\"exit\",4],[\"label\",\"L2\"],[\"mov_imm\",4,4],[\"exit\",4]],\"_start\"]],\"_start\"]", "1"],
    ["function call double(5)", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",2,0],[\"mov_imm\",1,10],[\"fcall\",2,\"double\",[1]],[\"exit\",2]],\"_start\"],[\"proc\",\"double\",1,0,[[\"local\",2,1],[\"mov\",2,1],[\"mov_imm\",4,4],[\"mul\",2,2,4],[\"ret\",2]],\"double\"]],\"_start\"]", "10"],
    ["recursion fact(5)", "[\"prog\",[[\"proc\",\"_start\",0,0,[[\"local\",2,0],[\"mov_imm\",1,10],[\"fcall\",2,\"fact\",[1]],[\"exit\",2]],\"_start\"],[\"proc\",\"fact\",1,0,[[\"local\",8,1],[\"mov_imm\",3,2],[\"cmp\",\"<=\",2,1,3],[\"cmpjmp\",2,\"L1\",\"L2\"],[\"label\",\"L1\"],[\"mov_imm\",3,2],[\"ret\",3],[\"label\",\"L2\"],[\"mov\",3,1],[\"mov_imm\",4,2],[\"sub\",5,3,4],[\"fcall\",6,\"fact\",[5]],[\"mul\",7,3,6],[\"ret\",7]],\"fact\"]],\"_start\"]", "120"]])

let unit_suite(st) =
  foldl(unit_one, st, [
    ["lir bin", ["map.yac", "lir.yac"], "print bin(\"+\", 1, 2, 3);\n0;\n", "[fcall, 1, yac_num_add, [2, 3]]\n0"],
    ["lexer tokenize", ["map.yac", "lexer.yac"], "print tokenize(\"let x = 5 in x + 1\");\nprint \"\";\n0;\n", "[[kw, let, 1], [ident, x, 1], [op, =, 1], [num, 5, 1], [kw, in, 1], [ident, x, 1], [op, +, 1], [num, 1, 1], [eof, , 1]]\n\n0"],
    ["lexer eq minus", ["map.yac", "lexer.yac"], "print tokenize(\"a=-1\");\nprint \"\";\n0;\n", "[[ident, a, 1], [op, =, 1], [op, -, 1], [num, 1, 1], [eof, , 1]]\n\n0"],
    ["lexer scientific", ["map.yac", "lexer.yac"], "print tokenize(\"2.5e-3 + 1e10\");\nprint \"\";\n0;\n", "[[num, 2.5e-3, 1], [op, +, 1], [num, 1e10, 1], [eof, , 1]]\n\n0"],
    ["elf pack_elf size", ["elf.yac"], "let b = bytes_new();\nlet _ = bytes_append(b, 144);\nlet elf = pack_elf(b);\nprint bytes_len(elf);\nprint \"\";\nprint bytes_ref(elf, 0);\nprint \"\";\nprint bytes_ref(elf, 1);\nprint \"\";\nprint bytes_ref(elf, 4);\nprint \"\";\n0;\n", "121\n\n127\n\n69\n\n2\n\n0"],
    ["pe mz magic", ["target.yac", "pe.yac"], "let t = mk_target(\"x86_64\", \"pe\", \"exec\");\nlet b = bytes_new();\nlet _ = bytes_append(b, 144);\nlet pe = pack_pe_target(t, b);\nprint bytes_ref(pe, 0);\nprint \"\";\nprint bytes_ref(pe, 1);\nprint \"\";\n0;\n", "77\n\n90\n\n0"],
    ["macho magic", ["target.yac", "macho.yac"], "let t = mk_target(\"x86_64\", \"macho\", \"exec\");\nlet b = bytes_new();\nlet _ = bytes_append(b, 144);\nlet m = pack_macho_target(t, b);\nprint bytes_ref(m, 0);\nprint \"\";\nprint bytes_ref(m, 1);\nprint \"\";\n0;\n", "207\n\n250\n\n0"],
    ["elf dylib et_dyn", ["target.yac", "elf.yac"], "let t = mk_target(\"x86_64\", \"elf\", \"dylib\");\nlet b = bytes_new();\nlet _ = bytes_append(b, 144);\nlet elf = pack_elf_ex(b, target_emachine(t), target_vaddr(t), target_text_off(t), 1);\nprint bytes_ref(elf, 16);\nprint \"\";\n0;\n", "3\n\n0"],
    ["target arm64 ids", ["target.yac"], "let t = mk_target(\"arm64\", \"elf\", \"exec\");\nprint target_arch(t);\nprint \"\";\nprint target_emachine(t);\nprint \"\";\n0;\n", "arm64\n\n183\n\n0"],
    ["target riscv64 ids", ["target.yac"], "let t = mk_target(\"riscv64\", \"elf\", \"exec\");\nprint target_arch(t);\nprint \"\";\nprint target_emachine(t);\nprint \"\";\n0;\n", "riscv64\n\n243\n\n0"],
    ["encode arm64 movz", ["encode_arm64.yac"], "let b = bytes_new();\nlet _ = a64_movz(b, 0, 42, 0);\nprint bytes_ref(b, 0);\nprint \"\";\nprint bytes_ref(b, 3);\nprint \"\";\n0;\n", "64\n\n210\n\n0"],
    ["encode arm64 sdiv", ["encode_arm64.yac"], "let b = bytes_new();\nlet _ = a64_sdiv(b, 0, 0, 1);\nprint bytes_ref(b, 0);\nprint \"\";\nprint bytes_ref(b, 1);\nprint \"\";\nprint bytes_ref(b, 2);\nprint \"\";\nprint bytes_ref(b, 3);\nprint \"\";\n0;\n", "0\n\n12\n\n193\n\n154\n\n0"],
    ["encode arm64 stp", ["encode_arm64.yac"], "let b = bytes_new();\nlet _ = a64_stp_fp_lr(b);\nprint bytes_ref(b, 0);\nprint \"\";\nprint bytes_ref(b, 1);\nprint \"\";\nprint bytes_ref(b, 2);\nprint \"\";\nprint bytes_ref(b, 3);\nprint \"\";\n0;\n", "253\n\n123\n\n191\n\n169\n\n0"],
    ["encode arm64 asr1", ["encode_arm64.yac"], "let b = bytes_new();\nlet _ = a64_asr1(b, 0, 0);\nprint bytes_ref(b, 0);\nprint \"\";\nprint bytes_ref(b, 1);\nprint \"\";\nprint bytes_ref(b, 2);\nprint \"\";\nprint bytes_ref(b, 3);\nprint \"\";\n0;\n", "224\n\n7\n\n128\n\n139\n\n0"],
    ["encode riscv addi", ["encode_riscv64.yac"], "let b = bytes_new();\nlet _ = rv_addi(b, 10, 0, 42);\nprint bytes_len(b);\nprint \"\";\n0;\n", "4\n\n0"],
    ["encode riscv li32 keeps rd", ["encode_riscv64.yac"], "let b = bytes_new();\nlet _ = rv_li32_pair(b, 5, 0);\nlet _ = rv_li32_at(b, 0, 6, 4096);\nprint bytes_ref(b, 0);\nprint \"\";\nprint bytes_ref(b, 1);\nprint \"\";\n0;\n", "183\n\n18\n\n0"],
    ["parser precedence", ["map.yac", "lexer.yac", "parser.yac"], "let src = \"1 + 2 * 3\";\nlet toks = tokenize(src);\nlet prog = parse_program(toks, 0, []);\nprint prog;\n0;\n", "[[binop, +, [int, 1], [binop, *, [int, 2], [int, 3]]]]\n0"],
    ["parser let fun", ["map.yac", "lexer.yac", "parser.yac"], "let src = \"let f(x) = if x == 0 then 0 else f(x - 1)\";\nlet toks = tokenize(src);\nlet prog = parse_program(toks, 0, []);\nprint prog;\n0;\n", "[[let, f, [fun, [x], [if, [binop, ==, [var, x], [int, 0]], [int, 0], [call, [var, f], [[binop, -, [var, x], [int, 1]]]]]], [unit]]]\n0"],
    ["parser unclosed call", ["map.yac", "lexer.yac", "parser.yac"], "let src = \"hi(\";\nlet toks = tokenize(src);\nlet prog = parse_program(toks, 0, []);\nprint nth(nth(prog, 0), 0);\n0;\n", "error\n0"],
    ["parser bare print", ["map.yac", "lexer.yac", "parser.yac"], "let src = \"print\";\nlet toks = tokenize(src);\nlet prog = parse_program(toks, 0, []);\nlet e = if prog_has_err(prog, 0) then 1 else 0 in\nprint e;\n0;\n", "1\n0"],
    ["parser bare not", ["map.yac", "lexer.yac", "parser.yac"], "let src = \"not\";\nlet toks = tokenize(src);\nlet prog = parse_program(toks, 0, []);\nlet e = if prog_has_err(prog, 0) then 1 else 0 in\nprint e;\n0;\n", "1\n0"],
    ["anf precedence", ["map.yac", "lexer.yac", "parser.yac", "anf.yac"], "let ast = [\"binop\", \"+\", [\"int\", \"1\"], [\"binop\", \"*\", [\"int\", \"2\"], [\"int\", \"3\"]]];\nlet r = anf_expr(ast, 0);\nprint [nth(r, 0), nth(r, 1)];\n0;\n", "[[[letbin, t0, *, [int, 2], [int, 3]], [letbin, t1, +, [int, 1], [var, t0]]], [var, t1]]\n0"],
    ["cps addition", ["map.yac", "anf.yac", "cps.yac"], "let r = anf_expr([\"binop\", \"+\", [\"int\", \"1\"], [\"int\", \"2\"]], 0);\nlet st = box_new();\nlet _ = box_set(st, 0);\nprint cps_expr([nth(r, 0), nth(r, 1)], [\"halt\"], st);\n0;\n", "[call, [prim, +], [[int, 1], [int, 2], [cont, #k0, [let, t0, [var, #k0], [halt, [var, t0]]]]]]\n0"],
    ["uncps addition", ["map.yac", "anf.yac", "cps.yac", "uncps.yac"], "let r = anf_expr([\"binop\", \"+\", [\"int\", \"1\"], [\"int\", \"2\"]], 0);\nlet st = box_new();\nlet _ = box_set(st, 0);\nlet c = cps_expr([nth(r, 0), nth(r, 1)], [\"halt\"], st);\nlet u = box_new();\nlet _ = box_set(u, 0);\nlet st2 = box_new();\nlet _ = box_set(st2, 0);\nprint uncps_item(c, u, st2);\n0;\n", "[[[letbin, #k0, +, [int, 1], [int, 2]], [let, t0, [var, #k0]]], [var, t0]]\n0"],
    ["cps opt add", ["map.yac", "anf.yac", "cps.yac"], "let r = anf_expr([\"binop\", \"+\", [\"int\", \"1\"], [\"int\", \"2\"]], 0);\nlet st = box_new();\nlet _ = box_set(st, 0);\nprint cps_opt_one(cps_expr([nth(r, 0), nth(r, 1)], [\"halt\"], st));\n0;\n", "[call, [cont, #k0, [let, t0, [var, #k0], [halt, [var, t0]]]], [[int, 3]]]\n0"],
    ["eval cps add", ["map.yac", "anf.yac", "cps.yac", "eval_cps.yac"], "let r = anf_expr([\"binop\", \"+\", [\"int\", \"1\"], [\"int\", \"2\"]], 0);\nlet st = box_new();\nlet _ = box_set(st, 0);\nlet c = cps_expr([nth(r, 0), nth(r, 1)], [\"halt\"], st);\nlet e = eval_cps_all([c]);\nprint nth(e, 1);\n0;\n", "3\n0"],
    ["eval cps eq list", ["map.yac", "anf.yac", "cps.yac", "eval_cps.yac"], "let r = anf_expr([\"binop\", \"==\", [\"list\", [[\"int\", \"1\"], [\"int\", \"2\"]]], [\"list\", [[\"int\", \"1\"], [\"int\", \"2\"]]]], 0);\nlet st = box_new();\nlet _ = box_set(st, 0);\nlet c = cps_expr([nth(r, 0), nth(r, 1)], [\"halt\"], st);\nlet e = eval_cps_all([c]);\nprint nth(e, 1);\n0;\n", "1\n0"],
    ["scheme plus", ["scheme.yac"], "print scheme_to_yac(\"(+ 1 2)\");\n0;\n", "(1 + 2);\n\n0"],
    ["scheme define fun", ["scheme.yac"], "print scheme_to_yac(\"(define (f x) (+ x 1))\");\n0;\n", "let f(x) = ((x + 1));\n\n0"],
    ["scheme cond", ["scheme.yac"], "print scheme_to_yac(\"(cond ((< 1 0) 1) (else 2))\");\n0;\n", "(if (1 < 0) then 1 else 2);\n\n0"],
    ["scheme map", ["scheme.yac"], "print scheme_to_yac(\"(map f xs)\");\n0;\n", "map(f, xs);\n\n0"],
    ["scheme read-file", ["scheme.yac"], "print scheme_to_yac(\"(read-file \\\"x\\\")\");\n0;\n", "read_file(\"x\");\n\n0"],
    ["scheme str-len", ["scheme.yac"], "print scheme_to_yac(\"(str-len \\\"ab\\\")\");\n0;\n", "str_len(\"ab\");\n\n0"],
    ["scheme write-file", ["scheme.yac"], "print scheme_to_yac(\"(write-file \\\"a\\\" \\\"b\\\")\");\n0;\n", "write_file(\"a\", \"b\");\n\n0"],
    ["scheme apply", ["scheme.yac"], "print scheme_to_yac(\"(apply f 1 2)\");\n0;\n", "f(1, 2);\n\n0"],
    ["scheme set!", ["scheme.yac"], "print scheme_to_yac(\"(set! x 1)\");\n0;\n", "error: unsupported Scheme form 'set!'\n0"],
    ["scheme zero arity", ["scheme.yac"], "print scheme_to_yac(\"(define (f) 1)\");\n0;\n", "error: zero-argument functions are not supported\n0"],
    ["lir free_vars", ["map.yac", "lir.yac"], "let body = [ [[\"letbin\", \"t0\", \"+\", [\"var\",\"n\"], [\"var\",\"x\"]]], [\"var\",\"t0\"] ];\nprint free_vars(body, [\"n\"], []);\n0;\n", "[x]\n0"],
    ["lir free_vars nested", ["map.yac", "lir.yac"], "let body = [ [[\"letfun\",\"g\",[\"m\"], [ [[\"letbin\",\"s0\",\"+\",[\"var\",\"n\"],[\"var\",\"m\"]]], [\"var\",\"s0\"] ]]],\n              [\"var\",\"g\"] ];\nprint free_vars(body, [\"n\"], []);\n0;\n", "[]\n0"],
    ["lir str_to_int", ["map.yac", "lir.yac"], "print str_to_int(\"42\");\n0;\n", "42\n0"],
    ["encode mov_r64_imm rax", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = mov_r64_imm(b, 0, 60);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "72\n199\n192\n60\n0\n0\n0\n0"],
    ["encode push/pop rbp", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = push_rbp(b); let _ = pop_rbp(b);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "85\n93\n0"],
    ["encode ret", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = ret(b);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "195\n0"],
    ["encode syscall", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = syscall(b);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "15\n5\n0"],
    ["encode mov_rbp_rsp", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = mov_rbp_rsp(b);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "72\n137\n229\n0"],
    ["encode jmp_rel32", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = jmp_rel32(b, 0);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "233\n0\n0\n0\n0\n0"],
    ["encode mov_r64_r64", ["encode_x64.yac"], "let b = bytes_new();\nlet _ = mov_r64_r64(b, 0, 1);\nlet dump(n) = if n >= bytes_len(b) then 0 else\n  let _ = print bytes_ref(b, n) in\n  dump(n + 1);\nlet _ = dump(0);\n0;\n", "72\n137\n200\n0"]])

let main =
  let _ = print("") in
  let _ = print("=== boot  yc_a ===") in
  let _ = run(["mkdir", "-p", TMP]) in
  let _ = cat_files(["src-self/lib/map.yac", "src-self/front/lexer.yac", "src-self/drivers/driver_lex.yac"], str_cat(TMP, "/lex_run.yac")) in
  let _ = cat_files(["src-self/lib/map.yac", "src-self/front/lexer.yac", "src-self/front/parser.yac", "src-self/drivers/driver_parse.yac"], str_cat(TMP, "/parse_run.yac")) in
  let _ = cat_files(["src-self/lib/map.yac", "src-self/front/lexer.yac", "src-self/front/parser.yac", "src-self/front/anf.yac", "src-self/drivers/driver_anf.yac"], str_cat(TMP, "/anf_run.yac")) in
  let _ = cat_files(["src-self/lib/map.yac", "src-self/front/lexer.yac", "src-self/front/parser.yac", "src-self/front/anf.yac", "src-self/front/lir.yac", "src-self/drivers/driver_lir.yac"], str_cat(TMP, "/lir_run.yac")) in
  let _ = write_file(str_cat(TMP, "/log_stub.yac"), LOG_STUB) in
  let _ = write_file(str_cat(TMP, "/emit_stub.yac"), EMIT_STUB) in
  let _ = cat_files([str_cat(TMP, "/log_stub.yac"),
                     "src-self/back/pack/target.yac",
                     "src-self/lib/map.yac",
                     "src-self/front/lexer.yac", "src-self/front/parser.yac",
                     "src-self/back/encode/encode_x64.yac",
                     "src-self/back/encode/encode_arm64.yac",
                     "src-self/back/encode/encode_riscv64.yac",
                     "src-self/back/pack/elf.yac",
                     "src-self/front/lir.yac",
                     "src-self/back/emit/emit.yac", "src-self/back/emit/emit_x86_64.yac",
                     str_cat(TMP, "/emit_stub.yac"),
                     "src-self/back/lower.yac",
                     "src-self/drivers/driver_emit.yac"],
                    str_cat(TMP, "/emit_run.yac")) in
  let _ = cat_files([str_cat(TMP, "/log_stub.yac"),
                     "src-self/back/pack/target.yac",
                     "src-self/lib/map.yac",
                     "src-self/front/lexer.yac", "src-self/front/parser.yac",
                     "src-self/front/anf.yac",
                     "src-self/back/encode/encode_x64.yac",
                     "src-self/back/encode/encode_arm64.yac",
                     "src-self/back/encode/encode_riscv64.yac",
                     "src-self/back/pack/elf.yac",
                     "src-self/front/lir.yac", "src-self/rt/runtime.yac",
                     "src-self/back/emit/emit.yac", "src-self/back/emit/emit_x86_64.yac",
                     str_cat(TMP, "/emit_stub.yac"),
                     "src-self/back/lower.yac",
                     "src-self/drivers/driver_pipe.yac"],
                    str_cat(TMP, "/pipe_run.yac")) in
  let _ = native_build(str_cat(TMP, "/lex_run.yac"), str_cat(TMP, "/lex_run")) in
  let _ = native_build(str_cat(TMP, "/parse_run.yac"), str_cat(TMP, "/parse_run")) in
  let _ = native_build(str_cat(TMP, "/anf_run.yac"), str_cat(TMP, "/anf_run")) in
  let _ = native_build(str_cat(TMP, "/lir_run.yac"), str_cat(TMP, "/lir_run")) in
  let _ = native_build(str_cat(TMP, "/pipe_run.yac"), str_cat(TMP, "/pipe_run")) in
  let st0 = lex_suite([0, 0]) in
  let st1 = parse_suite(st0) in
  let st2 = anf_suite(st1) in
  let stL = lir_suite(st2) in
  let stP = pipe_suite(stL) in
  let st3 = elf_suite(stP) in
  let st4 = emit_suite(st3) in
  let st5 = unit_suite(st4) in
  let _ = print("") in
  let _ = print(str_cat(int_to_str(nth(st5, 0)),
                 str_cat(" passed, ",
                   str_cat(int_to_str(nth(st5, 1)), " failed")))) in
  if nth(st5, 1) == 0 then exit(0) else exit(1)
in main
