let main =
  let _ = run(["mkdir", "-p", TMP]) in
  let _ = cat_files(["src-self/lexer.yac", "src-self/driver_lex.yac"], str_cat(TMP, "/lex_run.yac")) in
  let _ = cat_files(["src-self/lexer.yac", "src-self/parser.yac", "src-self/driver_parse.yac"], str_cat(TMP, "/parse_run.yac")) in
  let _ = cat_files(["src-self/lexer.yac", "src-self/parser.yac", "src-self/anf.yac", "src-self/driver_anf.yac"], str_cat(TMP, "/anf_run.yac")) in
  let _ = native_build(str_cat(TMP, "/lex_run.yac"), str_cat(TMP, "/lex_run")) in
  let st0 = lex_suite([0, 0]) in
  let st1 = parse_suite(st0) in
  let st2 = anf_suite(st1) in
  let st3 = elf_suite(st2) in
  let st4 = emit_suite(st3) in
  let st5 = unit_suite(st4) in
  let _ = print("") in
  let _ = print(str_cat(int_to_str(nth(st5, 0)),
                 str_cat(" passed, ",
                   str_cat(int_to_str(nth(st5, 1)), " failed")))) in
  if nth(st5, 1) == 0 then exit(0) else exit(1)
in main
