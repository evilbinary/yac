{
  "comments": {
    "lineComment": "--",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] },
    { "open": "/**", "close": "**/", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "([A-Za-z_\\u0080-\\uFFFF][A-Za-z0-9_\\u0080-\\uFFFF]*)|([0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(let\\b.*(=|\\bin\\b)\\s*$|fun\\b.*->\\s*$|if\\b.*then\\s*$|else\\s*$)",
    "decreaseIndentPattern": "^\\s*(in\\b|else\\b|then\\b)"
  }
}
