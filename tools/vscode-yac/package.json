{
  "name": "yac",
  "displayName": "Yac",
  "description": "Syntax highlighting for the Yac functional language",
  "version": "0.1.1",
  "publisher": "yac-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/evilbinary/yac.git",
    "directory": "tools/vscode-yac"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "yac",
    "functional",
    "anf",
    "cps"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yac",
        "aliases": [
          "Yac",
          "yac"
        ],
        "extensions": [
          ".yac"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/yac.svg",
          "dark": "./icons/yac.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "yac",
        "scopeName": "source.yac",
        "path": "./syntaxes/yac.tmLanguage.json"
      }
    ]
  }
}
