/* YUI bindings. Pair with yui_yac.c / libyui_yac.so. JSON onClick: "yac_click". */

import rt.ffi

let yui_open(path) = cload(path)

let yui_init(json, assets) = ccall(csym("yui_yac_init"), json, assets)

let yui_tick(_) = ccall(csym("yui_yac_tick"))

let yui_set_text(id, text) = ccall(csym("yui_yac_set_text"), id, text)

let yui_click_is(id) = ccall(csym("yui_yac_click_is"), id)

let yui_shutdown(_) = ccall(csym("yui_yac_shutdown"))

let yui_game_boot(path) = ccall(csym("yui_yac_game_boot"), path)

let yui_key(name) = ccall(csym("yui_yac_game_key"), name)

let yui_game_vel(id, vx, vy) = ccall(csym("yui_yac_game_vel"), id, vx, vy)

let yui_game_get(id, which) = ccall(csym("yui_yac_game_get"), id, which)

let yui_game_pos(id, x, y) = ccall(csym("yui_yac_game_pos"), id, x, y)

let yui_game_spawn(id, tag, x, y, rgb) =
  ccall(csym("yui_yac_game_spawn"), id, tag, x, y, rgb)

let yui_game_box(id, w, h) = ccall(csym("yui_yac_game_box"), id, w, h)

let yui_game_hit(id, tag) = ccall(csym("yui_yac_game_hit"), id, tag)

let yui_game_cull(tag, ymax) = ccall(csym("yui_yac_game_cull"), tag, ymax)

let yui_game_burst(x, y, rgb) = ccall(csym("yui_yac_game_burst"), x, y, rgb)

let yui_rand(n) = ccall(csym("yui_yac_rand"), n)
