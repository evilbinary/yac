let so =
  if argc() > 2 then argv(2)
  else "app/native/libyui_yac.so"

let json =
  if argc() > 1 then argv(1)
  else "app/counter/ui.json"

let h = yui_open(so)

let rc =
  if h == 0 then
    let _ = print("yui: cload failed") in 1
  else
    let ir = yui_init(json, "") in
    if ir != 0 then
      let _ = print("yui: init failed") in 1
    else
      let rec(n) =
        let q = yui_tick(0) in
        if q != 0 then 0
        else
          let n1 =
            if yui_click_is("plus") != 0 then n + 1
            else if yui_click_is("minus") != 0 then n - 1
            else if yui_click_is("reset") != 0 then 0
            else n in
          let _ =
            if n1 != n then yui_set_text("count", int_to_str(n1))
            else 0 in
          rec(n1) in
      let _ = rec(0) in
      let _ = yui_shutdown(0) in
      0

rc
