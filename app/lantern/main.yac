import yui

let so =
  if argc() > 2 then argv(2)
  else "app/native/libyui_yac.so"

let json =
  if argc() > 1 then argv(1)
  else "app/lantern/ui.json"

let scene = "app/lantern/scene.json"

let h = yui_open(so)

let ax(neg, pos) =
  if yui_key(neg) != 0 then 0 - 170
  else if yui_key(pos) != 0 then 170
  else 0

let clamp(id, lo, hi, which) =
  let v = yui_game_get(id, which) in
  if v < lo then lo
  else if v > hi then hi
  else v

let mote(kind, rgb, t) =
  let x = 24 + yui_rand(580) in
  let id = str_cat(kind, int_to_str(t)) in
  let _ = yui_game_spawn(id, kind, x, 0 - 18, rgb) in
  let _ = yui_game_box(id, 14, 14) in
  yui_game_vel(id, 0, 55 + yui_rand(50))

let rc =
  if h == 0 then
    let _ = print("yui: cload failed") in 1
  else
    let ir = yui_init(json, "") in
    if ir != 0 then
      let _ = print("yui: init failed") in 1
    else
      let br = yui_game_boot(scene) in
      if br != 0 then
        let _ = print("yui: game boot failed") in 1
      else
        let rec(score, t) =
          let q = yui_tick(0) in
          if q != 0 then score
          else if yui_click_is("quit") != 0 then score
          else
            let vx = ax("Left", "Right") in
            let vx2 =
              if vx != 0 then vx
              else ax("A", "D") in
            let vy = ax("Up", "Down") in
            let vy2 =
              if vy != 0 then vy
              else ax("W", "S") in
            let _ = yui_game_vel("moth", vx2, vy2) in
            let mx = clamp("moth", 16, 600, 0) in
            let my = clamp("moth", 48, 360, 1) in
            let _ = yui_game_pos("moth", mx, my) in
            let eat = yui_game_hit("moth", "ember") in
            let hit = yui_game_hit("moth", "ash") in
            let score1 =
              if eat != 0 then score + 1
              else if hit != 0 then
                if score < 1 then 0 else score - 1
              else score in
            let _ =
              if eat != 0 then yui_game_burst(mx, my, 16760806)
              else if hit != 0 then yui_game_burst(mx, my, 6056826)
              else 0 in
            let _ = yui_game_cull("ember", 400) in
            let _ = yui_game_cull("ash", 400) in
            let _ =
              if irem(t, 26) == 0 then
                if yui_rand(4) == 0 then mote("ash", 6056826, t)
                else mote("ember", 16758215, t)
              else 0 in
            let _ =
              if score1 != score then
                yui_set_text("score", str_cat("Embers ", int_to_str(score1)))
              else 0 in
            rec(score1, t + 1) in
        let _ = rec(0, 0) in
        let _ = yui_shutdown(0) in
        0

rc
