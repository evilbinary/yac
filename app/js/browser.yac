/* browser.yac — no-op browser/DOM/Audio host stubs for lang.js (B-tier).
 *
 * Browser-only code (Howler.js and friends) probes `window`/`document`/
 * `AudioContext`/... before doing real work. Under lang.js every unknown
 * global is a box holding 0, so each probe call errors and the bundle spends
 * its whole run printing "not a function". Programs that reference any of the
 * names in lang.js's stub table instead import this package and get these
 * singletons bound into their global boxes.
 *
 * Design rules (all no-op semantics, nothing here touches real OS audio):
 *   - every stub is a zero-recursion singleton;
 *   - every method is a `...a` rest function, so any call arity matches;
 *   - missing members read as 0 through _js_get (proto chain bottoms out);
 *   - chainable nodes point back at themselves (gain.gain.gain... works);
 *   - canPlayType -> "probably", decodeAudioData invokes the success
 *     callback so the WebAudio graph builds end-to-end;
 *   - XHR send is a no-op, so network loads stay pending silently;
 *   - timers/rAF never fire (no scheduler in the js runtime yet). */

package js.browser
export _js_st_win0, _js_st_doc0, _js_st_nav0, _js_st_loc0, _js_st_perf0,
  _js_st_store0, _js_st_xhrC, _js_st_ctxC, _js_st_audioC, _js_st_noop,
  _js_st_false, _js_st_empty, _js_st_id, _js_st_spin, js_browser_stub
import data.fmap { fmap_new, fmap_get, fmap_put }
import gui.yui { yui_bridge_open, yui_bridge_boot, yui_bridge_create, yui_bridge_del, yui_bridge_put_text, yui_bridge_pump }

/* TEMP diagnostics: name the callee before the runtime rejects it. */
let _jb_ck(f, t) =
  let _ = if kind(f) == 6 then 0
    else print(str_cat("dbg: bad jb callee ", str_cat(t, str_cat(" kind=", str_cat(int_to_str(kind(f)), str_cat(" v=", int_to_str(f))))))) in
  f

/* Name table: JS global identifier -> stub singleton exported above.
 * Returns "" for names that are not stubbed (lang.js keeps box(0) for those).
 * lang.js calls this while emitting a program to decide which names to import
 * and which boxes to bind to stubs. */
let js_browser_stub(nm) =
  if nm == "window" or nm == "self" or nm == "globalThis" or nm == "top" or nm == "parent" then "_js_st_win0"
  else if nm == "document" then "_js_st_doc0"
  else if nm == "navigator" then "_js_st_nav0"
  else if nm == "location" then "_js_st_loc0"
  else if nm == "performance" then "_js_st_perf0"
  else if nm == "localStorage" or nm == "sessionStorage" then "_js_st_store0"
  else if nm == "XMLHttpRequest" then "_js_st_xhrC"
  else if nm == "AudioContext" or nm == "webkitAudioContext" then "_js_st_ctxC"
  else if nm == "Audio" or nm == "HTMLAudioElement" then "_js_st_audioC"
  else if nm == "setTimeout" or nm == "setInterval" or nm == "clearTimeout" or nm == "clearInterval"
    or nm == "requestAnimationFrame" or nm == "cancelAnimationFrame" or nm == "fetch"
    or nm == "alert" or nm == "getComputedStyle" or nm == "matchMedia" then "_js_st_noop"
  else if nm == "confirm" then "_js_st_false"
  else if nm == "prompt" then "_js_st_empty"
  else if nm == "yuiSpinFrames" then "_js_st_spin"
  else if nm == "btoa" or nm == "atob" or nm == "escape" or nm == "unescape" then "_js_st_id"
  else ""

/* DOM bridge hooks. A VALUE defined before the singletons (so its static cell
 * exists) and filled at the END of this file with the _dom_* implementations.
 * The doc methods below reach the bridge through it, which keeps every bridge
 * function in this same package and free of cross-package cell reads. */
let _dom_hooks = ["$o", fmap_new(0)]
let _dom_hook(nm) = fmap_get(nth(_dom_hooks, 1), nm)

let _js_st_noop(...a) = 0
let _js_st_false(...a) = false
let _js_st_empty(...a) = ""
let _js_st_id(x) = x
let _js_st_spin(n) = (_dom_hook("spin"))(n)

/* Universal AudioNode: chainable members point back at itself. */
let _js_st_node0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_node0, 1), "connect", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "start", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "stop", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "disconnect", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "removeEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "gain", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "playbackRate", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "detune", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "frequency", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "Q", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "pan", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "destination", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "value", 0)
let _ = fmap_put(nth(_js_st_node0, 1), "currentTime", 0.0)
let _ = fmap_put(nth(_js_st_node0, 1), "duration", 0.0)
let _ = fmap_put(nth(_js_st_node0, 1), "sampleRate", 48000)
let _ = fmap_put(nth(_js_st_node0, 1), "state", "running")
let _ = fmap_put(nth(_js_st_node0, 1), "numberOfInputs", 1)
let _ = fmap_put(nth(_js_st_node0, 1), "numberOfOutputs", 1)
let _ = fmap_put(nth(_js_st_node0, 1), "channelCount", 2)
let _ = fmap_put(nth(_js_st_node0, 1), "onended", 0)
let _ = fmap_put(nth(_js_st_node0, 1), "buffer", 0)

/* Universal DOM element (doubles as document.documentElement/body/head). */
let _js_st_elem0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_elem0, 1), "style", ["$o", fmap_new(0)])
let _ = fmap_put(nth(_js_st_elem0, 1), "appendChild", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "removeChild", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "setAttribute", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "getAttribute", _js_st_empty)
let _ = fmap_put(nth(_js_st_elem0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "removeEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "canPlayType", fun(...a) -> "probably")
let _ = fmap_put(nth(_js_st_elem0, 1), "pause", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "load", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "play", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "getElementsByTagName", fun(...a) -> [])
let _ = fmap_put(nth(_js_st_elem0, 1), "textContent", "")
let _ = fmap_put(nth(_js_st_elem0, 1), "innerHTML", "")
let _ = fmap_put(nth(_js_st_elem0, 1), "src", "")
let _ = fmap_put(nth(_js_st_elem0, 1), "parentNode", 0)
let _ = fmap_put(nth(_js_st_elem0, 1), "children", [])
let _ = fmap_put(nth(_js_st_elem0, 1), "childNodes", [])
/* Inline stylesheet members: `document.styleSheets[0].insertRule(...)`. */
let _ = fmap_put(nth(_js_st_elem0, 1), "insertRule", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "deleteRule", _js_st_noop)
let _ = fmap_put(nth(_js_st_elem0, 1), "cssRules", [])
let _ = fmap_put(nth(_js_st_elem0, 1), "documentElement", _js_st_elem0)
let _ = fmap_put(nth(_js_st_elem0, 1), "body", _js_st_elem0)
let _ = fmap_put(nth(_js_st_elem0, 1), "head", _js_st_elem0)
/* `document.styleSheets[0].sheet.insertRule(...)`: the fake sheet is the
 * element itself, so `.sheet` chains back to the insertRule member above. */
let _ = fmap_put(nth(_js_st_elem0, 1), "sheet", _js_st_elem0)

let _js_st_doc0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_doc0, 1), "createElement", fun(tag) -> (_dom_hook("createElement"))(tag))
let _ = fmap_put(nth(_js_st_doc0, 1), "createElementNS", fun(tag) -> (_dom_hook("createElement"))(tag))
let _ = fmap_put(nth(_js_st_doc0, 1), "appendChild", _js_st_noop)
let _ = fmap_put(nth(_js_st_doc0, 1), "createTextNode", fun(txt) -> (_dom_hook("createText"))(txt))
let _ = fmap_put(nth(_js_st_doc0, 1), "createEvent", fun(...a) -> (_dom_hook("createElement"))("#event"))
let _ = fmap_put(nth(_js_st_doc0, 1), "getElementById", fun(id) -> (_dom_hook("document"))(id))
let _ = fmap_put(nth(_js_st_doc0, 1), "getElementsByTagName", fun(...a) -> [])
let _ = fmap_put(nth(_js_st_doc0, 1), "querySelector", fun(sel) -> (_dom_hook("document"))(sel))
let _ = fmap_put(nth(_js_st_doc0, 1), "querySelectorAll", fun(...a) -> [])
let _ = fmap_put(nth(_js_st_doc0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_doc0, 1), "removeEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_doc0, 1), "documentElement", _js_st_elem0)
let _ = fmap_put(nth(_js_st_doc0, 1), "body", _js_st_elem0)
let _ = fmap_put(nth(_js_st_doc0, 1), "head", _js_st_elem0)
let _ = fmap_put(nth(_js_st_doc0, 1), "hidden", false)
let _ = fmap_put(nth(_js_st_doc0, 1), "visibilityState", "visible")
let _ = fmap_put(nth(_js_st_doc0, 1), "readyState", "complete")
let _ = fmap_put(nth(_js_st_doc0, 1), "cookie", "")
/* One fake inline sheet so `document.styleSheets[0].insertRule` works. */
let _ = fmap_put(nth(_js_st_doc0, 1), "styleSheets", [_js_st_elem0])

let _js_st_nav0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_nav0, 1), "userAgent", "Mozilla/5.0 (yac)")
let _ = fmap_put(nth(_js_st_nav0, 1), "platform", "yac")
let _ = fmap_put(nth(_js_st_nav0, 1), "language", "en")
let _ = fmap_put(nth(_js_st_nav0, 1), "languages", ["en"])
let _ = fmap_put(nth(_js_st_nav0, 1), "maxTouchPoints", 0)

let _js_st_loc0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_loc0, 1), "href", "file:///")
let _ = fmap_put(nth(_js_st_loc0, 1), "protocol", "file:")
let _ = fmap_put(nth(_js_st_loc0, 1), "host", "")
let _ = fmap_put(nth(_js_st_loc0, 1), "hostname", "")
