let _js_st_perf0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_perf0, 1), "now", fun(...a) -> 0.0)
let _ = fmap_put(nth(_js_st_perf0, 1), "timeOrigin", 0.0)

let _js_st_store0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_store0, 1), "getItem", fun(...a) -> 0)
let _ = fmap_put(nth(_js_st_store0, 1), "setItem", _js_st_noop)
let _ = fmap_put(nth(_js_st_store0, 1), "removeItem", _js_st_noop)
let _ = fmap_put(nth(_js_st_store0, 1), "clear", _js_st_noop)
