/* browser.yac — no-op browser/DOM/Audio host stubs for lang.js (B-tier).
 *
 * Browser-only code (Howler.js and friends) probes `window`/`document`/
 * `AudioContext`/... before doing real work. Under lang.js every unknown
 * global is a box holding 0, so each probe call errors and the bundle spends
 * its whole run printing "not a function". Programs that reference any of the
 * names in lang.js's stub table instead import this package and get these
 * singletons bound into their global boxes.
 *
 * Design rules (all no-op semantics, nothing here touches real OS audio):
 *   - every stub is a zero-recursion singleton;
 *   - every method is a `...a` rest function, so any call arity matches;
 *   - missing members read as 0 through _js_get (proto chain bottoms out);
 *   - chainable nodes point back at themselves (gain.gain.gain... works);
 *   - canPlayType -> "probably", decodeAudioData invokes the success
 *     callback so the WebAudio graph builds end-to-end;
 *   - XHR send is a no-op, so network loads stay pending silently;
 *   - timers/rAF never fire (no scheduler in the js runtime yet). */

package js.browser
export _js_st_win0, _js_st_doc0, _js_st_nav0, _js_st_loc0, _js_st_perf0,
  _js_st_store0, _js_st_xhrC, _js_st_ctxC, _js_st_audioC, _js_st_noop,
  _js_st_false, _js_st_empty, _js_st_id, js_browser_stub
import data.fmap { fmap_new, fmap_put }

/* TEMP diagnostics: name the callee before the runtime rejects it. */
let _jb_ck(f, t) =
  let _ = if kind(f) == 6 then 0
    else print(str_cat("dbg: bad jb callee ", str_cat(t, str_cat(" kind=", str_cat(int_to_str(kind(f)), str_cat(" v=", int_to_str(f))))))) in
  f

/* Name table: JS global identifier -> stub singleton exported above.
 * Returns "" for names that are not stubbed (lang.js keeps box(0) for those).
 * lang.js calls this while emitting a program to decide which names to import
 * and which boxes to bind to stubs. */
let js_browser_stub(nm) =
  if nm == "window" or nm == "self" or nm == "globalThis" or nm == "top" or nm == "parent" then "_js_st_win0"
  else if nm == "document" then "_js_st_doc0"
  else if nm == "navigator" then "_js_st_nav0"
  else if nm == "location" then "_js_st_loc0"
  else if nm == "performance" then "_js_st_perf0"
  else if nm == "localStorage" or nm == "sessionStorage" then "_js_st_store0"
  else if nm == "XMLHttpRequest" then "_js_st_xhrC"
  else if nm == "AudioContext" or nm == "webkitAudioContext" then "_js_st_ctxC"
  else if nm == "Audio" or nm == "HTMLAudioElement" then "_js_st_audioC"
  else if nm == "setTimeout" or nm == "setInterval" or nm == "clearTimeout" or nm == "clearInterval"
    or nm == "requestAnimationFrame" or nm == "cancelAnimationFrame" or nm == "fetch"
    or nm == "alert" or nm == "getComputedStyle" or nm == "matchMedia" then "_js_st_noop"
  else if nm == "confirm" then "_js_st_false"
  else if nm == "prompt" then "_js_st_empty"
  else if nm == "btoa" or nm == "atob" or nm == "escape" or nm == "unescape" then "_js_st_id"
  else ""

let _js_st_noop(...a) = 0
let _js_st_false(...a) = false
let _js_st_empty(...a) = ""
let _js_st_id(x) = x

/* Universal AudioNode: chainable members point back at itself. */
let _js_st_node0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_node0, 1), "connect", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "start", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "stop", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "disconnect", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "removeEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_node0, 1), "gain", _js_st_node0)
let _ = fmap_put(nth(_js_st_node0, 1), "playbackRate", _js_st_node0)
