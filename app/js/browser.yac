let _ = fmap_put(nth(_js_st_store0, 1), "length", 0)

/* XMLHttpRequest: one shared instance; send is a no-op so loads stay pending
 * silently (the XHR path never fires a callback). */
let _js_st_xhr0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_xhr0, 1), "open", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "send", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "abort", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "setRequestHeader", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "getResponseHeader", fun(...a) -> 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "overrideMimeType", _js_st_noop)
let _ = fmap_put(nth(_js_st_xhr0, 1), "readyState", 4)
let _ = fmap_put(nth(_js_st_xhr0, 1), "status", 200)
let _ = fmap_put(nth(_js_st_xhr0, 1), "statusText", "OK")
let _ = fmap_put(nth(_js_st_xhr0, 1), "response", 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "responseText", "")
let _ = fmap_put(nth(_js_st_xhr0, 1), "responseType", "")
let _ = fmap_put(nth(_js_st_xhr0, 1), "onerror", 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "onload", 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "onprogress", 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "onreadystatechange", 0)
let _ = fmap_put(nth(_js_st_xhr0, 1), "withCredentials", false)

/* AudioContext instance + constructor wrappers. */
let _js_st_ctx0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_ctx0, 1), "createGain", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createBufferSource", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createBuffer", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createOscillator", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createDynamicsCompressor", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createAnalyser", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createScriptProcessor", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createBiquadFilter", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createPanner", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createConvolver", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createStereoPanner", fun(...a) -> _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "createWaveShaper", fun(...a) -> _js_st_node0)
/* decodeAudioData(buf, ok, err) -> ok(node): let the graph build run. */
let _ = fmap_put(nth(_js_st_ctx0, 1), "decodeAudioData",
  fun(...a) -> (if len(a) > 1 and nth(a, 1) != 0 then (_jb_ck(nth(a, 1), "decodeAudioData"))(nth(a, 0)) else 0))
let _ = fmap_put(nth(_js_st_ctx0, 1), "resume", _js_st_noop)
let _ = fmap_put(nth(_js_st_ctx0, 1), "suspend", _js_st_noop)
let _ = fmap_put(nth(_js_st_ctx0, 1), "close", _js_st_noop)
let _ = fmap_put(nth(_js_st_ctx0, 1), "destination", _js_st_node0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "currentTime", 0.0)
let _ = fmap_put(nth(_js_st_ctx0, 1), "sampleRate", 48000)
let _ = fmap_put(nth(_js_st_ctx0, 1), "state", "running")

let _js_st_ctxC(...a) = _js_st_ctx0
let _js_st_xhrC(...a) = _js_st_xhr0
let _js_st_audioC(...a) = _js_st_elem0

/* window: host singletons as members + timer/constructor aliases. */
let _js_st_win0 = ["$o", fmap_new(0)]
let _ = fmap_put(nth(_js_st_win0, 1), "document", _js_st_doc0)
let _ = fmap_put(nth(_js_st_win0, 1), "navigator", _js_st_nav0)
let _ = fmap_put(nth(_js_st_win0, 1), "location", _js_st_loc0)
let _ = fmap_put(nth(_js_st_win0, 1), "performance", _js_st_perf0)
let _ = fmap_put(nth(_js_st_win0, 1), "localStorage", _js_st_store0)
let _ = fmap_put(nth(_js_st_win0, 1), "sessionStorage", _js_st_store0)
let _ = fmap_put(nth(_js_st_win0, 1), "setTimeout", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "setInterval", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "clearTimeout", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "clearInterval", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "requestAnimationFrame", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "cancelAnimationFrame", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "AudioContext", _js_st_ctxC)
let _ = fmap_put(nth(_js_st_win0, 1), "webkitAudioContext", _js_st_ctxC)
let _ = fmap_put(nth(_js_st_win0, 1), "XMLHttpRequest", _js_st_xhrC)
let _ = fmap_put(nth(_js_st_win0, 1), "Audio", _js_st_audioC)
let _ = fmap_put(nth(_js_st_win0, 1), "addEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "removeEventListener", _js_st_noop)
let _ = fmap_put(nth(_js_st_win0, 1), "innerWidth", 1024)
let _ = fmap_put(nth(_js_st_win0, 1), "innerHeight", 768)
let _ = fmap_put(nth(_js_st_win0, 1), "devicePixelRatio", 1)

/* ---- bridge implementation (kept last: these names are only referenced from
 * the hooks above and from each other, all inside this package) ---- */
/* ---- yui DOM bridge (v1, id-addressed) -----------------------------------
 * DOM elements become real yui layers in app/native/libyui_yac.so. A node is
 * a "$o" carrying:
 *   $id    the yui layer id (minted here, carried in the create JSON)
 *   $tag   tag name
 *   $kids  child list
 * Creation is DEFERRED to appendChild (the JSON fragment is built there, with
 * the child's id), textContent is an accessor that syncs through
 * yui_yac_set_text, and every mutation pumps one frame so the window paints
 * incrementally. If the .so is missing, every bridge call degrades to the old
 * no-op stubs. ---- */
let _dom_lib = box_new()
let _ = box_set(_dom_lib, 0)
let _dom_root = box_new()
let _ = box_set(_dom_root, 0)
let _dom_rootnode = box_new()
let _ = box_set(_dom_rootnode, 0)
let _dom_seq = box_new()
let _ = box_set(_dom_seq, 0)
let _dom_tried = box_new()
let _ = box_set(_dom_tried, 0)

let _dom_ok(_) = box_get(_dom_lib) != 0

let _dom_ensure(_) =
  if box_get(_dom_tried) != 0 then box_get(_dom_root)
  else
    let _ = box_set(_dom_tried, 1) in
    let lib = yui_bridge_open("app/native/libyui_yac.so") in
    let _ = box_set(_dom_lib, lib) in
    let _ = if lib == 0 then print("yui: dlopen app/native/libyui_yac.so failed (build: make -C app so)") else 0 in
    if lib == 0 then 0
    else
      let r = yui_bridge_boot("app/js/yac-app.json", "") in
      let _ = if r != 0 then print(str_cat("yui: boot failed rc=", int_to_str(r))) else 0 in
      let _ = box_set(_dom_root, r) in
      r

let _dom_seqnext(_) =
  let n = box_get(_dom_seq) + 1 in
  let _ = box_set(_dom_seq, n) in
  str_cat("n", int_to_str(n))

let _dom_strval(v) = if is_int(v) then int_to_str(v) else if kind(v) == 3 then v else ""

let _dom_pump(_) =
  let r = _dom_ensure(0) in
  if r != 0 then yui_bridge_pump(0) else 0

/* Attach/detach a child in yui (ids come from the node objects). */
let _dom_attach(p, c) =
  let pid = fmap_get(nth(p, 1), "$id") in
  let cid = fmap_get(nth(c, 1), "$id") in
  if not _dom_ok(0) then 0
  else if pid == 0 or cid == 0 then 0
  else
    (let q = str_chr(34) in
     (let j = str_cat("{", q, "type", q, ":", q, "View", q, ",", q, "id", q, ":", q, cid, q, "}") in
      (let _ = yui_bridge_create(pid, j) in _dom_pump(0))))

let _dom_detach(p, c) =
  let pid = fmap_get(nth(p, 1), "$id") in
  let cid = fmap_get(nth(c, 1), "$id") in
  if not _dom_ok(0) then 0
  else if pid == 0 or cid == 0 then 0
  else yui_bridge_del(pid, cid)

/* kids minus c (order kept). */
let _dom_drop(kids, c) =
  let n = len(kids) in
  let nd = list_new() in
  let rec(i) =
    if i >= n then nd
    else (let _ = if nth(kids, i) != c then list_push(nd, nth(kids, i)) else 0 in rec(i + 1)) in
  rec(0)

let _dom_node(tag, id) =
  let o = ["$o", fmap_new(0)] in
  let _ = fmap_put(nth(o, 1), "$dom", 1) in
  let _ = fmap_put(nth(o, 1), "$id", id) in
  let _ = fmap_put(nth(o, 1), "$tag", tag) in
  let _ = fmap_put(nth(o, 1), "$kids", list_new()) in
  let _ = fmap_put(nth(o, 1), "$parent", 0) in
  let _ = fmap_put(nth(o, 1), "appendChild", fun(c) ->
    (let kids = fmap_get(nth(o, 1), "$kids") in
     (let _ = list_push(kids, c) in
      (let _ = fmap_put(nth(c, 1), "$parent", o) in
       (let _ = _dom_attach(o, c) in
        c))))) in
  let _ = fmap_put(nth(o, 1), "removeChild", fun(c) ->
    (let _ = fmap_put(nth(o, 1), "$kids", _dom_drop(fmap_get(nth(o, 1), "$kids"), c)) in
     (let _ = _dom_detach(o, c) in
      0))) in
  let _ = fmap_put(nth(o, 1), "setAttribute", fun(k, v) -> (let _ = fmap_put(nth(o, 1), k, v) in 0)) in
  let _ = fmap_put(nth(o, 1), "getAttribute", fun(k) -> fmap_get(nth(o, 1), k)) in
  let _ = fmap_put(nth(o, 1), "addEventListener", _js_st_noop) in
  let _ = fmap_put(nth(o, 1), "removeEventListener", _js_st_noop) in
  let _ = fmap_put(nth(o, 1), "textContent", ["$acc",
    fun(_) -> fmap_get(nth(o, 1), "$text"),
    fun(v) ->
      (let _ = fmap_put(nth(o, 1), "$text", v) in
       (let id = fmap_get(nth(o, 1), "$id") in
        (let _ = if _dom_ok(0) and id != 0 then yui_bridge_put_text(id, _dom_strval(v)) else 0 in
         (let _ = _dom_pump(0) in 0))))]) in
  let _ = fmap_put(nth(o, 1), "innerText", fmap_get(nth(o, 1), "textContent")) in
  o

let _dom_document(_) =
  let _ = _dom_ensure(0) in
  let r = box_get(_dom_rootnode) in
  if r != 0 then r
  else
    let n = _dom_node("#document", "app") in
    let _ = box_set(_dom_rootnode, n) in
    n

let _ = fmap_put(nth(_dom_hooks, 1), "createElement", fun(tag) -> _dom_node(tag, _dom_seqnext(0)))
let _ = fmap_put(nth(_dom_hooks, 1), "createText", fun(txt) -> (let n = _dom_node("#text", _dom_seqnext(0)) in (let _ = fmap_put(nth(n, 1), "$text", txt) in n)))
let _dom_spin(n) =
  let _ = _dom_ensure(0) in
  let rec(i) = if i >= n then 0 else (let _ = _dom_pump(0) in rec(i + 1)) in
  rec(n)

let _ = fmap_put(nth(_dom_hooks, 1), "spin", fun(n) -> _dom_spin(n))
let _ = fmap_put(nth(_dom_hooks, 1), "document", fun(_) -> _dom_document(0))
