/* 加载 Transformer 权重，贪心 / 采样续写。
 *
 *   make -C app llm-infer
 *   ./app/llm/infer [权重] [提示词]
 * 默认：app/llm/transformer.w  你好
 */

import transformer
import io
import fmt

let wpath =
  if argc() > 1 then argv(1)
  else "app/llm/transformer.w"

let prompt =
  if argc() > 2 then argv(2)
  else "你好"

let m = load_model(wpath)

let rc =
  if m == 0 then
    let _ = print("load failed (train first: app/llm/train)") in 1
  else
    let pad = 0 in
    let _ = print(format("transformer  V=%d  d=%d  T=%d", [ntok(m), dim(0), ctx(0)])) in
    let g = generate(m, prompt, 40, pad) in
    let s = generate_s(m, prompt, 40, pad, time_ns()) in
    let _ = print("--- infer greedy ---") in
    let _ = print(g) in
    let _ = print("--- infer sample ---") in
    let _ = print(s) in
    0

rc
