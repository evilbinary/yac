/* 2 层 1 头双向 Transformer：快照并行（MaskGIT）。
 *
 * 一次 forward 只读画布 ids[0..T)，写出每个位置的 logits；揭 MASK 在返回后提交。
 * 注意力全双向（无因果遮罩）。词表末项是 MASK（显示为 ░）。
 *
 * m：0 E  1 Wq1  2 Wk1  3 Wv1  4 Wout（d·V 个 f64，bytes + mem_ref）
 *    5 X  6 Q   7 K   8 V   9 score  10 α
 *    11 H(T×d)  12 logits(T×V)  13 w(V)  14 vocab
 *    15 pred(T)  16 conf(T)  17 字频  18 Adam m  19 Adam v
 *    20 Wq2  21 Wk2  22 Wv2  23 α全图(T×T)  24 gw-mark(d)
 *    25 gW  26 [tstep, gen, bc1, bc2]
 *
 *   make -C app llm-snapshot
 *   --pkg 含 app/llm/snapshot
 */

package snapshot
export sc, dim, ctx, freeze_n, u8len, ch_at, fill, mat, find_char, add_char, build_vocab,
  build_vocab_top, vocab_cap, encode, argmax, rng_next, mask_id, model_new, train_step, train_step_chat, gold_chat, forward,
  canvas_from_prompt, show_canvas, show_from, n_freeze, denoise, denoise_quiet, save_model, load_model,
  vocab_of, ntok, parse_int, zero_freq, maj_count, probe_shuffle, eval_step, fstr

import io
import fmt
import math

/* 死代码 QKV 仍用整数 S。前向 H/Wout 已是 f64；.w 第 4 个数 file_s=0。 */
let sc(_) = 64

let file_s(_) = 0

/* 模型宽度：左近 + 次近 + 右近 各 vocab_cap，再加 T 维位置。不用整袋指纹，避免背窗口。 */
let dim(_) = 784

/* √d 的整数近似，注意力分数除 S·nsq。 */
let nsq(_) = 4

/* 底片长度 T。一次曝光看完这 T 个位置。 */
let ctx(_) = 16

/* 对话模式：左侧最多冻这么多字，其余给回复。 */
let freeze_n(_) = 6

/* UTF-8 首字节 → 字宽。续字节 10xxxxxx 当 1，避免死循环。 */
let u8len(b) =
  if b < 128 then 1
  else if b < 192 then 1
  else if b < 224 then 2
  else if b < 240 then 3
    else 4

/* s 从字节 i 起的一个 UTF-8 字。 */
let ch_at(s, i) =
  let n = str_len(s) in
  if i >= n then ""
  else
    let k = u8len(str_ref(s, i)) in
    if i + k > n then str_slice(s, i, n - i)
    else str_slice(s, i, k)

/* 向 xs 追加 n 个 v。 */
let fill_go(xs, n, v) =
  if n <= 0 then xs
  else
    let _ = list_push(xs, v) in
    fill_go(xs, n - 1, v)

/* 长度 n、初值 v 的可变向量。 */
let fill(n, v) = fill_go(list_new(), n, v)

/* 向 m 追加 rows 行，每行 cols 个 0。 */
let mat_go(m, rows, cols) =
  if rows <= 0 then m
  else
    let _ = list_push(m, fill(cols, 0)) in
    mat_go(m, rows - 1, cols)

/* rows×cols 可变整数矩阵。 */
let mat(rows, cols) = mat_go(list_new(), rows, cols)

/* 词表中字 c 的下标；没有则 -1。 */
let find_char(vocab, c, i) =
  if i >= len(vocab) then 0 - 1
  else if nth(vocab, i) == c then i
  else find_char(vocab, c, i + 1)

/* 未见过的字推进词表。跳过 CR/LF，避免生成区被换行霸榜。 */
let add_char(vocab, c) =
  if str_len(c) == 1 then
    let b = str_ref(c, 0) in
    if b == 13 then 0
    else if b == 10 then 0
    else if find_char(vocab, c, 0) < 0 then list_push(vocab, c)
    else 0
  else if find_char(vocab, c, 0) < 0 then list_push(vocab, c)
  else 0

/* 按出现顺序收集唯一 UTF-8 字。MASK 由调用方再 list_push。 */
let build_vocab(s, vocab, i) =
  if i >= str_len(s) then vocab
  else
    let c = ch_at(s, i) in
    let _ = add_char(vocab, c) in
    build_vocab(s, vocab, i + str_len(c))

/* jsonl / 长书只留这么多槽（含 UNK，不含 MASK）。 */
let vocab_cap(_) = 256

/* 稀有字占位；encode 不再丢掉，避免把「孙悟空」拆成不相邻的高频字。 */
let unk_tok(_) = "<unk>"

/* 换行不进词表、不编成 UNK。 */
let skip_tok(c) =
  if str_len(c) != 1 then 0
  else
    let b = str_ref(c, 0) in
    if b == 10 then 1
    else if b == 13 then 1
    else 0

/* 字符串 → 词表下标。OOV → UNK（词表倒数第二）；MASK 符本身跳过。 */
let encode(s, vocab, ids, i) =
  if i >= str_len(s) then ids
  else
    let c = ch_at(s, i) in
    let _ =
      if skip_tok(c) == 1 then 0
      else
        let k = find_char(vocab, c, 0) in
        let mid = len(vocab) - 1 in
        let uid = mid - 1 in
        if k < 0 then
          if uid < 0 then 0 else list_push(ids, uid)
        else if k == mid then 0
        else list_push(ids, k) in
    encode(s, vocab, ids, i + str_len(c))

/* 计入 vocab/freq；已有则 +1。 */
let bump_freq(vocab, freq, c) =
  if skip_tok(c) == 1 then 0
  else
    let k = find_char(vocab, c, 0) in
    if k < 0 then
      let _ = list_push(vocab, c) in
      list_push(freq, 1)
    else list_set(freq, k, nth(freq, k) + 1)

let count_vocab(s, vocab, freq, i) =
  if i >= str_len(s) then 0
  else
    let c = ch_at(s, i) in
    let _ = bump_freq(vocab, freq, c) in
    count_vocab(s, vocab, freq, i + str_len(c))

/* freq[i..last] 最大值下标。 */
let maxf_go(freq, i, last, bi, bv) =
  if i > last then bi
  else
    let x = nth(freq, i) in
    if x > bv then maxf_go(freq, i + 1, last, i, x)
    else maxf_go(freq, i + 1, last, bi, bv)

/* 反复取出当前频次最高的字，最多 cap 个。 */
let take_top(vocab, freq, cap, acc) =
  if cap <= 0 then acc
  else if len(freq) < 1 then acc
  else
    let j = maxf_go(freq, 1, len(freq) - 1, 0, nth(freq, 0)) in
    if nth(freq, j) < 1 then acc
    else
      let _ = list_push(acc, nth(vocab, j)) in
      let _ = list_set(freq, j, 0) in
      take_top(vocab, freq, cap - 1, acc)

/* 大语料：先计数，再留 cap-1 个高频字 + UNK。MASK 仍由调用方 push。 */
let build_vocab_top(s, cap) =
  let vocab = list_new() in
  let freq = list_new() in
  let _ = count_vocab(s, vocab, freq, 0) in
  let ntop = if cap < 2 then 1 else cap - 1 in
  let acc = take_top(vocab, freq, ntop, list_new()) in
  let _ = list_push(acc, unk_tok(0)) in
  acc

/* m[14] = 词表（末项 MASK）。 */
let vocab_of(m) = nth(m, 14)

/* 词表大小 V，含末项 MASK。 */
let ntok(m) = len(nth(m, 0))

/* MASK 固定为词表最后一项，避免和下标 0（常是「你」）撞车。 */
let mask_id(m) = ntok(m) - 1

/* 倒数第二是 UNK 才认；chat 全字词表没有 UNK 则 -1。 */
let unk_id(m) =
  let v = ntok(m) in
  if v < 2 then 0 - 1
  else if nth(vocab_of(m), v - 2) == unk_tok(0) then v - 2
  else 0 - 1

let is_gap(m, id) =
  if id == mask_id(m) then 1
  else if id == unk_id(m) then 1
  else 0

/* dst[i..] ← src[i..]。 */
let copy_row(dst, src, i) =
  if i >= len(src) then 0
  else
    let _ = list_set(dst, i, nth(src, i)) in
    copy_row(dst, src, i + 1)

/* 位置只加在 dim0/1，幅度 ≤T，避免 t·7≈100 盖过可见字 mix。 */
let add_pos(x, t) =
  let _ = list_set(x, 0, nth(x, 0) + t) in
  list_set(x, 1, nth(x, 1) + t / 2)

/* 把一行清成 0。MASK 的 K/V 用这个，避免 ░ 当 key。 */
let zero_row(row, k) =
  if k >= len(row) then 0
  else
    let _ = list_set(row, k, 0) in
    zero_row(row, k + 1)

/* 扫描 [0, last) 的最大值下标；并列保留更小的 i。 */
let argmax_go(row, i, last, bi, bv) =
  if i >= last then bi
  else
    let x = nth(row, i) in
    if x > bv then argmax_go(row, i + 1, last, i, x)
    else argmax_go(row, i + 1, last, bi, bv)

/* 不把 MASK（最后一列）当成生成字。 */
let argmax(row) = argmax_go(row, 1, len(row) - 1, 0, nth(row, 0))

/* 生成用：再跳过单字节换行（旧权重里可能还有 \n）。 */
let banned_tok(vocab, i) =
  if i >= len(vocab) - 1 then 1
  else
    let c = nth(vocab, i) in
    if c == unk_tok(0) then 1
    else if str_len(c) != 1 then 0
    else
      let b = str_ref(c, 0) in
      if b == 10 then 1
      else if b == 13 then 1
      else 0

/* 推理用 argmax：跳过 MASK 和换行，acc = [bi, bv]。 */
let argmax_gen_go(row, vocab, i, acc) =
  if i >= len(row) then nth(acc, 0)
  else if banned_tok(vocab, i) == 1 then argmax_gen_go(row, vocab, i + 1, acc)
  else
    let x = nth(row, i) in
    let _ =
      if x > nth(acc, 1) then
        let _ = list_set(acc, 0, i) in
        list_set(acc, 1, x)
      else 0 in
    argmax_gen_go(row, vocab, i + 1, acc)

/* 推理：从 logits 里选字，跳过 MASK/换行。 */
let argmax_gen(m, row) =
  let acc = list_new() in
  let _ = list_push(acc, 0) in
  let _ = list_push(acc, 0 - 999999) in
  argmax_gen_go(row, vocab_of(m), 0, acc)

/* LCG: s' = (1103515245 s + 12345) mod (2^31-1)；折成非负。 */
let rng_next(s) =
  let x = irem(iadd(imul(s, 1103515245), 12345), 2147483647) in
  if x < 0 then 0 - x else x

/* Σ row[i..]。 */
let row_sum(row, i, acc) =
  if i >= len(row) then acc
  else row_sum(row, i + 1, acc + nth(row, i))

/* W ← S·I，使 Q/K/V 初值接近拷贝注意力。 */
let id_eye(W, i, s) =
  if i >= len(W) then W
  else
    let _ = list_set(nth(W, i), i, s) in
    id_eye(W, i + 1, s)

/* E[i][i] += S，袋平均初值接近 one-hot。 */
let e_spike(E, i, cap, s) =
  if i >= len(E) then 0
  else if i >= cap then 0
  else
    let row = nth(E, i) in
    let _ = list_set(row, i, nth(row, i) + s) in
    e_spike(E, i + 1, cap, s)

/* 一行均匀随机 ∈ [-mag, mag]。 */
let fill_rand(row, i, seed, mag) =
  if i >= len(row) then seed
  else
    let seed2 = rng_next(seed) in
    let r = irem(seed2, mag + mag + 1) - mag in
    let _ = list_set(row, i, r) in
    fill_rand(row, i + 1, seed2, mag)

/* 矩阵逐行 fill_rand。 */
let mat_rand(W, i, seed, mag) =
  if i >= len(W) then seed
  else
    let seed2 = fill_rand(nth(W, i), 0, seed, mag) in
    mat_rand(W, i + 1, seed2, mag)

/* 一块最多 256，避免 d·V 一层递归。 */
let fill_rand_blk(W, i, end, seed, mag) =
  if i >= end then seed
  else
    let seed2 = rng_next(seed) in
    let r = (irem(seed2, mag + mag + 1) - mag) * 1.0 in
    let _ = fset(W, i, r) in
    fill_rand_blk(W, i + 1, end, seed2, mag)

let fill_rand_all(W, i, n, seed, mag) =
  if i >= n then seed
  else
    let end0 = i + 256 in
    let end = if end0 > n then n else end0 in
    fill_rand_all(W, end, n, fill_rand_blk(W, i, end, seed, mag), mag)

/* 分配权重与前向缓存。前向只用 E+Wout；QKV / 旧 Adam 表占位 1×1。 */
let model_new(vocab, seed) =
  let v = len(vocab) in
  let d = dim(0) in
  let t = ctx(0) in
  let s = sc(0) in
  let E = mat(v, d) in
  let tiny = mat(1, 1) in
  let nv = d * v in
  let Wout = f64s(nv) in
  let am = f64s(nv) in
  let av = f64s(nv) in
  let gw = f64s(nv) in
  /* E / QKV 前向已不用；Wout 全 0。 */
  let m = list_new() in
  let _ = list_push(m, E) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, Wout) in
  let _ = list_push(m, mat(t, d)) in
  let _ = list_push(m, mat(t, d)) in
  let _ = list_push(m, mat(t, d)) in
  let _ = list_push(m, mat(t, d)) in
  let _ = list_push(m, fill(t, 0)) in
  let _ = list_push(m, fill(t, 0)) in
  let _ = list_push(m, mat(t, 4)) in
  let _ = list_push(m, mat(t, v)) in
  let _ = list_push(m, fill(v, 0)) in
  let _ = list_push(m, vocab) in
  let _ = list_push(m, fill(t, 0)) in
  let _ = list_push(m, fill(t, 0)) in
  let _ = list_push(m, fill(v, 0)) in
  let _ = list_push(m, am) in
  let _ = list_push(m, av) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, tiny) in
  let _ = list_push(m, mat(t, t)) in
  let _ = list_push(m, fill(d, 0)) in
  let _ = list_push(m, gw) in
  let st = fill(4, 0) in
  let _ = list_push(st, list_new()) in
  let _ = list_push(m, st) in
  m

/* a·b = Σ_i a[i] b[i]（未除 S，调用方再除）。 */
let dot(a, b, i, acc) =
  if i >= len(a) then acc
  else dot(a, b, i + 1, acc + nth(a, i) * nth(b, i))

/* (x W)[j] 的内层：Σ_i x[i] W[i][j] */
let mv_i(W, x, j, i, acc) =
  if i >= len(x) then acc
  else mv_i(W, x, j, i + 1, acc + nth(x, i) * nth(nth(W, i), j))

/* y = x W / S。W 为 d×out，行是输入维。 */
let mv_j(W, x, y, j, s) =
  if j >= len(y) then 0
  else
    let _ = list_set(y, j, mv_i(W, x, j, 0, 0) / s) in
    mv_j(W, x, y, j + 1, s)

/* 位置 t：X[t] = 词表 one-hot（尺度 S）。MASK 和下标 ≥cap 保持 0。 */
let embed_t(m, ids, t, n) =
  if t >= n then 0
  else
    let x = nth(nth(m, 5), t) in
    let id = nth(ids, t) in
    let _ = zero_row(x, 0) in
    let _ =
      if id >= vocab_cap(0) then 0
      else list_set(x, id, sc(0)) in
    embed_t(m, ids, t + 1, n)

/* 第 1 层 QKV。MASK 的 K/V 清零，避免一排░淹没可见字。 */
let qkv1(m, ids, t, n) =
  if t >= n then 0
  else
    let x = nth(nth(m, 5), t) in
    let _ = mv_j(nth(m, 1), x, nth(nth(m, 6), t), 0, sc(0)) in
    let _ = mv_j(nth(m, 2), x, nth(nth(m, 7), t), 0, sc(0)) in
    let _ = mv_j(nth(m, 3), x, nth(nth(m, 8), t), 0, sc(0)) in
    let _ =
      if nth(ids, t) != mask_id(m) then 0
      else
        let _ = zero_row(nth(nth(m, 7), t), 0) in
        zero_row(nth(nth(m, 8), t), 0) in
    qkv1(m, ids, t + 1, n)

/* 第 2 层 QKV，同样不让 MASK 当 key/value。 */
let qkv2(m, ids, t, n) =
  if t >= n then 0
  else
    let x = nth(nth(m, 5), t) in
    let _ = mv_j(nth(m, 20), x, nth(nth(m, 6), t), 0, sc(0)) in
    let _ = mv_j(nth(m, 21), x, nth(nth(m, 7), t), 0, sc(0)) in
    let _ = mv_j(nth(m, 22), x, nth(nth(m, 8), t), 0, sc(0)) in
    let _ =
      if nth(ids, t) != mask_id(m) then 0
      else
        let _ = zero_row(nth(nth(m, 7), t), 0) in
        zero_row(nth(nth(m, 8), t), 0) in
    qkv2(m, ids, t + 1, n)

/* 第 2 层输入：H1 拷到 X。不再加位置，免得和 H 上已有的 pos 叠在一起。 */
let copy_h_x(m, t) =
  if t >= ctx(0) then 0
  else
    let _ = copy_row(nth(nth(m, 5), t), nth(nth(m, 11), t), 0) in
    copy_h_x(m, t + 1)

let pad3(n) =
  if n < 10 then str_cat("00", int_to_str(n))
  else if n < 100 then str_cat("0", int_to_str(n))
  else int_to_str(n)

let fstr_pos(x) =
  let w = ftoi(x) in
  let frac = x - w * 1.0 in
  let milli0 = ftoi(frac * 1000.0 + 0.5) in
  let carry = if milli0 > 999 then 1 else 0 in
  let milli = if milli0 > 999 then 0 else milli0 in
  str_cat(int_to_str(w + carry), str_cat(".", pad3(milli)))

let fstr(x) =
  if x < 0.0 then str_cat("-", fstr_pos(0.0 - x))
  else fstr_pos(x)

/* 注意力死路径仍走这里；词表 softmax 用 exp_fast。 */
let exp_w(x) = ftoi(exp_fast(x * 1.0) * 32.0)

/* score[j] = (Q·K)/32。除 512 时分数全是 0，加权退化为均匀 BOW。 */
let score_all(m, t, j) =
  if j >= ctx(0) then 0
  else
    let s = dot(nth(nth(m, 6), t), nth(nth(m, 7), j), 0, 0) / 32 in
    let _ = list_set(nth(m, 9), j, s) in
    score_all(m, t, j + 1)

/* 闭区间 [i, n] 上的最大值。 */
let sc_max(row, i, n, mx) =
  if i > n then mx
  else
    let x = nth(row, i) in
    if x > mx then sc_max(row, i + 1, n, x)
    else sc_max(row, i + 1, n, mx)

/* w[j] = exp(score[j]-max)，j=0..T-1，返回 Σ w。 */
let attn_w(m, mx, j, z) =
  if j >= ctx(0) then z
  else
    let w = exp_w(nth(nth(m, 9), j) - mx) in
    let _ = list_set(nth(m, 10), j, w) in
    attn_w(m, mx, j + 1, z + w)

/* α[j] = S · w[j] / Σw，与其它向量同一尺度。 */
let attn_a(m, z, j, s) =
  if j >= ctx(0) then 0
  else
    let _ = list_set(nth(m, 10), j, nth(nth(m, 10), j) * s / z) in
    attn_a(m, z, j + 1, s)

/* (α V)[k]：Σ_j α[j] V[j][k]，j 扫完整张底片。 */
let mix_k(m, k, j, acc) =
  if j >= ctx(0) then acc
  else mix_k(m, k, j + 1, acc + nth(nth(m, 10), j) * nth(nth(nth(m, 8), j), k))

/* H[t] = (αV)/S = 可见 V 的加权平均（α 和为 S）。再在 attn_pos 里加小位置。 */
let mix_h(m, t, k, s) =
  if k >= dim(0) then 0
  else
    let _ = list_set(nth(nth(m, 11), t), k, mix_k(m, k, 0, 0) / s) in
    mix_h(m, t, k + 1, s)

/* MASK 的 key 分数打到条带外，α 只落在可见字上。 */
let mask_sc(m, ids, j) =
  if j >= ctx(0) then 0
  else
    let _ =
      if nth(ids, j) != mask_id(m) then 0
      else list_set(nth(m, 9), j, 0 - 40) in
    mask_sc(m, ids, j + 1)

/* 一层：Q/K/V 已在缓冲里。ids 用来打掉 MASK 的 score。 */
let attn_pos(m, ids, t) =
  if t >= ctx(0) then 0
  else
    let _ = score_all(m, t, 0) in
    let _ = mask_sc(m, ids, 0) in
    let mx = sc_max(nth(m, 9), 0, ctx(0) - 1, nth(nth(m, 9), 0)) in
    let z0 = attn_w(m, mx, 0, 0) in
    let z = if z0 < 1 then 1 else z0 in
    let _ = attn_a(m, z, 0, sc(0)) in
    let _ = mix_h(m, t, 0, sc(0)) in
    let _ = copy_row(nth(nth(m, 23), t), nth(m, 10), 0) in
    attn_pos(m, ids, t + 1)

/* y[j] += W[base+j] · sca。只写到 MASK 前一列。 */
let add_row_s(W, base, dst, sca, j) =
  if j >= len(dst) - 1 then 0
  else
    let _ = list_set(dst, j, nth(dst, j) + fget(W, base + j) * sca) in
    add_row_s(W, base, dst, sca, j + 1)

/* y = x W，跳过 x[i]≤0（袋/邻/位置都 ≥0）。int 0 和 0.0 都会跳。 */
let mv_nz(W, x, y, i, v) =
  if i >= len(x) then 0
  else
    let xi = nth(x, i) in
    let _ = if xi > 0.0 then add_row_s(W, i * v, y, xi, 0) else 0 in
    mv_nz(W, x, y, i + 1, v)

/* UNK 列打到条带外，避免模型靠「猜 □」刷 acc。 */
let ban_unk_row(m, y) =
  let u = unk_id(m) in
  if u < 0 then 0
  else list_set(y, u, 0.0 - 1000000.0)

/* y += W[fi]（one-hot 行）。 */
let add_idx_row(W, fi, y, v) =
  if fi < 0 then 0
  else add_row_s(W, fi * v, y, 1.0, 0)

let logits_idx(m, t) =
  let h = nth(nth(m, 11), t) in
  let y = nth(nth(m, 12), t) in
  let v = ntok(m) in
  let W = nth(m, 4) in
  let _ = zero_row(y, 0) in
  let _ = add_idx_row(W, nth(h, 0), y, v) in
  let _ = add_idx_row(W, nth(h, 1), y, v) in
  let _ = add_idx_row(W, nth(h, 2), y, v) in
  let _ = add_idx_row(W, nth(h, 3), y, v) in
  ban_unk_row(m, y)

/* logits[t] = 至多 4 行 Wout 相加。 */
let write_logits(m, t) =
  if t >= ctx(0) then 0
  else
    let _ = logits_idx(m, t) in
    write_logits(m, t + 1)

/* 训练：只给 flags=1 的格子写 logits。 */
let write_logits_f(m, flags, t) =
  if t >= ctx(0) then 0
  else
    let _ = if nth(flags, t) == 0 then 0 else logits_idx(m, t) in
    write_logits_f(m, flags, t + 1)

/* dst[k] += src[k]。 */
let add_row(dst, src, k) =
  if k >= len(dst) then 0
  else
    let _ = list_set(dst, k, nth(dst, k) + nth(src, k)) in
    add_row(dst, src, k + 1)

/* 整行整数除 n。 */
let div_row(row, n, k) =
  if k >= len(row) then 0
  else
    let _ = list_set(row, k, nth(row, k) / n) in
    div_row(row, n, k + 1)

/* [lo, hi) 除 n。左右袋各自平均，不用全图 n 冲掉照明。 */
let div_span(row, lo, hi, n) =
  if lo >= hi then 0
  else if n < 1 then 0
  else
    let _ = list_set(row, lo, nth(row, lo) / n) in
    div_span(row, lo + 1, hi, n)

/* 把可见位置的 X 加进 H[t]，返回可见个数。 */
let vis_acc(m, ids, t, j, n) =
  if j >= ctx(0) then n
  else if is_gap(m, nth(ids, j)) == 1 then vis_acc(m, ids, t, j + 1, n)
  else
    let _ = add_row(nth(nth(m, 11), t), nth(nth(m, 5), j), 0) in
    vis_acc(m, ids, t, j + 1, n + 1)

/* 只看紧挨着的格子；对面是 MASK / 越界则 -1。
 * 跳过 MASK 找「最近可见」时，后缀全洞会共享同一个左邻，续写变成同一字刷屏。 */
let nearest(m, ids, j, step) =
  if j < 0 then 0 - 1
  else if j >= ctx(0) then 0 - 1
  else if nth(ids, j) == mask_id(m) then 0 - 1
  else nth(ids, j)

/* dst[0,last) += src。袋用冻结 E，不反传。 */
let add_e(dst, src, k, last) =
  if k >= last then 0
  else
    let _ = list_set(dst, k, nth(dst, k) + nth(src, k)) in
    add_e(dst, src, k + 1, last)

/* j < t 的可见字 → 左袋 0..cap（出现过则 1，不平均；平均会把单字前缀冲淡）。 */
let vis_left(m, ids, t, j, n) =
  if j >= t then n
  else if is_gap(m, nth(ids, j)) == 1 then vis_left(m, ids, t, j + 1, n)
  else
    let id = nth(ids, j) in
    let cap = vocab_cap(0) in
    let h = nth(nth(m, 11), t) in
    let _ =
      if id >= cap then 0
      else list_set(h, id, 1.0) in
    vis_left(m, ids, t, j + 1, n + 1)

/* j > t 的可见字 → 右袋 cap..2cap。 */
let vis_right(m, ids, t, j, n) =
  if j >= ctx(0) then n
  else if j <= t then vis_right(m, ids, t, j + 1, n)
  else if is_gap(m, nth(ids, j)) == 1 then vis_right(m, ids, t, j + 1, n)
  else
    let id = nth(ids, j) in
    let cap = vocab_cap(0) in
    let h = nth(nth(m, 11), t) in
    let _ =
      if id >= cap then 0
      else
        let rk = cap + id in
        list_set(h, rk, 1.0) in
    vis_right(m, ids, t, j + 1, n + 1)

/* 沿 step 跳过 MASK/UNK，返回下标（不是字 id）。 */
let skip_idx(ids, j, step, mid, uid) =
  if j < 0 then 0 - 1
  else if j >= ctx(0) then 0 - 1
  else
    let id = nth(ids, j) in
    if id == mid then skip_idx(ids, j + step, step, mid, uid)
    else if id == uid then skip_idx(ids, j + step, step, mid, uid)
    else j

/* ids[i] 作为第 off 块的 Wout 行；缺格 -1。 */
let feat_or(ids, i, cap, off) =
  if i < 0 then 0 - 1
  else
    let id = nth(ids, i) in
    if id >= cap then 0 - 1
    else off + id

/* H[t][0..3] = L1 / L2 / R1 / pos 的 Wout 行下标（不是 one-hot）。 */
let mark_near(m, ids, t) =
  let cap = vocab_cap(0) in
  let h = nth(nth(m, 11), t) in
  let mid = mask_id(m) in
  let uid = unk_id(m) in
  let i1 = skip_idx(ids, t - 1, 0 - 1, mid, uid) in
  let i2 = if i1 < 0 then 0 - 1 else skip_idx(ids, i1 - 1, 0 - 1, mid, uid) in
  let ir = skip_idx(ids, t + 1, 1, mid, uid) in
  let _ = list_set(h, 0, feat_or(ids, i1, cap, 0)) in
  let _ = list_set(h, 1, feat_or(ids, i2, cap, cap)) in
  let _ = list_set(h, 2, feat_or(ids, ir, cap, cap + cap)) in
  list_set(h, 3, cap + cap + cap + t)

/* 只给要算 logits 的格填 4 个下标。 */
let bow_f(m, ids, flags, t) =
  if t >= ctx(0) then 0
  else
    let _ = if nth(flags, t) == 0 then 0 else mark_near(m, ids, t) in
    bow_f(m, ids, flags, t + 1)

/* 推理：每个位置都填。 */
let bow_t(m, ids, t) =
  if t >= ctx(0) then 0
  else
    let _ = mark_near(m, ids, t) in
    bow_t(m, ids, t + 1)

/* X → Q/K/V；MASK 的 K/V 清零。加权平均用 embedding 本身当 key/value。 */
let x_to_qkv(m, ids, t) =
  if t >= ctx(0) then 0
  else
    let x = nth(nth(m, 5), t) in
    let _ = copy_row(nth(nth(m, 6), t), x, 0) in
    let _ = copy_row(nth(nth(m, 7), t), x, 0) in
    let _ = copy_row(nth(nth(m, 8), t), x, 0) in
    let _ =
      if nth(ids, t) != mask_id(m) then 0
      else
        let _ = zero_row(nth(nth(m, 7), t), 0) in
        zero_row(nth(nth(m, 8), t), 0) in
    x_to_qkv(m, ids, t + 1)

/* 一张快门：可见字均匀平均 + 小位置 + Wout。
 * Q·K 加权在多样 jsonl 上会塌成「随机盯一个可见字」，比 maj 还差。 */
let forward(m, ids) =
  let _ = bow_t(m, ids, 0) in
  write_logits(m, 0)

/* 训练用快门：只算被挖格子的 logits。 */
let forward_train(m, ids, flags) =
  let _ = bow_f(m, ids, flags, 0) in
  write_logits_f(m, flags, 0)

/* 一格 SGD 已不用；窗口末尾动量（mean g）。 */
let zero_wrow(W, base, j, n) =
  if j >= n then 0
  else
    let _ = fset(W, base + j, 0.0) in
    zero_wrow(W, base, j + 1, n)

let gw_prep(m, i) =
  let st = nth(m, 26) in
  let gen = nth(st, 1) in
  let mk = nth(m, 24) in
  if nth(mk, i) == gen then 0
  else
    let _ = list_set(mk, i, gen) in
    let _ = list_push(nth(st, 4), i) in
    zero_wrow(nth(m, 25), i * ntok(m), 0, ntok(m) - 1)

let gw_row_j(m, i, xi, g, j) =
  if j >= ntok(m) - 1 then 0
  else
    let k = i * ntok(m) + j in
    let gw = nth(m, 25) in
    let _ = fset(gw, k, fget(gw, k) + xi * nth(g, j)) in
    gw_row_j(m, i, xi, g, j + 1)

/* 只对外积到的 ≤4 个特征行累加梯度。 */
let gw_idx(m, h, g, k) =
  if k >= 4 then 0
  else
    let i = nth(h, k) in
    let _ =
      if i < 0 then 0
      else
        let _ = gw_prep(m, i) in
        gw_row_j(m, i, 1.0, g, 0) in
    gw_idx(m, h, g, k + 1)

let adam_one_j(m, i, invn, j) =
  if j >= ntok(m) - 1 then 0
  else
    let k = i * ntok(m) + j in
    let st = nth(m, 26) in
    let g = fget(nth(m, 25), k) * invn in
    let mm = 0.9 * fget(nth(m, 18), k) + 0.1 * g in
    let vv = 0.999 * fget(nth(m, 19), k) + 0.001 * g * g in
    let _ = fset(nth(m, 18), k, mm) in
    let _ = fset(nth(m, 19), k, vv) in
    let mh = mm / nth(st, 2) in
    let vh = vv / nth(st, 3) in
    let t = nth(st, 0) in
    let lr =
      if t < 200 then 0.02
      else if t < 600 then 0.01
      else 0.005 in
    let _ = fset(nth(m, 4), k, fget(nth(m, 4), k) - lr * mh / (sqrt(vh) + 0.00000001)) in
    adam_one_j(m, i, invn, j + 1)

let adam_act(m, act, k, invn) =
  if k >= len(act) then 0
  else
    let _ = adam_one_j(m, nth(act, k), invn, 0) in
    adam_act(m, act, k + 1, invn)

let adam_win(m, nh) =
  if nh < 1 then 0
  else
    let st = nth(m, 26) in
    let t = nth(st, 0) + 1 in
    let _ = list_set(st, 0, t) in
    let _ = list_set(st, 2, 0.1 + 0.9 * nth(st, 2)) in
    let _ = list_set(st, 3, 0.001 + 0.999 * nth(st, 3)) in
    adam_act(m, nth(st, 4), 0, 1.0 / (nh * 1.0))

let bump_gen(m) =
  let st = nth(m, 26) in
  let _ = list_set(st, 1, nth(st, 1) + 1) in
  list_set(st, 4, list_new())

let adam_cell(m, i, j, gi) =
  let k = i * ntok(m) + j in
  fset(nth(m, 4), k, fget(nth(m, 4), k) - 0.02 * gi)

/* Wout 外积：g 先 clamp 到 ±256，|g|<2 跳过。x 是该位置的 H。 */
let adam_w(m, x, g, i, j) =
  if i >= len(x) then 0
  else if j >= len(g) then adam_w(m, x, g, i + 1, 0)
  else
    let gj = clamp(nth(g, j), 0 - 256, 256) in
    let _ =
      if gj < 2 then
        if gj > 0 - 2 then 0
        else adam_cell(m, i, j, nth(x, i) * gj)
      else adam_cell(m, i, j, nth(x, i) * gj) in
    adam_w(m, x, g, i, j + 1)

/* 只更新 Wout 的第 j 列（金标或当前 argmax）。V 大时比扫整表快一两个数量级。 */
let adam_col(m, x, gj, j, i) =
  if i >= len(x) then 0
  else
    let xi = nth(x, i) in
    let _ =
      if xi == 0 then 0
      else
        let g2 = clamp(gj, 0 - 256, 256) in
        if g2 < 2 then
          if g2 > 0 - 2 then 0
          else adam_cell(m, i, j, xi * g2)
        else adam_cell(m, i, j, xi * g2) in
    adam_col(m, x, gj, j, i + 1)

/* Wout[i][j] -= h[i] · g[j] / den。快照上 den=z·8 会贴 maj；现用 adam_w。 */
let outer_wj(row, xi, g, j, den) =
  if j >= len(g) then 0
  else
    let u = nth(row, j) - xi * nth(g, j) / den in
    let _ = list_set(row, j, clamp(u, 0 - 512, 512)) in
    outer_wj(row, xi, g, j + 1, den)

/* 对 hidden 向量 x 做一次 Wout 外积更新。 */
let outer_w(W, x, g, i, den) =
  if i >= len(x) then 0
  else
    let _ = outer_wj(nth(W, i), nth(x, i), g, 0, den) in
    outer_w(W, x, g, i + 1, den)

/* dh[k] = Σ_j Wout[k·V+j] g[j]（未除 den）。 */
let dh_k(W, g, k, j, acc) =
  if j >= len(g) then acc
  else dh_k(W, g, k, j + 1, acc + fget(W, k * len(g) + j) * nth(g, j))

/* 只改袋那一段 E[id][0..cap)。den 要大，否则以前会把 H 搅乱。 */
let embed_bag(m, id, den, k) =
  let cap = vocab_cap(0) in
  if k >= cap then 0
  else
    let row = nth(nth(m, 0), id) in
    let dh = dh_k(nth(m, 4), nth(m, 13), k, 0, 0) / den in
    let _ = list_set(row, k, clamp(nth(row, k) - dh, 0 - 256, 256)) in
    embed_bag(m, id, den, k + 1)

let vis_egrad(m, gold, flags, den, j) =
  if j >= ctx(0) then 0
  else if nth(flags, j) == 1 then vis_egrad(m, gold, flags, den, j + 1)
  else
    let id = nth(gold, j) in
    let _ =
      if id < 0 then 0
      else if id >= ntok(m) - 1 then 0
      else embed_bag(m, id, den, 0) in
    vis_egrad(m, gold, flags, den, j + 1)

/* dh[k] = Σ_j Wout[k][j] g[j] / 8，写入 m[24]。 */
let fill_dh(m, k) =
  if k >= dim(0) then 0
  else
    let _ = list_set(nth(m, 24), k, dh_k(nth(m, 4), nth(m, 13), k, 0, 0) / 8) in
    fill_dh(m, k + 1)

/* Wq 一行：Wq[p][c] -= x[p] · dh[c] / den。 */
let wq_c(row, xp, dh, c, den) =
  if c >= len(dh) then 0
  else
    let u = nth(row, c) - xp * nth(dh, c) / den in
    let _ = list_set(row, c, clamp(u, 0 - 256, 256)) in
    wq_c(row, xp, dh, c + 1, den)

/* 对整个 Wq：每个输入维 p 一行。 */
let wq_p(Wq, x, dh, p, den) =
  if p >= len(x) then 0
  else
    let _ = wq_c(nth(Wq, p), nth(x, p), dh, 0, den) in
    wq_p(Wq, x, dh, p + 1, den)

/* Wv 一行，scale = den/α_j，α 大则步长大。 */
let wv_c(row, xp, dh, c, scale) =
  if c >= len(dh) then 0
  else
    let u = nth(row, c) - xp * nth(dh, c) / scale in
    let _ = list_set(row, c, clamp(u, 0 - 256, 256)) in
    wv_c(row, xp, dh, c + 1, scale)

/* 用位置 j 的 X 当 value 侧输入，更新整张 Wv。 */
let wv_p(Wv, x, dh, p, scale) =
  if p >= len(x) then 0
  else
    let _ = wv_c(nth(Wv, p), nth(x, p), dh, 0, scale) in
    wv_p(Wv, x, dh, p + 1, scale)

/* 按第 2 层 α[t][j] 扫 key 位置；α=0（MASK 的 K）跳过。 */
let wv_j(m, t, j, den) =
  if j >= ctx(0) then 0
  else
    let aj = nth(nth(nth(m, 23), t), j) in
    let _ =
      if aj < 1 then 0
      else wv_p(nth(m, 22), nth(nth(m, 5), j), nth(m, 24), 0, den / aj) in
    wv_j(m, t, j + 1, den)

/* 只动第 2 层 Wv，den 很大；Wq 一开容易把 H 打乱。Adam 仍只作用在 Wout。 */
let wv_upd(m, t) =
  let den = sc(0) * 64 in
  let _ = fill_dh(m, 0) in
  wv_j(m, t, 0, den)

/* g[i] = p[i] − 1_y。MASK 列 0。 */
let g_fill(w, y, z, i, v) =
  if i >= v then 0
  else if i == v - 1 then
    let _ = list_set(w, i, 0.0) in
    g_fill(w, y, z, i + 1, v)
  else
    let p = nth(w, i) / z in
    let t = if i == y then 1.0 else 0.0 in
    let _ = list_set(w, i, p - t) in
    g_fill(w, y, z, i + 1, v)

/* 一行 Wout：固定 hidden 维 i，扫非 MASK 词。H 稀疏时比按列扫 784 维快。 */
let adam_row_j(m, i, xi, g, j) =
  if j >= ntok(m) - 1 then 0
  else
    let gj = nth(g, j) in
    let _ =
      if gj == 0.0 then 0
      else adam_cell(m, i, j, xi * gj) in
    adam_row_j(m, i, xi, g, j + 1)

/* 只对 H[i]≠0 的行做整表外积。 */
let adam_hi(m, x, g, i) =
  if i >= len(x) then 0
  else
    let xi = nth(x, i) in
    let _ = if xi > 0.0 then adam_row_j(m, i, xi, g, 0) else 0 in
    adam_hi(m, x, g, i + 1)

/* w[i] = exp(logit[i]-max)，i 不含 MASK 列；返回 Σ w。 */
let sm_into(row, w, mx, i, z) =
  if i >= len(row) - 1 then z
  else
    let e = exp_fast(nth(row, i) - mx) in
    let _ = list_set(w, i, e) in
    sm_into(row, w, mx, i + 1, z + e)

/* 位置 t 的 softmax 分子写入 m[13]。 */
let sm_row(m, t) =
  let row = nth(nth(m, 12), t) in
  let last = len(row) - 2 in
  let lmx = sc_max(row, 0, last, nth(row, 0)) in
  let _ = list_set(nth(m, 13), ntok(m) - 1, 0.0) in
  sm_into(row, nth(m, 13), lmx, 0, 0)

/* 语料窗口 ids[pos .. pos+T)；越界用 MASK 垫。 */
let win_at(ids, pos, mid, acc, k) =
  if k >= ctx(0) then acc
  else
    let id = if pos + k >= len(ids) then mid else nth(ids, pos + k) in
    let _ = list_push(acc, id) in
    win_at(ids, pos, mid, acc, k + 1)

/* 复制 id 列表（新 list，可再 mask）。 */
let copy_ids(src, i, dst) =
  if i >= len(src) then dst
  else
    let _ = list_push(dst, nth(src, i)) in
    copy_ids(src, i + 1, dst)

/* 从下标 i 起拷到新列表。 */
let take_from(ids, i, acc) =
  if i >= len(ids) then acc
  else
    let _ = list_push(acc, nth(ids, i)) in
    take_from(ids, i + 1, acc)

/* 只留末尾 n 个 id（对话冻结区用问句后缀）。 */
let tail_ids(ids, n) =
  if len(ids) <= n then ids
  else take_from(ids, len(ids) - n, list_new())

/* dst[di..] ← src[si..) 共 n 个。 */
let set_range(dst, di, src, si, n) =
  if n <= 0 then 0
  else if si >= len(src) then 0
  else if di >= len(dst) then 0
  else
    let _ = list_set(dst, di, nth(src, si)) in
    set_range(dst, di + 1, src, si + 1, n - 1)

/* 与画布同长的 0/1：1 = 本步被挖掉、要算损失。 */
let flags_new(_) = fill(ctx(0), 0)

/* 独立随机挖洞（不是扫行加噪）。st = [seed, mid, rate]。
 * gold 已是 MASK 的垫位不挖、不算损失。返回新种子。 */
let mask_i(gold, canvas, flags, st, i) =
  if i >= ctx(0) then nth(st, 0)
  else
    let mid = nth(st, 1) in
    let rate = nth(st, 2) in
    let seed = rng_next(nth(st, 0)) in
    let g = nth(gold, i) in
    let _ = list_set(canvas, i, g) in
    let _ = list_set(flags, i, 0) in
    let _ =
      if g == mid then 0
      else if irem(seed, 100) < rate then
        let _ = list_set(canvas, i, mid) in
        list_set(flags, i, 1)
      else 0 in
    let _ = list_set(st, 0, seed) in
    mask_i(gold, canvas, flags, st, i + 1)

/* list_set 用的可变二元/三元组。 */
let pair(a, b) =
  let s = list_new() in
  let _ = list_push(s, a) in
  let _ = list_push(s, b) in
  s

/* 可变三元组，mask_i 的 st = [seed, mid, rate]。 */
let triple(a, b, c) =
  let s = pair(a, b) in
  let _ = list_push(s, c) in
  s

/* ⌊log2(x)⌋，x≥1。用来凑 −log2(w/z) = log2(z)−log2(w)。 */
let ilog2(x, n) =
  if x <= 1 then n
  else ilog2(x / 2, n + 1)

/* 单格交叉熵（nat）。w[y] 过小夹到 ε。 */
let nll_nat(w, y, z) =
  let wy = nth(w, y) in
  let a = if wy < 0.000000000001 then 0.000000000001 else wy in
  0.0 - log(a / z)

/* z/w_y；均匀时约 V。累加时夹 1e6，避免个别洞把均值拉爆。 */
let invp_of(w, y, z) =
  let wy = nth(w, y) in
  let a = if wy < 0.000000000001 then 0.000000000001 else wy in
  let r = z / a in
  if r > 1000000.0 then 1000000.0 else r

/* 清 m[17] 字频，每个 epoch 开头调用。 */
let zero_freq(m, i) =
  let f = nth(m, 17) in
  if i >= len(f) then 0
  else
    let _ = list_set(f, i, 0) in
    zero_freq(m, i + 1)

/* f[i..last] 的最大值（次数，不是下标）。 */
let maj_go(f, i, last, bv) =
  if i > last then bv
  else
    let x = nth(f, i) in
    let bv2 = if x > bv then x else bv in
    maj_go(f, i + 1, last, bv2)

/* 本 epoch 被挖金标里出现最多的那个字的次数（unigram 上限）。 */
let maj_count(m) = maj_go(nth(m, 17), 0, ntok(m) - 2, 0)

/* H 是否全 0（左右都是 MASK）。 */
let h_nz(h, i) =
  if i >= len(h) then 0
  else if nth(h, i) != 0 then 1
  else h_nz(h, i + 1)

/* 远洞只靠左右袋（照明）；邻格另有 adj。全图回传，否则主题头没监督。 */
let fov_r(_) = 16

/* 洞 t 到最近可见字的距离。best 初值用大数。 */
let vis_dist(gold, flags, t, j, best) =
  if j >= ctx(0) then best
  else if nth(flags, j) == 1 then vis_dist(gold, flags, t, j + 1, best)
  else
    let d = j - t in
    let ad = if d < 0 then 0 - d else d in
    let b2 = if ad < best then ad else best in
    vis_dist(gold, flags, t, j + 1, b2)

/* 只在 flags[t]=1 且落在焦点半径内做交叉熵（和显影光圈对齐）。 */
let train_at(m, gold, flags, t, acc) =
  if t >= ctx(0) then acc
  else if nth(flags, t) == 0 then train_at(m, gold, flags, t + 1, acc)
  else if is_gap(m, nth(gold, t)) == 1 then train_at(m, gold, flags, t + 1, acc)
  else
    let y = nth(gold, t) in
    let z0 = sm_row(m, t) in
    let z = if z0 < 0.000000000001 then 0.000000000001 else z0 in
    let nll = nll_nat(nth(m, 13), y, z) in
    let inv = invp_of(nth(m, 13), y, z) in
    let p = argmax(nth(nth(m, 12), t)) in
    let hit = if p == y then 1 else 0 in
    let h = nth(nth(m, 11), t) in
    let w = nth(m, 13) in
    let _ = g_fill(w, y, z, 0, ntok(m)) in
    let _ = gw_idx(m, h, w, 0) in
    let fr = nth(m, 17) in
    let _ = list_set(fr, y, nth(fr, y) + 1) in
    let _ = list_set(acc, 0, nth(acc, 0) + hit) in
    let _ = list_set(acc, 1, nth(acc, 1) + 1) in
    let _ = list_set(acc, 2, nth(acc, 2) + nll) in
    let _ = list_set(acc, 3, nth(acc, 3) + inv) in
    train_at(m, gold, flags, t + 1, acc)

/* 验证：与 train_at 同一套挖洞/邻字，不更新 Wout。
 * bun = [hit, n, tp, goldn, predn]。 */
let eval_at(m, gold, flags, t, bun) =
  if t >= ctx(0) then 0
  else if nth(flags, t) == 0 then eval_at(m, gold, flags, t + 1, bun)
  else if is_gap(m, nth(gold, t)) == 1 then eval_at(m, gold, flags, t + 1, bun)
  else
    let y = nth(gold, t) in
    let p = argmax(nth(nth(m, 12), t)) in
    let hit = if p == y then 1 else 0 in
    let tp = nth(bun, 2) in
    let gc = nth(bun, 3) in
    let pc = nth(bun, 4) in
    let _ = list_set(tp, y, nth(tp, y) + hit) in
    let _ = list_set(gc, y, nth(gc, y) + 1) in
    let _ = list_set(pc, p, nth(pc, p) + 1) in
    let _ = list_set(bun, 0, nth(bun, 0) + hit) in
    let _ = list_set(bun, 1, nth(bun, 1) + 1) in
    eval_at(m, gold, flags, t + 1, bun)

/* [0,0,0,0]，train_at 的累加器。 */
let acc4(_) =
  let s = triple(0, 0, 0) in
  let _ = list_push(s, 0) in
  s

/* 从 cut 起整段挖掉：左侧当提示，右侧当续写（对齐推理）。 */
let mask_from(canvas, flags, mid, cut, i) =
  if i >= ctx(0) then 0
  else
    let _ =
      if i < cut then 0
      else
        let _ = list_set(canvas, i, mid) in
        list_set(flags, i, 1) in
    mask_from(canvas, flags, mid, cut, i + 1)

/* 一步：混合轻/中/重挖洞 + 两档后缀（对齐推理全 MASK）。
 * lr 占位。返回 [hit, nmask, nll, invp, new_seed]。 */
let noise_step(gold, canvas, flags, seed, mid) =
  let k = irem(seed, 6) in
  if k == 0 then mask_i(gold, canvas, flags, triple(seed, mid, 10), 0)
  else if k == 1 then mask_i(gold, canvas, flags, triple(seed, mid, 20), 0)
  else if k == 2 then mask_i(gold, canvas, flags, triple(seed, mid, 35), 0)
  else if k == 3 then mask_i(gold, canvas, flags, triple(seed, mid, 50), 0)
  else
    let min_cut = if k == 4 then 6 else 4 in
    let span = ctx(0) - min_cut in
    let cut = min_cut + irem(seed, if span < 1 then 1 else span) in
    let _ = mask_from(canvas, flags, mid, cut, 0) in
    rng_next(seed)

let train_step(m, ids, pos, seed, lr) =
  let mid = mask_id(m) in
  let gold = win_at(ids, pos, mid, list_new(), 0) in
  let canvas = copy_ids(gold, 0, list_new()) in
  let flags = flags_new(0) in
  let seed2 = noise_step(gold, canvas, flags, seed, mid) in
  let _ = bump_gen(m) in
  let _ = forward_train(m, canvas, flags) in
  let acc = acc4(0) in
  let _ = train_at(m, gold, flags, 0, acc) in
  let _ = adam_win(m, nth(acc, 1)) in
  let _ = list_push(acc, seed2) in
  acc

/* 与 train_step 相同挖洞，不 Adam。bun = [hit, n, tp, goldn, predn]。返回新种子。 */
let eval_step(m, ids, pos, seed, bun) =
  let mid = mask_id(m) in
  let gold = win_at(ids, pos, mid, list_new(), 0) in
  let canvas = copy_ids(gold, 0, list_new()) in
  let flags = flags_new(0) in
  let seed2 = noise_step(gold, canvas, flags, seed, mid) in
  let _ = forward_train(m, canvas, flags) in
  let _ = eval_at(m, gold, flags, 0, bun) in
  seed2

/* mask_i 也会挖用户区；再把 0..u-1 还原成真字、不算损失。 */
let restore_user(gold, canvas, flags, u, i) =
  if i >= u then 0
  else
    let _ = list_set(canvas, i, nth(gold, i)) in
    let _ = list_set(flags, i, 0) in
    restore_user(gold, canvas, flags, u, i + 1)

/* 对话一步：冻用户，回复区抽 25/50/75% MASK。lr 占位。 */
let train_step_chat(m, gold, u, seed, lr) =
  let mid = mask_id(m) in
  let canvas = copy_ids(gold, 0, list_new()) in
  let flags = flags_new(0) in
  let rate = 25 * (irem(seed, 3) + 1) in
  let seed2 = mask_i(gold, canvas, flags, triple(seed, mid, rate), 0) in
  let _ = bump_gen(m) in
  let _ = restore_user(gold, canvas, flags, u, 0) in
  let _ = forward_train(m, canvas, flags) in
  let acc = acc4(0) in
  let _ = train_at(m, gold, flags, 0, acc) in
  let _ = adam_win(m, nth(acc, 1)) in
  let _ = list_push(acc, seed2) in
  acc

/* 一张对话底片：问句后缀 + 答句一段（不总切句首「哼～」）。返回 [gold, u]。 */
let gold_chat(m, user, asst) =
  let vocab = vocab_of(m) in
  let mid = mask_id(m) in
  let uids = encode(user, vocab, list_new(), 0) in
  let aids = encode(asst, vocab, list_new(), 0) in
  let cap = freeze_n(0) in
  let u = if len(uids) < cap then len(uids) else cap in
  let need = ctx(0) - u in
  let extra = len(aids) - need in
  let off = if extra <= 0 then 0 else irem(len(uids) * 13 + len(aids), extra + 1) in
  let gold = fill(ctx(0), mid) in
  let _ = set_range(gold, 0, tail_ids(uids, u), 0, u) in
  let _ = set_range(gold, u, take_from(aids, off, list_new()), 0, need) in
  pair(gold, u)

/* 提示词 → id；跳过未知字和 MASK 符本身。 */
let prompt_ids(prompt, vocab, i, acc) =
  if i >= str_len(prompt) then acc
  else
    let c = ch_at(prompt, i) in
    let _ =
      if skip_tok(c) == 1 then 0
      else
        let k = find_char(vocab, c, 0) in
        let mid = len(vocab) - 1 in
        if k < 0 then 0
        else if k == mid then 0
        else list_push(acc, k) in
    prompt_ids(prompt, vocab, i + str_len(c), acc)

/* 左侧写提示（冻结区），其余铺 MASK。 */
let fill_canvas(pids, canvas, mid, i) =
  if i >= ctx(0) then canvas
  else
    let v = if i < len(pids) then nth(pids, i) else mid in
    let _ = list_set(canvas, i, v) in
    fill_canvas(pids, canvas, mid, i + 1)

/* 推理用底片：问句最多 freeze_n 字（取后缀），其余 MASK 给回复。 */
let canvas_from_prompt(m, prompt) =
  let vocab = vocab_of(m) in
  let pids = tail_ids(prompt_ids(prompt, vocab, 0, list_new()), freeze_n(0)) in
  fill_canvas(pids, fill(ctx(0), mask_id(m)), mask_id(m), 0)

/* 实际冻结长度（问句短于 freeze_n 时更短）。 */
let n_freeze(m, prompt) =
  let n = len(prompt_ids(prompt, vocab_of(m), 0, list_new())) in
  if n < freeze_n(0) then n else freeze_n(0)

/* 换行改成可见符，避免 print 把一张底片拆成多行。 */
let tok_show(c) =
  if str_len(c) != 1 then c
  else
    let b = str_ref(c, 0) in
    if b == 10 then "↵"
    else if b == 13 then "␍"
    else c

/* 拼画布字符串。 */
let show_i(canvas, vocab, i, acc) =
  if i >= len(canvas) then acc
  else show_i(canvas, vocab, i + 1, str_cat(acc, tok_show(nth(vocab, nth(canvas, i)))))

/* 把当前底片打成一行（MASK 显示为 ░）。 */
let show_canvas(m, canvas) = show_i(canvas, vocab_of(m), 0, "")

/* 只打冻结区右边的回复。 */
let show_from(m, canvas, u) = show_i(canvas, vocab_of(m), u, "")

/* 还剩多少格是 MASK。 */
let count_mask(canvas, mid, i, n) =
  if i >= len(canvas) then n
  else if nth(canvas, i) == mid then count_mask(canvas, mid, i + 1, n + 1)
  else count_mask(canvas, mid, i + 1, n)

/* 每个位置的 logits argmax，probe 对比打乱用。 */
let snap_arg(m, i, dst) =
  if i >= ctx(0) then dst
  else
    let _ = list_push(dst, argmax(nth(nth(m, 12), i))) in
    snap_arg(m, i + 1, dst)

/* 可见格换成随机字（不是置换同一袋字）。置换在均匀注意力下 mix 不变，probe 会假 0。 */
let scramble_vis(m, canvas, seed, i) =
  let mid = mask_id(m) in
  if i >= ctx(0) then seed
  else if nth(canvas, i) == mid then scramble_vis(m, canvas, seed, i + 1)
  else
    let seed2 = rng_next(seed) in
    let v = irem(seed2, ntok(m) - 1) in
    let _ = list_set(canvas, i, v) in
    scramble_vis(m, canvas, seed2, i + 1)

/* ab = [打乱前 argmax, 打乱后]。只数仍为 MASK 的格子变了几格。 */
let diff_mask(canvas, mid, ab, i, n) =
  if i >= ctx(0) then n
  else if nth(canvas, i) != mid then diff_mask(canvas, mid, ab, i + 1, n)
  else
    let n2 = if nth(nth(ab, 0), i) != nth(nth(ab, 1), i) then n + 1 else n in
    diff_mask(canvas, mid, ab, i + 1, n2)

/* 可见字换成随机词后，MASK 的 argmax 变不变。返回 [changed, nmask]；0 说明 H 没用上下文。 */
let probe_shuffle(m, ids) =
  let mid = mask_id(m) in
  let gold = win_at(ids, 0, mid, list_new(), 0) in
  let canvas = copy_ids(gold, 0, list_new()) in
  let flags = flags_new(0) in
  let _ = mask_i(gold, canvas, flags, triple(7, mid, 50), 0) in
  let n0 = count_mask(canvas, mid, 0, 0) in
  if n0 < 1 then pair(0, 0)
  else
    let _ = forward(m, canvas) in
    let a = snap_arg(m, 0, list_new()) in
    let _ = scramble_vis(m, canvas, 99, 0) in
    let _ = forward(m, canvas) in
    let b = snap_arg(m, 0, list_new()) in
    pair(diff_mask(canvas, mid, pair(a, b), 0, 0), n0)

/* 仍为 MASK 的格子：pred[i]=argmax(logits[i])，conf[i]=该 logit。
 * 已揭开的格子 conf 置极小，本步不会再被选。 */
let fill_pc(m, canvas, mid, i) =
  if i >= ctx(0) then 0
  else
    let _ =
      if nth(canvas, i) != mid then
        let _ = list_set(nth(m, 16), i, 0 - 999999) in 0
      else
        let row = nth(nth(m, 12), i) in
        let p = argmax_gen(m, row) in
        let _ = list_set(nth(m, 15), i, p) in
        list_set(nth(m, 16), i, nth(row, p)) in
    fill_pc(m, canvas, mid, i + 1)

/* 第一个 MASK：取景后焦平面落在提示右缘。 */
let first_mask(canvas, mid, i) =
  if i >= len(canvas) then 0
  else if nth(canvas, i) == mid then i
  else first_mask(canvas, mid, i + 1)

/* 光圈外的 MASK 置信度打掉：本张快门只揭焦点附近。st = [mid, focus, rad]。 */
let fov_dim(conf, canvas, st, i) =
  if i >= len(conf) then 0
  else
    let mid = nth(st, 0) in
    let focus = nth(st, 1) in
    let rad = nth(st, 2) in
    let d = i - focus in
    let ad = if d < 0 then 0 - d else d in
    let _ =
      if nth(canvas, i) != mid then 0
      else if ad <= rad then 0
      else list_set(conf, i, 0 - 999999) in
    fov_dim(conf, canvas, st, i + 1)

/* 在仍为 MASK 的格子里找置信度最高的下标。acc = [bi, bv]。
 * 不按阅读顺序；并列时留下标更小的（稳定，不是扫行策略）。 */
let best_mask(canvas, conf, mid, i, acc) =
  if i >= len(canvas) then nth(acc, 0)
  else if nth(canvas, i) != mid then best_mask(canvas, conf, mid, i + 1, acc)
  else
    let c = nth(conf, i) in
    let _ =
      if c > nth(acc, 1) then
        let _ = list_set(acc, 0, i) in
        list_set(acc, 1, c)
      else 0 in
    best_mask(canvas, conf, mid, i + 1, acc)

/* 同一张 logits 上按置信度揭 n 格。不重新 forward，故仍是这一次快门。 */
let unveil_n(m, canvas, mid, n) =
  if n <= 0 then 0
  else
    let i = best_mask(canvas, nth(m, 16), mid, 0, pair(0 - 1, 0 - 999999)) in
    if i < 0 then 0
    else
      let _ = list_set(canvas, i, nth(nth(m, 15), i)) in
      let _ = list_set(nth(m, 16), i, 0 - 999999) in
      unveil_n(m, canvas, mid, n - 1)

/* kmax<0 表示安静模式（|kmax| 仍是 K），训完扫 K 曲线用。 */
let denoise_go(m, canvas, left, kmax) =
  let km = if kmax < 0 then 0 - kmax else kmax in
  let mid = mask_id(m) in
  let step = km - left in
  let _ =
    if kmax < 0 then 0
    else print(str_cat(str_cat("step ", int_to_str(step)),
      str_cat("  ", show_canvas(m, canvas)))) in
  if left <= 0 then canvas
  else
    let nm = count_mask(canvas, mid, 0, 0) in
    if nm <= 0 then canvas
    else
      let _ = forward(m, canvas) in
      let _ = fill_pc(m, canvas, mid, 0) in
      let focus = first_mask(canvas, mid, 0) in
      let rad0 = (step + 1) * ctx(0) / km in
      let rad = if rad0 < 1 then 1 else rad0 in
      let _ =
        if left == 1 then 0
        else fov_dim(nth(m, 16), canvas, triple(mid, focus, rad), 0) in
      let ntake = if left == 1 then nm else (nm + left - 1) / left in
      let _ = unveil_n(m, canvas, mid, ntake) in
      denoise_go(m, canvas, left - 1, kmax)

/* K 次显影。K 与文本长度无关。 */
let denoise(m, prompt, k) =
  let canvas = canvas_from_prompt(m, prompt) in
  denoise_go(m, canvas, k, k)

/* 只返回成片，不打每步。 */
let denoise_quiet(m, prompt, k) =
  let canvas = canvas_from_prompt(m, prompt) in
  denoise_go(m, canvas, k, 0 - k)

/* 命令行无符号十进制。 */
let parse_int(s, i, n, acc) =
  if i >= n then acc
  else
    let c = str_ref(s, i) in
    if c >= 48 then
      if c <= 57 then parse_int(s, i + 1, n, acc * 10 + (c - 48))
      else acc
    else acc

/* 矩阵行优先摊平 / 还原，给存盘用。 */
let flat_row(row, acc, j) =
  if j >= len(row) then acc
  else
    let _ = list_push(acc, nth(row, j)) in
    flat_row(row, acc, j + 1)

/* 整张矩阵接到 acc 后面。 */
let flat_mat(W, acc, i) =
  if i >= len(W) then acc
  else
    let _ = flat_row(nth(W, i), acc, 0) in
    flat_mat(W, acc, i + 1)

/* 从 xs[p..] 填回一行，返回新 p。 */
let unflat_row(row, xs, j, p) =
  if j >= len(row) then p
  else
    let _ = list_set(row, j, nth(xs, p)) in
    unflat_row(row, xs, j + 1, p + 1)

/* 按行还原矩阵。 */
let unflat_mat(W, xs, i, p) =
  if i >= len(W) then p
  else unflat_mat(W, xs, i + 1, unflat_row(nth(W, i), xs, 0, p))

/* 从 i 读有符号十进制，返回 [值, 新下标]。 */
let parse_int_at(s, i, n, acc, sign) =
  if i >= n then [acc * sign, i]
  else
    let c = str_ref(s, i) in
    if c == 45 then parse_int_at(s, i + 1, n, acc, 0 - 1)
    else if c >= 48 then
      if c <= 57 then parse_int_at(s, i + 1, n, acc * 10 + (c - 48), sign)
      else [acc * sign, i]
    else [acc * sign, i]

/* 跳过空格、LF、CR。 */
let skip_ws(s, i, n) =
  if i >= n then i
  else
    let c = str_ref(s, i) in
    if c == 32 then skip_ws(s, i + 1, n)
    else if c == 10 then skip_ws(s, i + 1, n)
    else if c == 13 then skip_ws(s, i + 1, n)
    else i

/* 一次推进最多 k 个数，避免整文件递归撑爆栈。返回新下标。 */
let parse_ints_k(s, n, acc, i, k) =
  if k <= 0 then i
  else
    let i2 = skip_ws(s, i, n) in
    if i2 >= n then i2
    else
      let r = parse_int_at(s, i2, n, 0, 1) in
      if nth(r, 1) == i2 then i2
      else
        let _ = list_push(acc, nth(r, 0)) in
        parse_ints_k(s, n, acc, nth(r, 1), k - 1)

/* 空格 / LF / CR 分隔的整数列表。 */
let parse_ints(s, i, n, acc) =
  let i2 = skip_ws(s, i, n) in
  if i2 >= n then acc
  else
    let i3 = parse_ints_k(s, n, acc, i2, 256) in
    if i3 == i2 then acc
    else parse_ints(s, i3, n, acc)

/* 用 bytes 写盘，避免 str_cat 拼大字符串被截断。 */
let put_uint(b, x) =
  if x < 10 then bytes_append(b, 48 + x)
  else
    let _ = put_uint(b, x / 10) in
    bytes_append(b, 48 + irem(x, 10))

/* 有符号十进制写入 bytes。 */
let put_int(b, x) =
  if x < 0 then
    let _ = bytes_append(b, 45) in
    put_uint(b, 0 - x)
  else put_uint(b, x)

/* 流式写一个数（前面空格）。矩阵不再摊进大 list。 */
let emit_sp(b, x) =
  let _ = bytes_append(b, 32) in
  put_int(b, x)

let emit_row(b, row, j) =
  if j >= len(row) then bytes_append(b, 10)
  else
    let _ = emit_sp(b, nth(row, j)) in
    emit_row(b, row, j + 1)

let emit_mat(b, W, i) =
  if i >= len(W) then 0
  else
    let _ = emit_row(b, nth(W, i), 0) in
    emit_mat(b, W, i + 1)

/* Wout：微单位整数（×1e6），平坦 d×V。 */
let emit_sp_f(b, x) =
  let _ = bytes_append(b, 32) in
  put_int(b, ftoi(x * 1000000.0))

let emit_w_row(b, W, base, j, n) =
  if j >= n then bytes_append(b, 10)
  else
    let _ = emit_sp_f(b, fget(W, base + j)) in
    emit_w_row(b, W, base, j + 1, n)

let emit_wout(b, W, i, d, v) =
  if i >= d then 0
  else
    let _ = emit_w_row(b, W, i * v, 0, v) in
    emit_wout(b, W, i + 1, d, v)

let scale_w_blk(W, i, end) =
  if i >= end then 0
  else
    let _ = fset(W, i, fget(W, i) * 1.0 / 1000000.0) in
    scale_w_blk(W, i + 1, end)

let scale_wout(W, i, n) =
  if i >= n then 0
  else
    let end0 = i + 256 in
    let end = if end0 > n then n else end0 in
    let _ = scale_w_blk(W, i, end) in
    scale_wout(W, end, n)

let next_int(s, n, i) =
  let i2 = skip_ws(s, i, n) in
  parse_int_at(s, i2, n, 0, 1)

/* src = [文本, 长度]。传 list 避免每层递归拷贝整份 .w。 */
let next_src(src, i) = next_int(nth(src, 0), nth(src, 1), i)

let fill_w_k(W, src, j, p, k) =
  if k <= 0 then p
  else
    let r = next_src(src, p) in
    let _ = fset(W, j, nth(r, 0) * 1.0) in
    fill_w_k(W, src, j + 1, nth(r, 1), k - 1)

let fill_wout(W, src, j, n, p) =
  if j >= n then p
  else
    let left = n - j in
    let k = if left < 32 then left else 32 in
    let p2 = fill_w_k(W, src, j, p, k) in
    fill_wout(W, src, j + k, n, p2)

let fill_row_k(row, src, j, p, k) =
  if k <= 0 then p
  else if j >= len(row) then p
  else
    let r = next_src(src, p) in
    let _ = list_set(row, j, nth(r, 0)) in
    fill_row_k(row, src, j + 1, nth(r, 1), k - 1)

let fill_row_s(row, src, j, p) =
  if j >= len(row) then p
  else
    let p2 = fill_row_k(row, src, j, p, 32) in
    let j2 = j + 32 in
    fill_row_s(row, src, j2, p2)

let fill_mat_s(W, src, i, p) =
  if i >= len(W) then p
  else
    let p2 = fill_row_s(nth(W, i), src, 0, p) in
    fill_mat_s(W, src, i + 1, p2)

let fill_mat_k(W, src, i, p, k) =
  if k <= 0 then p
  else if i >= len(W) then p
  else
    let p2 = fill_row_s(nth(W, i), src, 0, p) in
    fill_mat_k(W, src, i + 1, p2, k - 1)

let fill_mats(W, src, i, p) =
  if i >= len(W) then p
  else
    let p2 = fill_mat_k(W, src, i, p, 16) in
    let i2 = i + 16 in
    fill_mats(W, src, i2, p2)

let read_tok_s(s, n, p, left, b) =
  if left <= 0 then [bytes_to_str(b), p]
  else
    let r = next_int(s, n, p) in
    let _ = bytes_append(b, nth(r, 0)) in
    read_tok_s(s, n, nth(r, 1), left - 1, b)

let read_vocab_s(s, n, p, v, acc) =
  if v <= 0 then [acc, p]
  else
    let ln = next_int(s, n, p) in
    let tok = read_tok_s(s, n, nth(ln, 1), nth(ln, 0), bytes_new()) in
    let _ = list_push(acc, nth(tok, 0)) in
    read_vocab_s(s, n, nth(tok, 1), v - 1, acc)

/* 只写文件头 + 词表（很短）。 */
let emit_ints_k(b, xs, i, k) =
  if k <= 0 then i
  else if i >= len(xs) then i
  else
    let _ = if i == 0 then 0 else bytes_append(b, 32) in
    let _ = put_int(b, nth(xs, i)) in
    emit_ints_k(b, xs, i + 1, k - 1)

let emit_ints(b, xs, i) =
  if i >= len(xs) then 0
  else emit_ints(b, xs, emit_ints_k(b, xs, i, 256))

/* 字符串 → 各字节的整数，供 vocab 序列化。 */
let bytes_of(s, i, acc) =
  if i >= str_len(s) then acc
  else
    let _ = list_push(acc, str_ref(s, i)) in
    bytes_of(s, i + 1, acc)

/* 词表写成「长度 + 各字节」，避免 UTF-8 / 换行和数字流搅在一起。 */
let vocab_ints(vocab, i, acc) =
  if i >= len(vocab) then acc
  else
    let c = nth(vocab, i) in
    let _ = list_push(acc, str_len(c)) in
    vocab_ints(vocab, i + 1, bytes_of(c, 0, acc))

/* 从整数流还原一个 token：n 个字节。 */
let tok_from(xs, p, n, b) =
  if n <= 0 then [bytes_to_str(b), p]
  else
    let _ = bytes_append(b, nth(xs, p)) in
    tok_from(xs, p + 1, n - 1, b)

/* 连续读 v 个 token，返回 [vocab, 下一整数下标]。 */
let read_vocab(xs, p, v, acc) =
  if v <= 0 then [acc, p]
  else
    let r = tok_from(xs, p + 1, nth(xs, p), bytes_new()) in
    let _ = list_push(acc, nth(r, 0)) in
    read_vocab(xs, nth(r, 1), v - 1, acc)

/* 文件：V d T S，词表，再流式 E、Wout。 */
let save_model(m, path) =
  let acc = list_new() in
  let _ = list_push(acc, ntok(m)) in
  let _ = list_push(acc, dim(0)) in
  let _ = list_push(acc, ctx(0)) in
  let _ = list_push(acc, file_s(0)) in
  let _ = vocab_ints(vocab_of(m), 0, acc) in
  let b = bytes_new() in
  let _ = emit_ints(b, acc, 0) in
  let _ = emit_mat(b, nth(m, 0), 0) in
  let _ = emit_wout(b, nth(m, 4), 0, dim(0), ntok(m)) in
  write(path, b)

/* 入参是路径。必须 import fmt：否则 format 变成 ncap，跨包调用会把 path 塞进 capture 槽。 */
let load_model(path) =
  let raw = read_or_0(path) in
  if raw == 0 then
    let _ = print("load  missing") in 0
  else
    let n = str_len(raw) in
    let src = list_new() in
    let _ = list_push(src, raw) in
    let _ = list_push(src, n) in
    let r0 = next_int(nth(src, 0), n, 0) in
    let r1 = next_int(nth(src, 0), n, nth(r0, 1)) in
    let r2 = next_int(nth(src, 0), n, nth(r1, 1)) in
    let r3 = next_int(nth(src, 0), n, nth(r2, 1)) in
    if nth(r1, 0) != dim(0) then
      let _ = print(format("load  d=%d  want %d  (retrain new)", [nth(r1, 0), dim(0)])) in 0
    else if nth(r2, 0) != ctx(0) then
      let _ = print(format("load  T=%d  want %d", [nth(r2, 0), ctx(0)])) in 0
    else if nth(r3, 0) != file_s(0) then
      let _ = print(format("load  fmt=%d  want %d  (retrain new)", [nth(r3, 0), file_s(0)])) in 0
    else
      let vt = read_vocab_s(nth(src, 0), n, nth(r3, 1), nth(r0, 0), list_new()) in
      let m = model_new(nth(vt, 0), 1) in
      let p0 = fill_mats(nth(m, 0), src, 0, nth(vt, 1)) in
      let nw = dim(0) * nth(r0, 0) in
      let _ = fill_wout(nth(m, 4), src, 0, nw, p0) in
      let _ = scale_wout(nth(m, 4), 0, nw) in
      m
