/* 快照并行训练（MLM 预训练 / MaskGIT generate）。
 *
 *   ./app/llm/snapshot/train [语料] [权重] [epoch] [new|chat]
 * 默认语料 app/llm/xyj.txt（过长只取中段 book_cap 字节）。
 */

import snapshot
import json
import io
import fmt

/* 读不到语料文件时的兜底短文。 */
let default_text(_) =
  "你好。\n你好，今天怎么样？\n我很好，你呢？\n我也很好，谢谢。\n再见。\n"

/* 可变五元组。Windows 函数最多 5 个参数，多状态放进 list。 */
let st5(a, b, c, d, e) =
  let s = list_new() in
  let _ = list_push(s, a) in
  let _ = list_push(s, b) in
  let _ = list_push(s, c) in
  let _ = list_push(s, d) in
  let _ = list_push(s, e) in
  s

/* 第 6 槽初值 0（nll）；invp 由 epoch_row 再 push。 */
let st6(a, b, c, d, e) =
  let s = st5(a, b, c, d, e) in
  let _ = list_push(s, 0) in
  s

/* 从 i 起找下一个 LF；没有则返回 n。 */
let find_nl(s, i) =
  if i >= str_len(s) then i
  else if str_ref(s, i) == 10 then i
  else find_nl(s, i + 1)

/* 把字符串 s 逐字节追加到 bytes 缓冲。 */
let append_str(b, s, i) =
  if i >= str_len(s) then 0
  else
    let _ = bytes_append(b, str_ref(s, i)) in
    append_str(b, s, i + 1)

/* json 节点取字符串；不是 "S" 则空。 */
let jstr_of(v) =
  if v == 0 then ""
  else if len(v) < 2 then ""
  else if nth(v, 0) == "S" then nth(v, 1)
  else ""

/* conversations 数组拼成一段文本，句间换行。 */
let convs_go(arr, i, b) =
  if i >= len(arr) then 0
  else
    let c = jstr_of(get(nth(arr, i), "content")) in
    let _ = append_str(b, c, 0) in
    let _ = bytes_append(b, 10) in
    convs_go(arr, i + 1, b)

/* jsonl 最多读这么多行（整份 pretrain 约 1.2GB，不能 read_file）。 */
let jsonl_max(_) = 250

/* 每个 epoch 最多扫这么多长度为 T 的窗口。 */
let win_cap(_) = 1000

/* 每本书最多取这么多字节（从 1/5 处切开，躲开 CIP）。整本进 list 会卡在 encode。 */
let book_cap(_) = 80000

/* 每这么多 epoch 写一次权重；最后一轮一定写。 */
let save_every(_) = 2

/* 一行 json：优先 "text"，否则 conversations。 */
let line_go(line, b) =
  let v = parse(line) in
  if v == 0 then 0
  else
    let t = jstr_of(get(v, "text")) in
    if str_len(t) > 0 then
      let _ = append_str(b, t, 0) in
      bytes_append(b, 10)
    else
      let conv = get(v, "conversations") in
      if conv == 0 then 0
      else if nth(conv, 0) != "A" then 0
      else
        let _ = convs_go(nth(conv, 1), 0, b) in
        bytes_append(b, 10)

/* 按行切 raw，最多 left 行。 */
let lines_go(raw, i, n, b, left) =
  if left <= 0 then bytes_to_str(b)
  else if i >= n then bytes_to_str(b)
  else
    let nl = find_nl(raw, i) in
    let _ = if nl > i then line_go(str_slice(raw, i, nl - i), b) else 0 in
    let i2 = if nl < n then nl + 1 else n in
    lines_go(raw, i2, n, b, left - 1)

/* 过长则从 1/5 处切 cap 字节。 */
let take_mid(s, cap) =
  let n = str_len(s) in
  if n <= cap then s
  else
    let o = n / 5 in
    str_slice(s, o, cap)

/* 读语料：`{` 开头当 jsonl，否则纯文本（过长只取中段）。 */
let load_text(path) =
  let raw = read_or_0(path) in
  if raw == 0 then default_text(0)
  else if str_len(raw) <= 0 then default_text(0)
  else if str_ref(raw, 0) == 123 then
    lines_go(raw, 0, str_len(raw), bytes_new(), jsonl_max(0))
    else take_mid(raw, book_cap(0))

/* 窗口 i 在全书上均匀落点，避免窗全落在封面/CIP。 */
let stride_pos(i, n, nuse) =
  let t = ctx(0) in
  if nuse < 1 then 0
  else if n <= t then 0
  else
    let span = n / nuse in
    let sp = if span < 1 then 1 else span in
    let p = i * sp in
    if p + t > n then n - t
    else p

/* 在 conversations 里找 role=want 的 content。 */
let find_role(arr, i, want) =
  if i >= len(arr) then ""
  else if jstr_of(get(nth(arr, i), "role")) == want then
    jstr_of(get(nth(arr, i), "content"))
  else     find_role(arr, i + 1, want)

/* 一行 chat jsonl → 推进 [user, assistant]；缺字段则跳过。 */
let line_pair(line, acc) =
  let v = parse(line) in
  if v == 0 then 0
  else
    let conv = get(v, "conversations") in
    if conv == 0 then 0
    else if nth(conv, 0) != "A" then 0
    else
      let arr = nth(conv, 1) in
      let u = find_role(arr, 0, "user") in
      let a = find_role(arr, 0, "assistant") in
      if str_len(u) <= 0 then 0
      else if str_len(a) <= 0 then 0
      else
        let p = list_new() in
        let _ = list_push(p, u) in
        let _ = list_push(p, a) in
        list_push(acc, p)

/* 按行收集 user/assistant 对。 */
let pairs_go(raw, i, n, acc, left) =
  if left <= 0 then acc
  else if i >= n then acc
  else
    let nl = find_nl(raw, i) in
    let _ = if nl > i then line_pair(str_slice(raw, i, nl - i), acc) else 0 in
    let i2 = if nl < n then nl + 1 else n in
    pairs_go(raw, i2, n, acc, left - 1)

/* 读 chat jsonl；失败返回空 list。 */
let load_pairs(path) =
  let raw = read_or_0(path) in
  if raw == 0 then list_new()
  else if str_len(raw) <= 0 then list_new()
    else pairs_go(raw, 0, str_len(raw), list_new(), jsonl_max(0))

/* 从对话对累积词表。 */
let vocab_pairs(pairs, i, vocab) =
  if i >= len(pairs) then vocab
  else
    let p = nth(pairs, i) in
    let _ = build_vocab(nth(p, 0), vocab, 0) in
    let _ = build_vocab(nth(p, 1), vocab, 0) in
    vocab_pairs(pairs, i + 1, vocab)

/* 每对对话切成一张 gold 底片和冻结长度 u。 */
let pack_go(m, pairs, i, golds, us) =
  if i >= len(pairs) then 0
  else
    let p = nth(pairs, i) in
    let g = gold_chat(m, nth(p, 0), nth(p, 1)) in
    let _ = list_push(golds, nth(g, 0)) in
    let _ = list_push(us, nth(g, 1)) in
    pack_go(m, pairs, i + 1, golds, us)

/* 一个 epoch：步长窗口。每 5 个窗留 1 个做测试（两本书都会进 train/test）。
 * st = [i, nuse, seed, hit, nmask, nll, invp]。 */
let epoch_mlm(m, ids, st) =
  let i = nth(st, 0) in
  if i >= nth(st, 1) then 0
  else
    let _ =
      if irem(i, 5) == 4 then 0
      else
        let pos = stride_pos(i, len(ids), nth(st, 1)) in
        let r = train_step(m, ids, pos, nth(st, 2), 1) in
        let _ = list_set(st, 2, nth(r, 4)) in
        let _ = list_set(st, 3, nth(st, 3) + nth(r, 0)) in
        let _ = list_set(st, 4, nth(st, 4) + nth(r, 1)) in
        let _ = list_set(st, 5, nth(st, 5) + nth(r, 2)) in
        list_set(st, 6, nth(st, 6) + nth(r, 3)) in
    let _ = list_set(st, 0, i + 1) in
    epoch_mlm(m, ids, st)

/* 一个 epoch：逐条对话底片。st[0] 是对下标。 */
let epoch_chat(m, golds, us, st) =
  let i = nth(st, 0) in
  if i >= len(golds) then 0
  else
    let r = train_step_chat(m, nth(golds, i), nth(us, i), nth(st, 2), 1) in
    let _ = list_set(st, 0, i + 1) in
    let _ = list_set(st, 2, nth(r, 4)) in
    let _ = list_set(st, 3, nth(st, 3) + nth(r, 0)) in
    let _ = list_set(st, 4, nth(st, 4) + nth(r, 1)) in
    let _ = list_set(st, 5, nth(st, 5) + nth(r, 2)) in
    let _ = list_set(st, 6, nth(st, 6) + nth(r, 3)) in
    epoch_chat(m, golds, us, st)

/* 整数均值；nm=0 则 0。nll 和 invp 都用它。 */
let avg_nll(nll, nm) =
  if nm < 1 then 0.0
  else nll / nm

/* 命中率百分数：hit/nm，nm=0 则 0。这就是终端上的 acc / maj。 */
let pct(hit, nm) =
  if nm < 1 then 0
  else hit * 100 / nm

/* 一个 epoch 的累加行：在 st6 后再接 invp 槽。 */
let epoch_row(limit, seed) =
  let row = st6(0, limit, seed, 0, 0) in
  let _ = list_push(row, 0) in
  row

/* 最后一轮或每 save_every 轮写盘。 */
let maybe_save(m, path, ep, ntot) =
  if ep + 1 >= ntot then save_model(m, path)
  else if irem(ep + 1, save_every(0)) == 0 then save_model(m, path)
  else 0

/* 验证：i % 5 == 4 的窗。st = [i, nuse, seed]。bun 累加命中。 */
let epoch_eval(m, ids, st, bun) =
  let i = nth(st, 0) in
  if i >= nth(st, 1) then 0
  else
    let _ =
      if irem(i, 5) != 4 then 0
      else
        let pos = stride_pos(i, len(ids), nth(st, 1)) in
        let seed2 = eval_step(m, ids, pos, nth(st, 2), bun) in
        list_set(st, 2, seed2) in
    let _ = list_set(st, 0, i + 1) in
    epoch_eval(m, ids, st, bun)

/* 清 F1 计数。 */
let zero_i(a, i) =
  if i >= len(a) then 0
  else
    let _ = list_set(a, i, 0) in
    zero_i(a, i + 1)

/* 宏平均 F1（百分数）。st = [tp, goldn, predn, sum, n]。 */
let f1_go(st, i, last) =
  let gc = nth(st, 1) in
  if i > last then
    let n = nth(st, 4) in
    if n < 1 then 0
    else nth(st, 3) / n
  else if nth(gc, i) < 1 then f1_go(st, i + 1, last)
  else
    let tp = nth(st, 0) in
    let pc = nth(st, 2) in
    let den = nth(gc, i) + nth(pc, i) in
    let f = if den < 1 then 0 else 100 * (nth(tp, i) + nth(tp, i)) / den in
    let _ = list_set(st, 3, nth(st, 3) + f) in
    let _ = list_set(st, 4, nth(st, 4) + 1) in
    f1_go(st, i + 1, last)

let f1_macro(tp, gc, pc) =
  let st = st5(tp, gc, pc, 0, 0) in
  f1_go(st, 0, len(gc) - 2)

/* bun = [hit, n, tp, goldn, predn]。 */
let bun_new(v) =
  let s = list_new() in
  let _ = list_push(s, 0) in
  let _ = list_push(s, 0) in
  let _ = list_push(s, fill(v, 0)) in
  let _ = list_push(s, fill(v, 0)) in
  let _ = list_push(s, fill(v, 0)) in
  s

let bun_zero(bun) =
  let _ = list_set(bun, 0, 0) in
  let _ = list_set(bun, 1, 0) in
  let _ = zero_i(nth(bun, 2), 0) in
  let _ = zero_i(nth(bun, 3), 0) in
  zero_i(nth(bun, 4), 0)

/* st = [ep, epochs, nuse, seed]。 */
let run_mlm(m, ids, st, path) =
  let ep = nth(st, 0) in
  if ep >= nth(st, 1) then 0
  else
    let nuse = nth(st, 2) in
    let _ = zero_freq(m, 0) in
    let row = epoch_row(nuse, nth(st, 3)) in
    let _ = epoch_mlm(m, ids, row) in
    let nm = nth(row, 4) in
    let hit = nth(row, 3) in
    let mj = maj_count(m) in
    let _ = print(format("epoch %d  acc ~%d%%  maj ~%d%%  loss %s nat  invp %s  hit %d / %d  maj-hit %d / %d",
      [ep, pct(hit, nm), pct(mj, nm), fstr(avg_nll(nth(row, 5), nm)), fstr(avg_nll(nth(row, 6), nm)),
        hit, nm, mj, nm])) in
    let bun = bun_new(ntok(m)) in
    let ev = st5(0, nuse, nth(row, 2), 0, 0) in
    let _ = epoch_eval(m, ids, ev, bun) in
    let te = nth(bun, 1) in
    let _ = print(format("         test acc ~%d%%  f1 ~%d%%  hit %d / %d",
      [pct(nth(bun, 0), te), f1_macro(nth(bun, 2), nth(bun, 3), nth(bun, 4)),
        nth(bun, 0), te])) in
    let _ = maybe_save(m, path, ep, nth(st, 1)) in
    let _ = list_set(st, 0, ep + 1) in
    let _ = list_set(st, 3, nth(row, 2)) in
    run_mlm(m, ids, st, path)

/* 对话模式的 epoch 循环，统计字段与 MLM 相同。 */
let run_chat(m, golds, us, st, path) =
  let ep = nth(st, 0) in
  if ep >= nth(st, 1) then 0
  else
    let _ = zero_freq(m, 0) in
    let row = epoch_row(0, nth(st, 2)) in
    let _ = epoch_chat(m, golds, us, row) in
    let nm = nth(row, 4) in
    let hit = nth(row, 3) in
    let mj = maj_count(m) in
    let _ = print(format("epoch %d  acc ~%d%%  maj ~%d%%  loss %s nat  invp %s  hit %d / %d  maj-hit %d / %d",
      [ep, pct(hit, nm), pct(mj, nm), fstr(avg_nll(nth(row, 5), nm)), fstr(avg_nll(nth(row, 6), nm)),
        hit, nm, mj, nm])) in
    let _ = maybe_save(m, path, ep, nth(st, 1)) in
    let _ = list_set(st, 0, ep + 1) in
    let _ = list_set(st, 2, nth(row, 2)) in
    run_chat(m, golds, us, st, path)

/* 第 4/5 参数是 chat。 */
let is_chat(s) =
  if s == "chat" then 1
  else 0

/* 第 4/5 参数是 new 则重建权重。 */
let is_new(s) =
  if s == "new" then 1
  else 0

/* 能读到合法权重就接着训；force=1 或坏文件则用 vocab 重建。 */
let open_or_new(wpath, vocab, force) =
  if force == 1 then
    let _ = print("init  new") in
    model_new(vocab, 1)
  else
    let m = load_model(wpath) in
    if m == 0 then
      let _ = print("init  scratch") in
      model_new(vocab, 1)
    else
      let _ = print(format("resume  V=%d", [ntok(m)])) in
      m

/* 语料路径，默认西游记中段。 */
let path =
  if argc() > 1 then argv(1)
  else "app/llm/xyj.txt"

/* 权重路径。 */
let wpath =
  if argc() > 2 then argv(2)
  else "app/llm/snapshot/snapshot.w"

/* epoch 数，缺省 3。 */
let epochs =
  if argc() > 3 then parse_int(argv(3), 0, str_len(argv(3)), 0)
  else 3

/* 第 4 参数 chat。 */
let mode_chat =
  if argc() > 4 then is_chat(argv(4))
  else 0

/* new 可写在第 4 或第 5 参数（与 chat 互斥占位）。 */
let force_new =
  if argc() > 5 then is_new(argv(5))
  else if argc() > 4 then is_new(argv(4))
  else 0

/* 入口：chat 或 MLM；非 0 表示失败。 */
let rc =
  if mode_chat == 1 then
    let pairs = load_pairs(path) in
    if len(pairs) <= 0 then
      let _ = print("no chat pairs (need jsonl conversations)") in 1
    else
      let vocab = vocab_pairs(pairs, 0, list_new()) in
      let _ = list_push(vocab, "░") in
      let m = open_or_new(wpath, vocab, force_new) in
      let golds = list_new() in
      let us = list_new() in
      let _ = pack_go(m, pairs, 0, golds, us) in
      let _ = print(format("snapshot  mode=chat  V=%d  T=%d  freeze=%d  pairs=%d",
        [ntok(m), ctx(0), freeze_n(0), len(golds)])) in
      let _ = print(str_cat("corpus  ", path)) in
      let _ = print("--- train (user frozen, assistant MASK) ---") in
      let _ = run_chat(m, golds, us, st5(0, epochs, 1, 0, 0), wpath) in
      let q = "怎么办" in
      let _ = print("--- after train ---") in
      let canvas = denoise(m, q, 8) in
      let _ = print(str_cat("reply  ", show_from(m, canvas, n_freeze(m, q)))) in
      let _ = print(str_cat("wrote ", wpath)) in
      0
  else
    let text = load_text(path) in
    let vocab = build_vocab_top(text, vocab_cap(0)) in
    let _ = list_push(vocab, "░") in
    let m = open_or_new(wpath, vocab, force_new) in
    let ids = encode(text, vocab_of(m), list_new(), 0) in
    let n = len(ids) in
    let tlen = ctx(0) in
    let nwin = if n >= tlen then n - tlen + 1 else 1 in
    let cap = win_cap(0) in
    let nuse = if nwin <= cap then nwin else cap in
    let ntr = nuse - nuse / 5 in
    if n <= 0 then
      let _ = print("empty corpus") in 1
    else
      let _ = print(format("snapshot  mode=mlm  V=%d  T=%d  tokens=%d  train-win=%d  test-win=%d",
        [ntok(m), tlen, n, ntr, nuse - ntr])) in
      let _ = print(format("vocab  top-%d + UNK + MASK  (OOV kept as UNK)", [vocab_cap(0) - 1])) in
      let _ = print(str_cat("corpus  ", path)) in
      let _ = print("opt  float softmax CE  Adam lr=0.02  L1+L2+R1+pos  Wout=0  UNK=gap") in
      let _ = print("--- train (random MASK, generate) ---") in
      let st = st5(0, epochs, nuse, 1, 0) in
      let _ = run_mlm(m, ids, st, wpath) in
      let _ = print("--- after train ---") in
      let pr = probe_shuffle(m, ids) in
      let _ = print(format("probe  scramble-vis  pred-changed %d / %d  (0 = ignores context)",
        [nth(pr, 0), nth(pr, 1)])) in
      let _ = print("--- K curve (same shutter, more K = more exposures) ---") in
      let _ = print(str_cat("K=1   ", show_canvas(m, denoise_quiet(m, "悟空", 1)))) in
      let _ = print(str_cat("K=4   ", show_canvas(m, denoise_quiet(m, "悟空", 4)))) in
      let _ = print(str_cat("K=8   ", show_canvas(m, denoise_quiet(m, "悟空", 8)))) in
      let _ = print(str_cat("K=14  ", show_canvas(m, denoise_quiet(m, "悟空", 14)))) in
      let _ = print(str_cat("K=8 Romeo  ", show_canvas(m, denoise_quiet(m, "Romeo", 8)))) in
      let _ = print(str_cat("wrote ", wpath)) in
      0

rc
