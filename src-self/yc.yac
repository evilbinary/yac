import rt.os

/* yc.yac — CLI: compile to ELF by default; yac-compatible run/dump flags JIT. */

let usage(_) =
  let _ = print("usage: yc [options] file.yac...") in
  let _ = print("options:") in
  let _ = print("  --cps            compile to machine code and run (in-process)") in
  let _ = print("  --dump-anf       print the ANF and exit") in
  let _ = print("  --dump-cps       print ANF->CPS and exit") in
  let _ = print("  --eval-cps       evaluate CPS with the native trampoline") in
  let _ = print("  --both           ANF->CPS->ANF, then compile and run") in
  let _ = print("  --uncps          ANF->CPS->ANF, then compile and run") in
  let _ = print("  --dump-uncps     print un-CPS ANF and exit") in
  let _ = print("  --opt            simplify CPS (eta + int fold) before dump/uncps") in
  let _ = print("  --ast            dump the parsed AST and exit") in
  let _ = print("  --no-gc          accepted (guest GC still runs in JIT image)") in
  let _ = print("  --limit-nodes N  accepted (C GC limit; unused natively)") in
  let _ = print("  --dump-rt FILE   print compiled ANF (not C rtio format)") in
  let _ = print("  --load-rt FILE   not supported in native yc") in
  let _ = print("  --repl           interactive loop; each line is compiled and jumped to") in
  let _ = print("                   empty line ignored; :q / :quit exits") in
  let _ = print("                   :dump FILE.yjit  write live image") in
  let _ = print("                   :load FILE.yjit  map image and run entry") in
  let _ = print("  file.yjit|file.jit  load and run a dumped image (no --cps)") in
  let _ = print("  file.yac...      concatenate in order as one program") in
  let _ = print("  --scheme         translate a Scheme subset, then run or compile") in
  let _ = print("  -o out           write an executable or library instead of running") in
  let _ = print("  --pkg DIR[,DIR]  package roots (before ./pkg and this yc)") in
  let _ = print("  -g, --syms       write ELF function symbols (nm/gdb)") in
  let _ = print("  --arch x86_64|arm64|riscv64") in
  let _ = print("  --format elf|pe|macho|yjit   (default: host)") in
  let _ = print("  --shared         ELF .so / PE .dll / Mach-O .dylib") in
  let _ = print("  --prof-out file  write profile data to file") in
  let _ = print("  -v, --verbose    compile progress ([yc]/[prof]/[emit])") in
  0

let ends_with_yjit(s) =
  let n = str_len(s) in
  if n < 5 then false
  else str_slice(s, n - 5, 5) == ".yjit"

/* `.yjit` does not end with `.jit` (last four are `yjit`). */
let ends_with_jit(s) =
  let n = str_len(s) in
  if n < 4 then false
  else str_slice(s, n - 4, 4) == ".jit"

let is_jit_file(s) =
  if ends_with_yjit(s) then true
  else ends_with_jit(s)

let ends_with_yac(s) =
  let n = str_len(s) in
  if n < 4 then false
  else if str_ref(s, n - 4) != 46 then false
  else if str_ref(s, n - 3) != 121 then false
  else if str_ref(s, n - 2) != 97 then false
  else str_ref(s, n - 1) == 99

let default_out(inpath) =
  if ends_with_yac(inpath) then str_slice(inpath, 0, str_len(inpath) - 4)
  else inpath

let ends_with_exe(s) =
  let n = str_len(s) in
  if n < 4 then false
  else str_slice(s, n - 4, 4) == ".exe"

let pe_out(path) =
  if ends_with_exe(path) then path else str_cat(path, ".exe")

let ends_with_str(s, suf) =
  let n = str_len(s) in
  let m = str_len(suf) in
  if n < m then false
  else str_slice(s, n - m, m) == suf

let dylib_suffix(fmt) =
  if fmt == "pe" then ".dll"
  else if fmt == "macho" then ".dylib"
  else ".so"

let dylib_out(path, fmt) =
  let suf = dylib_suffix(fmt) in
  if ends_with_str(path, suf) then path else str_cat(path, suf)

let has_flag(fs, name, i) =
  if i >= len(fs) then false
  else if nth(fs, i) == name then true
  else has_flag(fs, name, i + 1)

let fl(spec, name) = has_flag(nth(spec, 4), name, 0)

let spec_flag(spec, f) =
  [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
   append(nth(spec, 4), [f]), nth(spec, 5), nth(spec, 6)]

/* parse: [out, pos, err, spec]
 * spec = [arch, format, kind, profpath, flags, dump_rt, load_rt]
 * err 1 = help */
let parse_args(i, argc, out, pos, spec) =
  if i >= argc then [out, pos, 0, spec]
  else
    let a = argv(i) in
    if a == "-h" or a == "--help" then
      let _ = usage(0) in [out, pos, 1, spec]
    else if a == "-o" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, argv(i + 1), pos, spec)
    else if a == "--pkg" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else if pkg_set(argv(i + 1)) == 0 then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos, spec)
    else if a == "--arch" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [argv(i + 1), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--format" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), argv(i + 1), nth(spec, 2), nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--shared" or a == "--dylib" then
      parse_args(i + 1, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), "dylib", nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--profile" then
      parse_args(i + 1, argc, out, pos, spec)
    else if a == "-v" or a == "--verbose" then
      parse_args(i + 1, argc, out, pos, spec_flag(spec, "verbose"))
    else if a == "--prof-out" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), argv(i + 1),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--dump-rt" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         append(nth(spec, 4), ["dump-rt"]), argv(i + 1), nth(spec, 6)])
    else if a == "--load-rt" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         append(nth(spec, 4), ["load-rt"]), nth(spec, 5), argv(i + 1)])
    else if a == "--limit-nodes" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos, spec)
    else if a == "--checkpoint-at" or a == "--resume" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos, spec)
    else if a == "--cps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "cps"))
    else if a == "--dump-anf" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-anf"))
    else if a == "--dump-cps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-cps"))
    else if a == "--eval-cps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "eval-cps"))
    else if a == "--both" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "both"))
    else if a == "--uncps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "uncps"))
    else if a == "--dump-uncps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-uncps"))
    else if a == "--opt" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "opt"))
    else if a == "--ast" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "ast"))
    else if a == "--no-gc" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "no-gc"))
    else if a == "--repl" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "repl"))
    else if a == "-g" or a == "--syms" then
      parse_args(i + 1, argc, out, pos, spec_flag(spec, "syms"))
    else if a == "--scheme" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "scheme"))
    else if str_len(a) > 0 and str_ref(a, 0) == 45 then
      [out, pos, 2, spec]
    else parse_args(i + 1, argc, out, append(pos, [a]), spec)

let pos_has_yjit(pos, i) =
  if i >= len(pos) then false
  else if is_jit_file(nth(pos, i)) then true
  else pos_has_yjit(pos, i + 1)

/* Concatenate sources in argv order. 0 if any path cannot be read. */
let read_sources(paths, i, acc) =
  if i >= len(paths) then acc
  else
    let p = nth(paths, i) in
    let raw = read_file(p) in
    if raw == 0 then
      let _ = print(str_cat("cannot read file: ", p)) in
      0
    else
      let next =
        if acc == "" then raw
        else str_cat(str_cat(acc, "\n"), raw) in
      read_sources(paths, i + 1, next)

let prep_src(raw, spec) =
  if fl(spec, "scheme") then scheme_to_yac(raw) else raw

let jit_eval(src, arch) =
  compile_jit(src, mk_jit_target(arch), false)

let jit_eval_repl(src, arch) =
  compile_jit(src, mk_jit_target(arch), true)

/* Windows Enter is CR LF; skip space/tab/CR/LF so a bare return is not eval. */
let repl_is_blank(s, i) =
  if i >= str_len(s) then true
  else
    let c = str_ref(s, i) in
    if c == 32 then repl_is_blank(s, i + 1)
    else if c == 9 then repl_is_blank(s, i + 1)
    else if c == 10 then repl_is_blank(s, i + 1)
    else if c == 13 then repl_is_blank(s, i + 1)
    else false

let repl_cmd_is(s, cmd) =
  let n = str_len(cmd) in
  if str_len(s) < n then false
  else str_slice(s, 0, n) == cmd

let repl_cmd_arg(s, skip) =
  let n = str_len(s) in
  let rec(i) =
    if i >= n then ""
    else
      let c = str_ref(s, i) in
      if c == 32 then rec(i + 1)
      else if c == 9 then rec(i + 1)
      else str_slice(s, i, n - i) in
  rec(skip)

let repl_preload(pos, spec, an) =
  let npos = len(pos) in
  if npos == 0 then 0
  else if npos == 1 and is_jit_file(nth(pos, 0)) then
    jit_load_yjit(nth(pos, 0), 1)
  else if pos_has_yjit(pos, 0) then
    print("error: .yjit cannot be mixed with other inputs")
  else
    let raw = read_sources(pos, 0, "") in
    if raw == 0 then 0
    else if raw == "" then 0
    else jit_eval_repl(prep_src(raw, spec), an)

let repl_loop(spec) =
  let arch = parse_arch_name(nth(spec, 0)) in
  let _ = print("yc> ", false) in
  let line = read_line() in
  if line == 0 then 0
  else if repl_is_blank(line, 0) then repl_loop(spec)
  else if line == ":q" or line == ":quit" or line == "(exit)" then 0
  else if repl_cmd_is(line, ":dump") then
    let _ = jit_dump_live(repl_cmd_arg(line, 5), arch) in
    repl_loop(spec)
  else if repl_cmd_is(line, ":load") then
    let p = repl_cmd_arg(line, 5) in
    let _ =
      if p == "" then print("usage: :load FILE.yjit")
      else jit_load_yjit(p, 1) in
    repl_loop(spec)
  else
    let _ = jit_eval_repl(prep_src(line, spec), arch) in
    repl_loop(spec)

let run_cli(pr) =
  let out_opt = nth(pr, 0) in
  let pos = nth(pr, 1) in
  let spec = nth(pr, 3) in
  let _ = if fl(spec, "verbose") then log_set_hush(false) else 0 in
  if fl(spec, "load-rt") then
    let _ = print("error: --load-rt is not supported in native yc") in 1
  else
    let an = parse_arch_name(nth(spec, 0)) in
    let fn = parse_format_name(nth(spec, 1)) in
    if an == "" then
      let _ = print(str_cat("error: unknown --arch ", nth(spec, 0))) in 2
    else if fn == "" then
      let _ = print(str_cat("error: unknown --format ", nth(spec, 1))) in 2
    else
      let npos = len(pos) in
      let inpath = if npos == 0 then "" else nth(pos, npos - 1) in
      if fl(spec, "repl") then
        let _ = repl_preload(pos, spec, an) in
        repl_loop(spec)
      else if npos == 0 then
        let _ = usage(0) in 2
      else if npos == 1 and is_jit_file(inpath) then
        jit_load_yjit(inpath, 0)
      else if pos_has_yjit(pos, 0) then
        let _ = print("error: .yjit cannot be mixed with other inputs") in 2
      else
        let raw = read_sources(pos, 0, "") in
        if raw == 0 then 2
        else
          let src = prep_src(raw, spec) in
          let bad_scm =
            if fl(spec, "scheme") then
              if str_len(src) < 7 then false
              else str_slice(src, 0, 7) == "error: "
            else false in
          if bad_scm then
            let _ = print(src) in 1
          else if fl(spec, "ast") then dump_ast(src)
          else if fl(spec, "dump-anf") then dump_anf(src)
          else if fl(spec, "dump-cps") then dump_cps(src, fl(spec, "opt"))
          else if fl(spec, "eval-cps") then eval_cps_src(src, fl(spec, "opt"))
          else if fl(spec, "dump-uncps") then dump_uncps(src, fl(spec, "opt"))
          else if fl(spec, "dump-rt") then dump_anf(src)
          else
            let want_uncps = fl(spec, "uncps") or fl(spec, "both") in
            let want_run = fl(spec, "cps") in
            let scheme_run = fl(spec, "scheme") and out_opt == "" in
            if want_uncps or (want_run and fl(spec, "opt")) then
              compile_uncps(src, mk_jit_target(an), false, fl(spec, "opt"))
            else if want_run or scheme_run then jit_eval(src, an)
            else
              let t = mk_target(an, fn, nth(spec, 2)) in
              let out0 = if out_opt == "" then default_out(inpath) else out_opt in
              let outpath =
                if nth(spec, 2) == "dylib" then dylib_out(out0, fn)
                else if fn == "pe" then pe_out(out0)
                else out0 in
              let _ = if fl(spec, "syms") then syms_enable(1) else syms_enable(0) in
              compile_src(src, outpath, t, nth(spec, 3))

let main =
  let argc_n = argc() in
  if argc_n < 2 then
    let _ = usage(0) in 2
  else
    let pr = parse_args(1, argc_n, "", [],
               [host_arch(), host_format(), "exec", "", [], "", ""]) in
    let err = nth(pr, 2) in
    if err == 1 then 0
    else if err != 0 then
      let _ = print("error: bad arguments") in err
    else run_cli(pr)
in main
