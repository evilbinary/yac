/* yc.yac — CLI: compile to ELF by default; yac-compatible run/dump flags JIT. */

let usage(_) =
  let _ = print("usage: yc [options] file.yac") in
  let _ = print("options:") in
  let _ = print("  --cps            compile to machine code and run (in-process)") in
  let _ = print("  --dump-anf       print the ANF and exit") in
  let _ = print("  --dump-cps       print ANF (CPS dump not yet) and exit") in
  let _ = print("  --both           compile and run (native path is one machine)") in
  let _ = print("  --uncps          compile and run") in
  let _ = print("  --dump-uncps     print the ANF and exit") in
  let _ = print("  --opt            accepted (CPS simplify not yet)") in
  let _ = print("  --ast            dump the parsed AST and exit") in
  let _ = print("  --no-gc          accepted (guest GC still runs in JIT image)") in
  let _ = print("  --limit-nodes N  accepted (C GC limit; unused natively)") in
  let _ = print("  --dump-rt FILE   print compiled ANF (not C rtio format)") in
  let _ = print("  --load-rt FILE   not supported in native yc") in
  let _ = print("  --repl           interactive loop; each line is compiled and jumped to") in
  let _ = print("                   empty line ignored; :q / :quit exits") in
  let _ = print("  --scheme         translate a Scheme subset, then run or compile") in
  let _ = print("  -o out           write an executable instead of running") in
  let _ = print("  --arch x86_64|arm64|riscv64") in
  let _ = print("  --format elf|pe|macho   --shared   --prof-out file") in
  0

let ends_with_yac(s) =
  let n = str_len(s) in
  if n < 4 then false
  else if str_ref(s, n - 4) != 46 then false
  else if str_ref(s, n - 3) != 121 then false
  else if str_ref(s, n - 2) != 97 then false
  else str_ref(s, n - 1) == 99

let default_out(inpath) =
  if ends_with_yac(inpath) then str_slice(inpath, 0, str_len(inpath) - 4)
  else inpath

let has_flag(fs, name, i) =
  if i >= len(fs) then false
  else if nth(fs, i) == name then true
  else has_flag(fs, name, i + 1)

let fl(spec, name) = has_flag(nth(spec, 4), name, 0)

let spec_flag(spec, f) =
  [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
   append(nth(spec, 4), [f]), nth(spec, 5), nth(spec, 6)]

/* parse: [out, pos, err, spec]
 * spec = [arch, format, kind, profpath, flags, dump_rt, load_rt]
 * err 1 = help */
let parse_args(i, argc, out, pos, spec) =
  if i >= argc then [out, pos, 0, spec]
  else
    let a = argv(i) in
    if a == "-h" or a == "--help" then
      let _ = usage(0) in [out, pos, 1, spec]
    else if a == "-o" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, argv(i + 1), pos, spec)
    else if a == "--arch" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [argv(i + 1), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--format" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), argv(i + 1), nth(spec, 2), nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--shared" or a == "--dylib" then
      parse_args(i + 1, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), "dylib", nth(spec, 3),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--profile" then
      parse_args(i + 1, argc, out, pos, spec)
    else if a == "--prof-out" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), argv(i + 1),
         nth(spec, 4), nth(spec, 5), nth(spec, 6)])
    else if a == "--dump-rt" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         append(nth(spec, 4), ["dump-rt"]), argv(i + 1), nth(spec, 6)])
    else if a == "--load-rt" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
        [nth(spec, 0), nth(spec, 1), nth(spec, 2), nth(spec, 3),
         append(nth(spec, 4), ["load-rt"]), nth(spec, 5), argv(i + 1)])
    else if a == "--limit-nodes" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos, spec)
    else if a == "--checkpoint-at" or a == "--resume" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos, spec)
    else if a == "--cps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "cps"))
    else if a == "--dump-anf" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-anf"))
    else if a == "--dump-cps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-cps"))
    else if a == "--both" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "both"))
    else if a == "--uncps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "uncps"))
    else if a == "--dump-uncps" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "dump-uncps"))
    else if a == "--opt" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "opt"))
    else if a == "--ast" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "ast"))
    else if a == "--no-gc" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "no-gc"))
    else if a == "--repl" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "repl"))
    else if a == "--scheme" then parse_args(i + 1, argc, out, pos, spec_flag(spec, "scheme"))
    else if str_len(a) > 0 and str_ref(a, 0) == 45 then
      [out, pos, 2, spec]
    else parse_args(i + 1, argc, out, append(pos, [a]), spec)

let prep_src(raw, spec) =
  if fl(spec, "scheme") then scheme_to_yac(raw) else raw

let jit_eval(src) =
  compile_jit(src, mk_jit_target(0))

let repl_loop(acc, spec) =
  let _ = print("yc> ", false) in
  let line = read_line() in
  if line == 0 then 0
  else if str_len(line) == 0 then repl_loop(acc, spec)
  else if line == ":q" or line == ":quit" then 0
  else
    let acc2 = str_cat(acc, str_cat(line, "\n")) in
    let rc = jit_eval(prep_src(acc2, spec)) in
    if rc == 0 then repl_loop(acc2, spec)
    else repl_loop(acc, spec)

let run_cli(pr) =
  let out_opt = nth(pr, 0) in
  let pos = nth(pr, 1) in
  let spec = nth(pr, 3) in
  if fl(spec, "load-rt") then
    let _ = print("error: --load-rt is not supported in native yc") in 1
  else
    let an = parse_arch_name(nth(spec, 0)) in
    let fn = parse_format_name(nth(spec, 1)) in
    if an == "" then
      let _ = print(str_cat("error: unknown --arch ", nth(spec, 0))) in 2
    else if fn == "" then
      let _ = print(str_cat("error: unknown --format ", nth(spec, 1))) in 2
    else
      let npos = len(pos) in
      let inpath = if npos == 0 then "" else nth(pos, npos - 1) in
      if fl(spec, "repl") then
        let acc0 = if inpath == "" then "" else read_file(inpath) in
        let acc1 = if acc0 == 0 then "" else acc0 in
        let _ =
          if acc1 == "" then 0
          else jit_eval(prep_src(acc1, spec)) in
        repl_loop(acc1, spec)
      else if inpath == "" then
        let _ = usage(0) in 2
      else
        let raw = read_file(inpath) in
        if raw == 0 then
          let _ = print(str_cat("cannot read file: ", inpath)) in 2
        else
          let src = prep_src(raw, spec) in
          if fl(spec, "ast") then dump_ast(src)
          else if fl(spec, "dump-anf") then dump_anf(src)
          else if fl(spec, "dump-cps") then dump_anf(src)
          else if fl(spec, "dump-uncps") then dump_anf(src)
          else if fl(spec, "dump-rt") then dump_anf(src)
          else
            let want_run = fl(spec, "cps") or fl(spec, "both") or fl(spec, "uncps") in
            let scheme_run = fl(spec, "scheme") and out_opt == "" in
            if want_run or scheme_run then jit_eval(src)
            else
              let t = mk_target(an, fn, nth(spec, 2)) in
              let outpath = if out_opt == "" then default_out(inpath) else out_opt in
              compile_src(src, outpath, t, nth(spec, 3))

let main =
  let argc_n = argc() in
  if argc_n < 2 then
    let _ = usage(0) in 2
  else
    let pr = parse_args(1, argc_n, "", [],
               ["x86_64", "elf", "exec", "", [], "", ""]) in
    let err = nth(pr, 2) in
    if err == 1 then 0
    else if err != 0 then
      let _ = print("error: bad arguments") in err
    else run_cli(pr)
in main
