/* yc.yac — self-hosted compiler driver (M4).
 *
 * Usage:
 *   yc <input.yac> [-o output] [--arch x86_64|arm64|riscv64]
 *                    [--format elf|pe|macho] [--shared]
 *
 * Default output is the input path with `.yac` stripped (no `.bin`):
 *   yc fact.yac          → fact
 *   yc src-self/yc.yac   → src-self/yc
 *
 * Under the C interpreter the bundle path is an extra positional arg:
 *   yac bundle.yac <input.yac> [-o output]
 * The last positional argument is always the input source file.
 *
 * Bundle:
 *   cat src-self/{log,pass,target,lexer,parser,anf,encode_x64,encode_arm64,encode_riscv64,elf,pe,macho,pack,lir,runtime,emit,emit_x86_64,emit_arm64,emit_riscv64,backend,lower,yc}.yac \
 *     > build/yc_tmp/yc_bundle.yac
 *
 * PIPELINE: src -lex-> tok -parse-> ast -anf-> anf -lower-> lir -emit-> pack
 * LIR is arch-independent; emit/pack take --arch (default x86_64).
 */

let usage(_) =
  let _ = print("usage: yc <file.yac> [-o out] [--arch x86_64|arm64|riscv64]") in
  let _ = print("              [--format elf|pe|macho] [--shared]") in
  0

/* nested ifs: `and` is not short-circuit; str_ref on a short name would fault */
let ends_with_yac(s) =
  let n = str_len(s) in
  if n < 4 then false
  else if str_ref(s, n - 4) != 46 then false
  else if str_ref(s, n - 3) != 121 then false
  else if str_ref(s, n - 2) != 97 then false
  else str_ref(s, n - 1) == 99

let default_out(inpath) =
  if ends_with_yac(inpath) then str_slice(inpath, 0, str_len(inpath) - 4)
  else inpath

/* parse argv: [out, pos, err, spec] spec=[arch, format, kind] */
let parse_args(i, argc, out, pos, spec) =
  if i >= argc then [out, pos, 0, spec]
  else
    let a = argv(i) in
    if a == "-h" or a == "--help" then
      let _ = usage(0) in [out, pos, 0, spec]
    else if a == "-o" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, argv(i + 1), pos, spec)
    else if a == "--arch" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
                      [argv(i + 1), nth(spec, 1), nth(spec, 2)])
    else if a == "--format" then
      if i + 1 >= argc then [out, pos, 2, spec]
      else parse_args(i + 2, argc, out, pos,
                      [nth(spec, 0), argv(i + 1), nth(spec, 2)])
    else if a == "--shared" then
      parse_args(i + 1, argc, out, pos, [nth(spec, 0), nth(spec, 1), "dylib"])
    else if a == "--dylib" then
      parse_args(i + 1, argc, out, pos, [nth(spec, 0), nth(spec, 1), "dylib"])
    else if str_len(a) > 0 and str_ref(a, 0) == 45 then
      [out, pos, 2, spec]
    else parse_args(i + 1, argc, out, append(pos, [a]), spec)

let anf_top(item) =
  let r = anf_expr(item, 0) in
  [nth(r, 0), nth(r, 1)]

let anf_all(i, prog, acc) =
  if i >= len(prog) then acc
  else anf_all(i + 1, prog, append(acc, [anf_top(nth(prog, i))]))

let pass_lex(src) =
  let _ = log("yc", "tokenize begin") in
  let toks = tokenize(src) in
  let _ = log_i("yc", "ntoks", len(toks)) in
  toks

let pass_parse(toks) =
  let _ = log("yc", "parse begin") in
  let prog = parse_program(toks, 0, []) in
  let _ = log_i("yc", "nprog", len(prog)) in
  prog

let pass_anf(prog) =
  let _ = log("yc", "anf begin") in
  let anf_list = anf_all(0, prog, []) in
  let _ = log_i("yc", "nanf", len(anf_list)) in
  anf_list

let pass_lower(anf_list) = compile_top(anf_list)

let pass_emit_t(t, lir) =
  let a = target_arch(t) in
  let _ = log("yc", "emit begin") in
  let r =
    if a == "x86_64" then
      emit_program_at(lir, target_vaddr(t), target_text_off(t))
    else if a == "arm64" then
      emit_program_arm64(lir, target_vaddr(t), target_text_off(t))
    else
      emit_program_riscv64(lir, target_vaddr(t), target_text_off(t)) in
  let code = nth(r, 0) in
  let _ = log_i("yc", "code_len", bytes_len(code)) in
  code

let pass_pack_t(t, code) =
  let _ = log("yc", "pack") in
  pack_image(t, code)

let make_pipeline(t) =
  [mk_pass("lex", pass_lex),
   mk_pass("parse", pass_parse),
   mk_pass("anf", pass_anf),
   mk_pass("lower", pass_lower),
   mk_pass("emit", fun(lir) -> pass_emit_t(t, lir)),
   mk_pass("pack", fun(code) -> pass_pack_t(t, code))]

let compile_file(inpath, outpath, t) =
  let _ = log("yc", "start") in
  let src = read_file(inpath) in
  let _ = log_i("yc", "src_len", str_len(src)) in
  let bin = run_passes(make_pipeline(t), src) in
  let _ = log_i("yc", "bin_len", bytes_len(bin)) in
  let _ = log("yc", "write") in
  let _ = write_file(outpath, bin) in
  let _ = log("yc", "done") in
  0

let main =
  let argc_n = argc() in
  if argc_n < 2 then
    let _ = usage(0) in 2
  else
    let pr = parse_args(1, argc_n, "", [], ["x86_64", "elf", "exec"]) in
    let err = nth(pr, 2) in
    if err != 0 then
      let _ = print("error: bad arguments") in err
    else
      let pos = nth(pr, 1) in
      if len(pos) == 0 then
        let _ = usage(0) in 2
      else
        let spec = nth(pr, 3) in
        let an = parse_arch_name(nth(spec, 0)) in
        let fn = parse_format_name(nth(spec, 1)) in
        if an == "" then
          let _ = print(str_cat("error: unknown --arch ", nth(spec, 0))) in 2
        else if fn == "" then
          let _ = print(str_cat("error: unknown --format ", nth(spec, 1))) in 2
        else
          let t = mk_target(an, fn, nth(spec, 2)) in
          let inpath = nth(pos, len(pos) - 1) in
          let out_opt = nth(pr, 0) in
          let outpath = if out_opt == "" then default_out(inpath) else out_opt in
          compile_file(inpath, outpath, t)
in main
