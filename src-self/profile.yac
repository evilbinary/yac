/* profile.yac — native yc per-function counts / incl / excl (ns).
 *
 * C interp already dumps via --prof-out (src/profile.c). Native yc_A
 * instruments letfun prologues and uses the same TSV shape.
 * Disabled path: yac_prof_enter sees empty cell and returns.
 * Bundled after lower.yac so fmap and hash_str exist.
 * Overrides runtime.yac no-op prof_enter_go / prof_leave_go (emit last-put-wins).
 */

let prof_rec_get(recs, name) =
  let v = fmap_get(recs, name) in
  if v == 0 then
    let b = box_new() in
    let _ = box_set(b, [name, 0, 0, 0]) in
    let _ = fmap_put(recs, name, b) in
    b
  else v

let prof_bump(recs, name) =
  let b = prof_rec_get(recs, name) in
  let t = box_get(b) in
  box_set(b, [nth(t, 0), nth(t, 1) + 1, nth(t, 2), nth(t, 3)])

let yac_prof_enable(path) =
  let c = yac_prof_cell() in
  if len(c) != 0 then 0
  else
    let recs = fmap_new(0) in
    let b = box_new() in
    let _ = box_set(b, [path, [], recs]) in
    list_push(c, b)

let prof_enter_go(name) =
  let c = yac_prof_cell() in
  if len(c) == 0 then 0
  else
    let b = nth(c, 0) in
    let t = box_get(b) in
    let recs = nth(t, 2) in
    let _ = prof_bump(recs, name) in
    let fr = [name, time_ns(), 0] in
    box_set(b, [nth(t, 0), cons(fr, nth(t, 1)), recs])

let prof_add_child(rest, elapsed) =
  if rest == [] then []
  else
    let p = nth(rest, 0) in
    cons([nth(p, 0), nth(p, 1), nth(p, 2) + elapsed], drop(rest, 1))

let prof_leave_go(_) =
  let c = yac_prof_cell() in
  if len(c) == 0 then 0
  else
    let b = nth(c, 0) in
    let t = box_get(b) in
    let stk = nth(t, 1) in
    if stk == [] then 0
    else
      let fr = nth(stk, 0) in
      let elapsed = time_ns() - nth(fr, 1) in
      let recs = nth(t, 2) in
      let rb = prof_rec_get(recs, nth(fr, 0)) in
      let rt = box_get(rb) in
      let excl = elapsed - nth(fr, 2) in
      let _ = box_set(rb, [nth(rt, 0), nth(rt, 1), nth(rt, 2) + elapsed,
                           nth(rt, 3) + excl]) in
      box_set(b, [nth(t, 0), prof_add_child(drop(stk, 1), elapsed), recs])

let prof_unwind(_) =
  let c = yac_prof_cell() in
  if len(c) == 0 then 0
  else
    let t = box_get(nth(c, 0)) in
    if nth(t, 1) == [] then 0
    else
      let _ = prof_leave_go(0) in
      prof_unwind(0)

let prof_collect_bkt(bkt, out, j, n) =
  if j >= n then out
  else
    let _ = list_push(out, box_get(nth(nth(bkt, j), 1))) in
    prof_collect_bkt(bkt, out, j + 1, n)

let prof_collect(recs, i, out) =
  if i >= 256 then out
  else
    let bkt = nth(recs, i) in
    prof_collect(recs, i + 1, prof_collect_bkt(bkt, out, 0, len(bkt)))

let prof_ins(sorted, rec) =
  if sorted == [] then cons(rec, [])
  else if nth(rec, 3) >= nth(nth(sorted, 0), 3) then cons(rec, sorted)
  else cons(nth(sorted, 0), prof_ins(drop(sorted, 1), rec))

let prof_sort(xs, i, acc) =
  if i >= len(xs) then acc
  else prof_sort(xs, i + 1, prof_ins(acc, nth(xs, i)))

let prof_puts(b, s) =
  let n = str_len(s) in
  let loop(i) =
    if i >= n then b
    else
      let _ = bytes_append(b, str_ref(s, i)) in
      loop(i + 1) in
  loop(0)

let prof_nl(b) =
  let _ = bytes_append(b, 10) in
  b

let prof_tab(b) =
  let _ = bytes_append(b, 9) in
  b

let prof_putn(b, n) = prof_puts(b, int_to_str(n))

let prof_line(b, rec, tot) =
  let excl = nth(rec, 3) in
  let incl = nth(rec, 2) in
  let pct = if tot == 0 then 0 else (excl * 100) / tot in
  let b1 = prof_puts(b, nth(rec, 0)) in
  let b2 = prof_tab(b1) in
  let b3 = prof_putn(b2, nth(rec, 1)) in
  let b4 = prof_tab(b3) in
  let b5 = prof_putn(b4, incl) in
  let b6 = prof_tab(b5) in
  let b7 = prof_putn(b6, excl) in
  let b8 = prof_tab(b7) in
  let b9 = prof_putn(b8, incl / 1000000) in
  let ba = prof_tab(b9) in
  let bb = prof_putn(ba, excl / 1000000) in
  let bc = prof_tab(bb) in
  let bd = prof_putn(bc, pct) in
  prof_nl(bd)

let prof_tot(xs, i, acc) =
  if i >= len(xs) then acc
  else prof_tot(xs, i + 1, acc + nth(nth(xs, i), 3))

let prof_lines(b, xs, tot, i) =
  if i >= len(xs) then b
  else prof_lines(prof_line(b, nth(xs, i), tot), xs, tot, i + 1)

let yac_prof_dump(_) =
  let c = yac_prof_cell() in
  if len(c) == 0 then 0
  else
    let t0 = box_get(nth(c, 0)) in
    let path = nth(t0, 0) in
    let _ = prof_unwind(0) in
    let t = box_get(nth(c, 0)) in
    let raw = prof_collect(nth(t, 2), 0, list_new()) in
    let xs = prof_sort(raw, 0, []) in
    let tot = prof_tot(xs, 0, 0) in
    let b0 = bytes_new() in
    let b1 = prof_nl(prof_puts(b0, "# yac-prof 1 native")) in
    let b2 = prof_nl(prof_puts(prof_puts(b1, "# file="), path)) in
    let b3 = prof_puts(b2, "# nfuncs=") in
    let b4 = prof_nl(prof_putn(b3, len(xs))) in
    let b5 = prof_nl(prof_puts(b4, "# name calls incl_ns excl_ns incl_ms excl_ms pct_excl")) in
    let b6 = prof_lines(b5, xs, tot, 0) in
    write_file(path, b6)
