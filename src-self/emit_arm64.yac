  let _ = a64_slot(b, 0, false, 0) in
  let _ = a64_movz(b, 8, 57, 0) in
  let _ = a64_svc(b) in
  let _ = a64_slot(b, 1, false, 0) in
  let _ = a64_tag(b, 0) in
  let _ = a64_leave(b) in
  [b, acall]

