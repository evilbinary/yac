  let b = bytes_new() in
  let _ = a64_stp_fp_lr(b) in
  let _ = a64_mov_sp(b, 29, 31) in
  let _ = a64_sub_imm(b, 31, 31, 64) in
  let _ = a64_stur(b, 19, 31, 0) in
  let _ = a64_stur(b, 20, 31, 8) in
  let _ = a64_stur(b, 21, 31, 16) in
  let headpos = bytes_len(b) in
  let _ = a64_mov_imm64(b, 0, 0) in
  let _ = a64_mov_reg(b, 19, 0) in
  let shipos = bytes_len(b) in
  let _ = a64_mov_imm64(b, 0, 0) in
  let _ = a64_ldur(b, 20, 0, 0) in
  let _ = a64_ldur(b, 21, 19, 0) in
  let jcl = bytes_len(b) in
  let _ = a64_cmp_reg(b, 21, 31) in
  let pcl = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_movz(b, 9, 0, 0) in
  let _ = a64_stur(b, 9, 21, 8) in
  let _ = a64_ldur(b, 21, 21, 0) in
  let jclb = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let _ = a64_apply_b26(b, jclb, jcl) in
  let _ = a64_patch_bcond(b, pcl, bytes_len(b)) in
  let _ = a64_add_imm(b, 21, 29, 16) in
  let jsc = bytes_len(b) in
  let _ = a64_cmp_reg(b, 21, 20) in
  let pscd = bytes_len(b) in
  let _ = a64_b_cond(b, 2, 0) in
  let _ = a64_ldur(b, 0, 21, 0) in
  let _ = a64_stur(b, 21, 31, 24) in
  let cscan = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_ldur(b, 21, 31, 24) in
  let _ = a64_add_imm(b, 21, 21, 8) in
  let jscb = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let _ = a64_apply_b26(b, jscb, jsc) in
  let _ = a64_patch_bcond(b, pscd, bytes_len(b)) in
