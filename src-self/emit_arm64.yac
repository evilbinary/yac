/* emit_arm64.yac — Linux AArch64 emit of integer LIR (tagged like x86).
 * Other LIR ops emit BRK. Pack/target still choose ELF/PE/Mach-O.
 */

let a64_frame_bytes(nlocals) =
  let nbytes = bshl(nlocals + 1, 3) in
  bshl(bshr(nbytes + 15, 4), 4)

let a64_tag(b, rd) =
  let _ = a64_movz(b, 9, 1, 0) in
  a64_orr_reg(b, rd, rd, 9)

let a64_untag_ptr(b, rd) =
  let _ = a64_mov_imm64(b, 10, 0 - 2) in
  a64_and_reg(b, rd, rd, 10)

let a64_apply_b26(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 335544320 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

/* yac_alloc(n in x0) -> x0 raw ptr. Size at [obj-8]; first-fit gc_free; else brk/mmap n+8. */
let gen_alloc_a64(_) =
  let b = bytes_new() in
  let _ = a64_sub_imm(b, 31, 31, 32) in
  let _ = a64_stur(b, 30, 31, 24) in
  let _ = a64_stur(b, 19, 31, 16) in
  let _ = a64_stur(b, 20, 31, 8) in
  let _ = a64_mov_reg(b, 19, 0) in
  let headpos = bytes_len(b) in
  let _ = a64_mov_imm64(b, 0, 0) in
  let _ = a64_stur(b, 0, 31, 0) in
  let _ = a64_add_imm(b, 0, 0, 32) in
  let _ = a64_ldur(b, 2, 0, 0) in
  let _ = a64_movz(b, 3, 0, 0) in
  let jfl = bytes_len(b) in
  let _ = a64_cmp_reg(b, 2, 31) in
  let pmiss = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_ldur(b, 4, 2, 0 - 8) in
  let _ = a64_cmp_reg(b, 4, 19) in
  let phit = bytes_len(b) in
  let _ = a64_b_cond(b, 2, 0) in
  let _ = a64_mov_reg(b, 3, 2) in
  let _ = a64_ldur(b, 2, 2, 0) in
  let jflb = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let _ = a64_apply_b26(b, jflb, jfl) in
  let _ = a64_patch_bcond(b, phit, bytes_len(b)) in
  let _ = a64_ldur(b, 1, 2, 0) in
  let _ = a64_cmp_reg(b, 3, 31) in
  let pnf = bytes_len(b) in
  let _ = a64_b_ne(b, 0) in
  let _ = a64_stur(b, 1, 0, 0) in
  let pgot = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let _ = a64_patch_bcond(b, pnf, bytes_len(b)) in
  let _ = a64_stur(b, 1, 3, 0) in
  let _ = a64_apply_b26(b, pgot, bytes_len(b)) in
  let _ = a64_mov_reg(b, 20, 2) in
  let plink = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let _ = a64_patch_bcond(b, pmiss, bytes_len(b)) in
  let _ = a64_movz(b, 0, 0, 0) in
  let _ = a64_movz(b, 8, 214, 0) in
  let _ = a64_svc(b) in
  let _ = a64_mov_reg(b, 20, 0) in
  let _ = a64_add_reg(b, 0, 20, 19) in
  let _ = a64_add_imm(b, 0, 0, 8) in
  let _ = a64_movz(b, 8, 214, 0) in
  let _ = a64_svc(b) in
  let _ = a64_add_reg(b, 9, 20, 19) in
  let _ = a64_add_imm(b, 9, 9, 8) in
  let _ = a64_cmp_reg(b, 0, 31) in
  let jz = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let jlt = bytes_len(b) in
  let _ = a64_b_cond(b, 11, 0) in
  let _ = a64_cmp_reg(b, 0, 9) in
  let jlo = bytes_len(b) in
  let _ = a64_b_cond(b, 3, 0) in
  let _ = a64_mov_reg(b, 0, 20) in
  let jok = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let mmap = bytes_len(b) in
  let _ = a64_patch_bcond(b, jz, mmap) in
  let _ = a64_patch_bcond(b, jlt, mmap) in
  let _ = a64_patch_bcond(b, jlo, mmap) in
  let _ = a64_add_imm(b, 1, 19, 8) in
  let _ = a64_movz(b, 0, 0, 0) in
  let _ = a64_movz(b, 2, 3, 0) in
  let _ = a64_movz(b, 3, 34, 0) in
  let _ = a64_mov_imm64(b, 4, 0 - 1) in
  let _ = a64_movz(b, 5, 0, 0) in
  let _ = a64_movz(b, 8, 222, 0) in
  let _ = a64_svc(b) in
  let fresh = bytes_len(b) in
  let rel = bshr(fresh - jok, 2) in
  let _ = a64_u32_at(b, jok, 335544320 + band(rel, 67108863)) in
  let _ = a64_mov_reg(b, 20, 0) in
  let _ = a64_stur(b, 19, 20, 0) in
  let _ = a64_add_imm(b, 20, 20, 8) in
  let _ = a64_apply_b26(b, plink, bytes_len(b)) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_ldur(b, 1, 0, 0) in
  let _ = a64_stur(b, 1, 20, 0) in
  let _ = a64_stur(b, 20, 0, 0) in
  let _ = a64_mov_reg(b, 0, 20) in
  let _ = a64_ldur(b, 30, 31, 24) in
  let _ = a64_ldur(b, 19, 31, 16) in
  let _ = a64_ldur(b, 20, 31, 8) in
  let _ = a64_add_imm(b, 31, 31, 32) in
  let _ = a64_ret(b) in
  [b, headpos]

let a64_slot(b, slot, store, rt) =
  let off = bshl(slot + 1, 3) in
  let _ = a64_sub_imm(b, 9, 29, off) in
  if store then a64_stur(b, rt, 9, 0) else a64_ldur(b, rt, 9, 0)

let a64_apply_bl(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 2483027968 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let a64_bl_rt(b, patches, dst, name) =
  let pos = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_slot(b, dst, true, 0) in
  cons(["bl", pos, name], patches)

let a64_enter(b, n) =
  let _ = a64_stp_fp_lr(b) in
  let _ = a64_mov_sp(b, 29, 31) in
  a64_sub_imm(b, 31, 31, n)

let a64_leave(b) =
  let _ = a64_mov_sp(b, 31, 29) in
  let _ = a64_ldp_fp_lr(b) in
  a64_ret(b)

/* yac_gc: mark tagged slots [x29+16, stack_hi), unlink unmarked.
 * x19=&gc_head x20=stack_hi x21=cursor. [bytes, headpos, shipos]. */
