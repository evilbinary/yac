let a64_dyn_loadcap(b) =
  let rec(i) =
    if i >= 6 then 0
    else
      let _ = a64_cmp_imm(b, 11, i) in
      let p = bytes_len(b) in
      let _ = a64_b_cond(b, 13, 0) in
      let _ = a64_ldur(b, i, 17, 32 + bshl(i, 3)) in
      let _ = a64_patch_bcond(b, p, bytes_len(b)) in
      rec(i + 1) in
  rec(0)

let gen_apply2_a64(_) =
  let b = bytes_new() in
  let _ = a64_enter(b, 32) in
  let _ = a64_slot(b, 0, true, 1) in
  let _ = a64_slot(b, 1, true, 2) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_mov_reg(b, 17, 0) in
  let _ = a64_ldur(b, 16, 17, 16) in
  let _ = a64_slot(b, 2, true, 16) in
  let _ = a64_ldur(b, 11, 17, 24) in
  let _ = a64_dyn_loadcap(b) in
  let _ = a64_cmp_imm(b, 11, 0) in
  let r0 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 1) in
  let r1 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 2) in
  let r2 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 3) in
  let r3 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 4) in
  let r4 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let r5 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let setu(base) =
    let _ = a64_slot(b, 0, false, 12) in
    let _ = a64_slot(b, 1, false, 13) in
    if base == 0 then
      let _ = a64_mov_reg(b, 0, 12) in a64_mov_reg(b, 1, 13)
    else if base == 1 then
      let _ = a64_mov_reg(b, 1, 12) in a64_mov_reg(b, 2, 13)
    else if base == 2 then
      let _ = a64_mov_reg(b, 2, 12) in a64_mov_reg(b, 3, 13)
    else if base == 3 then
      let _ = a64_mov_reg(b, 3, 12) in a64_mov_reg(b, 4, 13)
    else if base == 4 then
      let _ = a64_mov_reg(b, 4, 12) in a64_mov_reg(b, 5, 13)
    else
      let _ = a64_mov_reg(b, 5, 12) in a64_mov_reg(b, 6, 13) in
  let a0 = bytes_len(b) in
  let _ = setu(0) in
  let j0 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a1 = bytes_len(b) in
  let _ = setu(1) in
  let j1 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a2 = bytes_len(b) in
  let _ = setu(2) in
  let j2 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a3 = bytes_len(b) in
  let _ = setu(3) in
  let j3 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a4 = bytes_len(b) in
  let _ = setu(4) in
  let j4 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a5 = bytes_len(b) in
  let _ = setu(5) in
  let j5 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let lc = bytes_len(b) in
  let _ = a64_slot(b, 2, false, 16) in
  let _ = a64_blr(b, 16) in
  let _ = a64_leave(b) in
  let _ = a64_patch_bcond(b, r0, a0) in
  let _ = a64_patch_bcond(b, r1, a1) in
  let _ = a64_patch_bcond(b, r2, a2) in
  let _ = a64_patch_bcond(b, r3, a3) in
  let _ = a64_patch_bcond(b, r4, a4) in
  let _ = a64_apply_b26(b, r5, a5) in
  let _ = a64_apply_b26(b, j0, lc) in
  let _ = a64_apply_b26(b, j1, lc) in
  let _ = a64_apply_b26(b, j2, lc) in
  let _ = a64_apply_b26(b, j3, lc) in
  let _ = a64_apply_b26(b, j4, lc) in
  let _ = a64_apply_b26(b, j5, lc) in
  b

let gen_apply1_a64(_) =
  let b = bytes_new() in
  let _ = a64_enter(b, 32) in
  let _ = a64_slot(b, 0, true, 1) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_mov_reg(b, 17, 0) in
  let _ = a64_ldur(b, 16, 17, 16) in
  let _ = a64_slot(b, 1, true, 16) in
  let _ = a64_ldur(b, 11, 17, 24) in
  let _ = a64_dyn_loadcap(b) in
  let _ = a64_cmp_imm(b, 11, 0) in
  let r0 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 1) in
  let r1 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 2) in
  let r2 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 3) in
  let r3 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_cmp_imm(b, 11, 4) in
  let r4 = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let r5 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let setu(base) =
    let _ = a64_slot(b, 0, false, 9) in
    if base == 0 then a64_mov_reg(b, 0, 9)
    else if base == 1 then a64_mov_reg(b, 1, 9)
    else if base == 2 then a64_mov_reg(b, 2, 9)
    else if base == 3 then a64_mov_reg(b, 3, 9)
    else if base == 4 then a64_mov_reg(b, 4, 9)
    else a64_mov_reg(b, 5, 9) in
  let a0 = bytes_len(b) in
  let _ = setu(0) in
  let j0 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a1 = bytes_len(b) in
  let _ = setu(1) in
  let j1 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a2 = bytes_len(b) in
  let _ = setu(2) in
  let j2 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a3 = bytes_len(b) in
  let _ = setu(3) in
  let j3 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a4 = bytes_len(b) in
  let _ = setu(4) in
  let j4 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let a5 = bytes_len(b) in
  let _ = setu(5) in
  let j5 = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let lc = bytes_len(b) in
  let _ = a64_slot(b, 1, false, 16) in
  let _ = a64_blr(b, 16) in
  let _ = a64_leave(b) in
  let _ = a64_patch_bcond(b, r0, a0) in
  let _ = a64_patch_bcond(b, r1, a1) in
  let _ = a64_patch_bcond(b, r2, a2) in
  let _ = a64_patch_bcond(b, r3, a3) in
  let _ = a64_patch_bcond(b, r4, a4) in
  let _ = a64_apply_b26(b, r5, a5) in
  let _ = a64_apply_b26(b, j0, lc) in
  let _ = a64_apply_b26(b, j1, lc) in
  let _ = a64_apply_b26(b, j2, lc) in
  let _ = a64_apply_b26(b, j3, lc) in
  let _ = a64_apply_b26(b, j4, lc) in
  let _ = a64_apply_b26(b, j5, lc) in
  b

let gen_argv_a64(_) =
  let b = bytes_new() in
  let _ = a64_enter(b, 48) in
  let _ = a64_asr1(b, 2, 0) in
  let acpat = bytes_len(b) in
  let _ = a64_mov_imm64(b, 0, 0) in
  let _ = a64_ldur(b, 0, 0, 0) in
  let _ = a64_cmp_reg(b, 2, 0) in
  let jfail = bytes_len(b) in
  let _ = a64_b_cond(b, 2, 0) in
  let avpat = bytes_len(b) in
  let _ = a64_mov_imm64(b, 0, 0) in
  let _ = a64_ldur(b, 0, 0, 0) in
  let _ = a64_ldr_lsl3(b, 0, 0, 2) in
  let _ = a64_cmp_reg(b, 0, 31) in
  let jnull = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_slot(b, 0, true, 0) in
  let _ = a64_movz(b, 2, 0, 0) in
  let slen = bytes_len(b) in
  let _ = a64_slot(b, 0, false, 3) in
  let _ = a64_ldrb_reg(b, 1, 3, 2) in
  let _ = a64_cmp_reg(b, 1, 31) in
  let jslen = bytes_len(b) in
  let _ = a64_b_cond(b, 0, 0) in
  let _ = a64_add_imm(b, 2, 2, 1) in
  let jbslen = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let slend = bytes_len(b) in
  let _ = a64_slot(b, 1, true, 2) in
  let _ = a64_add_imm(b, 0, 2, 33) in
  let _ = a64_add_imm(b, 0, 0, 7) in
  let _ = a64_mov_imm64(b, 1, 0 - 8) in
  let _ = a64_and_reg(b, 0, 0, 1) in
  let acall = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_slot(b, 2, true, 0) in
  let _ = a64_movz(b, 1, 0, 0) in
  let _ = a64_stur(b, 1, 0, 8) in
  let _ = a64_movz(b, 1, 3, 0) in
  let _ = a64_stur(b, 1, 0, 16) in
  let _ = a64_slot(b, 1, false, 1) in
  let _ = a64_stur(b, 1, 0, 24) in
  let _ = a64_movz(b, 2, 0, 0) in
  let cpy = bytes_len(b) in
  let _ = a64_slot(b, 1, false, 1) in
  let _ = a64_cmp_reg(b, 2, 1) in
  let jcpy = bytes_len(b) in
  let _ = a64_b_cond(b, 2, 0) in
  let _ = a64_slot(b, 0, false, 3) in
  let _ = a64_ldrb_reg(b, 4, 3, 2) in
  let _ = a64_slot(b, 2, false, 0) in
  let _ = a64_add_imm(b, 0, 0, 32) in
  let _ = a64_strb_reg(b, 4, 0, 2) in
  let _ = a64_add_imm(b, 2, 2, 1) in
  let jbcpy = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let cpyend = bytes_len(b) in
  let _ = a64_slot(b, 2, false, 0) in
  let _ = a64_add_imm(b, 0, 0, 32) in
  let _ = a64_slot(b, 1, false, 2) in
  let _ = a64_add_reg(b, 0, 0, 2) in
  let _ = a64_strb(b, 31, 0) in
  let _ = a64_slot(b, 2, false, 0) in
  let _ = a64_tag(b, 0) in
  let _ = a64_leave(b) in
  let fail = bytes_len(b) in
  let _ = a64_movz(b, 0, 0, 0) in
  let _ = a64_leave(b) in
  let _ = a64_patch_bcond(b, jfail, fail) in
  let _ = a64_patch_bcond(b, jnull, fail) in
  let _ = a64_apply_b26(b, jbslen, slen) in
  let _ = a64_patch_bcond(b, jslen, slend) in
  let _ = a64_apply_b26(b, jbcpy, cpy) in
  let _ = a64_patch_bcond(b, jcpy, cpyend) in
  [b, acpat, avpat, acall]

/* x0,x1 already untagged ints; tagged 0/2 in x0. */
let a64_cmp_int(b, op) =
  let _ = a64_cmp_reg(b, 0, 1) in
  let _ = a64_movz(b, 0, 0, 0) in
  let _ = a64_movz(b, 2, 1, 0) in
  let cc =
    if op == "==" then 1
    else if op == "!=" then 0
    else if op == "<" then 10
    else if op == "<=" then 12
    else if op == ">" then 13
    else if op == ">=" then 11
    else 1 in
  let _ = a64_b_cond(b, cc, 2) in
  let _ = a64_mov_reg(b, 0, 2) in
  a64_lsl1(b, 0, 0)

/* cmp ==/!=: both STR (kind 3) -> yac_str_eq; else integer. */
let a64_cmp_maybe_str(b, op, patches) =
  let _ = a64_sub_imm(b, 31, 31, 16) in
  let _ = a64_stur(b, 0, 31, 0) in
  let _ = a64_stur(b, 1, 31, 8) in
  let _ = a64_cmp_imm(b, 0, 1) in
  let jnil1 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_movz(b, 9, 1, 0) in
  let _ = a64_and_reg(b, 10, 0, 9) in
  let _ = a64_cmp_reg(b, 10, 31) in
  let jz1 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_cmp_imm(b, 1, 1) in
  let jnil2 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_and_reg(b, 10, 1, 9) in
  let _ = a64_cmp_reg(b, 10, 31) in
  let jz2 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_ldur(b, 2, 0, 16) in
  let _ = a64_cmp_imm(b, 2, 3) in
  let jne1 = bytes_len(b) in
  let _ = a64_b_ne(b, 0) in
  let _ = a64_ldur(b, 0, 31, 8) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_ldur(b, 2, 0, 16) in
  let _ = a64_cmp_imm(b, 2, 3) in
  let jne2 = bytes_len(b) in
  let _ = a64_b_ne(b, 0) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_ldur(b, 1, 31, 8) in
  let scall = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_add_imm(b, 31, 31, 16) in
  let _ =
    if op == "!=" then
      let _ = a64_asr1(b, 0, 0) in
      let _ = a64_movz(b, 9, 1, 0) in
      let _ = a64_eor_reg(b, 0, 0, 9) in
      a64_lsl1(b, 0, 0)
    else 0 in
  let jdone = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let intp = bytes_len(b) in
  let _ = a64_patch_bcond(b, jnil1, intp) in
  let _ = a64_patch_bcond(b, jz1, intp) in
  let _ = a64_patch_bcond(b, jnil2, intp) in
  let _ = a64_patch_bcond(b, jz2, intp) in
  let _ = a64_patch_bcond(b, jne1, intp) in
  let _ = a64_patch_bcond(b, jne2, intp) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_ldur(b, 1, 31, 8) in
  let _ = a64_add_imm(b, 31, 31, 16) in
  let _ = a64_asr1(b, 0, 0) in
  let _ = a64_asr1(b, 1, 1) in
  let _ = a64_cmp_int(b, op) in
  let _ = a64_apply_b26(b, jdone, bytes_len(b)) in
  cons(["bl", scall, "yac_str_eq"], patches)

let emit_a64_i_core(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "prologue" then
    let nlocals = nth(insn, 1) in
    let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
    let nbytes = a64_frame_bytes(nlocals) in
    let patches2 =
      if is_entry then
        let _ = a64_ldur(b, 8, 31, 0) in
        let ac_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 8, 0, 0) in
        let _ = a64_add_imm(b, 8, 31, 8) in
        let av_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 8, 0, 0) in
        cons(["saved_argv", av_save],
             cons(["saved_argc", ac_save], patches))
      else patches in
    let _ =
      if is_entry then a64_mov_sp(b, 29, 31)
      else
        let _ = a64_stp_fp_lr(b) in
        a64_mov_sp(b, 29, 31) in
    let patches3 =
      if is_entry then
        let sh_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 29, 0, 0) in
        cons(["stack_hi", sh_save], patches2)
      else patches2 in
    let _ = a64_sub_imm(b, 31, 31, nbytes) in
    let storep(j) =
      if j >= nparams then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, j + 1, true, j) in
        storep(j + 1) in
    let _ = storep(0) in
    [b, cur, labels, patches3]
  else if k == "mov_imm" then
    let _ = a64_mov_imm64(b, 0, nth(insn, 2)) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "mov" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "binop" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ =
      if op == "+" then a64_add_reg(b, 0, 0, 1)
      else if op == "-" then a64_sub_reg(b, 0, 0, 1)
      else if op == "*" then a64_mul(b, 0, 0, 1)
      else if op == "&" then a64_and_reg(b, 0, 0, 1)
      else if op == "|" then a64_orr_reg(b, 0, 0, 1)
      else if op == "and" then a64_and_reg(b, 0, 0, 1)
      else if op == "or" then a64_orr_reg(b, 0, 0, 1)
      else if op == "/" then a64_sdiv(b, 0, 0, 1)
      else if op == "%" then
        let _ = a64_sdiv(b, 2, 0, 1) in
        a64_msub(b, 0, 2, 1, 0)
      else a64_add_reg(b, 0, 0, 1) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    [b, cur, labels, patches]
  else if k == "icmp" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_cmp_int(b, op) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    [b, cur, labels, patches]
  else if k == "cmp" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let patches2 =
      if op == "==" or op == "!=" then a64_cmp_maybe_str(b, op, patches)
      else
        let _ = a64_asr1(b, 0, 0) in
        let _ = a64_asr1(b, 1, 1) in
        let _ = a64_cmp_int(b, op) in
        patches in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    [b, cur, labels, patches2]
  else if k == "label" then
    [b, cur, cons([nth(insn, 1), bytes_len(b)], labels), patches]
  else if k == "jmp" then
    let pos = bytes_len(b) in
    let _ = a64_b(b, 0) in
    [b, cur, labels, cons(["b26", pos, nth(insn, 1)], patches)]
  else if k == "br" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_cmp_reg(b, 0, 31) in
    let peq = bytes_len(b) in
    let _ = a64_b_eq(b, 0) in
    let pne = bytes_len(b) in
    let _ = a64_b(b, 0) in
    [b, cur, labels,
     cons(["b26", pne, nth(insn, 2)],
          cons(["beq", peq, nth(insn, 3)], patches))]
  else if k == "call" then
    let args = nth(insn, 3) in
    let na = len(args) in
    let load(j) =
      if j >= na then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, nth(args, j), false, j) in
        load(j + 1) in
    let _ = load(0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, nth(insn, 2)], patches)]
  else if k == "ret" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    if is_entry then
      let _ = a64_ret(b) in [b, cur, labels, patches]
    else
      let _ = a64_mov_sp(b, 31, 29) in
      let _ = a64_ldp_fp_lr(b) in
      let _ = a64_ret(b) in
      [b, cur, labels, patches]
  else if k == "exit" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_movz(b, 8, 93, 0) in
    let _ = a64_svc(b) in
    [b, cur, labels, patches]
  else if k == "tailcall" then
    let fn = nth(insn, 2) in
    let args = nth(insn, 3) in
    let na = len(args) in
    let load(j) =
      if j >= na then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, nth(args, j), false, j) in
        load(j + 1) in
    let _ = load(0) in
    let _ =
      if is_entry then 0
      else
        let _ = a64_mov_sp(b, 31, 29) in
        a64_ldp_fp_lr(b) in
    let pos = bytes_len(b) in
    let _ = a64_b(b, 0) in
    [b, cur, labels, cons(["b26", pos, fn], patches)]
  else st

let emit_a64_i_heap(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "obj_kind" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, 16) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_ld" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, nth(insn, 3)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_st" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "tag" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "is_int" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_movz(b, 9, 1, 0) in
    let _ = a64_and_reg(b, 10, 0, 9) in
    let _ = a64_eor_reg(b, 10, 10, 9) in
    let _ = a64_lsl1(b, 0, 10) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_sti" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_mov_imm64(b, 1, nth(insn, 3)) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "obj_st_int" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "ld8" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "st8" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_slot(b, nth(insn, 2), false, 2) in
    let _ = a64_asr1(b, 2, 2) in
    let _ = a64_add_reg(b, 0, 0, 2) in
    let _ = a64_strb(b, 1, 0) in
    [b, cur, labels, patches]
  else if k == "write1" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_sub_imm(b, 31, 31, 16) in
    let _ = a64_strb(b, 0, 31) in
    let _ = a64_mov_sp(b, 1, 31) in
    let _ = a64_movz(b, 2, 1, 0) in
    let _ = a64_movz(b, 0, 1, 0) in
    let _ = a64_movz(b, 8, 64, 0) in
    let _ = a64_svc(b) in
    let _ = a64_add_imm(b, 31, 31, 16) in
    [b, cur, labels, patches]
  else if k == "clock" then
    let _ = a64_sub_imm(b, 31, 31, 16) in
    let _ = a64_movz(b, 0, nth(insn, 3), 0) in
    let _ = a64_mov_sp(b, 1, 31) in
    let _ = a64_movz(b, 8, 113, 0) in
    let _ = a64_svc(b) in
    let _ = a64_ldur(b, 0, 31, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    let _ = a64_ldur(b, 0, 31, 8) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    let _ = a64_add_imm(b, 31, 31, 16) in
    [b, cur, labels, patches]
  else if k == "glob" then
    let gpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_ldur(b, 0, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    let which = nth(insn, 2) in
    let gkind = if which == 1 then "saved_argc" else "saved_argv" in
    [b, cur, labels, cons([gkind, gpos], patches)]
  else if k == "alloc" then
    let _ = a64_mov_imm64(b, 0, nth(insn, 2)) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, "yac_alloc"], patches)]
  else if k == "alloc_s" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, "yac_alloc"], patches)]
  else if k == "print" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_movz(b, 9, 1, 0) in
    let _ = a64_and_reg(b, 10, 0, 9) in
    let _ = a64_cmp_reg(b, 10, 31) in
    let jptr = bytes_len(b) in
    let _ = a64_b_ne(b, 0) in
    let c_int = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let jend = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let ptroff = bytes_len(b) in
    let _ = a64_patch_bcond(b, jptr, ptroff) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let c_val = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let nl = bytes_len(b) in
    let _ = a64_apply_b26(b, jend, nl) in
    let _ = a64_sub_imm(b, 31, 31, 16) in
    let _ = a64_movz(b, 0, 10, 0) in
    let _ = a64_strb(b, 0, 31) in
    let _ = a64_mov_sp(b, 1, 31) in
    let _ = a64_movz(b, 2, 1, 0) in
    let _ = a64_movz(b, 0, 1, 0) in
    let _ = a64_movz(b, 8, 64, 0) in
    let _ = a64_svc(b) in
    let _ = a64_add_imm(b, 31, 31, 16) in
    [b, cur, labels, cons(["bl", c_int, "print_int"],
                          cons(["bl", c_val, "print_val"], patches))]
  else if k == "argc" then
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_argc")]
  else if k == "time_ms" then
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "time_ms")]
  else if k == "time_str" then
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "time_str")]
  else if k == "argv" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, "yac_argv"], patches)]
  else st

let emit_a64_i_clos(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "closure" then
    let dst = nth(insn, 1) in
    let fnName = nth(insn, 2) in
    let caps = nth(insn, 3) in
    let nenv = len(caps) in
    let size = bshl(4 + nenv, 3) in
    let _ = a64_mov_imm64(b, 0, size) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let fnpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 1, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_movz(b, 1, nenv, 0) in
    let _ = a64_stur(b, 1, 0, 24) in
    let storecap(i) =
      if i >= nenv then 0
      else
        let _ = a64_slot(b, nth(caps, i), false, 1) in
        let _ = a64_stur(b, 1, 0, 32 + bshl(i, 3)) in
        storecap(i + 1) in
    let _ = storecap(0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, dst, true, 0) in
    [b, cur, labels,
     cons(["bl", acall, "yac_alloc"],
          cons(["closurefn", fnpos, fnName], patches))]
  else if k == "apply" then
    let dst = nth(insn, 1) in
    let clos = nth(insn, 2) in
    let ncap = nth(insn, 3) in
    let args = nth(insn, 4) in
    let nargs = len(args) in
    let ntot = ncap + nargs in
    if ncap < 0 then
      if nargs == 1 or nargs == 2 then
        let _ = a64_slot(b, clos, false, 0) in
        let _ = a64_slot(b, nth(args, 0), false, 1) in
        let _ = if nargs == 2 then a64_slot(b, nth(args, 1), false, 2) else 0 in
        let pos = bytes_len(b) in
        let _ = a64_bl(b, 0) in
        let _ = a64_slot(b, dst, true, 0) in
        let nm = if nargs == 1 then "yac_apply1" else "yac_apply2" in
        [b, cur, labels, cons(["bl", pos, nm], patches)]
      else
        let _ = a64_brk(b) in [b, cur, labels, patches]
    else if ntot > 8 then
      let _ = a64_brk(b) in [b, cur, labels, patches]
    else
      let _ = a64_slot(b, clos, false, 17) in
      let _ = a64_untag_ptr(b, 17) in
      let _ = a64_ldur(b, 16, 17, 16) in
      let load(i) =
        if i >= ntot then 0
        else if i < ncap then
          let _ = a64_ldur(b, i, 17, 32 + bshl(i, 3)) in
          load(i + 1)
        else
          let _ = a64_slot(b, nth(args, i - ncap), false, i) in
          load(i + 1) in
      let _ = load(0) in
      let _ = a64_blr(b, 16) in
      let _ = a64_slot(b, dst, true, 0) in
      [b, cur, labels, patches]
  else if k == "tailapply" then
    let clos = nth(insn, 2) in
    let ncap = nth(insn, 3) in
    let args = nth(insn, 4) in
    let nargs = len(args) in
    let ntot = ncap + nargs in
    if ncap < 0 then
      if nargs == 1 or nargs == 2 then
        let _ = a64_slot(b, clos, false, 0) in
        let _ = a64_slot(b, nth(args, 0), false, 1) in
        let _ = if nargs == 2 then a64_slot(b, nth(args, 1), false, 2) else 0 in
        let _ =
          if is_entry then 0
          else
            let _ = a64_mov_sp(b, 31, 29) in
            a64_ldp_fp_lr(b) in
        let pos = bytes_len(b) in
        let _ = a64_b(b, 0) in
        let nm = if nargs == 1 then "yac_apply1" else "yac_apply2" in
        [b, cur, labels, cons(["b26", pos, nm], patches)]
      else
        let _ = a64_brk(b) in [b, cur, labels, patches]
    else if ntot > 8 then
      let _ = a64_brk(b) in [b, cur, labels, patches]
    else
      let _ = a64_slot(b, clos, false, 17) in
      let _ = a64_untag_ptr(b, 17) in
      let _ = a64_ldur(b, 16, 17, 16) in
      let load(i) =
        if i >= ntot then 0
        else if i < ncap then
          let _ = a64_ldur(b, i, 17, 32 + bshl(i, 3)) in
          load(i + 1)
        else
          let _ = a64_slot(b, nth(args, i - ncap), false, i) in
          load(i + 1) in
      let _ = load(0) in
      let _ =
        if is_entry then 0
        else
          let _ = a64_mov_sp(b, 31, 29) in
          a64_ldp_fp_lr(b) in
      let _ = a64_br(b, 16) in
      [b, cur, labels, patches]
  else st

let emit_a64_i_prim(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "nil" then
    let _ = a64_movz(b, 0, 1, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "cons" then
    let _ = a64_mov_imm64(b, 0, 40) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let _ = a64_movz(b, 1, 2, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let _ = a64_stur(b, 1, 0, 24) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_stur(b, 1, 0, 32) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", acall, "yac_alloc"], patches)]
  else if k == "strlit" then
    let dst = nth(insn, 1) in
    let s = nth(insn, 2) in
    let n = str_len(s) in
    let size = bshl(bshr(32 + n + 1 + 7, 3), 3) in
    let _ = a64_mov_imm64(b, 0, size) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let _ = a64_movz(b, 1, 3, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_mov_imm64(b, 1, n) in
    let _ = a64_stur(b, 1, 0, 24) in
    let copy(i) =
      if i >= n then 0
      else
        let _ = a64_add_imm(b, 1, 0, 32 + i) in
        let _ = a64_movz(b, 2, str_ref(s, i), 0) in
        let _ = a64_strb(b, 2, 1) in
        copy(i + 1) in
    let _ = copy(0) in
    let _ = a64_add_imm(b, 1, 0, 32 + n) in
    let _ = a64_strb(b, 31, 1) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, dst, true, 0) in
    [b, cur, labels, cons(["bl", acall, "yac_alloc"], patches)]
  else if k == "str_len" then
    let dst = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_cmp_reg(b, 0, 31) in
    let jz = bytes_len(b) in
    let _ = a64_b_cond(b, 0, 0) in
    let _ = a64_cmp_imm(b, 0, 1) in
    let jnil = bytes_len(b) in
    let _ = a64_b_cond(b, 0, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_ldur(b, 0, 0, 24) in
    let _ = a64_lsl1(b, 0, 0) in
    let jd = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let zlen = bytes_len(b) in
    let _ = a64_movz(b, 0, 0, 0) in
    let done = bytes_len(b) in
    let _ = a64_patch_bcond(b, jz, zlen) in
    let _ = a64_patch_bcond(b, jnil, zlen) in
    let _ = a64_apply_b26(b, jd, done) in
    let _ = a64_slot(b, dst, true, 0) in
    [b, cur, labels, patches]
  else if k == "str_ref" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_imm(b, 0, 0, 32) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "bytes_new" then
    let _ = a64_mov_imm64(b, 0, 40 + 1048576) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let _ = a64_movz(b, 1, 4, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_stur(b, 31, 0, 24) in
    let _ = a64_mov_imm64(b, 1, 1048576) in
    let _ = a64_stur(b, 1, 0, 32) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", acall, "yac_alloc"], patches)]
  else if k == "bytes_len" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_ldur(b, 0, 0, 24) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "bytes_ref" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_imm(b, 0, 0, 40) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "bytes_put" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_mov_reg(b, 3, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    let _ = a64_asr1(b, 2, 2) in
    let _ = a64_add_imm(b, 0, 3, 40) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_strb(b, 2, 0) in
    let _ = a64_add_imm(b, 1, 1, 1) in
    let _ = a64_ldur(b, 0, 3, 24) in
    let _ = a64_cmp_reg(b, 1, 0) in
    let jsk = bytes_len(b) in
    let _ = a64_b_cond(b, 9, 0) in
    let _ = a64_stur(b, 1, 3, 24) in
    let _ = a64_patch_bcond(b, jsk, bytes_len(b)) in
    let _ = a64_movz(b, 0, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "len" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_len")]
  else if k == "nth" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_nth")]
  else if k == "tail" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_tail")]
  else if k == "append" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_append")]
  else if k == "list_rev" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_rev")]
  else if k == "list_new" then
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_new")]
  else if k == "list_push" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_push")]
  else if k == "str_cat" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_str_cat")]
  else if k == "str_slice" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_str_slice")]
  else if k == "int_to_str" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_int_to_str")]
  else if k == "bytes_to_str" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_to_str")]
  else if k == "bytes_extend" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_extend")]
  else if k == "bytes_append" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_mov_reg(b, 3, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_ldur(b, 2, 3, 24) in
    let _ = a64_add_imm(b, 0, 3, 40) in
    let _ = a64_add_reg(b, 0, 0, 2) in
    let _ = a64_strb(b, 1, 0) in
    let _ = a64_add_imm(b, 2, 2, 1) in
    let _ = a64_stur(b, 2, 3, 24) in
    let _ = a64_mov_reg(b, 0, 3) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "drop" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_drop")]
  else if k == "foldl" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_foldl")]
  else if k == "map" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    [b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_map")]
  else if k == "read_file" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, "yac_read_file"], patches)]
  else if k == "write_file" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, "yac_write_file"], patches)]
  else
    let _ = a64_brk(b) in
    [b, cur, labels, patches]

let emit_insn_a64(st, insn, is_entry) =
  let k = nth(insn, 0) in
  if k == "closure" or k == "apply" or k == "tailapply" then
    emit_a64_i_clos(st, insn, is_entry)
  else if k == "prologue" or k == "mov_imm" or k == "mov" or k == "binop"
       or k == "cmp" or k == "icmp" or k == "label" or k == "call"
       or k == "tailcall" or k == "jmp" or k == "br" or k == "ret"
       or k == "exit" then
    emit_a64_i_core(st, insn, is_entry)
  else if k == "obj_kind" or k == "obj_ld" or k == "obj_st" or k == "tag"
       or k == "is_int" or k == "alloc" or k == "obj_sti" or k == "obj_st_int"
       or k == "alloc_s" or k == "ld8" or k == "st8" or k == "print"
       or k == "write1" or k == "clock" or k == "glob" or k == "time_ms"
       or k == "time_str" or k == "argc" or k == "argv" then
    emit_a64_i_heap(st, insn)
  else emit_a64_i_prim(st, insn)



let a64_lookup(labels, name) =
  let n = len(labels) in
  let scan(i) =
    if i < 0 then 0
    else if nth(nth(labels, i), 0) == name then nth(nth(labels, i), 1)
    else scan(i - 1) in
  scan(n - 1)

let emit_program_arm64(prog, load_vaddr, text_off) =
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = bytes_len(nth(st, 0)) in
      let st0 = [nth(st, 0), 0, nth(st, 2), nth(st, 3)] in
      let insns = nth(f, 4) in
      if len(insns) == 0 then emit_fun(i + 1, st, fo)
      else
        let run(j, s) =
          if j >= len(insns) then s
          else run(j + 1, emit_insn_a64(s, nth(insns, j), is_entry)) in
        let s1 = run(0, st0) in
        emit_fun(i + 1, s1, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, [out, 0, [], []], []) in
  let st = nth(r1, 0) in
  let fo0 = nth(r1, 1) in
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let alc_off = bytes_len(b) in
  let alcr = gen_alloc_a64(0) in
  let _ = b_append(b, nth(alcr, 0)) in
  let rfr = gen_read_file_a64(0) in
  let rf_off = bytes_len(b) in
  let _ = b_append(b, nth(rfr, 0)) in
  let wf_off = bytes_len(b) in
  let _ = b_append(b, gen_write_file_a64(0)) in
  let a2_off = bytes_len(b) in
  let _ = b_append(b, gen_apply2_a64(0)) in
  let a1_off = bytes_len(b) in
  let _ = b_append(b, gen_apply1_a64(0)) in
  let avr = gen_argv_a64(0) in
  let av_off = bytes_len(b) in
  let _ = b_append(b, nth(avr, 0)) in
  let gc_off = bytes_len(b) in
  let gcr = gen_gc_a64(0) in
  let _ = b_append(b, nth(gcr, 0)) in
  let fo = cons(["yac_apply1", a1_off],
                cons(["yac_apply2", a2_off],
                     cons(["yac_write_file", wf_off],
                          cons(["yac_read_file", rf_off],
                               cons(["yac_alloc", alc_off],
                                    cons(["yac_gc", gc_off],
                                    cons(["yac_argv", av_off], fo0))))))) in
  let data_start = bytes_len(b) in
  let fill_data(i) =
    if i >= 40 then 0
    else let _ = bytes_append(b, 0) in fill_data(i + 1) in
  let _ = fill_data(0) in
  let GLOBALS_BASE = load_vaddr + text_off + data_start in
  let patches2 =
    cons(["gc_head", alc_off + nth(alcr, 1)],
         cons(["gc_head", gc_off + nth(gcr, 1)],
              cons(["stack_hi", gc_off + nth(gcr, 2)],
         cons(["bl", rf_off + nth(rfr, 1), "yac_alloc"],
              cons(["bl", av_off + nth(avr, 3), "yac_alloc"],
                   cons(["saved_argc", av_off + nth(avr, 1)],
                        cons(["saved_argv", av_off + nth(avr, 2)], patches))))))) in
  let resolve(i) =
    if i < 0 then 0
    else
      let p = nth(patches2, i) in
      let kind = nth(p, 0) in
      let _ =
        if kind == "saved_argc" then
          a64_mov_imm64_at(b, nth(p, 1), 0, GLOBALS_BASE + 8)
        else if kind == "saved_argv" then
          a64_mov_imm64_at(b, nth(p, 1), 0, GLOBALS_BASE + 16)
        else if kind == "stack_hi" then
          a64_mov_imm64_at(b, nth(p, 1), 0, GLOBALS_BASE + 24)
        else if kind == "gc_head" then
          a64_mov_imm64_at(b, nth(p, 1), 0, GLOBALS_BASE)
        else if kind == "closurefn" then
          let fo_fn = a64_lookup(fo, nth(p, 2)) in
          a64_mov_imm64_at(b, nth(p, 1), 1, load_vaddr + text_off + fo_fn)
        else
          let pos = nth(p, 1) in
          let lab = nth(p, 2) in
          let targ = a64_lookup(labels, lab) in
          let targ2 =
            if targ == 0 then a64_lookup(fo, lab) else targ in
          if kind == "bl" then a64_apply_bl(b, pos, targ2)
          else if kind == "beq" then
            let rel = bshr(targ2 - pos, 2) in
            let w = 1409286144 + bshl(band(rel, 524287), 5) in
            let _ = bytes_put(b, pos, band(w, 255)) in
            let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
            let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
            bytes_put(b, pos + 3, band(bshr(w, 24), 255))
          else a64_apply_b26(b, pos, targ2) in
      resolve(i - 1) in
  let _ = resolve(len(patches2) - 1) in
  [b, fo]
