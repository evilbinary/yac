/* emit_arm64.yac — Linux AArch64 emit of integer LIR (tagged like x86).
 * Other LIR ops emit BRK. Pack/target still choose ELF/PE/Mach-O.
 */

let a64_slot(b, slot, store, rt) =
  let off = bshl(slot + 1, 3) in
  let _ = a64_sub_imm(b, 9, 29, off) in
  if store then a64_stur(b, rt, 9, 0) else a64_ldur(b, rt, 9, 0)

let a64_apply_b26(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 335544320 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let a64_apply_bl(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 2483027968 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let emit_insn_a64(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "prologue" then
    let nlocals = nth(insn, 1) in
    let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
    let nbytes = bshl(nlocals + 1, 3) in
    let _ =
      if is_entry then a64_mov_reg(b, 29, 31)
      else
        let _ = a64_stp_fp_lr(b) in
        a64_mov_reg(b, 29, 31) in
    let _ = a64_sub_imm(b, 31, 31, nbytes) in
    let storep(j) =
      if j >= nparams then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, j + 1, true, j) in
        storep(j + 1) in
    let _ = storep(0) in
    [b, cur, labels, patches]
  else if k == "mov_imm" then
    let _ = a64_mov_imm64(b, 0, nth(insn, 2)) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "mov" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "binop" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ =
      if op == "+" then a64_add_reg(b, 0, 0, 1)
      else if op == "-" then a64_sub_reg(b, 0, 0, 1)
      else if op == "*" then a64_mul(b, 0, 0, 1)
      else if op == "&" then a64_and_reg(b, 0, 0, 1)
      else if op == "|" then a64_orr_reg(b, 0, 0, 1)
      else a64_add_reg(b, 0, 0, 1) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    [b, cur, labels, patches]
  else if k == "cmp" or k == "icmp" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_cmp_reg(b, 0, 1) in
    let _ = a64_movz(b, 0, 0, 0) in
    let _ = a64_movz(b, 2, 1, 0) in
    let cc =
      if op == "==" then 1
      else if op == "!=" then 0
      else if op == "<" then 10
      else if op == "<=" then 12
      else if op == ">" then 13
      else if op == ">=" then 11
      else 1 in
    let _ = a64_b_cond(b, cc, 2) in
    let _ = a64_mov_reg(b, 0, 2) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    [b, cur, labels, patches]
  else if k == "label" then
    [b, cur, cons([nth(insn, 1), bytes_len(b)], labels), patches]
  else if k == "jmp" then
    let pos = bytes_len(b) in
    let _ = a64_b(b, 0) in
    [b, cur, labels, cons(["b26", pos, nth(insn, 1)], patches)]
  else if k == "br" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_cmp_reg(b, 0, 31) in
    let peq = bytes_len(b) in
    let _ = a64_b_eq(b, 0) in
    let pne = bytes_len(b) in
    let _ = a64_b(b, 0) in
    [b, cur, labels,
     cons(["b26", pne, nth(insn, 2)],
          cons(["beq", peq, nth(insn, 3)], patches))]
  else if k == "call" then
    let args = nth(insn, 3) in
    let na = len(args) in
    let load(j) =
      if j >= na then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, nth(args, j), false, j) in
        load(j + 1) in
    let _ = load(0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, cons(["bl", pos, nth(insn, 2)], patches)]
  else if k == "ret" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    if is_entry then
      let _ = a64_ret(b) in [b, cur, labels, patches]
    else
      let _ = a64_mov_reg(b, 31, 29) in
      let _ = a64_ldp_fp_lr(b) in
      let _ = a64_ret(b) in
      [b, cur, labels, patches]
  else if k == "exit" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_movz(b, 8, 93, 0) in
    let _ = a64_svc(b) in
    [b, cur, labels, patches]
  else if k == "obj_kind" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, 16) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_ld" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, nth(insn, 3)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_st" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "tag" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "obj_sti" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_mov_imm64(b, 1, nth(insn, 3)) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "obj_st_int" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    [b, cur, labels, patches]
  else if k == "ld8" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    [b, cur, labels, patches]
  else if k == "st8" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_slot(b, nth(insn, 2), false, 2) in
    let _ = a64_asr1(b, 2, 2) in
    let _ = a64_add_reg(b, 0, 0, 2) in
    let _ = a64_strb(b, 1, 0) in
    [b, cur, labels, patches]
  else
    let _ = a64_brk(b) in
    [b, cur, labels, patches]

let a64_lookup(labels, name) =
  let n = len(labels) in
  let scan(i) =
    if i < 0 then 0
    else if nth(nth(labels, i), 0) == name then nth(nth(labels, i), 1)
    else scan(i - 1) in
  scan(n - 1)

let emit_program_arm64(prog, load_vaddr, text_off) =
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = bytes_len(nth(st, 0)) in
      let st0 = [nth(st, 0), 0, nth(st, 2), nth(st, 3)] in
      let insns = nth(f, 4) in
      let run(j, s) =
        if j >= len(insns) then s
        else run(j + 1, emit_insn_a64(s, nth(insns, j), is_entry)) in
      let s1 = run(0, st0) in
      emit_fun(i + 1, s1, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, [out, 0, [], []], []) in
  let st = nth(r1, 0) in
  let fo = nth(r1, 1) in
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let resolve(i) =
    if i < 0 then 0
    else
      let p = nth(patches, i) in
      let kind = nth(p, 0) in
      let pos = nth(p, 1) in
      let lab = nth(p, 2) in
      let targ = a64_lookup(labels, lab) in
      let targ2 =
        if targ == 0 then a64_lookup(fo, lab) else targ in
      let _ =
        if kind == "bl" then a64_apply_bl(b, pos, targ2)
        else if kind == "beq" then
          let rel = bshr(targ2 - pos, 2) in
          let w = 1409286144 + bshl(band(rel, 524287), 5) in
          let _ = bytes_put(b, pos, band(w, 255)) in
          let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
          let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
          bytes_put(b, pos + 3, band(bshr(w, 24), 255))
        else a64_apply_b26(b, pos, targ2) in
      resolve(i - 1) in
  let _ = resolve(len(patches) - 1) in
  [b, fo]
