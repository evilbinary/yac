/* fold.yac — compile-time evaluation of `import compiler` programs.
 *
 * When a source imports the `compiler` package its exported functions
 * (compile_file / compile / load) are HOST-ONLY: their implementation lives
 * in the running yc (back.backend / back.jit), never in the emitted guest.
 * So such a program is a *build script*: yc evaluates it here, at compile
 * time, and only the resulting integer becomes the guest's exit code.
 *
 *   compiler_fold(src) -> ["no"]            source does not import compiler
 *                       | ["ok", int]       build script evaluated; exit code
 *                       | ["err", message]  not foldable
 *
 * Evaluation is a small ANF interpreter over the restricted subset used by
 * build scripts: literals, let/letbin/letif/letcall, and calls to the
 * compiler host names + a few pure prims. Anything else is a clear error
 * instead of a miscompiled guest.
 */

package back.fold
export compiler_fold, fold_active, fold_import, fold_repl
import back.backend {pass_anf, pass_lex, pass_parse, ast_imports, compile_native}
import back.jit {compile_jit}
import back.pack.target {mk_jit_target, mk_target, target_live}
import rt.os {host_arch, host_format}

let fd_mem(name, xs) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(l, 0) == name then true
    else rec(drop(l, 1)) in
  rec(xs)

/* host names reachable from a build script / compiler-mode line */
let fd_host_names(_) =
  ["compile", "compile_file", "load", "print",
   "compile_native", "compile_jit", "target_live", "mk_jit_target",
   "mk_target", "host_arch", "host_format"]

let fd_is_host(nm) = fd_mem(nm, fd_host_names(0))

/* int from an int-literal text; plain decimal with optional +/- prefix. */
let fd_atoi(s) =
  let n = str_len(s) in
  let neg = if n > 0 then if str_ref(s, 0) == 45 then 1 else 0 else 0 in
  let i0 = if neg == 1 then 1 else 0 in
  let i1 = if i0 < n then if str_ref(s, i0) == 43 then i0 + 1 else i0 else i0 in
  let loop(i, acc) =
    if i >= n then acc
    else loop(i + 1, acc * 10 + (str_ref(s, i) - 48)) in
  let v = loop(i1, 0) in
  if neg == 1 then 0 - v else v

let fd_truthy(v) =
  if is_int(v) then v != 0 else true

/* equality over the values a build script compares (ints/strings/ptr) */
let fd_eq(a, b) =
  if is_int(a) then
    if is_int(b) then a == b else false
  else if is_int(b) then false
  else a == b

/* arithmetic/comparison on already-evaluated operands.
 * Returns ["v", int] or ["e", msg]. */
let fd_binop(op, a, b) =
  if op == "+" then ["v", a + b]
  else if op == "-" then ["v", a - b]
  else if op == "*" then ["v", a * b]
  else if op == "/" then
    if b == 0 then ["e", "compiler fold: divide by zero"] else ["v", a / b]
  else if op == "%" then
    if b == 0 then ["e", "compiler fold: modulo by zero"] else ["v", a % b]
  else if op == "==" then
    if fd_eq(a, b) then ["v", 1] else ["v", 0]
  else if op == "!=" then
    if fd_eq(a, b) then ["v", 0] else ["v", 1]
  else if op == "<" then
    if a < b then ["v", 1] else ["v", 0]
  else if op == "<=" then
    if a <= b then ["v", 1] else ["v", 0]
  else if op == ">" then
    if a > b then ["v", 1] else ["v", 0]
  else if op == ">=" then
    if a >= b then ["v", 1] else ["v", 0]
  else if op == "and" then
    if fd_truthy(a) then
      if fd_truthy(b) then ["v", 1] else ["v", 0]
    else ["v", 0]
  else if op == "or" then
    if fd_truthy(a) then ["v", 1]
    else if fd_truthy(b) then ["v", 1] else ["v", 0]
  else ["e", str_cat("compiler fold: bad binop '", str_cat(op, "'"))]

/* ---- host call wrappers (compiler package semantics) ---- */

let fd_host_target(_) = mk_target(host_arch(0), host_format(0), "exec")

let fd_compile_file(inp, outp, t, prof) =
  let t1 = if t == 0 then fd_host_target(0) else t in
  let bin = compile_native(read_file(inp), t1) in
  if bin == 0 then 1 else
    let _ = write_file(outp, bin) in
    0

let fd_compile(src, t) =
  if src == 0 then 0
  else if t != 0 then
    if target_live(t) then compile_jit(src, t, false)
    else compile_native(src, fd_host_target(0))
  else compile_native(src, fd_host_target(0))

let fd_load(path, t) =
  let src = read_file(path) in
  if src == 0 then 1
  else if t != 0 then
    if target_live(t) then compile_jit(src, t, true)
    else compile_jit(src, mk_jit_target(host_arch(0)), true)
  else compile_jit(src, mk_jit_target(host_arch(0)), true)

/* common prims a compiler-mode session may call (bytes/str/list introspect).
 * Returns 0 if name is not in the allowlist, else ["h", result]. */
let fd_call_prim(name, av) =
  let a0 = nth(av, 0) in
  let a1 = nth(av, 1) in
  let a2 = nth(av, 2) in
  if name == "bytes_new" then ["h", bytes_new()]
  else if name == "bytes_len" then ["h", bytes_len(a0)]
  else if name == "bytes_ref" then ["h", bytes_ref(a0, a1)]
  else if name == "bytes_append" then
    let _ = bytes_append(a0, a1) in
    ["h", a0]
  else if name == "str_len" then ["h", str_len(a0)]
  else if name == "str_ref" then ["h", str_ref(a0, a1)]
  else if name == "str_cat" then ["h", str_cat(a0, a1)]
  else if name == "str_slice" then ["h", str_slice(a0, a1, a2)]
  else if name == "int_to_str" then ["h", int_to_str(a0)]
  else if name == "len" then ["h", len(a0)]
  else if name == "nth" then ["h", nth(a0, a1)]
  else if name == "drop" then ["h", drop(a0, a1)]
  else if name == "cons" then ["h", cons(a0, a1)]
  else 0

/* av is the evaluated arg-value list; missing args become 0 (yac convention).
 * Returns 0 if name is not a known host call, else ["h", result]. */
let fd_host(name, av) =
  let a0 = nth(av, 0) in
  let a1 = nth(av, 1) in
  let a2 = nth(av, 2) in
  let a3 = nth(av, 3) in
  if name == "compile_file" then ["h", fd_compile_file(a0, a1, a2, a3)]
  else if name == "compile" then ["h", fd_compile(a0, a1)]
  else if name == "load" then ["h", fd_load(a0, a1)]
  else if name == "print" then
    if len(av) >= 2 then
      let _ = print(a0, a1) in
      ["h", 0]
    else
      let _ = print(a0) in
      ["h", 0]
  else if name == "compile_native" then ["h", compile_native(a0, a1)]
  else if name == "compile_jit" then ["h", compile_jit(a0, a1, a2)]
  else if name == "target_live" then ["h", target_live(a0)]
  else if name == "mk_jit_target" then ["h", mk_jit_target(a0)]
  else if name == "mk_target" then ["h", mk_target(a0, a1, a2)]
  else if name == "host_arch" then ["h", host_arch(a0)]
  else if name == "host_format" then ["h", host_format(a0)]
  else 0

/* try the compiler host API first, then the prim allowlist. 0 if unknown. */
let fd_dispatch(name, av) =
  let h = fd_host(name, av) in
  if h != 0 then h else fd_call_prim(name, av)

/* ---- the build-script interpreter (self-recursive core) ---- */

/* env lookup (top-level, shared by fold_body's nested fd_lookup callers too).
 * Returns the [name, value] entry or 0. */
let fd_env_lookup(e, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(l, 0)
    else rec(drop(l, 1)) in
  rec(e)

let fold_body(anf, env) =
  /* env: list of [name, value]. Returns [env', wrappedValue] or ["e", msg]. */
  let fd_lookup(e, name) =
    let rec(l) =
      if len(l) == 0 then 0
      else if nth(nth(l, 0), 0) == name then nth(l, 0)
      else rec(drop(l, 1)) in
    rec(e) in
  /* fold an atom to a raw value; returns ["v", v] / ["e", msg] */
  let fold_atom(atom, e) =
    let k = nth(atom, 0) in
    if k == "int" then ["v", fd_atoi(nth(atom, 1))]
    else if k == "str" then ["v", nth(atom, 1)]
    else if k == "bool" then
      if nth(atom, 1) == "true" then ["v", 1] else ["v", 0]
    else if k == "unit" then ["v", 0]
    else if k == "nil" then ["v", []]
    else if k == "var" then
      let ent = fd_lookup(e, nth(atom, 1)) in
      if ent == 0 then
        ["e", str_cat("compiler fold: unbound '", str_cat(nth(atom, 1), "'"))]
      else ["v", nth(ent, 1)]
    else if k == "list" then
      let items = nth(atom, 1) in
      let build(xs) =
        if len(xs) == 0 then ["v", []]
        else
          let hv = fold_atom(nth(xs, 0), e) in
          if nth(hv, 0) == "e" then hv
          else
            let tv = build(drop(xs, 1)) in
            if nth(tv, 0) == "e" then tv
            else ["v", cons(nth(hv, 1), nth(tv, 1))] in
      build(items)
    else ["e", "compiler fold: unsupported atom"] in
  let bindings = nth(anf, 0) in
  let tail = nth(anf, 1) in
  let nb = len(bindings) in
  /* step: process binding i with env e */
  let step(i, e) =
    if i >= nb then
      let tv = fold_atom(tail, e) in
      if nth(tv, 0) == "e" then ["e", nth(tv, 1)] else [e, ["v", nth(tv, 1)]]
    else
      let b = nth(bindings, i) in
      let bk = nth(b, 0) in
      if bk == "let" then
        let av = fold_atom(nth(b, 2), e) in
        if nth(av, 0) == "e" then ["e", nth(av, 1)]
        else step(i + 1, cons([nth(b, 1), nth(av, 1)], e))
      else if bk == "letbin" then
        let ar = fold_atom(nth(b, 3), e) in
        if nth(ar, 0) == "e" then ["e", nth(ar, 1)]
        else
          let br = fold_atom(nth(b, 4), e) in
          if nth(br, 0) == "e" then ["e", nth(br, 1)]
          else
            let op = nth(b, 2) in
            let bo = fd_binop(op, nth(ar, 1), nth(br, 1)) in
            if nth(bo, 0) == "e" then ["e", nth(bo, 1)]
            else step(i + 1, cons([nth(b, 1), nth(bo, 1)], e))
      else if bk == "letcall" then
        let fa = nth(b, 2) in
        if nth(fa, 0) == "var" then
          let nm = nth(fa, 1) in
          let args = nth(b, 3) in
          let nargs = len(args) in
          let evalargs(j, acc) =
            if j >= nargs then ["v", acc]
            else
              let rr = fold_atom(nth(args, j), e) in
              if nth(rr, 0) == "e" then rr
              else evalargs(j + 1, append(acc, [nth(rr, 1)])) in
          let ar = evalargs(0, []) in
          if nth(ar, 0) == "e" then ["e", nth(ar, 1)]
          else
            let hr = fd_dispatch(nm, nth(ar, 1)) in
            if hr == 0 then
              ["e", str_cat("compiler fold: cannot call '", str_cat(nm, "'"))]
            else step(i + 1, cons([nth(b, 1), nth(hr, 1)], e))
        else ["e", "compiler fold: call to computed function"]
      else if bk == "letif" then
        let cv = fold_atom(nth(b, 2), e) in
        if nth(cv, 0) == "e" then ["e", nth(cv, 1)]
        else
          let branch =
            if fd_truthy(nth(cv, 1)) then nth(b, 3) else nth(b, 4) in
          let bv = fold_body(branch, e) in
          if nth(bv, 0) == "e" then bv
          else step(i + 1, cons([nth(b, 1), nth(nth(bv, 1), 1)], e))
      else if bk == "letprint" then
        let pv = fold_atom(nth(b, 2), e) in
        if nth(pv, 0) == "e" then ["e", nth(pv, 1)]
        else
          let _ = print(nth(pv, 1)) in
          step(i + 1, cons([nth(b, 1), 0], e))
      else if bk == "letfun" then
        step(i + 1, cons([nth(b, 1), ["fun", nth(b, 2), nth(b, 3), e]], e))
      else ["e", "compiler fold: unsupported binding"] in
  step(0, env)

let compiler_fold(src) =
  let ast = pass_parse(pass_lex(src)) in
  let imps = ast_imports(ast, 0, []) in
  if not fd_mem("compiler", imps) then ["no"]
  else
    let items = pass_anf(ast) in
    let n = len(items) in
    let go(i, env, acc) =
      if i >= n then ["ok", acc]
      else
        let r = fold_body(nth(items, i), env) in
        if nth(r, 0) == "e" then ["err", nth(r, 1)]
        else if i + 1 >= n then
          let wv = nth(nth(r, 1), 1) in
          if is_int(wv) then ["ok", wv]
          else ["err", "compiler fold: program value is not an int"]
        else go(i + 1, nth(r, 0), 0) in
    go(0, [], 0)

/* ---- interactive (REPL) compiler session ----
 * A `import compiler` line switches the REPL into compiler mode: later lines
 * are evaluated here by the host interpreter (env persists across lines), so
 * compile/compile_file/load stay host-only and never enter guest code. */

let fold_mode_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let fold_env_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let fold_active(_) = box_get(fold_mode_box)

/* first import that is not the compiler package (or "" if none) */
let fd_other_import(imps, i) =
  if i >= len(imps) then ""
  else
    let p = nth(imps, i) in
    if p == "compiler" then fd_other_import(imps, i + 1)
    else p

/* If `src` imports compiler, turn the session on; returns 1 when on. */
let fold_import(src) =
  let ast = pass_parse(pass_lex(src)) in
  let imps = ast_imports(ast, 0, []) in
  let _ = if fd_mem("compiler", imps) then box_set(fold_mode_box, 1) else 0 in
  box_get(fold_mode_box)

/* Evaluate one REPL line in compiler mode with the persistent session env.
 * Echoes the line's value like the normal REPL: a bare int expression prints
 * the int; a top-level `let` prints "name = <int>" when the bound value is an
 * int (compiled bytes etc. are bound silently). Returns 0. */
let fold_repl(src) =
  if box_get(fold_mode_box) == 0 then 1
  else
    let ast = pass_parse(pass_lex(src)) in
    let other = fd_other_import(ast_imports(ast, 0, []), 0) in
    let _ =
      if other == "" then 0
      else
        print(str_cat("compiler fold: import '",
          str_cat(other,
            "' is not available in compiler mode (host API only)"))) in
    let items = pass_anf(ast) in
    let n = len(items) in
    if n == 0 then 0
    else
      let np = len(ast) in
      let lastp = nth(ast, np - 1) in
      let lastk = if np == 0 then "" else nth(lastp, 0) in
      let is_bind = lastk == "let" in
      let is_print_call =
        if lastk != "call" then false
        else
          let cal = nth(lastp, 1) in
          if nth(cal, 0) != "var" then false
          else
            let cnm = nth(cal, 1) in
            if cnm == "print" then true else cnm == "printf" in
      let is_quiet = lastk == "print" or is_print_call in
      let env0 = box_get(fold_env_box) in
      /* returns ["ok", env, lastVal] or ["err", msg] */
      let go(i, env, cur) =
        if i >= n then ["ok", env, cur]
        else
          let r = fold_body(nth(items, i), env) in
          if nth(r, 0) == "e" then ["err", nth(r, 1)]
          else go(i + 1, nth(r, 0), ["v", nth(nth(r, 1), 1)]) in
      let r0 = go(0, env0, ["v", 0]) in
      if nth(r0, 0) == "err" then
        let _ = print(nth(r0, 1)) in
        0
      else
        let _ = box_set(fold_env_box, nth(r0, 1)) in
        if is_quiet then 0
        else if is_bind then
          let nm = nth(lastp, 1) in
          let ent = fd_env_lookup(nth(r0, 1), nm) in
          let _ =
            if ent == 0 then 0
            else
              let v = nth(ent, 1) in
              if is_int(v) then
                let _ = print(str_cat(str_cat(nm, " = "), int_to_str(v))) in
                0
              else
                let _ = print(str_cat(nm, " = "), false) in
                let _ = print(v) in
                0 in
          0
        else
          let wv = nth(nth(r0, 2), 1) in
          let _ = print(wv) in
          0
