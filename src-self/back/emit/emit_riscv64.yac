/* emit_riscv64.yac — Linux RV64 emit of integer LIR. Other ops: unimp. */

package back.emit.emit_riscv64
export emit_program_riscv64, rv_resolve_loop
import back.encode.encode_riscv64
import lib.log {log_fatal}
import back.emit.emit {apply_args, apply_u64, asm_dump_cells, asm_dump_get, asm_dump_procs, asm_dump_set, cimport_buf, cimport_reset, clos_bytes, emit_abi_win_set, emit_cplt_rv, emit_fmt_set, emit_glob_data, emit_ids_new, emit_map_get, emit_patch_cimport, emit_patch_clos, emit_patch_jmpf, emit_patch_rel, emit_patch_strlit, emit_self, emit_self_set, emit_st4, emit_tco_get, emit_tco_set, emit_unres_set, gref_alloc, gref_base, host_id, host_slot_bake, host_unstub_procs, is_arith, is_frame_op, is_raw_op, label_put, patches_extend, strlit_bytes, strlit_off, strlit_pool_reset, tcall_raw_of, tcall_tab_set, prof_hook_fix, tco_lab, yjit_layout_set}
import back.emit.emit_cabi {dlib_rv_va, emit_cabi_all}
import back.pack.elf {elf_pic, funsym_set}
import back.pack.target {JIT_VADDR}
import lib.map {intern}
import rt.os {host_os}

let rv_frame_bytes(nlocals) =
  let nbytes = bshl(nlocals + 1, 3) in
  bshl(bshr(nbytes + 15, 4), 4)

/* Unified operand access (LIR.md 4.4.2). Loads can be:
 *   ["cap", i]  -> the i-th free variable, [self + 32 + i*8]  (capRef)
 *   ["self"]    -> the closure object itself
 *   ["imm", n]  -> an encoded constant
 *   bare int k  -> frame slot k, [fp - 8*(k+1)]
 * nth() on a bare int is a safe non-string read, so the dispatch is total.
 * self lives in s11 (x27) -- callee-saved and used by nothing else here; an
 * object-ABI prologue parks the CALLER's copy in frame slot 0 (never allocated
 * by the front) so a capRef body can read its caps after any nested call. */
let rv_slot(b, slot, store, r) =
  if store then
    let off = 0 - bshl(slot + 1, 3) in
    let _ = rv_addi(b, 5, 8, off) in
    rv_sd(b, r, 5, 0)
  else
    let k0 = nth(slot, 0) in
    if k0 == "cap" then rv_ld(b, r, 27, 32 + bshl(nth(slot, 1), 3))
    else if k0 == "self" then rv_addi(b, r, 27, 0)
    else if k0 == "imm" then rv_li(b, r, nth(slot, 1))
    else
      let off = 0 - bshl(slot + 1, 3) in
      let _ = rv_addi(b, 5, 8, off) in
      rv_ld(b, r, 5, 0)

let rv_sp_push(b, rs) =
  let _ = rv_addi(b, 2, 2, 0 - 8) in
  rv_sd(b, rs, 2, 0)

/* Extra apply args go on the stack in reverse. `nreg` is how many leading
 * registers this convention already filled: flat calls (fcall/tcall) use
 * a0-a7, ycall leaves a0 as the object slot and starts at a1. */
let rv_apply_push(b, nreg, ncap, args, i) =
  if i < nreg then 0
  else
    let _ =
      if i < ncap then rv_ld(b, 6, 28, 32 + bshl(i, 3))
      else rv_slot(b, nth(args, i - ncap), false, 6) in
    let _ = rv_sp_push(b, 6) in
    rv_apply_push(b, nreg, ncap, args, i - 1)

let rv_apply_load(b, ncap, args, i, nreg) =
  if i >= nreg then 0
  else if i < ncap then
    let _ = rv_ld(b, 10 + i, 28, 32 + bshl(i, 3)) in
    rv_apply_load(b, ncap, args, i + 1, nreg)
  else
    let _ = rv_slot(b, nth(args, i - ncap), false, 10 + i) in
    rv_apply_load(b, ncap, args, i + 1, nreg)

let rv_tag(b, rd) =
  let _ = rv_addi(b, 29, 0, 1) in
  rv_or(b, rd, rd, 29)

let rv_untag_ptr(b, rd) =
  let _ = rv_addi(b, 29, 0, 0 - 2) in
  rv_and(b, rd, rd, 29)

let rv_apply_jal(b, pos, target, rd) =
  let imm = target - pos in
  let i = band(imm, 2097151) in
  let b20 = band(bshr(i, 20), 1) in
  let b10_1 = band(bshr(i, 1), 1023) in
  let b11 = band(bshr(i, 11), 1) in
  let b19_12 = band(bshr(i, 12), 255) in
  let w = bshl(b20, 31) + bshl(b10_1, 21) + bshl(b11, 20) + bshl(b19_12, 12) +
          bshl(rd, 7) + 111 in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

/* yac_alloc is rt_alloc_ins ($proc / $local). */


let rv_enter(b, n) =
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 1, 2, 8) in
  let _ = rv_sd(b, 8, 2, 0) in
  let _ = rv_addi(b, 8, 2, 0) in
  rv_addi(b, 2, 2, 0 - n)

let rv_leave(b) =
  let _ = rv_addi(b, 2, 8, 0) in
  let _ = rv_ld(b, 1, 2, 8) in
  let _ = rv_ld(b, 8, 2, 0) in
  let _ = rv_addi(b, 2, 2, 16) in
  rv_jalr(b, 0, 1, 0)

let rv_clamp0(b) =
  let p = bytes_len(b) in
  let _ = rv_bge(b, 10, 0, 0) in
  let _ = rv_addi(b, 10, 0, 0) in
  rv_patch_b(b, p, bytes_len(b))

/* yac_read_file is rt_read_file_ins ($proc / $local). */



/* yac_apply1 / yac_apply2 are rt_apply*_ins ($proc / $local). */


/* yac_system is rt_system_ins ($proc / $local). */


/* yac_argv is rt_argv_ins ($proc / $local). */


let rv_jal_rt(b, patches, dst, name, ids) =
  let pos = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_slot(b, dst, true, 10) in
  emit_patch_rel(ids, patches, pos, name)

/* x6,x28 untagged; x7=1; tagged result in x6. */
let rv_cmp_int(b, op) =
  let _ =
    if op == "==" then
      let _ = rv_xor(b, 6, 6, 28) in
      rv_sltiu(b, 6, 6, 1)
    else if op == "!=" then
      let _ = rv_xor(b, 6, 6, 28) in
      let _ = rv_sltiu(b, 6, 6, 1) in
      rv_xor(b, 6, 6, 7)
    else if op == "<" then rv_slt(b, 6, 6, 28)
    else if op == "<=" then
      let _ = rv_slt(b, 6, 28, 6) in
      rv_sltiu(b, 6, 6, 1)
    else if op == ">" then rv_slt(b, 6, 28, 6)
    else if op == ">=" then
      let _ = rv_slt(b, 6, 6, 28) in
      rv_sltiu(b, 6, 6, 1)
    else
      let _ = rv_xor(b, 6, 6, 28) in
      rv_sltiu(b, 6, 6, 1) in
  rv_sll(b, 6, 6, 7)

let rv_cmp_maybe_str(b, op, patches, ids) =
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 10, 2, 0) in
  let _ = rv_sd(b, 11, 2, 8) in
  let _ = rv_addi(b, 7, 0, 1) in
  let jnil1 = bytes_len(b) in
  let _ = rv_beq(b, 10, 7, 0) in
  let _ = rv_and(b, 5, 10, 7) in
  let jz1 = bytes_len(b) in
  let _ = rv_beq(b, 5, 0, 0) in
  let jnil2 = bytes_len(b) in
  let _ = rv_beq(b, 11, 7, 0) in
  let _ = rv_and(b, 5, 11, 7) in
  let jz2 = bytes_len(b) in
  let _ = rv_beq(b, 5, 0, 0) in
  let _ = rv_ld(b, 10, 2, 0) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_ld(b, 5, 10, 16) in
  let _ = rv_addi(b, 6, 0, 3) in
  let jne1 = bytes_len(b) in
  let _ = rv_bne(b, 5, 6, 0) in
  let _ = rv_ld(b, 10, 2, 8) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_ld(b, 5, 10, 16) in
  let jne2 = bytes_len(b) in
  let _ = rv_bne(b, 5, 6, 0) in
  let _ = rv_ld(b, 10, 2, 0) in
  let _ = rv_ld(b, 11, 2, 8) in
  let scall = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_addi(b, 2, 2, 16) in
  let _ =
    if op == "!=" then
      let _ = rv_addi(b, 7, 0, 1) in
      let _ = rv_sra(b, 6, 10, 7) in
      let _ = rv_xor(b, 6, 6, 7) in
      rv_sll(b, 6, 6, 7)
    else rv_addi(b, 6, 10, 0) in
  let jdone = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let intp = bytes_len(b) in
  let _ = rv_patch_b(b, jnil1, intp) in
  let _ = rv_patch_b(b, jz1, intp) in
  let _ = rv_patch_b(b, jnil2, intp) in
  let _ = rv_patch_b(b, jz2, intp) in
  let _ = rv_patch_b(b, jne1, intp) in
  let _ = rv_patch_b(b, jne2, intp) in
  let _ = rv_ld(b, 6, 2, 0) in
  let _ = rv_ld(b, 28, 2, 8) in
  let _ = rv_addi(b, 2, 2, 16) in
  let _ = rv_addi(b, 7, 0, 1) in
  let _ = rv_sra(b, 6, 6, 7) in
  let _ = rv_sra(b, 28, 28, 7) in
  let _ = rv_cmp_int(b, op) in
  let _ = rv_apply_jal(b, jdone, bytes_len(b), 0) in
  emit_patch_rel(ids, patches, scall, "yac_str_eq")

let rv_f64_opn(op) =
  if op == "<" then 0
  else if op == ">" then 1
  else if op == "<=" then 2
  else if op == ">=" then 3
  else if op == "==" then 4
  else 5

let rv_skip_unless_f64(b, src) =
  let _ = rv_andi(b, 6, src, 1) in
  let j0 = bytes_len(b) in
  let _ = rv_beq(b, 6, 0, 0) in
  let _ = rv_addi(b, 6, 0, 1) in
  let j1 = bytes_len(b) in
  let _ = rv_beq(b, src, 6, 0) in
  let _ = rv_addi(b, 6, src, 0) in
  let _ = rv_untag_ptr(b, 6) in
  let _ = rv_ld(b, 7, 6, 16) in
  let _ = rv_addi(b, 6, 0, 7) in
  let j2 = bytes_len(b) in
  let _ = rv_bne(b, 7, 6, 0) in
  [j0, j1, j2]

let rv_patch3(b, js, t) =
  let _ = rv_patch_b(b, nth(js, 0), t) in
  let _ = rv_patch_b(b, nth(js, 1), t) in
  rv_patch_b(b, nth(js, 2), t)

let emit_rv_blc(b, patches, name) =
  let pos = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  emit_patch_cimport(patches, pos, name)

let emit_rv_f64_blc(b, patches, name) =
  let _ = rv_addi(b, 9, 2, 0) in
  let _ = rv_andi(b, 2, 2, 0 - 16) in
  let ps = emit_rv_blc(b, patches, name) in
  let _ = rv_addi(b, 2, 9, 0) in
  ps

let emit_rv_f64_strtod(b, patches) =
  let _ = rv_addi(b, 11, 0, 0) in
  let ps = emit_rv_f64_blc(b, patches, "strtod") in
  let _ = rv_fmv_x_d(b, 10, 10) in
  ps

let emit_rv_f64_unbox(b, patches) =
  let _ = rv_andi(b, 6, 10, 1) in
  let j_int = bytes_len(b) in
  let _ = rv_beq(b, 6, 0, 0) in
  let _ = rv_addi(b, 6, 0, 1) in
  let j_nil = bytes_len(b) in
  let _ = rv_beq(b, 10, 6, 0) in
  let _ = rv_untag_ptr(b, 10) in
  let j_z = bytes_len(b) in
  let _ = rv_beq(b, 10, 0, 0) in
  let _ = rv_ld(b, 7, 10, 16) in
  let _ = rv_addi(b, 6, 0, 7) in
  let j_nf = bytes_len(b) in
  let _ = rv_bne(b, 7, 6, 0) in
  let _ = rv_ld(b, 10, 10, 24) in
  let j_d1 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let nf = bytes_len(b) in
  let _ = rv_patch_b(b, j_nf, nf) in
  let _ = rv_addi(b, 6, 0, 3) in
  let j_ns = bytes_len(b) in
  let _ = rv_bne(b, 7, 6, 0) in
  let _ = rv_addi(b, 10, 10, 32) in
  let ps = emit_rv_f64_strtod(b, patches) in
  let j_d2 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let isint = bytes_len(b) in
  let _ = rv_patch_b(b, j_int, isint) in
  let _ = rv_srai(b, 10, 10, 1) in
  let _ = rv_fcvt_d_l(b, 10, 10) in
  let _ = rv_fmv_x_d(b, 10, 10) in
  let j_d3 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let zero = bytes_len(b) in
  let _ = rv_patch_b(b, j_ns, zero) in
  let _ = rv_patch_b(b, j_nil, zero) in
  let _ = rv_patch_b(b, j_z, zero) in
  let _ = rv_addi(b, 10, 0, 0) in
  let done = bytes_len(b) in
  let _ = rv_apply_jal(b, j_d1, done, 0) in
  let _ = rv_apply_jal(b, j_d2, done, 0) in
  let _ = rv_apply_jal(b, j_d3, done, 0) in
  ps

let emit_rv_f64_box(b, patches, ids) =
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 10, 2, 0) in
  let _ = rv_li(b, 10, 48) in
  let acall = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_addi(b, 6, 0, 7) in
  let _ = rv_sd(b, 6, 10, 16) in
  let _ = rv_ld(b, 6, 2, 0) in
  let _ = rv_sd(b, 6, 10, 24) in
  let _ = rv_addi(b, 2, 2, 16) in
  let _ = rv_tag(b, 10) in
  emit_patch_rel(ids, patches, acall, "yac_alloc")

let emit_rv_f64_fmt(b) =
  let j = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let fmt = bytes_len(b) in
  let _ = bytes_append(b, 37) in
  let _ = bytes_append(b, 103) in
  let _ = bytes_append(b, 0) in
  let rec(p) =
    if band(bytes_len(b), 3) == 0 then 0
    else
      let _ = bytes_append(b, 0) in
      rec(0) in
  let _ = rec(0) in
  let _ = rv_apply_jal(b, j, bytes_len(b), 0) in
  fmt

let emit_rv_f64_rel_set(b, opn) =
  if opn == 0 then rv_flt_d(b, 10, 10, 11)
  else if opn == 1 then rv_flt_d(b, 10, 11, 10)
  else if opn == 2 then rv_fle_d(b, 10, 10, 11)
  else if opn == 3 then rv_fle_d(b, 10, 11, 10)
  else if opn == 4 then rv_feq_d(b, 10, 10, 11)
  else
    let _ = rv_feq_d(b, 10, 10, 11) in
    rv_xori(b, 10, 10, 1)

let emit_rv_i_f64(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let ids = nth(st, 4) in
  let k = nth(insn, 0) in
  if k == "$f64fromstr" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let ps = emit_rv_f64_unbox(b, patches) in
    let ps2 = emit_rv_f64_box(b, ps, ids) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, ps2)
  else if k == "$f64binop" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let ps = emit_rv_f64_unbox(b, patches) in
    let _ = rv_addi(b, 2, 2, 0 - 16) in
    let _ = rv_sd(b, 10, 2, 0) in
    let _ = rv_slot(b, nth(insn, 3), false, 10) in
    let ps2 = emit_rv_f64_unbox(b, ps) in
    let _ = rv_fmv_d_x(b, 11, 10) in
    let _ = rv_ld(b, 10, 2, 0) in
    let _ = rv_addi(b, 2, 2, 16) in
    let _ = rv_fmv_d_x(b, 10, 10) in
    let _ = rv_slot(b, nth(insn, 4), false, 12) in
    let _ = rv_srai(b, 12, 12, 1) in
    let _ = rv_addi(b, 6, 0, 0) in
    let ja = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 1) in
    let js = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 2) in
    let jm = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_fdiv_d(b, 10, 10, 11) in
    let jd = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let pa = bytes_len(b) in
    let _ = rv_patch_b(b, ja, pa) in
    let _ = rv_fadd_d(b, 10, 10, 11) in
    let jd2 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let psu = bytes_len(b) in
    let _ = rv_patch_b(b, js, psu) in
    let _ = rv_fsub_d(b, 10, 10, 11) in
    let jd3 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let pm = bytes_len(b) in
    let _ = rv_patch_b(b, jm, pm) in
    let _ = rv_fmul_d(b, 10, 10, 11) in
    let join = bytes_len(b) in
    let _ = rv_apply_jal(b, jd, join, 0) in
    let _ = rv_apply_jal(b, jd2, join, 0) in
    let _ = rv_apply_jal(b, jd3, join, 0) in
    let _ = rv_fmv_x_d(b, 10, 10) in
    let ps3 = emit_rv_f64_box(b, ps2, ids) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, ps3)
  else if k == "$f64rel" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let ps = emit_rv_f64_unbox(b, patches) in
    let _ = rv_addi(b, 2, 2, 0 - 16) in
    let _ = rv_sd(b, 10, 2, 0) in
    let _ = rv_slot(b, nth(insn, 3), false, 10) in
    let ps2 = emit_rv_f64_unbox(b, ps) in
    let _ = rv_fmv_d_x(b, 11, 10) in
    let _ = rv_ld(b, 10, 2, 0) in
    let _ = rv_addi(b, 2, 2, 16) in
    let _ = rv_fmv_d_x(b, 10, 10) in
    let _ = rv_slot(b, nth(insn, 4), false, 12) in
    let _ = rv_srai(b, 12, 12, 1) in
    let _ = rv_addi(b, 6, 0, 0) in
    let c0 = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 1) in
    let c1 = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 2) in
    let c2 = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 3) in
    let c3 = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = rv_addi(b, 6, 0, 4) in
    let c4 = bytes_len(b) in
    let _ = rv_beq(b, 12, 6, 0) in
    let _ = emit_rv_f64_rel_set(b, 5) in
    let je = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let p0 = bytes_len(b) in
    let _ = rv_patch_b(b, c0, p0) in
    let _ = emit_rv_f64_rel_set(b, 0) in
    let je1 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let p1 = bytes_len(b) in
    let _ = rv_patch_b(b, c1, p1) in
    let _ = emit_rv_f64_rel_set(b, 1) in
    let je2 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let p2 = bytes_len(b) in
    let _ = rv_patch_b(b, c2, p2) in
    let _ = emit_rv_f64_rel_set(b, 2) in
    let je3 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let p3 = bytes_len(b) in
    let _ = rv_patch_b(b, c3, p3) in
    let _ = emit_rv_f64_rel_set(b, 3) in
    let je4 = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let p4 = bytes_len(b) in
    let _ = rv_patch_b(b, c4, p4) in
    let _ = emit_rv_f64_rel_set(b, 4) in
    let join = bytes_len(b) in
    let _ = rv_apply_jal(b, je, join, 0) in
    let _ = rv_apply_jal(b, je1, join, 0) in
    let _ = rv_apply_jal(b, je2, join, 0) in
    let _ = rv_apply_jal(b, je3, join, 0) in
    let _ = rv_apply_jal(b, je4, join, 0) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sll(b, 10, 10, 7) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, ps2)
  else
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let ps0 = emit_rv_f64_unbox(b, patches) in
    let _ = rv_addi(b, 12, 10, 0) in
    let fmt = emit_rv_f64_fmt(b) in
    let _ = rv_addi(b, 9, 2, 0) in
    let _ = rv_andi(b, 2, 2, 0 - 16) in
    let _ = rv_addi(b, 2, 2, 0 - 80) in
    let _ = rv_addi(b, 18, 2, 0) in
    let _ = rv_addi(b, 10, 18, 0) in
    let apos = bytes_len(b) in
    let _ = rv_auipc(b, 11, 0) in
    let _ = rv_addi(b, 11, 11, fmt - apos) in
    let ps1 = emit_rv_blc(b, ps0, "sprintf") in
    let _ = rv_addi(b, 12, 10, 0) in
    let _ = rv_addi(b, 11, 18, 0) in
    let _ = rv_addi(b, 10, 0, 1) in
    let _ = rv_addi(b, 17, 0, 64) in
    let _ = rv_ecall(b) in
    let _ = rv_addi(b, 2, 9, 0) in
    let _ = rv_addi(b, 10, 0, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, ps1)

let rv_cmp_val(b, op, patches, ids) =
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 10, 2, 0) in
  let _ = rv_sd(b, 11, 2, 8) in
  let js0 = rv_skip_unless_f64(b, 10) in
  let js1 = rv_skip_unless_f64(b, 11) in
  let _ = rv_ld(b, 10, 2, 0) in
  let _ = rv_ld(b, 11, 2, 8) in
  let _ = rv_addi(b, 2, 2, 16) in
  let opn = rv_f64_opn(op) in
  let _ = rv_addi(b, 12, 0, opn + opn) in
  let fcall = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_addi(b, 6, 10, 0) in
  let jd = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let other = bytes_len(b) in
  let _ = rv_patch3(b, js0, other) in
  let _ = rv_patch3(b, js1, other) in
  let _ = rv_ld(b, 10, 2, 0) in
  let _ = rv_ld(b, 11, 2, 8) in
  let _ = rv_addi(b, 2, 2, 16) in
  let ps =
    if op == "==" or op == "!=" then rv_cmp_maybe_str(b, op, patches, ids)
    else
      let _ = rv_addi(b, 7, 0, 1) in
      let _ = rv_sra(b, 6, 10, 7) in
      let _ = rv_sra(b, 28, 11, 7) in
      let _ = rv_cmp_int(b, op) in
      patches in
  let done = bytes_len(b) in
  let _ = rv_apply_jal(b, jd, done, 0) in
  emit_patch_rel(ids, ps, fcall, "yac_f64_rel")

/* Untag C arg in rd (not t1). Int → srai 1; heap ptr → +32. */
let emit_rv_c_untag(b, rd) =
  let _ = rv_andi(b, 6, rd, 1) in
  let jz = bytes_len(b) in
  let _ = rv_beq(b, 6, 0, 0) in
  let _ = rv_untag_ptr(b, rd) in
  let _ = rv_addi(b, rd, rd, 32) in
  let jd = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let intp = bytes_len(b) in
  let _ = rv_patch_b(b, jz, intp) in
  let _ = rv_srai(b, rd, rd, 1) in
  rv_apply_jal(b, jd, bytes_len(b), 0)

let emit_rv_c_align(b) =
  let _ = rv_addi(b, 9, 2, 0) in
  rv_andi(b, 2, 2, 0 - 16)

let emit_rv_c_unalign(b) = rv_addi(b, 2, 9, 0)

/* ccall: untag in t2 (x7); a0–a7 then 16-aligned stack. rv_slot uses t0. */
let emit_rv_c_arg(b, args, j, na) =
  if j >= na then 0
  else if j >= 8 then 0
  else
    let _ = rv_slot(b, nth(args, j), false, 7) in
    let _ = emit_rv_c_untag(b, 7) in
    let _ = rv_addi(b, 10 + j, 7, 0) in
    emit_rv_c_arg(b, args, j + 1, na)

let emit_rv_c_stkarg(b, args, j, na) =
  if j >= na then 0
  else
    let _ = rv_slot(b, nth(args, j), false, 7) in
    let _ = emit_rv_c_untag(b, 7) in
    let _ = rv_sd(b, 7, 2, bshl(j - 8, 3)) in
    emit_rv_c_stkarg(b, args, j + 1, na)

let emit_rv_c_marshal(b, args) =
  let na = len(args) in
  let nstack = if na > 8 then na - 8 else 0 in
  let asz = bshl(bshr(bshl(nstack, 3) + 15, 4), 4) in
  let _ = emit_rv_c_arg(b, args, 0, na) in
  let _ = emit_rv_c_align(b) in
  if nstack == 0 then 0
  else
    let _ = rv_addi(b, 2, 2, 0 - asz) in
    emit_rv_c_stkarg(b, args, 8, na)

let emit_rv_fcall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let na = len(args) in
  let nstack = if na > 8 then na - 8 else 0 in
  let nreg = if na < 8 then na else 8 in
  let pad = if nstack == 0 then 0 else if band(nstack, 1) == 0 then 0 else 8 in
  let _ = if pad == 0 then 0 else rv_addi(b, 2, 2, 0 - 8) in
  let _ = if nstack == 0 then 0 else rv_apply_push(b, 8, 0, args, na - 1) in
  let load(j) =
    if j >= nreg then 0
    else
      let _ = rv_slot(b, nth(args, j), false, 10 + j) in
      load(j + 1) in
  let _ = load(0) in
  /* Host leaf (@name): call through G+136+8*id. Materialised after the
   * arguments (which use t6 internally), addressed into t1/x6, entry in the
   * same register, then jalr. The slot holds the leaf's proc or its per-leaf
   * unimpl stub; a named jal could not be patched at all. */
  let hid = host_id(intern(nth(insn, 2)), 0) in
  let hpos = if hid < 0 then 0 - 1 else bytes_len(b) in
  let _ =
    if hid < 0 then 0
    else
      let _ = rv_li32_pair(b, 6, 0) in
      rv_ld(b, 6, 6, 0) in
  let pos = bytes_len(b) in
  let _ = if hid < 0 then rv_jal(b, 1, 0) else rv_jalr(b, 1, 6, 0) in
  let _ =
    if nstack == 0 then 0
    else rv_addi(b, 2, 2, bshl(nstack, 3) + pad) in
  let _ = rv_slot(b, nth(insn, 1), true, 10) in
  if hid < 0 then
    emit_st4(st, b, nth(st, 1), nth(st, 2),
      emit_patch_rel(nth(st, 4), nth(st, 3), pos, nth(insn, 2)))
  else
    emit_st4(st, b, nth(st, 1), nth(st, 2),
      cons([12, hpos, 136 + bshl(hid, 3)], nth(st, 3)))

/* Direct call to an in-image yac proc (object ABI, LIR.md 4.4.4): the object
 * register a0 is left unset and the real params start at a1 (registers 11..),
 * the rest on the stack -- matching this backend's prologue (which reads param
 * slot j+1 from a(j+1) for a marked frame) and see rv_apply_push for why the
 * stacked args start one slot lower than a flat call's. */
let emit_rv_ycall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let na = len(args) in
  let nstack = if na > 7 then na - 7 else 0 in
  let nreg = if na < 7 then na else 7 in
  let pad = if nstack == 0 then 0 else if band(nstack, 1) == 0 then 0 else 8 in
  let _ = if pad == 0 then 0 else rv_addi(b, 2, 2, 0 - 8) in
  let _ = if nstack == 0 then 0 else rv_apply_push(b, 7, 0, args, na - 1) in
  let load(j) =
    if j >= nreg then 0
    else
      let _ = rv_slot(b, nth(args, j), false, 11 + j) in
      load(j + 1) in
  let _ = load(0) in
  let pos = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ =
    if nstack == 0 then 0
    else rv_addi(b, 2, 2, bshl(nstack, 3) + pad) in
  let _ = rv_slot(b, nth(insn, 1), true, 10) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    emit_patch_rel(nth(st, 4), nth(st, 3), pos, nth(insn, 2)))

let emit_rv_ccall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let _ = emit_rv_c_marshal(b, args) in
  let pos = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = emit_rv_c_unalign(b) in
  let _ = rv_addi(b, 7, 0, 1) in
  let _ = rv_sll(b, 10, 10, 7) in
  let _ = rv_slot(b, nth(insn, 1), true, 10) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    emit_patch_cimport(nth(st, 3), pos, nth(insn, 2)))

let emit_rv_iccall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let _ = rv_slot(b, nth(insn, 2), false, 10) in
  let _ = emit_rv_c_untag(b, 10) in
  let _ = rv_addi(b, 28, 10, 0) in
  let _ = emit_rv_c_marshal(b, args) in
  let _ = rv_jalr(b, 1, 28, 0) in
  let _ = emit_rv_c_unalign(b) in
  let _ = rv_addi(b, 7, 0, 1) in
  let _ = rv_sll(b, 10, 10, 7) in
  let _ = rv_slot(b, nth(insn, 1), true, 10) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

/* The target's frame ABI comes from emit.yac's tcall_raw_of (the target's own
 * first local insn), not from the yac_ name prefix: the prefix is only a
 * convention, and a marked frame using it would be marshalled as unmarked.
 * tcall_raw_of keeps the prefix as the fallback for names not in this image. */
let emit_rv_tcall_other(st, insn, is_entry) =
  let b = nth(st, 0) in
  let fn = nth(insn, 2) in
  let args = nth(insn, 3) in
  let na = len(args) in
  let traw = tcall_raw_of(fn) in
  let nreg = if traw then 8 else 7 in
  let areg(j) = if traw then j else j + 1 in
  if na > nreg then
    let nstack = na - nreg in
    let pad = if band(nstack, 1) == 0 then 0 else 8 in
    let _ = if pad == 0 then 0 else rv_addi(b, 2, 2, 0 - 8) in
    let _ = rv_apply_push(b, nreg, 0, args, na - 1) in
    let load(j) =
      if j >= nreg then 0
      else
        let _ = rv_slot(b, nth(args, j), false, 10 + areg(j)) in
        load(j + 1) in
    let _ = load(0) in
    let _ = if traw then 0 else rv_addi(b, 10, 27, 0) in
    let _ = if is_entry then 0 else rv_slot(b, 0, false, 27) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_addi(b, 2, 2, bshl(nstack, 3) + pad) in
    let _ =
      if is_entry then rv_jalr(b, 0, 1, 0)
      else
        let _ = rv_addi(b, 2, 8, 0) in
        let _ = rv_ld(b, 1, 2, 8) in
        let _ = rv_ld(b, 8, 2, 0) in
        let _ = rv_addi(b, 2, 2, 16) in
        rv_jalr(b, 0, 1, 0) in
    emit_st4(st, b, nth(st, 1), nth(st, 2),
      emit_patch_rel(nth(st, 4), nth(st, 3), pos, fn))
  else
    let load(j) =
      if j >= na then 0
      else
        let _ = rv_slot(b, nth(args, j), false, 10 + areg(j)) in
        load(j + 1) in
    let _ = load(0) in
    let _ = if traw then 0 else rv_addi(b, 10, 27, 0) in
    let _ =
      if is_entry then 0
      else
        let _ = rv_slot(b, 0, false, 27) in
        let _ = rv_addi(b, 2, 8, 0) in
        let _ = rv_ld(b, 1, 2, 8) in
        let _ = rv_ld(b, 8, 2, 0) in
        rv_addi(b, 2, 2, 16) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    emit_st4(st, b, nth(st, 1), nth(st, 2),
      emit_patch_jmpf(nth(st, 4), nth(st, 3), pos, fn))

let emit_rv_tloop(st, args) =
  let b = nth(st, 0) in
  let nargs = len(args) in
  let pushj(j) =
    if j >= nargs then 0
    else
      let _ = rv_slot(b, nth(args, j), false, 10) in
      let _ = rv_sp_push(b, 10) in
      pushj(j + 1) in
  let popj(j) =
    if j < 0 then 0
    else
      let _ = rv_ld(b, 10, 2, 0) in
      let _ = rv_addi(b, 2, 2, 8) in
      let _ = rv_slot(b, j + 1, true, 10) in
      popj(j - 1) in
  let _ = pushj(0) in
  let _ = popj(nargs - 1) in
  let tco = emit_tco_get(0) in
  let pos = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let _ = if tco == 0 then 0 else rv_apply_jal(b, pos, tco, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

let emit_rv_i_core(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "local" or k == "$local" then
    let nlocals = nth(insn, 1) in
    let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
    let nbytes = rv_frame_bytes(nlocals) in
    let patches2 =
      if is_entry then
        let _ = rv_ld(b, 28, 2, 0) in
        let ac_save = bytes_len(b) in
        let _ = rv_li32_pair(b, 6, 0) in
        let _ = rv_sd(b, 28, 6, 0) in
        let _ = rv_addi(b, 28, 2, 8) in
        let av_save = bytes_len(b) in
        let _ = rv_li32_pair(b, 6, 0) in
        let _ = rv_sd(b, 28, 6, 0) in
        cons([5, av_save],
             cons([4, ac_save], patches))
      else patches in
    let _ =
      if is_entry then rv_addi(b, 8, 2, 0)
      else
        let _ = rv_addi(b, 2, 2, 0 - 16) in
        let _ = rv_sd(b, 1, 2, 8) in
        let _ = rv_sd(b, 8, 2, 0) in
        rv_addi(b, 8, 2, 0) in
    let patches3 =
      if is_entry then
        let sh_save = bytes_len(b) in
        let _ = rv_li32_pair(b, 6, 0) in
        let _ = rv_sd(b, 8, 6, 0) in
        cons([6, sh_save], patches2)
      else patches2 in
    let _ = rv_addi(b, 2, 2, 0 - nbytes) in
    /* Object ABI (LIR.md 4.4.4), keyed off the 4th local field the front writes
     * for every closure-callable proc -- never inferred here. The object sits in
     * a0 and the real params follow in a1-a7, then the stack at
     * [fp + 16 + 8*(j-7)]; slot 0 keeps the CALLER's self, because this frame is
     * about to retarget it at itself. Unmarked frames (_start, runtime $procs,
     * host leaves) keep the plain 8-register layout. */
    let selfabi = len(insn) > 3 in
    let nregargs = if selfabi then 7 else 8 in
    let aregadd = if selfabi then 1 else 0 in
    let _ = if is_entry then 0 else rv_slot(b, 0, true, 27) in
    let _ = if selfabi then rv_addi(b, 27, 10, 0) else 0 in
    let storep(j) =
      if j >= nparams then 0
      else if j < nregargs then
        let _ = rv_slot(b, j + 1, true, 10 + j + aregadd) in
        storep(j + 1)
      else
        let _ = rv_ld(b, 6, 8, 16 + bshl(j - nregargs, 3)) in
        let _ = rv_slot(b, j + 1, true, 6) in
        storep(j + 1) in
    let _ = storep(0) in
    let labs =
      if is_entry then labels
      else
        let _ = emit_tco_set(bytes_len(b)) in
        label_put(labels, tco_lab(0), bytes_len(b)) in
    emit_st4(st, b, cur, labs, patches3)
  else if k == "mov_imm" then
    let _ = rv_li(b, 6, nth(insn, 2)) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mov" then
    let _ = rv_slot(b, nth(insn, 2), false, 6) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels, patches)
  else if is_arith(k) then
    let _ = rv_slot(b, nth(insn, 2), false, 6) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 3), false, 28) in
    let _ = rv_sra(b, 28, 28, 7) in
    let _ =
      if k == "add" then rv_add(b, 6, 6, 28)
      else if k == "sub" then rv_sub(b, 6, 6, 28)
      else if k == "mul" then rv_mul(b, 6, 6, 28)
      else if k == "land" then rv_and(b, 6, 6, 28)
      else if k == "lor" then rv_or(b, 6, 6, 28)
      else if k == "xor" then rv_xor(b, 6, 6, 28)
      else if k == "bnot" then rv_xori(b, 6, 6, 0 - 1)
      else if k == "shl" then rv_sll(b, 6, 6, 28)
      else if k == "shr" then rv_srl(b, 6, 6, 28)
      else if k == "div" then rv_div(b, 6, 6, 28)
      else if k == "rem" then rv_rem(b, 6, 6, 28)
      else rv_add(b, 6, 6, 28) in
    let _ = rv_sll(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "icmp" then
    let op = nth(insn, 1) in
    let _ = rv_slot(b, nth(insn, 3), false, 6) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 4), false, 28) in
    let _ = rv_sra(b, 28, 28, 7) in
    let _ = rv_cmp_int(b, op) in
    let _ = rv_slot(b, nth(insn, 2), true, 6) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cmp" then
    let op = nth(insn, 1) in
    let _ = rv_slot(b, nth(insn, 3), false, 10) in
    let _ = rv_slot(b, nth(insn, 4), false, 11) in
    let patches2 = rv_cmp_val(b, op, patches, nth(st, 4)) in
    let _ = rv_slot(b, nth(insn, 2), true, 6) in
    emit_st4(st, b, cur, labels, patches2)
  else if k == "label" then
    let nm = nth(insn, 1) in
    let pos = bytes_len(b) in
    let _ =
      if is_entry then 0
      else if intern(nm) == tco_lab(0) then emit_tco_set(pos)
      else 0 in
    emit_st4(st, b, cur, label_put(labels, nm, pos), patches)
  else if k == "jmp" then
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    emit_st4(st, b, cur, labels, cons(["jal", pos, nth(insn, 1)], patches))
  else if k == "cmpjmp" then
    let _ = rv_slot(b, nth(insn, 1), false, 6) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 6, 6, 7) in
    let pz = bytes_len(b) in
    let _ = rv_beq(b, 6, 0, 8) in
    let pt = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let pf = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    emit_st4(st, b, cur, labels,
     cons(["jal", pt, nth(insn, 2)],
          cons(["jal", pf, nth(insn, 3)], patches)))
  else if k == "fcall" then emit_rv_fcall(st, insn)
  else if k == "ycall" then emit_rv_ycall(st, insn)
  else if k == "ccall" then emit_rv_ccall(st, insn)
  else if k == "iccall" then emit_rv_iccall(st, insn)
  else if k == "ret" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    if is_entry then
      let _ = rv_jalr(b, 0, 1, 0) in emit_st4(st, b, cur, labels, patches)
    else
      let _ = if is_entry then 0 else rv_slot(b, 0, false, 27) in
      let _ = rv_addi(b, 2, 8, 0) in
      let _ = rv_ld(b, 1, 2, 8) in
      let _ = rv_ld(b, 8, 2, 0) in
      let _ = rv_addi(b, 2, 2, 16) in
      let _ = rv_jalr(b, 0, 1, 0) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "exit" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 10, 10, 7) in
    let _ = rv_addi(b, 17, 0, 93) in
    let _ = rv_ecall(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "tcall" then
    if nth(insn, 2) == emit_self(0) then
      if emit_tco_get(0) == 0 then emit_rv_tcall_other(st, insn, is_entry)
      else emit_rv_tloop(st, nth(insn, 3))
    else emit_rv_tcall_other(st, insn, is_entry)
  else st

let emit_rv_sysarg(b, args, j) =
  if j >= len(args) then 0
  else if j >= 6 then 0
  else
    let _ = rv_slot(b, nth(args, j), false, 10 + j) in
    emit_rv_sysarg(b, args, j + 1)

let emit_rv_i_sys(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  if nth(insn, 0) == "untag" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 10, 10, 7) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else
    let nr = nth(insn, 2) in
    let _ = emit_rv_sysarg(b, nth(insn, 3), 0) in
    let _ =
      if nr == 60 then rv_addi(b, 17, 0, 93)
      else rv_addi(b, 17, 0, nr) in
    let _ = rv_ecall(b) in
    let _ = rv_slli(b, 10, 10, 1) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)

let emit_rv_i_raw(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "$and" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let imm = nth(insn, 3) in
    let _ =
      if imm == (0 - 2) then rv_untag_ptr(b, 10)
      else
        let _ = rv_addi(b, 6, 0, imm) in
        rv_and(b, 10, 10, 6) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$addi" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 10, 10, nth(insn, 3)) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$add" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sub" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_sub(b, 10, 10, 11) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bts" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let _ = rv_lbu(b, 12, 10, 0) in
    let _ = rv_addi(b, 13, 0, 1) in
    let _ = rv_sll(b, 13, 13, 11) in
    let _ = rv_or(b, 12, 12, 13) in
    let _ = rv_sb(b, 12, 10, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bt" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_lbu(b, 10, 10, 0) in
    let _ = rv_srl(b, 10, 10, 11) in
    let _ = rv_addi(b, 11, 0, 1) in
    let _ = rv_and(b, 10, 10, 11) in
    let _ = rv_slli(b, 10, 10, 1) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$or" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$clamp0" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_clamp0(b) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st64" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_sd(b, 11, 10, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st8" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_sb(b, 0, 10, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld64" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_ld(b, 10, 10, nth(insn, 3)) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld8" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_lbu(b, 10, 10, nth(insn, 3)) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sp" then
    let _ = rv_addi(b, 10, 2, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$fp" then
    let _ = rv_addi(b, 10, 8, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$smap" then
    let _ = rv_addi(b, 10, 0, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$gbase" then
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels, cons([3, gpos], patches))
  else if k == "$glob" then
    let which = nth(insn, 2) in
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_ld(b, 6, 6, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "$icmp" then
    let op = nth(insn, 1) in
    let _ = rv_slot(b, nth(insn, 3), false, 10) in
    let _ = rv_slot(b, nth(insn, 4), false, 11) in
    let _ =
      if op == "==" then
        let _ = rv_xor(b, 10, 10, 11) in
        rv_sltiu(b, 10, 10, 1)
      else if op == ">=u" then
        let _ = rv_sltu(b, 10, 10, 11) in
        let _ = rv_xori(b, 10, 10, 1) in
        0
      else if op == "<" then
        rv_slt(b, 10, 10, 11)
      else
        let _ = rv_xor(b, 10, 10, 11) in
        let _ = rv_sltiu(b, 10, 10, 1) in
        rv_xori(b, 10, 10, 1) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sll(b, 10, 10, 7) in
    let _ = rv_slot(b, nth(insn, 2), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$jcc" then
    let op = nth(insn, 1) in
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ =
      if op == "==" then rv_bne(b, 10, 11, 8)
      else if op == ">=u" then rv_bltu(b, 10, 11, 8)
      else rv_bge(b, 10, 11, 8) in
    let pt = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let pf = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    emit_st4(st, b, cur, labels,
     cons(["jal", pt, nth(insn, 4)],
          cons(["jal", pf, nth(insn, 5)], patches)))
  else if k == "$memcpy" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let _ = rv_slot(b, nth(insn, 3), false, 12) in
    let loop = bytes_len(b) in
    let jeq = bytes_len(b) in
    let _ = rv_beq(b, 12, 0, 0) in
    let _ = rv_lbu(b, 13, 11, 0) in
    let _ = rv_sb(b, 13, 10, 0) in
    let _ = rv_addi(b, 10, 10, 1) in
    let _ = rv_addi(b, 11, 11, 1) in
    let _ = rv_addi(b, 12, 12, 0 - 1) in
    let jb = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let done = bytes_len(b) in
    let _ = rv_patch_b(b, jeq, done) in
    let _ = rv_apply_jal(b, jb, loop, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$memset" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let loop = bytes_len(b) in
    let jeq = bytes_len(b) in
    let _ = rv_beq(b, 11, 0, 0) in
    let _ = rv_sb(b, 0, 10, 0) in
    let _ = rv_addi(b, 10, 10, 1) in
    let _ = rv_addi(b, 11, 11, 0 - 1) in
    let jb = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let done = bytes_len(b) in
    let _ = rv_patch_b(b, jeq, done) in
    let _ = rv_apply_jal(b, jb, loop, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$shr" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_srli(b, 10, 10, nth(insn, 3)) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$carg" then
    let _ = rv_slot(b, nth(insn, 2), false, 10 + nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$icall" then
    let _ = rv_slot(b, nth(insn, 2), false, 6) in
    let _ = rv_jalr(b, 1, 6, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$f64binop" or k == "$f64fromstr" or k == "$f64print" or k == "$f64rel" then
    emit_rv_i_f64(st, insn)
  else
    let name = nth(insn, 2) in
    let args = nth(insn, 3) in
    let _ =
      if name == "open" then
        let _ = rv_slot(b, nth(args, 0), false, 11) in
        let _ = rv_addi(b, 10, 0, 0 - 100) in
        let _ = rv_slot(b, nth(args, 1), false, 12) in
        let _ =
          if len(args) > 2 then rv_slot(b, nth(args, 2), false, 13)
          else rv_addi(b, 13, 0, 0) in
        rv_addi(b, 17, 0, 56)
      else if name == "fork" then
        let _ = rv_addi(b, 10, 0, 17) in
        let _ = rv_addi(b, 11, 0, 0) in
        let _ = rv_addi(b, 12, 0, 0) in
        let _ = rv_addi(b, 13, 0, 0) in
        let _ = rv_addi(b, 14, 0, 0) in
        rv_addi(b, 17, 0, 220)
      else
        let _ = emit_rv_sysarg(b, args, 0) in
        if name == "lseek" then rv_addi(b, 17, 0, 62)
        else if name == "read" then rv_addi(b, 17, 0, 63)
        else if name == "write" then rv_addi(b, 17, 0, 64)
        else if name == "wait4" then rv_addi(b, 17, 0, 260)
        else if name == "execve" then rv_addi(b, 17, 0, 221)
        else if name == "exit" then rv_addi(b, 17, 0, 93)
        else if name == "brk" then rv_addi(b, 17, 0, 214)
        else if name == "mmap" then rv_addi(b, 17, 0, 222)
        else if name == "munmap" then rv_addi(b, 17, 0, 215)
        else rv_addi(b, 17, 0, 57) in
    let _ = rv_ecall(b) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)

let emit_rv_i_heap(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "obj_kind" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_ld(b, 10, 10, 16) in
    let _ = rv_add(b, 10, 10, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mref" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_ld(b, 10, 10, nth(insn, 3)) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset" then
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_sd(b, 11, 10, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "tag" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_add(b, 10, 10, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "is_int" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_and(b, 5, 10, 7) in
    let _ = rv_xor(b, 5, 5, 7) in
    let _ = rv_add(b, 10, 5, 5) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "obj_sti" then
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_li(b, 11, nth(insn, 3)) in
    let _ = rv_sd(b, 11, 10, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "obj_st_int" then
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_sd(b, 11, 10, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mref8" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_lbu(b, 10, 10, 0) in
    let _ = rv_add(b, 10, 10, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset8" then
    let _ = rv_slot(b, nth(insn, 3), false, 12) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 12, 12, 7) in
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_sb(b, 12, 10, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "ld64" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_ld(b, 10, 10, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "st64" then
    let _ = rv_slot(b, nth(insn, 3), false, 12) in
    let _ = rv_slot(b, nth(insn, 1), false, 10) in
    let _ = rv_addi(b, 6, 0, 0 - 2) in
    let _ = rv_and(b, 10, 10, 6) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_sd(b, 12, 10, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "write1" then
    let _ = rv_slot(b, nth(insn, 1), false, 6) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 6, 6, 7) in
    let _ = rv_addi(b, 2, 2, 0 - 16) in
    let _ = rv_sb(b, 6, 2, 0) in
    let _ = rv_addi(b, 10, 0, 1) in
    let _ = rv_addi(b, 11, 2, 0) in
    let _ = rv_addi(b, 12, 0, 1) in
    let _ = rv_addi(b, 17, 0, 64) in
    let _ = rv_ecall(b) in
    let _ = rv_addi(b, 2, 2, 16) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "clock" then
    let _ = rv_addi(b, 2, 2, 0 - 16) in
    let _ = rv_addi(b, 10, 0, nth(insn, 3)) in
    let _ = rv_addi(b, 11, 2, 0) in
    let _ = rv_addi(b, 17, 0, 113) in
    let _ = rv_ecall(b) in
    let _ = rv_ld(b, 6, 2, 0) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sll(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    let _ = rv_ld(b, 6, 2, 8) in
    let _ = rv_sll(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 2), true, 6) in
    let _ = rv_addi(b, 2, 2, 16) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "gvar" then
    /* Flat function value: stub closure [0, 0, entry, 0] in the globals area;
     * entry baked into [cell+16] by tag 23, value = tagged cell address.
     * Mirrors x86_64. */
    let nm = nth(insn, 2) in
    let goff = gref_base() + bshl(gref_alloc(nm), 5) in
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let fid = emit_map_get(nth(st, 4), nm) in
    let _ =
      if fid == 0 then
        log_fatal(str_cat("emit: gvar: no such procedure '", str_cat(nm, "'")))
      else 0 in
    let _ = rv_tag(b, 6) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels,
      cons([23, fid, goff], cons([12, gpos, goff], patches)))
  else if k == "gval" then
    /* Read a top-level value: [unit + 0] (name unit = 32B in the globals area,
     * value at +0, entry at +16). Mirrors x86_64's abs64 tag 22 via tag 12. */
    let goff = gref_base() + bshl(gref_alloc(nth(insn, 2)), 5) in
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_ld(b, 6, 6, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    emit_st4(st, b, cur, labels, cons([12, gpos, goff], patches))
  else if k == "gset" then
    /* ["gset", name, off, src]: immediate -> link-time bake (tag 24),
     * otherwise a runtime store followed by a GC-root publish (yac_gval_pub),
     * exactly like x86_64 (FLAT_ABI.md 2.3). */
    let nm = nth(insn, 1) in
    let off = nth(insn, 2) in
    let src = nth(insn, 3) in
    let goff = gref_base() + bshl(gref_alloc(nm), 5) + off in
    if nth(src, 0) == "imm" then
      emit_st4(st, b, cur, labels, cons([24, goff, nth(src, 1)], patches))
    else
      let gpos = bytes_len(b) in
      let _ = rv_li32_pair(b, 6, 0) in
      let _ = rv_slot(b, src, false, 7) in
      let _ = rv_sd(b, 7, 6, 0) in
      /* GC-root publish (FLAT_ABI.md 2.3 / 8.2 #13): a top-level value
       * assigned at run time must land in the G+440 list, or the collector
       * never marks the cell's value. yac_gval_pub is an unmarked $proc
       * (plain ABI), so the name goes to a0 and the value to a1; both the
       * strlit and the call are patched like any other fcall. */
      let npos = bytes_len(b) in
      let _ = rv_li32_pair(b, 10, 0) in
      let _ = rv_slot(b, src, false, 11) in
      let acall = bytes_len(b) in
      let _ = rv_jal(b, 1, 0) in
      emit_st4(st, b, cur, labels,
        emit_patch_rel(nth(st, 4),
          emit_patch_strlit(cons([12, gpos, goff], patches), npos, strlit_off(nm)),
          acall, "yac_gval_pub"))
  else if k == "glob" then
    let which = nth(insn, 2) in
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_ld(b, 6, 6, 0) in
    let _ =
      if which == 3 then 0
      else if which == 4 then 0
      else
        let _ = rv_addi(b, 7, 0, 1) in
        rv_sll(b, 6, 6, 7) in
    let _ = rv_slot(b, nth(insn, 1), true, 6) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "gst" then
    let which = nth(insn, 1) in
    let gpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_slot(b, nth(insn, 2), false, 7) in
    let _ = rv_sd(b, 7, 6, 0) in
    let gkind = if which == 3 then 7 else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "alloc" then
    let _ = rv_li(b, 10, nth(insn, 2)) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
  else if k == "alloc_s" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 10, 10, 7) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
  else if k == "argc" then
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_argc", nth(st, 4)))
  else if k == "time_ms" then
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "time_ms", nth(st, 4)))
  else if k == "time_str" then
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "time_str", nth(st, 4)))
  else if k == "argv" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_argv"))
  else st

let emit_rv_i_clos(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "closure" then
    let dst = nth(insn, 1) in
    let fnName = nth(insn, 2) in
    let caps = nth(insn, 3) in
    let nenv = len(caps) in
    let size = clos_bytes(nenv) in
    let _ = rv_li(b, 10, size) in
    let acall = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_sd(b, 0, 10, 8) in
    let fnpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 11, 0) in
    let _ = rv_sd(b, 11, 10, 16) in
    let _ = rv_addi(b, 11, 0, nenv) in
    let _ = rv_sd(b, 11, 10, 24) in
    let storecap(i) =
      if i >= nenv then 0
      else
        let _ = rv_slot(b, nth(caps, i), false, 11) in
        let _ = rv_sd(b, 11, 10, 32 + bshl(i, 3)) in
        storecap(i + 1) in
    let _ = storecap(0) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, dst, true, 10) in
    emit_st4(st, b, cur, labels,
     emit_patch_rel(nth(st, 4), emit_patch_clos(nth(st, 4), patches, fnpos, fnName), acall, "yac_alloc"))
  else if k == "apply" or k == "icall" then
    let dst = nth(insn, 1) in
    let clos = nth(insn, 2) in
    let args = apply_args(insn) in
    let nargs = len(args) in
    let nstack = if nargs > 7 then nargs - 7 else 0 in
    let pad = if nstack == 0 then 0 else if band(nstack, 1) == 0 then 0 else 8 in
    let _ = if pad == 0 then 0 else rv_addi(b, 2, 2, 0 - 8) in
    let _ = if nstack == 0 then 0 else rv_apply_push(b, 7, 0, args, nargs - 1) in
    /* Closure call, object ABI: the object (untagged) goes in a0 and the real
     * params follow from a1; caps are the CALLEE's business now -- it reads them
     * through its self register, so nothing is repacked at the call site (that
     * repack was the dead flat-ABI scheme, which fed a capRef callee garbage). */
    let _ = rv_slot(b, clos, false, 10) in
    let _ = rv_untag_ptr(b, 10) in
    let load(j) =
      if j >= nargs or j >= 7 then 0
      else
        let _ = rv_slot(b, nth(args, j), false, 11 + j) in
        load(j + 1) in
    let _ = load(0) in
    let _ = rv_ld(b, 6, 10, 16) in
    let _ = rv_jalr(b, 1, 6, 0) in
    let _ =
      if nstack == 0 then 0
      else rv_addi(b, 2, 2, bshl(nstack, 3) + pad) in
    let _ = rv_slot(b, dst, true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else st

let emit_rv_i_prim(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "nil" then
    let _ = rv_addi(b, 10, 0, 1) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cons" then
    let _ = rv_addi(b, 10, 0, 40) in
    let acall = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_sd(b, 0, 10, 8) in
    let _ = rv_addi(b, 11, 0, 2) in
    let _ = rv_sd(b, 11, 10, 16) in
    let _ = rv_slot(b, nth(insn, 2), false, 11) in
    let _ = rv_sd(b, 11, 10, 24) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_sd(b, 11, 10, 32) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall, "yac_alloc"))
  else if k == "strlit" then
    let dst = nth(insn, 1) in
    let off = strlit_off(nth(insn, 2)) in
    let pos = bytes_len(b) in
    let _ = rv_li32_pair(b, 10, 0) in
    let _ = rv_slot(b, dst, true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_strlit(patches, pos, off))
  else if k == "str_len" then
    let dst = nth(insn, 1) in
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let jz = bytes_len(b) in
    let _ = rv_beq(b, 10, 0, 0) in
    let _ = rv_addi(b, 11, 0, 1) in
    let jnil = bytes_len(b) in
    let _ = rv_beq(b, 10, 11, 0) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_ld(b, 10, 10, 24) in
    let _ = rv_add(b, 10, 10, 10) in
    let jd = bytes_len(b) in
    let _ = rv_jal(b, 0, 0) in
    let zlen = bytes_len(b) in
    let _ = rv_addi(b, 10, 0, 0) in
    let done = bytes_len(b) in
    let _ = rv_patch_b(b, jz, zlen) in
    let _ = rv_patch_b(b, jnil, zlen) in
    let _ = rv_apply_jal(b, jd, done, 0) in
    let _ = rv_slot(b, dst, true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "str_ref" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_addi(b, 7, 0, 1) in
    let _ = rv_sra(b, 11, 11, 7) in
    let _ = rv_addi(b, 10, 10, 32) in
    let _ = rv_add(b, 10, 10, 11) in
    let _ = rv_lbu(b, 10, 10, 0) in
    let _ = rv_add(b, 10, 10, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_new" then
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_new", nth(st, 4)))
  else if k == "bytes_len" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_ld(b, 10, 10, 24) in
    let _ = rv_add(b, 10, 10, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_ref" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_ref", nth(st, 4)))
  else if k == "bytes_put" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_slot(b, nth(insn, 4), false, 12) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_put", nth(st, 4)))
  else if k == "bytes_append" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_append", nth(st, 4)))
  else if k == "len" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_len", nth(st, 4)))
  else if k == "nth" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_nth", nth(st, 4)))
  else if k == "tail" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_tail", nth(st, 4)))
  else if k == "append" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_append", nth(st, 4)))
  else if k == "list_rev" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_list_rev", nth(st, 4)))
  else if k == "list_new" then
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_list_new", nth(st, 4)))
  else if k == "list_push" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_list_push", nth(st, 4)))
  else if k == "str_cat" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_str_cat", nth(st, 4)))
  else if k == "str_slice" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_slot(b, nth(insn, 4), false, 12) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_str_slice", nth(st, 4)))
  else if k == "int_to_str" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_int_to_str", nth(st, 4)))
  else if k == "bytes_to_str" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_to_str", nth(st, 4)))
  else if k == "bytes_extend" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_bytes_extend", nth(st, 4)))
  else if k == "drop" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_drop", nth(st, 4)))
  else if k == "foldl" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let _ = rv_slot(b, nth(insn, 4), false, 12) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_foldl", nth(st, 4)))
  else if k == "map" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    emit_st4(st, b, cur, labels, rv_jal_rt(b, patches, nth(insn, 1), "yac_map", nth(st, 4)))
  else if k == "read_file" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_read_file"))
  else if k == "write_file" then
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_slot(b, nth(insn, 3), false, 11) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_write_file"))
  else
    let _ = rv_unimp(b) in
    emit_st4(st, b, cur, labels, patches)

let emit_rv_i_memcpy(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ = rv_slot(b, nth(insn, 1), false, 10) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_slot(b, nth(insn, 2), false, 11) in
  let _ = rv_addi(b, 7, 0, 1) in
  let _ = rv_sra(b, 11, 11, 7) in
  let _ = rv_add(b, 10, 10, 11) in
  let _ = rv_slot(b, nth(insn, 3), false, 11) in
  let _ = rv_untag_ptr(b, 11) in
  let _ = rv_slot(b, nth(insn, 4), false, 12) in
  let _ = rv_sra(b, 12, 12, 7) in
  let _ = rv_add(b, 11, 11, 12) in
  let _ = rv_slot(b, nth(insn, 5), false, 12) in
  let _ = rv_sra(b, 12, 12, 7) in
  let loop = bytes_len(b) in
  let jeq = bytes_len(b) in
  let _ = rv_beq(b, 12, 0, 0) in
  let _ = rv_lbu(b, 13, 11, 0) in
  let _ = rv_sb(b, 13, 10, 0) in
  let _ = rv_addi(b, 10, 10, 1) in
  let _ = rv_addi(b, 11, 11, 1) in
  let _ = rv_addi(b, 12, 12, 0 - 1) in
  let jb = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let done = bytes_len(b) in
  let _ = rv_patch_b(b, jeq, done) in
  let _ = rv_apply_jal(b, jb, loop, 0) in
  emit_st4(st, b, cur, labels, patches)

let emit_rv_i_cc(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "mkcont" then
    let _ = rv_li(b, 10, 48) in
    let pos = bytes_len(b) in
    let _ = rv_jal(b, 1, 0) in
    let _ = rv_untag_ptr(b, 10) in
    let _ = rv_sd(b, 0, 10, 8) in
    let _ = rv_li(b, 11, 6) in
    let _ = rv_sd(b, 11, 10, 16) in
    let _ = rv_sd(b, 8, 10, 24) in
    let _ = rv_sd(b, 2, 10, 32) in
    let labpos = bytes_len(b) in
    let _ = rv_li32_pair(b, 6, 0) in
    let _ = rv_sd(b, 6, 10, 40) in
    let _ = rv_tag(b, 10) in
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels,
      emit_patch_rel(nth(st, 4),
        cons(["cclab", labpos, nth(insn, 2)], patches), pos, "yac_alloc"))
  else if k == "throwk" then
    let _ = rv_slot(b, nth(insn, 1), false, 11) in
    let _ = rv_untag_ptr(b, 11) in
    let _ = rv_slot(b, nth(insn, 2), false, 10) in
    let _ = rv_ld(b, 8, 11, 24) in
    let _ = rv_ld(b, 6, 11, 32) in
    let _ = rv_ld(b, 7, 11, 40) in
    let _ = rv_addi(b, 2, 6, 0) in
    let _ = rv_jalr(b, 0, 7, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cc_recv" then
    let _ = rv_slot(b, nth(insn, 1), true, 10) in
    emit_st4(st, b, cur, labels, patches)
  else
    let _ = log_fatal(str_cat("emit: unknown LIR insn '", str_cat(k, "'"))) in
    st

let emit_insn_rv_go(st, insn, is_entry) =
  let k = nth(insn, 0) in
  if k == "closure" or k == "apply" or k == "icall" then
    emit_rv_i_clos(st, insn, is_entry)
  else if is_frame_op(k) or k == "mov_imm" or k == "mov" or is_arith(k)
       or k == "cmp" or k == "icmp" or k == "label" or k == "fcall" or k == "ccall"
       or k == "iccall" or k == "tcall" or k == "jmp" or k == "cmpjmp" or k == "ret"
       or k == "exit" or k == "ycall" then
    emit_rv_i_core(st, insn, is_entry)
  else if k == "untag" or k == "syscall" then
    emit_rv_i_sys(st, insn)
  else if is_raw_op(k) then
    emit_rv_i_raw(st, insn)
  else if k == "obj_kind" or k == "mref" or k == "mset" or k == "tag"
       or k == "is_int" or k == "alloc" or k == "obj_sti" or k == "obj_st_int"
       or k == "alloc_s" or k == "mref8" or k == "mset8" or k == "ld64" or k == "st64"
       or k == "write1" or k == "clock" or k == "glob" or k == "gst"
       or k == "gval" or k == "gset" or k == "gvar" or k == "time_ms"
       or k == "time_str" or k == "argc" or k == "argv" then
    emit_rv_i_heap(st, insn)
  else if k == "memcpy" then emit_rv_i_memcpy(st, insn)
  else if k == "mkcont" or k == "throwk" or k == "cc_recv" then
    emit_rv_i_cc(st, insn)
  else emit_rv_i_prim(st, insn)

let emit_insn_rv(st, insn, is_entry) =
  emit_insn_rv_go(st, insn, is_entry)



let rv_lookup_at(xs, name, i) =
  if i < 0 then 0
  else if nth(nth(xs, i), 0) == name then nth(nth(xs, i), 1)
  else rv_lookup_at(xs, name, i - 1)

let rv_lookup(xs, name) = rv_lookup_at(xs, name, len(xs) - 1)

let rv_resolve_fun_patches(b, labels, patches) =
  let n = len(patches) in
  let keep = list_new() in
  let step(i) =
    if i >= n then keep
    else
      let p = nth(patches, i) in
      let tag = nth(p, 0) in
      let _ =
        if is_int(tag) then list_push(keep, p)
        else if tag == "cclab" then
          list_push(keep, ["cclab", nth(p, 1), rv_lookup(labels, nth(p, 2))])
        else rv_apply_jal(b, nth(p, 1), rv_lookup(labels, nth(p, 2)), 0) in
      step(i + 1) in
  step(0)

let rv_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let offs = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let labels = nth(st, 4) in
  let tag = nth(p, 0) in
  if tag == 1 then
    rv_apply_jal(b, nth(p, 1), nth(offs, nth(p, 2)), 1)
  else if tag == 2 then
    dlib_rv_va(b, nth(p, 1), 11, codebase + nth(offs, nth(p, 2)), codebase)
  else if tag == 3 then
    dlib_rv_va(b, nth(p, 1), 6, globbase, codebase)
  else if tag == 4 then
    dlib_rv_va(b, nth(p, 1), 6, globbase + 8, codebase)
  else if tag == 5 then
    dlib_rv_va(b, nth(p, 1), 6, globbase + 16, codebase)
  else if tag == 6 then
    dlib_rv_va(b, nth(p, 1), 6, globbase + 24, codebase)
  else if tag == 7 then
    dlib_rv_va(b, nth(p, 1), 6, globbase + 120, codebase)
  else if tag == 8 then
    dlib_rv_va(b, nth(p, 1), 6, globbase + 128, codebase)
  else if tag == 9 then
    rv_apply_jal(b, nth(p, 1), nth(offs, nth(p, 2)), 0)
  else if tag == 23 then
    /* Bake a gvar stub's entry field: [cell+16] = codebase + offs[fid]. */
    apply_u64(b, globbase - codebase + nth(p, 2) + 16, codebase + nth(offs, nth(p, 1)))
  else if tag == 24 then
    /* Link-time bake of a top-level value into its name unit (x86_64 tag 24). */
    apply_u64(b, globbase - codebase + nth(p, 1), nth(p, 2))
  else if tag == 12 then
    /* Host-leaf slot address: globbase + 136 + 8*id (numeric tag: the per-fun
     * resolver only keeps numeric patches). */
    dlib_rv_va(b, nth(p, 1), 6, globbase + nth(p, 2), codebase)
  else if tag == 11 then
    dlib_rv_va(b, nth(p, 1), 10, nth(st, 5) + nth(p, 2) + 1, codebase)
  else if tag == 15 then
    rv_apply_jal(b, nth(p, 1), nth(nth(cimport_buf(0), 1), nth(p, 2)), 1)
  else if tag == "cclab" then
    dlib_rv_va(b, nth(p, 1), 6, codebase + nth(p, 2), codebase)
  else
    let pos = nth(p, 1) in
    let lab = nth(p, 2) in
    let targ = rv_lookup(labels, lab) in
    rv_apply_jal(b, pos, targ, 0)

let rv_resolve_loop(st, ps, i) =
  if i >= len(ps) then 0
  else
    let _ = rv_resolve_patch(st, nth(ps, i)) in
    rv_resolve_loop(st, ps, i + 1)

let emit_program_riscv64(prog, load_vaddr, text_off, fmt) =
  let _ = emit_fmt_set(fmt) in
  let _ =
    emit_abi_win_set(
      if fmt == "pe" then true
      else if load_vaddr == JIT_VADDR then host_os(0) == "windows"
      else false) in
  let _ = strlit_pool_reset(0) in
  let _ = cimport_reset(0) in
  let ckeep = cimport_buf(0) in
  /* Host slots: one named unimpl stub per leaf, so a missing @leaf says which
   * one it was (see host_unstub_procs in emit.yac). */
  /* prof_hook_fix: hook calls follow the target's frame ABI, and a hook
   * defined in this unit is only visible once the proc list is complete
   * (FLAT_ABI.md 8.2 #8). */
  let funs = prof_hook_fix(append(nth(prog, 1), host_unstub_procs(0))) in
  /* Target-frame ABI table for tcall (emit.yac tcall_raw_of). */
  let _ = tcall_tab_set(funs) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let ids = emit_ids_new(funs) in
  let offs = list_new() in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let _ = emit_self_set(name) in
      let _ = emit_tco_set(0) in
      let is_entry = name == entry in
      let fstart = bytes_len(nth(st, 0)) in
      let st0 = [nth(st, 0), 0, [], [], nth(st, 4)] in
      let insns = nth(f, 4) in
      if len(insns) == 0 then
        let _ = list_push(offs, 0) in
        emit_fun(i + 1, st, fo)
      else
        let _ = list_push(offs, fstart) in
        let run(j, s) =
          if j >= len(insns) then s
          else run(j + 1, emit_insn_rv(s, nth(insns, j), is_entry)) in
        let s1 = run(0, st0) in
        let kept = rv_resolve_fun_patches(nth(s1, 0), nth(s1, 2), nth(s1, 3)) in
        let _ = patches_extend(nth(st, 3), kept) in
        let s2 = [nth(s1, 0), 0, [], nth(st, 3), nth(st, 4)] in
        emit_fun(i + 1, s2, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, [out, 0, [], list_new(), ids], []) in
  /* --dump-asm: same listing as x86_64 (shared helper; this backend had none). */
  let want_asm = asm_dump_get(0) != 0 in
  let _ = if want_asm then asm_dump_set(0) else 0 in
  let _ = if want_asm then asm_dump_procs(out, funs, offs, nfun) else 0 in
  let st = nth(r1, 0) in
  let fo0 = nth(r1, 1) in
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ =
    if elf_pic(0) then emit_cabi_all(b, nth(st, 4), patches, funs)
    else 0 in
  let pad8(_) =
    if band(bytes_len(b), 7) == 0 then 0
    else let _ = bytes_append(b, 0) in pad8(0) in
  let _ = pad8(0) in
  let pool_start = bytes_len(b) in
  let _ = bytes_extend(b, strlit_bytes(0)) in
  let _ = pad8(0) in
  let data_start = bytes_len(b) in
  let _ = emit_glob_data(b) in
  let _ = emit_cplt_rv(b) in
  let _ = ckeep in
  let GLOBALS_BASE = load_vaddr + text_off + data_start in
  /* Bake the G+136 host-slot table (AOT): implemented leaves -> their entry,
   * the rest -> their own stub that names the leaf. */
  let _ = host_slot_bake(b, fo0, load_vaddr, text_off, data_start) in
  let extra = list_new() in
  let _ = patches_extend(extra, patches) in
  /* Field 6 = the G/host-slot base (tags 3..8, 21). This backend always bakes
   * those into its own image, so it equals GLOBALS_BASE -- see emit_x86_64's
   * GSESS_BASE note for why the two are separate fields. */
  let rst = [b, offs, load_vaddr + text_off, GLOBALS_BASE, labels,
             load_vaddr + text_off + pool_start, GLOBALS_BASE] in
  let _ = if want_asm then asm_dump_cells(b, data_start, 0) else 0 in
  let _ = emit_unres_set([rst, extra, "riscv64"]) in
  let _ = funsym_set(fo0) in
  let _ = yjit_layout_set(pool_start, pool_start, data_start, bytes_len(b)) in
  [b, fo0]
