  let _ = emit_reg("arm32", "ycall", a32_cop_ycall) in
  let _ = emit_reg("arm32", "add", a32_cop_arith) in
  let _ = emit_reg("arm32", "sub", a32_cop_arith) in
  let _ = emit_reg("arm32", "mul", a32_cop_arith) in
