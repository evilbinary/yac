  emit_st4(st, b, nth(st, 1), nth(st, 2), cons([gkind, gpos], patches))
let a32_cop_gvar(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let nm = nth(insn, 2) in
  let goff = gref_base(0) + bshl(gref_alloc(nm), 5) in
  let gpos = bytes_len(b) in
  let _ = a32_mov_imm32(b, 0, 0) in
  let fid = emit_map_get(nth(st, 4), nm) in
  let _ =
    if fid == 0 then
      log_fatal(str_cat("emit: gvar: no such procedure '", str_cat(nm, "'")))
    else 0 in
  let _ = a32_tag(b, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    cons([23, fid, goff], cons([12, gpos, goff], patches)))
let a32_cop_gval(st, insn) =
