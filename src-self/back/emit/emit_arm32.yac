  let goff = gref_base(0) + bshl(gref_alloc(nth(insn, 2)), 5) in
  let gpos = bytes_len(b) in
  let _ = a32_mov_imm32(b, 0, 0) in
  let _ = a32_ldr_imm(b, 0, 0, 0) in
