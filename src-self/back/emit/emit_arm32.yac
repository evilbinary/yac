  let b = nth(st, 0) in
  let nr = nth(insn, 2) in
  let _ = a32_sysarg(b, nth(insn, 3), 0) in
  let _ =
    if nr == 60 then a32_mov_imm(b, 7, 1)
    else a32_mov_imm(b, 7, nr) in
  let _ = a32_svc(b, 0) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

