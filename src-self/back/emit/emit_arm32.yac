let a32_cop_gset(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let nm = nth(insn, 1) in
  let off = nth(insn, 2) in
  let src = nth(insn, 3) in
  let goff = gref_base(0) + bshl(gref_alloc(nm), 5) + off in
  if nth(src, 0) == "imm" then
    emit_st4(st, b, nth(st, 1), nth(st, 2), cons([24, goff, nth(src, 1)], patches))
  else
    let gpos = bytes_len(b) in
    let _ = a32_mov_imm32(b, 0, 0) in
    let _ = a32_slot(b, src, false, 1) in
    let _ = a32_str_imm(b, 1, 0, 0) in
    let npos = bytes_len(b) in
    let _ = a32_mov_imm32(b, 0, 0) in
    let _ = a32_slot(b, src, false, 1) in
    let acall = bytes_len(b) in
    let _ = a32_bl(b, 0) in
    emit_st4(st, b, nth(st, 1), nth(st, 2),
      emit_patch_rel(nth(st, 4),
        emit_patch_strlit(cons([12, gpos, goff], patches), npos, strlit_off(nm)),
        acall, "yac_gval_pub"))
