  let _ = a32_cmp_imm(b, 1, 0) in
  let jeq = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_mov_imm(b, 3, 0) in
  let _ = a32_strb_imm(b, 3, 0, 0) in
  let _ = a32_add_imm(b, 0, 0, 1) in
  let _ = a32_sub_imm(b, 1, 1, 1) in
  let jb = bytes_len(b) in
  let _ = a32_b(b, 0) in
  let done = bytes_len(b) in
  let _ = a32_patch_bcond(b, jeq, done) in
