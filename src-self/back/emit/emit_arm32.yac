let a32_cop_prim_icmp(st, insn) =
  let b = nth(st, 0) in
  let op = nth(insn, 1) in
  let _ = a32_slot(b, nth(insn, 3), false, 0) in
  let _ = a32_slot(b, nth(insn, 4), false, 1) in
  let _ = a32_cmp_reg(b, 0, 1) in
  let _ = a32_cset(b, 0, a32_cc_of(op)) in
  let _ = a32_lsl1(b, 0, 0) in
