  let _ = a32_mov_imm(b, 7, 263) in
  let _ = a32_svc(b, 0) in
  let _ = a32_ldr_imm(b, 0, 13, 0) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  let _ = a32_ldr_imm(b, 0, 13, 8) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 2), true, 0) in
