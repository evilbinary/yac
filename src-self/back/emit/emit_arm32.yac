package back.emit.emit_arm32

export emit_program_arm32, a32_resolve_loop

import back.encode.encode_arm32
import lib.log {log_fatal}
import back.emit.emit {icall_args, apply_u64, asm_dump_cells, asm_dump_get, asm_dump_procs, asm_dump_set, cimport_buf, cimport_reset, clos_bytes, emit_abi_win_set, emit_fmt_set, emit_glob_data, emit_ids_new, emit_map_get, emit_patch_cimport, emit_patch_clos, emit_patch_rel, emit_patch_strlit, emit_self, emit_self_set, emit_st4, emit_tco_get, emit_tco_set, emit_unres_set, gref_alloc, gref_base, host_id, host_slot_bake, host_unstub_procs, is_arith, is_frame_op, is_raw_op, fun_is_raw, emit_funs_loop, no_skip, label_put, patches_extend, strlit_bytes, strlit_off, strlit_pool_reset, tcall_raw_of, tcall_tab_set, prof_hook_fix, tco_lab, yjit_layout_set, emit_reg, emit_insn_disp, emit_ctx_get, emit_rt_ops, emit_rt_argn, emit_rt_call}
import back.pack.elf {elf_pic, funsym_set}
import back.pack.target {JIT_VADDR}
import lib.map {intern, fmap_new64, fmap_put}
import rt.os {host_os}

/* ---- frame / value helpers ------------------------------------------ */

let a32_frame_bytes(nlocals) =
  let nbytes = bshl(nlocals + 1, 2) in
  bshl(bshr(nbytes + 7, 3), 3)

let a32_tag(b, rd) =
  let _ = a32_mov_imm(b, 9, 1) in
  a32_orr_reg(b, rd, rd, 9)

let a32_untag_ptr(b, rd) =
  let _ = a32_mov_imm(b, 12, 0 - 2) in
  a32_and_reg(b, rd, rd, 12)

/* b/bl immediate is (target - (pos+8)) >> 2, 24-bit signed. */
let a32_patch_b24(b, pos, targ) =
  let rel = bshr(targ - (pos + 8), 2) in
  let w = 592445440 + band(rel, 16777215) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  bytes_put(b, pos + 3, band(bshr(w, 24), 255))

/* Write a 32-bit absolute little-endian value (arm32 relocations). */
let a32_apply_u32(b, pos, v) =
  let _ = bytes_put(b, pos, band(v, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(v, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(v, 16), 255)) in
  bytes_put(b, pos + 3, band(bshr(v, 24), 255))

/* Slot access (LIR.md 4.4.2). 32-bit slots: slot k at [fp - 4*(k+1)]. */
let a32_slot(b, slot, store, rt) =
  if store then
    let off = bshl(slot + 1, 2) in
    let _ = a32_sub_imm(b, 9, 11, off) in
    a32_str_imm(b, rt, 9, 0)
  else
    let k0 = nth(slot, 0) in
    if k0 == "cap" then a32_ldr_imm(b, rt, 10, 32 + bshl(nth(slot, 1), 2))
    else if k0 == "self" then a32_mov_reg(b, rt, 10)
    else if k0 == "imm" then a32_mov_imm32(b, rt, nth(slot, 1))
    else
      let off = bshl(slot + 1, 2) in
      let _ = a32_sub_imm(b, 9, 11, off) in
      a32_ldr_imm(b, rt, 9, 0)

/* ---- op registry ----------------------------------------------------- */

/* runtime-prim: load args into r0..rN then call yac_<name> (AAPCS32). */
let a32_rt_slot(b, slot, i) = a32_slot(b, slot, false, i)
let a32_bl_rt(b, patches, dst, name, ids) =
  let pos = bytes_len(b) in
  let _ = a32_bl(b, 0) in
  let _ = a32_slot(b, dst, true, 0) in
  emit_patch_rel(ids, patches, pos, name)
let a32_op_rt(st, insn) =
  let nm = nth(insn, 0) in
  emit_rt_call(st, insn, nm, emit_rt_argn(nm), a32_rt_slot, a32_bl_rt)

let a32_cop_mov_imm(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_mov_imm32(b, 0, nth(insn, 2)) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_mov(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_label(st, insn) =
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let is_entry = nth(emit_ctx_get(0), 0) in
  let nm = nth(insn, 1) in
  let pos = bytes_len(b) in
  let _ =
    if is_entry then 0
    else if intern(nm) == tco_lab(0) then emit_tco_set(pos)
    else 0 in
  emit_st4(st, b, nth(st, 1), label_put(labels, nm, pos), patches)
let a32_cop_jmp(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let pos = bytes_len(b) in
  let _ = a32_b(b, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), cons(["b24", pos, nth(insn, 1)], patches))
let a32_cop_ret(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let is_entry = nth(emit_ctx_get(0), 0) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  if is_entry then let _ = a32_ret(b) in emit_st4(st, b, cur, labels, patches)
  else
    let _ = a32_mov_reg(b, 13, 11) in
    let _ = a32_ldr_imm(b, 11, 13, 0) in
    let _ = a32_ldr_imm(b, 14, 13, 4) in
    let _ = a32_ret(b) in
    emit_st4(st, b, cur, labels, patches)
let a32_cop_exit(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_lsr_imm(b, 0, 0, 1) in
  let _ = a32_mov_imm(b, 7, 1) in
  let _ = a32_mov_imm(b, 0, 1) in
  let _ = a32_svc(b, 0) in
  emit_st4(st, b, cur, labels, patches)
let a32_cop_nil(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_mov_imm(b, 0, 1) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

/* f64: TODO (VFP). Placeholders keep the table complete. */
let a32_cop_f64binop(st, insn) = 0
let a32_cop_f64fromstr(st, insn) = 0
let a32_cop_f64rel(st, insn) = 0
let a32_cop_f64print(st, insn) = 0

let a32_op_arith(b, opk, d, x, y) =
  if opk == "add" then a32_add_reg(b, d, x, y)
  else if opk == "sub" then a32_sub_reg(b, d, x, y)
  else if opk == "mul" then a32_mul(b, d, x, y)
  else if opk == "land" then a32_and_reg(b, d, x, y)
  else if opk == "lor" then a32_orr_reg(b, d, x, y)
  else if opk == "xor" then a32_eor_reg(b, d, x, y)
  else if opk == "bnot" then a32_mvn_reg(b, d, x)
  else if opk == "shl" then a32_lsl_reg(b, d, x, y)
  else if opk == "shr" then a32_lsr_reg(b, d, x, y)
  else if opk == "div" then a32_sdiv(b, d, x, y)
  else if opk == "rem" then
    let _ = a32_sdiv(b, 2, x, y) in
    let _ = a32_mul(b, 2, 2, y) in
    a32_sub_reg(b, d, x, 2)
  else a32_add_reg(b, d, x, y)

let a32_cc_of(op) =
  if op == "==" then 0
  else if op == "!=" then 1
  else if op == "<" then 11
  else if op == ">=" then 10
  else if op == ">" then 12
  else if op == "<=" then 13
  else 0

let a32_cop_arith(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_asr_imm(b, 0, 0, 1) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_op_arith(b, nth(insn, 0), 0, 0, 1) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_icmp(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 3), false, 0) in
  let _ = a32_asr_imm(b, 0, 0, 1) in
  let _ = a32_slot(b, nth(insn, 4), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_cmp_reg(b, 0, 1) in
  let _ = a32_cset(b, 0, a32_cc_of(nth(insn, 1))) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 2), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_cmpjmp(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_asr_imm(b, 0, 0, 1) in
  let _ = a32_cmp_imm(b, 0, 0) in
  let peq = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let pne = bytes_len(b) in
  let _ = a32_b(b, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
   cons(["b24", pne, nth(insn, 2)],
        cons(["beq", peq, nth(insn, 3)], patches)))

let a32_cop_local(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let is_entry = nth(emit_ctx_get(0), 0) in
  let nlocals = nth(insn, 1) in
  let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
  let nbytes = a32_frame_bytes(nlocals) in
  let _ =
    if is_entry then a32_mov_reg(b, 11, 13)
    else
      let _ = a32_push(b, 18432) in
      a32_mov_reg(b, 11, 13) in
  let _ = a32_sub_imm(b, 13, 13, nbytes) in
  let storep(j) =
    if j >= nparams then 0
    else if j < 4 then
      let _ = a32_slot(b, j + 1, true, j) in
      storep(j + 1)
    else
      let _ = a32_ldr_imm(b, 0, 11, 8 + bshl(j - 4, 2)) in
      let _ = a32_slot(b, j + 1, true, 0) in
      storep(j + 1) in
  let _ = storep(0) in
  emit_st4(st, b, cur, labels, patches)

let a32_cop_fcall(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let dst = nth(insn, 1) in
  let fn = nth(insn, 2) in
  let args = nth(insn, 3) in
  let nargs = len(args) in
  let nstack = if nargs > 4 then nargs - 4 else 0 in
  let pushargs(j) =
    if j < 4 then 0
    else
      let _ = a32_slot(b, nth(args, j), false, 0) in
      let _ = a32_push(b, 1) in
      pushargs(j - 1) in
  let _ = pushargs(nargs - 1) in
  let ldarg(j) =
    if j >= nargs or j >= 4 then 0
    else
      let _ = a32_slot(b, nth(args, j), false, j) in
      ldarg(j + 1) in
  let _ = ldarg(0) in
  let pos = bytes_len(b) in
  let _ = a32_bl(b, 0) in
  let _ = if nstack == 0 then 0 else a32_add_imm(b, 13, 13, bshl(nstack, 2)) in
  let _ = a32_slot(b, dst, true, 0) in
  emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, fn))
let a32_cop_ycall(st, insn) = a32_cop_fcall(st, insn)

let a32_cop_mref(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_mov_imm(b, 1, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 1) in
  let _ = a32_ldr_imm(b, 0, 0, nth(insn, 3)) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_mset(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_mov_imm(b, 2, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 2) in
  let _ = a32_str_imm(b, 1, 0, nth(insn, 2)) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_tag(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_is_int(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_mov_imm(b, 1, 1) in
  let _ = a32_and_reg(b, 0, 0, 1) in
  let _ = a32_eor_reg(b, 0, 0, 1) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_alloc(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let _ = a32_mov_imm32(b, 0, nth(insn, 2)) in
  let pos = bytes_len(b) in
  let _ = a32_bl(b, 0) in
  let _ = a32_tag(b, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
let a32_cop_alloc_s(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_asr_imm(b, 0, 0, 1) in
  let pos = bytes_len(b) in
  let _ = a32_bl(b, 0) in
  let _ = a32_tag(b, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
let a32_cop_obj_sti(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_mov_imm(b, 1, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 1) in
  let _ = a32_mov_imm32(b, 1, nth(insn, 3)) in
  let _ = a32_str_imm(b, 1, 0, nth(insn, 2)) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_obj_st_int(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_mov_imm(b, 2, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 2) in
  let _ = a32_str_imm(b, 1, 0, nth(insn, 2)) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_mref8(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_mov_imm(b, 1, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 1) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_add_reg(b, 0, 0, 1) in
  let _ = a32_ldrb_imm(b, 0, 0, 0) in
  let _ = a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_mset8(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_mov_imm(b, 2, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 2) in
  let _ = a32_slot(b, nth(insn, 2), false, 2) in
  let _ = a32_asr_imm(b, 2, 2, 1) in
  let _ = a32_add_reg(b, 0, 0, 2) in
  let _ = a32_strb_imm(b, 1, 0, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

let a32_cop_kind(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_mov_imm(b, 1, 1) in
  let _ = a32_and_reg(b, 2, 0, 1) in
  let _ = a32_cmp_imm(b, 2, 0) in
  let j_int = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_cmp_imm(b, 0, 1) in
  let j_nil = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_untag_ptr(b, 0) in
  let _ = a32_ldr_imm(b, 2, 0, 16) in
  let _ = a32_cmp_imm(b, 2, 2) in
  let jk2 = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_cmp_imm(b, 2, 3) in
  let jk3 = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_cmp_imm(b, 2, 4) in
  let jk4 = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_cmp_imm(b, 2, 5) in
  let jk5 = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_cmp_imm(b, 2, 7) in
  let jk7 = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_mov_imm(b, 2, 6) in
  let l_k = bytes_len(b) in
  let _ = a32_patch_bcond(b, jk2, l_k) in
  let _ = a32_patch_bcond(b, jk3, l_k) in
  let _ = a32_patch_bcond(b, jk4, l_k) in
  let _ = a32_patch_bcond(b, jk5, l_k) in
  let _ = a32_patch_bcond(b, jk7, l_k) in
  let _ = a32_lsl1(b, 0, 2) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  let j_done = bytes_len(b) in
  let _ = a32_b(b, 0) in
  let l_int = bytes_len(b) in
  let _ = a32_patch_bcond(b, j_int, l_int) in
  let _ = a32_mov_imm(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  let j_done2 = bytes_len(b) in
  let _ = a32_b(b, 0) in
  let l_nil = bytes_len(b) in
  let _ = a32_patch_bcond(b, j_nil, l_nil) in
  let _ = a32_mov_imm(b, 0, 2) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  let l_done = bytes_len(b) in
  let _ = a32_patch_b24(b, j_done, l_done) in
  let _ = a32_patch_b24(b, j_done2, l_done) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_ld64(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
  let _ = a32_mov_imm(b, 1, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 1) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_asr_imm(b, 1, 1, 1) in
  let _ = a32_add_reg(b, 0, 0, 1) in
  let _ = a32_ldr_imm(b, 0, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_st64(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 3), false, 1) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_mov_imm(b, 2, 0 - 2) in
  let _ = a32_and_reg(b, 0, 0, 2) in
  let _ = a32_slot(b, nth(insn, 2), false, 2) in
  let _ = a32_asr_imm(b, 2, 2, 1) in
  let _ = a32_add_reg(b, 0, 0, 2) in
  let _ = a32_str_imm(b, 1, 0, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
let a32_cop_glob(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let which = nth(insn, 2) in
  let gpos = bytes_len(b) in
  let _ = a32_mov_imm32(b, 0, 0) in
  let _ = a32_ldr_imm(b, 0, 0, 0) in
  let _ = if which == 3 then 0 else if which == 4 then 0 else a32_lsl1(b, 0, 0) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  let gkind =
    if which == 1 then 4
    else if which == 2 then 5
    else if which == 3 then 7
    else 8 in
  emit_st4(st, b, nth(st, 1), nth(st, 2), cons([gkind, gpos], patches))
let a32_cop_gst(st, insn) =
