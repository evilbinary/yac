  let _ = a32_cmp_reg(b, 0, 1) in
  let pt = bytes_len(b) in
  let _ = a32_b_cond(b, a32_cc_of(op), 0) in
  let pf = bytes_len(b) in
  let _ = a32_b(b, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
   cons(["b24", pf, nth(insn, 5)],
        cons(["bcond", pt, nth(insn, 4)], patches)))
let a32_cop_prim_memcpy(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 1), false, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 1) in
  let _ = a32_slot(b, nth(insn, 3), false, 2) in
  let loop = bytes_len(b) in
  let _ = a32_cmp_imm(b, 2, 0) in
  let jeq = bytes_len(b) in
  let _ = a32_b_eq(b, 0) in
  let _ = a32_ldrb_imm(b, 3, 1, 0) in
  let _ = a32_strb_imm(b, 3, 0, 0) in
  let _ = a32_add_imm(b, 0, 0, 1) in
  let _ = a32_add_imm(b, 1, 1, 1) in
  let _ = a32_sub_imm(b, 2, 2, 1) in
  let jb = bytes_len(b) in
  let _ = a32_b(b, 0) in
  let done = bytes_len(b) in
  let _ = a32_patch_bcond(b, jeq, done) in
  let _ = a32_patch_b24(b, jb, loop) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
