  0

/* Register the whole runtime-prim table to the single generic handler. */
let a32_reg_rt =
  let reg(i) =
    if i >= len(emit_rt_ops) then 0
    else
      let _ = emit_reg("arm32", nth(nth(emit_rt_ops, i), 0), a32_op_rt) in
      reg(i + 1) in
  reg(0)

/* ---- resolve + program ---------------------------------------------- */

let a32_lookup_at(labels, name, i) =
  if i < 0 then 0
  else if nth(nth(labels, i), 0) == name then nth(nth(labels, i), 1)
  else a32_lookup_at(labels, name, i - 1)

let a32_lookup(labels, name) = a32_lookup_at(labels, name, len(labels) - 1)

let a32_resolve_fun_patches(b, labels, patches) =
  let n = len(patches) in
  let keep = list_new() in
  let step(i) =
    if i >= n then keep
    else
      let p = nth(patches, i) in
      let tag = nth(p, 0) in
      let _ =
        if is_int(tag) then list_push(keep, p)
        else if tag == "cclab" then
          list_push(keep, ["cclab", nth(p, 1), a32_lookup(labels, nth(p, 2))])
        else
          let pos = nth(p, 1) in
          let targ = a32_lookup(labels, nth(p, 2)) in
          if tag == "beq" or tag == "bcond" then a32_patch_bcond(b, pos, targ)
          else a32_patch_b24(b, pos, targ) in
      step(i + 1) in
  step(0)

let a32_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let offs = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let labels = nth(st, 4) in
  let tag = nth(p, 0) in
  if tag == 1 then
    a32_patch_b24(b, nth(p, 1), nth(offs, nth(p, 2)))
  else if tag == 2 then
    a32_apply_u32(b, nth(p, 1), codebase + nth(offs, nth(p, 2)))
  else if tag == 3 then
    a32_apply_u32(b, nth(p, 1), globbase)
  else if tag == 4 then
    a32_apply_u32(b, nth(p, 1), globbase + 8)
  else if tag == 5 then
    a32_apply_u32(b, nth(p, 1), globbase + 16)
  else if tag == 12 then
    a32_apply_u32(b, nth(p, 1), globbase + nth(p, 2))
  else if tag == 21 then
    a32_apply_u32(b, nth(p, 1), globbase + 136 + bshl(nth(p, 2), 2))
  else if tag == 23 then
    a32_apply_u32(b, globbase - codebase + nth(p, 2) + 16, codebase + nth(offs, nth(p, 1)))
  else if tag == 24 then
    a32_apply_u32(b, globbase - codebase + nth(p, 1), nth(p, 2))
  else
    let pos = nth(p, 1) in
    let lab = nth(p, 2) in
    let targ = a32_lookup(labels, lab) in
    if tag == "beq" then a32_patch_bcond(b, pos, targ)
    else a32_patch_b24(b, pos, targ)

let a32_resolve_loop(st, ps, i) =
  if i >= len(ps) then 0
  else
    let _ = a32_resolve_patch(st, nth(ps, i)) in
    a32_resolve_loop(st, ps, i + 1)

let a32_i_rest(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ = nth(insn, 0) in
  let _ = a32_brk(b) in
  emit_st4(st, b, cur, labels, patches)

let emit_insn_a32(st, insn, is_entry, is_raw) =
  let _ = is_raw in
  let _ = is_entry in
  let r = emit_insn_disp(st, insn) in
  if r != 0 then r else a32_i_rest(st, insn)

let emit_program_arm32(prog, load_vaddr, text_off, fmt) =
  let _ = emit_fmt_set(fmt) in
  let _ =
    emit_abi_win_set(
      if fmt == "pe" then true
      else if load_vaddr == JIT_VADDR then host_os(0) == "windows"
      else false) in
  let _ = strlit_pool_reset(0) in
  let _ = cimport_reset(0) in
  let ckeep = cimport_buf(0) in
  let funs = prof_hook_fix(append(nth(prog, 1), host_unstub_procs(0))) in
  let _ = tcall_tab_set(funs) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let r1 = emit_funs_loop(funs, entry, 0, emit_insn_a32, a32_resolve_fun_patches,
                          no_skip) in
  let out = nth(nth(r1, 0), 0) in
  let offs = nth(r1, 2) in
  let want_asm = asm_dump_get(0) != 0 in
  let _ = if want_asm then asm_dump_set(0) else 0 in
  let _ = if want_asm then asm_dump_procs(out, funs, offs, nfun) else 0 in
  let st = nth(r1, 0) in
  let fo0 = nth(r1, 1) in
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let pad8(_) =
    if band(bytes_len(b), 7) == 0 then 0
    else let _ = bytes_append(b, 0) in pad8(0) in
  let _ = pad8(0) in
  let pool_start = bytes_len(b) in
  let _ = bytes_extend(b, strlit_bytes(0)) in
  let _ = pad8(0) in
  let data_start = bytes_len(b) in
  let _ = emit_glob_data(b) in
  let _ = ckeep in
  let GLOBALS_BASE = load_vaddr + text_off + data_start in
  let _ = host_slot_bake(b, fo0, load_vaddr, text_off, data_start) in
  let extra = list_new() in
  let _ = patches_extend(extra, patches) in
  let rst = [b, offs, load_vaddr + text_off, GLOBALS_BASE, labels,
             load_vaddr + text_off + pool_start, GLOBALS_BASE] in
  let _ = if want_asm then asm_dump_cells(b, data_start, 0) else 0 in
  let _ = emit_unres_set([rst, extra, "arm32"]) in
  let _ = funsym_set(fo0) in
  let _ = yjit_layout_set(pool_start, pool_start, data_start, bytes_len(b)) in
  [b, fo0]
