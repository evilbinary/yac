let a32_sysarg(b, args, j) =
  if j >= len(args) then 0
  else if j >= 6 then 0
  else
    let _ = a32_slot(b, nth(args, j), false, j) in
    a32_sysarg(b, args, j + 1)

let a32_cop_untag(st, insn) =
  let b = nth(st, 0) in
  let _ = a32_slot(b, nth(insn, 2), false, 0) in
