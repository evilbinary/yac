let a32_reg_ops =
  let _ = emit_reg("arm32", "untag", a32_cop_untag) in
  let _ = emit_reg("arm32", "syscall", a32_cop_syscall) in
  let _ = emit_reg("arm32", "$and", a32_cop_prim_and) in
  let _ = emit_reg("arm32", "$addi", a32_cop_prim_addi) in
  let _ = emit_reg("arm32", "$add", a32_cop_prim_add) in
  let _ = emit_reg("arm32", "$sub", a32_cop_prim_sub) in
  let _ = emit_reg("arm32", "$or", a32_cop_prim_or) in
  let _ = emit_reg("arm32", "$shr", a32_cop_prim_shr) in
  let _ = emit_reg("arm32", "$clamp0", a32_cop_prim_clamp0) in
  let _ = emit_reg("arm32", "$st64", a32_cop_prim_st64) in
  let _ = emit_reg("arm32", "$st8", a32_cop_prim_st8) in
  let _ = emit_reg("arm32", "$ld64", a32_cop_prim_ld64) in
  let _ = emit_reg("arm32", "$ld8", a32_cop_prim_ld8) in
  let _ = emit_reg("arm32", "$sp", a32_cop_prim_sp) in
  let _ = emit_reg("arm32", "$fp", a32_cop_prim_fp) in
  let _ = emit_reg("arm32", "$smap", a32_cop_prim_smap) in
  let _ = emit_reg("arm32", "$gbase", a32_cop_prim_gbase) in
  let _ = emit_reg("arm32", "$glob", a32_cop_prim_glob) in
  let _ = emit_reg("arm32", "$icmp", a32_cop_prim_icmp) in
  let _ = emit_reg("arm32", "$jcc", a32_cop_prim_jcc) in
  let _ = emit_reg("arm32", "$memcpy", a32_cop_prim_memcpy) in
  let _ = emit_reg("arm32", "$memset", a32_cop_prim_memset) in
  let _ = emit_reg("arm32", "$carg", a32_cop_prim_carg) in
  let _ = emit_reg("arm32", "$icall", a32_cop_prim_icall) in
  let _ = emit_reg("arm32", "$bts", a32_cop_prim_bts) in
  let _ = emit_reg("arm32", "$bt", a32_cop_prim_bt) in
  let _ = emit_reg("arm32", "kind", a32_cop_kind) in
  let _ = emit_reg("arm32", "ld64", a32_cop_ld64) in
  let _ = emit_reg("arm32", "st64", a32_cop_st64) in
  let _ = emit_reg("arm32", "glob", a32_cop_glob) in
  let _ = emit_reg("arm32", "gst", a32_cop_gst) in
  let _ = emit_reg("arm32", "gvar", a32_cop_gvar) in
  let _ = emit_reg("arm32", "gval", a32_cop_gval) in
  let _ = emit_reg("arm32", "gset", a32_cop_gset) in
  let _ = emit_reg("arm32", "write1", a32_cop_write1) in
  let _ = emit_reg("arm32", "clock", a32_cop_clock) in
  let _ = emit_reg("arm32", "argc", a32_cop_argc) in
  let _ = emit_reg("arm32", "time_ms", a32_cop_time_ms) in
  let _ = emit_reg("arm32", "time_str", a32_cop_time_str) in
  let _ = emit_reg("arm32", "argv", a32_cop_argv) in
  let _ = emit_reg("arm32", "mref", a32_cop_mref) in
  let _ = emit_reg("arm32", "mset", a32_cop_mset) in
  let _ = emit_reg("arm32", "tag", a32_cop_tag) in
  let _ = emit_reg("arm32", "is_int", a32_cop_is_int) in
  let _ = emit_reg("arm32", "alloc", a32_cop_alloc) in
  let _ = emit_reg("arm32", "alloc_s", a32_cop_alloc_s) in
  let _ = emit_reg("arm32", "obj_sti", a32_cop_obj_sti) in
