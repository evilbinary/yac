  let _ = a32_strb_imm(b, 0, 13, 0) in
  let _ = a32_mov_reg(b, 1, 13) in
  let _ = a32_mov_imm(b, 2, 1) in
  let _ = a32_mov_imm(b, 0, 1) in
  let _ = a32_mov_imm(b, 7, 4) in
  let _ = a32_svc(b, 0) in
  let _ = a32_add_imm(b, 13, 13, 16) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
