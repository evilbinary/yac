  let imm = nth(insn, 3) in
  let _ =
    if imm == (0 - 2) then a32_untag_ptr(b, 0)
    else
      let _ = a32_mov_imm32(b, 1, imm) in
      a32_and_reg(b, 0, 0, 1) in
  let _ = a32_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))
