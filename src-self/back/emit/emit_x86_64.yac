/* emit_x86_64.yac — x86-64 emit of LIR.
 *
 * Shared maps/patches: emit.yac. Encoding: encode_x64.yac.
 * Host (ccall / _start / $syscall): linux_x86_64.yac, win_x86_64.yac.
 *
 * Single-pass emission with deferred patch-up. Lengths come from
 * bytes_len before/after, never hand-counted.
 *
 * Slot k -> [rbp - 8*(k+1)]. Never [rbp+0] (saved rbp / _start argc).
 * Entry (_start) sets rbp, no push/pop.
 * Memory ops use disp32 (signed 32), not disp8 — signed imm8 is -128..127
 * and band(_,255) wraps (stack k>=16, closure cap i>=12, sub rsp >127).
 *
 * Program: ["prog", [fun...], entryName]; fun from l_fun in lir.yac.
 * Returns [codeBytes, funOffsets].
 */

let emit_x86_c_marshal(b, args) =
  if emit_host_win(0) then win_cc_marshal(b, args)
  else linux_cc_marshal(b, args)

/* Windows does not commit stack pages skipped by a single sub rsp. */
let emit_chkstk(b, nbytes) =
  if nbytes <= 4096 then sub_rsp_imm32(b, nbytes)
  else
    let _ = mov_r64_imm(b, 3, nbytes) in
    let loop = bytes_len(b) in
    let _ = cmp_rbx_imm32(b, 4096) in
    let jle = bytes_len(b) in
    let _ = jcc_rel32(b, 14, 0) in
    let _ = sub_rsp_imm32(b, 4096) in
    let _ = mov_rax_mem_rsp(b) in
    let _ = sub_rbx_imm32(b, 4096) in
    let _ = jmp_rel32(b, 0) in
    let jback = bytes_len(b) - 4 in
    let _ = apply_patch(b, jback, loop) in
    let done = bytes_len(b) in
    let _ = apply_patch(b, jle + 2, done) in
    sub_rsp_rbx(b)

let emit_x86_iccall(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let dst = nth(insn, 1) in
  let args = nth(insn, 3) in
  let _ = emit_load_rax_slot(b, nth(insn, 2)) in
  let _ = emit_x86_c_untag(b) in
  let _ = mov_r11_rax(b) in
  let _ = emit_x86_c_marshal(b, args) in
  let _ = call_r11(b) in
  let _ = smap_note(bytes_len(b)) in
  let _ = emit_x86_c_unalign(b) in
  let _ = shl_rax_1(b) in
  let _ = emit_store_rax_slot(b, dst) in
  emit_st4(st, b, cur, labels, patches)

let emit_x86_i_core(st, insn, is_entry, is_raw) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "local" or k == "$local" then
    let nlocals = nth(insn, 1) in
    let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
    let noscan =
      if is_raw then true
      else if k == "$local" then true
      else false in
    let _ =
      if noscan then smap_set_nslots(0) else smap_set_nslots(nlocals) in
    /* imm8 for sub rsp is signed; always imm32. */
    if is_entry then
      let pe_ps =
        if emit_host_win(0) then win_entry(b, patches)
        else linux_entry(b, patches) in
      let _ = mov_rax_imm64(b, 0) in
      let ac_save = bytes_len(b) - 8 in
      let _ = mov_mem_rax_rdi(b) in
      let _ = mov_rax_imm64(b, 0) in
      let av_save = bytes_len(b) - 8 in
      let _ = mov_mem_rax_rsi(b) in
      let _ = mov_rbp_rsp(b) in
      let _ = xor_rax_rax(b) in
      let _ = mov_mem_rbp32_r64(b, 0, 0) in
      let _ = mov_rax_imm64(b, 0) in
      let sh_save = bytes_len(b) - 8 in
      let _ = mov_mem_rax_rbp(b) in
      let nbytes = bshl(nlocals + 1, 3) in
      let _ = emit_chkstk(b, nbytes) in
      emit_st4(st, b, cur, labels,
       cons([6, sh_save],
            cons([5, av_save],
                 cons([4, ac_save], pe_ps))))
    else
      let _ = push_rbp(b) in
      let _ = mov_rbp_rsp(b) in
      let nbytes = bshl(nlocals + 1, 3) in
      let _ = emit_chkstk(b, nbytes) in
      let storeparams(j) =
        if j >= nparams then 0
        else if j < 6 then
          let _ = emit_store_param(b, j, j + 1) in
          storeparams(j + 1)
        else
          /* stack arg: [rbp + 16 + 8*(j-6)] */
          let off = 16 + bshl(j - 6, 3) in
          let _ = mov_r64_mem_rbp32(b, 0, off) in
          let _ = emit_store_rax_slot(b, j + 1) in
          storeparams(j + 1) in
      let _ = storeparams(0) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "mov_imm" then
    /* bit pattern already encoded (tagged int or nil=1) */
    let _ = mov_r64_imm64(b, 0, nth(insn, 2)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mov" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if is_arith(k) then
    let dst = nth(insn, 1) in
    let a = nth(insn, 2) in
    let bop = nth(insn, 3) in
    let _ = emit_load_rax_slot(b, a) in
    let _ = sar_rax_1(b) in
    let _ = emit_load_rbx_slot(b, bop) in
    let _ = sar_rbx_1(b) in
    let c =
      if k == "add" then add_rax_rbx(b)
      else if k == "sub" then sub_rax_rbx(b)
      else if k == "mul" then imul_rax_rbx(b)
      else if k == "land" then and_rax_rbx(b)
      else if k == "lor" then or_rax_rbx(b)
      else if k == "xor" then xor_rax_rbx(b)
      else if k == "bnot" then not_rax(b)
      else if k == "shl" or k == "sal" then
        let _ = mov_rcx_rbx(b) in
        shl_rax_cl(b)
      else if k == "shr" or k == "sar" then
        let _ = mov_rcx_rbx(b) in
        shr_rax_cl(b)
      else if k == "div" then
        let _ = cqo(b) in
        idiv_rbx(b)
      else if k == "rem" then
        let _ = cqo(b) in
        let _ = idiv_rbx(b) in
        mov_r64_r64(b, 0, 2)
      else 0 in
    let _ = c in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cmp" then
    let op = nth(insn, 1) in
    let dst = nth(insn, 2) in
    let a = nth(insn, 3) in
    let bop = nth(insn, 4) in
    if (op == "==" or op == "!=") then
      let _ = emit_load_rax_slot(b, a) in
      let _ = push_r64(b, 0) in
      let _ = emit_load_rax_slot(b, bop) in
      let _ = push_r64(b, 0) in
      /* stack: [rsp]=b [rsp+8]=a */
      let _ = mov_rax_mem_rsp8(b) in
      let _ = mov_rbx_mem_rsp(b) in
      let _ = cmp_rax_rbx(b) in
      let _ = jcc_rel32(b, 4, 0) in
      let jptr = bytes_len(b) - 4 in
      let _ = mov_rax_mem_rsp8(b) in
      let _ = cmp_rax_imm8(b, 1) in
      let _ = jcc_rel32(b, 4, 0) in
      let jnil1 = bytes_len(b) - 4 in
      let _ = test_rax_1(b) in
      let _ = jcc_rel32(b, 4, 0) in
      let jz1 = bytes_len(b) - 4 in
      let _ = mov_rax_mem_rsp(b) in
      let _ = cmp_rax_imm8(b, 1) in
      let _ = jcc_rel32(b, 4, 0) in
      let jnil2 = bytes_len(b) - 4 in
      let _ = test_rax_1(b) in
      let _ = jcc_rel32(b, 4, 0) in
      let jz2 = bytes_len(b) - 4 in
      let _ = mov_rax_mem_rsp8(b) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_rax_disp32(b, 16) in
      let _ = cmp_rax_imm8(b, 3) in
      let _ = jcc_rel32(b, 5, 0) in
      let jne1 = bytes_len(b) - 4 in
      let _ = mov_rax_mem_rsp(b) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_rax_disp32(b, 16) in
      let _ = cmp_rax_imm8(b, 3) in
      let _ = jcc_rel32(b, 5, 0) in
      let jne2 = bytes_len(b) - 4 in
      let _ = mov_rax_mem_rsp8(b) in
      let _ = mov_rdi_rax(b) in
      let _ = mov_rax_mem_rsp(b) in
      let _ = mov_rsi_rax(b) in
      let scall = bytes_len(b) in
      let _ = call_user(b) in
      let _ = add_rsp_imm32(b, 16) in
      let _ =
        if op == "!=" then
          let _ = sar_rax_1(b) in
          let _ = e8(b, 72) in let _ = e8(b, 247) in let _ = e8(b, 208) in
          let _ = e8(b, 36) in let _ = e8(b, 1) in
          shl_rax_1(b)
        else 0 in
      let _ = jmp_rel32(b, 0) in
      let jdone = bytes_len(b) - 4 in
      let ptreq = bytes_len(b) in
      let _ = apply_patch(b, jptr, ptreq) in
      let _ = add_rsp_imm32(b, 16) in
      let _ =
        if op == "==" then mov_r64_imm(b, 0, 2)
        else xor_rax_rax(b) in
      let _ = jmp_rel32(b, 0) in
      let jptrdone = bytes_len(b) - 4 in
      let intp = bytes_len(b) in
      let _ = apply_patch(b, jz1, intp) in
      let _ = apply_patch(b, jz2, intp) in
      let _ = apply_patch(b, jnil1, intp) in
      let _ = apply_patch(b, jnil2, intp) in
      let _ = apply_patch(b, jne1, intp) in
      let _ = apply_patch(b, jne2, intp) in
      let _ = mov_rax_mem_rsp8(b) in
      let _ = sar_rax_1(b) in
      let _ = mov_rbx_mem_rsp(b) in
      let _ = sar_rbx_1(b) in
      let _ = cmp_rax_rbx(b) in
      let _ = setcc_r8(b, cc_of(op)) in
      let _ = movzx_eax_al(b) in
      let _ = shl_rax_1(b) in
      let _ = add_rsp_imm32(b, 16) in
      let done = bytes_len(b) in
      let _ = apply_patch(b, jdone, done) in
      let _ = apply_patch(b, jptrdone, done) in
      let _ = emit_store_rax_slot(b, dst) in
      emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, scall + 1, "yac_str_eq"))
    else
      let _ = emit_load_rax_slot(b, a) in
      let _ = sar_rax_1(b) in
      let _ = emit_load_rbx_slot(b, bop) in
      let _ = sar_rbx_1(b) in
      let _ = cmp_rax_rbx(b) in
      let _ = setcc_r8(b, cc_of(op)) in
      let _ = movzx_eax_al(b) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "icmp" then
    let op = nth(insn, 1) in
    let dst = nth(insn, 2) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = sar_rax_1(b) in
    let _ = emit_load_rbx_slot(b, nth(insn, 4)) in
    let _ = sar_rbx_1(b) in
    let _ = cmp_rax_rbx(b) in
    let _ = setcc_r8(b, cc_of(op)) in
    let _ = movzx_eax_al(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "label" then
    let nm = nth(insn, 1) in
    emit_st4(st, b, cur, label_put(labels, nm, cur), patches)
  else if k == "fcall" then
    /* call fn(argSlots...): load args to rdi,rsi,rdx,rcx,r8,r9; call; store. */
    let dst = nth(insn, 1) in
    let fn = nth(insn, 2) in
    let args = nth(insn, 3) in
    let nargs = len(args) in
    let loadarg(j) =
      if j >= nargs then 0
      else
        let _ = emit_load_rax_slot(b, nth(args, j)) in
        let _ =
          if j == 0 then mov_rdi_rax(b)
          else if j == 1 then mov_rsi_rax(b)
          else if j == 2 then mov_rdx_rax(b)
          else if j == 3 then mov_rcx_rax(b)
          else if j == 4 then mov_r8_rax(b)
          else mov_r9_rax(b) in
        loadarg(j + 1) in
    let _ = loadarg(0) in
    let callstart = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, callstart + 1, fn))
  else if k == "ccall" then
    let dst = nth(insn, 1) in
    let fn = nth(insn, 2) in
    let args = nth(insn, 3) in
    let _ = emit_x86_c_marshal(b, args) in
    let callstart = bytes_len(b) in
    let _ = call_rel32(b, 0) in
    let _ = smap_note(bytes_len(b)) in
    let _ = emit_x86_c_unalign(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    let ps =
      if emit_host_win(0) then win_ccall_patch(patches, callstart + 1, fn)
      else linux_ccall_patch(patches, callstart + 1, fn) in
    emit_st4(st, b, cur, labels, ps)
  else if k == "iccall" then emit_x86_iccall(st, insn)
  else if k == "tcall" then
    /* TCO: load args, tear down frame, jmp (no extra stack). */
    let fn = nth(insn, 2) in
    let args = nth(insn, 3) in
    let nargs = len(args) in
    let loadarg(j) =
      if j >= nargs then 0
      else
        let _ = emit_load_rax_slot(b, nth(args, j)) in
        let _ =
          if j == 0 then mov_rdi_rax(b)
          else if j == 1 then mov_rsi_rax(b)
          else if j == 2 then mov_rdx_rax(b)
          else if j == 3 then mov_rcx_rax(b)
          else if j == 4 then mov_r8_rax(b)
          else mov_r9_rax(b) in
        loadarg(j + 1) in
    let _ = loadarg(0) in
    let _ = mov_rsp_rbp(b) in
    let _ = pop_rbp(b) in
    let jmpstart = bytes_len(b) in
    let _ = jmp_rel32(b, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, jmpstart + 1, fn))
  else if k == "jmp" then
    /* jmp_rel32: e9 + rel32; rel32 field at len0+1 */
    let jpos = bytes_len(b) in
    let _ = jmp_rel32(b, 0) in
    emit_st4(st, b, cur, labels, cons([jpos + 1, nth(insn, 1)], patches))
  else if k == "cmpjmp" then
    let cond = nth(insn, 1) in
    let tl = nth(insn, 2) in
    let fl = nth(insn, 3) in
    let _ = emit_load_rax_slot(b, cond) in
    let _ = test_rax_rax(b) in
    let jcc_at = bytes_len(b) in
    let _ = jcc_rel32(b, 4, 0) in  /* 0f 84 + rel32 */
    let jmp_at = bytes_len(b) in
    let _ = jmp_rel32(b, 0) in     /* e9 + rel32 */
    emit_st4(st, b, cur, labels,
     cons([jcc_at + 2, fl], cons([jmp_at + 1, tl], patches)))
  else if k == "ret" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    if is_entry then let _ = ret(b) in emit_st4(st, b, cur, labels, patches)
    else
      let _ = mov_rsp_rbp(b) in
      let _ = pop_rbp(b) in
      let _ = ret(b) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "exit" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = sar_rax_1(b) in
    if emit_host_win(0) then win_exit(st, patches)
    else linux_exit(st, patches)
  else st

let emit_x86_i_sys(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  if nth(insn, 0) == "untag" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = sar_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if emit_host_win(0) then win_num_syscall(st, insn)
  else linux_num_syscall(st, insn)

let emit_x86_i_raw(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "$and" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let imm = nth(insn, 3) in
    let _ =
      if imm == (0 - 2) then and_rax_1(b)
      else if imm >= (0 - 128) and imm <= 127 then and_rax_imm8(b, imm)
      else and_eax_imm32(b, imm) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$addi" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = add_rax_imm32(b, nth(insn, 3)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$add" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = emit_load_rbx_slot(b, nth(insn, 3)) in
    let _ = add_rax_rbx(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sub" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = emit_load_rbx_slot(b, nth(insn, 3)) in
    let _ = sub_rax_rbx(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bts" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = mov_rdx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rcx_rax(b) in
    let _ = bts_mem_rdx_rcx(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bt" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rcx_rax(b) in
    let _ = bt_mem_rdx_rcx(b) in
    let _ = setcc_r8(b, 2) in
    let _ = movzx_eax_al(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$or" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$clamp0" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = test_rax_rax(b) in
    let _ = jcc_rel32(b, 9, 0) in
    let pns = bytes_len(b) - 4 in
    let _ = xor_rax_rax(b) in
    let _ = apply_patch(b, pns, bytes_len(b)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st64" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
    let _ = mov_rax_disp32_rdi(b, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st8" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = mov_rax_disp32_imm8(b, nth(insn, 2), nth(insn, 3)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld64" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_rax_disp32(b, nth(insn, 3)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld8" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = movzx_eax_rax_disp32(b, nth(insn, 3)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sp" then
    let _ = mov_rax_rsp(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$fp" then
    let _ = mov_rax_rbp(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$smap" then
    let _ = mov_rax_imm64(b, 0) in
    let spat = bytes_len(b) - 8 in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, cons([14, spat], patches))
  else if k == "$gbase" then
    let _ = mov_rax_imm64(b, 0) in
    let gpat = bytes_len(b) - 8 in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, cons([3, gpat], patches))
  else if k == "$glob" then
    let which = nth(insn, 2) in
    let _ = mov_rax_imm64(b, 0) in
    let gpat = bytes_len(b) - 8 in
    let _ = mov_rax_mem_rax(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpat], patches))
  else if k == "$icmp" then
    let op = nth(insn, 1) in
    let cc = if op == ">=u" then 3 else if op == "==" then 4 else if op == "<" then 12 else 5 in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = emit_load_rbx_slot(b, nth(insn, 4)) in
    let _ = cmp_rax_rbx(b) in
    let _ = setcc_r8(b, cc) in
    let _ = movzx_eax_al(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$jcc" then
    let op = nth(insn, 1) in
    let cc = if op == ">=u" then 3 else if op == "==" then 4 else if op == "<" then 12 else 5 in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = emit_load_rbx_slot(b, nth(insn, 3)) in
    let _ = cmp_rax_rbx(b) in
    let jcc_at = bytes_len(b) in
    let _ = jcc_rel32(b, cc, 0) in
    let jmp_at = bytes_len(b) in
    let _ = jmp_rel32(b, 0) in
    emit_st4(st, b, cur, labels,
     cons([jcc_at + 2, nth(insn, 4)], cons([jmp_at + 1, nth(insn, 5)], patches)))
  else if k == "$memcpy" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rsi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rcx_rax(b) in
    let _ = cld(b) in
    let _ = rep_movsb(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$memset" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rcx_rax(b) in
    let _ = xor_rax_rax(b) in
    let _ = cld(b) in
    let _ = rep_stosb(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$lea" then
    let _ = emit_lea_rax_slot(b, nth(insn, 2)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$shr" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = shr_rax_imm8(b, nth(insn, 3)) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$carg" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rax_to_argreg(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$icall" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rbx_rax(b) in
    let _ = call_rbx_user(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if emit_host_win(0) then win_syscall(st, insn)
  else linux_syscall(st, insn)

let emit_x86_i_heap(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "obj_kind" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_rax_disp32(b, 16) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mref" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_rax_disp32(b, nth(insn, 3)) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset" then
    let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_disp32_rdi(b, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "tag" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "is_int" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = test_rax_1(b) in
    let _ = setcc_r8(b, cc_of("==")) in
    let _ = movzx_eax_al(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "alloc" then
    let _ = mov_rdi_imm(b, nth(insn, 2)) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_alloc"))
  else if k == "obj_sti" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_disp32_imm32(b, nth(insn, 2), nth(insn, 3)) in
    let _ = mov_rax_disp32_imm32(b, nth(insn, 2) + 4, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "obj_st_int" then
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = sar_rax_1(b) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_disp32_rdi(b, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "alloc_s" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = sar_rax_1(b) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_alloc"))
  else if k == "mref8" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rdx_rax(b) in
    let _ = sar_rdx_1(b) in
    let _ = mov_rax_rbx(b) in
    let _ = movzx_eax_rax_rdx(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset8" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdx_rax(b) in
    let _ = sar_rdx_1(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rdi_rax(b) in
    let _ = sar_rdi_1(b) in
    let _ = mov_rax_rbx(b) in
    let _ = mov_rax_rdx_dil(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "ld64" then
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rdx_rax(b) in
    let _ = sar_rdx_1(b) in
    let _ = mov_rax_rbx(b) in
    let _ = mov_rax_mem_rax_rdx(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "st64" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdx_rax(b) in
    let _ = sar_rdx_1(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_mem_rbx_rdx_rax(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "write1" then
    if emit_host_win(0) then win_write1(st, insn)
    else linux_write1(st, insn)
  else if k == "clock" then
    if emit_host_win(0) then win_clock(st, insn)
    else linux_clock(st, insn)
  else if k == "glob" then
    let which = nth(insn, 2) in
    let _ = mov_rax_imm64(b, 0) in
    let gpat = bytes_len(b) - 8 in
    let _ = mov_rax_mem_rax(b) in
    let _ = if which == 3 then 0 else if which == 4 then 0 else shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpat], patches))
  else if k == "gst" then
    let which = nth(insn, 1) in
    let _ = mov_rax_imm64(b, 0) in
    let gpat = bytes_len(b) - 8 in
    let _ = emit_load_rdi_slot(b, nth(insn, 2)) in
    let _ = mov_mem_rax_rdi(b) in
    let gkind = if which == 3 then 7 else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpat], patches))
  else if k == "time_ms" then
    let dst = nth(insn, 1) in
    let callstart = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, callstart + 1, "time_ms"))
  else if k == "time_str" then
    let dst = nth(insn, 1) in
    let callstart = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, callstart + 1, "time_str"))
  else if k == "argc" then
    let dst = nth(insn, 1) in
    let callstart = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, callstart + 1, "yac_argc"))
  else if k == "argv" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let callstart = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, callstart + 1, "yac_argv"))
  else st

let emit_x86_i_clos(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "closure" then
    /* closure dst fnName [capSlots]:
     * alloc object [next][mark][fnptr][nenv][env...], tag, store.
     * yac_alloc links the object into the global GC list (sets [next]).
     * Offsets: next=0 mark=8 fnptr=16 nenv=24 env=32. */
    let dst = nth(insn, 1) in
    let fnName = nth(insn, 2) in
    let caps = nth(insn, 3) in
    let nenv = len(caps) in
    let size = clos_bytes(nenv) in
    let _ = mov_rdi_imm(b, size) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = and_rax_1(b) in    /* alloc returns raw ptr; ensure untagged */
    let _ = mov_rax_disp32_imm32(b, 8, 0) in   /* mark = 0 */
    let _ = mov_rax_disp32_imm32(b, 16, 0) in  /* fnptr placeholder */
    let fnpos = bytes_len(b) - 4 in
    let _ = mov_rax_disp32_imm32(b, 20, 0) in  /* high 32 of fnptr (must be 0) */
    let _ = mov_rax_disp32_imm32(b, 24, nenv) in
    let _ = mov_rax_disp32_imm32(b, 28, 0) in  /* clear high dword of nenv qword */
    let storecap(i) =
      if i >= nenv then 0
      else
        let _ = emit_load_rdi_slot(b, nth(caps, i)) in
        let _ = emit_obj_store_rdi(b, 32 + i * 8) in
        storecap(i + 1) in
    let _ = storecap(0) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels,
     emit_patch_rel(nth(st, 4), emit_patch_clos(nth(st, 4), patches, fnpos, fnName), acall + 1, "yac_alloc"))
  else if k == "apply" or k == "icall" then
    /* apply dst clos ncap [args]  |  icall dst clos [args] (ncap = -1) */
    let dst = nth(insn, 1) in
    let clos = nth(insn, 2) in
    let ncap = apply_ncap(insn) in
    let args = apply_args(insn) in
    let nargs = len(args) in
    if ncap >= 0 then
      let ntot = ncap + nargs in
      let nstack = if ntot > 6 then ntot - 6 else 0 in
      /* push stack args (indices ntot-1 .. 6), reloading clos as needed */
      let push_flat(i) =
        if i < 6 then 0
        else
          let _ =
            if i < ncap then
              let _ = emit_load_rax_slot(b, clos) in
              let _ = and_rax_1(b) in
              let _ = emit_obj_load_rax(b, 32 + i * 8) in
              push_r64(b, 0)
            else
              let _ = emit_load_rax_slot(b, nth(args, i - ncap)) in
              push_r64(b, 0) in
          push_flat(i - 1) in
      let _ = push_flat(ntot - 1) in
      let _ = emit_load_rax_slot(b, clos) in
      let _ = and_rax_1(b) in
      let _ = mov_rbx_rax_disp32(b, 16) in
      let _ = push_r64(b, 3) in
      let nreg = if ntot < 6 then ntot else 6 in
      let load_reg(i) =
        if i >= nreg then 0
        else if i < ncap then
          let _ = emit_load_rax_slot(b, clos) in
          let _ = and_rax_1(b) in
          let _ = emit_obj_load_argreg(b, i, 32 + i * 8) in
          load_reg(i + 1)
        else
          let _ = emit_load_rax_slot(b, nth(args, i - ncap)) in
          let _ = mov_rax_to_argreg(b, i) in
          load_reg(i + 1) in
      let _ = load_reg(0) in
      let _ = pop_r64(b, 3) in
      let _ = call_rbx_user(b) in
      let _ =
        if nstack == 0 then 0
        else add_rsp_imm32(b, bshl(nstack, 3)) in
      let _ = emit_store_rax_slot(b, dst) in
      emit_st4(st, b, cur, labels, patches)
    else
      /* dynamic nenv: build jump table and patch local labels immediately */
      let nargs = len(args) in
      let pushargs(j) =
        if j < 0 then 0
        else
          let _ = emit_load_rax_slot(b, nth(args, j)) in
          let _ = push_r64(b, 0) in
          pushargs(j - 1) in
      let _ = pushargs(nargs - 1) in
      let _ = emit_load_rax_slot(b, clos) in
      let _ = and_rax_1(b) in
      let _ = mov_rbx_rax_disp32(b, 16) in
      let _ = mov_r11d_rax_disp32(b, 24) in
      let loadcap(i) =
        if i >= 6 then 0
        else
          let _ = cmp_r11_imm8(b, i) in
          let _ = e8(b, 126) in
          let offpos = bytes_len(b) in
          let _ = e8(b, 0) in
          let m0 = bytes_len(b) in
          let _ = emit_obj_load_argreg(b, i, 32 + i * 8) in
          let m1 = bytes_len(b) in
          let _ = bytes_put(b, offpos, m1 - m0) in
          loadcap(i + 1) in
      let _ = loadcap(0) in
      /* record je/jmp patch sites (rel32 field positions) */
      let _ = cmp_r11_imm8(b, 0) in
      let _ = jcc_rel32(b, 4, 0) in
      let r0 = bytes_len(b) - 4 in
      let _ = cmp_r11_imm8(b, 1) in
      let _ = jcc_rel32(b, 4, 0) in
      let r1 = bytes_len(b) - 4 in
      let _ = cmp_r11_imm8(b, 2) in
      let _ = jcc_rel32(b, 4, 0) in
      let r2 = bytes_len(b) - 4 in
      let _ = cmp_r11_imm8(b, 3) in
      let _ = jcc_rel32(b, 4, 0) in
      let r3 = bytes_len(b) - 4 in
      let _ = cmp_r11_imm8(b, 4) in
      let _ = jcc_rel32(b, 4, 0) in
      let r4 = bytes_len(b) - 4 in
      let _ = jmp_rel32(b, 0) in
      let r5 = bytes_len(b) - 4 in
      let popusers(base) =
        let loop(j) =
          if j >= nargs then 0
          else
            let _ = pop_argreg(b, base + j) in
            loop(j + 1) in
        loop(0) in
      /* arms: pop then jmp to LC; record arm starts and jmp sites */
      let a0 = bytes_len(b) in
      let _ = popusers(0) in
      let _ = jmp_rel32(b, 0) in
      let j0 = bytes_len(b) - 4 in
      let a1 = bytes_len(b) in
      let _ = popusers(1) in
      let _ = jmp_rel32(b, 0) in
      let j1 = bytes_len(b) - 4 in
      let a2 = bytes_len(b) in
      let _ = popusers(2) in
      let _ = jmp_rel32(b, 0) in
      let j2 = bytes_len(b) - 4 in
      let a3 = bytes_len(b) in
      let _ = popusers(3) in
      let _ = jmp_rel32(b, 0) in
      let j3 = bytes_len(b) - 4 in
      let a4 = bytes_len(b) in
      let _ = popusers(4) in
      let _ = jmp_rel32(b, 0) in
      let j4 = bytes_len(b) - 4 in
      let a5 = bytes_len(b) in
      let _ = popusers(5) in
      let _ = jmp_rel32(b, 0) in
      let j5 = bytes_len(b) - 4 in
      let lc = bytes_len(b) in
      let _ = call_rbx_user(b) in
      let _ = emit_store_rax_slot(b, dst) in
      /* patch all local rel32s now */
      let _ = apply_patch(b, r0, a0) in
      let _ = apply_patch(b, r1, a1) in
      let _ = apply_patch(b, r2, a2) in
      let _ = apply_patch(b, r3, a3) in
      let _ = apply_patch(b, r4, a4) in
      let _ = apply_patch(b, r5, a5) in
      let _ = apply_patch(b, j0, lc) in
      let _ = apply_patch(b, j1, lc) in
      let _ = apply_patch(b, j2, lc) in
      let _ = apply_patch(b, j3, lc) in
      let _ = apply_patch(b, j4, lc) in
      let _ = apply_patch(b, j5, lc) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "tailapply" or k == "ticall" then
    let clos = nth(insn, 2) in
    let ncap = apply_ncap(insn) in
    let args = apply_args(insn) in
    let nargs = len(args) in
    let ntot = ncap + nargs in
    let nreg = if ntot < 6 then ntot else 6 in
    let _ = emit_load_rax_slot(b, clos) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax_disp32(b, 16) in
    let load_reg(i) =
      if i >= nreg then 0
      else if i < ncap then
        let _ = emit_load_rax_slot(b, clos) in
        let _ = and_rax_1(b) in
        let _ = emit_obj_load_argreg(b, i, 32 + i * 8) in
        load_reg(i + 1)
      else
        let _ = emit_load_rax_slot(b, nth(args, i - ncap)) in
        let _ = mov_rax_to_argreg(b, i) in
        load_reg(i + 1) in
    let _ = load_reg(0) in
    let _ = mov_rsp_rbp(b) in
    let _ = pop_rbp(b) in
    let _ = jmp_rbx(b) in
    emit_st4(st, b, cur, labels, patches)
  else st

let emit_x86_i_prim(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "nil" then
    /* nil = tagged null = 1 */
    let _ = mov_r64_imm(b, 0, 1) in
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cons" then
    /* cons dst head tail: alloc [next][mark][kind=2][head][tail] */
    let dst = nth(insn, 1) in
    let hd = nth(insn, 2) in
    let tl = nth(insn, 3) in
    let _ = mov_rdi_imm(b, 40) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_disp32_imm32(b, 8, 0) in    /* mark */
    let _ = mov_rax_disp32_imm32(b, 16, 2) in   /* kind = LIST */
    let _ = mov_rax_disp32_imm32(b, 20, 0) in
    let _ = emit_load_rdi_slot(b, hd) in
    let _ = mov_rax_disp32_rdi(b, 24) in
    let _ = emit_load_rdi_slot(b, tl) in
    let _ = mov_rax_disp32_rdi(b, 32) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_alloc"))
  else if k == "len" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_len"))
  else if k == "nth" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_nth"))
  else if k == "tail" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_tail"))
  else if k == "append" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_append"))
  else if k == "list_rev" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_list_rev"))
  else if k == "list_new" then
    let dst = nth(insn, 1) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_list_new"))
  else if k == "list_push" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_list_push"))
  else if k == "strlit" then
    /* Pooled STR in the image: one object per unique content. */
    let dst = nth(insn, 1) in
    let off = strlit_off(nth(insn, 2)) in
    let _ = mov_rax_imm64(b, 0) in
    let ipos = bytes_len(b) - 8 in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_strlit(patches, ipos, off))
  else if k == "str_len" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = test_rax_rax(b) in
    let _ = jcc_rel32(b, 4, 0) in
    let jz0 = bytes_len(b) - 4 in
    let _ = cmp_rax_imm8(b, 1) in
    let _ = jcc_rel32(b, 4, 0) in
    let jnil = bytes_len(b) - 4 in
    let _ = and_rax_1(b) in
    let _ = mov_rax_rax_disp32(b, 24) in
    let _ = shl_rax_1(b) in
    let _ = jmp_rel32(b, 0) in
    let jdone = bytes_len(b) - 4 in
    let zlen = bytes_len(b) in
    let _ = apply_patch(b, jz0, zlen) in
    let _ = apply_patch(b, jnil, zlen) in
    let _ = xor_rax_rax(b) in
    let done = bytes_len(b) in
    let _ = apply_patch(b, jdone, done) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "str_ref" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
    let _ = mov_r64_r64(b, 2, 7) in
    let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 250) in
    let _ = add_rax_imm32(b, 32) in
    let _ = movzx_eax_rax_rdx(b) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_new" then
    let dst = nth(insn, 1) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_new"))
  else if k == "bytes_len" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_rax_disp32(b, 24) in
    let _ = shl_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_ref" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_ref"))
  else if k == "bytes_put" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 4)) in
    let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_put"))
  else if k == "bytes_append" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_append"))
  else if k == "bytes_extend" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_extend"))
  else if k == "str_cat" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_str_cat"))
  else if k == "str_slice" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 4)) in
    let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_str_slice"))
  else if k == "int_to_str" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_int_to_str"))
  else if k == "bytes_to_str" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_bytes_to_str"))
  else if k == "drop" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_drop"))
  else if k == "foldl" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 4)) in
    let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_foldl"))
  else if k == "map" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_map"))
  else if k == "read_file" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_read_file"))
  else if k == "write_file" then
    let dst = nth(insn, 1) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rdi_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 3)) in
    let _ = mov_rsi_rax(b) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall + 1, "yac_write_file"))
  else st

/* memcpy dst doff src soff n: copy n bytes (tagged ints) between objects. */
let emit_x86_i_memcpy(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ = emit_load_rax_slot(b, nth(insn, 1)) in
  let _ = and_rax_1(b) in
  let _ = mov_rdi_rax(b) in
  let _ = emit_load_rax_slot(b, nth(insn, 2)) in
  let _ = sar_rax_1(b) in
  let _ = add_rdi_rax(b) in
  let _ = emit_load_rax_slot(b, nth(insn, 3)) in
  let _ = and_rax_1(b) in
  let _ = mov_rsi_rax(b) in
  let _ = emit_load_rax_slot(b, nth(insn, 4)) in
  let _ = sar_rax_1(b) in
  let _ = add_rsi_rax(b) in
  let _ = emit_load_rax_slot(b, nth(insn, 5)) in
  let _ = sar_rax_1(b) in
  let _ = mov_rcx_rax(b) in
  let _ = cld(b) in
  let _ = rep_movsb(b) in
  emit_st4(st, b, cur, labels, patches)

let emit_x86_i_cc(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "mkcont" then
    let dst = nth(insn, 1) in
    let lab = nth(insn, 2) in
    let _ = mov_rdi_imm(b, 48) in
    let acall = bytes_len(b) in
    let _ = call_user(b) in
    let _ = and_rax_1(b) in
    let _ = mov_rax_disp32_imm32(b, 8, 0) in
    let _ = mov_rax_disp32_imm32(b, 12, 0) in
    let _ = mov_rax_disp32_imm32(b, 16, 6) in
    let _ = mov_rax_disp32_imm32(b, 20, 0) in
    let _ = mov_rbx_rax(b) in
    let _ = mov_rax_rbp(b) in
    let _ = mov_mem_rbx_disp32_rax(b, 24) in
    let _ = mov_rax_rsp(b) in
    let _ = mov_mem_rbx_disp32_rax(b, 32) in
    let _ = lea_rax_rip(b) in
    let lpos = bytes_len(b) - 4 in
    let _ = mov_mem_rbx_disp32_rax(b, 40) in
    let _ = mov_rax_rbx(b) in
    let _ = or_rax_1(b) in
    let _ = emit_store_rax_slot(b, dst) in
    emit_st4(st, b, cur, labels,
      emit_patch_rel(nth(st, 4), cons([lpos, lab], patches), acall + 1, "yac_alloc"))
  else if k == "throwk" then
    let _ = emit_load_rax_slot(b, nth(insn, 1)) in
    let _ = and_rax_1(b) in
    let _ = mov_rbx_rax(b) in
    let _ = emit_load_rax_slot(b, nth(insn, 2)) in
    let _ = mov_rbp_rbx_disp32(b, 24) in
    let _ = mov_rsp_rbx_disp32(b, 32) in
    let _ = jmp_mem_rbx_disp32(b, 40) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cc_recv" then
    let _ = emit_store_rax_slot(b, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else st

/* emit one instruction; st = [bytes, cur, labelsRev, patchesRev, funIds].
 * Helpers keep this frame small (huge emit_insn miscompiles under L5). */
let emit_insn_go(st, insn, is_entry, is_raw) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let k = nth(insn, 0) in
  let len0 = bytes_len(b) in
  let done =
    if k == "closure" or k == "apply" or k == "icall"
         or k == "tailapply" or k == "ticall" then
      emit_x86_i_clos(st, insn, is_entry)
    else if is_frame_op(k) or k == "mov_imm" or k == "mov" or is_arith(k)
         or k == "cmp" or k == "icmp" or k == "label" or k == "fcall" or k == "ccall"
         or k == "iccall" or k == "tcall" or k == "jmp" or k == "cmpjmp" or k == "ret"
         or k == "exit" then
      emit_x86_i_core(st, insn, is_entry, is_raw)
    else if k == "untag" or k == "syscall" then
      emit_x86_i_sys(st, insn)
    else if is_raw_op(k) then
      emit_x86_i_raw(st, insn)
    else if k == "obj_kind" or k == "mref" or k == "mset" or k == "tag"
         or k == "is_int" or k == "alloc" or k == "obj_sti" or k == "obj_st_int"
         or k == "alloc_s" or k == "mref8" or k == "mset8" or k == "ld64" or k == "st64"
         or k == "write1" or k == "clock" or k == "glob" or k == "gst" or k == "time_ms"
         or k == "time_str" or k == "argc" or k == "argv" then
      emit_x86_i_heap(st, insn)
    else if k == "memcpy" then emit_x86_i_memcpy(st, insn)
    else if k == "mkcont" or k == "throwk" or k == "cc_recv" then
      emit_x86_i_cc(st, insn)
    else emit_x86_i_prim(st, insn) in
  let newlen = bytes_len(nth(done, 0)) in
  [nth(done, 0), cur + (newlen - len0), nth(done, 2), nth(done, 3), nth(done, 4)]

let emit_insn(st, insn, is_entry, is_raw) =
  emit_insn_go(st, insn, is_entry, is_raw)


let resolve_local_labels(b, labels, patches) =
  let n = len(patches) in
  let keep = list_new() in
  let step(i) =
    if i >= n then keep
    else
      let p = nth(patches, i) in
      let _ =
        if len(p) >= 3 then list_push(keep, p)
        else if label_has(labels, nth(p, 1)) then
          apply_patch(b, nth(p, 0), lookup_name(labels, nth(p, 1)))
        else list_push(keep, p) in
      step(i + 1) in
  step(0)

let emit_program_x86_64(prog, load_vaddr, text_off, fmt) =
  let _ = emit_fmt_set(fmt) in
  let _ = strlit_pool_reset(0) in
  let _ = smap_reset(0) in
  let _ = cimport_reset(0) in
  let _ = box_set(pe_uname_off_box, 0) in
  let _ = box_set(pe_dlsym_off_box, 0) in
  let _ = box_set(pe_system_off_box, 0) in
  let _ = if emit_host_win(0) then win_begin(0) else linux_begin(0) in
  let ckeep = cimport_buf(0) in
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let _ = log_i("emit", "nfun", nfun) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let ids = emit_ids_new(funs) in
  let offs = list_new() in
  /* [code, cur, labels, globalPatches, ids]. Per-fun patches start empty so
   * resolve_local_labels is O(patches_in_fun), not O(total_patches). */
  let glob = [out, 0, [], list_new(), ids] in
  let funOffsRev = [] in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let _ =
        if i == 0 or ((i % 20) == 0) then log_i("emit", "fun", i) else 0 in
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      /* Kernel process ABI (argc/argv on the stack, no call frame).
       * That's whoever prog[2] names — often _start, not a hard-coded name.
       * A JIT callable (_eval) must not be prog[2], or call/ret would break. */
      let is_entry = name == entry in
      let fstart = nth(st, 1) in
      let st0 = [nth(st, 0), nth(st, 1), [], [], nth(st, 4)] in
      let insns = nth(f, 4) in
      if len(insns) == 0 then
        let _ = list_push(offs, 0) in
        emit_fun(i + 1, st, fo)
      else
        let _ = list_push(offs, fstart) in
        let run(j, s) =
        if j >= len(insns) then s
        else run(j + 1, emit_insn(s, nth(insns, j), is_entry, fun_is_raw(f))) in
      let s1 = run(0, st0) in
      let b = nth(s1, 0) in
      let kept = resolve_local_labels(b, nth(s1, 2), nth(s1, 3)) in
      let _ = patches_extend(nth(st, 3), kept) in
      let s2 = [b, nth(s1, 1), [], nth(st, 3), nth(st, 4)] in
      emit_fun(i + 1, s2, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, glob, []) in
  let _ = log("emit", "funs done") in
  let st = nth(r1, 0) in
  let funOffsRev = nth(r1, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let b = nth(st, 0) in
  let LOAD_VADDR = load_vaddr in
  let TEXT_OFF = text_off in
  /* writable globals: gc_head, argc, argv, stack_hi, gc_free, alloc_bump, heap_lo, prof_st, gc_bm, gc_hi, gc_bmlo, gc_bmsz, arena_cur, arena_end. */
  let pad8(_) =
    if band(bytes_len(b), 7) == 0 then 0
    else let _ = bytes_append(b, 0) in pad8(0) in
  let _ = pad8(0) in
  let pool_start = bytes_len(b) in
  let _ = bytes_extend(b, strlit_bytes(0)) in
  let _ = pad8(0) in
  let extra = list_new() in
  let smap_start = smap_emit_table(b, extra) in
  let _ = pad8(0) in
  let data_start = bytes_len(b) in
  let fill_data(i) =
    if i >= 112 then 0
    else let _ = bytes_append(b, 0) in fill_data(i + 1) in
  let _ = fill_data(0) in
  let _ = emit_cplt(b) in
  let _ =
    if emit_host_win(0) then win_finish(b, extra)
    else linux_finish(b, extra) in
  let _ = ckeep in
  let GLOBALS_BASE = LOAD_VADDR + TEXT_OFF + data_start in
  let _ = patches_extend(extra, patches) in
  let _ = log("emit", "resolve") in
  let _ = emit_resolve_loop([b, offs, LOAD_VADDR + TEXT_OFF, GLOBALS_BASE,
                             LOAD_VADDR + TEXT_OFF + pool_start, smap_start], extra, 0, len(extra)) in
  let _ = log_i("emit", "code_len", bytes_len(b)) in
  let _ = log("emit", "done") in
  let _ = funsym_set(funOffsRev) in
  [b, funOffsRev]

let emit_program(prog) = emit_program_x86_64(prog, 4194304, 120, "elf")
