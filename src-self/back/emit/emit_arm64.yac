/* emit_arm64.yac — Linux AArch64 emit of integer LIR (tagged like x86).
 * Other LIR ops emit BRK. Pack/target still choose ELF/PE/Mach-O.
 */

let a64_frame_bytes(nlocals) =
  let nbytes = bshl(nlocals + 1, 3) in
  bshl(bshr(nbytes + 15, 4), 4)

let a64_tag(b, rd) =
  let _ = a64_movz(b, 9, 1, 0) in
  a64_orr_reg(b, rd, rd, 9)

let a64_untag_ptr(b, rd) =
  let _ = a64_mov_imm64(b, 10, 0 - 2) in
  a64_and_reg(b, rd, rd, 10)

let a64_apply_b26(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 335544320 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

/* yac_alloc is rt_alloc_ins ($proc / $local). */


let a64_slot(b, slot, store, rt) =
  let off = bshl(slot + 1, 3) in
  let _ = a64_sub_imm(b, 9, 29, off) in
  if store then a64_stur(b, rt, 9, 0) else a64_ldur(b, rt, 9, 0)

let a64_apply_bl(b, pos, target) =
  let rel = bshr(target - pos, 2) in
  let w = 2483027968 + band(rel, 67108863) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let a64_bl_rt(b, patches, dst, name, ids) =
  let pos = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_slot(b, dst, true, 0) in
  emit_patch_rel(ids, patches, pos, name)

let a64_enter(b, n) =
  let _ = a64_stp_fp_lr(b) in
  let _ = a64_mov_sp(b, 29, 31) in
  a64_sub_imm(b, 31, 31, n)

let a64_leave(b) =
  let _ = a64_mov_sp(b, 31, 29) in
  let _ = a64_ldp_fp_lr(b) in
  a64_ret(b)

let a64_clamp0(b) =
  let _ = a64_cmp_reg(b, 0, 31) in
  let p = bytes_len(b) in
  let _ = a64_b_cond(b, 10, 0) in
  let _ = a64_movz(b, 0, 0, 0) in
  a64_patch_bcond(b, p, bytes_len(b))

/* yac_read_file is rt_read_file_ins ($proc / $local). */


/* yac_apply1 / yac_apply2 are rt_apply*_ins ($proc / $local). */


/* yac_system is rt_system_ins ($proc / $local). */


/* yac_argv is rt_argv_ins ($proc / $local). */


/* x0,x1 already untagged ints; tagged 0/2 in x0. */
let a64_cmp_int(b, op) =
  let _ = a64_cmp_reg(b, 0, 1) in
  let _ = a64_movz(b, 0, 0, 0) in
  let _ = a64_movz(b, 2, 1, 0) in
  let cc =
    if op == "==" then 1
    else if op == "!=" then 0
    else if op == "<" then 10
    else if op == "<=" then 12
    else if op == ">" then 13
    else if op == ">=" then 11
    else 1 in
  let _ = a64_b_cond(b, cc, 2) in
  let _ = a64_mov_reg(b, 0, 2) in
  a64_lsl1(b, 0, 0)

/* cmp ==/!=: both STR (kind 3) -> yac_str_eq; else integer. */
let a64_cmp_maybe_str(b, op, patches, ids) =
  let _ = a64_sub_imm(b, 31, 31, 16) in
  let _ = a64_stur(b, 0, 31, 0) in
  let _ = a64_stur(b, 1, 31, 8) in
  let _ = a64_cmp_imm(b, 0, 1) in
  let jnil1 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_movz(b, 9, 1, 0) in
  let _ = a64_and_reg(b, 10, 0, 9) in
  let _ = a64_cmp_reg(b, 10, 31) in
  let jz1 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_cmp_imm(b, 1, 1) in
  let jnil2 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_and_reg(b, 10, 1, 9) in
  let _ = a64_cmp_reg(b, 10, 31) in
  let jz2 = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_ldur(b, 2, 0, 16) in
  let _ = a64_cmp_imm(b, 2, 3) in
  let jne1 = bytes_len(b) in
  let _ = a64_b_ne(b, 0) in
  let _ = a64_ldur(b, 0, 31, 8) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_ldur(b, 2, 0, 16) in
  let _ = a64_cmp_imm(b, 2, 3) in
  let jne2 = bytes_len(b) in
  let _ = a64_b_ne(b, 0) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_ldur(b, 1, 31, 8) in
  let scall = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_add_imm(b, 31, 31, 16) in
  let _ =
    if op == "!=" then
      let _ = a64_asr1(b, 0, 0) in
      let _ = a64_movz(b, 9, 1, 0) in
      let _ = a64_eor_reg(b, 0, 0, 9) in
      a64_lsl1(b, 0, 0)
    else 0 in
  let jdone = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let intp = bytes_len(b) in
  let _ = a64_patch_bcond(b, jnil1, intp) in
  let _ = a64_patch_bcond(b, jz1, intp) in
  let _ = a64_patch_bcond(b, jnil2, intp) in
  let _ = a64_patch_bcond(b, jz2, intp) in
  let _ = a64_patch_bcond(b, jne1, intp) in
  let _ = a64_patch_bcond(b, jne2, intp) in
  let _ = a64_ldur(b, 0, 31, 0) in
  let _ = a64_ldur(b, 1, 31, 8) in
  let _ = a64_add_imm(b, 31, 31, 16) in
  let _ = a64_asr1(b, 0, 0) in
  let _ = a64_asr1(b, 1, 1) in
  let _ = a64_cmp_int(b, op) in
  let _ = a64_apply_b26(b, jdone, bytes_len(b)) in
  emit_patch_rel(ids, patches, scall, "yac_str_eq")

/* C ABI ccall/iccall for arm64 and riscv64. Kept out of emit_*_i_core. */

/* Untag C arg in rd (not x9/x10). Int → asr 1; heap ptr → +32. */
let emit_a64_c_untag(b, rd) =
  let _ = a64_movz(b, 9, 1, 0) in
  let _ = a64_and_reg(b, 10, rd, 9) in
  let _ = a64_cmp_imm(b, 10, 0) in
  let peq = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_untag_ptr(b, rd) in
  let _ = a64_add_imm(b, rd, rd, 32) in
  let pjmp = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let intp = bytes_len(b) in
  let _ = a64_patch_bcond(b, peq, intp) in
  let _ = a64_asr1(b, rd, rd) in
  a64_apply_b26(b, pjmp, bytes_len(b))

let emit_a64_c_align(b) =
  let _ = a64_mov_sp(b, 19, 31) in
  let _ = a64_mov_imm64(b, 17, 0 - 16) in
  let _ = a64_and_reg(b, 17, 19, 17) in
  a64_mov_sp(b, 31, 17)

let emit_a64_c_unalign(b) = a64_mov_sp(b, 31, 19)

/* ccall: untag in x8, then x0..x5. fcall must not use this (keeps tags). */
let emit_a64_c_arg(b, args, j, na) =
  if j >= na then 0
  else if j >= 6 then 0
  else
    let _ = a64_slot(b, nth(args, j), false, 8) in
    let _ = emit_a64_c_untag(b, 8) in
    let _ = a64_mov_reg(b, j, 8) in
    emit_a64_c_arg(b, args, j + 1, na)

let emit_a64_fcall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let na = len(args) in
  let load(j) =
    if j >= na then 0
    else if j >= 8 then 0
    else
      let _ = a64_slot(b, nth(args, j), false, j) in
      load(j + 1) in
  let _ = load(0) in
  let pos = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = a64_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    emit_patch_rel(nth(st, 4), nth(st, 3), pos, nth(insn, 2)))

let emit_a64_ccall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let _ = emit_a64_c_arg(b, args, 0, len(args)) in
  let _ = emit_a64_c_align(b) in
  let pos = bytes_len(b) in
  let _ = a64_bl(b, 0) in
  let _ = emit_a64_c_unalign(b) in
  let _ = a64_lsl1(b, 0, 0) in
  let _ = a64_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    emit_patch_cimport(nth(st, 3), pos, nth(insn, 2)))

let emit_a64_iccall(st, insn) =
  let b = nth(st, 0) in
  let args = nth(insn, 3) in
  let _ = a64_slot(b, nth(insn, 2), false, 0) in
  let _ = emit_a64_c_untag(b, 0) in
  let _ = a64_mov_reg(b, 16, 0) in
  let _ = emit_a64_c_arg(b, args, 0, len(args)) in
  let _ = emit_a64_c_align(b) in
  let _ = a64_blr(b, 16) in
  let _ = emit_a64_c_unalign(b) in
  let _ = a64_lsl1(b, 0, 0) in
  let _ = a64_slot(b, nth(insn, 1), true, 0) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

let emit_a64_i_core(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "local" or k == "$local" then
    let nlocals = nth(insn, 1) in
    let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
    let nbytes = a64_frame_bytes(nlocals) in
    let patches2 =
      if is_entry then
        let _ = a64_ldur(b, 8, 31, 0) in
        let ac_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 8, 0, 0) in
        let _ = a64_add_imm(b, 8, 31, 8) in
        let av_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 8, 0, 0) in
        cons([5, av_save],
             cons([4, ac_save], patches))
      else patches in
    let _ =
      if is_entry then a64_mov_sp(b, 29, 31)
      else
        let _ = a64_stp_fp_lr(b) in
        a64_mov_sp(b, 29, 31) in
    let patches3 =
      if is_entry then
        let sh_save = bytes_len(b) in
        let _ = a64_mov_imm64(b, 0, 0) in
        let _ = a64_stur(b, 29, 0, 0) in
        cons([6, sh_save], patches2)
      else patches2 in
    let _ = a64_sub_imm(b, 31, 31, nbytes) in
    let storep(j) =
      if j >= nparams then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, j + 1, true, j) in
        storep(j + 1) in
    let _ = storep(0) in
    emit_st4(st, b, cur, labels, patches3)
  else if k == "mov_imm" then
    let _ = a64_mov_imm64(b, 0, nth(insn, 2)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mov" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if is_arith(k) then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ =
      if k == "add" then a64_add_reg(b, 0, 0, 1)
      else if k == "sub" then a64_sub_reg(b, 0, 0, 1)
      else if k == "mul" then a64_mul(b, 0, 0, 1)
      else if k == "land" then a64_and_reg(b, 0, 0, 1)
      else if k == "lor" then a64_orr_reg(b, 0, 0, 1)
      else if k == "xor" then a64_eor_reg(b, 0, 0, 1)
      else if k == "bnot" then a64_mvn(b, 0, 0)
      else if k == "shl" or k == "sal" then a64_lslv(b, 0, 0, 1)
      else if k == "shr" or k == "sar" then a64_lsrv(b, 0, 0, 1)
      else if k == "div" then a64_sdiv(b, 0, 0, 1)
      else if k == "rem" then
        let _ = a64_sdiv(b, 2, 0, 1) in
        a64_msub(b, 0, 2, 1, 0)
      else a64_add_reg(b, 0, 0, 1) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "icmp" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_cmp_int(b, op) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cmp" then
    let op = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let patches2 =
      if op == "==" or op == "!=" then a64_cmp_maybe_str(b, op, patches, nth(st, 4))
      else
        let _ = a64_asr1(b, 0, 0) in
        let _ = a64_asr1(b, 1, 1) in
        let _ = a64_cmp_int(b, op) in
        patches in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    emit_st4(st, b, cur, labels, patches2)
  else if k == "label" then
    emit_st4(st, b, cur, label_put(labels, nth(insn, 1), bytes_len(b)), patches)
  else if k == "jmp" then
    let pos = bytes_len(b) in
    let _ = a64_b(b, 0) in
    emit_st4(st, b, cur, labels, cons(["b26", pos, nth(insn, 1)], patches))
  else if k == "cmpjmp" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_cmp_reg(b, 0, 31) in
    let peq = bytes_len(b) in
    let _ = a64_b_eq(b, 0) in
    let pne = bytes_len(b) in
    let _ = a64_b(b, 0) in
    emit_st4(st, b, cur, labels,
     cons(["b26", pne, nth(insn, 2)],
          cons(["beq", peq, nth(insn, 3)], patches)))
  else if k == "fcall" then emit_a64_fcall(st, insn)
  else if k == "ccall" then emit_a64_ccall(st, insn)
  else if k == "iccall" then emit_a64_iccall(st, insn)
  else if k == "ret" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    if is_entry then
      let _ = a64_ret(b) in emit_st4(st, b, cur, labels, patches)
    else
      let _ = a64_mov_sp(b, 31, 29) in
      let _ = a64_ldp_fp_lr(b) in
      let _ = a64_ret(b) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "exit" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_movz(b, 8, 93, 0) in
    let _ = a64_svc(b) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "tcall" then
    let fn = nth(insn, 2) in
    let args = nth(insn, 3) in
    let na = len(args) in
    let load(j) =
      if j >= na then 0
      else if j >= 8 then 0
      else
        let _ = a64_slot(b, nth(args, j), false, j) in
        load(j + 1) in
    let _ = load(0) in
    let _ =
      if is_entry then 0
      else
        let _ = a64_mov_sp(b, 31, 29) in
        a64_ldp_fp_lr(b) in
    let pos = bytes_len(b) in
    let _ = a64_b(b, 0) in
    emit_st4(st, b, cur, labels, emit_patch_jmpf(nth(st, 4), patches, pos, fn))
  else st

let emit_a64_sysarg(b, args, j) =
  if j >= len(args) then 0
  else if j >= 6 then 0
  else
    let _ = a64_slot(b, nth(args, j), false, j) in
    emit_a64_sysarg(b, args, j + 1)

let emit_a64_i_sys(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  if nth(insn, 0) == "untag" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else
    let nr = nth(insn, 2) in
    let _ = emit_a64_sysarg(b, nth(insn, 3), 0) in
    let _ =
      if nr == 60 then a64_movz(b, 8, 93, 0)
      else a64_movz(b, 8, nr, 0) in
    let _ = a64_svc(b) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)

let emit_a64_i_raw(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "$and" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let imm = nth(insn, 3) in
    let _ =
      if imm == (0 - 2) then a64_untag_ptr(b, 0)
      else
        let _ = a64_mov_imm64(b, 1, imm) in
        a64_and_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$addi" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_add_imm(b, 0, 0, nth(insn, 3)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$add" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sub" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_sub_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bts" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let _ = a64_ldrb(b, 3, 0) in
    let _ = a64_movz(b, 2, 1, 0) in
    let _ = a64_lslv(b, 2, 2, 1) in
    let _ = a64_orr_reg(b, 3, 3, 2) in
    let _ = a64_strb(b, 3, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$bt" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsrv(b, 0, 0, 1) in
    let _ = a64_movz(b, 1, 1, 0) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$or" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$clamp0" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_clamp0(b) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st64" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$st8" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_strb(b, 31, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld64" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_ldur(b, 0, 0, nth(insn, 3)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$ld8" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ =
      if nth(insn, 3) == 0 then 0 else a64_add_imm(b, 0, 0, nth(insn, 3)) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$sp" then
    let _ = a64_mov_sp(b, 0, 31) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$fp" then
    let _ = a64_mov_sp(b, 0, 29) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$smap" then
    let _ = a64_movz(b, 0, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$gbase" then
    let gpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, cons([3, gpos], patches))
  else if k == "$glob" then
    let which = nth(insn, 2) in
    let gpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_ldur(b, 0, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "$icmp" then
    let op = nth(insn, 1) in
    let cc = if op == ">=u" then 3 else if op == "==" then 1 else if op == "<" then 10 else 0 in
    let _ = a64_slot(b, nth(insn, 3), false, 0) in
    let _ = a64_slot(b, nth(insn, 4), false, 1) in
    let _ = a64_cmp_reg(b, 0, 1) in
    let _ = a64_movz(b, 0, 0, 0) in
    let _ = a64_movz(b, 2, 1, 0) in
    let _ = a64_b_cond(b, cc, 2) in
    let _ = a64_mov_reg(b, 0, 2) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$jcc" then
    let op = nth(insn, 1) in
    let inv = if op == ">=u" then 3 else if op == "==" then 1 else if op == "<" then 10 else 0 in
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_cmp_reg(b, 0, 1) in
    let _ = a64_b_cond(b, inv, 2) in
    let pt = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let pf = bytes_len(b) in
    let _ = a64_b(b, 0) in
    emit_st4(st, b, cur, labels,
     cons(["b26", pt, nth(insn, 4)],
          cons(["b26", pf, nth(insn, 5)], patches)))
  else if k == "$memcpy" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 2) in
    let loop = bytes_len(b) in
    let _ = a64_cmp_imm(b, 2, 0) in
    let jeq = bytes_len(b) in
    let _ = a64_b_eq(b, 0) in
    let _ = a64_ldrb(b, 3, 1) in
    let _ = a64_strb(b, 3, 0) in
    let _ = a64_add_imm(b, 0, 0, 1) in
    let _ = a64_add_imm(b, 1, 1, 1) in
    let _ = a64_sub_imm(b, 2, 2, 1) in
    let jb = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let done = bytes_len(b) in
    let _ = a64_patch_bcond(b, jeq, done) in
    let _ = a64_apply_b26(b, jb, loop) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$memset" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let loop = bytes_len(b) in
    let _ = a64_cmp_imm(b, 1, 0) in
    let jeq = bytes_len(b) in
    let _ = a64_b_eq(b, 0) in
    let _ = a64_strb(b, 31, 0) in
    let _ = a64_add_imm(b, 0, 0, 1) in
    let _ = a64_sub_imm(b, 1, 1, 1) in
    let jb = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let done = bytes_len(b) in
    let _ = a64_patch_bcond(b, jeq, done) in
    let _ = a64_apply_b26(b, jb, loop) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$lea" then
    let off = bshl(nth(insn, 2) + 1, 3) in
    let _ = a64_sub_imm(b, 0, 29, off) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$shr" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_movz(b, 1, nth(insn, 3), 0) in
    let _ = a64_lsrv(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$carg" then
    let _ = a64_slot(b, nth(insn, 2), false, nth(insn, 1)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "$icall" then
    let _ = a64_slot(b, nth(insn, 2), false, 16) in
    let _ = a64_blr(b, 16) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else
    let name = nth(insn, 2) in
    let args = nth(insn, 3) in
    let _ =
      if name == "open" then
        let _ = a64_slot(b, nth(args, 0), false, 1) in
        let _ = a64_mov_imm64(b, 0, 0 - 100) in
        let _ = a64_slot(b, nth(args, 1), false, 2) in
        let _ =
          if len(args) > 2 then a64_slot(b, nth(args, 2), false, 3)
          else a64_movz(b, 3, 0, 0) in
        a64_movz(b, 8, 56, 0)
      else if name == "fork" then
        let _ = a64_movz(b, 0, 17, 0) in
        let _ = a64_movz(b, 1, 0, 0) in
        let _ = a64_movz(b, 2, 0, 0) in
        let _ = a64_movz(b, 3, 0, 0) in
        let _ = a64_movz(b, 4, 0, 0) in
        a64_movz(b, 8, 220, 0)
      else
        let _ = emit_a64_sysarg(b, args, 0) in
        if name == "lseek" then a64_movz(b, 8, 62, 0)
        else if name == "read" then a64_movz(b, 8, 63, 0)
        else if name == "write" then a64_movz(b, 8, 64, 0)
        else if name == "wait4" then a64_movz(b, 8, 260, 0)
        else if name == "execve" then a64_movz(b, 8, 221, 0)
        else if name == "exit" then a64_movz(b, 8, 93, 0)
        else if name == "brk" then a64_movz(b, 8, 214, 0)
        else if name == "mmap" then a64_movz(b, 8, 222, 0)
        else if name == "munmap" then a64_movz(b, 8, 215, 0)
        else a64_movz(b, 8, 57, 0) in
    let _ = a64_svc(b) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)

let emit_a64_i_heap(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "obj_kind" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, 16) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mref" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, nth(insn, 3)) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "tag" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "is_int" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_movz(b, 9, 1, 0) in
    let _ = a64_and_reg(b, 10, 0, 9) in
    let _ = a64_eor_reg(b, 10, 10, 9) in
    let _ = a64_lsl1(b, 0, 10) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "obj_sti" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_mov_imm64(b, 1, nth(insn, 3)) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "obj_st_int" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, nth(insn, 2)) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mref8" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "mset8" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_slot(b, nth(insn, 2), false, 2) in
    let _ = a64_asr1(b, 2, 2) in
    let _ = a64_add_reg(b, 0, 0, 2) in
    let _ = a64_strb(b, 1, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "ld64" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_mov_imm64(b, 1, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 1) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldur(b, 0, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "st64" then
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_mov_imm64(b, 2, 0 - 2) in
    let _ = a64_and_reg(b, 0, 0, 2) in
    let _ = a64_slot(b, nth(insn, 2), false, 2) in
    let _ = a64_asr1(b, 2, 2) in
    let _ = a64_add_reg(b, 0, 0, 2) in
    let _ = a64_stur(b, 1, 0, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "write1" then
    let _ = a64_slot(b, nth(insn, 1), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let _ = a64_sub_imm(b, 31, 31, 16) in
    let _ = a64_strb(b, 0, 31) in
    let _ = a64_mov_sp(b, 1, 31) in
    let _ = a64_movz(b, 2, 1, 0) in
    let _ = a64_movz(b, 0, 1, 0) in
    let _ = a64_movz(b, 8, 64, 0) in
    let _ = a64_svc(b) in
    let _ = a64_add_imm(b, 31, 31, 16) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "clock" then
    let _ = a64_sub_imm(b, 31, 31, 16) in
    let _ = a64_movz(b, 0, nth(insn, 3), 0) in
    let _ = a64_mov_sp(b, 1, 31) in
    let _ = a64_movz(b, 8, 113, 0) in
    let _ = a64_svc(b) in
    let _ = a64_ldur(b, 0, 31, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    let _ = a64_ldur(b, 0, 31, 8) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), true, 0) in
    let _ = a64_add_imm(b, 31, 31, 16) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "glob" then
    let which = nth(insn, 2) in
    let gpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_ldur(b, 0, 0, 0) in
    let _ = if which == 3 then 0 else if which == 4 then 0 else a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    let gkind =
      if which == 1 then 4
      else if which == 2 then 5
      else if which == 3 then 7
      else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "gst" then
    let which = nth(insn, 1) in
    let gpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let _ = a64_stur(b, 1, 0, 0) in
    let gkind = if which == 3 then 7 else 8 in
    emit_st4(st, b, cur, labels, cons([gkind, gpos], patches))
  else if k == "alloc" then
    let _ = a64_mov_imm64(b, 0, nth(insn, 2)) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
  else if k == "alloc_s" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_asr1(b, 0, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_alloc"))
  else if k == "argc" then
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_argc", nth(st, 4)))
  else if k == "time_ms" then
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "time_ms", nth(st, 4)))
  else if k == "time_str" then
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "time_str", nth(st, 4)))
  else if k == "argv" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_argv"))
  else st

let emit_a64_i_clos(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "closure" then
    let dst = nth(insn, 1) in
    let fnName = nth(insn, 2) in
    let caps = nth(insn, 3) in
    let nenv = len(caps) in
    let size = clos_bytes(nenv) in
    let _ = a64_mov_imm64(b, 0, size) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let fnpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 1, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_movz(b, 1, nenv, 0) in
    let _ = a64_stur(b, 1, 0, 24) in
    let storecap(i) =
      if i >= nenv then 0
      else
        let _ = a64_slot(b, nth(caps, i), false, 1) in
        let _ = a64_stur(b, 1, 0, 32 + bshl(i, 3)) in
        storecap(i + 1) in
    let _ = storecap(0) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, dst, true, 0) in
    emit_st4(st, b, cur, labels,
     emit_patch_rel(nth(st, 4), emit_patch_clos(nth(st, 4), patches, fnpos, fnName), acall, "yac_alloc"))
  else if k == "apply" or k == "icall" then
    let dst = nth(insn, 1) in
    let clos = nth(insn, 2) in
    let ncap = apply_ncap(insn) in
    let args = apply_args(insn) in
    let nargs = len(args) in
    let ntot = ncap + nargs in
    if ncap < 0 then
      if nargs == 1 or nargs == 2 then
        let _ = a64_slot(b, clos, false, 0) in
        let _ = a64_slot(b, nth(args, 0), false, 1) in
        let _ = if nargs == 2 then a64_slot(b, nth(args, 1), false, 2) else 0 in
        let pos = bytes_len(b) in
        let _ = a64_bl(b, 0) in
        let _ = a64_slot(b, dst, true, 0) in
        let nm = if nargs == 1 then "yac_apply1" else "yac_apply2" in
        emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, nm))
      else
        let _ = a64_brk(b) in emit_st4(st, b, cur, labels, patches)
    else if ntot > 8 then
      let _ = a64_brk(b) in emit_st4(st, b, cur, labels, patches)
    else
      let _ = a64_slot(b, clos, false, 17) in
      let _ = a64_untag_ptr(b, 17) in
      let _ = a64_ldur(b, 16, 17, 16) in
      let load(i) =
        if i >= ntot then 0
        else if i < ncap then
          let _ = a64_ldur(b, i, 17, 32 + bshl(i, 3)) in
          load(i + 1)
        else
          let _ = a64_slot(b, nth(args, i - ncap), false, i) in
          load(i + 1) in
      let _ = load(0) in
      let _ = a64_blr(b, 16) in
      let _ = a64_slot(b, dst, true, 0) in
      emit_st4(st, b, cur, labels, patches)
  else if k == "tailapply" or k == "ticall" then
    let clos = nth(insn, 2) in
    let ncap = apply_ncap(insn) in
    let args = apply_args(insn) in
    let nargs = len(args) in
    let ntot = ncap + nargs in
    if ncap < 0 then
      if nargs == 1 or nargs == 2 then
        let _ = a64_slot(b, clos, false, 0) in
        let _ = a64_slot(b, nth(args, 0), false, 1) in
        let _ = if nargs == 2 then a64_slot(b, nth(args, 1), false, 2) else 0 in
        let _ =
          if is_entry then 0
          else
            let _ = a64_mov_sp(b, 31, 29) in
            a64_ldp_fp_lr(b) in
        let pos = bytes_len(b) in
        let _ = a64_b(b, 0) in
        let nm = if nargs == 1 then "yac_apply1" else "yac_apply2" in
        emit_st4(st, b, cur, labels, emit_patch_jmpf(nth(st, 4), patches, pos, nm))
      else
        let _ = a64_brk(b) in emit_st4(st, b, cur, labels, patches)
    else if ntot > 8 then
      let _ = a64_brk(b) in emit_st4(st, b, cur, labels, patches)
    else
      let _ = a64_slot(b, clos, false, 17) in
      let _ = a64_untag_ptr(b, 17) in
      let _ = a64_ldur(b, 16, 17, 16) in
      let load(i) =
        if i >= ntot then 0
        else if i < ncap then
          let _ = a64_ldur(b, i, 17, 32 + bshl(i, 3)) in
          load(i + 1)
        else
          let _ = a64_slot(b, nth(args, i - ncap), false, i) in
          load(i + 1) in
      let _ = load(0) in
      let _ =
        if is_entry then 0
        else
          let _ = a64_mov_sp(b, 31, 29) in
          a64_ldp_fp_lr(b) in
      let _ = a64_br(b, 16) in
      emit_st4(st, b, cur, labels, patches)
  else st

let emit_a64_i_prim(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "nil" then
    let _ = a64_movz(b, 0, 1, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cons" then
    let _ = a64_mov_imm64(b, 0, 40) in
    let acall = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_stur(b, 31, 0, 8) in
    let _ = a64_movz(b, 1, 2, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_slot(b, nth(insn, 2), false, 1) in
    let _ = a64_stur(b, 1, 0, 24) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_stur(b, 1, 0, 32) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, acall, "yac_alloc"))
  else if k == "strlit" then
    let dst = nth(insn, 1) in
    let off = strlit_off(nth(insn, 2)) in
    let pos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 0, 0) in
    let _ = a64_slot(b, dst, true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_strlit(patches, pos, off))
  else if k == "str_len" then
    let dst = nth(insn, 1) in
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_cmp_reg(b, 0, 31) in
    let jz = bytes_len(b) in
    let _ = a64_b_cond(b, 0, 0) in
    let _ = a64_cmp_imm(b, 0, 1) in
    let jnil = bytes_len(b) in
    let _ = a64_b_cond(b, 0, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_ldur(b, 0, 0, 24) in
    let _ = a64_lsl1(b, 0, 0) in
    let jd = bytes_len(b) in
    let _ = a64_b(b, 0) in
    let zlen = bytes_len(b) in
    let _ = a64_movz(b, 0, 0, 0) in
    let done = bytes_len(b) in
    let _ = a64_patch_bcond(b, jz, zlen) in
    let _ = a64_patch_bcond(b, jnil, zlen) in
    let _ = a64_apply_b26(b, jd, done) in
    let _ = a64_slot(b, dst, true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "str_ref" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_asr1(b, 1, 1) in
    let _ = a64_add_imm(b, 0, 0, 32) in
    let _ = a64_add_reg(b, 0, 0, 1) in
    let _ = a64_ldrb(b, 0, 0) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_new" then
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_new", nth(st, 4)))
  else if k == "bytes_len" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_ldur(b, 0, 0, 24) in
    let _ = a64_lsl1(b, 0, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "bytes_ref" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_ref", nth(st, 4)))
  else if k == "bytes_put" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_put", nth(st, 4)))
  else if k == "len" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_len", nth(st, 4)))
  else if k == "nth" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_nth", nth(st, 4)))
  else if k == "tail" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_tail", nth(st, 4)))
  else if k == "append" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_append", nth(st, 4)))
  else if k == "list_rev" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_rev", nth(st, 4)))
  else if k == "list_new" then
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_new", nth(st, 4)))
  else if k == "list_push" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_list_push", nth(st, 4)))
  else if k == "str_cat" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_str_cat", nth(st, 4)))
  else if k == "str_slice" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_str_slice", nth(st, 4)))
  else if k == "int_to_str" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_int_to_str", nth(st, 4)))
  else if k == "bytes_to_str" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_to_str", nth(st, 4)))
  else if k == "bytes_extend" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_extend", nth(st, 4)))
  else if k == "bytes_append" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_bytes_append", nth(st, 4)))
  else if k == "drop" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_drop", nth(st, 4)))
  else if k == "foldl" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let _ = a64_slot(b, nth(insn, 4), false, 2) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_foldl", nth(st, 4)))
  else if k == "map" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    emit_st4(st, b, cur, labels, a64_bl_rt(b, patches, nth(insn, 1), "yac_map", nth(st, 4)))
  else if k == "read_file" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_read_file"))
  else if k == "write_file" then
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_slot(b, nth(insn, 3), false, 1) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, emit_patch_rel(nth(st, 4), patches, pos, "yac_write_file"))
  else
    let _ = a64_brk(b) in
    emit_st4(st, b, cur, labels, patches)

let emit_a64_i_memcpy(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let _ = a64_slot(b, nth(insn, 1), false, 0) in
  let _ = a64_untag_ptr(b, 0) in
  let _ = a64_slot(b, nth(insn, 2), false, 1) in
  let _ = a64_asr1(b, 1, 1) in
  let _ = a64_add_reg(b, 0, 0, 1) in
  let _ = a64_slot(b, nth(insn, 3), false, 2) in
  let _ = a64_untag_ptr(b, 2) in
  let _ = a64_slot(b, nth(insn, 4), false, 3) in
  let _ = a64_asr1(b, 3, 3) in
  let _ = a64_add_reg(b, 1, 2, 3) in
  let _ = a64_slot(b, nth(insn, 5), false, 2) in
  let _ = a64_asr1(b, 2, 2) in
  let loop = bytes_len(b) in
  let _ = a64_cmp_imm(b, 2, 0) in
  let jeq = bytes_len(b) in
  let _ = a64_b_eq(b, 0) in
  let _ = a64_ldrb(b, 3, 1) in
  let _ = a64_strb(b, 3, 0) in
  let _ = a64_add_imm(b, 0, 0, 1) in
  let _ = a64_add_imm(b, 1, 1, 1) in
  let _ = a64_sub_imm(b, 2, 2, 1) in
  let jb = bytes_len(b) in
  let _ = a64_b(b, 0) in
  let done = bytes_len(b) in
  let _ = a64_patch_bcond(b, jeq, done) in
  let _ = a64_apply_b26(b, jb, loop) in
  emit_st4(st, b, cur, labels, patches)

let emit_a64_i_cc(st, insn) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  if k == "mkcont" then
    let _ = a64_mov_imm64(b, 0, 48) in
    let pos = bytes_len(b) in
    let _ = a64_bl(b, 0) in
    let _ = a64_untag_ptr(b, 0) in
    let _ = a64_movz(b, 1, 0, 0) in
    let _ = a64_stur(b, 1, 0, 8) in
    let _ = a64_movz(b, 1, 6, 0) in
    let _ = a64_stur(b, 1, 0, 16) in
    let _ = a64_stur(b, 29, 0, 24) in
    let _ = a64_mov_sp(b, 9, 31) in
    let _ = a64_stur(b, 9, 0, 32) in
    let labpos = bytes_len(b) in
    let _ = a64_mov_imm64(b, 8, 0) in
    let _ = a64_stur(b, 8, 0, 40) in
    let _ = a64_tag(b, 0) in
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels,
      emit_patch_rel(nth(st, 4),
        cons(["cclab", labpos, nth(insn, 2)], patches), pos, "yac_alloc"))
  else if k == "throwk" then
    let _ = a64_slot(b, nth(insn, 1), false, 1) in
    let _ = a64_untag_ptr(b, 1) in
    let _ = a64_slot(b, nth(insn, 2), false, 0) in
    let _ = a64_ldur(b, 29, 1, 24) in
    let _ = a64_ldur(b, 9, 1, 32) in
    let _ = a64_mov_sp(b, 31, 9) in
    let _ = a64_ldur(b, 8, 1, 40) in
    let _ = a64_br(b, 8) in
    emit_st4(st, b, cur, labels, patches)
  else if k == "cc_recv" then
    let _ = a64_slot(b, nth(insn, 1), true, 0) in
    emit_st4(st, b, cur, labels, patches)
  else st

let emit_insn_a64_go(st, insn, is_entry) =
  let k = nth(insn, 0) in
  if k == "closure" or k == "apply" or k == "icall"
       or k == "tailapply" or k == "ticall" then
    emit_a64_i_clos(st, insn, is_entry)
  else if is_frame_op(k) or k == "mov_imm" or k == "mov" or is_arith(k)
       or k == "cmp" or k == "icmp" or k == "label" or k == "fcall" or k == "ccall"
       or k == "iccall" or k == "tcall" or k == "jmp" or k == "cmpjmp" or k == "ret"
       or k == "exit" then
    emit_a64_i_core(st, insn, is_entry)
  else if k == "untag" or k == "syscall" then
    emit_a64_i_sys(st, insn)
  else if is_raw_op(k) then
    emit_a64_i_raw(st, insn)
  else if k == "obj_kind" or k == "mref" or k == "mset" or k == "tag"
       or k == "is_int" or k == "alloc" or k == "obj_sti" or k == "obj_st_int"
       or k == "alloc_s" or k == "mref8" or k == "mset8" or k == "ld64" or k == "st64"
       or k == "write1" or k == "clock" or k == "glob" or k == "gst" or k == "time_ms"
       or k == "time_str" or k == "argc" or k == "argv" then
    emit_a64_i_heap(st, insn)
  else if k == "memcpy" then emit_a64_i_memcpy(st, insn)
  else if k == "mkcont" or k == "throwk" or k == "cc_recv" then
    emit_a64_i_cc(st, insn)
  else emit_a64_i_prim(st, insn)

let emit_insn_a64(st, insn, is_entry) =
  emit_insn_a64_go(st, insn, is_entry)



let a64_lookup_at(labels, name, i) =
  if i < 0 then 0
  else if nth(nth(labels, i), 0) == name then nth(nth(labels, i), 1)
  else a64_lookup_at(labels, name, i - 1)

let a64_lookup(labels, name) = a64_lookup_at(labels, name, len(labels) - 1)

let a64_patch_beq(b, pos, targ) =
  let rel = bshr(targ - pos, 2) in
  let w = 1409286144 + bshl(band(rel, 524287), 5) in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  bytes_put(b, pos + 3, band(bshr(w, 24), 255))

/* Per-fun: resolve PC-relative local branches. Keep numeric patches.
 * Rewrite cclab name → code offset (labels are discarded after each fun).
 * Shared labels across funs made recursion jump into runtime. */
let a64_resolve_fun_patches(b, labels, patches) =
  let n = len(patches) in
  let keep = list_new() in
  let step(i) =
    if i >= n then keep
    else
      let p = nth(patches, i) in
      let tag = nth(p, 0) in
      let _ =
        if is_int(tag) then list_push(keep, p)
        else if tag == "cclab" then
          list_push(keep, ["cclab", nth(p, 1), a64_lookup(labels, nth(p, 2))])
        else
          let pos = nth(p, 1) in
          let targ = a64_lookup(labels, nth(p, 2)) in
          if tag == "beq" then a64_patch_beq(b, pos, targ)
          else a64_apply_b26(b, pos, targ) in
      step(i + 1) in
  step(0)

/* st = [b, offs, codebase, globbase, labels] */
let a64_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let offs = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let labels = nth(st, 4) in
  let tag = nth(p, 0) in
  if tag == 1 then
    a64_apply_bl(b, nth(p, 1), nth(offs, nth(p, 2)))
  else if tag == 2 then
    a64_mov_imm64_at(b, nth(p, 1), 1, codebase + nth(offs, nth(p, 2)))
  else if tag == 3 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase)
  else if tag == 4 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase + 8)
  else if tag == 5 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase + 16)
  else if tag == 6 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase + 24)
  else if tag == 7 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase + 48)
  else if tag == 8 then
    a64_mov_imm64_at(b, nth(p, 1), 0, globbase + 56)
  else if tag == 9 then
    a64_apply_b26(b, nth(p, 1), nth(offs, nth(p, 2)))
  else if tag == 11 then
    a64_mov_imm64_at(b, nth(p, 1), 0, nth(st, 5) + nth(p, 2) + 1)
  else if tag == 15 then
    a64_apply_bl(b, nth(p, 1), nth(nth(cimport_buf(0), 1), nth(p, 2)))
  else if tag == "cclab" then
    a64_mov_imm64_at(b, nth(p, 1), 8, codebase + nth(p, 2))
  else
    let pos = nth(p, 1) in
    let lab = nth(p, 2) in
    let targ = a64_lookup(labels, lab) in
    if tag == "beq" then a64_patch_beq(b, pos, targ)
    else a64_apply_b26(b, pos, targ)

let a64_resolve_loop(st, ps, i) =
  if i >= len(ps) then 0
  else
    let _ = a64_resolve_patch(st, nth(ps, i)) in
    a64_resolve_loop(st, ps, i + 1)

let emit_program_arm64(prog, load_vaddr, text_off) =
  let _ = strlit_pool_reset(0) in
  let _ = cimport_reset(0) in
  let ckeep = cimport_buf(0) in
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let ids = emit_ids_new(funs) in
  let offs = list_new() in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = bytes_len(nth(st, 0)) in
      let st0 = [nth(st, 0), 0, [], [], nth(st, 4)] in
      let insns = nth(f, 4) in
      if len(insns) == 0 then
        let _ = list_push(offs, 0) in
        emit_fun(i + 1, st, fo)
      else
        let _ = list_push(offs, fstart) in
        let run(j, s) =
          if j >= len(insns) then s
          else run(j + 1, emit_insn_a64(s, nth(insns, j), is_entry)) in
        let s1 = run(0, st0) in
        let kept = a64_resolve_fun_patches(nth(s1, 0), nth(s1, 2), nth(s1, 3)) in
        let _ = patches_extend(nth(st, 3), kept) in
        let s2 = [nth(s1, 0), 0, [], nth(st, 3), nth(st, 4)] in
        emit_fun(i + 1, s2, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, [out, 0, [], list_new(), ids], []) in
  let st = nth(r1, 0) in
  let fo0 = nth(r1, 1) in
  let b = nth(st, 0) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let pad8(_) =
    if band(bytes_len(b), 7) == 0 then 0
    else let _ = bytes_append(b, 0) in pad8(0) in
  let _ = pad8(0) in
  let pool_start = bytes_len(b) in
  let _ = bytes_extend(b, strlit_bytes(0)) in
  let _ = pad8(0) in
  let data_start = bytes_len(b) in
  let fill_data(i) =
    if i >= 112 then 0
    else let _ = bytes_append(b, 0) in fill_data(i + 1) in
  let _ = fill_data(0) in
  let _ = emit_cplt_a64(b) in
  let _ = ckeep in
  let GLOBALS_BASE = load_vaddr + text_off + data_start in
  let extra = list_new() in
  let _ = patches_extend(extra, patches) in
  let _ = a64_resolve_loop([b, offs, load_vaddr + text_off, GLOBALS_BASE, labels,
                            load_vaddr + text_off + pool_start], extra, 0) in
  [b, fo0]
