let win_entry(b, patches) =
  let _ = sub_rsp_imm32(b, 40) in
  let p1 = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = mov_rbx_rax(b) in
  let _ = mov_r64_imm(b, 1, 0) in
  let _ = mov_r64_imm(b, 2, 8192) in
  let _ = mov_r64_imm(b, 8, 12288) in
  let _ = mov_r64_imm(b, 9, 4) in
  let p2 = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_rdi_rax(b) in
  let _ = add_rdi_imm32(b, 512) in
  let _ = xor_r8_r8(b) in
  let _ = win_argv(b) in
  let _ = mov_r64_imm(b, 0, 0) in
  let _ = mov_mem_rsi_r8_rax(b) in
  let _ = add_rsp_imm32(b, 40) in
  let _ = mov_rax_r8(b) in
  let _ = mov_rdi_rax(b) in
  emit_patch_cimport(
    emit_patch_cimport(patches, p1 + 1, "GetCommandLineA"),
    p2 + 1, "VirtualAlloc")

let win_exit(st, patches) =
  let b = nth(st, 0) in
  let _ = mov_rcx_rax(b) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), win_k32_call(b, patches, "ExitProcess"))

let win_num_syscall(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let _ = emit_load_rax_slot(b, nth(nth(insn, 3), 0)) in
  let _ = mov_rcx_rax(b) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), win_k32_call(b, patches, "ExitProcess"))

let win_write1(st, insn) =
  let b = nth(st, 0) in
  let patches = nth(st, 3) in
  let _ = emit_load_rax_slot(b, nth(insn, 1)) in
  let _ = sar_rax_1(b) in
  let _ = sub_rsp_imm32(b, 64) in
  let _ = mov_mem_rsp_disp8_al(b, 56) in
  let _ = mov_r64_imm(b, 1, 0 - 11) in
  let g1 = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = mov_rcx_rax(b) in
  let _ = lea_rdx_rsp_disp8(b, 56) in
  let _ = mov_r64_imm(b, 8, 1) in
  let _ = lea_r9_rsp_disp8(b, 48) in
  let _ = mov_r64_imm(b, 0, 0) in
  let _ = mov_mem_rsp_disp8_rax(b, 32) in
  let g2 = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = add_rsp_imm32(b, 64) in
  emit_st4(st, b, nth(st, 1), nth(st, 2),
    emit_patch_cimport(emit_patch_cimport(patches, g1 + 1, "GetStdHandle"),
                       g2 + 1, "WriteFile"))

let win_clock(st, insn) =
  let b = nth(st, 0) in
  let _ = mov_r64_imm(b, 0, 0) in
  let _ = emit_store_rax_slot(b, nth(insn, 1)) in
  let _ = emit_store_rax_slot(b, nth(insn, 2)) in
  emit_st4(st, b, nth(st, 1), nth(st, 2), nth(st, 3))

let win_ccall_patch(ps, pos, fn) =
  if fn == "uname" then emit_patch_pe_uname(ps, pos)
  else if fn == "dlsym" then emit_patch_pe_dlsym(ps, pos)
  else if fn == "dlopen" then emit_patch_pe_dlopen(ps, pos)
  else if fn == "system" then emit_patch_pe_system(ps, pos)
  else emit_patch_cimport(ps, pos, fn)

let win_begin(_) = win_need(0)

