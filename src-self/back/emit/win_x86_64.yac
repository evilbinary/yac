  let _ = ret(b) in
  let s_os = bytes_len(b) in
  let _ = win_put_str(b, "OS", 0) in
  let s_arch = bytes_len(b) in
  let _ = win_put_str(b, "PROCESSOR_ARCHITECTURE", 0) in
  let _ = apply_patch(b, l1 + 3, s_os) in
  let _ = apply_patch(b, l2 + 3, s_arch) in
  let _ = list_push(extra, [15, c1 + 1, cimport_id("GetEnvironmentVariableA")]) in
  let _ = list_push(extra, [15, c2 + 1, cimport_id("GetComputerNameA")]) in
  let _ = list_push(extra, [15, c3 + 1, cimport_id("GetEnvironmentVariableA")]) in
  extra

