/* emit.yac — shared emit helpers (all arches).
 *
 * Arch backends: emit_x86_64.yac (+ linux_x86_64.yac / win_x86_64.yac),
 * emit_arm64.yac, emit_riscv64.yac
 * LIR in, code bytes out; pack is a separate pass.
 *
 * Helpers: byte append, abs32/u64 patches, x86 rel32 patch, name maps,
 * patch-list extend. Instruction emit stays in emit_<arch>.yac.
 */

let reverse(xs) = list_rev(xs)

/* 0-cap closures are 32 bytes. Cons cdr / BYTES cap live at +32, which is
 * the next object's size/next (heap dump: next=6, size=0x3c/0x2000). */
let clos_bytes(nenv) =
  let s = bshl(4 + nenv, 3) in
  if s < 48 then 48 else s

/* DESIGN arith tags. */
let is_arith(k) =
  if k == "add" then true
  else if k == "sub" then true
  else if k == "mul" then true
  else if k == "div" then true
  else if k == "rem" then true
  else if k == "sar" then true
  else if k == "shr" then true
  else if k == "sal" then true
  else if k == "shl" then true
  else if k == "land" then true
  else if k == "lor" then true
  else if k == "xor" then true
  else if k == "bnot" then true
  else false

/* icall/ticall have no ncap field; apply/tailapply do. */
let apply_ncap(insn) =
  if nth(insn, 0) == "icall" then 0 - 1
  else if nth(insn, 0) == "ticall" then 0 - 1
  else nth(insn, 3)

let apply_args(insn) =
  if nth(insn, 0) == "icall" then nth(insn, 3)
  else if nth(insn, 0) == "ticall" then nth(insn, 3)
  else nth(insn, 4)

let b_append(dst, src) =
  let _ = bytes_extend(dst, src) in
  dst

let apply_i32(b, bytePos, val) =
  let _ = bytes_put(b, bytePos + 0, band(val, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(val, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(val, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(val, 24), 255)) in
  0

let apply_patch(b, bytePos, target) =
  apply_i32(b, bytePos, target - (bytePos + 4))

/* write a 32-bit absolute value at bytePos (for closure fnptr fields) */
let apply_abs32(b, bytePos, val) = apply_i32(b, bytePos, val)

/* write a 64-bit little-endian value at bytePos (for GC global addresses) */
let apply_u64(b, bytePos, val) =
  let _ = apply_abs32(b, bytePos, band(val, 4294967295)) in
  let _ = apply_abs32(b, bytePos + 4, band(bshr(val, 32), 4294967295)) in
  0

/* Local labels: cons list of [name, pos]. */
let lookup_name_at(table, name, i) =
  if i < 0 then 0
  else if nth(nth(table, i), 0) == name then nth(nth(table, i), 1)
  else lookup_name_at(table, name, i - 1)

let lookup_name(table, name) = lookup_name_at(table, name, len(table) - 1)

let label_has_at(labels, name, i) =
  if i < 0 then false
  else if nth(nth(labels, i), 0) == name then true
  else label_has_at(labels, name, i - 1)

let label_has(labels, name) = label_has_at(labels, name, len(labels) - 1)

let label_put(labels, name, pos) = cons([name, pos], labels)

/* GC root: funs during fmap_fill, then [funs, ids] for the rest of emit. */
let emit_ids_hold =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let emit_id_scan(funs, name, i, n) =
  if i >= n then 0
  else
    let nm = nth(nth(funs, i), 1) in
    if is_int(nm) then emit_id_scan(funs, name, i + 1, n)
    else if intern(nm) == name then i
    else emit_id_scan(funs, name, i + 1, n)

/* fmap_get miss is 0; fun id 0 is _start. Store i+1 so 0 is only a miss. */
let emit_map_get(m, k) =
  let ik = intern(k) in
  let e = fmap_get(m, ik) in
  if e != 0 then e - 1
  else
    let h = box_get(emit_ids_hold) in
    if h == 0 then 0
    else if is_int(h) then 0
    else emit_id_scan(nth(h, 0), intern(ik), 0, len(nth(h, 0)))

let emit_map_put(m, k, v) =
  let _ = fmap_put(m, intern(k), v) in
  m

/* Fun id table: bind procs first, then helpers so reserved names win.
 * Duplicate fun names: last-put-wins (runtime prof_* stubs lose to profile.yac).
 * No handwritten helpers; yac_gc is a $proc. */
let emit_ids_helpers(ids, nfun) =
  let _ = nfun in
  ids

/* Native ops: no sar/shl. $syscall names open/lseek/read/write/close/fork/wait4/execve/exit/brk/mmap/munmap. */
let is_raw_op(k) =
  if k == "$and" then true
  else if k == "$add" then true
  else if k == "$addi" then true
  else if k == "$or" then true
  else if k == "$syscall" then true
  else if k == "$clamp0" then true
  else if k == "$st64" then true
  else if k == "$st8" then true
  else if k == "$ld64" then true
  else if k == "$ld8" then true
  else if k == "$glob" then true
  else if k == "$gbase" then true
  else if k == "$icmp" then true
  else if k == "$memcpy" then true
  else if k == "$lea" then true
  else if k == "$shr" then true
  else if k == "$carg" then true
  else if k == "$icall" then true
  else if k == "$sp" then true
  else if k == "$sub" then true
  else if k == "$bts" then true
  else if k == "$bt" then true
  else if k == "$fp" then true
  else if k == "$smap" then true
  else if k == "$jcc" then true
  else k == "$memset"

let is_frame_op(k) =
  if k == "local" then true
  else k == "$local"

/* $proc record, or first insn $local. */
let fun_is_raw(f) =
  if nth(f, 0) == "$proc" then true
  else
    let ins = nth(f, 4) in
    if len(ins) == 0 then false
    else nth(nth(ins, 0), 0) == "$local"

let emit_ids_bind(ids, funs, i, n) =
  if i >= n then ids
  else
    let f = nth(funs, i) in
    let ins = nth(f, 4) in
    let _ =
      if is_int(ins) then 0
      else if len(ins) == 0 then 0
      else
        let nm = nth(f, 1) in
        if is_int(nm) then 0
        else emit_map_put(ids, intern(nm), i + 1) in
    emit_ids_bind(ids, funs, i + 1, n)

let emit_ids_new(funs) =
  let nfun = len(funs) in
  let ids = fmap_new(0) in
  let _ = box_set(emit_ids_hold, funs) in
  let _ = fmap_init_n(ids, 4096) in
  let ids2 = emit_ids_helpers(emit_ids_bind(ids, box_get(emit_ids_hold), 0, nfun), nfun) in
  let _ = box_set(emit_ids_hold, [box_get(emit_ids_hold), ids2]) in
  ids2

/* Patch tags: 1=call to fun id (x86 rel32 / a64 bl / rv jal ra),
 * 2=closure fnptr abs64, 3+=globals, 9=tail jmp to fun id (a64 b26 / rv jal).
 * Local labels stay string kinds (b26/beq/jal) or [pos, name] on x86. */
let emit_patch_rel(ids, ps, pos, name) =
  cons([1, pos, emit_map_get(ids, name)], ps)

let emit_patch_clos(ids, ps, pos, name) =
  cons([2, pos, emit_map_get(ids, name)], ps)

let emit_patch_jmpf(ids, ps, pos, name) =
  cons([9, pos, emit_map_get(ids, name)], ps)

/* tag 11: mov-imm64 of pooled STR (va|1). pos = imm64 / movz site. */
let emit_patch_strlit(ps, pos, off) = cons([11, pos, off], ps)

/* tag 12: abs64 = codebase + file_off (stack-map retaddrs / table ptr). */
let emit_patch_codeva(ps, pos, off) = cons([12, pos, off], ps)

/* tag 16/17/18/19/20: rel32 to PE uname / dlsym / system / dlopen / unimp stubs. */
let emit_patch_pe_uname(ps, pos) = cons([16, pos], ps)
let emit_patch_pe_dlsym(ps, pos) = cons([17, pos], ps)
let emit_patch_pe_system(ps, pos) = cons([18, pos], ps)
let emit_patch_pe_dlopen(ps, pos) = cons([19, pos], ps)
let emit_patch_pe_unimp(ps, pos) = cons([20, pos], ps)

let emit_fmt_box =
  let b = box_new() in
  let _ = box_set(b, "elf") in
  b

let emit_fmt_set(s) = box_set(emit_fmt_box, s)

let emit_fmt(_) = box_get(emit_fmt_box)

let emit_is_pe(_) = emit_fmt(0) == "pe"

/* 112 bytes GC globals + 8 bytes host jit_map ptr (G+112). */
let emit_glob_data(b) =
  let fill(i) =
    if i >= 120 then 0
    else let _ = bytes_append(b, 0) in fill(i + 1) in
  fill(0)

let yjit_layout_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let yjit_layout_set(pool, smap, data, n) =
  box_set(yjit_layout_box, [pool, smap, data, n])

let yjit_layout_get(_) = box_get(yjit_layout_box)

/* Append session for emit: 0 or [text_off, globbase, exports_fmap]. */
let emit_jsess_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let emit_jsess_set(v) = box_set(emit_jsess_box, v)

let emit_jsess(_) = box_get(emit_jsess_box)

/* JIT: skip resolve in emit; apply in lower / jit.yac ([rst, patches, arch]). */
let emit_unres_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let emit_unres_set(v) = box_set(emit_unres_box, v)

let emit_unres(_) = box_get(emit_unres_box)

let emit_jsess_skip(name) =
  let s = emit_jsess(0) in
  if s == 0 then 0 - 1
  else
    let e = fmap_get(nth(s, 2), intern(name)) in
    if e == 0 then 0 - 1 else e - 1

/* Win64 ccall/_start: PE guests, or in-process JIT on a Windows host. */
let emit_abi_win_box =
  let b = box_new() in
  let _ = box_set(b, false) in
  b

let emit_abi_win_set(v) = box_set(emit_abi_win_box, v)

let emit_abi_win(_) = box_get(emit_abi_win_box)

let emit_host_win(_) = emit_abi_win(0)

/* Current proc name while emitting (self-tcall loopify vs cross-fun tcall). */
let emit_self_box =
  let b = box_new() in
  let _ = box_set(b, "") in
  b

let emit_self_set(n) = box_set(emit_self_box, n)

let emit_self(_) = box_get(emit_self_box)

let pe_uname_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pe_dlsym_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pe_system_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pe_dlopen_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pe_mods_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pe_unimp_off_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let cimport_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let cimport_buf(_) =
  let v = box_get(cimport_box) in
  if v == 0 then
    let l = list_new() in
    let _ = box_set(cimport_box, l) in
    l
  else v

let cimport_reset(_) =
  let c = cimport_buf(0) in
  if len(c) == 0 then
    let _ = list_push(c, list_new()) in
    let _ = list_push(c, list_new()) in
    list_push(c, 0)
  else
    let _ = list_set(c, 0, list_new()) in
    let _ = list_set(c, 1, list_new()) in
    list_set(c, 2, 0)

let cimport_names(_) =
  let c = cimport_buf(0) in
  if len(c) == 0 then list_new() else nth(c, 0)

let cimport_got(_) =
  let c = cimport_buf(0) in
  if len(c) < 3 then 0 else nth(c, 2)

let cimport_n(_) = len(cimport_names(0))

let cimport_find(xs, name, i, n) =
  if i >= n then 0 - 1
  else if nth(xs, i) == name then i
  else cimport_find(xs, name, i + 1, n)

let cimport_id(name) =
  let _ = if len(cimport_buf(0)) == 0 then cimport_reset(0) else 0 in
  let xs = nth(cimport_buf(0), 0) in
  let j = cimport_find(xs, name, 0, len(xs)) in
  if j >= 0 then j
  else
    let _ = list_push(xs, name) in
    len(xs) - 1

let emit_patch_cimport(ps, pos, name) =
  cons([15, pos, cimport_id(name)], ps)

let emit_cplt(b) =
  let xs = cimport_names(0) in
  let n = len(xs) in
  if n == 0 then 0
  else
    let pad8(_) =
      if band(bytes_len(b), 7) == 0 then 0
      else let _ = bytes_append(b, 0) in pad8(0) in
    let _ = pad8(0) in
    let got = bytes_len(b) in
    let _ = list_set(cimport_buf(0), 2, got) in
    let fill(i, lim) =
      if i >= lim then 0
      else let _ = bytes_append(b, 0) in fill(i + 1, lim) in
    let nq =
      if emit_is_pe(0) then 3 + pe_iat_qwords(xs)
      else 3 + n in
    let _ = fill(0, nq * 8) in
    let plts = nth(cimport_buf(0), 1) in
    let stub(i) =
      if i >= n then 0
      else
        let _ = list_push(plts, bytes_len(b)) in
        let slot =
          if emit_is_pe(0) then pe_iat_off(got, xs, i)
          else got + 24 + i * 8 in
        let _ = jmp_mem_rip(b, slot - (bytes_len(b) + 6)) in
        stub(i + 1) in
    stub(0)

let emit_cplt_a64(b) =
  let xs = cimport_names(0) in
  let n = len(xs) in
  if n == 0 then 0
  else
    let pad8(_) =
      if band(bytes_len(b), 7) == 0 then 0
      else let _ = bytes_append(b, 0) in pad8(0) in
    let _ = pad8(0) in
    let got = bytes_len(b) in
    let _ = list_set(cimport_buf(0), 2, got) in
    let fill(i, lim) =
      if i >= lim then 0
      else let _ = bytes_append(b, 0) in fill(i + 1, lim) in
    let _ = fill(0, (3 + n) * 8) in
    let plts = nth(cimport_buf(0), 1) in
    let stub(i) =
      if i >= n then 0
      else
        let _ = list_push(plts, bytes_len(b)) in
        let slot = got + 24 + i * 8 in
        let disp = slot - bytes_len(b) in
        let _ = a64_adr(b, 16, disp) in
        let _ = a64_ldr(b, 16, 16, 0) in
        let _ = a64_br(b, 16) in
        stub(i + 1) in
    stub(0)

let emit_cplt_rv(b) =
  let xs = cimport_names(0) in
  let n = len(xs) in
  if n == 0 then 0
  else
    let pad8(_) =
      if band(bytes_len(b), 7) == 0 then 0
      else let _ = bytes_append(b, 0) in pad8(0) in
    let _ = pad8(0) in
    let got = bytes_len(b) in
    let _ = list_set(cimport_buf(0), 2, got) in
    let fill(i, lim) =
      if i >= lim then 0
      else let _ = bytes_append(b, 0) in fill(i + 1, lim) in
    let _ = fill(0, (3 + n) * 8) in
    let plts = nth(cimport_buf(0), 1) in
    let stub(i) =
      if i >= n then 0
      else
        let _ = list_push(plts, bytes_len(b)) in
        let slot = got + 24 + i * 8 in
        let delta = slot - bytes_len(b) in
        let hi = bshr(delta + 2048, 12) in
        let lo = delta - bshl(hi, 12) in
        let _ = rv_auipc(b, 28, hi) in
        let _ = rv_ld(b, 28, 28, lo) in
        let _ = rv_jalr(b, 0, 28, 0) in
        stub(i + 1) in
    stub(0)

/* JIT: no ld.so. Fill GOT via dlsym(RTLD_DEFAULT). */
let cimport_jit_fill(i, n, xs, b, got) =
  if i >= n then 0
  else
    let p = ccall("dlsym", 0, nth(xs, i)) in
    let _ = apply_u64(b, got + 24 + i * 8, p) in
    cimport_jit_fill(i + 1, n, xs, b, got)

let cimport_jit_bind(code) =
  let n = cimport_n(0) in
  if n == 0 then 0
  else cimport_jit_fill(0, n, cimport_names(0), code, cimport_got(0))

/* Call-site stack maps: [ret_off, nslots]. nslots is the caller's frame. */
let smap_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let smap_buf(_) =
  let v = box_get(smap_box) in
  if v == 0 then
    let l = list_new() in
    let _ = box_set(smap_box, l) in
    l
  else v

let smap_reset(_) =
  let c = smap_buf(0) in
  if len(c) == 0 then
    let _ = list_push(c, 0) in
    list_push(c, list_new())
  else
    let _ = list_set(c, 0, 0) in
    list_set(c, 1, list_new())

let smap_set_nslots(n) =
  let c = smap_buf(0) in
  let _ = if len(c) == 0 then smap_reset(0) else 0 in
  list_set(c, 0, n)

let smap_note(ret_off) =
  let c = smap_buf(0) in
  let _ = if len(c) < 2 then smap_reset(0) else 0 in
  list_push(nth(c, 1), [ret_off, nth(c, 0)])

let smap_recs(_) =
  let c = smap_buf(0) in
  if len(c) < 2 then list_new() else nth(c, 1)

/* Unique STR objects in the image (not yac_alloc). Same content => same ptr
 * so native == is pointer-eq. GC only walks gc_head; pool is in the ELF. */
let strlit_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let strlit_buf(_) =
  let v = box_get(strlit_box) in
  if v == 0 then
    let l = list_new() in
    let _ = box_set(strlit_box, l) in
    l
  else v

let strlit_pool_reset(_) =
  let m = fmap_new(0) in
  let _ = fmap_init_n(m, 2048) in
  let c = strlit_buf(0) in
  if len(c) == 0 then
    let _ = list_push(c, m) in
    list_push(c, bytes_new())
  else
    let _ = list_set(c, 0, m) in
    list_set(c, 1, bytes_new())

let strlit_pad8(b) =
  if band(bytes_len(b), 7) == 0 then 0
  else
    let _ = bytes_append(b, 0) in
    strlit_pad8(b)

let strlit_u64(b, v) =
  let _ = bytes_append(b, band(v, 255)) in
  let _ = bytes_append(b, band(bshr(v, 8), 255)) in
  let _ = bytes_append(b, band(bshr(v, 16), 255)) in
  let _ = bytes_append(b, band(bshr(v, 24), 255)) in
  let _ = bytes_append(b, band(bshr(v, 32), 255)) in
  let _ = bytes_append(b, band(bshr(v, 40), 255)) in
  let _ = bytes_append(b, band(bshr(v, 48), 255)) in
  bytes_append(b, band(bshr(v, 56), 255))

let strlit_put_bytes(b, s, i, n) =
  if i >= n then bytes_append(b, 0)
  else
    let _ = bytes_append(b, str_ref(s, i)) in
    strlit_put_bytes(b, s, i + 1, n)

let strlit_off(s) =
  let c = strlit_buf(0) in
  let _ = if len(c) == 0 then strlit_pool_reset(0) else 0 in
  let m = nth(c, 0) in
  let key = intern(s) in
  let e = fmap_get(m, key) in
  if e != 0 then e - 1
  else
    let buf = nth(strlit_buf(0), 1) in
    let _ = strlit_pad8(buf) in
    let off = bytes_len(buf) in
    let n = str_len(s) in
    let _ = strlit_u64(buf, 0) in
    let _ = strlit_u64(buf, 0) in
    let _ = strlit_u64(buf, 3) in
    let _ = strlit_u64(buf, n) in
    let _ = strlit_put_bytes(buf, s, 0, n) in
    let _ = strlit_pad8(buf) in
    let _ = fmap_put(m, key, off + 1) in
    off

let strlit_bytes(_) =
  let c = strlit_buf(0) in
  if len(c) < 2 then bytes_new() else nth(c, 1)

let smap_emit_table(b, extra) =
  let recs = smap_recs(0) in
  let nr = len(recs) in
  let start = bytes_len(b) in
  let _ = strlit_u64(b, nr) in
  let putr(i) =
    if i >= nr then 0
    else
      let e = nth(recs, i) in
      let pos = bytes_len(b) in
      let _ = strlit_u64(b, 0) in
      let _ = list_push(extra, [12, pos, nth(e, 0)]) in
      let _ = strlit_u64(b, nth(e, 1)) in
      putr(i + 1) in
  let _ = putr(0) in
  start

let emit_st4(st, b, cur, labels, ps) =
  [b, cur, labels, ps, nth(st, 4)]

let patches_extend(dst, src) =
  let n = len(src) in
  let loop(i) =
    if i >= n then dst
    else let _ = list_push(dst, nth(src, i)) in loop(i + 1) in
  loop(0)

/* Top-level so ncap=0 and self-call is TCO. Nested resolve(i) in emit_program_x86_64
 * overflows the C stack once nth is O(1) and we actually walk every patch. */
let emit_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let offs = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let tag = nth(p, 0) in
  if tag == 1 then
    apply_patch(b, nth(p, 1), nth(offs, nth(p, 2)))
  else if tag == 2 then
    apply_u64(b, nth(p, 1), codebase + nth(offs, nth(p, 2)))
  else if tag == 3 then
    apply_u64(b, nth(p, 1), globbase)
  else if tag == 4 then
    apply_u64(b, nth(p, 1), globbase + 8)
  else if tag == 5 then
    apply_u64(b, nth(p, 1), globbase + 16)
  else if tag == 6 then
    apply_u64(b, nth(p, 1), globbase + 24)
  else if tag == 7 then
    apply_u64(b, nth(p, 1), globbase + 56)
  else if tag == 8 then
    apply_u64(b, nth(p, 1), globbase + 64)
  else if tag == 11 then
    apply_u64(b, nth(p, 1), nth(st, 4) + nth(p, 2) + 1)
  else if tag == 12 then
    apply_u64(b, nth(p, 1), nth(st, 2) + nth(p, 2))
  else if tag == 14 then
    apply_u64(b, nth(p, 1), nth(st, 2) + nth(st, 5))
  else if tag == 15 then
    apply_patch(b, nth(p, 1), nth(nth(cimport_buf(0), 1), nth(p, 2)))
  else if tag == 16 then
    apply_patch(b, nth(p, 1), box_get(pe_uname_off_box))
  else if tag == 17 then
    apply_patch(b, nth(p, 1), box_get(pe_dlsym_off_box))
  else if tag == 18 then
    apply_patch(b, nth(p, 1), box_get(pe_system_off_box))
  else if tag == 19 then
    apply_patch(b, nth(p, 1), box_get(pe_dlopen_off_box))
  else if tag == 20 then
    apply_patch(b, nth(p, 1), box_get(pe_unimp_off_box))
  else
    0

let emit_resolve_loop(st, ps, i, n) =
  if i >= n then 0
  else
    let _ = emit_resolve_patch(st, nth(ps, i)) in
    emit_resolve_loop(st, ps, i + 1, n)
