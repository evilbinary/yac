/* lower.yac — LIR AST → emit_*（对标 lir_expr：ANF → LIR）.
 *
 * 输入 ast = ["prog", [proc*], entryName]
 * 先 alloc_prog（寄存器分配预留：现在 identity，槽号仍是虚寄存器/
 *   栈槽；以后在这里改写成物理寄存器或 spill），再按 target 调 emit_*。
 * 返回 emit 结果 [code, ...]。
 */

/* vreg s 的 home。现在 = 自己（emit 映 [rbp-8*(s+1)] / FP 帧）。 */
package backend
export lower_expr, drop_unreachable, alloc_prog, lower_program
import lib.map {intern, fmap_new, fmap_init_n, fmap_put, fmap_get}
import front.lir {imap_box}
import back.pack.target {mk_target, target_arch, target_vaddr, target_text_off, target_format, target_shared, target_live}
import back.pack.elf {elf_pic_set, elf_relocs_reset}
import back.emit.emit {emit_unres, emit_unres_set, emit_arch_set, emit_resolve_loop}
import back.emit.emit_x86_64 {emit_program_x86_64}
import back.emit.emit_arm64 {emit_program_arm64, a64_resolve_loop}
import back.emit.emit_riscv64 {emit_program_riscv64, rv_resolve_loop}
import lib.log {log}

let alloc_home(s) = s

let insn_callee(ins) =
  let k = nth(ins, 0) in
  if k == "fcall" then intern(nth(ins, 2))
  else if k == "tcall" then intern(nth(ins, 2))
  else if k == "closure" then intern(nth(ins, 2))
  else 0

/* Kernel runtime_funs stay; emit patches yac_* from opcodes that are not
 * fcall. Stdlib from rt/*.yac is kept only if reachable from _start/_eval. */
let is_kernel_name(n) =
  if str_len(n) >= 4 then
    if str_slice(n, 0, 4) == "yac_" then true
    else if n == "print" then true
    else if n == "print_int" then true
    else if n == "print_val" then true
    else if n == "gc_collect" then true
    else if n == "time_ms" then true
    else if n == "time_ns" then true
    else n == "time_str"
  else
    if n == "print" then true
    else false
let drop_unreachable(funs) =
  let seen = fmap_new(0) in
  let _ = fmap_init_n(seen, 4096) in
  let tab = fmap_new(0) in
  let _ = fmap_init_n(tab, 4096) in
  let rec_index(i) =
    if i >= len(funs) then 0
    else
      let f = nth(funs, i) in
      let _ = fmap_put(tab, intern(nth(f, 1)), f) in
      rec_index(i + 1) in
  let _ = rec_index(0) in
  let q = list_new() in
  let mark(nm) =
    if nm == 0 then 0
    else if fmap_get(seen, nm) != 0 then 0
    else
      let _ = fmap_put(seen, nm, 1) in
      list_push(q, nm) in
  let scan(insns, i) =
    if i >= len(insns) then 0
    else
      let _ = mark(insn_callee(nth(insns, i))) in
      scan(insns, i + 1) in
  let _ = mark(intern("_start")) in
  let _ = mark(intern("_eval")) in
  /* REPL import: keep pkg exports even if this line's _eval does not call them. */
  let im = box_get(imap_box) in
  let rec_im(i) =
    if i >= len(im) then 0
    else
      let _ = mark(intern(nth(nth(im, i), 1))) in
      rec_im(i + 1) in
  let _ = rec_im(0) in
  let rec_wl(i) =
    if i >= len(q) then 0
    else
      let f = fmap_get(tab, nth(q, i)) in
      let _ = if f == 0 then 0 else scan(nth(f, 4), 0) in
      rec_wl(i + 1) in
  let _ = rec_wl(0) in
  let out = list_new() in
  let rec_keep(i) =
    if i >= len(funs) then out
    else
      let f = nth(funs, i) in
      let _ =
        if fmap_get(seen, intern(nth(f, 1))) != 0 then list_push(out, f)
        else if is_kernel_name(nth(f, 1)) then list_push(out, f)
        else 0 in
      rec_keep(i + 1) in
  rec_keep(0)

let alloc_prog(prog) =
  ["prog", drop_unreachable(nth(prog, 1)), nth(prog, 2)]

/* off = extra TEXT VA (REPL append dest). AOT / first map: 0. */
let emit_apply_unres(off) =
  let u = emit_unres(0) in
  if u == 0 then 0
  else
    let rst = nth(u, 0) in
    let extra = nth(u, 1) in
    let arch = if len(u) > 2 then nth(u, 2) else "x86_64" in
    let st =
      if off == 0 then rst
      else if arch == "x86_64" then
        [nth(rst, 0), nth(rst, 1), nth(rst, 2) + off, nth(rst, 3),
         nth(rst, 4) + off, nth(rst, 5)]
      else
        [nth(rst, 0), nth(rst, 1), nth(rst, 2) + off, nth(rst, 3),
         nth(rst, 4), nth(rst, 5) + off] in
    let _ = log("emit", "resolve") in
    let _ =
      if arch == "arm64" then a64_resolve_loop(st, extra, 0)
      else if arch == "riscv64" then rv_resolve_loop(st, extra, 0)
      else emit_resolve_loop(st, extra, 0, len(extra)) in
    emit_unres_set(0)

let emit_by_target(ast, t) =
  let _ =
    elf_pic_set(if target_shared(t) then 1 else 0) in
  let _ = elf_relocs_reset(0) in
  let a = target_arch(t) in
  let _ = emit_arch_set(a) in
  let r =
    if a == "x86_64" then
      emit_program_x86_64(ast, target_vaddr(t), target_text_off(t),
                         target_format(t))
    else if a == "arm64" then
      emit_program_arm64(ast, target_vaddr(t), target_text_off(t),
                         target_format(t))
    else
      emit_program_riscv64(ast, target_vaddr(t), target_text_off(t),
                           target_format(t)) in
  let _ = if target_live(t) then 0 else emit_apply_unres(0) in
  r

let lower_expr(ast, t) = emit_by_target(alloc_prog(ast), t)

let lower_program(ast) = lower_expr(ast, mk_target("x86_64", "elf", "exec"))
