/* macho.yac — 64-bit Mach-O (MH_EXECUTE or MH_DYLIB).
 * Headers padded to text_off (4096); __text follows. vmaddr = vaddr.
 */

package back.pack.macho
export pack_macho_target
import back.pack.target {target_macho_cpusub, target_macho_cputype, target_shared, target_text_off, target_vaddr}
import back.pack.elf {elf_dynexp_get, elf_init_off, elf_relocs_get}

let mo_le16(b, v, i) =
  let _ = bytes_put(b, i + 0, band(v, 255)) in
  let _ = bytes_put(b, i + 1, band(bshr(v, 8), 255)) in
  0

let mo_le32(b, v, i) =
  let _ = bytes_put(b, i + 0, band(v, 255)) in
  let _ = bytes_put(b, i + 1, band(bshr(v, 8), 255)) in
  let _ = bytes_put(b, i + 2, band(bshr(v, 16), 255)) in
  let _ = bytes_put(b, i + 3, band(bshr(v, 24), 255)) in
  0

let mo_le64(b, v, i) =
  let _ = mo_le32(b, band(v, 4294967295), i) in
  let _ = mo_le32(b, bshr(v, 32), i + 4) in
  0

let mo_name16(b, i, s) =
  let n = str_len(s) in
  let loop(j) =
    if j >= 16 then 0
    else
      let ch = if j < n then str_ref(s, j) else 0 in
      let _ = bytes_put(b, i + j, ch) in
      loop(j + 1) in
  loop(0)

let mo_uleb(b, v) =
  if v < 128 then bytes_append(b, v)
  else
    let _ = bytes_append(b, bor(band(v, 127), 128)) in
    mo_uleb(b, bshr(v, 7))

let mo_app_str(b, s, i, n) =
  if i >= n then 0
  else
    let _ = bytes_append(b, str_ref(s, i)) in
    mo_app_str(b, s, i + 1, n)

let macho_finish_dylib(out, t, cmdat) =
  let vaddr = target_vaddr(t) in
  let text_off = target_text_off(t) in
  let ioff = elf_init_off(0) in
  let exps = list_rev(elf_dynexp_get(0)) in
  let nexp = len(exps) in
  let relp = elf_relocs_get(0) in
  let nrel = len(relp) in
  let _ = mo_le32(out, 26, cmdat) in
  let _ = mo_le32(out, 80, cmdat + 4) in
  let initva =
    if ioff == 0 then 0 else vaddr + text_off + ioff in
  let _ = mo_le64(out, initva, cmdat + 8) in
  let _ = mo_le64(out, 0, cmdat + 16) in
  let str_off = bytes_len(out) in
  let _ = bytes_append(out, 0) in
  let name_off = list_new() in
  let addn(i) =
    if i >= nexp then 0
    else
      let _ = list_push(name_off, bytes_len(out) - str_off) in
      let nm = str_cat("_", nth(nth(exps, i), 0)) in
      let _ = mo_app_str(out, nm, 0, str_len(nm)) in
      let _ = bytes_append(out, 0) in
      addn(i + 1) in
  let _ = addn(0) in
  let str_sz = bytes_len(out) - str_off in
  let sym_off = bytes_len(out) in
  let puts(i) =
    if i >= nexp then 0
    else
      let e = nth(exps, i) in
      let at = bytes_len(out) in
      let _ = mo_le32(out, nth(name_off, i), at) in
      let _ = bytes_put(out, at + 4, 15) in
      let _ = bytes_put(out, at + 5, 1) in
      let _ = mo_le16(out, 0, at + 6) in
      let _ = mo_le64(out, vaddr + text_off + nth(e, 1), at + 8) in
      puts(i + 1) in
  let _ = puts(0) in
  let reb = bytes_new() in
  let _ = bytes_append(reb, 17) in
  let putr(i) =
    if i >= nrel then 0
    else
      let _ = bytes_append(reb, 32) in
      let _ = mo_uleb(reb, text_off + nth(relp, i)) in
      let _ = bytes_append(reb, 81) in
      putr(i + 1) in
  let _ = putr(0) in
  let _ = bytes_append(reb, 0) in
  let reb_off = bytes_len(out) in
  let _ = bytes_extend(out, reb) in
  let reb_sz = bytes_len(reb) in
  let _ = mo_le32(out, 2, cmdat + 80) in
  let _ = mo_le32(out, 24, cmdat + 84) in
  let _ = mo_le32(out, sym_off, cmdat + 88) in
  let _ = mo_le32(out, nexp, cmdat + 92) in
  let _ = mo_le32(out, str_off, cmdat + 96) in
  let _ = mo_le32(out, str_sz, cmdat + 100) in
  let _ = mo_le32(out, 2147483682, cmdat + 104) in
  let _ = mo_le32(out, 48, cmdat + 108) in
  let _ = mo_le32(out, reb_off, cmdat + 112) in
  let _ = mo_le32(out, reb_sz, cmdat + 116) in
  let z(i) =
    if i >= 32 then 0
    else
      let _ = mo_le32(out, 0, cmdat + 120 + i) in
      z(i + 4) in
  let _ = z(0) in
  let _ = mo_le32(out, 5, 16) in
  let _ = mo_le32(out, 344, 20) in
  out

let pack_macho_target(t, code) =
  let cputype = target_macho_cputype(t) in
  let cpusub = target_macho_cpusub(t) in
  let vaddr = target_vaddr(t) in
  let text_off = target_text_off(t) in
  let shared = target_shared(t) in
  let code_len = bytes_len(code) in
  let filesz = text_off + code_len in
  let out = bytes_new() in
  let _ = bytes_put(out, text_off - 1, 0) in
  let _ = bytes_put(out, 0, 207) in
  let _ = bytes_put(out, 1, 250) in
  let _ = bytes_put(out, 2, 237) in
  let _ = bytes_put(out, 3, 254) in
  let _ = mo_le32(out, cputype, 4) in
  let _ = mo_le32(out, cpusub, 8) in
  let filetype = if shared then 6 else 2 in
  let _ = mo_le32(out, filetype, 12) in
  let ncmds = 2 in
  let sizeofcmds = if shared then 192 else 176 in
  let _ = mo_le32(out, ncmds, 16) in
  let _ = mo_le32(out, sizeofcmds, 20) in
  let _ = mo_le32(out, 1, 24) in
  let _ = mo_le32(out, 0, 28) in
  let _ = mo_le32(out, 25, 32) in
  let _ = mo_le32(out, 152, 36) in
  let _ = mo_name16(out, 40, "__TEXT") in
  let _ = mo_le64(out, vaddr, 56) in
  let _ = mo_le64(out, filesz, 64) in
  let _ = mo_le64(out, 0, 72) in
  let _ = mo_le64(out, filesz, 80) in
  let _ = mo_le32(out, 7, 88) in
  let _ = mo_le32(out, 7, 92) in
  let _ = mo_le32(out, 1, 96) in
  let _ = mo_le32(out, 0, 100) in
  let _ = mo_name16(out, 104, "__text") in
  let _ = mo_name16(out, 120, "__TEXT") in
  let _ = mo_le64(out, vaddr + text_off, 136) in
  let _ = mo_le64(out, code_len, 144) in
  let _ = mo_le32(out, text_off, 152) in
  let _ = mo_le32(out, 4, 156) in
  let _ = mo_le32(out, 0, 160) in
  let _ = mo_le32(out, 0, 164) in
  let _ = mo_le32(out, 2147484672, 168) in
  let _ = mo_le32(out, 0, 172) in
  let _ = mo_le32(out, 0, 176) in
  let _ = mo_le32(out, 0, 180) in
  let cmdend =
    if shared then
      let _ = mo_le32(out, 13, 184) in
      let _ = mo_le32(out, 40, 188) in
      let _ = mo_le32(out, 24, 192) in
      let _ = mo_le32(out, 0, 196) in
      let _ = mo_le32(out, 65536, 200) in
      let _ = mo_le32(out, 65536, 204) in
      let _ = mo_name16(out, 208, "libyac.dylib") in
      224
    else
      let _ = mo_le32(out, 2147483688, 184) in
      let _ = mo_le32(out, 24, 188) in
      let _ = mo_le64(out, text_off, 192) in
      let _ = mo_le64(out, 0, 200) in
      208 in
  let _ = bytes_extend(out, code) in
  if shared then macho_finish_dylib(out, t, cmdend) else out
