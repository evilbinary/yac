/* elf.yac — ELF64 packer (ET_EXEC or ET_DYN).
 *
 * Exec: ehdr + 1 PT_LOAD, text at 120 (historical).
 * Dylib: ehdr + PT_LOAD + PT_DYNAMIC + DT_NULL, text at 192.
 * p_vaddr / entry use target vaddr + text_off.
 */

let le16(b, v, i) =
  let _ = bytes_put(b, i + 0, band(v, 255)) in
  let _ = bytes_put(b, i + 1, band(bshr(v, 8), 255)) in
  0

let le32(b, v, i) =
  let _ = le16(b, band(v, 65535), i) in
  let _ = le16(b, bshr(v, 16), i + 2) in
  0

let le64(b, v, i) =
  let _ = le32(b, band(v, 4294967295), i) in
  let _ = le32(b, bshr(v, 32), i + 4) in
  0

let E_MACHINE = 62
let LOAD_VADDR = 4194304
let PH_TYPE_LOAD = 1
let PH_TYPE_DYNAMIC = 2
let PH_FLAGS_RWX = 7
let PH_FLAGS_R = 4
let PAGE = 4096
let DT_NULL = 0

let elf_header(b, entry, machine, etype, phnum, flags) =
  let _ = bytes_put(b, 0, 127) in
  let _ = bytes_put(b, 1, 69) in
  let _ = bytes_put(b, 2, 76) in
  let _ = bytes_put(b, 3, 70) in
  let _ = bytes_put(b, 4, 2) in
  let _ = bytes_put(b, 5, 1) in
  let _ = bytes_put(b, 6, 1) in
  let _ = bytes_put(b, 7, 0) in
  let _ = bytes_put(b, 8, 0) in
  let _ = bytes_put(b, 9, 0) in
  let _ = bytes_put(b, 10, 0) in
  let _ = bytes_put(b, 11, 0) in
  let _ = bytes_put(b, 12, 0) in
  let _ = bytes_put(b, 13, 0) in
  let _ = bytes_put(b, 14, 0) in
  let _ = bytes_put(b, 15, 0) in
  let _ = le16(b, etype, 16) in
  let _ = le16(b, machine, 18) in
  let _ = le32(b, 1, 20) in
  let _ = le64(b, entry, 24) in
  let _ = le64(b, 64, 32) in
  let _ = le64(b, 0, 40) in
  let _ = le32(b, flags, 48) in
  let _ = le16(b, 64, 52) in
  let _ = le16(b, 56, 54) in
  let _ = le16(b, phnum, 56) in
  let _ = le16(b, 0, 58) in
  let _ = le16(b, 0, 60) in
  let _ = le16(b, 0, 62) in
  0

/* Native emit only passes 6 args in registers; keep helpers at ≤6 params. */
let elf_phdr_load(b, off, ptype, flags, poff, vaddr) =
  let _ = le32(b, ptype, off) in
  let _ = le32(b, flags, off + 4) in
  let _ = le64(b, poff, off + 8) in
  let _ = le64(b, vaddr, off + 16) in
  let _ = le64(b, vaddr, off + 24) in
  0

let elf_phdr_sizes(b, off, filesz, memsz, align) =
  let _ = le64(b, filesz, off + 32) in
  let _ = le64(b, memsz, off + 40) in
  let _ = le64(b, align, off + 48) in
  0

let pack_elf_exec(code, machine, vaddr, text_off) =
  let entry = vaddr + text_off in
  let file_size = text_off + bytes_len(code) in
  let out = bytes_new() in
  let _ = bytes_put(out, text_off - 1, 0) in
  let _ = elf_header(out, entry, machine, 2, 1, 0) in
  let _ = elf_phdr_load(out, 64, PH_TYPE_LOAD, PH_FLAGS_RWX, 0, vaddr) in
  let _ = elf_phdr_sizes(out, 64, file_size, file_size, PAGE) in
  let _ = bytes_extend(out, code) in
  out

let pack_elf_dyn(code, machine, vaddr, text_off) =
  let dyn_off = 176 in
  let file_size = text_off + bytes_len(code) in
  let entry = vaddr + text_off in
  let dyn_va = vaddr + dyn_off in
  let out = bytes_new() in
  let _ = bytes_put(out, text_off - 1, 0) in
  let _ = elf_header(out, entry, machine, 3, 2, 0) in
  let _ = elf_phdr_load(out, 64, PH_TYPE_LOAD, PH_FLAGS_RWX, 0, vaddr) in
  let _ = elf_phdr_sizes(out, 64, file_size, file_size, PAGE) in
  let _ = elf_phdr_load(out, 120, PH_TYPE_DYNAMIC, PH_FLAGS_R, dyn_off, dyn_va) in
  let _ = elf_phdr_sizes(out, 120, 16, 16, 8) in
  let _ = le64(out, DT_NULL, dyn_off) in
  let _ = le64(out, 0, dyn_off + 8) in
  let _ = bytes_extend(out, code) in
  out

let pack_elf_arch(code, machine) = pack_elf_exec(code, machine, LOAD_VADDR, 120)

let pack_elf(code) = pack_elf_arch(code, E_MACHINE)

let pack_elf_ex(code, machine, vaddr, text_off, shared) =
  if shared != 0 then pack_elf_dyn(code, machine, vaddr, text_off)
  else pack_elf_exec(code, machine, vaddr, text_off)

let PH_TYPE_INTERP = 3
let DT_NEEDED = 1
let DT_PLTRELSZ = 2
let DT_PLTGOT = 3
let DT_HASH = 4
let DT_STRTAB = 5
let DT_SYMTAB = 6
let DT_SYMENT = 11
let DT_PLTREL = 20
let DT_JMPREL = 23
let DT_FLAGS = 30
let DF_BIND_NOW = 8
let DT_RELA = 7
let R_JUMP_SLOT = 7

/* Filled by emit_program_*; pack reads it for .symtab. */
let funsym_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let funsym_set(fo) = box_set(funsym_box, fo)

let funsym_get(_) =
  let v = box_get(funsym_box) in
  if v == 0 then [] else v

let syms_flag_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let syms_enable(on) = box_set(syms_flag_box, on)

let elf_want_syms(_) =
  let v = box_get(syms_flag_box) in
  if v == 0 then false else true

let app8(b, v) = bytes_append(b, band(v, 255))

let app16(b, v) =
  let _ = app8(b, v) in
  app8(b, bshr(v, 8))

let app32(b, v) =
  let _ = app16(b, band(v, 65535)) in
  app16(b, bshr(v, 16))

let app64(b, v) =
  let _ = app32(b, band(v, 4294967295)) in
  app32(b, bshr(v, 32))

let app_str(b, s, i, n) =
  if i >= n then bytes_append(b, 0)
  else
    let _ = bytes_append(b, str_ref(s, i)) in
    app_str(b, s, i + 1, n)

let pad8b(b) =
  if band(bytes_len(b), 7) == 0 then 0
  else
    let _ = bytes_append(b, 0) in
    pad8b(b)

let elf_shdr_nt(b, off, name, typ) =
  let _ = le32(b, name, off) in
  le32(b, typ, off + 4)

let elf_shdr_fa(b, off, flags, addr) =
  let _ = le64(b, flags, off + 8) in
  le64(b, addr, off + 16)

let elf_shdr_os(b, off, shoff, size) =
  let _ = le64(b, shoff, off + 24) in
  le64(b, size, off + 32)

let elf_shdr_li(b, off, link, info) =
  let _ = le32(b, link, off + 40) in
  le32(b, info, off + 44)

let elf_shdr_ae(b, off, align, entsz) =
  let _ = le64(b, align, off + 48) in
  le64(b, entsz, off + 56)

let elf_z24(b, i) =
  if i >= 24 then 0
  else
    let _ = bytes_append(b, 0) in
    elf_z24(b, i + 1)

let elf_append_debug(out, vaddr, text_off, code_len, funs) =
  let xs = list_rev(funs) in
  let n = len(xs) in
  let _ = pad8b(out) in
  let str_off = bytes_len(out) in
  let _ = bytes_append(out, 0) in
  let names = list_new() in
  let addn(i) =
    if i >= n then 0
    else
      let s = nth(nth(xs, i), 0) in
      let _ = list_push(names, bytes_len(out) - str_off) in
      let _ = app_str(out, s, 0, str_len(s)) in
      addn(i + 1) in
  let _ = addn(0) in
  let str_sz = bytes_len(out) - str_off in
  let _ = pad8b(out) in
  let sym_off = bytes_len(out) in
  let _ = elf_z24(out, 0) in
  let rec(i) =
    if i >= n then 0
    else
      let e = nth(xs, i) in
      let off = nth(e, 1) in
      let nxt = if i + 1 >= n then code_len else nth(nth(xs, i + 1), 1) in
      let sz = nxt - off in
      let sz2 = if sz < 0 then 0 else sz in
      let _ = app32(out, nth(names, i)) in
      let _ = bytes_append(out, 18) in
      let _ = bytes_append(out, 0) in
      let _ = app16(out, 1) in
      let _ = app64(out, (vaddr + text_off) + off) in
      let _ = app64(out, sz2) in
      rec(i + 1) in
  let _ = rec(0) in
  let sym_sz = bytes_len(out) - sym_off in
  let shstr_off = bytes_len(out) in
  let _ = bytes_append(out, 0) in
  let _ = app_str(out, ".text", 0, 5) in
  let _ = app_str(out, ".symtab", 0, 7) in
  let _ = app_str(out, ".strtab", 0, 7) in
  let _ = app_str(out, ".shstrtab", 0, 9) in
  let shstr_sz = bytes_len(out) - shstr_off in
  let shoff = bytes_len(out) in
  let _ = bytes_put(out, shoff + 320 - 1, 0) in
  let text_va = vaddr + text_off in
  let _ = elf_shdr_nt(out, shoff + 64, 1, 1) in
  let _ = elf_shdr_fa(out, shoff + 64, 7, text_va) in
  let _ = elf_shdr_os(out, shoff + 64, text_off, code_len) in
  let _ = elf_shdr_li(out, shoff + 64, 0, 0) in
  let _ = elf_shdr_ae(out, shoff + 64, 16, 0) in
  let _ = elf_shdr_nt(out, shoff + 128, 7, 2) in
  let _ = elf_shdr_fa(out, shoff + 128, 0, 0) in
  let _ = elf_shdr_os(out, shoff + 128, sym_off, sym_sz) in
  let _ = elf_shdr_li(out, shoff + 128, 3, 1) in
  let _ = elf_shdr_ae(out, shoff + 128, 8, 24) in
  let _ = elf_shdr_nt(out, shoff + 192, 15, 3) in
  let _ = elf_shdr_fa(out, shoff + 192, 0, 0) in
  let _ = elf_shdr_os(out, shoff + 192, str_off, str_sz) in
  let _ = elf_shdr_li(out, shoff + 192, 0, 0) in
  let _ = elf_shdr_ae(out, shoff + 192, 1, 0) in
  let _ = elf_shdr_nt(out, shoff + 256, 23, 3) in
  let _ = elf_shdr_fa(out, shoff + 256, 0, 0) in
  let _ = elf_shdr_os(out, shoff + 256, shstr_off, shstr_sz) in
  let _ = elf_shdr_li(out, shoff + 256, 0, 0) in
  let _ = elf_shdr_ae(out, shoff + 256, 1, 0) in
  let _ = le64(out, shoff, 40) in
  let _ = le16(out, 64, 58) in
  let _ = le16(out, 5, 60) in
  let _ = le16(out, 4, 62) in
  out

let elf_maybe_debug(out, vaddr, text_off, code_len) =
  if elf_want_syms(0) then
    elf_append_debug(out, vaddr, text_off, code_len, funsym_get(0))
  else out

let dyn_pair(b, tag, val) =
  let _ = app64(b, tag) in
  app64(b, val)

let elf_interp(machine) =
  if machine == 62 then "/lib64/ld-linux-x86-64.so.2"
  else if machine == 183 then "/lib/ld-linux-aarch64.so.1"
  else "/lib/ld-linux-riscv64-lp64d.so.1"

let elf_jump_reloc(machine) =
  if machine == 62 then 7
  else if machine == 183 then 1026
  else 5

let pack_elf_libc(code, machine, vaddr, text_off, names, got_off) =
  let n = len(names) in
  let out = pack_elf_exec(code, machine, vaddr, text_off) in
  let interp = elf_interp(machine) in
  let rtype = elf_jump_reloc(machine) in
  let interp_off = bytes_len(out) in
  let _ = app_str(out, interp, 0, str_len(interp)) in
  let _ = pad8b(out) in
  let dynstr_off = bytes_len(out) in
  let _ = bytes_append(out, 0) in
  let name_off(i, acc) =
    if i >= n then acc
    else
      let o = bytes_len(out) - dynstr_off in
      let _ = app_str(out, nth(names, i), 0, str_len(nth(names, i))) in
      name_off(i + 1, cons(o, acc)) in
  let offs_rev = name_off(0, []) in
  let libc_off = bytes_len(out) - dynstr_off in
  let _ = app_str(out, "libc.so.6", 0, 9) in
  let dynstr_sz = bytes_len(out) - dynstr_off in
  let str_off(i) = nth(offs_rev, n - 1 - i) in
  let _ = pad8b(out) in
  let dynsym_off = bytes_len(out) in
  let zsym(i) =
    if i >= 24 then 0
    else let _ = bytes_append(out, 0) in zsym(i + 1) in
  let _ = zsym(0) in
  let put_sym(i) =
    if i >= n then 0
    else
      let _ = app32(out, str_off(i)) in
      let _ = bytes_append(out, 18) in
      let _ = bytes_append(out, 0) in
      let _ = app16(out, 0) in
      let _ = app64(out, 0) in
      let _ = app64(out, 0) in
      put_sym(i + 1) in
  let _ = put_sym(0) in
  let hash_off = bytes_len(out) in
  let nsyms = n + 1 in
  let _ = app32(out, 1) in
  let _ = app32(out, nsyms) in
  let _ = app32(out, 1) in
  let chain(i) =
    if i >= nsyms then 0
    else
      let nxt = if i == 0 then 0 else if i == n then 0 else i + 1 in
      let _ = app32(out, nxt) in
      chain(i + 1) in
  let _ = chain(0) in
  let _ = pad8b(out) in
  let rela_off = bytes_len(out) in
  let put_rela(i) =
    if i >= n then 0
    else
      let roff = vaddr + text_off + got_off + 24 + i * 8 in
      let info = bshl(i + 1, 32) + rtype in
      let _ = app64(out, roff) in
      let _ = app64(out, info) in
      let _ = app64(out, 0) in
      put_rela(i + 1) in
  let _ = put_rela(0) in
  let dyn_off = bytes_len(out) in
  let va(off) = vaddr + off in
  let _ = dyn_pair(out, DT_NEEDED, libc_off) in
  let _ = dyn_pair(out, DT_HASH, va(hash_off)) in
  let _ = dyn_pair(out, DT_STRTAB, va(dynstr_off)) in
  let _ = dyn_pair(out, DT_SYMTAB, va(dynsym_off)) in
  let _ = dyn_pair(out, DT_SYMENT, 24) in
  let _ = dyn_pair(out, 10, dynstr_sz) in
  let _ = dyn_pair(out, DT_PLTGOT, va(text_off + got_off)) in
  let _ = dyn_pair(out, DT_PLTRELSZ, n * 24) in
  let _ = dyn_pair(out, DT_PLTREL, DT_RELA) in
  let _ = dyn_pair(out, DT_JMPREL, va(rela_off)) in
  let _ = dyn_pair(out, DT_FLAGS, DF_BIND_NOW) in
  let _ = dyn_pair(out, DT_NULL, 0) in
  let dyn_sz = bytes_len(out) - dyn_off in
  let ph_off = bytes_len(out) in
  let file_size = ph_off + 168 in
  let _ = bytes_put(out, file_size - 1, 0) in
  let _ = elf_phdr_load(out, ph_off, PH_TYPE_LOAD, PH_FLAGS_RWX, 0, vaddr) in
  let _ = elf_phdr_sizes(out, ph_off, file_size, file_size, PAGE) in
  let _ = elf_phdr_load(out, ph_off + 56, PH_TYPE_INTERP, PH_FLAGS_R, interp_off, va(interp_off)) in
  let _ = elf_phdr_sizes(out, ph_off + 56, str_len(interp) + 1, str_len(interp) + 1, 1) in
  let _ = elf_phdr_load(out, ph_off + 112, PH_TYPE_DYNAMIC, PH_FLAGS_R, dyn_off, va(dyn_off)) in
  let _ = elf_phdr_sizes(out, ph_off + 112, dyn_sz, dyn_sz, 8) in
  let _ = le64(out, ph_off, 32) in
  let _ = le16(out, 3, 56) in
  let _ = le64(out, va(dyn_off), text_off + got_off) in
  elf_maybe_debug(out, vaddr, text_off, bytes_len(code))

