/* dlib.yac — aliases for PIC/export state defined in elf.yac.
 * Keep this file after elf.yac in the compiler cat order.
 */

package back.pack.dlib
export dlib_dynexp_set, dlib_dynexp_get, dlib_init_off_set, dlib_init_off, dlib_pic_set, dlib_pic, dlib_relocs_reset, dlib_relocs_get, dlib_note_abs64
import back.pack.elf {elf_dynexp_get, elf_dynexp_set, elf_init_off, elf_init_off_set, elf_note_abs64, elf_pic, elf_pic_set, elf_relocs_get, elf_relocs_reset}

let dlib_dynexp_set(v) = elf_dynexp_set(v)
let dlib_dynexp_get(_) = elf_dynexp_get(0)
let dlib_init_off_set(n) = elf_init_off_set(n)
let dlib_init_off(_) = elf_init_off(0)
let dlib_pic_set(on) = elf_pic_set(on)
let dlib_pic(_) = elf_pic(0)
let dlib_relocs_reset(_) = elf_relocs_reset(0)
let dlib_relocs_get(_) = elf_relocs_get(0)
let dlib_note_abs64(pos) = elf_note_abs64(pos)
