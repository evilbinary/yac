/* yjit.yac — Yac JIT image (docs/JIT_IMAGE.md). Not ELF.
 * File: 64-byte hdr + TEXT [+ RODATA + DATA + LINK].
 * v1 pack treats the emit blob as a single TEXT section. */

package pack
export pack_yjit_ex, pack_yjit_flat, yjit_arch_num, yjit_arch_name, yjit_read, yjit_export_enc, yjit_export_dec, yjit_imp_enc, yjit_imp_parse

let YJIT_HDR = 64
let YJIT_VER = 1
let YJIT_ARCH_X64 = 1
let YJIT_ARCH_A64 = 2
let YJIT_ARCH_RV = 3
let YJIT_SEG_TEXT = 1
let YJIT_SEG_RO = 2
let YJIT_SEG_DATA = 3
let YJIT_REL_REL32 = 1
let YJIT_REL_ABS32 = 2
let YJIT_REL_DATA64 = 3
let YJIT_REL_STR = 4
let YJIT_REL_TEXT64 = 5
let YJIT_REL_PLT = 6
let YJIT_SYM_NONE = 4294967295
let JIT_TEXT_CAP = 16777216

let yjit_arch_num(a) =
  if a == "arm64" then 2
  else if a == "riscv64" then 3
  else 1

let yjit_hdr_zeros(out) =
  let _ = bytes_put(out, 63, 0) in
  0

/* h = [arch, abi, flags, base, entry, t_off, t_sz, r_off, r_sz, d_off, d_sz, l_off, l_sz] */
let yjit_hdr_write(out, h) =
  let _ = bytes_put(out, 0, 89) in
  let _ = bytes_put(out, 1, 74) in
  let _ = bytes_put(out, 2, 73) in
  let _ = bytes_put(out, 3, 84) in
  let _ = le16(out, 1, 4) in
  let _ = le16(out, nth(h, 0), 6) in
  let _ = le16(out, nth(h, 1), 8) in
  let _ = le16(out, nth(h, 2), 10) in
  let _ = le32(out, 64, 12) in
  let _ = le64(out, nth(h, 3), 16) in
  let _ = le32(out, nth(h, 4), 24) in
  let _ = le32(out, 0, 28) in
  let _ = le32(out, nth(h, 5), 32) in
  let _ = le32(out, nth(h, 6), 36) in
  let _ = le32(out, nth(h, 7), 40) in
  let _ = le32(out, nth(h, 8), 44) in
  let _ = le32(out, nth(h, 9), 48) in
  let _ = le32(out, nth(h, 10), 52) in
  let _ = le32(out, nth(h, 11), 56) in
  let _ = le32(out, nth(h, 12), 60) in
  0

let yjit_app8(b, v) = bytes_append(b, band(v, 255))

let yjit_app16(b, v) =
  let _ = yjit_app8(b, v) in
  yjit_app8(b, bshr(v, 8))

let yjit_app32(b, v) =
  let _ = yjit_app16(b, v) in
  yjit_app16(b, bshr(v, 16))

/* rest = [abi, base, entry, data_rel] or + link + flags.
 * flags bit0: LINK starts with import table (n, got, names) then exports. */
let pack_yjit_ex(code, arch, rest) =
  let n = bytes_len(code) in
  let link = if len(rest) > 4 then nth(rest, 4) else bytes_new() in
  let ln = bytes_len(link) in
  let flags = if len(rest) > 5 then nth(rest, 5) else 0 in
  let loff = 64 + n in
  let out = bytes_new() in
  let _ = yjit_hdr_zeros(out) in
  let _ = yjit_hdr_write(out,
    [arch, nth(rest, 0), flags, nth(rest, 1), nth(rest, 2),
     64, n, 64 + n, 0, 64 + n, 0, loff, ln]) in
  let _ = le32(out, nth(rest, 3), 28) in
  let _ = bytes_extend(out, code) in
  let _ = if ln == 0 then 0 else bytes_extend(out, link) in
  out

let pack_yjit_flat(code, arch, abi, base, entry) =
  pack_yjit_ex(code, arch, [abi, base, entry, 0])

let yjit_magic_ok(b) =
  if bytes_len(b) < 4 then false
  else if bytes_ref(b, 0) != 89 then false
  else if bytes_ref(b, 1) != 74 then false
  else if bytes_ref(b, 2) != 73 then false
  else bytes_ref(b, 3) == 84

let yjit_arch_name(n) =
  if n == 2 then "arm64"
  else if n == 3 then "riscv64"
  else "x86_64"

let ld16(b, i) = bytes_ref(b, i) + bshl(bytes_ref(b, i + 1), 8)

let ld32(b, i) = ld16(b, i) + bshl(ld16(b, i + 2), 16)

let bytes_from_str(s, i, n, b) =
  if i >= n then b
  else
    let _ = bytes_append(b, str_ref(s, i)) in
    bytes_from_str(s, i + 1, n, b)

let bytes_copy_range(src, off, n, i, dst) =
  if i >= n then dst
  else
    let _ = bytes_append(dst, bytes_ref(src, off + i)) in
    bytes_copy_range(src, off, n, i + 1, dst)

/* Skip-map LINK: u32 n; n × { u32 off+1, u16 nlen, name }. */
let yjit_export_walk(vec, i, cap, b, n) =
  if i >= cap then n
  else
    let e = nth(vec, i) in
    let n2 =
      if e == 0 then n
      else
        let k = nth(e, 0) in
        let nl = str_len(k) in
        let _ = yjit_app32(b, nth(e, 1)) in
        let _ = yjit_app16(b, nl) in
        let _ = bytes_from_str(k, 0, nl, b) in
        n + 1 in
    yjit_export_walk(vec, i + 1, cap, b, n2)

let yjit_export_enc(m) =
  let b = bytes_new() in
  let _ = yjit_app32(b, 0) in
  let cap = nth(m, 2) in
  let n =
    if fmap_cap_ok(cap) then yjit_export_walk(nth(m, 0), 0, cap, b, 0)
    else 0 in
  let _ = le32(b, n, 0) in
  b

let yjit_export_dec(link) =
  let m = fmap_new(0) in
  let _ = fmap_init_n(m, 4096) in
  let ln = bytes_len(link) in
  if ln < 4 then m
  else
    let n = ld32(link, 0) in
    let rec(i, off) =
      if i >= n then m
      else if off + 6 > ln then m
      else
        let v = ld32(link, off) in
        let nl = ld16(link, off + 4) in
        if off + 6 + nl > ln then m
        else
          let k = bytes_to_str(bytes_copy_range(link, off + 6, nl, 0, bytes_new())) in
          let _ = fmap_put(m, intern(k), v) in
          rec(i + 1, off + 6 + nl) in
    rec(0, 4)

/* Import LINK prefix: u32 n, u32 got_off; n × { u16 nlen, name }. */
let yjit_imp_enc(got, xs) =
  let b = bytes_new() in
  let n = len(xs) in
  let _ = yjit_app32(b, n) in
  let _ = yjit_app32(b, got) in
  let rec(i) =
    if i >= n then 0
    else
      let k = nth(xs, i) in
      let nl = str_len(k) in
      let _ = yjit_app16(b, nl) in
      let _ = bytes_from_str(k, 0, nl, b) in
      rec(i + 1) in
  let _ = rec(0) in
  b

/* [got, names, byte_off after names]. */
let yjit_imp_parse(link) =
  let ln = bytes_len(link) in
  let xs = list_new() in
  if ln < 8 then [0, xs, 0]
  else
    let n = ld32(link, 0) in
    let got = ld32(link, 4) in
    let rec(i, off) =
      if i >= n then off
      else if off + 2 > ln then off
      else
        let nl = ld16(link, off) in
        if off + 2 + nl > ln then off
        else
          let k = bytes_to_str(bytes_copy_range(link, off + 2, nl, 0, bytes_new())) in
          let _ = list_push(xs, k) in
          rec(i + 1, off + 2 + nl) in
    [got, xs, rec(0, 8)]

/* 0 or [arch, abi, entry, data_rel, text, link, flags] */
let yjit_parse(b) =
  if bytes_len(b) < 64 then 0
  else if yjit_magic_ok(b) == false then 0
  else
    let toff = ld32(b, 32) in
    let tsz = ld32(b, 36) in
    let loff = ld32(b, 56) in
    let lsz = ld32(b, 60) in
    let nb = bytes_len(b) in
    if toff + tsz > nb then 0
    else if lsz > 0 then
      if loff + lsz > nb then 0
      else
        [ld16(b, 6), ld16(b, 8), ld32(b, 24), ld32(b, 28),
         bytes_copy_range(b, toff, tsz, 0, bytes_new()),
         bytes_copy_range(b, loff, lsz, 0, bytes_new()),
         ld16(b, 10)]
    else
      [ld16(b, 6), ld16(b, 8), ld32(b, 24), ld32(b, 28),
       bytes_copy_range(b, toff, tsz, 0, bytes_new()),
       bytes_new(),
       ld16(b, 10)]

let yjit_read(path) =
  let s = read_file(path) in
  if s == 0 then 0
  else yjit_parse(bytes_from_str(s, 0, str_len(s), bytes_new()))
