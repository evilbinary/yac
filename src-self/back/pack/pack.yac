/* pack.yac — container dispatch: elf | pe | macho (exec or dylib). */

package pack
export pack_image, pack_elf_target
import back.pe
import back.elf
import back.macho

let pack_elf_target(t, code) =
  let sh = if target_shared(t) then 1 else 0 in
  let img = pack_elf_ex(code, target_emachine(t), target_vaddr(t),
                        target_text_off(t), sh) in
  elf_maybe_debug(img, target_vaddr(t), target_text_off(t), bytes_len(code))

let pack_image(t, code) =
  let fmt = target_format(t) in
  if fmt == "elf" then pack_elf_target(t, code)
  else if fmt == "pe" then pack_pe_target(t, code)
  else if fmt == "macho" then pack_macho_target(t, code)
  else if fmt == "yjit" then
    pack_yjit_flat(code, yjit_arch_num(target_arch(t)), 0,
                   target_vaddr(t), 0)
  else pack_elf_target(t, code)
