/* encode_arm64.yac — AArch64 instruction words (little-endian). */

package back.encode.encode_arm64
export a64_u32, a64_u32_at, a64_movz, a64_movk, a64_mov_imm64_at, a64_mov_imm64, a64_add_imm, a64_sub_imm, a64_add_reg, a64_sub_reg, a64_mul, a64_sdiv, a64_msub, a64_and_reg, a64_orr_reg, a64_eor_reg, a64_mov_reg, a64_mov_sp, a64_nop_at, a64_adrp_at, a64_ldr_at, a64_ldr, a64_str, a64_lsl1, a64_lslv, a64_lsrv, a64_mvn, a64_asr1, a64_cmp_reg, a64_cmp_imm, a64_ldrb, a64_strb, a64_ldrb_reg, a64_strb_reg, a64_ldr_lsl3, a64_word, a64_patch_bcond, a64_stur, a64_ldur, a64_stp_fp_lr, a64_ldp_fp_lr, a64_ret, a64_b, a64_b_cond, a64_b_eq, a64_b_ne, a64_bl, a64_adr, a64_blr, a64_br, a64_svc, a64_brk, a64_fmov_d_x, a64_fmov_x_d, a64_scvtf_d_x, a64_fadd_d, a64_fsub_d, a64_fmul_d, a64_fdiv_d, a64_fcmp_d, a64_cset

let a64_u32(b, w) =
  let _ = bytes_append(b, band(w, 255)) in
  let _ = bytes_append(b, band(bshr(w, 8), 255)) in
  let _ = bytes_append(b, band(bshr(w, 16), 255)) in
  let _ = bytes_append(b, band(bshr(w, 24), 255)) in
  0

let a64_u32_at(b, pos, w) =
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

/* 0xD2800000 MOVZ Xd,#imm,LSL #(hw*16) */
let a64_movz(b, rd, imm16, hw) =
  a64_u32(b, 3531603968 + bshl(hw, 21) + bshl(band(imm16, 65535), 5) + rd)

/* 0xF2800000 MOVK */
let a64_movk(b, rd, imm16, hw) =
  a64_u32(b, 4068474880 + bshl(hw, 21) + bshl(band(imm16, 65535), 5) + rd)

let a64_mov_imm64_at(b, pos, rd, v) =
  let _ = a64_u32_at(b, pos, 3531603968 + bshl(band(v, 65535), 5) + rd) in
  let _ = a64_u32_at(b, pos + 4, 4068474880 + bshl(1, 21) + bshl(band(bshr(v, 16), 65535), 5) + rd) in
  let _ = a64_u32_at(b, pos + 8, 4068474880 + bshl(2, 21) + bshl(band(bshr(v, 32), 65535), 5) + rd) in
  a64_u32_at(b, pos + 12, 4068474880 + bshl(3, 21) + bshl(band(bshr(v, 48), 65535), 5) + rd)

let a64_mov_imm64(b, rd, v) =
  let _ = a64_movz(b, rd, band(v, 65535), 0) in
  let _ = a64_movk(b, rd, band(bshr(v, 16), 65535), 1) in
  let _ = a64_movk(b, rd, band(bshr(v, 32), 65535), 2) in
  a64_movk(b, rd, band(bshr(v, 48), 65535), 3)

/* 0x91000000 ADD Xd,Xn,#imm12 */
let a64_add_imm(b, rd, rn, imm12) =
  a64_u32(b, 2432696320 + bshl(band(imm12, 4095), 10) + bshl(rn, 5) + rd)

/* 0xD1000000 SUB Xd,Xn,#imm12 */
let a64_sub_imm(b, rd, rn, imm12) =
  a64_u32(b, 3506438144 + bshl(band(imm12, 4095), 10) + bshl(rn, 5) + rd)

/* 0x8B000000 ADD Xd,Xn,Xm */
let a64_add_reg(b, rd, rn, rm) =
  a64_u32(b, 2332033024 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0xCB000000 SUB Xd,Xn,Xm */
let a64_sub_reg(b, rd, rn, rm) =
  a64_u32(b, 3405774848 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0x9B007C00 MUL */
let a64_mul(b, rd, rn, rm) =
  a64_u32(b, 2600500224 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0x9AC00C00 SDIV */
let a64_sdiv(b, rd, rn, rm) =
  a64_u32(b, 2596277248 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0x9B008000 MSUB  Xd = Xa - Xn*Xm */
let a64_msub(b, rd, rn, rm, ra) =
  a64_u32(b, 2600501248 + bshl(rm, 16) + bshl(ra, 10) + bshl(rn, 5) + rd)

/* 0x8A000000 AND */
let a64_and_reg(b, rd, rn, rm) =
  a64_u32(b, 2315255808 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0xAA000000 ORR Xd,Xn,Xm */
let a64_orr_reg(b, rd, rn, rm) =
  a64_u32(b, 2852126720 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* 0xCA000000 EOR Xd,Xn,Xm */
let a64_eor_reg(b, rd, rn, rm) =
  a64_u32(b, 3388997632 + bshl(rm, 16) + bshl(rn, 5) + rd)

/* MOV Xd,Xm = ORR Xd,XZR,Xm  0xAA0003E0 — Xm must not be SP. */
let a64_mov_reg(b, rd, rm) =
  a64_u32(b, 2852127712 + bshl(rm, 16) + rd)

/* MOV involving SP is ADD #0 (ORR treats 31 as XZR). */
let a64_mov_sp(b, rd, rn) = a64_add_imm(b, rd, rn, 0)

/* LDR Xt,[Xn,#off] unsigned, off multiple of 8. */
let a64_nop_at(b, pos) = a64_u32_at(b, pos, 3573751839)

/* ADRP Xd, #imm21 pages. imm is signed page count. */
let a64_adrp_at(b, pos, rd, imm21) =
  let i = band(imm21, 2097151) in
  a64_u32_at(b, pos, 2415919104 + bshl(band(i, 3), 29) + bshl(bshr(i, 2), 5) + rd)

let a64_ldr_at(b, pos, rt, rn, off) =
  a64_u32_at(b, pos, 4181721088 + bshl(band(bshr(off, 3), 4095), 10)
             + bshl(rn, 5) + rt)

let a64_ldr(b, rt, rn, off) =
  a64_u32(b, 4181721088 + bshl(band(bshr(off, 3), 4095), 10) + bshl(rn, 5) + rt)

/* STR Xt,[Xn,#imm12*8]  0xF9000000 */
let a64_str(b, rt, rn, off) =
  a64_u32(b, 4177526784 + bshl(band(bshr(off, 3), 4095), 10) + bshl(rn, 5) + rt)

let a64_lsl1(b, rd, rn) = a64_add_reg(b, rd, rn, rn)

/* LSLV Xd,Xn,Xm  0x9AC02000 */
let a64_lslv(b, rd, rn, rm) =
  a64_u32(b, 2596282368 + bshl(rm, 16) + bshl(rn, 5) + rd)
/* LSRV Xd,Xn,Xm  0x9AC02400 */
let a64_lsrv(b, rd, rn, rm) =
  a64_u32(b, 2596283392 + bshl(rm, 16) + bshl(rn, 5) + rd)
/* MVN Xd,Xm = ORN Xd,XZR,Xm  0xAA2003E0 */
let a64_mvn(b, rd, rm) =
  a64_u32(b, 2854224864 + bshl(rm, 16) + rd)

/* ASR #1: ADD Xd, XZR, Xn, ASR #1  (0x8B800400 + Rn<<16 + Rd). SBFM immediates are qemu-sensitive. */
let a64_asr1(b, rd, rn) =
  a64_u32(b, 2340422656 + bshl(rn, 16) + 992 + rd)

/* CMP Xn,Xm = SUBS XZR,Xn,Xm  0xEB00001F */
let a64_cmp_reg(b, rn, rm) =
  a64_u32(b, 3942645760 + bshl(rm, 16) + bshl(rn, 5) + 31)

/* CMP Xn,#imm12 = SUBS XZR,Xn,#imm  0xF100001F */
let a64_cmp_imm(b, rn, imm12) =
  a64_u32(b, 4043309087 + bshl(band(imm12, 4095), 10) + bshl(rn, 5))

/* LDRB Wt,[Xn]  0x39400000 */
let a64_ldrb(b, rt, rn) = a64_u32(b, 960495616 + bshl(rn, 5) + rt)
/* STRB Wt,[Xn]  0x39000000 */
let a64_strb(b, rt, rn) = a64_u32(b, 956301312 + bshl(rn, 5) + rt)
/* LDRB Wt,[Xn,Xm]  0x38606800 */
let a64_ldrb_reg(b, rt, rn, rm) =
  a64_u32(b, 945842176 + bshl(rm, 16) + bshl(rn, 5) + rt)
/* STRB Wt,[Xn,Xm]  0x38206800 */
let a64_strb_reg(b, rt, rn, rm) =
  a64_u32(b, 941647872 + bshl(rm, 16) + bshl(rn, 5) + rt)
/* LDR Xt,[Xn,Xm,LSL #3]  0xF8607800 */
let a64_ldr_lsl3(b, rt, rn, rm) =
  a64_u32(b, 4167071744 + bshl(rm, 16) + bshl(rn, 5) + rt)

let a64_word(b, pos) =
  bytes_ref(b, pos) + bshl(bytes_ref(b, pos + 1), 8) +
  bshl(bytes_ref(b, pos + 2), 16) + bshl(bytes_ref(b, pos + 3), 24)

/* Rewrite B.cond at pos so it lands on target. */
let a64_patch_bcond(b, pos, target) =
  let cond = band(a64_word(b, pos), 15) in
  let rel = bshr(target - pos, 2) in
  a64_u32_at(b, pos, 1409286144 + bshl(band(rel, 524287), 5) + cond)

/* STUR Xt,[Xn,#simm9]  0xF8000000 */
let a64_stur(b, rt, rn, simm9) =
  let imm = band(simm9, 511) in
  a64_u32(b, 4160749568 + bshl(imm, 12) + bshl(rn, 5) + rt)

/* LDUR  0xF8400000 */
let a64_ldur(b, rt, rn, simm9) =
  let imm = band(simm9, 511) in
  a64_u32(b, 4164943872 + bshl(imm, 12) + bshl(rn, 5) + rt)

/* STP X29,X30,[SP,#-16]!  0xA9BF7BFD */
let a64_stp_fp_lr(b) = a64_u32(b, 2847898621)

/* LDP X29,X30,[SP],#16  0xA8C17BFD */
let a64_ldp_fp_lr(b) = a64_u32(b, 2831252477)

let a64_ret(b) = a64_u32(b, 3596551104)

/* B  0x14000000 */
let a64_b(b, imm26) = a64_u32(b, 335544320 + band(imm26, 67108863))

let a64_b_cond(b, cond, imm19) =
  a64_u32(b, 1409286144 + bshl(band(imm19, 524287), 5) + band(cond, 15))

/* B.EQ  0x54000000 */
let a64_b_eq(b, imm19) =
  a64_u32(b, 1409286144 + bshl(band(imm19, 524287), 5))

let a64_b_ne(b, imm19) =
  a64_u32(b, 1409286145 + bshl(band(imm19, 524287), 5))

/* BL  0x94000000 */
let a64_bl(b, imm26) = a64_u32(b, 2483027968 + band(imm26, 67108863))

/* ADR Xd, #imm21 (PC-relative byte offset). 0x10000000 */
let a64_adr(b, rd, imm21) =
  let i = band(imm21, 2097151) in
  a64_u32(b, bshl(band(i, 3), 29) + 268435456 + bshl(bshr(i, 2), 5) + rd)

/* BLR Xn  0xD63F0000 | (Rn<<5) */
let a64_blr(b, rn) = a64_u32(b, 3594452992 + bshl(rn, 5))

/* BR Xn  0xD61F0000 | (Rn<<5) */
let a64_br(b, rn) = a64_u32(b, 3592355840 + bshl(rn, 5))

/* SVC #0  0xD4000001 */
let a64_svc(b) = a64_u32(b, 3556769793)

/* BRK #0  0xD4200000 */
let a64_brk(b) = a64_u32(b, 3558866944)

/* FMOV Dd,Xn  0x9E670000 */
let a64_fmov_d_x(b, dd, xn) =
  a64_u32(b, 2657550336 + bshl(xn, 5) + dd)

/* FMOV Xd,Dn  0x9E660000 */
let a64_fmov_x_d(b, xd, dn) =
  a64_u32(b, 2657484800 + bshl(dn, 5) + xd)

/* SCVTF Dd,Xn  0x9E620000 */
let a64_scvtf_d_x(b, dd, xn) =
  a64_u32(b, 2657222656 + bshl(xn, 5) + dd)

/* FADD/FSUB/FMUL/FDIV Dd,Dn,Dm  (type=double). Bases have Rm=Rn=Rd=0. */
let a64_fadd_d(b, dd, dn, dm) =
  a64_u32(b, 509618176 + bshl(dm, 16) + bshl(dn, 5) + dd)

let a64_fsub_d(b, dd, dn, dm) =
  a64_u32(b, 509622272 + bshl(dm, 16) + bshl(dn, 5) + dd)

let a64_fmul_d(b, dd, dn, dm) =
  a64_u32(b, 509609984 + bshl(dm, 16) + bshl(dn, 5) + dd)

let a64_fdiv_d(b, dd, dn, dm) =
  a64_u32(b, 509614080 + bshl(dm, 16) + bshl(dn, 5) + dd)

/* FCMP Dd,Dm  0x1E602000 */
let a64_fcmp_d(b, dn, dm) =
  a64_u32(b, 509616128 + bshl(dm, 16) + bshl(dn, 5))

/* CSET Xd,cond = CSINC Xd,XZR,XZR,invert(cond)  0x9A9F07E0 */
let a64_cset(b, rd, cond) =
  a64_u32(b, 2594113504 + bshl(bxor(cond, 1), 12) + rd)
