/* encode_riscv64.yac — RV64I (+ MUL) instruction words. */

let rv_u32(b, w) =
  let _ = bytes_append(b, band(w, 255)) in
  let _ = bytes_append(b, band(bshr(w, 8), 255)) in
  let _ = bytes_append(b, band(bshr(w, 16), 255)) in
  let _ = bytes_append(b, band(bshr(w, 24), 255)) in
  0

let rv_u32_at(b, pos, w) =
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let rv_addi(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + bshl(rd, 7) + 19)

let rv_add(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + bshl(rd, 7) + 51)

let rv_sub(b, rd, rs1, rs2) =
  rv_u32(b, 1073741824 + bshl(rs2, 20) + bshl(rs1, 15) + bshl(rd, 7) + 51)

let rv_and(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 28672 + bshl(rd, 7) + 51)

let rv_or(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 24576 + bshl(rd, 7) + 51)

let rv_sll(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 4096 + bshl(rd, 7) + 51)

let rv_srl(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 20480 + bshl(rd, 7) + 51)

let rv_xori(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 16384 + bshl(rd, 7) + 19)

let rv_sra(b, rd, rs1, rs2) =
  rv_u32(b, 1073741824 + bshl(rs2, 20) + bshl(rs1, 15) + 20480 + bshl(rd, 7) + 51)

let rv_mul(b, rd, rs1, rs2) =
  rv_u32(b, 33554432 + bshl(rs2, 20) + bshl(rs1, 15) + bshl(rd, 7) + 51)

let rv_div(b, rd, rs1, rs2) =
  rv_u32(b, 33554432 + bshl(rs2, 20) + bshl(rs1, 15) + 16384 + bshl(rd, 7) + 51)

let rv_rem(b, rd, rs1, rs2) =
  rv_u32(b, 33554432 + bshl(rs2, 20) + bshl(rs1, 15) + 24576 + bshl(rd, 7) + 51)

let rv_xor(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 16384 + bshl(rd, 7) + 51)

let rv_slt(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 8192 + bshl(rd, 7) + 51)

let rv_sltu(b, rd, rs1, rs2) =
  rv_u32(b, bshl(rs2, 20) + bshl(rs1, 15) + 12288 + bshl(rd, 7) + 51)

let rv_sltiu(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 12288 + bshl(rd, 7) + 19)

let rv_lui(b, rd, imm20) =
  rv_u32(b, bshl(band(imm20, 1048575), 12) + bshl(rd, 7) + 55)

let rv_nop_at(b, pos) = rv_u32_at(b, pos, 19)

let rv_ld_at(b, pos, rd, rs1, imm) =
  rv_u32_at(b, pos, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 12288
            + bshl(rd, 7) + 3)

let rv_auipc_at(b, pos, rd, imm20) =
  rv_u32_at(b, pos, bshl(band(imm20, 1048575), 12) + bshl(rd, 7) + 23)

let rv_ld(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 12288 + bshl(rd, 7) + 3)

let rv_lbu(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 16384 + bshl(rd, 7) + 3)

let rv_sd(b, rs2, rs1, imm) =
  let i = band(imm, 4095) in
  rv_u32(b, bshl(bshr(i, 5), 25) + bshl(rs2, 20) + bshl(rs1, 15) + 12288 +
           bshl(band(i, 31), 7) + 35)

let rv_sb(b, rs2, rs1, imm) =
  let i = band(imm, 4095) in
  rv_u32(b, bshl(bshr(i, 5), 25) + bshl(rs2, 20) + bshl(rs1, 15) +
           bshl(band(i, 31), 7) + 35)

let rv_beq(b, rs1, rs2, imm13) =
  let i = band(imm13, 8191) in
  let b12 = band(bshr(i, 12), 1) in
  let b10_5 = band(bshr(i, 5), 63) in
  let b4_1 = band(bshr(i, 1), 15) in
  let b11 = band(bshr(i, 11), 1) in
  rv_u32(b, bshl(b12, 31) + bshl(b10_5, 25) + bshl(rs2, 20) + bshl(rs1, 15) +
           bshl(b4_1, 8) + bshl(b11, 7) + 99)

let rv_word(b, pos) =
  bytes_ref(b, pos) + bshl(bytes_ref(b, pos + 1), 8) +
  bshl(bytes_ref(b, pos + 2), 16) + bshl(bytes_ref(b, pos + 3), 24)

let rv_bxx(b, rs1, rs2, imm13, f3) =
  let i = band(imm13, 8191) in
  let b12 = band(bshr(i, 12), 1) in
  let b10_5 = band(bshr(i, 5), 63) in
  let b4_1 = band(bshr(i, 1), 15) in
  let b11 = band(bshr(i, 11), 1) in
  rv_u32(b, bshl(b12, 31) + bshl(b10_5, 25) + bshl(rs2, 20) + bshl(rs1, 15) +
           bshl(f3, 12) + bshl(b4_1, 8) + bshl(b11, 7) + 99)

let rv_blt(b, rs1, rs2, imm13) = rv_bxx(b, rs1, rs2, imm13, 4)
let rv_bge(b, rs1, rs2, imm13) = rv_bxx(b, rs1, rs2, imm13, 5)
let rv_bltu(b, rs1, rs2, imm13) = rv_bxx(b, rs1, rs2, imm13, 6)
let rv_bgeu(b, rs1, rs2, imm13) = rv_bxx(b, rs1, rs2, imm13, 7)

let rv_patch_b(b, pos, target) =
  let w = rv_word(b, pos) in
  let rs1 = band(bshr(w, 15), 31) in
  let rs2 = band(bshr(w, 20), 31) in
  let f3 = band(bshr(w, 12), 7) in
  let i = band(target - pos, 8191) in
  let b12 = band(bshr(i, 12), 1) in
  let b10_5 = band(bshr(i, 5), 63) in
  let b4_1 = band(bshr(i, 1), 15) in
  let b11 = band(bshr(i, 11), 1) in
  rv_u32_at(b, pos, bshl(b12, 31) + bshl(b10_5, 25) + bshl(rs2, 20) + bshl(rs1, 15) +
            bshl(f3, 12) + bshl(b4_1, 8) + bshl(b11, 7) + 99)

let rv_slli(b, rd, rs1, sh) =
  rv_u32(b, bshl(band(sh, 63), 20) + bshl(rs1, 15) + 4096 + bshl(rd, 7) + 19)

let rv_srli(b, rd, rs1, sh) =
  rv_u32(b, bshl(band(sh, 63), 20) + bshl(rs1, 15) + 20480 + bshl(rd, 7) + 19)

let rv_bne(b, rs1, rs2, imm13) =
  let i = band(imm13, 8191) in
  let b12 = band(bshr(i, 12), 1) in
  let b10_5 = band(bshr(i, 5), 63) in
  let b4_1 = band(bshr(i, 1), 15) in
  let b11 = band(bshr(i, 11), 1) in
  rv_u32(b, bshl(b12, 31) + bshl(b10_5, 25) + bshl(rs2, 20) + bshl(rs1, 15) +
           4096 + bshl(b4_1, 8) + bshl(b11, 7) + 99)

let rv_jal(b, rd, imm21) =
  let i = band(imm21, 2097151) in
  let b20 = band(bshr(i, 20), 1) in
  let b10_1 = band(bshr(i, 1), 1023) in
  let b11 = band(bshr(i, 11), 1) in
  let b19_12 = band(bshr(i, 12), 255) in
  rv_u32(b, bshl(b20, 31) + bshl(b10_1, 21) + bshl(b11, 20) + bshl(b19_12, 12) +
           bshl(rd, 7) + 111)

let rv_jalr(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + bshl(rd, 7) + 103)

let rv_auipc(b, rd, imm20) =
  rv_u32(b, bshl(band(imm20, 1048575), 12) + bshl(rd, 7) + 23)

let rv_andi(b, rd, rs1, imm) =
  rv_u32(b, bshl(band(imm, 4095), 20) + bshl(rs1, 15) + 28672 + bshl(rd, 7) + 19)

let rv_srai(b, rd, rs1, sh) =
  rv_u32(b, 1073741824 + bshl(band(sh, 63), 20) + bshl(rs1, 15) + 20480 +
           bshl(rd, 7) + 19)

let rv_fp(b, funct7, rs2, rs1, funct3, rd) =
  rv_u32(b, bshl(funct7, 25) + bshl(rs2, 20) + bshl(rs1, 15) +
           bshl(funct3, 12) + bshl(rd, 7) + 83)

let rv_fadd_d(b, rd, rs1, rs2) = rv_fp(b, 1, rs2, rs1, 0, rd)
let rv_fsub_d(b, rd, rs1, rs2) = rv_fp(b, 5, rs2, rs1, 0, rd)
let rv_fmul_d(b, rd, rs1, rs2) = rv_fp(b, 9, rs2, rs1, 0, rd)
let rv_fdiv_d(b, rd, rs1, rs2) = rv_fp(b, 13, rs2, rs1, 0, rd)
let rv_fmv_x_d(b, rd, rs1) = rv_fp(b, 113, 0, rs1, 0, rd)
let rv_fmv_d_x(b, rd, rs1) = rv_fp(b, 121, 0, rs1, 0, rd)
let rv_fcvt_d_l(b, rd, rs1) = rv_fp(b, 105, 2, rs1, 0, rd)
let rv_feq_d(b, rd, rs1, rs2) = rv_fp(b, 81, rs2, rs1, 2, rd)
let rv_flt_d(b, rd, rs1, rs2) = rv_fp(b, 81, rs2, rs1, 1, rd)
let rv_fle_d(b, rd, rs1, rs2) = rv_fp(b, 81, rs2, rs1, 0, rd)

let rv_ecall(b) = rv_u32(b, 115)

let rv_unimp(b) = rv_u32(b, 0)

let rv_slli_at(b, pos, rd, rs1, sh) =
  rv_u32_at(b, pos, bshl(band(sh, 63), 20) + bshl(rs1, 15) + 4096 + bshl(rd, 7) + 19)

let rv_srli_at(b, pos, rd, rs1, sh) =
  rv_u32_at(b, pos, bshl(band(sh, 63), 20) + bshl(rs1, 15) + 20480 + bshl(rd, 7) + 19)

let rv_add_at(b, pos, rd, rs1, rs2) =
  rv_u32_at(b, pos, bshl(rs2, 20) + bshl(rs1, 15) + bshl(rd, 7) + 51)

let rv_li(b, rd, v) =
  let hi = band(bshr(v + 2048, 12), 1048575) in
  let lo = band(v, 4095) in
  let lo_s = if lo > 2047 then lo - 4096 else lo in
  if hi == 0 then rv_addi(b, rd, 0, lo_s)
  else
    let _ = rv_lui(b, rd, hi) in
    if lo_s == 0 then 0 else rv_addi(b, rd, rd, lo_s)

let rv_lui_addi(b, rd, v32) =
  let hi = band(bshr(v32 + 2048, 12), 1048575) in
  let lo = band(v32, 4095) in
  let lo_s = if lo > 2047 then lo - 4096 else lo in
  let _ = rv_lui(b, rd, hi) in
  rv_addi(b, rd, rd, lo_s)

let rv_lui_addi_at(b, pos, rd, v32) =
  let hi = band(bshr(v32 + 2048, 12), 1048575) in
  let lo = band(v32, 4095) in
  let lo_s = if lo > 2047 then lo - 4096 else lo in
  let _ = rv_u32_at(b, pos, bshl(band(hi, 1048575), 12) + bshl(rd, 7) + 55) in
  rv_u32_at(b, pos + 4, bshl(band(lo_s, 4095), 20) + bshl(rd, 15) + bshl(rd, 7) + 19)

/* Scratch: t0, or t1 if rd is t0. */
let rv_li_tmp(rd) = if rd == 5 then 6 else 5

/* 8 insns (32 bytes), patchable abs64. Name kept: callers used this for VAs. */
let rv_li32_pair(b, rd, v) =
  let tmp = rv_li_tmp(rd) in
  let _ = rv_lui_addi(b, rd, band(v, 4294967295)) in
  let _ = rv_slli(b, rd, rd, 32) in
  let _ = rv_srli(b, rd, rd, 32) in
  let _ = rv_lui_addi(b, tmp, bshr(v, 32)) in
  let _ = rv_slli(b, tmp, tmp, 32) in
  rv_add(b, rd, rd, tmp)

/* rd is bits [11:7] of the LUI already at pos; keep it (alloc bump is t0, not t1). */
let rv_insn_rd(b, pos) =
  band(bshr(bytes_ref(b, pos), 7), 1) + bshl(band(bytes_ref(b, pos + 1), 15), 1)

let rv_li32_at(b, pos, rd0, v) =
  let rd = rv_insn_rd(b, pos) in
  let tmp = rv_li_tmp(rd) in
  let _ = rv_lui_addi_at(b, pos, rd, band(v, 4294967295)) in
  let _ = rv_slli_at(b, pos + 8, rd, rd, 32) in
  let _ = rv_srli_at(b, pos + 12, rd, rd, 32) in
  let _ = rv_lui_addi_at(b, pos + 16, tmp, bshr(v, 32)) in
  let _ = rv_slli_at(b, pos + 24, tmp, tmp, 32) in
  rv_add_at(b, pos + 28, rd, rd, tmp)
