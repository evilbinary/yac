/* backend.yac — pipeline + image. lir_expr = ANF→LIR；lower_expr = LIR→emit. */

let backend_emit(t, ast) = nth(lower_expr(ast, t), 0)

let backend_pack(t, code) =
  if target_format(t) == "pe" then
    let img = pack_pe_target(t, code) in
    let _ = pe_finish_imports(img, t, cimport_names(0), cimport_got(0)) in
    img
  else if target_format(t) != "elf" then pack_image(t, code)
  else if target_shared(t) then pack_image(t, code)
  else if cimport_n(0) == 0 then pack_image(t, code)
  else if target_emachine(t) == 62 then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else if target_emachine(t) == 183 then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else if target_emachine(t) == 243 then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else pack_image(t, code)

let backend_compile(prog) = pack_elf(nth(lower_program(prog), 0))

let pass_lex(src) = tokenize(src)
let pass_parse(toks) = parse_program(toks, 0, [])
let pass_anf(prog) = anf_all(0, prog, list_new(), len(prog))

let path_dirname(s) =
  let n = str_len(s) in
  let rec(i) =
    if i < 0 then 0 - 1
    else if str_ref(s, i) == 47 then i
    else rec(i - 1) in
  let k = rec(n - 1) in
  if k < 0 then "."
  else if k == 0 then "/"
  else str_slice(s, 0, k)

let file_or_0(p) =
  let r = read_file(p) in
  if r == 0 then 0 else r

let src_rel_file(rel) =
  let a = file_or_0(rel) in
  if a != 0 then a
  else
    let d = path_dirname(argv(0)) in
    let here = file_or_0(str_cat(d, str_cat("/", rel))) in
    if here != 0 then here
    else
      let b = file_or_0(str_cat(d, str_cat("/../../", rel))) in
      if b != 0 then b
      else file_or_0(str_cat(d, str_cat("/../", rel)))

let pkg_rel(pkg) =
  let n = str_len(pkg) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(pkg, i) in
      if c == 46 then rec(i + 1, str_cat(acc, "/"))
      else rec(i + 1, str_cat(acc, str_chr(c))) in
  str_cat("src-self/", str_cat(rec(0, ""), ".yac"))

let pkg_src(pkg) = src_rel_file(pkg_rel(pkg))

/* Compile one rt/*.yac against already-lowered procs so later stdlib
 * files can call earlier ones. Guest always gets rt.num; other packages
 * are src-self/<dots-to-slashes>.yac from import. Do not call
 * runtime_funs() inside a loop. */
let lir_extend(src, acc) =
  if src == 0 then acc
  else
    let ast = pass_parse(pass_lex(src)) in
    if prog_has_err(ast, 0) then acc
    else
      let anf = pass_anf(ast) in
      let st = lir_all(0, anf,
        [env_new(0), 1, sigma_of_rt(acc), 0, list_new(), 0],
        len(anf)) in
      reverse(sigma_list(nth(st, 2)))

let ast_imports(ast, i, acc) =
  if i >= len(ast) then acc
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "import" then
      let p = nth(e, 1) in
      if in_list(p, acc) then ast_imports(ast, i + 1, acc)
      else ast_imports(ast, i + 1, cons(p, acc))
    else ast_imports(ast, i + 1, acc)

let intern_names(xs, i, acc) =
  if i >= len(xs) then acc
  else intern_names(xs, i + 1, cons(intern(nth(xs, i)), acc))

let ast_export_list(ast, i) =
  if i >= len(ast) then []
  else if nth(nth(ast, i), 0) == "export" then intern_names(nth(nth(ast, i), 1), 0, [])
  else ast_export_list(ast, i + 1)

let pkg_export_names(pkg) =
  let src = pkg_src(pkg) in
  if src == 0 then []
  else ast_export_list(pass_parse(pass_lex(src)), 0)

let import_sel(sel, all, i, acc) =
  if i >= len(sel) then acc
  else
    let n = nth(sel, i) in
    if in_list(n, all) then import_sel(sel, all, i + 1, cons(n, acc))
    else import_sel(sel, all, i + 1, acc)

let fill_import(e) =
  let all = pkg_export_names(nth(e, 1)) in
  if len(e) < 3 then ["import", nth(e, 1), all]
  else ["import", nth(e, 1), import_sel(nth(e, 2), all, 0, [])]

let rewrite_imports(ast, i, acc) =
  if i >= len(ast) then reverse(acc)
  else
    let e = nth(ast, i) in
    let e2 = if nth(e, 0) == "import" then fill_import(e) else e in
    rewrite_imports(ast, i + 1, cons(e2, acc))

let link_need_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_from_ast(ast) =
  let _ = box_set(link_need_box, ast_imports(ast, 0, [])) in
  0

let rt_cache_num =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let rt_base(_) =
  let c = box_get(rt_cache_num) in
  if c == 0 then
    let v = lir_extend(pkg_src("rt.num"), runtime_funs(0)) in
    let _ = box_set(rt_cache_num, v) in
    v
  else c

let rt_for_link(_) =
  let pkgs = box_get(link_need_box) in
  let rec(i, acc) =
    if i >= len(pkgs) then acc
    else
      let p = nth(pkgs, i) in
      if p == "rt.num" then rec(i + 1, acc)
      else rec(i + 1, lir_extend(pkg_src(p), acc)) in
  rec(0, rt_base(0))

let rt_fun_names(funs) =
  let rec(i, acc) =
    if i >= len(funs) then acc
    else rec(i + 1, cons(intern(nth(nth(funs, i), 1)), acc)) in
  rec(0, [])

let pass_lir(anf_list) =
  let rt0 = rt_for_link(0) in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let entry = start_proc(nth(st, 1), nth(st, 5), nth(st, 4)) in
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

let pass_lir_eval(anf_list, bind_name) =
  let rt0 = rt_for_link(0) in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let pslot =
    if bind_name == "" then nth(st, 5)
    else
      let s = env_slot(nth(st, 0), bind_name) in
      if s == 0 then nth(st, 5) else s in
  let entry = start_proc_eval(nth(st, 1), pslot, nth(st, 4), bind_name) in
  /* prog[2] is the Linux process entry (is_entry in emit). JIT jumps to
   * _eval by name; it must not be prog[2] or it would get _start's ABI. */
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

let fun_off(fo, name) =
  if fo == [] then 0
  else if nth(nth(fo, 0), 0) == name then nth(nth(fo, 0), 1)
  else fun_off(drop(fo, 1), name)

let kernel_names_cache =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let kernel_fun_names(_) =
  let c = box_get(kernel_names_cache) in
  if c == 0 then
    let v = rt_fun_names(runtime_funs(0)) in
    let _ = box_set(kernel_names_cache, v) in
    v
  else c

let report_unbound(src, ast) =
  let nm = ub_prog(rewrite_imports(ast, 0, []), 0, kernel_fun_names(0)) in
  if nm == "" then 0
  else
    let toks = tokenize(src) in
    let line = tok_ident_line(toks, nm, 0, len(toks)) in
    let _ = print(str_cat("error: ",
      str_cat(int_to_str(line),
        str_cat(":1: unbound variable '",
          str_cat(nm, "'"))))) in
    1

let repl_last_let(ast) =
  let n = len(ast) in
  if n == 0 then ""
  else
    let e = nth(ast, n - 1) in
    if nth(e, 0) == "let" then nth(e, 1) else ""

let compile_jit(src, t, named) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = link_from_ast(ast) in
    let bn = if named then repl_last_let(ast) else "" in
    let _ = log_set_hush(true) in
    let r = lower_expr(pass_lir_eval(pass_anf(ast), bn), t) in
    let _ = log_set_hush(false) in
    let _ = cimport_jit_bind(nth(r, 0)) in
    let _ = jit_run(nth(r, 0), fun_off(nth(r, 1), "_eval")) in 0

let make_pipeline(t) =
  let pass_lower(ast) = nth(lower_expr(ast, t), 0) in
  let pass_pack(code) = backend_pack(t, code) in
  [mk_pass("lex", pass_lex),
   mk_pass("parse", pass_parse),
   mk_pass("anf", pass_anf),
   mk_pass("lir", pass_lir),
   mk_pass("lower", pass_lower),
   mk_pass("pack", pass_pack)]

let dump_ast(src) =
  let _ = print(pass_parse(pass_lex(src))) in 0

let dump_anf(src) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(pass_anf(ast)) in 0

let dump_cps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in 0

let eval_cps_src(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = eval_cps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if nth(r, 0) == "err" then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(nth(r, 1)) in 0

let dump_uncps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = uncps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if uncps_is_err(r) then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(r) in 0

let compile_jit_anf(anf, t, bn) =
  let _ = log_set_hush(true) in
  let r = lower_expr(pass_lir_eval(anf, bn), t) in
  let _ = log_set_hush(false) in
  let _ = cimport_jit_bind(nth(r, 0)) in
  let _ = jit_run(nth(r, 0), fun_off(nth(r, 1), "_eval")) in 0

let compile_uncps(src, t, named, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = link_from_ast(ast) in
    let r = uncps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if uncps_is_err(r) then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let bn = if named then repl_last_let(ast) else "" in
      compile_jit_anf(r, t, bn)

let compile_src(src, outpath, t, profpath) =
  let ast0 = pass_parse(pass_lex(src)) in
  if prog_has_err(ast0, 0) then
    let _ = print("error: syntax") in 1
  else if report_unbound(src, ast0) != 0 then 1
  else
    let _ = link_from_ast(ast0) in
    let t0 = time_ms() in
    let _ = if profpath == "" then 0 else yac_prof_enable(profpath) in
    let _ = log("yc", "start") in
    let _ = log_i("yc", "src_len", str_len(src)) in
    let bin = run_passes(make_pipeline(t), src) in
    let _ = log_i("yc", "bin_len", bytes_len(bin)) in
    let _ = log("yc", "write") in
    let _ = write_file(outpath, bin) in
    let _ = log_i("prof", "total", time_ms() - t0) in
    let _ = log("yc", "done") in
    let _ = if profpath == "" then 0 else yac_prof_dump(0) in
    0

let compile_file(inpath, outpath, t, profpath) =
  compile_src(read_file(inpath), outpath, t, profpath)
