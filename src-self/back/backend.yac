/* backend.yac — pipeline + image. lir_expr = ANF→LIR；lower_expr = LIR→emit. */

package back.backend
export compile_native, compile_env_of, compile_env_new, dump_ast, dump_anf, dump_cps, dump_uncps, eval_cps_src, make_pipeline, pass_lex, pass_parse, pass_anf, pkg_set, link_set, report_unbound, link_from_ast, backend_pack, backend_compile, backend_emit, ast_imports, fun_off, link_need_box, rewrite_imports, rt_for_link
import back.lower
import back.pack.elf {elf_shared_set, funsym_get, pack_elf, pack_elf_libc}
import back.pack.target {target_arch, target_emachine, target_format, target_shared, target_text_off, target_vaddr}
import back.pack.pe {pack_pe_target, pe_finish_dll, pe_finish_imports}
import back.pack.pack {pack_image}
import lib.map
import back.emit.emit {cimport_got, cimport_n, cimport_names, emit_abi_win, emit_jsess, emit_jsess_set, extsym_add, extsym_bind_add, host_names, yjit_layout_get, yjit_layout_set}
import front.lir {env_new, imap_load, import_alias, in_list, insn_extend, insn_push, lir_all, pkg_prefix_get, pkg_prefix_set, pkg_qn, session_get, session_set, sigma_host_seed, sigma_list, sigma_of_rt, start_proc, tco_prog, ub_prog}
import front.lexer {tok_ident_line, tokenize}
import front.parser {parse_program, prog_has_err, report_syntax}
import front.anf {anf_all}
import front.cps {cps_all, cps_maybe_opt}
import front.eval_cps {eval_cps_all}
import front.uncps {uncps_all, uncps_is_err}
import lib.pass {mk_pass, run_passes}
import back.pack.yjit {pack_yjit_ex, yjit_arch_num, yjit_imp_enc}

let reverse(xs) = list_rev(xs)


let backend_emit(t, ast) = nth(lower_expr(ast, t), 0)

let backend_pack(t, code) =
  let _ = elf_shared_set(if target_shared(t) then 1 else 0) in
  if target_format(t) == "pe" then
    let img = pack_pe_target(t, code) in
    let _ = pe_finish_imports(img, t, cimport_names(0), cimport_got(0)) in
    let _ = if target_shared(t) then pe_finish_dll(img, t) else 0 in
    img
  else if target_format(t) != "elf" then pack_image(t, code)
  else if cimport_n(0) != 0 then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else if target_shared(t) then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else pack_image(t, code)

let backend_compile(prog) = pack_elf(nth(lower_program(prog), 0))

let pass_lex(src) = tokenize(src)
let pass_parse(toks) = parse_program(toks, 0, [])
let pass_anf(prog) = anf_all(0, prog, list_new(), len(prog))

/* Package lookup must not import path: loading path.yac would recurse. */
let path_dirname(s) =
  let n = str_len(s) in
  let rec(i) =
    if i < 0 then 0 - 1
    else
      let c = str_ref(s, i) in
      if c == 47 then i
      else if c == 92 then i
      else rec(i - 1) in
  let k = rec(n - 1) in
  if k < 0 then "."
  else if k == 0 then "/"
  else str_slice(s, 0, k)

let file_or_0(p) =
  let r = read_file(p) in
  if r == 0 then 0
  else if r == () then 0
  else if str_len(r) == 0 then 0
  else r

let join_path(a, b) = str_cat(a, str_cat("/", b))

/* import a.b.c → a/b/c.yac under a package root. */
let pkg_file(pkg) =
  let n = str_len(pkg) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(pkg, i) in
      if c == 46 then rec(i + 1, str_cat(acc, "/"))
      else rec(i + 1, str_cat(acc, str_chr(c))) in
  str_cat(rec(0, ""), ".yac")

/* 0 = --pkg not given; else list of roots. */
let pkg_extra_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

/* Comma-separated roots. Empty segments (a,,b or trailing comma) → 0. */
let pkg_split(s) =
  let n = str_len(s) in
  let rec(i, start, acc) =
    if i >= n then
      if i == start then 0
      else reverse(cons(str_slice(s, start, i - start), acc))
    else if str_ref(s, i) != 44 then rec(i + 1, start, acc)
    else if i == start then 0
    else rec(i + 1, i + 1, cons(str_slice(s, start, i - start), acc)) in
  if n == 0 then 0 else rec(0, 0, [])

/* Once. Returns 1, or 0 if already set / bad list. */
let pkg_set(csv) =
  if box_get(pkg_extra_box) != 0 then 0
  else
    let xs = pkg_split(csv) in
    if xs == 0 then 0
    else
      let _ = box_set(pkg_extra_box, xs) in
      1

let pkg_try(roots, f, i) =
  if i >= len(roots) then 0
  else
    let r = file_or_0(join_path(nth(roots, i), f)) in
    if r != 0 then r else pkg_try(roots, f, i + 1)

let pkg_src(pkg) =
  let f = pkg_file(pkg) in
  let extra = box_get(pkg_extra_box) in
  let a = if extra == 0 then 0 else pkg_try(extra, f, 0) in
  if a != 0 then a
  else
    let p = file_or_0(join_path("pkg", f)) in
    if p != 0 then p
    else file_or_0(join_path(path_dirname(argv(0)), f))

/* ---- --link: BOOTSTRAP_LINK.md §5.2 / 12.3. Interface only: parse the
 * chain into state and probe precompiled artifacts. Loaders are later steps
 * (12.4 embed .host / dylib .so / yjit .yjit). Default ["stub"] means the
 * current source-link behavior; stub is also the safe tail of any chain.
 * Grammar:
 *   --link <mode>[,<mode>…]            global chain (no '=')
 *   --link <pkg>=<mode>[,<mode>…][,…]  per-package override; a bare mode
 *                                      segment continues the last <pkg>=
 * Repeated --link accumulates package overrides (later wins); a later
 * --link without '=' replaces the global chain. --link is *not* once-only
 * (contrast pkg_set). Modes: embed | dylib | yjit | stub. */
let link_global_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_pkg_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_valid_mode(m) =
  if m == "embed" then true
  else if m == "dylib" then true
  else if m == "yjit" then true
  else m == "stub"

let link_has_eq(s, i) =
  if i >= str_len(s) then false
  else if str_ref(s, i) == 61 then true
  else link_has_eq(s, i + 1)

let link_cut_eq(s, i) =
  if i >= str_len(s) then 0
  else if str_ref(s, i) == 61 then
    [str_slice(s, 0, i), str_slice(s, i + 1, str_len(s) - i - 1)]
  else link_cut_eq(s, i + 1)

let link_any_eq(xs, i) =
  if i >= len(xs) then false
  else if link_has_eq(nth(xs, i), 0) then true
  else link_any_eq(xs, i + 1)

let link_modes_ok(xs, i) =
  if i >= len(xs) then true
  else if link_valid_mode(nth(xs, i)) == false then false
  else link_modes_ok(xs, i + 1)

/* segs from pkg_split; every later segment without '=' appends to the last
 * <pkg>= override; a bare segment before any '=' is an error. */
let link_parse_override(segs, i, cur, acc) =
  if i >= len(segs) then
    if cur == 0 then reverse(acc)
    else reverse(cons([nth(cur, 0), reverse(nth(cur, 1))], acc))
  else
    let t = nth(segs, i) in
    if link_has_eq(t, 0) then
      let pr = link_cut_eq(t, 0) in
      if pr == 0 then 0
      else
        let p = nth(pr, 0) in
        let m = nth(pr, 1) in
        if str_len(p) == 0 then 0
        else if link_valid_mode(m) == false then 0
        else if str_len(m) == 0 then 0
        else
          let acc2 =
            if cur == 0 then acc
            else cons([nth(cur, 0), reverse(nth(cur, 1))], acc) in
          link_parse_override(segs, i + 1, [p, [m]], acc2)
    else if cur == 0 then 0
    else if link_valid_mode(t) == false then 0
    else
      link_parse_override(segs, i + 1,
                          [nth(cur, 0), cons(t, nth(cur, 1))], acc)

/* 1 on success; 0 on a bad argument (CLI then reports bad arguments). */
let link_set(csv) =
  let segs = pkg_split(csv) in
  if segs == 0 then 0
  else if link_any_eq(segs, 0) == false then
    if link_modes_ok(segs, 0) then
      let _ = box_set(link_global_box, segs) in
      1
    else 0
  else
    let ov = link_parse_override(segs, 0, 0, []) in
    if ov == 0 then 0
    else
      let _ = box_set(link_pkg_box,
                      append(box_get(link_pkg_box), ov)) in
      1

/* Effective chain for pkg: last package override (search back-to-front so a
 * later --link with the same pkg wins), else global, else stub. */
let link_chain_of(pkg) =
  let find(xs, i) =
    if i < 0 then 0
    else if nth(nth(xs, i), 0) == pkg then nth(nth(xs, i), 1)
    else find(xs, i - 1) in
  let o = find(box_get(link_pkg_box), len(box_get(link_pkg_box)) - 1) in
  if o != 0 then o
  else
    let g = box_get(link_global_box) in
    if g == 0 then ["stub"]
    else if len(g) == 0 then ["stub"]
    else g

let link_has_nstub(c, i) =
  if i >= len(c) then false
  else if nth(c, i) != "stub" then true
  else link_has_nstub(c, i + 1)

/* Artifact suffixes per mode. dylib is target-format dependent: ELF .so,
 * PE .dll, Mach-O .dylib — probe all so the same chain works on any host. */
let link_suffixes(mode) =
  if mode == "embed" then [".host"]
  else if mode == "dylib" then [".so", ".dll", ".dylib"]
  else if mode == "yjit" then [".yjit"]
  else []

/* Artifact file <pkg>.yac<mode-suffix> under the package roots. Content or
 * 0. Only used when a non-stub mode was explicitly requested. */
let link_artifact(pkg, mode) =
  let try_suf(sufs, i) =
    if i >= len(sufs) then 0
    else
      let f = str_cat(pkg_file(pkg), nth(sufs, i)) in
      let extra = box_get(pkg_extra_box) in
      let a = if extra == 0 then 0 else pkg_try(extra, f, 0) in
      if a != 0 then a
      else
        let p = file_or_0(join_path("pkg", f)) in
        if p != 0 then p
        else
          let q = file_or_0(join_path(path_dirname(argv(0)), f)) in
          if q != 0 then q
          else try_suf(sufs, i + 1) in
  try_suf(link_suffixes(mode), 0)

let link_render_go(xs, i, acc) =
  if i >= len(xs) then acc
  else if acc == "" then link_render_go(xs, i + 1, nth(xs, i))
  else link_render_go(xs, i + 1, str_cat(acc, str_cat(",", nth(xs, i))))

let link_render(xs) = link_render_go(xs, 0, "")

/* dylib-bound packages (12.5 stage 2): the operative chain mode is dylib and
 * the dylib artifact exists. Their source is NOT linked into the image; each
 * exported function name becomes one extern slot (G+216+8*i, tag21 id 10+i).
 * Calls currently land on the yac_host_unimpl stub until the runtime loader
 * (12.4.C) fills the slots. */
let link_operative(c, i) =
  if i >= len(c) then "stub"
  else if nth(c, i) == "stub" then link_operative(c, i + 1)
  else nth(c, i)

let link_is_dylib(pkg) =
  if link_operative(link_chain_of(pkg), 0) == "dylib" then
    if link_artifact(pkg, "dylib") == 0 then 0
    else 1
  else 0

/* 0 = proceed (source-link, or artifact mode that can't apply yet).
 * 1 = fail compile with a message (pkg_fail). Only fires when the chain
 * names a non-stub mode for this pkg. Found artifact -> "not implemented"
 * (loaders land in 12.4+); nothing found and no stub tail -> error. */
let link_check_pkg(pkg) =
  if link_is_dylib(pkg) == 1 then 0
  else
    let chain = link_chain_of(pkg) in
    if link_has_nstub(chain, 0) == false then 0
    else
      let rec_scan(i) =
        if i >= len(chain) then
          if in_list("stub", chain) then 0
          else
            let _ = print(str_cat("error: --link for pkg '",
              str_cat(pkg, str_cat("': no precompiled artifact (",
                str_cat(link_render(chain),
                  "); make one or add 'stub' to the chain"))))) in
            1
        else
          let m = nth(chain, i) in
          if m == "stub" then rec_scan(i + 1)
          else if link_artifact(pkg, m) != 0 then
            let _ = print(str_cat("error: --link ", str_cat(m,
              str_cat(" for pkg '", str_cat(pkg,
                "': artifact exists but this mode is not implemented yet"))))) in
            1
          else rec_scan(i + 1) in
      rec_scan(0)

let intern_names(xs, i, acc) =
  if i >= len(xs) then acc
  else intern_names(xs, i + 1, cons(intern(nth(xs, i)), acc))

/* One file may list export more than once; union them. */
let ast_export_list(ast, i) =
  let rec(j, acc) =
    if j >= len(ast) then acc
    else if nth(nth(ast, j), 0) == "export" then
      rec(j + 1, intern_names(nth(nth(ast, j), 1), 0, acc))
    else rec(j + 1, acc) in
  rec(i, [])

let ast_pkg_name(ast, i) =
  if i >= len(ast) then ""
  else if nth(nth(ast, i), 0) == "package" then nth(nth(ast, i), 1)
  else ast_pkg_name(ast, i + 1)

/* Exports of an imported package, cached: the bundle imports the same
 * lib/front/back package many times, and reading+parsing it on every import
 * was ~9 s of a ~29 s self-compile. The map value is the same list object
 * each call, so the caller must not mutate it. */
let pkg_exp_cache_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pkg_export_names(pkg) =
  let b0 = box_get(pkg_exp_cache_box) in
  let m =
    if b0 == 0 then
      let _ = box_set(pkg_exp_cache_box, fmap_new64(0)) in
      box_get(pkg_exp_cache_box)
    else b0 in
  let e = fmap_get(m, pkg) in
  if e != 0 then e
  else
    let src = pkg_src(pkg) in
    let v = if src == 0 then [] else ast_export_list(pass_parse(pass_lex(src)), 0) in
    let _ = fmap_put(m, pkg, v) in
    v

/* extbind entries: [qnameKey, exportSymbol, artifactPath]. Key matches the
 * emit extern slot (extsym index), symbol is what csym() looks up in the
 * artifact, path is what cload() opens. Fed by pkg_extern_register below,
 * read by the 12.4.C loader. */
let extbind_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let extbind_add(key, sym, art) =
  let xs = box_get(extbind_box) in
  let has(xs2, i) =
    if i >= len(xs2) then false
    else if nth(nth(xs2, i), 0) == key then true
    else has(xs2, i + 1) in
  if has(xs, 0) then 0
  else box_set(extbind_box, cons([key, sym, art], xs))

let extbind_list(_) = box_get(extbind_box)

/* Like link_artifact but returns the file path of the first existing artifact
 * (mode suffixes, same root order) instead of its contents; 0 if none. Used
 * to build the loader's cload() argument (12.4.C). */
let link_artifact_path(pkg, mode) =
  let try_suf(sufs, i) =
    if i >= len(sufs) then 0
    else
      let f = str_cat(pkg_file(pkg), nth(sufs, i)) in
      let extra = box_get(pkg_extra_box) in
      let try_root(xs, j) =
        if j >= len(xs) then 0
        else
          let c = str_cat(nth(xs, j), str_cat("/", f)) in
          if file_or_0(c) == 0 then try_root(xs, j + 1)
          else c in
      let a = if extra == 0 then 0 else try_root(extra, 0) in
      if a != 0 then a
      else
        let p = join_path("pkg", f) in
        if file_or_0(p) == 0 then
          let q = join_path(path_dirname(argv(0)), f) in
          if file_or_0(q) == 0 then try_suf(sufs, i + 1)
          else q
        else p in
  try_suf(link_suffixes(mode), 0)

/* Register every export of a dylib-bound package as one extern slot keyed by
 * its qname (pkg/f), plus the extbind triple the loader needs. See extsym_*
 * (emit) and extbind_* / link_artifact_path above (12.5 stage 2/3). */
let pkg_extern_register(pkg) =
  let art = link_artifact_path(pkg, "dylib") in
  let names = pkg_export_names(pkg) in
  let rec_add(i) =
    if i >= len(names) then 0
    else
      let n = nth(names, i) in
      let key = intern(pkg_qn(pkg, n)) in
      let _ = extsym_add(key) in
      let _ = if art == 0 then 0 else extsym_bind_add(key, intern(n), art) in
      rec_add(i + 1) in
  rec_add(0)

/* dylib wrapper package (12.5, option B): each export becomes a shim that
 * dlopens the C-ABI artifact and forwards up to 6 tagged int args through
 * ccall (untags args, calls the C export, tags the int result). Compiled
 * under `package pkg`, so imported calls resolve to local procs named pkg/f
 * through the normal sigma path.
 *
 * Note: a per-package box cache was tried and REVERTED — package-scope
 * functions referencing a top-level box crash at runtime (only main files
 * support that). Resolve happens on every call for now. */
let pkg_dylib_synth(pkg) =
  let art = link_artifact_path(pkg, "dylib") in
  if art == 0 then ""
  else
    let names = pkg_export_names(pkg) in
    let hdr = str_cat("package ", str_cat(pkg, "\n")) in
    let one(e, acc) =
      let msg = str_cat("dylib load failed: ", art) in
      let s1 = str_cat("(a0, a1, a2, a3, a4, a5) = let h = ccall(\"dlopen\", \"", art) in
      let s2 = str_cat(s1, "\", 258) in if h == 0 then let _ = print(\"") in
      let s3 = str_cat(s2, msg) in
      let s4 = str_cat(s3, "\") in 0 else ccall(ccall(\"dlsym\", 0, \"") in
      let s5 = str_cat(s4, e) in
      let s6 = str_cat(s5, "\"), a0, a1, a2, a3, a4, a5)\n") in
      str_cat(acc, str_cat("let ", str_cat(e, s6))) in
    let rec(i, acc) =
      if i >= len(names) then acc
      else rec(i + 1, one(nth(names, i), acc)) in
    str_cat(hdr, rec(0, ""))

let import_id_pairs(xs, i, acc) =
  if i >= len(xs) then acc
  else
    let n = nth(xs, i) in
    import_id_pairs(xs, i + 1, cons([n, n], acc))

let import_sel(sel, all, i, acc) =
  if i >= len(sel) then acc
  else
    let spec = nth(sel, i) in
    if len(spec) > 2 then
      /* host binding (@name): not checked against the package exports,
       * kept as [name, name, 1] so imap_load binds the bare host name. */
      import_sel(sel, all, i + 1, cons(spec, acc))
    else
      let orig = intern(nth(spec, 1)) in
      let loc = intern(nth(spec, 0)) in
      if in_list(orig, all) then
        import_sel(sel, all, i + 1, cons([loc, orig], acc))
      else import_sel(sel, all, i + 1, acc)

/* Exports of packages declared in the same source. Saves reading+parsing
 * the imported file for every `import` inside the concatenated compiler
 * bundle (that was ~9 s; the disk cache above still covers repeat imports
 * of packages that are genuinely separate files). */
let ast_exp_go(ast, i, n, st) =
  if i >= n then st
  else
    let e = nth(ast, i) in
    let k = nth(e, 0) in
    if k == "package" then ast_exp_go(ast, i + 1, n, [nth(st, 0), nth(e, 1)])
    else if k == "export" then
      let cur = nth(st, 1) in
      if cur == "" then ast_exp_go(ast, i + 1, n, st)
      else
        let m = nth(st, 0) in
        let old = fmap_get(m, cur) in
        let v = if old == 0 then nth(e, 1) else append(nth(e, 1), old) in
        let _ = fmap_put(m, cur, v) in
        ast_exp_go(ast, i + 1, n, st)
    else ast_exp_go(ast, i + 1, n, st)

let local_exports(ast) =
  let st = ast_exp_go(ast, 0, len(ast), [fmap_new64(0), ""]) in
  nth(st, 0)

/* True when every brace spec of an import is a host binding (@name): the
 * package then only provides a name view over host leaves and its source
 * must NOT be pulled into the link closure. */
let import_all_host(sel, i) =
  if i >= len(sel) then true
  else
    let spec = nth(sel, i) in
    if len(spec) <= 2 then false
    else import_all_host(sel, i + 1)

let fill_import(e, local) =
  let sel =
    if len(e) < 3 then 0
    else if nth(e, 2) == 0 then 0
    else nth(e, 2) in
  let alias = if len(e) > 3 then nth(e, 3) else 0 in
  let all0 = if local == 0 then 0 else fmap_get(local, nth(e, 1)) in
  let pairs =
    if sel != 0 and import_all_host(sel, 0) then
      /* every spec is @name: bind bare host names, never read the package. */
      sel
    else
      let all = if all0 == 0 then pkg_export_names(nth(e, 1)) else all0 in
      if len(e) < 3 then import_id_pairs(all, 0, [])
      else if nth(e, 2) == 0 then import_id_pairs(all, 0, [])
      else import_sel(sel, all, 0, []) in
  ["import", nth(e, 1), pairs, alias]

let rewrite_imports_go(ast, i, acc, local) =
  if i >= len(ast) then reverse(acc)
  else
    let e = nth(ast, i) in
    let e2 = if nth(e, 0) == "import" then fill_import(e, local) else e in
    rewrite_imports_go(ast, i + 1, cons(e2, acc), local)

let rewrite_imports(ast, i, acc) =
  rewrite_imports_go(ast, i, acc, local_exports(ast))

/* Compile one rt/*.yac against already-lowered procs so later stdlib
 * files can call earlier ones. Guest always gets rt.num; other packages
 * come from --pkg, ./pkg, then the directory of yc. Do not call
 * runtime_funs() inside a loop. */
let pkg_fail_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pkg_fail_set(v) = box_set(pkg_fail_box, v)

let pkg_fail(_) = box_get(pkg_fail_box)

let pair_locals(xs, i, acc) =
  if i >= len(xs) then acc
  else pair_locals(xs, i + 1, cons(nth(nth(xs, i), 0), acc))

let rt_fun_names(funs) =
  let rec(i, acc) =
    if i >= len(funs) then acc
    else rec(i + 1, cons(intern(nth(nth(funs, i), 1)), acc)) in
  rec(0, [])

let kernel_names_cache =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let kernel_fun_names(_) =
  let c = box_get(kernel_names_cache) in
  if c == 0 then
    let v = rt_fun_names(runtime_funs(0)) in
    let _ = box_set(kernel_names_cache, v) in
    v
  else c

/* Kernel package (rt/runtime.yac) exports: always linked into every image,
 * so a standalone package may reference them without importing. Cached. */
let kernel_let_names_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let kernel_let_names(_) =
  let c = box_get(kernel_let_names_box) in
  if c == 0 then
    let v = pkg_export_names("rt.runtime") in
    let _ = box_set(kernel_let_names_box, v) in
    v
  else c

/* Host functions available to REPL lines and host packages. These are the
 * names baked into the yc host image's G+136..G+216 table; a *guest* must not
 * see them without an import (pkg/compiler.yac binds them via `import`), so
 * a bare `compile(...)` is an unbound-variable error, exactly like any other
 * name. Only the kernel (rt.runtime) and imported names widen guest scope. */
let host_fun_names(_) = host_names(0)

let report_unbound_ex(src, ast, extra) =
  let sc0 = pair_locals(nth(session_get(0), 0), 0,
                        append(kernel_fun_names(0), kernel_let_names(0))) in
  let sc1 = pair_locals(nth(session_get(0), 1), 0, sc0) in
  let nm = ub_prog(rewrite_imports(ast, 0, []), 0, append(extra, sc1)) in
  if nm == "" then 0
  else
    let toks = tokenize(src) in
    let line = tok_ident_line(toks, nm, 0, len(toks)) in
    let pfx = pkg_prefix_get(0) in
    let loc = str_cat(int_to_str(line), ":1: unbound variable '") in
    let msg =
      if pfx == "" then str_cat("error: ", str_cat(loc, str_cat(nm, "'")))
      else str_cat("error: package ",
        str_cat(pfx, str_cat(": ", str_cat(loc, str_cat(nm, "'"))))) in
    let _ = print(msg) in
    1

let report_unbound(src, ast) = report_unbound_ex(src, ast, [])

/* synth = 1 when src is a synthesized dylib wrapper package (not the package
 * source), so the "dylib-bound => do not compile real source" guard is
 * bypassed; link_check still approves the package. */
let lir_extend_go(pkg, src, acc, synth) =
  if synth == 0 and pkg != "rt.num" and link_is_dylib(pkg) == 1 then acc
  else
    let _ =
      if pkg == "rt.num" then 0
      else if link_check_pkg(pkg) != 0 then pkg_fail_set(1)
      else 0 in
    if src == 0 then acc
    else
      let ast = pass_parse(pass_lex(src)) in
      if prog_has_err(ast, 0) then
        let _ = print(str_cat("error: syntax in package '", str_cat(pkg, "'"))) in
        let _ = report_syntax(ast) in
        let _ = pkg_fail_set(1) in
        acc
      else
        let saved_s = session_get(0) in
        let filled = rewrite_imports(ast, 0, []) in
        let _ = imap_load(filled, 0) in
        let _ = pkg_prefix_set(ast_pkg_name(ast, 0)) in
        if report_unbound(src, ast) != 0 then
          let _ = pkg_fail_set(1) in
          let _ = session_set(saved_s) in
          acc
        else
          let anf = pass_anf(ast) in
          let st = lir_all(0, anf,
            [env_new(0), 1, sigma_host_seed(sigma_of_rt(acc)), 0,
             list_new(), 0],
            len(anf)) in
          let out = reverse(sigma_list(nth(st, 2))) in
          let _ = session_set(saved_s) in
          out

let lir_extend(pkg, src, acc) = lir_extend_go(pkg, src, acc, 0)

let lir_extend_dylib(pkg, src, acc) = lir_extend_go(pkg, src, acc, 1)

let ast_imports(ast, i, acc) =
  if i >= len(ast) then acc
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "import" then
      let p = nth(e, 1) in
      let sel =
        if len(e) < 3 then 0
        else if nth(e, 2) == 0 then 0
        else nth(e, 2) in
      if sel != 0 and import_all_host(sel, 0) then ast_imports(ast, i + 1, acc)
      else if in_list(p, acc) then ast_imports(ast, i + 1, acc)
      else ast_imports(ast, i + 1, cons(p, acc))
    else ast_imports(ast, i + 1, acc)

/* Imports written inside a package source (so http can use net). */
let pkg_file_imports(pkg) =
  let src = pkg_src(pkg) in
  if src == 0 then []
  else ast_imports(pass_parse(pass_lex(src)), 0, [])

/* DFS imports. op 0 = one pkg p; op 1 = xs[i..]. 6 args (emit max). */
let visit_go(op, p, xs, i, seen, order) =
  if op == 0 then
    if in_list(p, seen) then [seen, order]
    else if p == "rt.num" then [cons(p, seen), order]
    else if link_is_dylib(p) then [cons(p, seen), cons(p, order)]
    else
      let seen1 = cons(p, seen) in
      let st = visit_go(1, p, pkg_file_imports(p), 0, seen1, order) in
      [nth(st, 0), cons(p, nth(st, 1))]
  else if i >= len(xs) then [seen, order]
  else
    let st = visit_go(0, nth(xs, i), xs, i, seen, order) in
    visit_go(1, p, xs, i + 1, nth(st, 0), nth(st, 1))

let link_need_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_local_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

/* Package names declared inside a source (used to skip them when linking). */
let ast_packages(ast, i, acc) =
  if i >= len(ast) then acc
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "package" then
      ast_packages(ast, i + 1, cons(nth(e, 1), acc))
    else ast_packages(ast, i + 1, acc)

/* Drop imports of packages defined inside the same source. */
let skip_local_imp(ast, local, i, acc) =
  if i >= len(ast) then reverse(acc)
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "import" then
      if in_list(nth(e, 1), local) then skip_local_imp(ast, local, i + 1, acc)
      else skip_local_imp(ast, local, i + 1, cons(e, acc))
    else skip_local_imp(ast, local, i + 1, cons(e, acc))

let link_from_ast(ast) =
  let pkgs = ast_packages(ast, 0, []) in
  let ast1 = skip_local_imp(ast, pkgs, 0, []) in
  let filled = rewrite_imports(ast1, 0, []) in
  let _ = box_set(link_need_box, ast_imports(ast1, 0, [])) in
  let _ = box_set(link_local_box, pkgs) in
  let _ = imap_load(filled, 0) in
  0

let rt_cache_num =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let rt_base(_) =
  let c = box_get(rt_cache_num) in
  if c == 0 then
    let v = lir_extend("rt.num", pkg_src("rt.num"), runtime_funs(0)) in
    let _ = box_set(rt_cache_num, v) in
    v
  else c

let rt_for_link(_) =
  let st = visit_go(1, 0, box_get(link_need_box), 0,
                    cons("rt.num", box_get(link_local_box)), []) in
  let pkgs = reverse(nth(st, 1)) in
  let rec(i, acc) =
    if i >= len(pkgs) then acc
    else
      let p = nth(pkgs, i) in
      if p == "rt.num" then rec(i + 1, acc)
      else if link_is_dylib(p) == 1 then
        let src = pkg_dylib_synth(p) in
        rec(i + 1, lir_extend_dylib(p, src, acc))
      else rec(i + 1, lir_extend(p, pkg_src(p), acc)) in
  runtime_add(rec(0, rt_base(0)))

let pass_lir(anf_list) =
  let rt0 = rt_for_link(0) in
  let _ = pkg_prefix_set("") in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let entry = start_proc(nth(st, 1), nth(st, 5), nth(st, 4)) in
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

/* In-process image: _eval + print, not OS _start. */
let pass_lir_yjit(anf_list) =
  let rt0 = rt_for_link(0) in
  let _ = pkg_prefix_set("") in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let nslots = nth(st, 1) in
  let pslot = nth(st, 5) in
  let b0 = insn_extend(insn_push(list_new(), ["local", nslots + 8, 0]),
                       nth(st, 4)) in
  let ins =
    insn_push(insn_push(insn_push(b0,
      ["mov_imm", nslots, 2]),
      ["fcall", nslots + 1, "print", [pslot, nslots]]),
      ["ret", pslot]) in
  let entry = ["proc", "_eval", 0, 0, ins, "_eval"] in
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

let fun_off(fo, name) =
  if fo == [] then 0
  else if nth(nth(fo, 0), 0) == name then nth(nth(fo, 0), 1)
  else fun_off(drop(fo, 1), name)

let pack_yjit_prog(t, code) =
  let ent = fun_off(funsym_get(0), "_eval") in
  let abi = if emit_abi_win(0) then 1 else 0 in
  let lay = yjit_layout_get(0) in
  let drel = if lay == 0 then 0 else nth(lay, 2) in
  let link = yjit_imp_enc(cimport_got(0), cimport_names(0)) in
  pack_yjit_ex(code, yjit_arch_num(target_arch(t)),
               [abi, target_vaddr(t), ent, drel, link, 1])

let make_pipeline(t) =
  let pass_lir_t(anf) =
    if target_format(t) == "yjit" then pass_lir_yjit(anf) else pass_lir(anf) in
  let pass_lower(ast) = nth(lower_expr(ast, t), 0) in
  let pass_pack(code) =
    if target_format(t) == "yjit" then pack_yjit_prog(t, code)
    else backend_pack(t, code) in
  [mk_pass("lex", pass_lex),
   mk_pass("parse", pass_parse),
   mk_pass("anf", pass_anf),
   mk_pass("lir", pass_lir_t),
   mk_pass("lower", pass_lower),
   mk_pass("pack", pass_pack)]

let dump_ast(src) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else
    let _ = print(ast) in 0

let dump_anf(src) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(pass_anf(ast)) in 0

let dump_cps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in 0

let eval_cps_src(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = eval_cps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if nth(r, 0) == "err" then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(nth(r, 1)) in 0

let dump_uncps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = uncps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if uncps_is_err(r) then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(r) in 0

/* Compile-session environment (BOOTSTRAP_LINK.md 12.13 B1/B2-B). One value
 * per independent compile; snapshots the host session globals a compile
 * rewrites, applied on entry and restored on every exit (incl. the syntax /
 * unbound early returns). The lir-side lexical environment (imap / malias /
 * pkg_prefix) is ONE value (lir session env, 12.13 B2-B) and is swapped
 * atomically. Later batches (B3) cover emit/pack-side globals explicitly
 * instead of through process-global boxes; callers that must not share
 * state (host leaves, REPL rows) create their own env.
 * Fields: 0 emit_jsess, 1 lir session env, 2 link_need, 3 link_local,
 * 4 yjit_layout, 5 pkg_fail, 6 link_pkg, 7 link_global, 8 extbind,
 * 9 pkg_extra. */
let compile_env_new(_) =
  [emit_jsess(0), session_get(0), box_get(link_need_box),
   box_get(link_local_box), yjit_layout_get(0), pkg_fail(0),
   box_get(link_pkg_box), box_get(link_global_box), box_get(extbind_box),
   box_get(pkg_extra_box)]

let compile_env_leave(env) =
  let _ = session_set(nth(env, 1)) in
  let _ = box_set(link_need_box, nth(env, 2)) in
  let _ = box_set(link_local_box, nth(env, 3)) in
  let _ =
    if nth(env, 4) == 0 then 0
    else yjit_layout_set(nth(nth(env, 4), 0), nth(nth(env, 4), 1),
                         nth(nth(env, 4), 2), nth(nth(env, 4), 3)) in
  let _ = pkg_fail_set(nth(env, 5)) in
  let _ = box_set(link_pkg_box, nth(env, 6)) in
  let _ = box_set(link_global_box, nth(env, 7)) in
  let _ = box_set(extbind_box, nth(env, 8)) in
  let _ = box_set(pkg_extra_box, nth(env, 9)) in
  let _ = emit_jsess_set(nth(env, 0)) in
  0

let compile_env_of(env, src, t) =
  let _ = emit_jsess_set(0) in
  let ast0 = pass_parse(pass_lex(src)) in
  if prog_has_err(ast0, 0) then
    let _ = report_syntax(ast0) in
    compile_env_leave(env)
  else if report_unbound(src, ast0) != 0 then
    compile_env_leave(env)
  else
    let _ = pkg_fail_set(0) in
    let _ = link_from_ast(ast0) in
    /* ast0 is already the parsed program (syntax + unbound checks above);
     * rerunning lex+parse on src would duplicate ~6s of a ~38s self-compile. */
    let bin = run_passes(drop(make_pipeline(t), 2), ast0) in
    /* read pkg_fail BEFORE leave restores the caller's value */
    let failed = pkg_fail(0) in
    let _ = compile_env_leave(env) in
    if failed != 0 then 0 else bin

let compile_native(src, t) = compile_env_of(compile_env_new(0), src, t)

