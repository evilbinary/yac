/* backend.yac — pipeline + image. lir_expr = ANF→LIR；lower_expr = LIR→emit. */

package back.backend
export compile_native, dump_ast, dump_anf, dump_cps, dump_uncps, eval_cps_src, make_pipeline, pass_lex, pass_parse, pass_anf, pkg_set, report_unbound, report_unbound_ex, link_from_ast, backend_pack, backend_compile, backend_emit, ast_imports, ast_packages, skip_local_imp, fun_off, link_need_box, link_local_box, rewrite_imports, rt_for_link, compiler_top_env, compiler_env_bind
import back.lower
import back.pack.elf {elf_shared_set, funsym_get, pack_elf, pack_elf_libc}
import back.pack.target {mk_target, target_arch, target_emachine, target_format, target_shared, target_text_off, target_vaddr}
import back.pack.pe {pack_pe_target, pe_finish_dll, pe_finish_imports}
import back.pack.pack {pack_image}
import lib.map
import back.emit.emit {cimport_got, cimport_n, cimport_names, emit_abi_win, yjit_layout_get}
import front.lir {env_new, imap_box, imap_load, import_alias, in_list, insn_extend, insn_push, lir_all, malias_box, pkg_prefix_get, pkg_prefix_set, sigma_list, sigma_of_rt, start_proc, tco_prog, ub_prog}
import front.lexer {tok_ident_line, tokenize}
import front.parser {parse_program, prog_has_err, report_syntax}
import front.anf {anf_all}
import front.cps {cps_all, cps_maybe_opt}
import front.eval_cps {eval_cps_all}
import front.uncps {uncps_all, uncps_is_err}
import lib.pass {mk_pass, run_passes}
import back.pack.yjit {pack_yjit_ex, yjit_arch_num, yjit_imp_enc}
import rt.os {host_arch, host_format}

let reverse(xs) = list_rev(xs)


let backend_emit(t, ast) = nth(lower_expr(ast, t), 0)

let backend_pack(t, code) =
  let _ = elf_shared_set(if target_shared(t) then 1 else 0) in
  if target_format(t) == "pe" then
    let img = pack_pe_target(t, code) in
    let _ = pe_finish_imports(img, t, cimport_names(0), cimport_got(0)) in
    let _ = if target_shared(t) then pe_finish_dll(img, t) else 0 in
    img
  else if target_format(t) != "elf" then pack_image(t, code)
  else if cimport_n(0) != 0 then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else if target_shared(t) then
    pack_elf_libc(code, target_emachine(t), target_vaddr(t),
                  target_text_off(t), cimport_names(0), cimport_got(0))
  else pack_image(t, code)

let backend_compile(prog) = pack_elf(nth(lower_program(prog), 0))

let pass_lex(src) = tokenize(src)
let pass_parse(toks) = parse_program(toks, 0, [])
let pass_anf(prog) = anf_all(0, prog, list_new(), len(prog))

/* Package lookup must not import path: loading path.yac would recurse. */
let path_dirname(s) =
  let n = str_len(s) in
  let rec(i) =
    if i < 0 then 0 - 1
    else
      let c = str_ref(s, i) in
      if c == 47 then i
      else if c == 92 then i
      else rec(i - 1) in
  let k = rec(n - 1) in
  if k < 0 then "."
  else if k == 0 then "/"
  else str_slice(s, 0, k)

let file_or_0(p) =
  let r = read_file(p) in
  if r == 0 then 0
  else if r == () then 0
  else if str_len(r) == 0 then 0
  else r

let join_path(a, b) = str_cat(a, str_cat("/", b))

/* import a.b.c → a/b/c.yac under a package root. */
let pkg_file(pkg) =
  let n = str_len(pkg) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(pkg, i) in
      if c == 46 then rec(i + 1, str_cat(acc, "/"))
      else rec(i + 1, str_cat(acc, str_chr(c))) in
  str_cat(rec(0, ""), ".yac")

/* 0 = --pkg not given; else list of roots. */
let pkg_extra_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

/* Comma-separated roots. Empty segments (a,,b or trailing comma) → 0. */
let pkg_split(s) =
  let n = str_len(s) in
  let rec(i, start, acc) =
    if i >= n then
      if i == start then 0
      else reverse(cons(str_slice(s, start, i - start), acc))
    else if str_ref(s, i) != 44 then rec(i + 1, start, acc)
    else if i == start then 0
    else rec(i + 1, i + 1, cons(str_slice(s, start, i - start), acc)) in
  if n == 0 then 0 else rec(0, 0, [])

/* Once. Returns 1, or 0 if already set / bad list. */
let pkg_set(csv) =
  if box_get(pkg_extra_box) != 0 then 0
  else
    let xs = pkg_split(csv) in
    if xs == 0 then 0
    else
      let _ = box_set(pkg_extra_box, xs) in
      1

let pkg_try(roots, f, i) =
  if i >= len(roots) then 0
  else
    let r = file_or_0(join_path(nth(roots, i), f)) in
    if r != 0 then r else pkg_try(roots, f, i + 1)

let pkg_src(pkg) =
  let f = pkg_file(pkg) in
  let extra = box_get(pkg_extra_box) in
  let a = if extra == 0 then 0 else pkg_try(extra, f, 0) in
  if a != 0 then a
  else
    let p = file_or_0(join_path("pkg", f)) in
    if p != 0 then p
    else file_or_0(join_path(path_dirname(argv(0)), f))

let intern_names(xs, i, acc) =
  if i >= len(xs) then acc
  else intern_names(xs, i + 1, cons(intern(nth(xs, i)), acc))

/* One file may list export more than once; union them. */
let ast_export_list(ast, i) =
  let rec(j, acc) =
    if j >= len(ast) then acc
    else if nth(nth(ast, j), 0) == "export" then
      rec(j + 1, intern_names(nth(nth(ast, j), 1), 0, acc))
    else rec(j + 1, acc) in
  rec(i, [])

let ast_pkg_name(ast, i) =
  if i >= len(ast) then ""
  else if nth(nth(ast, i), 0) == "package" then nth(nth(ast, i), 1)
  else ast_pkg_name(ast, i + 1)

let pkg_export_names(pkg) =
  let src = pkg_src(pkg) in
  if src == 0 then []
  else ast_export_list(pass_parse(pass_lex(src)), 0)

let import_id_pairs(xs, i, acc) =
  if i >= len(xs) then acc
  else
    let n = nth(xs, i) in
    import_id_pairs(xs, i + 1, cons([n, n], acc))

let import_sel(sel, all, i, acc) =
  if i >= len(sel) then acc
  else
    let spec = nth(sel, i) in
    let orig = intern(nth(spec, 1)) in
    let loc = intern(nth(spec, 0)) in
    if in_list(orig, all) then
      import_sel(sel, all, i + 1, cons([loc, orig], acc))
    else import_sel(sel, all, i + 1, acc)

let fill_import(e) =
  let raw = pkg_export_names(nth(e, 1)) in
  let all =
    if raw != [] then raw
    else if nth(e, 1) != "compiler" then raw
    else intern_names(["compile_file", "compile", "load"], 0, []) in
  let alias = if len(e) > 3 then nth(e, 3) else 0 in
  let pairs =
    if len(e) < 3 then import_id_pairs(all, 0, [])
    else if nth(e, 2) == 0 then import_id_pairs(all, 0, [])
    else import_sel(nth(e, 2), all, 0, []) in
  ["import", nth(e, 1), pairs, alias]

let rewrite_imports(ast, i, acc) =
  if i >= len(ast) then reverse(acc)
  else
    let e = nth(ast, i) in
    let e2 =
      if nth(e, 0) != "import" then e
      else if nth(e, 1) == "compiler" then e
      else fill_import(e) in
    rewrite_imports(ast, i + 1, cons(e2, acc))

/* Compile one rt/*.yac against already-lowered procs so later stdlib
 * files can call earlier ones. Guest always gets rt.num; other packages
 * come from --pkg, ./pkg, then the directory of yc. Do not call
 * runtime_funs() inside a loop. */
let pkg_fail_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let pkg_fail_set(v) = box_set(pkg_fail_box, v)

let pkg_fail(_) = box_get(pkg_fail_box)

let pair_locals(xs, i, acc) =
  if i >= len(xs) then acc
  else pair_locals(xs, i + 1, cons(nth(nth(xs, i), 0), acc))

let rt_fun_names(funs) =
  let rec(i, acc) =
    if i >= len(funs) then acc
    else rec(i + 1, cons(intern(nth(nth(funs, i), 1)), acc)) in
  rec(0, [])

let kernel_names_cache =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let compiler_top_env(_) =
  ["compile_native", "compile_jit", "target_live", "mk_jit_target",
   "mk_target", "host_arch", "host_format"]

let compiler_env_bind(xs, i) =
  if i >= len(xs) then 0
  else
    let n = intern(nth(xs, i)) in
    let _ = box_set(imap_box, cons([n, n], box_get(imap_box))) in
    compiler_env_bind(xs, i + 1)

let kernel_fun_names(_) =
  let c = box_get(kernel_names_cache) in
  if c == 0 then
    let v = rt_fun_names(runtime_funs(0)) in
    let _ = box_set(kernel_names_cache, v) in
    v
  else c

let ast_imports(ast, i, acc) =
  if i >= len(ast) then acc
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "import" then
      let p = nth(e, 1) in
      if in_list(p, acc) then ast_imports(ast, i + 1, acc)
      else ast_imports(ast, i + 1, cons(p, acc))
    else ast_imports(ast, i + 1, acc)

let ast_packages(ast, i, acc) =
  if i >= len(ast) then acc
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "package" then
      ast_packages(ast, i + 1, cons(nth(e, 1), acc))
    else ast_packages(ast, i + 1, acc)

let skip_local_imp(ast, local, i, acc) =
  if i >= len(ast) then reverse(acc)
  else
    let e = nth(ast, i) in
    if nth(e, 0) == "import" then
      if in_list(nth(e, 1), local) then skip_local_imp(ast, local, i + 1, acc)
      else skip_local_imp(ast, local, i + 1, cons(e, acc))
    else skip_local_imp(ast, local, i + 1, cons(e, acc))

let report_unbound_ex(src, ast, extra) =
  let ast1 = skip_local_imp(ast, ast_packages(ast, 0, []), 0, []) in
  let sc0 = pair_locals(box_get(imap_box), 0, kernel_fun_names(0)) in
  let sc1 = pair_locals(box_get(malias_box), 0, sc0) in
  let nm = ub_prog(rewrite_imports(ast1, 0, []), 0, append(extra, sc1)) in
  if nm == "" then 0
  else
    let toks = tokenize(src) in
    let line = tok_ident_line(toks, nm, 0, len(toks)) in
    let pfx = pkg_prefix_get(0) in
    let loc = str_cat(int_to_str(line), ":1: unbound variable '") in
    let msg =
      if pfx == "" then str_cat("error: ", str_cat(loc, str_cat(nm, "'")))
      else str_cat("error: package ",
        str_cat(pfx, str_cat(": ", str_cat(loc, str_cat(nm, "'"))))) in
    let _ = print(msg) in
    1

let report_unbound(src, ast) = report_unbound_ex(src, ast, [])

let lir_extend(pkg, src, acc) =
  if src == 0 then acc
  else
    let ast = pass_parse(pass_lex(src)) in
    if prog_has_err(ast, 0) then
      let _ = print(str_cat("error: syntax in package '", str_cat(pkg, "'"))) in
      let _ = report_syntax(ast) in
      let _ = pkg_fail_set(1) in
      acc
    else
      let saved_i = box_get(imap_box) in
      let saved_m = box_get(malias_box) in
      let saved_p = pkg_prefix_get(0) in
      let filled = rewrite_imports(ast, 0, []) in
      let _ = imap_load(filled, 0) in
      let _ = pkg_prefix_set(ast_pkg_name(ast, 0)) in
      if report_unbound(src, ast) != 0 then
        let _ = pkg_fail_set(1) in
        let _ = box_set(imap_box, saved_i) in
        let _ = box_set(malias_box, saved_m) in
        let _ = pkg_prefix_set(saved_p) in
        acc
      else
        let anf = pass_anf(ast) in
        let st = lir_all(0, anf,
          [env_new(0), 1, sigma_of_rt(acc), 0, list_new(), 0],
          len(anf)) in
        let out = reverse(sigma_list(nth(st, 2))) in
        let _ = box_set(imap_box, saved_i) in
        let _ = box_set(malias_box, saved_m) in
        let _ = pkg_prefix_set(saved_p) in
        out

/* Imports written inside a package source (so http can use net). */
let pkg_file_imports(pkg) =
  if pkg == "compiler" then []
  else
    let src = pkg_src(pkg) in
    if src == 0 then []
    else ast_imports(pass_parse(pass_lex(src)), 0, [])

/* DFS imports. op 0 = one pkg p; op 1 = xs[i..]. 6 args (emit max). */
let visit_go(op, p, xs, i, seen, order) =
  if op == 0 then
    if in_list(p, seen) then [seen, order]
    else if p == "rt.num" then [cons(p, seen), order]
    else if p == "compiler" then [cons(p, seen), order]
    else
      let seen1 = cons(p, seen) in
      let st = visit_go(1, p, pkg_file_imports(p), 0, seen1, order) in
      [nth(st, 0), cons(p, nth(st, 1))]
  else if i >= len(xs) then [seen, order]
  else
    let st = visit_go(0, nth(xs, i), xs, i, seen, order) in
    visit_go(1, p, xs, i + 1, nth(st, 0), nth(st, 1))

let link_need_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_local_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b

let link_from_ast(ast) =
  let pkgs = ast_packages(ast, 0, []) in
  let ast1 = skip_local_imp(ast, pkgs, 0, []) in
  let filled = rewrite_imports(ast1, 0, []) in
  let _ = box_set(link_need_box, ast_imports(ast1, 0, [])) in
  let _ = box_set(link_local_box, pkgs) in
  let _ = imap_load(filled, 0) in
  0

let rt_cache_num =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let rt_base(_) =
  let c = box_get(rt_cache_num) in
  if c == 0 then
    let v = lir_extend("rt.num", pkg_src("rt.num"), runtime_funs(0)) in
    let _ = box_set(rt_cache_num, v) in
    v
  else c

let rt_for_link(_) =
  let st = visit_go(1, 0, box_get(link_need_box), 0,
                    cons("rt.num", box_get(link_local_box)), []) in
  let pkgs = reverse(nth(st, 1)) in
  let rec(i, acc) =
    if i >= len(pkgs) then acc
    else
      let p = nth(pkgs, i) in
      if p == "rt.num" then rec(i + 1, acc)
      else rec(i + 1, lir_extend(p, pkg_src(p), acc)) in
  runtime_add(rec(0, rt_base(0)))

let pass_lir(anf_list) =
  let rt0 = rt_for_link(0) in
  let _ = pkg_prefix_set("") in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let entry = start_proc(nth(st, 1), nth(st, 5), nth(st, 4)) in
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

/* In-process image: _eval + print, not OS _start. */
let pass_lir_yjit(anf_list) =
  let rt0 = rt_for_link(0) in
  let _ = pkg_prefix_set("") in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_of_rt(rt0), 0, list_new(), 0],
             len(anf_list)) in
  let nslots = nth(st, 1) in
  let pslot = nth(st, 5) in
  let b0 = insn_extend(insn_push(list_new(), ["local", nslots + 8, 0]),
                       nth(st, 4)) in
  let ins =
    insn_push(insn_push(insn_push(b0,
      ["mov_imm", nslots, 2]),
      ["fcall", nslots + 1, "print", [pslot, nslots]]),
      ["ret", pslot]) in
  let entry = ["proc", "_eval", 0, 0, ins, "_eval"] in
  tco_prog(["prog", cons(entry, reverse(sigma_list(nth(st, 2)))), "_start"])

let fun_off(fo, name) =
  if fo == [] then 0
  else if nth(nth(fo, 0), 0) == name then nth(nth(fo, 0), 1)
  else fun_off(drop(fo, 1), name)

let pack_yjit_prog(t, code) =
  let ent = fun_off(funsym_get(0), "_eval") in
  let abi = if emit_abi_win(0) then 1 else 0 in
  let lay = yjit_layout_get(0) in
  let drel = if lay == 0 then 0 else nth(lay, 2) in
  let link = yjit_imp_enc(cimport_got(0), cimport_names(0)) in
  pack_yjit_ex(code, yjit_arch_num(target_arch(t)),
               [abi, target_vaddr(t), ent, drel, link, 1])

let make_pipeline(t) =
  let pass_lir_t(anf) =
    if target_format(t) == "yjit" then pass_lir_yjit(anf) else pass_lir(anf) in
  let pass_lower(ast) = nth(lower_expr(ast, t), 0) in
  let pass_pack(code) =
    if target_format(t) == "yjit" then pack_yjit_prog(t, code)
    else backend_pack(t, code) in
  [mk_pass("lex", pass_lex),
   mk_pass("parse", pass_parse),
   mk_pass("anf", pass_anf),
   mk_pass("lir", pass_lir_t),
   mk_pass("lower", pass_lower),
   mk_pass("pack", pass_pack)]

let dump_ast(src) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else
    let _ = print(ast) in 0

let dump_anf(src) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(pass_anf(ast)) in 0

let dump_cps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let _ = print(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in 0

let eval_cps_src(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = eval_cps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if nth(r, 0) == "err" then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(nth(r, 1)) in 0

let dump_uncps(src, do_opt) =
  let ast = pass_parse(pass_lex(src)) in
  if prog_has_err(ast, 0) then
    let _ = report_syntax(ast) in 1
  else if report_unbound(src, ast) != 0 then 1
  else
    let r = uncps_all(cps_maybe_opt(cps_all(pass_anf(ast)), do_opt)) in
    if uncps_is_err(r) then
      let _ = print(str_cat("error: ", nth(r, 1))) in 1
    else
      let _ = print(r) in 0

let compile_native_go(src, t) =
  if src == 0 then 0
  else if is_int(src) then 0
  else if t == 0 then 0
  else
    let saved_i = box_get(imap_box) in
    let saved_m = box_get(malias_box) in
    let saved_p = pkg_prefix_get(0) in
    let saved_n = box_get(link_need_box) in
    let saved_l = box_get(link_local_box) in
    let ast0 = pass_parse(pass_lex(src)) in
    let bin =
      if prog_has_err(ast0, 0) then
        let _ = report_syntax(ast0) in 0
      else if report_unbound(src, ast0) != 0 then 0
      else
        let _ = pkg_fail_set(0) in
        let _ = link_from_ast(ast0) in
        let b = run_passes(make_pipeline(t), src) in
        if pkg_fail(0) != 0 then 0 else b in
    let _ = box_set(imap_box, saved_i) in
    let _ = box_set(malias_box, saved_m) in
    let _ = pkg_prefix_set(saved_p) in
    let _ = box_set(link_need_box, saved_n) in
    let _ = box_set(link_local_box, saved_l) in
    bin

let host_exec_t(_) = mk_target(host_arch(0), host_format(0), "exec")

let host_hc_n =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let host_fold_bin(s) =
  let bin = compile_native_go(s, host_exec_t(0)) in
  if bin == 0 then ["int", "0"]
  else
    let n = box_get(host_hc_n) in
    let _ = box_set(host_hc_n, n + 1) in
    let p = str_cat("build/yc_tmp/hc_", int_to_str(n)) in
    let _ = write_file(p, bin) in
    ["call", ["var", "read_file"], [["str", p]]]

let host_fold_call(nm, args) =
  if nm == "compile" then
    if len(args) < 1 then 0
    else if nth(nth(args, 0), 0) != "str" then 0
    else host_fold_bin(nth(nth(args, 0), 1))
  else if nm == "compile_native" then
    if len(args) < 1 then 0
    else if nth(nth(args, 0), 0) != "str" then 0
    else host_fold_bin(nth(nth(args, 0), 1))
  else if nm == "compile_file" then
    if len(args) < 2 then 0
    else if nth(nth(args, 0), 0) != "str" then 0
    else if nth(nth(args, 1), 0) != "str" then 0
    else
      let src = read_file(nth(nth(args, 0), 1)) in
      if src == 0 then ["int", "1"]
      else
        let bin = compile_native_go(src, host_exec_t(0)) in
        if bin == 0 then ["int", "1"]
        else
          let _ = write_file(nth(nth(args, 1), 1), bin) in
          ["int", "0"]
  else if nm == "load" then
    if len(args) < 1 then 0
    else if nth(nth(args, 0), 0) != "str" then 0
    else
      let src = read_file(nth(nth(args, 0), 1)) in
      if src == 0 then ["int", "1"]
      else
        let p = pass_parse(pass_lex(src)) in
        if prog_has_err(p, 0) then ["int", "1"]
        else
          let rec(i, last) =
            if i >= len(p) then last
            else
              let e = nth(p, i) in
              let k = nth(e, 0) in
              if k == "import" then rec(i + 1, last)
              else if k == "package" then rec(i + 1, last)
              else if k == "export" then rec(i + 1, last)
              else rec(i + 1, e) in
          rec(0, ["int", "0"])
  else 0

let host_fold_go(op, x, i, acc) =
  if op == 0 then
    let k = nth(x, 0) in
    if k == "call" then
      let fn = host_fold_go(0, nth(x, 1), 0, []) in
      let args = host_fold_go(1, nth(x, 2), 0, []) in
      if nth(fn, 0) != "var" then ["call", fn, args]
      else
        let r = host_fold_call(nth(fn, 1), args) in
        if r == 0 then ["call", fn, args] else r
    else if k == "if" then
      ["if", host_fold_go(0, nth(x, 1), 0, []),
       host_fold_go(0, nth(x, 2), 0, []),
       host_fold_go(0, nth(x, 3), 0, [])]
    else if k == "let" then
      ["let", nth(x, 1), host_fold_go(0, nth(x, 2), 0, []),
       host_fold_go(0, nth(x, 3), 0, [])]
    else if k == "fun" then
      ["fun", nth(x, 1), host_fold_go(0, nth(x, 2), 0, [])]
    else if k == "binop" then
      ["binop", nth(x, 1), host_fold_go(0, nth(x, 2), 0, []),
       host_fold_go(0, nth(x, 3), 0, [])]
    else if k == "not" then ["not", host_fold_go(0, nth(x, 1), 0, [])]
    else if k == "list" then ["list", host_fold_go(1, nth(x, 1), 0, [])]
    else x
  else if i >= len(x) then reverse(acc)
  else host_fold_go(1, x, i + 1, cons(host_fold_go(0, nth(x, i), 0, []), acc))

let host_fold(ast) =
  let rec(i, acc) =
    if i >= len(ast) then reverse(acc)
    else
      let e = nth(ast, i) in
      let k = nth(e, 0) in
      if k == "import" then rec(i + 1, cons(e, acc))
      else if k == "package" then rec(i + 1, cons(e, acc))
      else if k == "export" then rec(i + 1, cons(e, acc))
      else rec(i + 1, cons(host_fold_go(0, e, 0, []), acc)) in
  rec(0, [])

let compile_native(src, t) =
  if src == 0 then 0
  else if is_int(src) then 0
  else if t == 0 then 0
  else
    let saved_i = box_get(imap_box) in
    let saved_m = box_get(malias_box) in
    let saved_p = pkg_prefix_get(0) in
    let saved_n = box_get(link_need_box) in
    let saved_l = box_get(link_local_box) in
    let ast0 = pass_parse(pass_lex(src)) in
    let bin =
      if prog_has_err(ast0, 0) then
        let _ = report_syntax(ast0) in 0
      else
        let ast1 = host_fold(ast0) in
        if report_unbound(src, ast1) != 0 then 0
        else
          let _ = pkg_fail_set(0) in
          let _ = link_from_ast(ast1) in
          let b = run_passes(drop(make_pipeline(t), 2), ast1) in
          if pkg_fail(0) != 0 then 0 else b in
    let _ = box_set(imap_box, saved_i) in
    let _ = box_set(malias_box, saved_m) in
    let _ = pkg_prefix_set(saved_p) in
    let _ = box_set(link_need_box, saved_n) in
    let _ = box_set(link_local_box, saved_l) in
    bin

