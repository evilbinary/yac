/* map.yac — open-addressing string map + intern.
 * Bundled before lexer so tokenize can intern ident/kw/op text.
 * hash_str is content hash (C prim / native yac_str_hash). Do not use
 * ident_hash here: native GC does not move objects, but shr-untag mixing
 * collides, and interned keys must hash the same before/after intern.
 */

package lib
export intern, hash_str, fmap_new, fmap_init, fmap_init_n, fmap_new64, fmap_get, fmap_get_h, fmap_put, fmap_put_h, fmap_push

let hash_str(s) = str_hash(s)

let fmap_fill(b, i, cap) =
  if i >= cap then b
  else
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    fmap_fill(b, i + 16, cap)

let fmap_new(_) =
  let m = list_new() in
  let _ = list_push(m, list_new()) in
  let _ = list_push(m, 0) in
  let _ = list_push(m, 0) in
  m

/* Content == (yac_str_eq loops). Do not walk bytes in Yac: intern_str_eq_at
 * was one frame per character and blew the stack around 4KiB. */
let fmap_probe(vec, k, h, i, mask) =
  let e = nth(vec, i) in
  if e == 0 then i
  else
    let hit =
      if nth(e, 2) == h then nth(e, 0) == k
      else false in
    if hit then i
    else
      let i2 = band(i + 1, mask) in
      if i2 == band(h, mask) then 0 - 1
      else fmap_probe(vec, k, h, i2, mask)

let fmap_got(e) =
  if e == 0 then 0 else nth(e, 1)

let fmap_cap_ok(cap) =
  if is_int(cap) then
    if cap < 1 then false
    else if cap > 1048576 then false
    else band(cap, cap - 1) == 0
  else false

let fmap_get_h(m, k, h) =
  let cap = nth(m, 2) in
  if fmap_cap_ok(cap) then
    let p = fmap_probe(nth(m, 0), k, h, band(h, cap - 1), cap - 1) in
    if p < 0 then 0 else fmap_got(nth(nth(m, 0), p))
  else 0

let fmap_get(m, k) =
  let cap = nth(m, 2) in
  if cap == 0 then 0
  else fmap_get_h(m, k, hash_str(k))

let fmap_put_at(m, k, v, h, i) =
  let vec = nth(m, 0) in
  if nth(vec, i) == 0 then
    let _ = list_set(vec, i, [k, v, h]) in
    list_set(m, 1, nth(m, 1) + 1)
  else list_set(vec, i, [k, v, h])

let fmap_install_hash(m, k, v, h) =
  let vec = nth(m, 0) in
  let mask = nth(m, 2) - 1 in
  let p = fmap_probe(vec, k, h, band(h, mask), mask) in
  if p < 0 then fmap_put_at(m, k, v, h, band(h, mask))
  else fmap_put_at(m, k, v, h, p)

let fmap_install(m, k, v) =
  fmap_install_hash(m, k, v, hash_str(k))

let fmap_rehash(oldv, m, i, oldc) =
  if i >= oldc then 0
  else
    let e = nth(oldv, i) in
    if e == 0 then fmap_rehash(oldv, m, i + 1, oldc)
    else
      let _ = fmap_install_hash(m, nth(e, 0), nth(e, 1), nth(e, 2)) in
      fmap_rehash(oldv, m, i + 1, oldc)

let fmap_grow_prep(m, oldc) =
  let _ = list_set(m, 0, fmap_fill(list_new(), 0, oldc * 2)) in
  let _ = list_set(m, 1, 0) in
  list_set(m, 2, oldc * 2)

let fmap_init(m) =
  let _ = list_set(m, 0, fmap_fill(list_new(), 0, 64)) in
  list_set(m, 2, 64)

let fmap_init_n(m, cap) =
  let _ = list_set(m, 0, fmap_fill(list_new(), 0, cap)) in
  list_set(m, 2, cap)

let fmap_new64(_) =
  let m = fmap_new(0) in
  let _ = fmap_init_n(m, 64) in
  m

let fmap_swap(oldv, m, oldc) =
  let _ = fmap_grow_prep(m, oldc) in
  fmap_rehash(oldv, m, 0, oldc)

let fmap_grow(m) =
  let oldv = nth(m, 0) in
  fmap_swap(oldv, m, nth(m, 2))

let fmap_maybe_grow(m) =
  let cap = nth(m, 2) in
  if fmap_cap_ok(cap) then
    if nth(m, 1) * 2 >= cap then fmap_grow(m) else 0
  else fmap_init(m)

let fmap_put_h(m, k, v, h) =
  let _ = fmap_maybe_grow(m) in
  fmap_install_hash(m, k, v, h)

let fmap_put(m, k, v) = fmap_put_h(m, k, v, hash_str(k))

let fmap_push(m, k, v) =
  let h = hash_str(k) in
  let old = fmap_get_h(m, k, h) in
  if old == 0 then fmap_put_h(m, k, [v], h)
  else fmap_put_h(m, k, cons(v, old), h)

/* One intern table per process; keys are canonical string objects.
 * Box (cons) so GC marks the map via car; a listbuf cell was collected
 * and reused, then nth(m,2) was nil, cap-1=-1, probe index = full hash. */
let intern_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let intern_init(_) =
  let nm = fmap_new(0) in
  let _ = fmap_init_n(nm, 4096) in
  let _ = box_set(intern_box, nm) in
  nm

let intern(s) =
  let m0 = box_get(intern_box) in
  let cap = if m0 == 0 then 0 else nth(m0, 2) in
  let m = if fmap_cap_ok(cap) then m0 else intern_init(0) in
  let h = str_hash(s) in
  let e = fmap_get_h(m, s, h) in
  if e == 0 then
    let _ = fmap_put_h(m, s, s, h) in
    s
  else e
