/* log.yac — structured progress logging for the self-hosted compiler.
 *
 * Format (one line):
 *   [<HH:MM:SS.mmm>] [<module>] <msg>
 *
 * Example:
 *   [12:25:30.012] [yc] src_len=54
 *
 * API:
 *   log(mod, msg)       — string message
 *   log_i(mod, key, n)  — key=int helper
 *
 * Off unless `--verbose` (yc) / `log_set_hush(false)`. Pass wall times:
 *   [..] [prof] lex=8
 * C interpreter function profile (counts + incl/excl ns):
 *   ./yac --prof-out FILE.prof bundle.yac input.yac
 *   # or YAC_PROF_OUT=FILE.prof ./yac ...
 * Native yc_a: same --prof-out TSV (enter/leave around each letfun).
 *
 * Requires prims: time_str, str_cat, int_to_str, print, box_*.
 * Bundle this file first so drivers / stages can call it.
 */

package lib
export log, log_i, log_set_hush, log_get_hush

let log_hush =
  let b = box_new() in
  let _ = box_set(b, true) in
  b
let log_set_hush(v) = box_set(log_hush, v)
let log_get_hush(_) = box_get(log_hush)

let log(mod, msg) =
  if box_get(log_hush) then 0
  else
    let line =
      str_cat("[",
        str_cat(time_str(),
          str_cat("] [",
            str_cat(mod,
              str_cat("] ", msg))))) in
    let _ = print line in
    0

let log_i(mod, key, n) =
  log(mod, str_cat(key, str_cat("=", int_to_str(n))))
