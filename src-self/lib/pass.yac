/* pass.yac — run the compiler's pass list.
 *
 * Pass: ["pass", name, fn]   fn : value -> value
 *
 * The list lives in backend.yac (not tests):
 *   src -lex-> tok -parse-> ast -anf-> anf -lower-> lir -emit-> pack
 * Later ANF opts go between "anf" and "lower". pack is the container.
 */

package lib
export mk_pass, run_pass, run_passes, pass_name, pass_fn
import lib.log {log}

let mk_pass(name, fn) = ["pass", name, fn]

let pass_name(p) = nth(p, 1)
let pass_fn(p) = nth(p, 2)

let run_pass(p, x) =
  let name = pass_name(p) in
  let _ = log("yc", name) in
  let t0 = time_ms() in
  let fn = pass_fn(p) in
  let r = fn(x) in
  let _ = log_i("prof", name, time_ms() - t0) in
  r

let run_passes(ps, x) =
  let n = len(ps) in
  let loop(i, cur) =
    if i >= n then cur
    else loop(i + 1, run_pass(nth(ps, i), cur)) in
  loop(0, x)
