/* lir.yac — ANF → LIR（对标 anf_expr：AST → ANF）.
 *
 * 输入：anf.yac 的 body 列表，每项是 ANF：
 *   body ::= [ [bind*], atom ]
 * 输出：DESIGN §LIR 的 list，不是构造器、也不是机器码：
 *
 *   ["prog", [proc*], entryName]
 *   ["proc"|"$proc", name, nparams, ncap, [insn*], srcname]
 *   ; 帧：["local"| "$local", nslots, nparams]；$proc 或首条 $local → 原生槽（x86 栈图 nslots=0）
 *   insn 为 ["mov_imm", s, int] | ["add", s, s, s] | ["fcall", s, name, [s*]] | …
 *
 * runtime_funs 在 runtime.yac（本文件之后）。公开入口对标 anf_expr：
 *   lir_expr(ast, st)  一项 ANF body × 状态 → [insns, slot, Γ, ctr, Σ, uid]
 */

package front.lir
export lir_all, lir_expr, start_proc, tco_prog, imap_load, imap_load_merge, imap_reset, pkg_prefix_set, pkg_prefix_get, pkg_qn, env_new, sigma_of_rt, sigma_host_seed, sigma_list, sigma_new, sigma_kind, toplevel_seed, is_prim_name, import_alias, import_locals, in_list, imap_box, malias_box, env_slot, insn_extend, insn_push, st_no, ub_prog, lir_tlv_set
import lib.map
import lib.log {log_fatal}

let reverse(xs) = list_rev(xs)

/* Guest import aliases: local name → LIR key (env/get). Module as-name → pkg. */
let imap_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b
let malias_box =
  let b = box_new() in
  let _ = box_set(b, []) in
  b
let pkg_prefix_box =
  let b = box_new() in
  let _ = box_set(b, "") in
  b

let pkg_is_rt(p) =
  if str_len(p) < 3 then false
  else if str_ref(p, 0) != 114 then false
  else if str_ref(p, 1) != 116 then false
  else str_ref(p, 2) == 46

/* rt.* keeps bare LIR names (kernel fcall yac_num_slow). */
let pkg_qn(pkg, name) =
  if pkg == "" then name
  else if pkg_is_rt(pkg) then name
  else str_cat(pkg, str_cat("/", name))

/* Host leaves baked into the yc image's own G+136..G+216 (10 slots). A
 * guest gets one via `import pkg {@name}`; it stays a bare name so emit
 * calls through the slot. Names must stay in sync with host_names_box in
 * back.emit.emit and with the bake loop in back.jit host_tab_fill. */
let host_slot_names = ["compile", "compile_file", "load", "compile_native",
                       "compile_jit", "mk_target", "mk_jit_target",
                       "target_live", "host_arch", "host_format"]

/* Top-level recursion (no nested closure): match an interned name against
 * the slot list by index. */
let host_match_i(t, i) =
  if i >= len(host_slot_names) then false
  else if t == intern(nth(host_slot_names, i)) then true
  else host_match_i(t, i + 1)

let is_host_name(nm) = host_match_i(intern(nm), 0)

let imap_find(xs, k, i) =
  if i >= len(xs) then 0
  else if nth(nth(xs, i), 0) == k then nth(nth(xs, i), 1)
  else imap_find(xs, k, i + 1)

let malias_find(xs, k, i) =
  if i >= len(xs) then 0
  else if nth(nth(xs, i), 0) == k then nth(nth(xs, i), 1)
  else malias_find(xs, k, i + 1)

let qvar_key(a, f) =
  let pkg = malias_find(box_get(malias_box), a, 0) in
  if pkg == 0 then 0
  else pkg_qn(pkg, f)

let imap_reset(_) =
  let _ = box_set(imap_box, []) in
  let _ = box_set(malias_box, []) in
  0

let imap_add_pair(pkg, spec) =
  let q =
    if len(spec) > 2 then intern(nth(spec, 1))
    else pkg_qn(pkg, intern(nth(spec, 1))) in
  box_set(imap_box, cons([intern(nth(spec, 0)), intern(q)], box_get(imap_box)))

let imap_add_pairs(pkg, pairs, i) =
  if i >= len(pairs) then 0
  else
    let _ = imap_add_pair(pkg, nth(pairs, i)) in
    imap_add_pairs(pkg, pairs, i + 1)

let imap_load_one(e) =
  if nth(e, 0) != "import" then 0
  else if len(e) < 3 then 0
  else
    let pkg = nth(e, 1) in
    let pairs = nth(e, 2) in
    let alias = if len(e) > 3 then nth(e, 3) else 0 in
    if alias != 0 then
      if alias == "" then 0
      else box_set(malias_box, cons([intern(alias), intern(pkg)], box_get(malias_box)))
    else if pairs == 0 then 0
    else imap_add_pairs(pkg, pairs, 0)

let imap_load(ast, i) =
  if i == 0 then
    let _ = imap_reset(0) in
    imap_load(ast, 1)
  else if i - 1 >= len(ast) then 0
  else
    let _ = imap_load_one(nth(ast, i - 1)) in
    imap_load(ast, i + 1)

let imap_load_merge(ast, i) =
  if i >= len(ast) then 0
  else
    let _ = imap_load_one(nth(ast, i)) in
    imap_load_merge(ast, i + 1)

let pkg_prefix_set(p) = box_set(pkg_prefix_box, p)
let pkg_prefix_get(_) = box_get(pkg_prefix_box)

let fv_skip_go(xs, name, i, n, acc) =
  if i >= n then acc
  else if nth(xs, i) == name then fv_skip_go(xs, name, i + 1, n, acc)
  else
    let _ = list_push(acc, nth(xs, i)) in
    fv_skip_go(xs, name, i + 1, n, acc)

let fv_skip(xs, name) = fv_skip_go(xs, name, 0, len(xs), list_new())

/* DESIGN bin(op,s,a,b). User + - * / go through yac_num_* (int fast path
 * or IEEE f64 boxes). % and bits stay integer insns. */
let bin(op, d, a, b) =
  if op == "+" then ["fcall", d, "yac_num_add", [a, b]]
  else if op == "-" then ["fcall", d, "yac_num_sub", [a, b]]
  else if op == "*" then ["fcall", d, "yac_num_mul", [a, b]]
  else if op == "/" then ["fcall", d, "yac_num_div", [a, b]]
  else if op == "%" then ["rem", d, a, b]
  else if op == "and" then ["land", d, a, b]
  else if op == "or" then ["lor", d, a, b]
  else if op == "<<" then ["shl", d, a, b]
  else if op == ">>" then ["shr", d, a, b]
  else if op == "&" then ["land", d, a, b]
  else if op == "|" then ["lor", d, a, b]
  else if op == "^" then ["xor", d, a, b]
  else if op == "~" then ["bnot", d, a, b]
  else ["add", d, a, b]

let tco_hit(ins, slot, gname, i) =
  if nth(ins, 1) == slot then
    if nth(ins, 2) == gname then
      if len(nth(ins, 3)) > 6 then 0 - 1
      else i
    else 0 - 1
  else 0 - 1

let tco_find(insns, i, slot, gname) =
  if i < 0 then 0 - 1
  else if nth(nth(insns, i), 0) == "ret" then
    tco_find(insns, i - 1, nth(nth(insns, i), 1), gname)
  else if nth(nth(insns, i), 0) == "label" then
    tco_find(insns, i - 1, slot, gname)
  else if nth(nth(insns, i), 0) == "mov" then
  if nth(nth(insns, i), 1) == slot then
      tco_find(insns, i - 1, nth(nth(insns, i), 2), gname)
    else 0 - 1
  else if nth(nth(insns, i), 0) == "fcall"
       or nth(nth(insns, i), 0) == "ycall" then
    tco_hit(nth(insns, i), slot, gname, i)
  else 0 - 1

let tco_one(ins) =
  if nth(ins, 0) == "fcall" or nth(ins, 0) == "ycall" then
    ["tcall", nth(ins, 1), nth(ins, 2), nth(ins, 3)]
  else if nth(ins, 0) == "apply" then
    ["tailapply", nth(ins, 1), nth(ins, 2), nth(ins, 3), nth(ins, 4)]
  else if nth(ins, 0) == "icall" then
    ["ticall", nth(ins, 1), nth(ins, 2), nth(ins, 3)]
  else ins

let tco_fun_at(f, idx) =
  if idx == 0 - 1 then f
  else
    let insns = nth(f, 4) in
    let _ = list_set(insns, idx, tco_one(nth(insns, idx))) in
    f

let tco_fun(f) =
  if len(nth(f, 4)) < 2 then f
  else tco_fun_at(f, tco_find(nth(f, 4), len(nth(f, 4)) - 1, 0, nth(f, 1)))

let tco_prog(p) =
  let funs = nth(p, 1) in
  let n = len(funs) in
  let out = list_new() in
  let loop(i) =
    if i >= n then out
    else
      let _ = list_push(out, tco_fun(nth(funs, i))) in
      loop(i + 1) in
  ["prog", loop(0), nth(p, 2)]

/* ---- Γ, Σ, FV ---- */

let insn_push(ins, x) =
  let _ = list_push(ins, x) in ins

let insn_extend(ins, xs) =
  let n = len(xs) in
  let loop(i) =
    if i >= n then ins
    else let _ = list_push(ins, nth(xs, i)) in loop(i + 1) in
  loop(0)

/* fmap_* / hash_str / intern: map.yac (bundled before lexer). */

let sset_new(_) = fmap_new64(0)
let sset_put(m, k) =
  let _ = fmap_put(m, k, 1) in m
let sset_has(m, k) =
  if fmap_get(m, k) == 0 then false else true

let sh_new(_) = [fmap_new64(0), 1]
let sh_from_list(xs) =
  let sh = sh_new(0) in
  let n = len(xs) in
  let loop(i) =
    if i >= n then sh
    else
      let _ = fmap_push(nth(sh, 0), nth(xs, i), nth(sh, 1)) in
      loop(i + 1) in
  loop(0)
let sh_put(sh, k) =
  let _ = fmap_push(nth(sh, 0), k, nth(sh, 1)) in sh
let sh_has_at(ch, j, n, dcur) =
  if j >= n then false
  else if nth(ch, j) > dcur then sh_has_at(ch, j + 1, n, dcur)
  else true
let sh_has_chain(ch, dcur) = sh_has_at(ch, 0, len(ch), dcur)
let sh_has(sh, k) =
  let ch = fmap_get(nth(sh, 0), k) in
  if ch == 0 then false else sh_has_chain(ch, nth(sh, 1))
let sh_enter(sh) = [nth(sh, 0), nth(sh, 1) + 1]

let fv_acc_new(_) = [[], sset_new(0)]
let fv_acc_list(a) = nth(a, 0)
let fv_acc_add_h(a, k, h) =
  let m = nth(a, 1) in
  if fmap_get_h(m, k, h) == 0 then
    let _ = fmap_put_h(m, k, 1, h) in
    [cons(k, nth(a, 0)), m]
  else a

let fv_acc_add(a, k) = fv_acc_add_h(a, k, hash_str(k))

let sigma_new(nrt) =
  let m = fmap_new(0) in
  let _ = fmap_init_n(m, 2048) in
  let tm = fmap_new(0) in
  let _ = fmap_init_n(tm, 4096) in
  [[], m, nrt, tm]

let sigma_list(fs) = nth(fs, 0)
let sigma_map(fs) = nth(fs, 1)
let fun_src(f) = if len(f) > 5 then nth(f, 5) else nth(f, 1)

/* Field 3 is this compile unit's TOP-LEVEL name -> kind map. It lives inside
 * Σ -- which is already threaded as a parameter -- instead of a global box,
 * so no pass has to remember to `reset` it (a forgotten reset used to
 * silently pollute the set; see toplevel_seed / FLAT_ABI.md 1).
 * Kinds: 1 = top-level letfun, 2 = top-level `let` value. */
let sigma_tl(fs) = nth(fs, 3)

let sigma_kind_h(fs, name, h) =
  if len(fs) < 4 then 0
  else fmap_get_h(sigma_tl(fs), name, h)

let sigma_kind(fs, name) = sigma_kind_h(fs, name, hash_str(name))

let sigma_cons(fs, f) =
  let m = sigma_map(fs) in
  let idx =
    if len(nth(f, 4)) == 0 then 0 - 1
    else len(sigma_list(fs)) in
  let g = intern(nth(f, 1)) in
  let src = intern(fun_src(f)) in
  let ent = [nth(f, 1), nth(f, 3), idx, nth(f, 0)] in
  let _ = fmap_put(m, g, ent) in
  let _ = if src == g then 0 else fmap_put(m, src, ent) in
  [cons(f, sigma_list(fs)), m, nth(fs, 2), nth(fs, 3)]

/* Load linked stdlib procs into Σ (kernel+num, plus os/ffi if imported).
 * Unexported lets (os_has) are not in ub_prog scope. */
let sigma_of_rt(rt) =
  let rec(i, fs) =
    if i >= len(rt) then fs
    else rec(i + 1, sigma_cons(fs, nth(rt, i))) in
  rec(0, sigma_new(len(rt)))

let sigma_ent_h(fs, name, h) =
  if len(fs) < 2 then 0
  else fmap_get_h(sigma_map(fs), name, h)

let sigma_ent(fs, name) =
  if len(fs) < 2 then 0
  else fmap_get(sigma_map(fs), name)

let sigma_has(fs, name) =
  if sigma_ent(fs, name) == 0 then false else true

let sigma_code(fs, name) =
  let e = sigma_ent(fs, name) in
  if e == 0 then name else nth(e, 0)

let sigma_ncap(fs, name) =
  let e = sigma_ent(fs, name) in
  if e == 0 then 0 else nth(e, 1)

/* Host bindings (@name) are resolved to bare host-leaf names but have no
 * proc body, so free_vars would capture them as closure vars (ncap>0) and
 * the wrapper's call/closure ABI breaks. Seed the sigma map with a
 * 0-capture entry per host name currently in the import map: free_vars then
 * treats it as a known ncap-0 function (no capture), while emit still routes
 * the fcall through the host slot (name stays bare, no local proc exists).
 * The procs list is untouched, so nothing host-related reaches emit ids. */
let sigma_host_seed(fs) =
  let xs = box_get(imap_box) in
  let m0 = sigma_map(fs) in
  let put(i, m) =
    if i >= len(xs) then [sigma_list(fs), m, nth(fs, 2), nth(fs, 3)]
    else
      let v = nth(nth(xs, i), 1) in
      let m2 =
        if is_host_name(v) then
          let _ = fmap_put(m, v, [v, 0, 0 - 1]) in
          m
        else m in
      put(i + 1, m2) in
  put(0, m0)

/* Register this compile unit's TOP-LEVEL names into Σ's field 3 (kinds:
 * 1 = letfun, 2 = `let` value).
 *
 * The set comes straight from the ANF structure (FLAT_ABI.md 1): each
 * top-level item is one ANF body, so `nth(nth(items, i), 0)` is that item's
 * DIRECT bind list -- we never descend into nested bodies and never guess
 * from the name's shape. A top-level `let x = 5` and a compiler temp `t0`
 * are indistinguishable in ANF and do not need to be told apart.
 *
 * Only `letfun` / `let` are registered. The other bind kinds bind compiler
 * temporaries, and the ANF aliases (["let","y",["var","t0"]]) guarantee a
 * temp never reaches a `fvs`, so they need no entry.
 *
 * PURE: returns Σ with the map and fn-list filled. There is no global box
 * and nothing to `reset` -- the caller just hands the result to lir_all. */
let toplevel_seed(items, i, fs) =
  /* 同单元内重复的顶层同名定义必须报错。yac 的 let 后绑定生效，
   * 第二个定义会静默覆盖第一个（emit_load_rax/rbx_slot 双定义事故：
   * 带操作数分发的新装载器被文件后段的旧定义覆盖，查了两天）。
   * 只守单元顶层；函数体内的 let* 顺序重绑是合法作用域规则，不受影响。 */
  let seen = fmap_new64(0) in
  let walk(i) =
    if i >= len(items) then fs
    else
      let binds = nth(nth(items, i), 0) in
      let tm = sigma_tl(fs) in
      let put(j) =
        if j >= len(binds) then walk(i + 1)
        else
          let b = nth(binds, j) in
          let k = nth(b, 0) in
          let nm = nth(b, 1) in
          let h = hash_str(nm) in
          let _ =
            if fmap_get_h(seen, nm, h) != 0 then
              log_fatal(str_cat("LIR: duplicate top-level definition '",
                                str_cat(nm, "'")))
            else 0 in
          let _ = fmap_put_h(seen, nm, h, 1) in
          let _ =
            if k == "letfun" then fmap_put(tm, nm, 1)
            else if k == "let" then fmap_put(tm, nm, 2)
            else 0 in
          put(j + 1) in
      put(0) in
  walk(0)

let str_to_int(s) =
  let n = str_len(s) in
  let isneg = if n > 0 then str_ref(s, 0) == 45 else false in
  let start = if isneg then 1 else 0 in
  let acc(i, v) =
    if i >= n then v
    else
      let c = str_ref(s, i) in
      if c >= 48 then
        if c <= 57 then acc(i + 1, v * 10 + (c - 48))
        else v
      else v in
  let v = acc(start, 0) in
  if isneg then 0 - v else v

/* Γ : fmap name → stack of [slot, ncap, gen]. Shared across env_enter. */
let env_new(_) =
  let ps = list_new() in
  let _ = list_push(ps, 0) in
  [fmap_new64(0), [0, ps]]

let env_enter(env) =
  let ps = nth(nth(env, 1), 1) in
  let _ = list_push(ps, nth(nth(env, 1), 0)) in
  [nth(env, 0), [len(ps) - 1, ps]]

let env_bind(env, name, slot, ncap) =
  let _ = fmap_push(nth(env, 0), name, [slot, ncap, nth(nth(env, 1), 0)]) in
  env

let env_live(g, cur, parents) =
  if cur == g then true
  else if cur == 0 then false
  else env_live(g, nth(parents, cur), parents)

let env_chain_at(ch, j, cur, parents) =
  if j >= len(ch) then 0
  else if env_live(nth(nth(ch, j), 2), cur, parents) then nth(ch, j)
  else env_chain_at(ch, j + 1, cur, parents)

let env_chain(ch, cur, parents) = env_chain_at(ch, 0, cur, parents)

let env_rec_h(env, name, h) =
  let ch = fmap_get_h(nth(env, 0), name, h) in
  if ch == 0 then 0
  else env_chain(ch, nth(nth(env, 1), 0), nth(nth(env, 1), 1))

let env_rec(env, name) = env_rec_h(env, name, hash_str(name))

let env_slot(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then 0 else nth(e, 0)

let env_ncap(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then 0 else nth(e, 1)

let env_has(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then false else true

let is_cmp(op) =
  if op == "<" then true
  else if op == "<=" then true
  else if op == ">" then true
  else if op == ">=" then true
  else if op == "==" then true
  else if op == "!=" then true
  else false

/* List membership on a cons list. Do not scan by index: nth(cons, i)
 * re-walks the chain from the head for every i, which made the indexed
 * version quadratic (in_list_go ~9.5M calls / ~74 s excl in a self-compile
 * profile). Walk the chain with tail() instead. */
let in_list(name, lst) =
  if lst == [] then false
  else if nth(lst, 0) == name then true
  else in_list(name, tail(lst))

let is_prim_name(w) =
  if w == "cons" then true
  else if w == "len" then true
  else if w == "nth" then true
  else if w == "tail" then true
  else if w == "append" then true
  else if w == "print" then true
  else if w == "map" then true
  else if w == "filter" then true
  else if w == "foldl" then true
  else if w == "foldr" then true
  else if w == "drop" then true
  else if w == "head" then true
  else if w == "str_len" then true
  else if w == "str_hash" then true
  else if w == "ident_hash" then true
  else if w == "str_cat" then true
  else if w == "str_ref" then true
  else if w == "str_slice" then true
  else if w == "str_chr" then true
  else if w == "int_to_str" then true
  else if w == "time_ms" then true
  else if w == "time_ns" then true
  else if w == "time_str" then true
  else if w == "argc" then true
  else if w == "argv" then true
  else if w == "bytes_new" then true
  else if w == "bytes_len" then true
  else if w == "bytes_append" then true
  else if w == "bytes_extend" then true
  else if w == "bytes_ref" then true
  else if w == "bytes_put" then true
  else if w == "mem_ref" then true
  else if w == "mem_put" then true
  else if w == "bytes_to_str" then true
  else if w == "list_new" then true
  else if w == "list_push" then true
  else if w == "list_set" then true
  else if w == "list_rev" then true
  else if w == "box_new" then true
  else if w == "box_get" then true
  else if w == "box_set" then true
  else if w == "yac_prof_cell" then true
  else if w == "read_file" then true
  else if w == "write_file" then true
  else if w == "system" then true
  else if w == "read_line" then true
  else if w == "jit_run" then true
  else if w == "popen" then true
  else if w == "exit" then true
  else if w == "band" then true
  else if w == "bor" then true
  else if w == "bxor" then true
  else if w == "bnot" then true
  else if w == "bshl" then true
  else if w == "bshr" then true
  else if w == "gc_collect" then true
  else if w == "is_int" then true
  else if w == "iadd" then true
  else if w == "isub" then true
  else if w == "imul" then true
  else if w == "idiv" then true
  else if w == "irem" then true
  else if w == "ccall" then true
  else false

let name_has_slash(s, i) =
  if i >= str_len(s) then false
  else if str_ref(s, i) == 47 then true
  else name_has_slash(s, i + 1)

let resolve_call(nm) =
  if is_prim_name(nm) then nm
  else
    let m = imap_find(box_get(imap_box), nm, 0) in
    if m != 0 then m
    else if name_has_slash(nm, 0) then nm
    else
      let p = box_get(pkg_prefix_box) in
      if p == "" then nm
      else if pkg_is_rt(p) then nm
      else pkg_qn(p, nm)

/* ---- unbound-variable check (set-based scopes) ----
 * File scope is a growing fmap `m` (kernel + host + import names and every
 * top-level let already processed; ub_prog only ever adds). A top-level
 * item's own params / nested lets live in a short cons list `locs`, threaded
 * purely so sibling items and branches never see them. This replaced a flat
 * list scan per variable (self-compile: ~9.6M in_list tail calls, ~9.6 s). */

let ub_locs(nm, locs) =
  if locs == [] then false
  else if nth(locs, 0) == nm then true
  else ub_locs(nm, tail(locs))

let ub_has(nm, locs, m) =
  if fmap_get(m, nm) != 0 then true
  else ub_locs(nm, locs)

/* AST scope check (C ANF in_scope). "" = ok, else the unbound name. */
let ub_expr(e, locs, m) =
  let xs(ys, i) =
    if i >= len(ys) then ""
    else
      let u = ub_expr(nth(ys, i), locs, m) in
      if u != "" then u else xs(ys, i + 1) in
  let k = nth(e, 0) in
  if k == "var" then
    let nm = nth(e, 1) in
    if ub_has(nm, locs, m) then ""
    else if is_prim_name(nm) then ""
    else nm
  else if k == "qvar" then
    let a = nth(e, 1) in
    if ub_has(a, locs, m) then ""
    else str_cat(a, str_cat(".", nth(e, 2)))
  else if k == "call" then
    let u = ub_expr(nth(e, 1), locs, m) in
    if u != "" then u else xs(nth(e, 2), 0)
  else if k == "fun" then ub_expr(nth(e, 2), append(nth(e, 1), locs), m)
  else if k == "if" then
    let u = ub_expr(nth(e, 1), locs, m) in
    if u != "" then u
    else
      let u2 = ub_expr(nth(e, 2), locs, m) in
      if u2 != "" then u2 else ub_expr(nth(e, 3), locs, m)
  else if k == "let" then
    let nm = nth(e, 1) in
    let bound = nth(e, 2) in
    let locs1 = if nth(bound, 0) == "fun" then cons(nm, locs) else locs in
    let u = ub_expr(bound, locs1, m) in
    if u != "" then u else ub_expr(nth(e, 3), cons(nm, locs), m)
  else if k == "binop" then
    let u = ub_expr(nth(e, 2), locs, m) in
    if u != "" then u else ub_expr(nth(e, 3), locs, m)
  else if k == "not" then ub_expr(nth(e, 1), locs, m)
  else if k == "callcc" then ub_expr(nth(e, 1), locs, m)
  else if k == "throw" then
    let u = ub_expr(nth(e, 1), locs, m) in
    if u != "" then u else ub_expr(nth(e, 2), locs, m)
  else if k == "list" then xs(nth(e, 1), 0)
  else ""

let import_alias(e) =
  if len(e) > 3 then nth(e, 3) else 0

let import_locals_go(pairs, i, acc) =
  if i >= len(pairs) then acc
  else import_locals_go(pairs, i + 1, cons(nth(nth(pairs, i), 0), acc))

let import_locals(e) =
  if len(e) < 3 then []
  else if nth(e, 2) == 0 then []
  else
    let alias = if len(e) > 3 then nth(e, 3) else 0 in
    if alias != 0 then []
    else import_locals_go(nth(e, 2), 0, [])

let ub_add_name(m, nm) =
  let _ = fmap_put(m, nm, 1) in 0

let ub_prog_i(p, n, i, m) =
  if i >= n then ""
  else
    let e = nth(p, i) in
    let k = nth(e, 0) in
    if k == "package" then ub_prog_i(p, n, i + 1, m)
    else if k == "export" then ub_prog_i(p, n, i + 1, m)
    else if k == "import" then
      let al = import_alias(e) in
      if al != 0 then
        let _ = ub_add_name(m, al) in
        ub_prog_i(p, n, i + 1, m)
      else
        let add_locs(xs) =
          if xs == [] then 0
          else
            let _ = ub_add_name(m, nth(xs, 0)) in
            add_locs(tail(xs)) in
        let _ = add_locs(import_locals(e)) in
        ub_prog_i(p, n, i + 1, m)
    else
      let u = ub_expr(e, [], m) in
      if u != "" then u
      else if k == "let" then
        let _ = ub_add_name(m, nth(e, 1)) in
        ub_prog_i(p, n, i + 1, m)
      else ub_prog_i(p, n, i + 1, m)

let ub_prog(p, i, sc) =
  let m = fmap_new64(0) in
  let seed(xs) =
    if xs == [] then 0
    else
      let _ = ub_add_name(m, nth(xs, 0)) in
      seed(tail(xs)) in
  let _ = seed(sc) in
  ub_prog_i(p, len(p), i, m)

/* Top-level function registry (12.14 flat ABI): names defined as top-level
 * lets of the current compile unit. Flat functions compile with no captured
 * environment (ncap=0); free refs to them skip the caps chain (fcall rel32
 * inside the image, xcall via the entry table across images). */
/* `env` is the enclosing Γ where this letfun is defined. A name that a
 * top-level entry also claims may still be a VISIBLE ENCLOSING LOCAL, and
 * then it must be captured: the top-level table only says the name exists
 * somewhere, never that this occurrence refers to it. Γ wins. */
let free_vars(fnbody, params, funs, env) =
  let fv(anf, acc, shdw) =
    let atom_vars(atom, a, sh) =
      let k = nth(atom, 0) in
      if k == "var" then
        let nm = nth(atom, 1) in
        let h = hash_str(nm) in
        let ch = fmap_get_h(nth(sh, 0), nm, h) in
        let g = resolve_call(nm) in
        if ch == 0 then
          if sigma_kind_h(funs, nm, h) != 0 or sigma_kind_h(funs, g, hash_str(g)) != 0 then
            /* The name also names a top-level binding -- but if it is visible in
             * the enclosing Γ it is a TRUE LOCAL of an enclosing lambda and must
             * be captured (FLAT_ABI.md 1: ncap counts true locals only, top-level
             * names are reached statically). Top-level values no longer enter Γ
             * (see lir_let), so a Γ hit here is always a real capture. */
            if env_rec_h(env, nm, h) != 0 then fv_acc_add_h(a, nm, h) else a
          else
            let se = sigma_ent_h(funs, g, hash_str(g)) in
            if se == 0 then fv_acc_add_h(a, nm, h)
            else if nth(se, 1) == 0 then a
            else fv_acc_add_h(a, nm, h)
        else if sh_has_chain(ch, nth(sh, 1)) then a
        else fv_acc_add_h(a, nm, h)
      else if k == "qvar" then a
      else if k == "fun" then nth(fv(nth(atom, 2), a, sh), 0)
      else a in
    let args_vars(args, j, a, sh) =
      if j >= len(args) then a
      else args_vars(args, j + 1, atom_vars(nth(args, j), a, sh), sh) in
    let binds = nth(anf, 0) in
    let tail = nth(anf, 1) in
    let nb = len(binds) in
    let step(i, a, sh) =
      if i >= nb then [atom_vars(tail, a, sh), sh]
      else
        let b = nth(binds, i) in
        let k = nth(b, 0) in
        let r =
          if k == "let" then
            let atm = nth(b, 2) in
            let a2 = if nth(atm, 0) == "var" then a else atom_vars(atm, a, sh) in
            [a2, sh_put(sh, nth(b, 1))]
          else if k == "letbin" then
            [atom_vars(nth(b, 4), atom_vars(nth(b, 3), a, sh), sh),
             sh_put(sh, nth(b, 1))]
          else if k == "letcall" then
            let fn = nth(b, 2) in
            let a2 =
              if nth(fn, 0) == "qvar" then a
              else if nth(fn, 0) == "var" then
                if is_prim_name(nth(fn, 1)) then a
                else atom_vars(fn, a, sh)
              else atom_vars(fn, a, sh) in
            [args_vars(nth(b, 3), 0, a2, sh), sh_put(sh, nth(b, 1))]
          else if k == "letif" then
            let a2 = atom_vars(nth(b, 2), a, sh) in
            let r1 = fv(nth(b, 3), a2, sh) in
            let r2 = fv(nth(b, 4), nth(r1, 0), nth(r1, 1)) in
            [nth(r2, 0), sh_put(nth(r2, 1), nth(b, 1))]
          else if k == "letfun" then
            let sh2 = sh_enter(sh) in
            let _ = sh_put(sh2, nth(b, 1)) in
            let p = nth(b, 2) in
            let addp(j) =
              if j >= len(p) then 0
              else let _ = sh_put(sh2, nth(p, j)) in addp(j + 1) in
            let _ = addp(0) in
            let rr = fv(nth(b, 3), a, sh2) in
            [nth(rr, 0), sh_put(sh, nth(b, 1))]
          else if k == "letthrow" then
            [atom_vars(nth(b, 3), atom_vars(nth(b, 2), a, sh), sh),
             sh_put(sh, nth(b, 1))]
          else if k == "letcallcc" then
            let a2 = atom_vars(nth(b, 3), a, sh) in
            let sh2 = sh_put(sh, nth(b, 1)) in
            let rr = fv(nth(b, 4), a2, sh2) in
            [nth(rr, 0), sh_put(nth(rr, 1), nth(b, 2))]
          else [a, sh] in
        step(i + 1, nth(r, 0), nth(r, 1)) in
    step(0, acc, shdw) in
  reverse(fv_acc_list(nth(fv(fnbody, fv_acc_new(0), sh_from_list(params)), 0)))

/* ---- Γ ⊢ atom ---- */
/* st = [I, Γ, ctr, Σ, uid]. Returns [I, s, Γ, ctr, Σ, uid]. */

let lir_clos_atom(st, fname) =
  [insn_push(nth(st, 0),
     ["closure", nth(st, 2), fname, []]),
   nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]

let lir_var(atom, st) =
  let nm = nth(atom, 1) in
  let h = hash_str(nm) in
  let e = env_rec_h(nth(st, 1), nm, h) in
  if e != 0 then
    let sl = nth(e, 0) in
    /* Negative slot = capture marker from bind_caps; the self sentinel is
     * the incoming object. Both become operands, not slots (LIR.md 4.4.2). */
    let op =
      if sl == 0 - 1000000 then ["self"]
      else if sl < 0 then ["cap", 0 - sl - 1]
      else sl in
    [nth(st, 0), op,
     nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]
  else
    let g = resolve_call(nm) in
    let se = sigma_ent_h(nth(st, 3), g, hash_str(g)) in
    let k1 = sigma_kind_h(nth(st, 3), nm, h) in
    let kind = if k1 != 0 then k1 else sigma_kind_h(nth(st, 3), g, hash_str(g)) in
    if kind == 2 then
      /* Top-level value: load [cell + 0]. The cell is filled by the `gset`
       * that lir_let emits for this name (baked at link time when the value
       * is a literal). Checked BEFORE the sigma lookup -- top-level values
       * are not procs and are absent from Σ. */
      let i1 = insn_push(nth(st, 0), ["gval", nth(st, 2), g]) in
      [i1, nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
    else if kind == 1 then
      /* Flat function value (12.14): the stub cell's address. In-image
       * compile bakes the entry through emit_map_get, which is keyed by the
       * proc's CODE name (package-qualified) -- so resolve the name through
       * Σ instead of passing the bare ANF name, or the lookup misses and
       * silently bakes offs[0], i.e. the wrong function's entry. */
      let i1 = insn_push(nth(st, 0), ["gvar", nth(st, 2), sigma_code(nth(st, 3), g)]) in
      [i1, nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
    else if se != 0 then lir_clos_atom(st, nth(se, 0))
    else if is_prim_name(nm) then lir_clos_atom(st, "print")
    else
      /* Not in Γ or sigma: a first-class cross-image reference. Flat ABI
       * (12.14): the value is the callee's entry address, loaded from a
       * patch slot the jit layer fills via the host's entry table. */
      let i1 = insn_push(nth(st, 0), ["gvar", nth(st, 2), g]) in
      [i1, nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]

let lir_qvar(atom, st) =
  let g = qvar_key(nth(atom, 1), nth(atom, 2)) in
  if g == 0 then
    [nth(st, 0), 0, nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]
  else
    let se = sigma_ent_h(nth(st, 3), g, hash_str(g)) in
    if se != 0 then lir_clos_atom(st, nth(se, 0))
    else
      [nth(st, 0), 0, nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]

let lir_atom(atom, st) =
  let k = nth(atom, 0) in
  if k == "int" then
    [insn_push(nth(st, 0), ["mov_imm", nth(st, 2), str_to_int(nth(atom, 1)) + str_to_int(nth(atom, 1))]),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else if k == "float" then
    let d = nth(st, 2) in
    let s1 = insn_push(nth(st, 0), ["strlit", d, nth(atom, 1)]) in
    [insn_push(s1, ["fcall", d, "yac_f64_from_str", [d]]),
     d, nth(st, 1), d + 1, nth(st, 3), nth(st, 4)]
  else if k == "nil" then
    [insn_push(nth(st, 0), ["mov_imm", nth(st, 2), 1]),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else if k == "str" then
    [insn_push(nth(st, 0), ["strlit", nth(st, 2), nth(atom, 1)]),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else if k == "bool" then
    let v = if nth(atom, 1) == "true" then 1 else 0 in
    [insn_push(nth(st, 0), ["mov_imm", nth(st, 2), v + v]),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else if k == "unit" then
    [insn_push(nth(st, 0), ["mov_imm", nth(st, 2), 0 + 0]),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else if k == "var" then
    lir_var(atom, st)
  else if k == "qvar" then
    lir_qvar(atom, st)
  else
    let _ = log_fatal(str_cat("LIR: unknown ANF atom '", str_cat(k, "'"))) in
    [nth(st, 0), 0, nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]

/* tail(x): last bind, tail atom is ["var", x], self TCO allowed. */
let rest_is_tail(self, info) =
  if self == "F" then false
  else if nth(info, 0) == nth(info, 1) - 1 then
    if nth(nth(info, 2), 0) == "var" then
      nth(nth(info, 2), 1) == nth(info, 3)
    else false
  else false

let tco_name_ok(self) =
  if self == "parse_expr" then false
  else true

let maybe_tcall(rest_tail, ins, self) =
  if not rest_tail then ins
  else if not tco_name_ok(self) then ins
  else if nth(ins, 0) == "fcall" then
    if nth(ins, 2) == self then
      ["tcall", nth(ins, 1), nth(ins, 2), nth(ins, 3)]
    else ins
  else ins

let cap_slots(n, j, acc) =
  if j > n then acc
  else
    let _ = list_push(acc, j) in
    cap_slots(n, j + 1, acc)

let list_ext(dst, src, i, n) =
  if i >= n then dst
  else
    let _ = list_push(dst, nth(src, i)) in
    list_ext(dst, src, i + 1, n)

let lir_rt_list(g, dst, ss) =
  if g == "cons" then ["fcall", dst, "yac_cons", [nth(ss, 0), nth(ss, 1)]]
  else if g == "len" then ["fcall", dst, "yac_len", [nth(ss, 0)]]
  else if g == "nth" then ["fcall", dst, "yac_nth", [nth(ss, 0), nth(ss, 1)]]
  else if g == "tail" then ["fcall", dst, "yac_tail", [nth(ss, 0)]]
  else if g == "append" then ["fcall", dst, "yac_append", [nth(ss, 0), nth(ss, 1)]]
  else if g == "drop" then ["fcall", dst, "yac_drop", [nth(ss, 0), nth(ss, 1)]]
  else if g == "foldl" then ["fcall", dst, "yac_foldl", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "map" then ["fcall", dst, "yac_map", [nth(ss, 0), nth(ss, 1)]]
  else if g == "list_new" then ["fcall", dst, "yac_list_new", []]
  else if g == "list_push" then ["fcall", dst, "yac_list_push", [nth(ss, 0), nth(ss, 1)]]
  else if g == "list_set" then
    ["fcall", dst, "yac_list_set", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "list_rev" then ["fcall", dst, "yac_list_rev", [nth(ss, 0)]]
  else 0

let lir_rt_str(g, dst, ss) =
  if g == "str_len" then ["str_len", dst, nth(ss, 0)]
  else if g == "str_hash" then ["fcall", dst, "yac_str_hash", [nth(ss, 0)]]
  else if g == "ident_hash" then ["fcall", dst, "yac_ident_hash", [nth(ss, 0)]]
  else if g == "str_ref" then ["str_ref", dst, nth(ss, 0), nth(ss, 1)]
  else if g == "str_cat" then ["fcall", dst, "yac_str_cat", [nth(ss, 0), nth(ss, 1)]]
  else if g == "str_slice" then
    ["fcall", dst, "yac_str_slice", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "str_chr" then ["fcall", dst, "yac_str_chr", [nth(ss, 0)]]
  else if g == "int_to_str" then ["fcall", dst, "yac_int_to_str", [nth(ss, 0)]]
  else if g == "time_ms" then ["fcall", dst, "time_ms", []]
  else if g == "time_ns" then ["fcall", dst, "time_ns", []]
  else if g == "time_str" then ["fcall", dst, "time_str", []]
  else if g == "box_new" then ["fcall", dst, "yac_box_new", []]
  else if g == "box_get" then ["fcall", dst, "yac_box_get", [nth(ss, 0)]]
  else if g == "box_set" then
    ["fcall", dst, "yac_box_set", [nth(ss, 0), nth(ss, 1)]]
  else if g == "yac_prof_cell" then ["fcall", dst, "yac_prof_cell", []]
  else if g == "argc" then ["fcall", dst, "yac_argc", []]
  else if g == "argv" then ["fcall", dst, "yac_argv", [nth(ss, 0)]]
  else 0

let lir_rt_bytes(g, dst, ss) =
  if g == "bytes_to_str" then ["fcall", dst, "yac_bytes_to_str", [nth(ss, 0)]]
  else if g == "bytes_new" then ["fcall", dst, "yac_bytes_new", []]
  else if g == "bytes_len" then ["bytes_len", dst, nth(ss, 0)]
  else if g == "bytes_ref" then ["fcall", dst, "yac_bytes_ref", [nth(ss, 0), nth(ss, 1)]]
  else if g == "bytes_put" then
    ["fcall", dst, "yac_bytes_put", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "mem_ref" then
    ["fcall", dst, "yac_mem_ref", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "mem_put" then
    ["fcall", dst, "yac_mem_put", [nth(ss, 0), nth(ss, 1), nth(ss, 2), nth(ss, 3)]]
  else if g == "bytes_append" then ["fcall", dst, "yac_bytes_append", [nth(ss, 0), nth(ss, 1)]]
  else if g == "bytes_extend" then ["fcall", dst, "yac_bytes_extend", [nth(ss, 0), nth(ss, 1)]]
  else if g == "read_file" then ["fcall", dst, "yac_read_file", [nth(ss, 0)]]
  else if g == "write_file" then ["fcall", dst, "yac_write_file", [nth(ss, 0), nth(ss, 1)]]
  else if g == "system" then ["fcall", dst, "yac_system", [nth(ss, 0)]]
  else if g == "read_line" then ["fcall", dst, "yac_read_line", []]
  else if g == "jit_run" then
    ["fcall", dst, "yac_jit_run", [nth(ss, 0), nth(ss, 1), nth(ss, 2)]]
  else if g == "exit" then ["exit", nth(ss, 0)]
  else if g == "gc_collect" then ["fcall", dst, "gc_collect", []]
  else if g == "band" then bin("&", dst, nth(ss, 0), nth(ss, 1))
  else if g == "bor" then bin("|", dst, nth(ss, 0), nth(ss, 1))
  else if g == "bxor" then bin("^", dst, nth(ss, 0), nth(ss, 1))
  else if g == "bnot" then bin("~", dst, nth(ss, 0), nth(ss, 0))
  else if g == "bshl" then bin("<<", dst, nth(ss, 0), nth(ss, 1))
  else if g == "bshr" then bin(">>", dst, nth(ss, 0), nth(ss, 1))
  else 0

let lir_rt_num(g, dst, ss) =
  if g == "is_int" then ["is_int", dst, nth(ss, 0)]
  else if g == "iadd" then ["add", dst, nth(ss, 0), nth(ss, 1)]
  else if g == "isub" then ["sub", dst, nth(ss, 0), nth(ss, 1)]
  else if g == "imul" then ["mul", dst, nth(ss, 0), nth(ss, 1)]
  else if g == "idiv" then ["div", dst, nth(ss, 0), nth(ss, 1)]
  else if g == "irem" then ["rem", dst, nth(ss, 0), nth(ss, 1)]
  else 0

let lir_rt(g, dst, ss) =
  let a = lir_rt_list(g, dst, ss) in
  if a == 0 then
    let b = lir_rt_str(g, dst, ss) in
    if b == 0 then
      let c = lir_rt_bytes(g, dst, ss) in
      if c == 0 then lir_rt_num(g, dst, ss) else c
    else b
  else a

/* callι: Σ then Γ then runtime. Do not turn every ncap>0 into icall.
 * Named self uses fcall/tcall + capture slots 1..n. */
let calli(g0, dst, ss, env, funs, self, tail) =
  let h0 = hash_str(g0) in
  let e = env_rec_h(env, g0, h0) in
  let g = resolve_call(g0) in
  let h = hash_str(g) in
  if e != 0 then
    let slf = nth(e, 0) == 0 - 1000000 in
    let ncap = nth(e, 1) in
    if slf and ncap == 0 then
      /* Flat self-recursion (capRef): direct ycall -- the callee ignores the
       * object register, and tco_find still matches it for the tloop. */
      let se = sigma_ent_h(funs, g, h) in
      let code = if se == 0 then g else nth(se, 0) in
      ["ycall", dst, code, ss]
    else if slf then
      /* Non-flat self-recursion (capRef): the object is the incoming self
       * itself; apply through ["self"] so the callee reads caps from r13. */
      ["apply", dst, ["self"], ncap, ss]
    else if ncap > 0 then
      /* The callee is a captured closure: capRef binds its Gamma slot to a
       * NEGATIVE marker, so it must become the ["cap", j] operand (same
       * conversion as lir_var/outer_caps) before it can be applied. The
       * old fcall-with-caps-as-args path is gone under the object ABI. */
      let cs = nth(e, 0) in
      let clo = if cs < 0 then ["cap", 0 - cs - 1] else cs in
      ["apply", dst, clo, ncap, ss]
    else
      let se = sigma_ent_h(funs, g, h) in
      if se != 0 then
        let ci = if len(se) > 3 and nth(se, 3) == "proc" then ["ycall", dst, nth(se, 0), ss]
                 else ["fcall", dst, nth(se, 0), ss] in
        ci
      else ["icall", dst, nth(e, 0), ss]
  else
    let se = sigma_ent_h(funs, g, h) in
    if se != 0 then
      let ci = if len(se) > 3 and nth(se, 3) == "proc" then ["ycall", dst, nth(se, 0), ss]
               else ["fcall", dst, nth(se, 0), ss] in
      ci
    else
      let p = lir_rt(g0, dst, ss) in
      if p != 0 then p
      else if str_slice(g, 0, 4) == "yac_" then ["fcall", dst, g, ss]
      else
        /* Cross-image call (12.14 flat ABI): the callee's entry address is
         * loaded from a patch slot the jit layer fills from the host's
         * name-keyed entry table, then called with the plain arg layout. */
        ["xcall", dst, dst + 1, g, ss]

let lir_loadargs(args, p, slots_rev) =
  if nth(p, 0) >= len(args) then
    [nth(p, 1), reverse(slots_rev), nth(p, 2), nth(p, 3)]
  else
    let r = lir_atom(nth(args, nth(p, 0)),
                     [nth(p, 1), nth(p, 2), nth(p, 3), nth(p, 4), 0]) in
    lir_loadargs(args,
      [nth(p, 0) + 1, nth(r, 0), nth(r, 2), nth(r, 3), nth(p, 4)],
      cons(nth(r, 1), slots_rev))

let st_self(st5, self) =
  [nth(st5, 0), nth(st5, 1), nth(st5, 2), nth(st5, 3), nth(st5, 4), self]
let st_no(st5) = st_self(st5, "F")
let pack_i(st, i) = [st, i]

/* Tagged immediate for a raw-literal ANF atom, or -1 when the atom is not
 * one. Tagged ints are always even, so -1 is a safe "not a literal" marker. */
let lit_imm(atom) =
  let k = nth(atom, 0) in
  if k == "int" then str_to_int(nth(atom, 1)) + str_to_int(nth(atom, 1))
  else if k == "bool" then (if nth(atom, 1) == "true" then 1 + 1 else 0)
  else if k == "nil" then 1
  else if k == "unit" then 0
  else 0 - 1

/* "Am I compiling a top-level item?" -- the explicit fact lir_let needs to
 * decide gset (the KNOWN GAP in its is_tv comment). Set to 1 by pass_lir
 * before lir_all; lir_letfun_prep clears it on entering a function body and
 * lir_letfun_finish restores the saved value, so nesting is safe. Boxes are
 * the established idiom here (imap_box, pkg_prefix, emit_self). */
let lir_tlv_box = let b = box_new() in let _ = box_set(b, 1) in b
let lir_tlv_set(v) = box_set(lir_tlv_box, v)

let lir_let(b, s) =
  let nm = nth(b, 1) in
  let r = lir_atom(nth(b, 2), s) in
  let i0 = nth(r, 0) in
  /* Give a top-level value its static home (FLAT_ABI.md 2.2). A literal is
   * handed over as an immediate so emit BAKES it into the cell's data at
   * link time -- zero runtime action. Anything else is written at run time,
   * in source order, before any call. Either way a nested function can then
   * read it with `gval` and capture nothing. */
  /* Partial structural test for "this bind IS the unit's own top-level value"
   * (FLAT_ABI.md 1 准则 5). A top-level value never enters Γ (see below), so a
   * name already VISIBLE in Γ is an enclosing lambda's local that merely
   * shares the name -- treating it as top-level would emit a spurious `gset`
   * (plus a publish call) inside a function body and clobber live registers.
   *
   * KNOWN GAP: this only catches the shadowed case. For the FIRST bind of a
   * colliding name inside a function the name is not yet in Γ, so it is still
   * misread as top-level -- Γ cannot tell "binds of a top-level item" from
   * "first local bind of the same name". Closing it needs the "am I compiling
   * a top-level item" fact threaded in explicitly (see lir_all vs branch_st). */
  let is_tv =
    sigma_kind(nth(s, 3), nm) == 2 and env_rec_h(nth(s, 1), nm, hash_str(nm)) == 0
    and box_get(lir_tlv_box) != 0 in
  let i1 =
    if is_tv then
      /* The cell is keyed by the name a READER will use, i.e. the same
       * resolve_call(nm) `lir_var` resolves a `gval` with. In a package file
       * that is the package-qualified name: emitting the bare ANF name here
       * would fill one cell while every read looked at another (still zero). */
      let rn = resolve_call(nm) in
      let li = lit_imm(nth(b, 2)) in
      if li >= 0 then insn_push(i0, ["gset", rn, 0, ["imm", li]])
      else insn_push(i0, ["gset", rn, 0, nth(r, 1)])
    else i0 in
  /* A top-level value has its static cell and is read with `gval`
   * (FLAT_ABI.md 1). It must NOT enter Γ: capture analysis would then see it
   * as a true local, ncap would become > 0 and the function would lose flat --
   * exactly the failure FLAT_ABI.md 1 "没有 1 会怎样" describes. */
  /* capRef (LIR.md 4.4.7): an atom result may be an OPERAND (["cap", i] /
   * ["self"]) rather than a bare slot. Gamma stays INT-ONLY -- materialize
   * such an operand into a fresh slot with a mov, or every consumer that
   * does slot arithmetic on Gamma values (env_slot, slot_off) explodes. */
  let opnd = nth(r, 1) in
  let i2 = if is_tv or is_int(opnd) then i1
           else insn_push(i1, ["mov", nth(r, 3), opnd]) in
  let e1 =
    if is_tv then nth(r, 2)
    else if is_int(opnd) then env_bind(nth(r, 2), nm, opnd, 0)
    else env_bind(nth(r, 2), nm, nth(r, 3), 0) in
  let nxt = if is_tv or is_int(opnd) then nth(r, 3) else nth(r, 3) + 1 in
  [i2, e1, nxt, nth(r, 4), nth(r, 5), nth(s, 5)]

let lir_letbin(b, s) =
  let ra = lir_atom(nth(b, 3), s) in
  let rb = lir_atom(nth(b, 4), [nth(ra, 0), nth(ra, 2), nth(ra, 3),
                                nth(ra, 4), nth(ra, 5)]) in
  let dst = nth(rb, 3) in
  let ins =
    if is_cmp(nth(b, 2)) then ["cmp", nth(b, 2), dst, nth(ra, 1), nth(rb, 1)]
    else bin(nth(b, 2), dst, nth(ra, 1), nth(rb, 1)) in
  [insn_push(nth(rb, 0), ins),
   env_bind(nth(rb, 2), nth(b, 1), dst, 0), dst + 1,
   nth(rb, 4), nth(rb, 5), nth(s, 5)]

let lir_letthrow(b, s) =
  let rk = lir_atom(nth(b, 2), s) in
  let rv = lir_atom(nth(b, 3), [nth(rk, 0), nth(rk, 2), nth(rk, 3),
                                nth(rk, 4), nth(rk, 5)]) in
  let dst = nth(rv, 3) in
  [insn_push(nth(rv, 0), ["throwk", nth(rk, 1), nth(rv, 1)]),
   env_bind(nth(rv, 2), nth(b, 1), dst, 0), dst + 1,
   nth(rv, 4), nth(rv, 5), nth(s, 5)]

let lir_letcallcc_prep(b, s) =
  let fr = lir_atom(nth(b, 3), s) in
  [nth(b, 4), fr, nth(fr, 3), nth(b, 1), nth(b, 2)]

let cc_put(buf, step, p) =
  if step == 0 then
    cc_put(insn_push(buf, ["mkcont", nth(p, 0), nth(p, 5)]), 1, p)
  else if step == 1 then
    cc_put(insn_push(buf, ["icall", nth(p, 1), nth(p, 2), [nth(p, 0)]]), 2, p)
  else if step == 2 then
    cc_put(insn_extend(buf, nth(nth(p, 3), 0)), 3, p)
  else if step == 3 then
    cc_put(insn_push(buf, ["mov", nth(p, 4), nth(nth(p, 3), 1)]), 4, p)
  else if step == 4 then
    cc_put(insn_push(buf, ["jmp", nth(p, 6)]), 5, p)
  else if step == 5 then
    cc_put(insn_push(buf, ["label", nth(p, 5)]), 6, p)
  else if step == 6 then
    cc_put(insn_push(buf, ["cc_recv", nth(p, 4)]), 7, p)
  else insn_push(buf, ["label", nth(p, 6)])

let lir_letcallcc_finish(s, p, br, rslot) =
  let fr = nth(p, 1) in
  let cslot = nth(p, 2) in
  let kslot = cslot + 1 in
  let uid = nth(br, 5) in
  let tag = intern(str_cat(nth(s, 5), str_cat("_LCC", int_to_str(cslot + uid)))) in
  let Lth = intern(str_cat(tag, "t")) in
  let Ljn = intern(str_cat(tag, "j")) in
  let buf = cc_put(list_new(), 0,
             [cslot, kslot, nth(fr, 1), br, rslot, Lth, Ljn]) in
  let next =
    if nth(br, 3) > rslot + 1 then nth(br, 3) else rslot + 1 in
  [insn_extend(nth(fr, 0), buf),
   env_bind(nth(br, 2), nth(p, 4), rslot, 0),
   next, nth(br, 4), uid + 2, nth(s, 5)]

let ccall_cname(b) =
  let fn = nth(b, 2) in
  if nth(fn, 0) != intern("var") then ""
  else if nth(fn, 1) != intern("ccall") then ""
  else if len(nth(b, 3)) == 0 then ""
  else if nth(nth(nth(b, 3), 0), 0) != intern("str") then ""
  else nth(nth(nth(b, 3), 0), 1)

let ccall_is(b) =
  let fn = nth(b, 2) in
  if nth(fn, 0) != intern("var") then false
  else if nth(fn, 1) != intern("ccall") then false
  else if len(nth(b, 3)) == 0 then false
  else true

let lir_letccall(b, pack) =
  let s = nth(pack, 0) in
  let lr = lir_loadargs(nth(b, 3),
            [1, nth(s, 0), nth(s, 1), nth(s, 2), nth(s, 3)], []) in
  let dst = nth(lr, 3) in
  [insn_push(nth(lr, 0), ["ccall", dst, ccall_cname(b), nth(lr, 1)]),
   env_bind(nth(lr, 2), nth(b, 1), dst, 0), dst + 1,
   nth(s, 3), nth(s, 4), nth(s, 5)]

let lir_leticcall(b, pack) =
  let s = nth(pack, 0) in
  let lr = lir_loadargs(nth(b, 3),
            [0, nth(s, 0), nth(s, 1), nth(s, 2), nth(s, 3)], []) in
  let dst = nth(lr, 3) in
  let ss = nth(lr, 1) in
  [insn_push(nth(lr, 0), ["iccall", dst, nth(ss, 0), drop(ss, 1)]),
   env_bind(nth(lr, 2), nth(b, 1), dst, 0), dst + 1,
   nth(s, 3), nth(s, 4), nth(s, 5)]

let lir_letcall(b, pack) =
  if ccall_cname(b) != "" then lir_letccall(b, pack)
  else if ccall_is(b) then lir_leticcall(b, pack)
  else
    let s = nth(pack, 0) in
    let lr = lir_loadargs(nth(b, 3),
              [0, nth(s, 0), nth(s, 1), nth(s, 2), nth(s, 3)], []) in
    let dst = nth(lr, 3) in
    let fn = nth(b, 2) in
    let g0 =
      if nth(fn, 0) == "qvar" then
        let k = qvar_key(nth(fn, 1), nth(fn, 2)) in
        if k == 0 then nth(fn, 1) else k
      else nth(fn, 1) in
    let tail = rest_is_tail(nth(s, 5),
                 [nth(pack, 1), nth(pack, 2), nth(pack, 3), nth(b, 1)]) in
    let ins = maybe_tcall(tail,
      calli(g0, dst, nth(lr, 1), nth(s, 1), nth(s, 3), nth(s, 5), tail),
      nth(s, 5)) in
    [insn_push(nth(lr, 0), ins),
     env_bind(nth(lr, 2), nth(b, 1), dst, 0), dst + 1,
     nth(s, 3), nth(s, 4), nth(s, 5)]

/* capRef ABI (LIR.md 4.4.4): captures no longer occupy frame slots. Gamma
 * binds fv j to the NEGATIVE marker -(j+1); lir_var turns that into the
 * ["cap", j] operand and outer_caps chains it through the object. env_slot
 * has exactly one other consumer (outer_caps), both capRef-aware. */
let bind_caps(fvs, ncap, env, j, e) =
  if j >= ncap then e
  else bind_caps(fvs, ncap, env, j + 1,
        env_bind(e, nth(fvs, j), 0 - (j + 1), env_ncap(env, nth(fvs, j))))

/* capRef (LIR.md 4.4.4): caps no longer precede params in the frame, so
 * param j lives in slot j+1 -- matching the prologue's spill of the incoming
 * arg registers. The ncap argument is kept for call-site compatibility. */
let bind_params(ps, nparams, ncap, j, e) =
  if j >= nparams then e
  else bind_params(ps, nparams, ncap, j + 1,
        env_bind(e, nth(ps, j), j + 1, 0))

let lir_letfun_prep(b, s) =
  let env = nth(s, 1) in
  let name = nth(b, 1) in
  let params = nth(b, 2) in
  let body = nth(b, 3) in
  let nparams = len(params) in
  let uid = nth(s, 4) in
  let pfx = pkg_prefix_get(0) in
  let base =
    if pfx == "" then name
    else if pkg_is_rt(pfx) then name
    else pkg_qn(pfx, name) in
  let gname0 =
    if sigma_has(nth(s, 3), base) then
      str_cat(base, str_cat("#", int_to_str(uid)))
    else base in
  let gname = intern(gname0) in
  let fvs_raw = free_vars(body, params, nth(s, 3), env) in
  let is_rec = in_list(name, fvs_raw) in
  let fvs = if is_rec then fv_skip(fvs_raw, name) else fvs_raw in
  let ncap = len(fvs) in
  /* capRef (LIR.md 4.4.4): no capture slots, no self-closure slot. A value
   * reference to a recursive proc resolves to ["self"] via the sentinel;
   * the proc's second field is nparams (params only, object comes first). */
  let p_env0 = bind_params(params, nparams, ncap, 0,
                 bind_caps(fvs, ncap, env, 0, env_new(0))) in
  let p_env =
    /* The Gamma entry keeps the REAL ncap: calli (lir.yac "calli") uses it
     * to pick ycall (flat self, object ignored) vs apply-through-["self"]
     * (caps read from r13). Losing it sent cap-bearing self-calls down the
     * flat ycall path with no object in the 0th arg register. */
    if is_rec then env_bind(p_env0, name, 0 - 1000000, ncap) else p_env0 in
  let stub = ["proc", gname, nparams, ncap, list_new(), name] in
  let fs1 = sigma_cons(nth(s, 3), stub) in
  let st5 = [list_new(), p_env, nparams + 1, fs1, uid + 1] in
  /* Is this letfun one of the unit's top-level names? Answered by the set
   * carried in Σ (toplevel_seed), never by name shape. Recorded as field 9
   * so lir_letfun_finish reaches the SAME answer the reference sites use. */
  let is_top = sigma_kind(nth(s, 3), name) == 1 in
  let _ = if ncap > 0 then print(["dbg_nf", name, ncap, fvs]) else 0 in
  let saved_tlv = box_get(lir_tlv_box) in
  let _ = box_set(lir_tlv_box, 0) in
  [body, st5, name, ncap, nparams, gname, fvs, false, 0, is_top, saved_tlv != 0]

let cap_list(n, j, acc) =
  if j >= n then acc
  else
    let _ = list_push(acc, j + 1) in
    cap_list(n, j + 1, acc)

/* capRef: a captured value lives either in an outer frame slot (bare int)
 * or in the outer proc's own object (negative marker -> ["cap", k]); the
 * closure insn accepts both operand shapes (LIR.md 4.4.2). */
let outer_caps(env, fvs, ncap, j, acc) =
  if j >= ncap then acc
  else
    let sl = env_slot(env, nth(fvs, j)) in
    let _ = list_push(acc,
      if sl < 0 then ["cap", 0 - sl - 1] else sl) in
    outer_caps(env, fvs, ncap, j + 1, acc)

/* Skip profiler helpers only. Runtime yac_* never pass letfun_finish. */
let is_prof_name(nm) =
  let n = str_len(nm) in
  if n < 5 then false
  else if str_ref(nm, 0) != 112 then false
  else if str_ref(nm, 1) != 114 then false
  else if str_ref(nm, 2) != 111 then false
  else if str_ref(nm, 3) != 102 then false
  else str_ref(nm, 4) == 95

let is_yac_prof_name(nm) =
  let n = str_len(nm) in
  if n < 8 then false
  else if str_ref(nm, 0) != 121 then false
  else if str_ref(nm, 1) != 97 then false
  else if str_ref(nm, 2) != 99 then false
  else if str_ref(nm, 3) != 95 then false
  else if str_ref(nm, 4) != 112 then false
  else if str_ref(nm, 5) != 114 then false
  else if str_ref(nm, 6) != 111 then false
  else str_ref(nm, 7) == 102

let prof_skip(nm) =
  if nm == "_start" then true
  else if is_prof_name(nm) then true
  else is_yac_prof_name(nm)

let prof_is_tco(k) =
  if k == "tcall" then true
  else if k == "ticall" then true
  else if k == "tailapply" then true
  else false

/* maybe_tcall rewrites tail self-calls before wrap. Insert leave in front of
 * those jumps or nstk leaks until dump (incl_ns becomes remaining wall time). */
let prof_copy_tco(src, i, n, dst, ptmp) =
  if i >= n then dst
  else
    let ins = nth(src, i) in
    let _ =
      if prof_is_tco(nth(ins, 0)) then
        list_push(dst, ["fcall", ptmp, "yac_prof_leave", []])
      else 0 in
    let _ = list_push(dst, ins) in
    prof_copy_tco(src, i + 1, n, dst, ptmp)

let prof_wrap_insns(name, head, body, retslot, nslots) =
  if prof_skip(name) then
    insn_push(insn_extend(head, body), ["ret", retslot])
  else
    let pnm = nslots - 2 in
    let ptmp = nslots - 1 in
    let a = insn_push(head, ["strlit", pnm, name]) in
    let b = insn_push(a, ["fcall", ptmp, "yac_prof_enter", [pnm]]) in
    let c = prof_copy_tco(body, 0, len(body), b, ptmp) in
    let d = insn_push(c, ["fcall", ptmp, "yac_prof_leave", []]) in
    insn_push(d, ["ret", retslot])

let lir_letfun_finish(s, p, br) =
  let ncap = nth(p, 3) in
  let nparams = nth(p, 4) in
  let gname = nth(p, 5) in
  let _ = box_set(lir_tlv_box, if nth(p, 10) then 1 else 0) in
  let nslots = nth(br, 3) + 2 in
  /* capRef prologue (LIR.md 4.4.4): params only, object in the 0th arg
   * register. The trailing 1 marks the OBJECT ABI explicitly -- the emit
   * must not infer it from the insn kind (runtime $procs and _start share
   * the "local" spelling with different conventions). */
  let f_insns0 = insn_push(list_new(), ["local", nslots, nparams, 1]) in
  let f_insns2 = insn_push(f_insns0, ["label", "$tco"]) in
  let f_insns = prof_wrap_insns(nth(p, 2), f_insns2, nth(br, 0), nth(br, 1), nslots) in
  let f = ["proc", gname, nparams, ncap, f_insns, nth(p, 2)] in
  /* Flat ABI (FLAT_ABI.md 1): flat <=> captures nothing. Because free_vars no
   * longer counts a top-level name (function or value) as a capture, a
   * top-level letfun necessarily has ncap == 0 -- and the reference sites
   * (lir_var) decide by the same set, so the two can no longer disagree. */
  let flat = nth(p, 9) and nth(p, 3) == 0 in
  let finish_insns =
    if flat then nth(s, 0)
    else
      insn_push(nth(s, 0),
        ["closure", nth(s, 2), gname, outer_caps(nth(s, 1), nth(p, 6), ncap, 0, list_new())]) in
  let bind_env =
    if flat then nth(s, 1)
    else env_bind(nth(s, 1), nth(p, 2), nth(s, 2), ncap) in
  [finish_insns,
   bind_env,
   nth(s, 2) + 1, sigma_cons(nth(br, 4), f), nth(br, 5), nth(s, 5)]

let lir_letif_prep(b, s) =
  let cr = lir_atom(nth(b, 2), s) in
  [nth(b, 3), nth(b, 4), cr, nth(cr, 3), nth(cr, 3) + 1, nth(b, 1)]

let if_put(b, step, p) =
  if step == 0 then
    if_put(insn_push(b, ["cmpjmp", nth(nth(p, 0), 1), nth(p, 4), nth(p, 5)]), 1, p)
  else if step == 1 then
    if_put(insn_push(b, ["label", nth(p, 4)]), 2, p)
  else if step == 2 then
    if_put(insn_extend(b, nth(nth(p, 2), 0)), 3, p)
  else if step == 3 then
    if_put(insn_push(b, ["mov", nth(p, 1), nth(nth(p, 2), 1)]), 4, p)
  else if step == 4 then
    if_put(insn_push(b, ["jmp", nth(p, 6)]), 5, p)
  else if step == 5 then
    if_put(insn_push(b, ["label", nth(p, 5)]), 6, p)
  else if step == 6 then
    if_put(insn_extend(b, nth(nth(p, 3), 0)), 7, p)
  else if step == 7 then
    if_put(insn_push(b, ["mov", nth(p, 1), nth(nth(p, 3), 1)]), 8, p)
  else if step == 8 then
    insn_push(b, ["label", nth(p, 6)])
  else b

let lir_letif_finish(s, p, thenr, elser) =
  let cr = nth(p, 2) in
  let dst = nth(p, 3) in
  let L = nth(elser, 5) in
  let L0 = str_cat("LIF", int_to_str(L)) in
  let L1 = str_cat("LIF", int_to_str(L + 1)) in
  let L2 = str_cat("LIF", int_to_str(L + 2)) in
  let nextctr =
    if nth(thenr, 3) > nth(elser, 3) then nth(thenr, 3) else nth(elser, 3) in
  let buf = if_put(list_new(), 0, [cr, dst, thenr, elser, L0, L1, L2]) in
  [insn_extend(nth(cr, 0), buf),
   env_bind(nth(elser, 2), nth(p, 5), dst, 0), nextctr,
   nth(elser, 4), L + 3, nth(s, 5)]

let branch_st(s, cr, ctr1, funs, uid, info) =
  let flag = if rest_is_tail(nth(s, 5), info) then nth(s, 5) else "F" in
  [list_new(), env_enter(nth(cr, 2)), ctr1, funs, uid, flag]

let lir_expr_i(ast, pack) =
  let st = nth(pack, 0) in
  let i = nth(pack, 1) in
  let binds = nth(ast, 0) in
  let tail = nth(ast, 1) in
  let nb = len(binds) in
  if i >= nb then
    let tr = lir_atom(tail, st) in
    [nth(tr, 0), nth(tr, 1), nth(tr, 2), nth(tr, 3), nth(tr, 4), nth(tr, 5)]
  else
    let b = nth(binds, i) in
    let k = nth(b, 0) in
    if k == "let" then
      lir_expr_i(ast, pack_i(lir_let(b, st), i + 1))
    else if k == "letbin" then
      lir_expr_i(ast, pack_i(lir_letbin(b, st), i + 1))
    else if k == "letcall" then
      lir_expr_i(ast, pack_i(lir_letcall(b, [st, i, nb, tail]), i + 1))
    else if k == "letfun" then
      let p = lir_letfun_prep(b, st) in
      let br = lir_expr_i(nth(p, 0), pack_i(st_self(nth(p, 1), nth(p, 5)), 0)) in
      lir_expr_i(ast, pack_i(lir_letfun_finish(st, p, br), i + 1))
    else if k == "letif" then
      let p = lir_letif_prep(b, st) in
      let cr = nth(p, 2) in
      let info = [i, nb, tail, nth(b, 1)] in
      let thenr = lir_expr_i(nth(p, 0),
        pack_i(branch_st(st, cr, nth(p, 4), nth(cr, 4), nth(cr, 5), info), 0)) in
      let elser = lir_expr_i(nth(p, 1),
        pack_i(branch_st(st, cr, nth(p, 4), nth(thenr, 4), nth(thenr, 5), info), 0)) in
      lir_expr_i(ast, pack_i(lir_letif_finish(st, p, thenr, elser), i + 1))
    else if k == "letthrow" then
      lir_expr_i(ast, pack_i(lir_letthrow(b, st), i + 1))
    else if k == "letcallcc" then
      let p = lir_letcallcc_prep(b, st) in
      let fr = nth(p, 1) in
      let cslot = nth(p, 2) in
      let kslot = cslot + 1 in
      let rslot = cslot + 2 in
      let envk = env_bind(nth(fr, 2), nth(p, 3), kslot, 0) in
      let br = lir_expr_i(nth(p, 0),
        pack_i([list_new(), envk, rslot + 1, nth(fr, 4), nth(fr, 5), nth(st, 5)], 0)) in
      lir_expr_i(ast, pack_i(lir_letcallcc_finish(st, p, br, rslot), i + 1))
    else
      let _ = log_fatal(str_cat("LIR: unknown ANF bind '", str_cat(k, "'"))) in
      lir_expr_i(ast, pack_i(st, i + 1))

/* ast = ANF body [binds, atom]. st = [insns, Γ, ctr, Σ, uid, self]. */
let lir_expr(ast, st) = lir_expr_i(ast, pack_i(st, 0))

/* st = [env, ctr, Σ, uid, insns, slot] */
let lir_all(i, items, st, n) =
  if i >= n then st
  else
    let r = lir_expr(nth(items, i),
              st_no([nth(st, 4), nth(st, 0), nth(st, 1), nth(st, 2), nth(st, 3)])) in
    lir_all(i + 1, items,
      [nth(r, 2), nth(r, 3), nth(r, 4), nth(r, 5), nth(r, 0), nth(r, 1)], n)

let start_proc(nslots, result_slot, body) =
  /* Entry prologue FIRST: `local` reads argc/argv, builds the frame and
   * installs rbp + the GC stack bound, so it must precede any publish.
   * Top-level function entries need no runtime publication at all -- `gvar`
   * bakes each cell's entry at link time (patch tag 23), and a blob reaches
   * the host's cell through a patch slot. */
  let head = insn_push(list_new(), ["local", nslots, 0]) in
  ["proc", "_start", 0, 0, insn_push(
      insn_push(
        insn_extend(head, body),
        ["untag", nslots, result_slot]),
      ["syscall", 0, 60, [nslots]]), "_start"]
