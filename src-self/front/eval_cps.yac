/* eval_cps.yac — trampoline over CPS lists (name env, mutable frames).
 * Runtime tags: cfun / ccont / cprim. Continuations write into the captured frame.
 * HO prims (map/filter/fold) use a nested trampoline; they must not re-enter ce_run.
 */

package front
export eval_cps_all
import lib.map

let ce_eb =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let ce_fail(msg) =
  let _ = if box_get(ce_eb) == 0 then box_set(ce_eb, msg) else 0 in
  0

let ce_bad(_) = box_get(ce_eb) != 0

let ce_frame(parent) = [fmap_new64(0), parent]

let ce_bind(env, name, v) = fmap_put(nth(env, 0), name, ["v", v])

/* New name: bind in this frame (letrec: closures see later bindings).
 * Shadowing: new frame so captured envs keep the old value. */
let ce_let_env(env, name, v) =
  let e = fmap_get(nth(env, 0), name) in
  if e == 0 then
    let _ = ce_bind(env, name, v) in env
  else
    let nf = ce_frame(env) in
    let _ = ce_bind(nf, name, v) in
    nf

let ce_find(env, name) =
  if env == 0 then 0
  else
    let e = fmap_get(nth(env, 0), name) in
    if e == 0 then ce_find(nth(env, 1), name)
    else e

let ce_bind_params(env, ps, args, i, n) =
  if i >= n then 0
  else
    let _ = ce_bind(env, nth(ps, i), nth(args, i)) in
    ce_bind_params(env, ps, args, i + 1, n)

let ce_tag(v) =
  if is_int(v) then "int"
  else if v == [] then "nil"
  else if v == true then "bool"
  else if v == false then "bool"
  else nth(v, 0)

let ce_apply_cont(k, v) =
  if ce_bad(0) then [0, 0]
  else if ce_tag(k) != "ccont" then
    let _ = ce_fail("expected a continuation") in [0, 0]
  else
    let env = nth(k, 3) in
    let _ = ce_bind(env, nth(k, 1), v) in
    [nth(k, 2), env]

let ce_eq(a, b) =
  let rec(i, n) =
    if i >= n then true
    else if ce_eq(nth(a, i), nth(b, i)) then rec(i + 1, n)
    else false in
  if a == b then true
  else if is_int(a) then false
  else if is_int(b) then false
  else if a == [] then b == []
  else if b == [] then false
  else
    let ta = nth(a, 0) in
    if ta == "cfun" then false
    else if ta == "ccont" then false
    else if ta == "cprim" then false
    else
      let n = len(a) in
      if n != len(b) then false
      else rec(0, n)

let ce_prim_bin(op, a, b) =
  if op == "+" then a + b
  else if op == "-" then a - b
  else if op == "*" then a * b
  else if op == "/" then a / b
  else if op == "%" then a % b
  else if op == "==" then ce_eq(a, b)
  else if op == "!=" then not ce_eq(a, b)
  else if op == "<" then a < b
  else if op == ">" then a > b
  else if op == "<=" then a <= b
  else if op == ">=" then a >= b
  else if op == "and" then a and b
  else if op == "or" then a or b
  else ce_fail(str_cat("CPS eval: primitive '", str_cat(op, "' not supported")))

let ce_prim_one(op, args) =
  let a0 = nth(args, 0) in
  if op == "not" then not a0
  else if op == "print" then
    let _ = print(a0) in 0
  else if op == "len" then len(a0)
  else if op == "tail" then tail(a0)
  else if op == "list_rev" then list_rev(a0)
  else if op == "list_new" then list_new()
  else if op == "int_to_str" then int_to_str(a0)
  else if op == "is_int" then is_int(a0)
  else if op == "str_len" then str_len(a0)
  else if op == "str_hash" then str_hash(a0)
  else if op == "ident_hash" then ident_hash(a0)
  else if op == "str_chr" then str_chr(a0)
  else if op == "bnot" then bnot(a0)
  else if op == "bytes_new" then bytes_new()
  else if op == "bytes_len" then bytes_len(a0)
  else if op == "bytes_to_str" then bytes_to_str(a0)
  else if op == "box_new" then box_new()
  else if op == "box_get" then box_get(a0)
  else if op == "argc" then argc()
  else if op == "read_file" then read_file(a0)
  else if op == "read_line" then read_line()
  else if op == "argv" then argv(a0)
  else if op == "system" then system(a0)
  else if op == "time_ms" then time_ms()
  else if op == "time_ns" then time_ns()
  else if op == "time_str" then time_str()
  else if op == "gc_collect" then gc_collect()
  else ce_fail(str_cat("CPS eval: primitive '", str_cat(op, "' not supported")))

let ce_prim_two(op, args) =
  let a0 = nth(args, 0) in
  let a1 = nth(args, 1) in
  if op == "cons" then cons(a0, a1)
  else if op == "nth" then nth(a0, a1)
  else if op == "drop" then drop(a0, a1)
  else if op == "append" then append(a0, a1)
  else if op == "str_cat" then str_cat(a0, a1)
  else if op == "str_ref" then str_ref(a0, a1)
  else if op == "list_push" then list_push(a0, a1)
  else if op == "box_set" then box_set(a0, a1)
  else if op == "bytes_append" then bytes_append(a0, a1)
  else if op == "bytes_extend" then bytes_extend(a0, a1)
  else if op == "bytes_ref" then bytes_ref(a0, a1)
  else if op == "band" then band(a0, a1)
  else if op == "bor" then bor(a0, a1)
  else if op == "bxor" then bxor(a0, a1)
  else if op == "bshl" then bshl(a0, a1)
  else if op == "bshr" then bshr(a0, a1)
  else if op == "iadd" then iadd(a0, a1)
  else if op == "isub" then isub(a0, a1)
  else if op == "imul" then imul(a0, a1)
  else if op == "idiv" then idiv(a0, a1)
  else if op == "irem" then irem(a0, a1)
  else if op == "write_file" then write_file(a0, a1)
  else ce_prim_bin(op, a0, a1)

let ce_prim_print(args, m) =
  if m == 1 then
    let _ = print(nth(args, 0)) in 0
  else if nth(args, 1) then
    let _ = print(nth(args, 0)) in 0
  else
    let _ = print(nth(args, 0), false) in 0

let ce_prim_plain(op, args) =
  let n = len(args) in
  let m = n - 1 in
  if op == "print" then ce_prim_print(args, m)
  else if m == 1 then ce_prim_one(op, args)
  else if m == 2 then ce_prim_two(op, args)
  else if m == 3 then
    if op == "list_set" then list_set(nth(args, 0), nth(args, 1), nth(args, 2))
    else if op == "str_slice" then str_slice(nth(args, 0), nth(args, 1), nth(args, 2))
    else if op == "bytes_put" then bytes_put(nth(args, 0), nth(args, 1), nth(args, 2))
    else if op == "mem_ref" then
      ce_fail("CPS eval: primitive 'mem_ref' not supported")
    else ce_fail(str_cat("CPS eval: primitive '", str_cat(op, "' not supported")))
  else if m == 4 then
    if op == "mem_put" then ce_fail("CPS eval: primitive 'mem_put' not supported")
    else ce_fail(str_cat("CPS eval: primitive '", str_cat(op, "' not supported")))
  else ce_fail(str_cat("CPS eval: primitive '", str_cat(op, "' not supported")))

let ce_atom(a, env) =
  if ce_bad(0) then 0
  else
    let k = nth(a, 0) in
    if k == "int" then cps_atoi(nth(a, 1))
    else if k == "bool" then nth(a, 1) == "true"
    else if k == "str" then nth(a, 1)
    else if k == "unit" then 0
    else if k == "nil" then []
    else if k == "prim" then ["cprim", nth(a, 1)]
    else if k == "fun" then ["cfun", nth(a, 1), nth(a, 2), env]
    else if k == "cont" then ["ccont", nth(a, 1), nth(a, 2), env]
    else if k == "var" then
      let name = nth(a, 1) in
      let e = ce_find(env, name) in
      if e != 0 then nth(e, 1)
      else ["cprim", name]
    else ce_fail("CPS eval: bad atom")

let ce_atoms(xs, env, i, n, acc) =
  if ce_bad(0) then acc
  else if i >= n then list_rev(acc)
  else ce_atoms(xs, env, i + 1, n, cons(ce_atom(nth(xs, i), env), acc))

let ce_jump_call(C, env) =
  let hd = ce_atom(nth(C, 1), env) in
  let args = ce_atoms(nth(C, 2), env, 0, len(nth(C, 2)), []) in
  if ce_bad(0) then [0, 0]
  else
    let tk = ce_tag(hd) in
    if tk == "cfun" then
      let ps = nth(hd, 1) in
      let n = len(ps) in
      if n != len(args) then
        let _ = ce_fail("function arity mismatch") in [0, 0]
      else
        let nf = ce_frame(nth(hd, 3)) in
        let _ = ce_bind_params(nf, ps, args, 0, n) in
        [nth(hd, 2), nf]
    else if tk == "ccont" then
      if len(args) != 1 then
        let _ = ce_fail("continuation applied to the wrong arity") in [0, 0]
      else ce_apply_cont(hd, nth(args, 0))
    else if tk == "cprim" then
      let k = nth(args, len(args) - 1) in
      ce_apply_cont(k, ce_prim_plain(nth(hd, 1), args))
    else
      let _ = ce_fail("cannot apply a non-function value") in [0, 0]

let ce_call_value(hd, args) =
  if ce_tag(hd) != "cfun" then ce_fail("cannot apply a non-function value")
  else
    let ps = nth(hd, 1) in
    let np = len(ps) in
    if np != len(args) + 1 then ce_fail("function arity mismatch")
    else
      let kf = ce_frame(0) in
      let rn = intern("#r") in
      let k = ["ccont", rn, ["halt", ["var", rn]], kf] in
      let nf = ce_frame(nth(hd, 3)) in
      let _ = ce_bind_params(nf, ps, append(args, [k]), 0, np) in
      let rec(code, env) =
        if ce_bad(0) then ["err", box_get(ce_eb)]
        else
          let ck = nth(code, 0) in
          if ck == "halt" then ["ok", ce_atom(nth(code, 1), env)]
          else if ck == "let" then
            let v = ce_atom(nth(code, 2), env) in
            if ce_bad(0) then ["err", box_get(ce_eb)]
            else rec(nth(code, 3), ce_let_env(env, nth(code, 1), v))
          else if ck == "if" then
            let cnd = ce_atom(nth(code, 1), env) in
            if ce_bad(0) then ["err", box_get(ce_eb)]
            else if cnd then rec(nth(code, 2), env)
            else rec(nth(code, 3), env)
          else if ck == "throw" then
            let kexp = nth(code, 1) in
            if nth(kexp, 0) == "halt" then ["ok", ce_atom(nth(code, 2), env)]
            else
              let k2 = ce_atom(kexp, env) in
              let v2 = ce_atom(nth(code, 2), env) in
              if ce_bad(0) then ["err", box_get(ce_eb)]
              else
                let j = ce_apply_cont(k2, v2) in
                rec(nth(j, 0), nth(j, 1))
          else if ck == "call" then
            let j = ce_jump_call(code, env) in
            if ce_bad(0) then ["err", box_get(ce_eb)]
            else rec(nth(j, 0), nth(j, 1))
          else ["err", "CPS eval: bad CPS node"] in
      let r = rec(nth(hd, 2), nf) in
      if nth(r, 0) == "err" then
        let _ = ce_fail(nth(r, 1)) in 0
      else nth(r, 1)

let ce_map(f, xs, i, acc) =
  if ce_bad(0) then acc
  else if i >= len(xs) then list_rev(acc)
  else ce_map(f, xs, i + 1, cons(ce_call_value(f, [nth(xs, i)]), acc))

let ce_filter(f, xs, i, acc) =
  if ce_bad(0) then acc
  else if i >= len(xs) then list_rev(acc)
  else
    let x = nth(xs, i) in
    if ce_call_value(f, [x]) then ce_filter(f, xs, i + 1, cons(x, acc))
    else ce_filter(f, xs, i + 1, acc)

let ce_foldl(f, z, xs, i) =
  if ce_bad(0) then z
  else if i >= len(xs) then z
  else ce_foldl(f, ce_call_value(f, [z, nth(xs, i)]), xs, i + 1)

let ce_foldr(f, z, xs, i) =
  if ce_bad(0) then z
  else if i >= len(xs) then z
  else
    let rest = ce_foldr(f, z, xs, i + 1) in
    ce_call_value(f, [nth(xs, i), rest])

let ce_prim_apply(op, args) =
  let n = len(args) in
  if n < 1 then
    let _ = ce_fail("primitive call without continuation") in [0, 0]
  else
    let k = nth(args, n - 1) in
    let v =
      if op == "map" then ce_map(nth(args, 0), nth(args, 1), 0, [])
      else if op == "filter" then ce_filter(nth(args, 0), nth(args, 1), 0, [])
      else if op == "foldl" then ce_foldl(nth(args, 0), nth(args, 1), nth(args, 2), 0)
      else if op == "foldr" then ce_foldr(nth(args, 0), nth(args, 1), nth(args, 2), 0)
      else ce_prim_plain(op, args) in
    ce_apply_cont(k, v)

let ce_do_call(C, env) =
  let hd = ce_atom(nth(C, 1), env) in
  let args = ce_atoms(nth(C, 2), env, 0, len(nth(C, 2)), []) in
  if ce_bad(0) then [0, 0]
  else
    let tk = ce_tag(hd) in
    if tk == "cfun" then
      let ps = nth(hd, 1) in
      let n = len(ps) in
      if n != len(args) then
        let _ = ce_fail("function arity mismatch") in [0, 0]
      else
        let nf = ce_frame(nth(hd, 3)) in
        let _ = ce_bind_params(nf, ps, args, 0, n) in
        [nth(hd, 2), nf]
    else if tk == "ccont" then
      if len(args) != 1 then
        let _ = ce_fail("continuation applied to the wrong arity") in [0, 0]
      else ce_apply_cont(hd, nth(args, 0))
    else if tk == "cprim" then ce_prim_apply(nth(hd, 1), args)
    else
      let _ = ce_fail("cannot apply a non-function value") in [0, 0]

let ce_run(code0, env0) =
  let rec(code, env) =
    if ce_bad(0) then ["err", box_get(ce_eb)]
    else
      let ck = nth(code, 0) in
      if ck == "halt" then ["ok", ce_atom(nth(code, 1), env)]
      else if ck == "let" then
        let v = ce_atom(nth(code, 2), env) in
        if ce_bad(0) then ["err", box_get(ce_eb)]
        else rec(nth(code, 3), ce_let_env(env, nth(code, 1), v))
      else if ck == "if" then
        let cnd = ce_atom(nth(code, 1), env) in
        if ce_bad(0) then ["err", box_get(ce_eb)]
        else if cnd then rec(nth(code, 2), env)
        else rec(nth(code, 3), env)
      else if ck == "throw" then
        let kexp = nth(code, 1) in
        if nth(kexp, 0) == "halt" then ["ok", ce_atom(nth(code, 2), env)]
        else
          let k = ce_atom(kexp, env) in
          let v = ce_atom(nth(code, 2), env) in
          if ce_bad(0) then ["err", box_get(ce_eb)]
          else
            let j = ce_apply_cont(k, v) in
            rec(nth(j, 0), nth(j, 1))
      else if ck == "call" then
        let j = ce_do_call(code, env) in
        if ce_bad(0) then ["err", box_get(ce_eb)]
        else rec(nth(j, 0), nth(j, 1))
      else ["err", "CPS eval: bad CPS node"] in
  rec(code0, env0)

let eval_cps_all(xs) =
  let _ = box_set(ce_eb, 0) in
  let env = ce_frame(0) in
  let n = len(xs) in
  let rec(i, last) =
    if ce_bad(0) then ["err", box_get(ce_eb)]
    else if i >= n then ["ok", last]
    else
      let r = ce_run(nth(xs, i), env) in
      if nth(r, 0) == "err" then r
      else rec(i + 1, nth(r, 1)) in
  rec(0, 0)
