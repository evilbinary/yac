/* parser.yac — recursive-descent parser for the self-hosted compiler.
 *
 * Input: token list from lexer.yac (each token = [kind, text, line]).
 * Output: AST as nested Lists.
 *
 * Architecture: yac has no mutual recursion / forward refs across top-level
 * lets, so the parser is ONE self-recursive top-level function `parse_expr`
 * with all auxiliary parsers defined as nested local functions inside it
 * (they may reference parse_expr, which is in scope). Each returns
 * [ast, nextIndex].
 *
 * AST shapes:
 *   ["int", text] ["float", text] ["str", text] ["bool","true"|"false"]
 *   ["unit"] ["var", name]
 *   ["call", fn, [args...]]
 *   ["fun", [params...], body]
 *   ["if", cond, then, else]
 *   ["let", name, bound, body]
 *   ["binop", op, lhs, rhs]   op: + - * / % == != < <= > >= and or
 *   ["not", x] ["callcc", x] ["throw", k, v]
 *   print e / print(e[, nl]) desugars to call print
 *   ["list", [items...]]
 *   ["error", msg, line, near]
 */

let reverse(xs) = list_rev(xs)
let is_err(a) = nth(a, 0) == "error"
/* Nested ["error", ...] (e.g. print without an argument) must not reach ANF. */
let ast_has_err(a) =
  let xs_err(xs, i) =
    if i >= len(xs) then false
    else if ast_has_err(nth(xs, i)) then true
    else xs_err(xs, i + 1) in
  let k = nth(a, 0) in
  if k == "error" then true
  else if k == "call" then
    if ast_has_err(nth(a, 1)) then true else xs_err(nth(a, 2), 0)
  else if k == "fun" then ast_has_err(nth(a, 2))
  else if k == "if" then
    if ast_has_err(nth(a, 1)) then true
    else if ast_has_err(nth(a, 2)) then true
    else ast_has_err(nth(a, 3))
  else if k == "let" then
    if ast_has_err(nth(a, 2)) then true else ast_has_err(nth(a, 3))
  else if k == "binop" then
    if ast_has_err(nth(a, 2)) then true else ast_has_err(nth(a, 3))
  else if k == "not" then ast_has_err(nth(a, 1))
  else if k == "callcc" then ast_has_err(nth(a, 1))
  else if k == "throw" then
    if ast_has_err(nth(a, 1)) then true else ast_has_err(nth(a, 2))
  else if k == "list" then xs_err(nth(a, 1), 0)
  else false

let ast_find_err(a) =
  let xs_err(xs, i) =
    if i >= len(xs) then 0
    else
      let e = ast_find_err(nth(xs, i)) in
      if e == 0 then xs_err(xs, i + 1) else e in
  let k = nth(a, 0) in
  if k == "error" then a
  else if k == "call" then
    let e = ast_find_err(nth(a, 1)) in
    if e == 0 then xs_err(nth(a, 2), 0) else e
  else if k == "fun" then ast_find_err(nth(a, 2))
  else if k == "if" then
    let e = ast_find_err(nth(a, 1)) in
    if e != 0 then e
    else
      let e2 = ast_find_err(nth(a, 2)) in
      if e2 != 0 then e2 else ast_find_err(nth(a, 3))
  else if k == "let" then
    let e = ast_find_err(nth(a, 2)) in
    if e == 0 then ast_find_err(nth(a, 3)) else e
  else if k == "binop" then
    let e = ast_find_err(nth(a, 2)) in
    if e == 0 then ast_find_err(nth(a, 3)) else e
  else if k == "not" then ast_find_err(nth(a, 1))
  else if k == "callcc" then ast_find_err(nth(a, 1))
  else if k == "throw" then
    let e = ast_find_err(nth(a, 1)) in
    if e == 0 then ast_find_err(nth(a, 2)) else e
  else if k == "list" then xs_err(nth(a, 1), 0)
  else 0

let prog_has_err(p, i) =
  if i >= len(p) then false
  else if ast_has_err(nth(p, i)) then true
  else prog_has_err(p, i + 1)

let prog_find_err(p, i) =
  if i >= len(p) then 0
  else
    let e = ast_find_err(nth(p, i)) in
    if e == 0 then prog_find_err(p, i + 1) else e

let tok_line(toks, j) =
  if len(toks) == 0 then 1
  else if j < 0 then 1
  else if j >= len(toks) then nth(nth(toks, len(toks) - 1), 2)
  else nth(nth(toks, j), 2)

let tok_near(toks, j) =
  if j >= len(toks) then "eof"
  else
    let t = nth(nth(toks, j), 1) in
    if t == "" then nth(nth(toks, j), 0) else t

/* Top-level so parse_expr stays ncap=0. AST: ["error", msg, line, near]. */
let parse_err(toks, j) =
  [["error", "syntax", tok_line(toks, j), tok_near(toks, j)], j]

let parse_err_msg(toks, j, msg) =
  [["error", msg, tok_line(toks, j), tok_near(toks, j)], j]

let syntax_msg(e) =
  let line = if len(e) > 2 then nth(e, 2) else 1 in
  let raw = nth(e, 1) in
  let msg =
    if raw == "syntax" then "syntax error"
    else if raw == "parse" then "syntax error"
    else raw in
  let near = if len(e) > 3 then nth(e, 3) else "" in
  let loc = str_cat(int_to_str(line), str_cat(": ", msg)) in
  if near == "" then str_cat("error: syntax: ", loc)
  else str_cat("error: syntax: ", str_cat(loc, str_cat(" (near ", str_cat(near, ")"))))

let report_syntax(ast) =
  let e = prog_find_err(ast, 0) in
  if e == 0 then print("error: syntax")
  else print(syntax_msg(e))

let tok_k(toks, i) =
  if i >= len(toks) then "eof" else nth(nth(toks, i), 0)
let tok_t(toks, i) =
  if i >= len(toks) then "" else nth(nth(toks, i), 1)
let tok_is_kw(toks, i, w) =
  if tok_k(toks, i) == "kw" then tok_t(toks, i) == w else false

let parse_dotted(toks, i, acc) =
  if tok_k(toks, i) != "ident" then ["", i]
  else
    let part = tok_t(toks, i) in
    let acc2 = if acc == "" then part else str_cat(acc, str_cat(".", part)) in
    if tok_k(toks, i + 1) == "dot" then
      if tok_k(toks, i + 2) == "ident" then parse_dotted(toks, i + 2, acc2)
      else [acc2, i + 1]
    else [acc2, i + 1]

let parse_idlist(toks, i, acc) =
  if tok_k(toks, i) != "ident" then [reverse(acc), i]
  else if tok_k(toks, i + 1) == "comma" then
    parse_idlist(toks, i + 2, cons(tok_t(toks, i), acc))
  else [reverse(cons(tok_t(toks, i), acc)), i + 1]

/* One brace spec: name or `name as alias` → [local, orig]. */
let parse_imp1(toks, i) =
  if tok_k(toks, i) != "ident" then 0
  else
    let orig = tok_t(toks, i) in
    if tok_k(toks, i + 1) == "ident" then
      if tok_t(toks, i + 1) == "as" then
        if tok_k(toks, i + 2) != "ident" then 0
        else [[tok_t(toks, i + 2), orig], i + 3]
      else [[orig, orig], i + 1]
    else [[orig, orig], i + 1]

/* Brace import list. */
let parse_implist(toks, i, acc) =
  let one = parse_imp1(toks, i) in
  if one == 0 then [reverse(acc), i]
  else
    let j = nth(one, 1) in
    if tok_k(toks, j) == "comma" then parse_implist(toks, j + 1, cons(nth(one, 0), acc))
    else [reverse(cons(nth(one, 0), acc)), j]

let hdr_semi(toks, j) =
  if tok_k(toks, j) == "semi" then j + 1 else j

let parse_expr(toks, i, min_prec) =
  /* ---- token access ---- */
  let ntoks = len(toks) in
  let tk_at(j) = if j >= ntoks then ["eof", "", 0] else nth(toks, j) in
  let kk(j) = nth(tk_at(j), 0) in
  let tt(j) = nth(tk_at(j), 1) in
  let is_punct(j) =
    let k = kk(j) in
    if k == "lparen" then true
    else if k == "rparen" then true
    else if k == "lbrk" then true
    else if k == "rbrk" then true
    else if k == "lbrace" then true
    else if k == "rbrace" then true
    else if k == "comma" then true
    else if k == "semi" then true
    else if k == "punct" then true
    else false in
  let is_kw(j, t) =
    let tok = tk_at(j) in
    if nth(tok, 0) == "kw" then nth(tok, 1) == t else false in
  let is_op(j, t) =
    let tok = tk_at(j) in
    if nth(tok, 0) == "op" then nth(tok, 1) == t else false in

  /* ---- precedence ---- */
  let prec_of(op) =
    if op == "or" then 1
    else if op == "and" then 2
    else if op == "==" then 3
    else if op == "!=" then 3
    else if op == "<" then 4
    else if op == "<=" then 4
    else if op == ">" then 4
    else if op == ">=" then 4
    else if op == "+" then 5
    else if op == "-" then 5
    else if op == "*" then 6
    else if op == "/" then 6
    else if op == "%" then 6
    else 0 in
  let is_binop_tok(j) =
    let tok = tk_at(j) in
    let k = nth(tok, 0) in
    if k == "op" then prec_of(nth(tok, 1)) > 0
    else if k == "kw" then prec_of(nth(tok, 1)) > 0
    else false in

  /* ---- comma list after '(' / '[' ----
   * [true, items, next] | [false, 0, failIdx] | [false, innerErr, innerIdx] */
  let parse_arglist(j, acc) =
    if kk(j) == "rparen" then [true, reverse(acc), j + 1]
    else
      let r = parse_expr(toks, j, 0) in
      if is_err(nth(r, 0)) then [false, nth(r, 0), nth(r, 1)]
      else if kk(nth(r, 1)) == "comma" then
        parse_arglist(nth(r, 1) + 1, cons(nth(r, 0), acc))
      else if kk(nth(r, 1)) == "rparen" then
        [true, reverse(cons(nth(r, 0), acc)), nth(r, 1) + 1]
      else [false, 0, nth(r, 1)] in
  let close_fail(r, msg) =
    if nth(r, 1) == 0 then parse_err_msg(toks, nth(r, 2), msg)
    else
      let e = nth(r, 1) in
      if is_err(e) then
        if nth(e, 1) == "syntax" then parse_err_msg(toks, nth(r, 2), msg)
        else [e, nth(r, 2)]
      else parse_err_msg(toks, nth(r, 2), msg) in

  /* ---- ( ident, ... ) ; j is first token after '('. ---- */
  let parse_params(j, acc) =
    if kk(j) == "rparen" then [true, reverse(acc), j + 1]
    else if kk(j) == "ident" then
      if kk(j + 1) == "comma" then parse_params(j + 2, cons(tt(j), acc))
      else if kk(j + 1) == "rparen" then [true, reverse(cons(tt(j), acc)), j + 2]
      else [false, acc, j + 1]
    else [false, acc, j] in

  let parse_listitems(j, acc) =
    if kk(j) == "rbrk" then [true, reverse(acc), j + 1]
    else
      let r = parse_expr(toks, j, 0) in
      if is_err(nth(r, 0)) then [false, nth(r, 0), nth(r, 1)]
      else if kk(nth(r, 1)) == "comma" then
        parse_listitems(nth(r, 1) + 1, cons(nth(r, 0), acc))
      else if kk(nth(r, 1)) == "rbrk" then
        [true, reverse(cons(nth(r, 0), acc)), nth(r, 1) + 1]
      else [false, 0, nth(r, 1)] in

  /* ---- primary / atom ---- */
  let parse_primary(j) =
    if kk(j) == "num" then
      let t = tt(j) in
      let rec(i) =
        if i >= str_len(t) then false
        else
          let c = str_ref(t, i) in
          if c == 46 then true
          else if c == 101 then true
          else if c == 69 then true
          else rec(i + 1) in
      if rec(0) then [["float", t], j + 1]
      else [["int", t], j + 1]
    else if kk(j) == "str" then [["str", tt(j)], j + 1]
    else if kk(j) == "ident" then
      if kk(j + 1) == "dot" then
        if kk(j + 2) == "ident" then [["qvar", tt(j), tt(j + 2)], j + 3]
        else [["var", tt(j)], j + 1]
      else [["var", tt(j)], j + 1]
    else if is_kw(j, "true") then [["bool", "true"], j + 1]
    else if is_kw(j, "false") then [["bool", "false"], j + 1]
    else if kk(j) == "lbrk" then
      let r = parse_listitems(j + 1, []) in
      if nth(r, 0) then [["list", nth(r, 1)], nth(r, 2)]
      else close_fail(r, "expected ']' to close list")
    else if is_kw(j, "not") then
      let r = parse_expr(toks, j + 1, 0) in
      if is_err(nth(r, 0)) then r
      else [["not", nth(r, 0)], nth(r, 1)]
    else if is_kw(j, "print") then
      if kk(j + 1) == "lparen" then
        let r = parse_arglist(j + 2, []) in
        if not nth(r, 0) then close_fail(r, "expected ')' after print arguments")
        else
          let args = nth(r, 1) in
          let na = len(args) in
          if na == 1 then
            [["call", ["var", "print"], [nth(args, 0), ["bool", "true"]]], nth(r, 2)]
          else if na == 2 then
            [["call", ["var", "print"], args], nth(r, 2)]
          else parse_err(toks,j)
      else
        let r = parse_expr(toks, j + 1, 0) in
        if is_err(nth(r, 0)) then r
        else [["call", ["var", "print"], [nth(r, 0), ["bool", "true"]]], nth(r, 1)]
    else if is_kw(j, "callcc") then
      let r = parse_expr(toks, j + 1, 0) in
      if is_err(nth(r, 0)) then r
      else [["callcc", nth(r, 0)], nth(r, 1)]
    else if is_kw(j, "throw") then
      /* Two primaries (not juxta-app): `throw exit 999` is two args, not exit(999). */
      let kr = parse_primary(j + 1) in
      if is_err(nth(kr, 0)) then kr
      else
        let vr = parse_primary(nth(kr, 1)) in
        if is_err(nth(vr, 0)) then vr
        else [["throw", nth(kr, 0), nth(vr, 0)], nth(vr, 1)]
    else if is_kw(j, "fun") then
      /* fun ( params ) -> body */
      if kk(j + 1) == "lparen" then
        let pr = parse_params(j + 2, []) in
        if not nth(pr, 0) then parse_err_msg(toks, nth(pr, 2), "expected ')'")
        else
          let after = nth(pr, 2) in
          if is_op(after, "->") then
            let r = parse_expr(toks, after + 1, 0) in
            if is_err(nth(r, 0)) then r
            else [["fun", nth(pr, 1), nth(r, 0)], nth(r, 1)]
          else parse_err_msg(toks, after, "expected '->'")
      else parse_err(toks,j)
    else if kk(j) == "lparen" then
      /* () is unit. f() / let f() = stay lparen+rparen via parse_app / params. */
      if kk(j + 1) == "rparen" then [["unit"], j + 2]
      else if kk(j + 1) == "ident" and kk(j + 2) == "comma" then
        let pr = parse_params(j + 1, []) in
        if not nth(pr, 0) then parse_err_msg(toks, nth(pr, 2), "expected ')'")
        else
          let after = nth(pr, 2) in
          if is_op(after, "->") then
            let r = parse_expr(toks, after + 1, 0) in
            if is_err(nth(r, 0)) then r
            else [["fun", nth(pr, 1), nth(r, 0)], nth(r, 1)]
          else parse_err_msg(toks, after, "expected '->'")
      else
        let r = parse_expr(toks, j + 1, 0) in
        if is_err(nth(r, 0)) then r
        else if kk(nth(r, 1)) != "rparen" then
          parse_err_msg(toks, nth(r, 1), "expected ')'")
        else [nth(r, 0), nth(r, 1) + 1]
    else parse_err(toks,j) in

  /* ---- application: head followed by ( args ), chainable: f(a)(b) ---- */
  let parse_app(j, head) =
    if kk(j) == "lparen" then
      if nth(nth(toks, j), 2) != nth(nth(toks, j - 1), 2) then [head, j]
      else
        let r = parse_arglist(j + 1, []) in
        if not nth(r, 0) then
          close_fail(r, "expected ')' to close argument list")
        else parse_app(nth(r, 2), ["call", head, nth(r, 1)])
    else
      let k = kk(j) in
      let juxta(_) =
        if nth(nth(toks, j), 2) != nth(nth(toks, j - 1), 2) then [head, j]
        else
          let r = parse_expr(toks, j, 0) in
          if is_err(nth(r, 0)) then [head, j]
          else parse_app(nth(r, 1), ["call", head, [nth(r, 0)]]) in
      if k == "ident" then juxta(0)
      else if k == "num" then juxta(0)
      else if k == "str" then juxta(0)
      else if k == "lparen" then juxta(0)
      else if k == "lbrk" then juxta(0)
      else if is_kw(j, "fun") then juxta(0)
      else [head, j] in

  /* ---- if ---- */
  let parse_if(j) =
    let cr = parse_expr(toks, j, 0) in
    if is_err(nth(cr, 0)) then cr
    else
      let cond = nth(cr, 0) in
      let k = nth(cr, 1) in
      if is_kw(k, "then") then
        let tr = parse_expr(toks, k + 1, 0) in
        if is_err(nth(tr, 0)) then tr
        else
          let thena = nth(tr, 0) in
          let m = nth(tr, 1) in
          if is_kw(m, "else") then
            let er = parse_expr(toks, m + 1, 0) in
            if is_err(nth(er, 0)) then er
            else [["if", cond, thena, nth(er, 0)], nth(er, 1)]
          else parse_err_msg(toks, m, "expected 'else'")
      else parse_err_msg(toks, k, "expected 'then'") in

  /* ---- let (supports both `let x = e` and `let f(ps) = e`) ---- */
  let parse_let(j) =
    if kk(j) == "ident" then
      let name = tt(j) in
      let after_name = j + 1 in
      let has_params = kk(after_name) == "lparen" in
      let params_res =
        if has_params then parse_params(after_name + 1, [])
        else [true, [], after_name] in
      if not nth(params_res, 0) then
        parse_err_msg(toks, nth(params_res, 2), "expected ')'")
      else
        let params = nth(params_res, 1) in
        let after_params = nth(params_res, 2) in
        if is_op(after_params, "=") then
          let br = parse_expr(toks, after_params + 1, 0) in
          let bound0 = nth(br, 0) in
          let k = nth(br, 1) in
          let bound1 =
            if has_params then ["fun", params, bound0] else bound0 in
          if is_err(bound0) then br
          else if is_kw(k, "in") then
            let bodyr = parse_expr(toks, k + 1, 0) in
            if is_err(nth(bodyr, 0)) then bodyr
            else [["let", name, bound1, nth(bodyr, 0)], nth(bodyr, 1)]
          else [["let", name, bound1, ["unit"]], k]
        else parse_err(toks,j)
    else parse_err(toks,j) in

  /* ---- binary operator loop (left-assoc, precedence climbing) ---- */
  let parse_binloop(j, lhs, minp) =
    if is_binop_tok(j) then
      let op = tt(j) in
      let p = prec_of(op) in
      if p >= minp then
        let rr = parse_expr(toks, j + 1, p + 1) in
        if is_err(nth(rr, 0)) then rr
        else parse_binloop(nth(rr, 1), ["binop", op, lhs, nth(rr, 0)], minp)
      else [lhs, j]
    else [lhs, j] in

  /* ---- main dispatch ---- */
  if is_kw(i, "let") then parse_let(i + 1)
  else if is_kw(i, "if") then parse_if(i + 1)
  else if is_op(i, "-") then
    /* unary minus: -x  ==  (0 - x); operand binds tightest (min_prec high),
     * then continue with trailing binary operators */
    let ur = parse_expr(toks, i + 1, 7) in
    if is_err(nth(ur, 0)) then ur
    else
      let u = nth(ur, 0) in
      let un =
        if nth(u, 0) == "float" then
          let t = nth(u, 1) in
          if str_len(t) == 0 then u
          else if str_ref(t, 0) == 45 then
            ["float", str_slice(t, 1, str_len(t) - 1)]
          else ["float", str_cat("-", t)]
        else ["binop", "-", ["int", "0"], u] in
      parse_binloop(nth(ur, 1), un, min_prec)
  else
    let pr = parse_primary(i) in
    if is_err(nth(pr, 0)) then pr
    else
      let appr = parse_app(nth(pr, 1), nth(pr, 0)) in
      if is_err(nth(appr, 0)) then appr
      else parse_binloop(nth(appr, 1), nth(appr, 0), min_prec)

/* ---- program: headers then a sequence of top-level exprs ---- */
let parse_program(toks, i, acc) =
  if i >= len(toks) then reverse(acc)
  else if tok_k(toks, i) == "eof" then reverse(acc)
  else if tok_is_kw(toks, i, "package") then
    let d = parse_dotted(toks, i + 1, "") in
    if nth(d, 0) == "" then cons(nth(parse_err(toks, i + 1), 0), acc)
    else parse_program(toks, hdr_semi(toks, nth(d, 1)),
           cons(["package", nth(d, 0)], acc))
  else if tok_is_kw(toks, i, "export") then
    let ids = parse_idlist(toks, i + 1, []) in
    if nth(ids, 0) == [] then cons(nth(parse_err(toks, i + 1), 0), acc)
    else parse_program(toks, hdr_semi(toks, nth(ids, 1)),
           cons(["export", nth(ids, 0)], acc))
  else if tok_is_kw(toks, i, "import") then
    let d = parse_dotted(toks, i + 1, "") in
    if nth(d, 0) == "" then cons(nth(parse_err(toks, i + 1), 0), acc)
    else
      let j = nth(d, 1) in
      if tok_k(toks, j) == "lbrace" then
        let ids = parse_implist(toks, j + 1, []) in
        if tok_k(toks, nth(ids, 1)) != "rbrace" then
          cons(nth(parse_err_msg(toks, nth(ids, 1), "expected '}'"), 0), acc)
        else parse_program(toks, hdr_semi(toks, nth(ids, 1) + 1),
               cons(["import", nth(d, 0), nth(ids, 0), 0], acc))
      else if tok_k(toks, j) == "ident" then
        if tok_t(toks, j) == "as" then
          if tok_k(toks, j + 1) != "ident" then
            cons(nth(parse_err(toks, j + 1), 0), acc)
          else parse_program(toks, hdr_semi(toks, j + 2),
                 cons(["import", nth(d, 0), 0, tok_t(toks, j + 1)], acc))
        else parse_program(toks, hdr_semi(toks, j),
               cons(["import", nth(d, 0)], acc))
      else parse_program(toks, hdr_semi(toks, j),
             cons(["import", nth(d, 0)], acc))
  else
    let r = parse_expr(toks, i, 0) in
    if is_err(nth(r, 0)) then cons(nth(r, 0), acc)
    else
      let rawj = nth(r, 1) in
      let j2 = if rawj < len(toks) then
                 if tok_k(toks, rawj) == "semi" then rawj + 1 else rawj
               else rawj in
      parse_program(toks, j2, cons(nth(r, 0), acc))
