/* lexer.yac — tokenizer for the self-hosted compiler front-end.
 *
 * Token: [kind, text, line]
 *   kind: "ident" | "int" | "str" | "kw" | "op" | "punct" | "eof"
 *   text:  lexeme string (str for strings is the decoded body)
 *   line:  1-based line number
 *
 * lex pushes onto a list_new() buffer (O(1) append). C cons copies the
 * whole array, so cons+reverse tokenize was O(n²) on the 90k-token bundle.
 * Exposes:
 *   tokenize(src) -> token list (last element is ["eof","",line])
 *   token_kind(t), token_text(t), token_line(t)
 */

package front
export tokenize, token_kind, token_text, token_line, tok_ident_line
import lib.map {intern}

let is_digit(c) = c >= 48 and c <= 57
let is_alpha(c) = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
let is_alnum(c) = is_digit(c) or is_alpha(c)
let is_space(c) = c == 32 or c == 9 or c == 10 or c == 13
let is_opchar(c) = c == 43 or c == 45 or c == 42 or c == 47 or c == 37 or
                   c == 61 or c == 60 or c == 62 or c == 33

let is_kw(w) =
  if w == "let" then true
  else if w == "in" then true
  else if w == "fun" then true
  else if w == "if" then true
  else if w == "then" then true
  else if w == "else" then true
  else if w == "not" then true
  else if w == "print" then true
  else if w == "and" then true
  else if w == "or" then true
  else if w == "true" then true
  else if w == "false" then true
  else if w == "callcc" then true
  else if w == "throw" then true
  else if w == "package" then true
  else if w == "import" then true
  else if w == "export" then true
  else false

let slen(s) = str_len(s)
let sat(s, i) = str_ref(s, i)
let at_end(s, i) = i >= str_len(s)

/* skip spaces; returns new pos */
let skip_sp(s, i, line, n) =
  if i >= n then [i, line]
  else if sat(s, i) == 10 then skip_sp(s, i + 1, line + 1, n)
  else if is_space(sat(s, i)) then skip_sp(s, i + 1, line, n)
  else [i, line]

/* skip -- line comment */
let skip_line_cm(s, i) =
  if at_end(s, i) or sat(s, i) == 10 then i else skip_line_cm(s, i + 1)

/* Nested slash-star comments. d is remaining opens (1 after the outer
 * slash-star). slash-star-dot is a path glob, not another opener. */
let skip_block_cm(s, i, line, d) =
  if at_end(s, i) then 0
  else if sat(s, i) == 47 then
    if at_end(s, i + 1) then 0
    else if sat(s, i + 1) == 42 then
      if at_end(s, i + 2) then 0
      else if sat(s, i + 2) == 46 then skip_block_cm(s, i + 1, line, d)
      else skip_block_cm(s, i + 2, line, d + 1)
    else skip_block_cm(s, i + 1, line, d)
  else if sat(s, i) == 42 then
    if at_end(s, i + 1) then 0
    else if sat(s, i + 1) == 47 then
      if d <= 1 then i + 2
      else skip_block_cm(s, i + 2, line, d - 1)
    else skip_block_cm(s, i + 1, line, d)
  else if sat(s, i) == 10 then skip_block_cm(s, i + 1, line + 1, d)
  else skip_block_cm(s, i + 1, line, d)

/* skip double-star comments (slash-star-star ... star-star-slash); pos 0 if open */
let skip_starstar_cm(s, i, line) =
  if at_end(s, i) then 0
  else if sat(s, i) == 42 then
    if at_end(s, i + 1) then 0
    else if sat(s, i + 1) == 42 then
      if at_end(s, i + 2) then 0
      else if sat(s, i + 2) == 47 then i + 3
      else skip_starstar_cm(s, i + 1, line)
    else skip_starstar_cm(s, i + 1, line)
  else if sat(s, i) == 10 then skip_starstar_cm(s, i + 1, line + 1)
  else skip_starstar_cm(s, i + 1, line)

/* read a run of alnum chars (specialized; avoids HO capture of is_alnum) */
let read_alnum(s, i, n) =
  if i >= n then i
  else if is_alnum(sat(s, i)) then read_alnum(s, i + 1, n)
  else i

let read_opchars(s, i, n) =
  if i >= n then i
  else if is_opchar(sat(s, i)) then read_opchars(s, i + 1, n)
  else i

/* --- token constructors --- */
let mk_tok(kind, text, line) = [kind, text, line]

/* C lexer: longest valid operator, not a run of op chars (`=-` is `=` then `-`). */
let scan_op(s, i, line, n) =
  let c = sat(s, i) in
  let has1 = i + 1 < n in
  let c1 = if has1 then sat(s, i + 1) else 0 in
  if c == 61 then
    if has1 then
      if c1 == 61 then [mk_tok("op", "==", line), i + 2]
      else if c1 == 62 then [mk_tok("op", "->", line), i + 2]
      else [mk_tok("op", "=", line), i + 1]
    else [mk_tok("op", "=", line), i + 1]
  else if c == 33 then
    if has1 then
      if c1 == 61 then [mk_tok("op", "!=", line), i + 2]
      else [mk_tok("op", "!", line), i + 1]
    else [mk_tok("op", "!", line), i + 1]
  else if c == 60 then
    if has1 then
      if c1 == 61 then [mk_tok("op", "<=", line), i + 2]
      else [mk_tok("op", "<", line), i + 1]
    else [mk_tok("op", "<", line), i + 1]
  else if c == 62 then
    if has1 then
      if c1 == 61 then [mk_tok("op", ">=", line), i + 2]
      else [mk_tok("op", ">", line), i + 1]
    else [mk_tok("op", ">", line), i + 1]
  else if c == 45 then
    if has1 then
      if c1 == 62 then [mk_tok("op", "->", line), i + 2]
      else [mk_tok("op", "-", line), i + 1]
    else [mk_tok("op", "-", line), i + 1]
  else [mk_tok("op", str_slice(s, i, 1), line), i + 1]

/* scan an identifier or keyword starting at pos */
let scan_ident(s, i, line, n) =
  let e = read_alnum(s, i, n) in
  let w = str_slice(s, i, e - i) in
  let k = if is_kw(w) then "kw" else "ident" in
  [mk_tok(k, w, line), e]

/* scan a number (int or float) starting at pos. Grammar:
 *   digits [ . digits ] [ (e|E) [ + | - ] digits ]
 * The exponent is only part of the number when e/E is followed by a digit
 * (optionally signed); otherwise e/E begins a separate identifier. */
let is_exp(c) = c == 101 or c == 69  /* 'e' or 'E' */
let read_digits(s, i) =
  if at_end(s, i) then i
  else if is_digit(sat(s, i)) then read_digits(s, i + 1)
  else i
let read_num_body(s, i) =
  if at_end(s, i) then i
  else if is_digit(sat(s, i)) or sat(s, i) == 46 then read_num_body(s, i + 1)
  else i
let scan_num(s, i, line) =
  let e = read_num_body(s, i) in
  /* yac's and/or are not short-circuit, so guard each sat() with if */
  let m =
    if at_end(s, e) then e
    else if not is_exp(sat(s, e)) then e
    else if at_end(s, e + 1) then e
    else if is_digit(sat(s, e + 1)) then
      read_digits(s, e + 1)
    else if sat(s, e + 1) == 43 or sat(s, e + 1) == 45 then
      /* optional sign: consume only if a digit follows */
      if at_end(s, e + 2) then e
      else if is_digit(sat(s, e + 2)) then read_digits(s, e + 2)
      else e
    else e
  in
  let txt = str_slice(s, i, m - i) in
  [mk_tok("num", txt, line), m]

/* scan a string literal starting after the opening quote at pos; returns
 * [tok, nextpos] or [null, 0] on unterminated */
let scan_str(s, i, line, acc, buf) =
  if at_end(s, i) then [["error", "lex", 0], 0]
  else
    let c = sat(s, i) in
    if c == 34 then
      let out = bytes_to_str(buf) in
      [mk_tok("str", out, line), i + 1]
    else if c == 92 then
      if at_end(s, i + 1) then [["error", "lex", 0], 0]
      else
        let e = sat(s, i + 1) in
        let ch =
          if e == 110 then 10
          else if e == 116 then 9
          else if e == 114 then 13
          else if e == 48 then 0
          else e in
        let _ = bytes_append(buf, ch) in
        scan_str(s, i + 2, line, acc, buf)
    else
      let _ = bytes_append(buf, c) in
      scan_str(s, i + 1, line, acc, buf)

/* classify a delimiter char */
let punct_kind(c) =
  if c == 40 then "lparen"
  else if c == 41 then "rparen"
  else if c == 91 then "lbrk"
  else if c == 93 then "rbrk"
  else if c == 123 then "lbrace"
  else if c == 125 then "rbrace"
  else if c == 44 then "comma"
  else if c == 59 then "semi"
  else if c == 46 then "dot"
  else "punct"

let is_punct(c) = c == 40 or c == 41 or c == 91 or c == 93 or c == 123 or
                  c == 125 or c == 44 or c == 59 or c == 46

/* main lex loop */
let lex(s, i, line, acc, n) =
  if i >= n then
    let _ = list_push(acc, mk_tok("eof", "", line)) in acc
  else if is_space(sat(s, i)) then
    let sp = skip_sp(s, i, line, n) in
    lex(s, nth(sp, 0), nth(sp, 1), acc, n)
  else if sat(s, i) == 45 and (if i + 1 >= n then false else sat(s, i + 1) == 45) then
    lex(s, skip_line_cm(s, i + 2), line, acc, n)
  else if sat(s, i) == 47 and (if i + 1 >= n then false else sat(s, i + 1) == 42) then
    let starstar =
      if i + 2 >= n then false
      else if sat(s, i + 2) != 42 then false
      else if i + 3 >= n then true
      else sat(s, i + 3) != 47 in
    let e =
      if starstar then skip_starstar_cm(s, i + 3, line)
      else skip_block_cm(s, i + 2, line, 1) in
    if e == 0 then
      let _ = list_push(acc, mk_tok("eof", "unterminated-comment", line)) in acc
    else lex(s, e, line, acc, n)
  else if is_alpha(sat(s, i)) then
    let r = scan_ident(s, i, line, n) in
    let _ = list_push(acc, nth(r, 0)) in
    lex(s, nth(r, 1), line, acc, n)
  else if is_digit(sat(s, i)) then
    let r = scan_num(s, i, line) in
    let _ = list_push(acc, nth(r, 0)) in
    lex(s, nth(r, 1), line, acc, n)
  else if sat(s, i) == 34 then
    let r = scan_str(s, i + 1, line, 0, bytes_new()) in
    if nth(nth(r, 0), 0) == "error" then
      let _ = list_push(acc, mk_tok("eof", "unterminated-string", line)) in acc
    else
      let _ = list_push(acc, nth(r, 0)) in
      lex(s, nth(r, 1), line, acc, n)
  else if is_opchar(sat(s, i)) then
    let r = scan_op(s, i, line, n) in
    let _ = list_push(acc, nth(r, 0)) in
    lex(s, nth(r, 1), line, acc, n)
  else if is_punct(sat(s, i)) then
    let c = sat(s, i) in
    let txt = str_slice(s, i, 1) in
    let _ = list_push(acc, mk_tok(punct_kind(c), txt, line)) in
    lex(s, i + 1, line, acc, n)
  else
    let txt = str_slice(s, i, 1) in
    let _ = list_push(acc, mk_tok("punct", txt, line)) in
    lex(s, i + 1, line, acc, n)

/* Seed intern table with compiler literals (pooled in native yc) so
 * intern_toks of source text returns the same pointers as k == "ident". */
let intern_seed(_) =
  let _ = intern("ident") in
  let _ = intern("kw") in
  let _ = intern("op") in
  let _ = intern("punct") in
  let _ = intern("num") in
  let _ = intern("str") in
  let _ = intern("eof") in
  let _ = intern("lparen") in
  let _ = intern("rparen") in
  let _ = intern("lbrk") in
  let _ = intern("rbrk") in
  let _ = intern("lbrace") in
  let _ = intern("rbrace") in
  let _ = intern("comma") in
  let _ = intern("semi") in
  let _ = intern("let") in
  let _ = intern("in") in
  let _ = intern("fun") in
  let _ = intern("if") in
  let _ = intern("then") in
  let _ = intern("else") in
  let _ = intern("not") in
  let _ = intern("print") in
  let _ = intern("and") in
  let _ = intern("or") in
  let _ = intern("true") in
  let _ = intern("false") in
  let _ = intern("callcc") in
  let _ = intern("throw") in
  let _ = intern("package") in
  let _ = intern("import") in
  let _ = intern("export") in
  let _ = intern("dot") in
  let _ = intern("->") in
  let _ = intern("=") in
  let _ = intern("==") in
  let _ = intern("!=") in
  let _ = intern("<") in
  let _ = intern("<=") in
  let _ = intern(">") in
  let _ = intern(">=") in
  let _ = intern("+") in
  let _ = intern("-") in
  let _ = intern("*") in
  let _ = intern("/") in
  let _ = intern("%") in
  let _ = intern("var") in
  let _ = intern("int") in
  let _ = intern("float") in
  let _ = intern("bool") in
  let _ = intern("unit") in
  let _ = intern("nil") in
  let _ = intern("error") in
  let _ = intern("letbin") in
  let _ = intern("letcall") in
  let _ = intern("letif") in
  let _ = intern("letfun") in
  let _ = intern("cons") in
  let _ = intern("len") in
  let _ = intern("nth") in
  let _ = intern("tail") in
  let _ = intern("append") in
  let _ = intern("map") in
  let _ = intern("filter") in
  let _ = intern("foldl") in
  let _ = intern("foldr") in
  let _ = intern("drop") in
  let _ = intern("head") in
  let _ = intern("ccall") in
  let _ = intern("cload") in
  let _ = intern("csym") in
  0

/* After lex: intern ident/kw/op/punct/num/str text so later == is pointer-eq
 * on native (and cheap intern-table hits). TCO loop; not nested inside lex. */
let intern_toks(toks, i, n) =
  if i >= n then toks
  else
    let t = nth(toks, i) in
    let k = nth(t, 0) in
    if k == "eof" then intern_toks(toks, i + 1, n)
    else if k == "num" then intern_toks(toks, i + 1, n)
    else if k == "str" then intern_toks(toks, i + 1, n)
    else
      let _ = list_set(toks, i, [k, intern(nth(t, 1)), nth(t, 2)]) in
      intern_toks(toks, i + 1, n)

/* public API */
let tokenize(src) =
  let _ = intern_seed(0) in
  let acc = list_new() in
  let toks = lex(src, 0, 1, acc, str_len(src)) in
  intern_toks(toks, 0, len(toks))

let token_kind(t) = nth(t, 0)
let token_text(t) = nth(t, 1)
let token_line(t) = nth(t, 2)

/* Line of first token whose text is name. Token walk (TCO), not a byte
 * rec() — that was apply + 0x180 frames and SIGSEGV on a megabyte bundle. */
let tok_ident_line(toks, name, i, n) =
  if i >= n then 1
  else if token_text(nth(toks, i)) == name then token_line(nth(toks, i))
  else tok_ident_line(toks, name, i + 1, n)
