/* anf.yac — normalize AST to A-Normal Form (explicit evaluation order).
 *
 * Input: AST from parser.yac. Output: ANF as [bindings, tailExpr]:
 *   bindings: cons list of statements (kept in order):
 *     ["let",   temp, atom]                     -- temp = atom
 *     ["letcall", temp, fnAtom, [argAtoms]]     -- temp = fn(arg...)
 *     ["letbin",  temp, op, aAtom, bAtom]       -- temp = a op b
 *     ["letif",   temp, condAtom, thenBindings, elseBindings]
 *     ["letfun",  temp, [params], bodyBindings] -- temp = fun(params)
 *   atom:
 *     ["int",s] ["str",s] ["bool","true"|"false"] ["unit"]
 *     ["var",name] ["fun",[params],bodyBindings]
 *   tailExpr: the atom that is the expression's value.
 *
 * Bindings stay cons so nested `let` can append(small, large) in O(1) via
 * tail sharing. LIR converts each body to listbuf once (nth O(1) walk).
 * Ordinary let-chains are walked iteratively (reverse-cons, then one
 * reverse + append) so lang.js's deep `let _ = e in ...` does not recurse
 * through go per arm, while still tail-sharing the final body binds.
 *
 * Architecture: helpers live inside mk_anf; internal recursion uses boxed
 * `go` so nested lets reuse closures (same cliff as parse_expr).
 */

package front.anf
export anf_all, anf_expr, reverse

let reverse(xs) = list_rev(xs)

/* One go closure for the whole anf_all pass (helpers do not close over AST). */
let anf_sess = box_new()

let mk_anf(_) =
  let go_b = box_new() in
  let go(ast, c) = (box_get(go_b))(ast, c) in
  /* Fresh temps are unique per counter — do not intern. Interning millions
   * of `tN` into the permanent arena dominated main.yac ANF RSS. */
  let fresh(c) = [str_cat("t", int_to_str(c)), c + 1] in

  /* atomize a sub-expression: returns [bindings, atom, counter].
   * If ast is already atomic, bindings is empty; else it binds a fresh temp. */
  let anf_atom(expr, c) =
    let k = nth(expr, 0) in
    if k == "int" then [[], expr, c]
    else if k == "float" then [[], expr, c]
    else if k == "str" then [[], expr, c]
    else if k == "bool" then [[], expr, c]
    else if k == "unit" then [[], expr, c]
    else if k == "var" then [[], expr, c]
    else if k == "qvar" then [[], expr, c]
    else if k == "fun" then
      /* closure: [fun, [params], body] or [fun, params, body, 1] for rest */
      let br = go(nth(expr, 2), c) in
      let tup = fresh(nth(br, 2)) in
      let fbody = [nth(br, 0), nth(br, 1)] in
      let restf = if len(expr) > 3 then nth(expr, 3) else 0 in
      let fb =
        if restf == 0 then ["letfun", nth(tup, 0), nth(expr, 1), fbody]
        else ["letfun", nth(tup, 0), nth(expr, 1), fbody, 1] in
      [[fb], ["var", nth(tup, 0)], nth(tup, 1)]
    else
      /* non-atomic: the normalized expression's tail is already an atom
       * (its last binding produced the value), so use it directly. */
      let r = go(expr, c) in
      [nth(r, 0), nth(r, 1), nth(r, 2)] in

  let anf_go(ast, counter) =
    let k = nth(ast, 0) in
    if k == "int" then [[], ast, counter]
    else if k == "float" then [[], ast, counter]
    else if k == "str" then [[], ast, counter]
    else if k == "bool" then [[], ast, counter]
    else if k == "unit" then [[], ast, counter]
    else if k == "var" then [[], ast, counter]
    else if k == "qvar" then [[], ast, counter]
    else if k == "fun" then
      /* fun (params) -> body. Fourth field 1 means the last param is rest. */
      let br = go(nth(ast, 2), counter) in
      let tup = fresh(nth(br, 2)) in
      let fbody = [nth(br, 0), nth(br, 1)] in
      let restf = if len(ast) > 3 then nth(ast, 3) else 0 in
      let fb =
        if restf == 0 then ["letfun", nth(tup, 0), nth(ast, 1), fbody]
        else ["letfun", nth(tup, 0), nth(ast, 1), fbody, 1] in
      [[fb], ["var", nth(tup, 0)], nth(tup, 1)]
    else if k == "list" then
      /* desugar [e1,...,en] to cons(e1, cons(... cons(en, []))).
       * Old recursive append(append(ir, tr), letcall) was O(n²) on the
       * growing tail (--prof-out: build ~5.5% excl on yc_bundle; main.yac
       * JS arrays make this the ANF cliff). Emit into a listbuf then
       * one O(n) cons spine. */
      let items = nth(ast, 1) in
      let n = len(items) in
      let buf = list_new() in
      let flush(xs) =
        if xs == [] then 0
        else
          let _ = list_push(buf, nth(xs, 0)) in
          flush(tail(xs)) in
      let atoms = list_new() in
      let atomize(i, c) =
        if i >= n then c
        else
          let ir = anf_atom(nth(items, i), c) in
          let _ = flush(nth(ir, 0)) in
          let _ = list_push(atoms, nth(ir, 1)) in
          atomize(i + 1, nth(ir, 2)) in
      let c1 = atomize(0, counter) in
      let nilt = fresh(c1) in
      let _ = list_push(buf, ["let", nth(nilt, 0), ["nil"]]) in
      let wrap(i, c, acc) =
        if i < 0 then [acc, c]
        else
          let tup = fresh(c) in
          let _ = list_push(buf,
                    ["letcall", nth(tup, 0), ["var", "cons"],
                     [nth(atoms, i), acc]]) in
          wrap(i - 1, nth(tup, 1), ["var", nth(tup, 0)]) in
      let wr = wrap(n - 1, nth(nilt, 1), ["var", nth(nilt, 0)]) in
      let to_cons(j, acc) =
        if j < 0 then acc
        else to_cons(j - 1, cons(nth(buf, j), acc)) in
      [to_cons(len(buf) - 1, []), nth(wr, 0), nth(wr, 1)]
    else if k == "callcc" then
      let ar = anf_atom(nth(ast, 1), counter) in
      let kn = fresh(nth(ar, 2)) in
      let rn = fresh(nth(kn, 1)) in
      let body = [[], ["var", nth(kn, 0)]] in
      [append(nth(ar, 0),
              [["letcallcc", nth(kn, 0), nth(rn, 0), nth(ar, 1), body]]),
       ["var", nth(rn, 0)], nth(rn, 1)]
    else if k == "throw" then
      let ka = anf_atom(nth(ast, 1), counter) in
      let va = anf_atom(nth(ast, 2), nth(ka, 2)) in
      let tup = fresh(nth(va, 2)) in
      [append(append(nth(ka, 0), nth(va, 0)),
              [["letthrow", nth(tup, 0), nth(ka, 1), nth(va, 1)]]),
       ["var", nth(tup, 0)], nth(tup, 1)]
    else if k == "not" then
      /* not x  →  if x then false else true */
      go(["if", nth(ast, 1), ["bool", "false"], ["bool", "true"]], counter)
    else if k == "binop" then
      /* op lhs rhs -> temp = lhs op rhs */
      let la = anf_atom(nth(ast, 2), counter) in
      let ra = anf_atom(nth(ast, 3), nth(la, 2)) in
      let tup = fresh(nth(ra, 2)) in
      let bindings = append(append(nth(la, 0), nth(ra, 0)),
                            [["letbin", nth(tup, 0), nth(ast, 1),
                              nth(la, 1), nth(ra, 1)]]) in
      [bindings, ["var", nth(tup, 0)], nth(tup, 1)]
    else if k == "call" then
      /* call fn args -> temp = fn(arg...). Atomize fn and each arg. */
      let fa = anf_atom(nth(ast, 1), counter) in
      let args = nth(ast, 2) in
      let nargs = len(args) in
      let argloop(i, c, accb, acca) =
        if i >= nargs then [accb, reverse(acca), c]
        else
          let aa = anf_atom(nth(args, i), c) in
          argloop(i + 1, nth(aa, 2), append(nth(aa, 0), accb),
                  cons(nth(aa, 1), acca)) in
      let arr = argloop(0, nth(fa, 2), [], []) in
      let tup = fresh(nth(arr, 2)) in
      let bindings = append(append(nth(fa, 0), nth(arr, 0)),
                            [["letcall", nth(tup, 0), nth(fa, 1), nth(arr, 1)]]) in
      [bindings, ["var", nth(tup, 0)], nth(tup, 1)]
    else if k == "if" then
      /* if cond then a else b  ->  cond atomized, branches normalized.
       * Each branch is stored as [branchBindings, branchTail]. */
      let ca = anf_atom(nth(ast, 1), counter) in
      let tr = go(nth(ast, 2), nth(ca, 2)) in
      let er = go(nth(ast, 3), nth(tr, 2)) in
      let tup = fresh(nth(er, 2)) in
      let bindings = append(nth(ca, 0),
                            [["letif", nth(tup, 0), nth(ca, 1),
                              [nth(tr, 0), nth(tr, 1)],
                              [nth(er, 0), nth(er, 1)]]]) in
      [bindings, ["var", nth(tup, 0)], nth(tup, 1)]
    else if k == "let" then
      /* Flatten `let a = e1 in let b = e2 in ... in body` without one go
       * frame per arm (main.yac from lang.js: ~4e5 lets, depth ~600).
       * Acc is binds in reverse; list_rev_onto keeps O(1) cons per bind.
       * fun/callcc break the chain (same special binders as before). */
      let list_rev_onto(xs, acc) =
        if xs == [] then acc
        else list_rev_onto(tail(xs), cons(nth(xs, 0), acc)) in
      /* Prefixed binds (reversed) ++ body binds; shares body's cons spine. */
      let finish(rev, body_binds, atom, c) =
        [append(reverse(rev), body_binds), atom, c] in
      let loop(e, c, rev) =
        if nth(e, 0) != "let" then
          let r = go(e, c) in
          finish(rev, nth(r, 0), nth(r, 1), nth(r, 2))
        else
          let name = nth(e, 1) in
          let bound = nth(e, 2) in
          let bk = nth(bound, 0) in
          if bk == "fun" then
            let params = nth(bound, 1) in
            let bodyr = go(nth(bound, 2), c) in
            let fbody = [nth(bodyr, 0), nth(bodyr, 1)] in
            let restf = if len(bound) > 3 then nth(bound, 3) else 0 in
            let fbind =
              if restf == 0 then ["letfun", name, params, fbody]
              else ["letfun", name, params, fbody, 1] in
            let body2 = go(nth(e, 3), nth(bodyr, 2)) in
            finish(cons(fbind, rev), nth(body2, 0), nth(body2, 1), nth(body2, 2))
          else if bk == "callcc" then
            let ar = anf_atom(nth(bound, 1), c) in
            let bodyr = go(nth(e, 3), nth(ar, 2)) in
            let tup = fresh(nth(bodyr, 2)) in
            let rev1 = list_rev_onto(nth(ar, 0), rev) in
            let rev2 = cons(
                         ["letcallcc", name, nth(tup, 0), nth(ar, 1),
                          [nth(bodyr, 0), nth(bodyr, 1)]],
                         rev1) in
            [reverse(rev2), ["var", nth(tup, 0)], nth(tup, 1)]
          else
            let br = anf_atom(bound, c) in
            let rev1 = list_rev_onto(nth(br, 0), rev) in
            let rev2 = cons(["let", name, nth(br, 1)], rev1) in
            loop(nth(e, 3), nth(br, 2), rev2) in
      loop(ast, counter, [])
    else [["error", "anf"], ["unit"], counter] in
  let _ = box_set(go_b, anf_go) in
  anf_go

let anf_expr(ast, counter) =
  let s = box_get(anf_sess) in
  if s != 0 then s(ast, counter)
  else
    let g = mk_anf(0) in
    let _ = box_set(anf_sess, g) in
    g(ast, counter)

let ast_is_hdr(e) =
  let k = nth(e, 0) in
  if k == "package" then true
  else if k == "import" then true
  else if k == "export" then true
  else false

let anf_top(item) =
  let r = anf_expr(item, 0) in
  [nth(r, 0), nth(r, 1)]

let anf_all(i, prog, acc, n) =
  /* Reset then prime session so every top form reuses the same helpers. */
  let _ = if i == 0 then
            let g = mk_anf(0) in
            box_set(anf_sess, g)
          else 0 in
  if i >= n then acc
  else
    let e = nth(prog, i) in
    /* prog is a listbuf (see prog_vec). list_set clears the slot, so this
     * item's tree is unreachable once `e` is overwritten on the next turn.
     * A cons spine ignores list_set; the compile path must not keep one.
     * The dropped trees return on the next allocation-triggered collect;
     * do not collect here — a full mark per batch dominates host compiles
     * such as lang_js, which re-enters the compiler hundreds of times. */
    let _ = list_set(prog, i, 0) in
    let _ = if ast_is_hdr(e) then 0 else list_push(acc, anf_top(e)) in
    anf_all(i + 1, prog, acc, n)
