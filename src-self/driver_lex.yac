/* self-hosted lexer test driver (M2)
 *
 * Usage: concat(lexer.yac, this) -> run with ./yac. Reads the input file,
 * tokenizes it, and prints "kind text" per token so the test can compare.
 * The input file path is fixed so the driver is self-contained.
 */
let src = read_file("build/shlex_tmp/lexin.yac");
let toks = tokenize(src);
let show(n) = if n >= len(toks) then 0 else
  let t = nth(toks, n) in
  if token_kind(t) == "eof" then show(n + 1)
  else
    let _ = print str_cat(str_cat(token_kind(t), " "), token_text(t)) in
    show(n + 1);
let _ = show(0);
0;
