/* encode_x64.yac — x86-64 instruction encoding (M3 backend, step 2).
 *
 * Emits instruction bytes into a growable bytes buffer. Register numbers
 * (x86-64):
 *   rax=0 rcx=1 rdx=2 rbx=3 rsp=4 rbp=5 rsi=6 rdi=7 r8=8 ... r15=15
 * Stack frame: rbp = frame base; locals/params at [rbp+disp8].
 *
 * Every emit_* function appends to the buffer and returns 0 (or the new
 * buffer for chaining). All literals are decimal (no hex in yac).
 */

/* ---- small helpers ---- */

/* append a byte */
let e8(b, v) = bytes_append(b, band(v, 255))
/* append imm32 little-endian */
let e32(b, v) =
  let _ = e8(b, band(v, 255)) in
  let _ = e8(b, band(bshr(v, 8), 255)) in
  let _ = e8(b, band(bshr(v, 16), 255)) in
  let _ = e8(b, band(bshr(v, 24), 255)) in
  b
/* append imm64 little-endian */
let e64(b, v) =
  let _ = e32(b, band(v, 4294967295)) in
  let _ = e32(b, bshr(v, 32)) in
  b

/* ---- modrm/sib helpers ---- */

/* modrm byte: mod(2) reg(3) rm(3) */
let modrm(mod_, reg, rm) = bor(bor(bshl(mod_, 6), bshl(reg, 3)), rm)

/* ---- register moves ---- */

/* mov r64, imm32 sign-extended (48 c7 /0 id32). Works for any register. */
let mov_r64_imm(b, rd, imm) =
  let _ = e8(b, 72) in       /* REX.W */
  let _ = e8(b, 199) in      /* c7 */
  let _ = e8(b, modrm(3, 0, rd)) in  /* /0, rm=rd */
  e32(b, imm)

/* mov r64, imm64 (REX.W b8+rd id64). Needed for tagged LIR immediates. */
let mov_r64_imm64(b, rd, imm) =
  let rex = if rd >= 8 then 73 else 72 in
  let _ = e8(b, rex) in
  let _ = e8(b, 184 + band(rd, 7)) in
  e64(b, imm)

/* mov rax, imm32 zero-extended (b8 id32, no REX) — 5 bytes, for small ints */
let mov_eax_imm(b, imm) =
  let _ = e8(b, 184) in      /* b8 */
  e32(b, imm)

/* mov r64, r64 (48 89 /r  or  48 8b /r) */
let mov_r64_r64(b, dst, src) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in      /* 89 /r */
  e8(b, modrm(3, src, dst))

/* mov r64, [rbp+disp8]  (48 8b 45 id8) — load local */
let mov_r64_mem_rbp(b, reg, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in      /* 8b /r */
  let _ = e8(b, modrm(1, reg, 5)) in  /* mod=01 rm=rbp */
  e8(b, band(disp8, 255))

/* mov [rbp+disp8], r64  (48 89 45 id8) — store local */
let mov_mem_rbp_r64(b, disp8, reg) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in      /* 89 /r */
  let _ = e8(b, modrm(1, reg, 5)) in
  e8(b, band(disp8, 255))

/* mov [rbp+disp32], r64  (48/4c 89 85 id32) */
let mov_mem_rbp32_r64(b, disp32, reg) =
  let rex = if reg >= 8 then 76 else 72 in
  let r = if reg >= 8 then reg - 8 else reg in
  let _ = e8(b, rex) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(2, r, 5)) in
  e32(b, disp32)

/* mov r64, [rbp+disp32]  (48/4c 8b 85 id32) */
let mov_r64_mem_rbp32(b, reg, disp32) =
  let rex = if reg >= 8 then 76 else 72 in
  let r = if reg >= 8 then reg - 8 else reg in
  let _ = e8(b, rex) in
  let _ = e8(b, 139) in
  let _ = e8(b, modrm(2, r, 5)) in
  e32(b, disp32)

/* ---- stack frame ---- */

/* push rbp */
let push_rbp(b) = e8(b, 85)
/* pop rbp */
let pop_rbp(b) = e8(b, 93)
/* mov rbp, rsp (48 89 e5) */
let mov_rbp_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 229)
/* sub rsp, imm8 (48 83 ec id8) */
let sub_rsp_imm8(b, imm8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 131) in
  let _ = e8(b, 236) in      /* 83 /5 -> sub */
  e8(b, band(imm8, 255))
/* add rsp, imm8 (48 83 c4 id8) */
let add_rsp_imm8(b, imm8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 131) in
  let _ = e8(b, 196) in      /* 83 /4 -> add */
  e8(b, band(imm8, 255))
/* mov rax, [rsp]  (48 8b 04 24) */
let mov_rax_mem_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 4) in
  e8(b, 36)
/* mov rax, [rsp+8]  (48 8b 44 24 08) */
let mov_rax_mem_rsp8(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 68) in
  let _ = e8(b, 36) in
  e8(b, 8)
/* mov rdi, [rsp]  (48 8b 3c 24) */
let mov_rdi_mem_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 60) in
  e8(b, 36)
/* lea rsi, [rsp]  (48 8d 34 24) */
let lea_rsi_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 141) in
  let _ = e8(b, 52) in
  e8(b, 36)
/* lea rsi, [rsp+8]  (48 8d 74 24 08) */
let lea_rsi_rsp8(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 141) in
  let _ = e8(b, 116) in
  let _ = e8(b, 36) in
  e8(b, 8)
/* mov rbx, [rsp]  (48 8b 1c 24) */
let mov_rbx_mem_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 28) in
  e8(b, 36)
/* ret */
let ret(b) = e8(b, 195)

/* ---- arithmetic: rax = rax op [rbp+disp8] ---- */

/* add rax, [rbp+disp8]  (48 03 45 id8) */
let add_rax_mem_rbp(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 3) in
  let _ = e8(b, modrm(1, 0, 5)) in
  e8(b, band(disp8, 255))
/* sub rax, [rbp+disp8]  (48 2b 45 id8) */
let sub_rax_mem_rbp(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 43) in
  let _ = e8(b, modrm(1, 0, 5)) in
  e8(b, band(disp8, 255))
/* imul rax, [rbp+disp8]  (48 0f af 45 id8) */
let imul_rax_mem_rbp(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 15) in
  let _ = e8(b, 175) in
  let _ = e8(b, modrm(1, 0, 5)) in
  e8(b, band(disp8, 255))

/* cmp rax, [rbp+disp8]  (48 3b 45 id8) — sets flags; do not keep result */
let cmp_rax_mem_rbp(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 59) in       /* 3b /r */
  let _ = e8(b, modrm(1, 0, 5)) in
  e8(b, band(disp8, 255))

/* idiv rax by [rbp+disp8] (48 f7 7d id8); requires sign-extended rdx
 * (use cqo first: 48 99). Quotient in rax, remainder in rdx. */
let cqo(b) =
  let _ = e8(b, 72) in
  e8(b, 153)                /* 99 */
let idiv_rax_mem_rbp(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 247) in     /* f7 /7 */
  let _ = e8(b, modrm(1, 7, 5)) in
  e8(b, band(disp8, 255))

/* xor rax, rax (48 31 c0) — zero */
let xor_rax_rax(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 49) in
  e8(b, 192)

/* movzx eax, al (0f b6 c0) — zero-extend setcc result */
let movzx_eax_al(b) =
  let _ = e8(b, 15) in
  let _ = e8(b, 182) in
  e8(b, 192)

/* setcc r8 (0f 9x c0) with cc byte; then movzx eax,al */
let setcc_r8(b, cc) =
  let _ = e8(b, 15) in
  let _ = e8(b, bor(144, cc)) in  /* 90+cc */
  e8(b, 192)

/* push r64 (50+rd) */
let push_r64(b, rd) = e8(b, bor(80, rd))
/* pop r64 (58+rd) */
let pop_r64(b, rd) = e8(b, bor(88, rd))

/* cmp rdi, imm8 (48 83 ff id8) — 3-byte form for rdi */
let cmp_rdi_imm8(b, imm8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 131) in
  let _ = e8(b, 255) in   /* /7 rm=rdi */
  e8(b, band(imm8, 255))

/* lea rdi, [rdi + disp8]  (48 8d 7f id8) */
let lea_rdi_rdi_disp8(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 141) in   /* 8d */
  let _ = e8(b, 127) in   /* mod=01 reg=rdi rm=rdi */
  e8(b, band(disp8, 255))

/* lea rsi, [rbp + disp8]  (48 8d 75 id8) — e.g. timespec on stack */
let lea_rsi_rbp_disp8(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 141) in
  let _ = e8(b, 117) in   /* mod=01 reg=rsi rm=rbp */
  e8(b, band(disp8, 255))

/* imul rax, rdi  (48 0f af c7) */
let imul_rax_rdi(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 15) in
  let _ = e8(b, 175) in
  e8(b, 199)

/* mov rdi, rax  (48 89 c7) */
let mov_rdi_rax(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 199)

/* mov rax, rdi  (48 89 f8) */
let mov_rax_rdi(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 248)

/* ---- branches ---- */

/* test rax, rax (48 85 c0) */
let test_rax_rax(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 133) in
  e8(b, 192)

/* jcc rel32: 0f 8x id32 (near conditional jump) */
let jcc_rel32(b, cc, off) =
  let _ = e8(b, 15) in
  let _ = e8(b, bor(128, cc)) in
  e32(b, off)
/* jcc rel8: 7x id8 (short conditional jump) */
let jcc_rel8(b, cc, off) =
  let _ = e8(b, bor(112, cc)) in
  e8(b, band(off, 255))
/* jmp rel32: e9 id32 */
let jmp_rel32(b, off) =
  let _ = e8(b, 233) in
  e32(b, off)
/* jmp rel8: eb id8 */
let jmp_rel8(b, off) =
  let _ = e8(b, 235) in
  e8(b, band(off, 255))

let syscall(b) =
  let _ = e8(b, 15) in
  e8(b, 5)

/* call rel32 (e8 id32) — placeholder offset 0; patched later */
let call_rel32(b, off) =
  let _ = e8(b, 232) in
  e32(b, off)

/* ---- argument register moves (System V: rdi,rsi,rdx,rcx,r8,r9) ---- */

/* mov rdi <- rax (48 89 c7) */
let mov_rdi_rax(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 199)

/* mov [rbp+disp8] <- rdi (48 89 7d id8) */
let mov_mem_rbp_rdi(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 7, 5)) in   /* reg=rdi rm=rbp */
  e8(b, band(disp8, 255))

/* mov [rbp+disp8] <- rsi (48 89 75 id8) */
let mov_mem_rbp_rsi(b, disp8) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 6, 5)) in
  e8(b, band(disp8, 255))

/* mov rdi <- rax then call via indirection is not needed; direct call_rel32 */

/* ---- division by register not needed for M3.3 ---- */

/* mov rsp, rbp (48 89 ec) — restore frame before pop/ret */
let mov_rsp_rbp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 236)

/* ---- extra encoders for print_int runtime ---- */

/* cmp rax, imm8 (48 83 f8 id8) */
let cmp_rax_imm8(b, v) =
  let _ = e8(b, 72) in
  let _ = e8(b, 131) in
  let _ = e8(b, 248) in   /* /7 rm=rax */
  e8(b, band(v, 255))
/* mov rcx, imm32 (48 c7 c1 id32) */
let mov_rcx_imm(b, v) =
  let _ = e8(b, 72) in
  let _ = e8(b, 199) in
  let _ = e8(b, 193) in
  e32(b, v)
/* idiv rcx (48 f7 f9) */
let idiv_rcx(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 247) in
  e8(b, 249)
/* mov [rbp-8], rax (48 89 45 f8) */
let mov_mem_rbp8_rax(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, 69) in
  e8(b, 248)
/* mov rax, [rbp-8] (48 8b 45 f8) */
let mov_rax_mem_rbp8(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 69) in
  e8(b, 248)
/* add rax, imm8 (48 83 c0 id8) */
let add_rax_imm8(b, v) =
  let _ = e8(b, 72) in
  let _ = e8(b, 131) in
  let _ = e8(b, 192) in
  e8(b, band(v, 255))
/* mov [rsp], al (88 04 24) */
let mov_mem_rsp_al(b) =
  let _ = e8(b, 136) in
  let _ = e8(b, 4) in
  e8(b, 36)
/* mov rsi, rsp (48 89 e6) */
let mov_rsi_rsp(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  e8(b, 230)
/* mov rdx, imm8 (48 c7 c2 id32) */
let mov_rdx_imm(b, v) =
  let _ = e8(b, 72) in
  let _ = e8(b, 199) in
  let _ = e8(b, 194) in
  e32(b, v)
/* mov rdi, imm8 (48 c7 c7 id32) */
let mov_rdi_imm(b, v) =
  let _ = e8(b, 72) in
  let _ = e8(b, 199) in
  let _ = e8(b, 199) in
  e32(b, v)

/* ---- multi-arg register moves ---- */

/* mov rsi <- rax (48 89 c6) */
let mov_rsi_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 137) in e8(b, 198)
/* mov rdx <- rax (48 89 c2) */
let mov_rdx_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 137) in e8(b, 194)
/* mov rcx <- rax (48 89 c1) */
let mov_rcx_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 137) in e8(b, 193)
/* add rdi, rax  (48 01 c7) */
let add_rdi_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 1) in e8(b, 199)
/* add rsi, rax  (48 01 c6) */
let add_rsi_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 1) in e8(b, 198)
/* cld (fc) — forward rep movsb */
let cld(b) = e8(b, 252)
/* rep movsb (f3 a4) */
let rep_movsb(b) =
  let _ = e8(b, 243) in e8(b, 164)
/* mov r8  <- rax (49 89 c0) */
let mov_r8_rax(b) =
  let _ = e8(b, 73) in let _ = e8(b, 137) in e8(b, 192)
/* mov r9  <- rax (49 89 c1) */
let mov_r9_rax(b) =
  let _ = e8(b, 73) in let _ = e8(b, 137) in e8(b, 193)

/* mov rdi, [rbp+disp8]  (48 8b 7d id8) — load a captured value into rdi */
let mov_rdi_mem_rbp(b, d) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, modrm(1, 7, 5)) in
  e8(b, band(d, 255))
/* mov <argreg>, [rax+disp8]  (48/4c 8b 7x id8) — load a captured env value
 * from the closure object into a System V arg register (rdi..r9). */
let mov_argreg_rax_disp8(b, reg, disp8) =
  if reg == 0 then
    let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 120) in
    e8(b, band(disp8, 255))
  else if reg == 1 then
    let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 112) in
    e8(b, band(disp8, 255))
  else if reg == 2 then
    let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 80) in
    e8(b, band(disp8, 255))
  else if reg == 3 then
    let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 72) in
    e8(b, band(disp8, 255))
  else if reg == 4 then
    let _ = e8(b, 76) in let _ = e8(b, 139) in let _ = e8(b, 64) in
    e8(b, band(disp8, 255))
  else
    let _ = e8(b, 76) in let _ = e8(b, 139) in let _ = e8(b, 72) in
    e8(b, band(disp8, 255))
/* mov <argreg idx>, rax  (dispatch to existing mov_*_rax) */
let mov_rax_to_argreg(b, idx) =
  if idx == 0 then mov_rdi_rax(b)
  else if idx == 1 then mov_rsi_rax(b)
  else if idx == 2 then mov_rdx_rax(b)
  else if idx == 3 then mov_rcx_rax(b)
  else if idx == 4 then mov_r8_rax(b)
  else mov_r9_rax(b)

/* mov [rbp+disp8] <- rsi (48 89 75 id8) */
let mov_mem_rbp_rsi(b, d) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 6, 5)) in
  e8(b, band(d, 255))
/* mov [rbp+disp8] <- rdx (48 89 55 id8) */
let mov_mem_rbp_rdx(b, d) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 2, 5)) in
  e8(b, band(d, 255))
/* mov [rbp+disp8] <- rcx (48 89 4d id8) */
let mov_mem_rbp_rcx(b, d) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 1, 5)) in
  e8(b, band(d, 255))

/* mov [rbp+disp8] <- r8  (4c 89 45 id8)  REX.W|REX.R, B=0 */
let mov_mem_rbp_r8(b, d) =
  let _ = e8(b, 76) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 0, 5)) in
  e8(b, band(d, 255))
/* mov [rbp+disp8] <- r9  (4c 89 4d id8) */
let mov_mem_rbp_r9(b, d) =
  let _ = e8(b, 76) in
  let _ = e8(b, 137) in
  let _ = e8(b, modrm(1, 1, 5)) in
  e8(b, band(d, 255))

/* ---- tagged-value ops (int = n<<1; ptr = p|1) ---- */
/* sar rax, 1  (48 d1 f8) — untag an int */
let sar_rax_1(b) =
  let _ = e8(b, 72) in let _ = e8(b, 209) in e8(b, 248)
/* shl rax, 1  (48 d1 e0) — tag an int */
let shl_rax_1(b) =
  let _ = e8(b, 72) in let _ = e8(b, 209) in e8(b, 224)

/* mov [rbp-8], rdx  (48 89 55 f8) */
let mov_mem_rbp8_rdx(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 137) in
  let _ = e8(b, 85) in
  e8(b, 248)
/* mov rax, [rbp-16]  (48 8b 45 f0) */
let mov_rax_mem_rbp16(b) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, 69) in
  e8(b, 240)

/* ---- rbx operand support (for tagged arithmetic) ---- */
/* mov rbx, [rbp+disp8]  (48 8b 5d id8) */
let mov_rbx_mem_rbp(b, d) =
  let _ = e8(b, 72) in
  let _ = e8(b, 139) in
  let _ = e8(b, modrm(1, 3, 5)) in
  e8(b, band(d, 255))
/* sar rbx, 1  (48 d1 fb) */
let sar_rbx_1(b) =
  let _ = e8(b, 72) in let _ = e8(b, 209) in e8(b, 251)
/* sar rdx, 1  (48 d1 fa) */
let sar_rdx_1(b) =
  let _ = e8(b, 72) in let _ = e8(b, 209) in e8(b, 250)
/* sar rdi, 1  (48 d1 ff) */
let sar_rdi_1(b) =
  let _ = e8(b, 72) in let _ = e8(b, 209) in e8(b, 255)
/* and rax, rbx  (48 21 d8) */
let and_rax_rbx(b) =
  let _ = e8(b, 72) in let _ = e8(b, 33) in e8(b, 216)
/* or rax, rbx  (48 09 d8) */
let or_rax_rbx(b) =
  let _ = e8(b, 72) in let _ = e8(b, 9) in e8(b, 216)
/* xor rax, rbx  (48 31 d8) */
let xor_rax_rbx(b) =
  let _ = e8(b, 72) in let _ = e8(b, 49) in e8(b, 216)
/* not rax  (48 f7 d0) */
let not_rax(b) =
  let _ = e8(b, 72) in let _ = e8(b, 247) in e8(b, 208)
/* mov rcx, rbx  (48 89 d9) */
