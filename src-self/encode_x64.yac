/* pop into System V arg register idx */
let pop_argreg(b, idx) =
  if idx == 0 then pop_r64(b, 7)
  else if idx == 1 then pop_r64(b, 6)
  else if idx == 2 then pop_r64(b, 2)
  else if idx == 3 then pop_r64(b, 1)
  else if idx == 4 then
    let _ = e8(b, 65) in pop_r64(b, 0)
  else
    let _ = e8(b, 65) in pop_r64(b, 1)

