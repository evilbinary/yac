/* emit_riscv64.yac — Linux RV64 emit of integer LIR. Other ops: unimp. */

let rv_frame_bytes(nlocals) =
  let nbytes = bshl(nlocals + 1, 3) in
  bshl(bshr(nbytes + 15, 4), 4)

let rv_slot(b, slot, store, r) =
  let off = 0 - bshl(slot + 1, 3) in
  let _ = rv_addi(b, 5, 8, off) in
  if store then rv_sd(b, r, 5, 0) else rv_ld(b, r, 5, 0)

let rv_tag(b, rd) =
  let _ = rv_addi(b, 29, 0, 1) in
  rv_or(b, rd, rd, 29)

let rv_untag_ptr(b, rd) =
  let _ = rv_addi(b, 29, 0, 0 - 2) in
  rv_and(b, rd, rd, 29)

let gen_alloc_rv(_) =
  let b = bytes_new() in
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 1, 2, 8) in
  let _ = rv_addi(b, 28, 10, 0) in
  let headpos = bytes_len(b) in
  let _ = rv_li32_pair(b, 6, 0) in
  let _ = rv_ld(b, 7, 6, 0) in
  let _ = rv_ld(b, 29, 6, 24) in
  let _ = rv_add(b, 5, 29, 28) in
  let _ = rv_sd(b, 5, 6, 24) in
  let _ = rv_sd(b, 7, 29, 0) in
  let _ = rv_sd(b, 29, 6, 0) in
  let _ = rv_addi(b, 10, 29, 0) in
  let _ = rv_ld(b, 1, 2, 8) in
  let _ = rv_addi(b, 2, 2, 16) in
  let _ = rv_jalr(b, 0, 1, 0) in
  [b, headpos]

let rv_apply_jal(b, pos, target, rd) =
  let imm = target - pos in
  let i = band(imm, 2097151) in
  let b20 = band(bshr(i, 20), 1) in
  let b10_1 = band(bshr(i, 1), 1023) in
  let b11 = band(bshr(i, 11), 1) in
  let b19_12 = band(bshr(i, 12), 255) in
  let w = bshl(b20, 31) + bshl(b10_1, 21) + bshl(b11, 20) + bshl(b19_12, 12) +
          bshl(rd, 7) + 111 in
  let _ = bytes_put(b, pos, band(w, 255)) in
  let _ = bytes_put(b, pos + 1, band(bshr(w, 8), 255)) in
  let _ = bytes_put(b, pos + 2, band(bshr(w, 16), 255)) in
  let _ = bytes_put(b, pos + 3, band(bshr(w, 24), 255)) in
  0

let rv_enter(b, n) =
  let _ = rv_addi(b, 2, 2, 0 - 16) in
  let _ = rv_sd(b, 1, 2, 8) in
  let _ = rv_sd(b, 8, 2, 0) in
  let _ = rv_addi(b, 8, 2, 0) in
  rv_addi(b, 2, 2, 0 - n)

let rv_leave(b) =
  let _ = rv_addi(b, 2, 8, 0) in
  let _ = rv_ld(b, 1, 2, 8) in
  let _ = rv_ld(b, 8, 2, 0) in
  let _ = rv_addi(b, 2, 2, 16) in
  rv_jalr(b, 0, 1, 0)

let rv_clamp0(b) =
  let p = bytes_len(b) in
  let _ = rv_bge(b, 10, 0, 0) in
  let _ = rv_addi(b, 10, 0, 0) in
  rv_patch_b(b, p, bytes_len(b))

let gen_read_file_rv(_) =
  let b = bytes_new() in
  let _ = rv_enter(b, 32) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_addi(b, 11, 10, 32) in
  let _ = rv_addi(b, 10, 0, 0 - 100) in
  let _ = rv_addi(b, 12, 0, 0) in
  let _ = rv_addi(b, 13, 0, 0) in
  let _ = rv_addi(b, 17, 0, 56) in
  let _ = rv_ecall(b) in
  let _ = rv_slot(b, 0, true, 10) in
  let _ = rv_addi(b, 11, 0, 0) in
  let _ = rv_addi(b, 12, 0, 2) in
  let _ = rv_addi(b, 17, 0, 62) in
  let _ = rv_ecall(b) in
  let _ = rv_clamp0(b) in
  let _ = rv_slot(b, 2, true, 10) in
  let _ = rv_slot(b, 0, false, 10) in
  let _ = rv_addi(b, 11, 0, 0) in
  let _ = rv_addi(b, 12, 0, 0) in
  let _ = rv_addi(b, 17, 0, 62) in
  let _ = rv_ecall(b) in
  let _ = rv_slot(b, 2, false, 10) in
  let _ = rv_addi(b, 10, 10, 33) in
  let _ = rv_addi(b, 10, 10, 7) in
  let _ = rv_addi(b, 6, 0, 0 - 8) in
  let _ = rv_and(b, 10, 10, 6) in
  let acall = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_slot(b, 1, true, 10) in
  let _ = rv_sd(b, 0, 10, 8) in
  let _ = rv_addi(b, 11, 0, 3) in
  let _ = rv_sd(b, 11, 10, 16) in
  let _ = rv_sd(b, 0, 10, 24) in
  let _ = rv_addi(b, 11, 10, 32) in
  let _ = rv_slot(b, 0, false, 10) in
  let _ = rv_slot(b, 2, false, 12) in
  let _ = rv_addi(b, 17, 0, 63) in
  let _ = rv_ecall(b) in
  let _ = rv_clamp0(b) in
  let _ = rv_addi(b, 12, 10, 0) in
  let _ = rv_slot(b, 1, false, 10) in
  let _ = rv_sd(b, 12, 10, 24) in
  let _ = rv_addi(b, 10, 10, 32) in
  let _ = rv_add(b, 10, 10, 12) in
  let _ = rv_sb(b, 0, 10, 0) in
  let _ = rv_slot(b, 0, false, 10) in
  let _ = rv_addi(b, 17, 0, 57) in
  let _ = rv_ecall(b) in
  let _ = rv_slot(b, 1, false, 10) in
  let _ = rv_tag(b, 10) in
  let _ = rv_leave(b) in
  [b, acall]

let gen_write_file_rv(_) =
  let b = bytes_new() in
  let _ = rv_enter(b, 32) in
  let _ = rv_slot(b, 0, true, 11) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_addi(b, 11, 10, 32) in
  let _ = rv_addi(b, 10, 0, 0 - 100) in
  let _ = rv_li(b, 12, 577) in
  let _ = rv_addi(b, 13, 0, 420) in
  let _ = rv_addi(b, 17, 0, 56) in
  let _ = rv_ecall(b) in
  let _ = rv_slot(b, 1, true, 10) in
  let _ = rv_slot(b, 0, false, 10) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_ld(b, 11, 10, 16) in
  let _ = rv_addi(b, 6, 0, 4) in
  let jne = bytes_len(b) in
  let _ = rv_bne(b, 11, 6, 0) in
  let _ = rv_addi(b, 11, 10, 40) in
  let _ = rv_ld(b, 12, 10, 24) in
  let jdo = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let dostr = bytes_len(b) in
  let _ = rv_addi(b, 11, 10, 32) in
  let _ = rv_ld(b, 12, 10, 24) in
  let dowr = bytes_len(b) in
  let _ = rv_slot(b, 1, false, 10) in
  let _ = rv_addi(b, 17, 0, 64) in
  let _ = rv_ecall(b) in
  let _ = rv_slot(b, 1, false, 10) in
  let _ = rv_addi(b, 17, 0, 57) in
  let _ = rv_ecall(b) in
  let _ = rv_addi(b, 10, 0, 0) in
  let _ = rv_leave(b) in
  let _ = rv_patch_b(b, jne, dostr) in
  let _ = rv_apply_jal(b, jdo, dowr, 0) in
  b

let rv_dyn_loadcap(b) =
  let rec(i) =
    if i >= 6 then 0
    else
      let _ = rv_addi(b, 5, 0, i) in
      let p = bytes_len(b) in
      let _ = rv_bge(b, 5, 7, 0) in
      let _ = rv_ld(b, 10 + i, 28, 32 + bshl(i, 3)) in
      let _ = rv_patch_b(b, p, bytes_len(b)) in
      rec(i + 1) in
  rec(0)

let gen_apply2_rv(_) =
  let b = bytes_new() in
  let _ = rv_enter(b, 32) in
  let _ = rv_slot(b, 0, true, 11) in
  let _ = rv_slot(b, 1, true, 12) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_addi(b, 28, 10, 0) in
  let _ = rv_ld(b, 6, 28, 16) in
  let _ = rv_slot(b, 2, true, 6) in
  let _ = rv_ld(b, 7, 28, 24) in
  let _ = rv_dyn_loadcap(b) in
  let _ = rv_addi(b, 5, 0, 0) in
  let r0 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let _ = rv_addi(b, 5, 0, 1) in
  let r1 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let _ = rv_addi(b, 5, 0, 2) in
  let r2 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let _ = rv_addi(b, 5, 0, 3) in
  let r3 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let _ = rv_addi(b, 5, 0, 4) in
  let r4 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let r5 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let setu(base) =
    let _ = rv_slot(b, 0, false, 28) in
    let _ = rv_slot(b, 1, false, 29) in
    if base == 0 then
      let _ = rv_addi(b, 10, 28, 0) in rv_addi(b, 11, 29, 0)
    else if base == 1 then
      let _ = rv_addi(b, 11, 28, 0) in rv_addi(b, 12, 29, 0)
    else if base == 2 then
      let _ = rv_addi(b, 12, 28, 0) in rv_addi(b, 13, 29, 0)
    else if base == 3 then
      let _ = rv_addi(b, 13, 28, 0) in rv_addi(b, 14, 29, 0)
    else if base == 4 then
      let _ = rv_addi(b, 14, 28, 0) in rv_addi(b, 15, 29, 0)
    else
      let _ = rv_addi(b, 15, 28, 0) in rv_addi(b, 16, 29, 0) in
  let a0 = bytes_len(b) in
  let _ = setu(0) in
  let j0 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let a1 = bytes_len(b) in
  let _ = setu(1) in
  let j1 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let a2 = bytes_len(b) in
  let _ = setu(2) in
  let j2 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let a3 = bytes_len(b) in
  let _ = setu(3) in
  let j3 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let a4 = bytes_len(b) in
  let _ = setu(4) in
  let j4 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let a5 = bytes_len(b) in
  let _ = setu(5) in
  let j5 = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let lc = bytes_len(b) in
  let _ = rv_slot(b, 2, false, 6) in
  let _ = rv_jalr(b, 1, 6, 0) in
  let _ = rv_leave(b) in
  let _ = rv_patch_b(b, r0, a0) in
  let _ = rv_patch_b(b, r1, a1) in
  let _ = rv_patch_b(b, r2, a2) in
  let _ = rv_patch_b(b, r3, a3) in
  let _ = rv_patch_b(b, r4, a4) in
  let _ = rv_apply_jal(b, r5, a5, 0) in
  let _ = rv_apply_jal(b, j0, lc, 0) in
  let _ = rv_apply_jal(b, j1, lc, 0) in
  let _ = rv_apply_jal(b, j2, lc, 0) in
  let _ = rv_apply_jal(b, j3, lc, 0) in
  let _ = rv_apply_jal(b, j4, lc, 0) in
  let _ = rv_apply_jal(b, j5, lc, 0) in
  b

let gen_apply1_rv(_) =
  let b = bytes_new() in
  let _ = rv_enter(b, 32) in
  let _ = rv_slot(b, 0, true, 11) in
  let _ = rv_untag_ptr(b, 10) in
  let _ = rv_addi(b, 28, 10, 0) in
  let _ = rv_ld(b, 6, 28, 16) in
  let _ = rv_slot(b, 1, true, 6) in
  let _ = rv_ld(b, 7, 28, 24) in
  let _ = rv_dyn_loadcap(b) in
  let _ = rv_addi(b, 5, 0, 0) in
  let r0 = bytes_len(b) in
  let _ = rv_beq(b, 7, 5, 0) in
  let _ = rv_addi(b, 5, 0, 1) in
  let r1 = bytes_len(b) in
