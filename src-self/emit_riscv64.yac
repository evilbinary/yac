  let slen = bytes_len(b) in
  let _ = rv_slot(b, 0, false, 13) in
  let _ = rv_add(b, 5, 13, 12) in
  let _ = rv_lbu(b, 11, 5, 0) in
  let jslen = bytes_len(b) in
  let _ = rv_beq(b, 11, 0, 0) in
  let _ = rv_addi(b, 12, 12, 1) in
  let jbslen = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let slend = bytes_len(b) in
  let _ = rv_slot(b, 1, true, 12) in
  let _ = rv_addi(b, 10, 12, 33) in
  let _ = rv_addi(b, 10, 10, 7) in
  let _ = rv_addi(b, 6, 0, 0 - 8) in
  let _ = rv_and(b, 10, 10, 6) in
  let acall = bytes_len(b) in
  let _ = rv_jal(b, 1, 0) in
  let _ = rv_untag_ptr(b, 10) in
