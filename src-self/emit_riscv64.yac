  let _ = rv_jal(b, 0, 0) in
  let _ = rv_patch_b(b, pmiss, bytes_len(b)) in
  let _ = rv_addi(b, 10, 0, 0) in
  let _ = rv_addi(b, 17, 0, 214) in
  let _ = rv_ecall(b) in
  let _ = rv_addi(b, 29, 10, 0) in
  let _ = rv_addi(b, 29, 29, 7) in
  let _ = rv_addi(b, 5, 0, 0 - 8) in
