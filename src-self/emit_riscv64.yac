  let jlt = bytes_len(b) in
  let _ = rv_blt(b, 10, 0, 0) in
  let jlo = bytes_len(b) in
  let _ = rv_bltu(b, 10, 5, 0) in
  let _ = rv_addi(b, 10, 29, 0) in
  let jok = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let mmap = bytes_len(b) in
  let _ = rv_patch_b(b, jz, mmap) in
  let _ = rv_patch_b(b, jlt, mmap) in
  let _ = rv_patch_b(b, jlo, mmap) in
  let _ = rv_addi(b, 11, 28, 8) in
  let _ = rv_addi(b, 10, 0, 0) in
  let _ = rv_addi(b, 12, 0, 3) in
  let _ = rv_addi(b, 13, 0, 34) in
  let _ = rv_addi(b, 14, 0, 0 - 1) in
  let _ = rv_addi(b, 15, 0, 0) in
  let _ = rv_addi(b, 17, 0, 222) in
  let _ = rv_ecall(b) in
  let fresh = bytes_len(b) in
  let imm = fresh - jok in
  let i = band(imm, 2097151) in
  let _ = rv_u32_at(b, jok,
    bshl(band(bshr(i, 20), 1), 31) + bshl(band(bshr(i, 1), 1023), 21) +
    bshl(band(bshr(i, 11), 1), 20) + bshl(band(bshr(i, 12), 255), 12) + 111) in
  let _ = rv_sd(b, 28, 10, 0) in
  let _ = rv_addi(b, 10, 10, 8) in
  let _ = rv_apply_jal(b, plink, bytes_len(b), 0) in
  let _ = rv_ld(b, 6, 2, 0) in
  let _ = rv_ld(b, 7, 6, 0) in
  let _ = rv_sd(b, 7, 10, 0) in
  let _ = rv_sd(b, 10, 6, 0) in
  let _ = rv_ld(b, 1, 2, 24) in
  let _ = rv_addi(b, 2, 2, 32) in
  let _ = rv_jalr(b, 0, 1, 0) in
