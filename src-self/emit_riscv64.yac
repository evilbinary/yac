  let _ = rv_sd(b, 11, 6, 0) in
  let pgot = bytes_len(b) in
  let _ = rv_jal(b, 0, 0) in
  let _ = rv_patch_b(b, pnf, bytes_len(b)) in
  let _ = rv_sd(b, 11, 7, 0) in
