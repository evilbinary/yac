/* driver_elf.yac — test the ELF packer with a hardcoded exit(42) program.
 * Builds the code bytes, packs an ELF, writes build/elf_tmp/out, and prints
 * the file length. Used by tests/boot/run.yac.
 */
/* exit(42): mov rax,60; mov rdi,42; syscall */
let code = bytes_new()
let _ = bytes_append(code, 72)   /* 48 */
let _ = bytes_append(code, 199)  /* c7 */
let _ = bytes_append(code, 192)  /* c0 */
let _ = bytes_append(code, 60)   /* mov rax, 60 */
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 72)   /* 48 */
let _ = bytes_append(code, 199)  /* c7 */
let _ = bytes_append(code, 199)  /* c7 */
let _ = bytes_append(code, 42)   /* mov rdi, 42 */
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 0)
let _ = bytes_append(code, 15)   /* 0f */
let _ = bytes_append(code, 5)    /* 05 syscall */
let elf = pack_elf(code)
let _ = write_file("build/test_tmp/elf.bin", elf)
print bytes_len(elf)
print ""
0
