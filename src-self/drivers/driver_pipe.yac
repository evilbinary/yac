import rt.os
import back.emit.emit {cimport_got, cimport_names}
import back.lower {lower_expr}
import back.pack.elf {pack_elf}
import back.pack.pe {pack_pe_target, pe_finish_imports}
import back.pack.target {mk_target, target_format}
import front.anf {anf_expr}
import front.lexer {tokenize}
import front.lir {env_new, lir_expr, sigma_list, sigma_new, st_no, start_proc, tco_prog}
import front.parser {parse_program}

/* driver_pipe.yac — source → ANF → LIR dump, then emit+pack host image.
 * Reads build/test_tmp/pipein.yac, writes build/test_tmp/pipe.bin.
 */
let pack_host(t, code) =
  if target_format(t) == "pe" then
    let img = pack_pe_target(t, code) in
    let _ = pe_finish_imports(img, t, cimport_names(0), cimport_got(0)) in
    img
  else pack_elf(code)

let src = read_file("build/test_tmp/pipein.yac")
let toks = tokenize(src)
let ast = nth(parse_program(toks, 0, []), 0)
let ar = anf_expr(ast, 0)
let anf = [nth(ar, 0), nth(ar, 1)]
let _ = print(anf)
let out = lir_expr(anf, st_no([list_new(), env_new(0), 1, sigma_new(0), 0]))
let insns = nth(out, 0)
let _ = print(insns)
let proc = start_proc(nth(out, 3), nth(out, 1), insns)
let funs = reverse(sigma_list(nth(out, 4)))
let rt0 = runtime_funs(0)
let lir = tco_prog(["prog", cons(proc, append(rt0, funs)), "_start"])
let t = mk_target("x86_64", host_format(0), "exec")
let er = lower_expr(lir, t)
let _ = write_file("build/test_tmp/pipe.bin", pack_host(t, nth(er, 0)))
0
