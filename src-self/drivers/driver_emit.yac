import back.emit.emit {cimport_got, cimport_names}
import back.lower {lower_expr}
import back.pack.elf {pack_elf}
import back.pack.pe {pack_pe_target, pe_finish_imports}
import back.pack.target {mk_target, target_format}
import front.lexer {tokenize}
import front.parser {parse_program}
import rt.os {host_format}

/* driver_emit.yac — read a LIR list from emitin.yac, emit+pack host image.
 * Used by tests/boot/run.yac (native emit_run, compiled once).
 * pack_*(lower_expr(...)) — no backend.yac (avoids runtime_funs / pack_image).
 * Walk the parse AST with direct recursion (not map/apply).
 */
let str_to_int(s) =
  let n = str_len(s) in
  let isneg = if n > 0 then str_ref(s, 0) == 45 else false in
  let start = if isneg then 1 else 0 in
  let acc(i, v) =
    if i >= n then v
    else acc(i + 1, v * 10 + (str_ref(s, i) - 48)) in
  let v = acc(start, 0) in
  if isneg then 0 - v else v

let ast_to_val(e) =
  let k = nth(e, 0) in
  if k == "int" then str_to_int(nth(e, 1))
  else if k == "str" then nth(e, 1)
  else if k == "list" then
    let xs = nth(e, 1) in
    let n = len(xs) in
    let rec(i, acc) =
      if i >= n then list_rev(acc)
      else rec(i + 1, cons(ast_to_val(nth(xs, i)), acc)) in
    rec(0, [])
  else e

let pack_host(t, code) =
  if target_format(t) == "pe" then
    let img = pack_pe_target(t, code) in
    let _ = pe_finish_imports(img, t, cimport_names(0), cimport_got(0)) in
    img
  else pack_elf(code)

let src = read_file("build/test_tmp/emitin.yac")
let toks = tokenize(src)
let ast = nth(parse_program(toks, 0, []), 0)
let prog = ast_to_val(ast)
let t = mk_target("x86_64", host_format(0), "exec")
let img = pack_host(t, nth(lower_expr(prog, t), 0))
let _ = write_file("build/test_tmp/emit.bin", img)
0
