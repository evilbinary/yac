/* emit.yac — shared emit helpers (all arches).
 *
 * Arch backends: emit_x86_64.yac, emit_arm64.yac, emit_riscv64.yac
 * LIR in, code bytes out; pack is a separate pass.
 *
 * Helpers: byte append, abs32/u64 patches, x86 rel32 patch, name maps,
 * patch-list extend. Instruction emit stays in emit_<arch>.yac.
 */

let reverse(xs) = list_rev(xs)

let b_append(dst, src) =
  let _ = bytes_extend(dst, src) in
  dst

let apply_patch(b, bytePos, target) =
  let rel = target - (bytePos + 4) in
  let _ = bytes_put(b, bytePos + 0, band(rel, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(rel, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(rel, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(rel, 24), 255)) in
  0

/* write a 32-bit absolute value at bytePos (for closure fnptr fields) */
let apply_abs32(b, bytePos, val) =
  let _ = bytes_put(b, bytePos + 0, band(val, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(val, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(val, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(val, 24), 255)) in
  0

/* write a 64-bit little-endian value at bytePos (for GC global addresses) */
let apply_u64(b, bytePos, val) =
  let _ = apply_abs32(b, bytePos, band(val, 4294967295)) in
  let _ = apply_abs32(b, bytePos + 4, band(bshr(val, 32), 4294967295)) in
  0

let lookup_name(table, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(table)

/* Top-level loops so hash/get are TCO calls, not nested apply. */
let emit_hash_loop(s, n, i, h) =
  if i >= n then h
  else emit_hash_loop(s, n, i + 1, (h * 31 + str_ref(s, i)) % 256)

let emit_hash(s) = emit_hash_loop(s, str_len(s), 0, 0)

let emit_map_fill(b, i) =
  if i >= 256 then b
  else
    let _ = list_push(b, list_new()) in
    emit_map_fill(b, i + 1)

let emit_map_new(_) = emit_map_fill(list_new(), 0)

let emit_map_put(m, k, v) =
  let bucket = nth(m, emit_hash(k)) in
  let _ = list_push(bucket, [k, v]) in
  0

let emit_map_scan(bucket, k, i, n) =
  if i >= n then 0
  else if nth(nth(bucket, i), 0) == k then nth(nth(bucket, i), 1)
  else emit_map_scan(bucket, k, i + 1, n)

let emit_map_get(m, k) =
  let bucket = nth(m, emit_hash(k)) in
  emit_map_scan(bucket, k, 0, len(bucket))

let emit_map_from_at(m, xs, i, n) =
  if i >= n then m
  else
    let e = nth(xs, i) in
    let _ = emit_map_put(m, nth(e, 0), nth(e, 1)) in
    emit_map_from_at(m, xs, i + 1, n)

let emit_map_from_list(xs) = emit_map_from_at(emit_map_new(0), xs, 0, len(xs))

let label_has(labels, name) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(nth(l, 0), 0) == name then true
    else rec(drop(l, 1)) in
  rec(labels)

let patches_extend(dst, src) =
  let n = len(src) in
  let loop(i) =
    if i >= n then dst
    else let _ = list_push(dst, nth(src, i)) in loop(i + 1) in
  loop(0)

/* Top-level so ncap=0 and self-call is TCO. Nested resolve(i) in emit_program_at
 * overflows the C stack once nth is O(1) and we actually walk every patch. */
let emit_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let fmap = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let kind = nth(p, 0) in
  /* Call-site patches are [pos, name] with an int pos — skip string kinds. */
  if kind == "closurefn" then
    apply_abs32(b, nth(p, 1), codebase + emit_map_get(fmap, nth(p, 2)))
  else if kind == "gc_head" then
    apply_u64(b, nth(p, 1), globbase)
  else if kind == "saved_argc" then
    apply_u64(b, nth(p, 1), globbase + 8)
  else if kind == "saved_argv" then
    apply_u64(b, nth(p, 1), globbase + 16)
  else if kind == "stack_hi" then
    apply_u64(b, nth(p, 1), globbase + 24)
  else if kind == "prof_st" then
    apply_u64(b, nth(p, 1), globbase + 56)
  else if kind == "prof_busy" then
    apply_u64(b, nth(p, 1), globbase + 64)
  else
    apply_patch(b, kind, emit_map_get(fmap, nth(p, 1)))

let emit_resolve_loop(st, ps, i) =
  if i >= len(ps) then 0
  else
    let _ = emit_resolve_patch(st, nth(ps, i)) in
    emit_resolve_loop(st, ps, i + 1)
