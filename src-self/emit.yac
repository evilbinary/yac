/* emit.yac — shared emit helpers (all arches).
 *
 * Arch backends: emit_x86_64.yac, emit_arm64.yac, emit_riscv64.yac
 * LIR in, code bytes out; pack is a separate pass.
 *
 * Helpers: byte append, abs32/u64 patches, x86 rel32 patch, name maps,
 * patch-list extend. Instruction emit stays in emit_<arch>.yac.
 */

let reverse(xs) = list_rev(xs)

/* DESIGN arith tags. */
let is_arith(k) =
  if k == "add" then true
  else if k == "sub" then true
  else if k == "mul" then true
  else if k == "div" then true
  else if k == "rem" then true
  else if k == "sar" then true
  else if k == "shr" then true
  else if k == "sal" then true
  else if k == "shl" then true
  else if k == "land" then true
  else if k == "lor" then true
  else if k == "xor" then true
  else false

/* icall/ticall have no ncap field; apply/tailapply do. */
let apply_ncap(insn) =
  if nth(insn, 0) == "icall" then 0 - 1
  else if nth(insn, 0) == "ticall" then 0 - 1
  else nth(insn, 3)

let apply_args(insn) =
  if nth(insn, 0) == "icall" then nth(insn, 3)
  else if nth(insn, 0) == "ticall" then nth(insn, 3)
  else nth(insn, 4)

let b_append(dst, src) =
  let _ = bytes_extend(dst, src) in
  dst

let apply_i32(b, bytePos, val) =
  let _ = bytes_put(b, bytePos + 0, band(val, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(val, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(val, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(val, 24), 255)) in
  0

let apply_patch(b, bytePos, target) =
  apply_i32(b, bytePos, target - (bytePos + 4))

/* write a 32-bit absolute value at bytePos (for closure fnptr fields) */
let apply_abs32(b, bytePos, val) = apply_i32(b, bytePos, val)

/* write a 64-bit little-endian value at bytePos (for GC global addresses) */
let apply_u64(b, bytePos, val) =
  let _ = apply_abs32(b, bytePos, band(val, 4294967295)) in
  let _ = apply_abs32(b, bytePos + 4, band(bshr(val, 32), 4294967295)) in
  0

/* Local labels: cons list of [name, pos]. */
let lookup_name_at(table, name, i) =
  if i < 0 then 0
  else if nth(nth(table, i), 0) == name then nth(nth(table, i), 1)
  else lookup_name_at(table, name, i - 1)

let lookup_name(table, name) = lookup_name_at(table, name, len(table) - 1)

let label_has_at(labels, name, i) =
  if i < 0 then false
  else if nth(nth(labels, i), 0) == name then true
  else label_has_at(labels, name, i - 1)

let label_has(labels, name) = label_has_at(labels, name, len(labels) - 1)

let label_put(labels, name, pos) = cons([name, pos], labels)

let emit_map_new(_) = fmap_new(0)
let emit_map_get(m, k) = fmap_get(m, k)
let emit_map_put(m, k, v) =
  let _ = fmap_put(m, k, v) in
  m

/* Fun id table: prog funs, then helpers last so helper names stay reserved.
 * Duplicate fun names: last-put-wins (runtime prof_* stubs lose to profile.yac).
 * Helper ids are nfun+0..nfun+6 matching offs listbuf after emit_fun. */
let emit_ids_helpers(ids, nfun) =
  let _ = emit_map_put(ids, "yac_apply1", nfun) in
  let _ = emit_map_put(ids, "yac_apply2", nfun + 1) in
  let _ = emit_map_put(ids, "yac_write_file", nfun + 2) in
  let _ = emit_map_put(ids, "yac_read_file", nfun + 3) in
  let _ = emit_map_put(ids, "yac_alloc", nfun + 4) in
  let _ = emit_map_put(ids, "yac_gc", nfun + 5) in
  let _ = emit_map_put(ids, "yac_argv", nfun + 6) in
  ids

let emit_ids_bind(ids, funs, i, n) =
  if i >= n then ids
  else
    let f = nth(funs, i) in
    let _ =
      if len(nth(f, 4)) == 0 then 0
      else emit_map_put(ids, nth(f, 1), i) in
    emit_ids_bind(ids, funs, i + 1, n)

let emit_ids_new(funs) =
  let nfun = len(funs) in
  let ids = fmap_new(0) in
  let _ = fmap_init_n(ids, 4096) in
  emit_ids_helpers(emit_ids_bind(ids, funs, 0, nfun), nfun)

/* Patch tags: 1=call to fun id (x86 rel32 / a64 bl / rv jal ra),
 * 2=closure fnptr, 3+=globals, 9=tail jmp to fun id (a64 b26 / rv jal).
 * Local labels stay string kinds (b26/beq/jal) or [pos, name] on x86. */
let emit_patch_rel(ids, ps, pos, name) =
  cons([1, pos, emit_map_get(ids, name)], ps)

let emit_patch_clos(ids, ps, pos, name) =
  cons([2, pos, emit_map_get(ids, name)], ps)

let emit_patch_jmpf(ids, ps, pos, name) =
  cons([9, pos, emit_map_get(ids, name)], ps)

let emit_st4(st, b, cur, labels, ps) =
  [b, cur, labels, ps, nth(st, 4)]

let patches_extend(dst, src) =
  let n = len(src) in
  let loop(i) =
    if i >= n then dst
    else let _ = list_push(dst, nth(src, i)) in loop(i + 1) in
  loop(0)

/* Top-level so ncap=0 and self-call is TCO. Nested resolve(i) in emit_program_x86_64
 * overflows the C stack once nth is O(1) and we actually walk every patch. */
let emit_resolve_patch(st, p) =
  let b = nth(st, 0) in
  let offs = nth(st, 1) in
  let codebase = nth(st, 2) in
  let globbase = nth(st, 3) in
  let tag = nth(p, 0) in
  if tag == 1 then
    apply_patch(b, nth(p, 1), nth(offs, nth(p, 2)))
  else if tag == 2 then
    apply_abs32(b, nth(p, 1), codebase + nth(offs, nth(p, 2)))
  else if tag == 3 then
    apply_u64(b, nth(p, 1), globbase)
  else if tag == 4 then
    apply_u64(b, nth(p, 1), globbase + 8)
  else if tag == 5 then
    apply_u64(b, nth(p, 1), globbase + 16)
  else if tag == 6 then
    apply_u64(b, nth(p, 1), globbase + 24)
  else if tag == 7 then
    apply_u64(b, nth(p, 1), globbase + 56)
  else if tag == 8 then
    apply_u64(b, nth(p, 1), globbase + 64)
  else
    0

let emit_resolve_loop(st, ps, i, n) =
  if i >= n then 0
  else
    let _ = emit_resolve_patch(st, nth(ps, i)) in
    emit_resolve_loop(st, ps, i + 1, n)
