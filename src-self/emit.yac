  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, selfcall + 1, a1call + 1, acall + 1]

/* yac_int_to_str(n tagged rdi) -> STR. Non-negative only. Returns [bytes, allocRel]. */
let gen_int_to_str(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 64) in
  let _ = mov_rax_rdi(b) in
  let _ = sar_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 248, 0) in
  let _ = mov_rdi_imm(b, 48) in
  let acall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = and_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 240, 0) in
  let _ = mov_rax_disp8_imm32(b, 8, 0) in
  let _ = mov_rax_disp8_imm32(b, 16, 3) in
  let _ = mov_rax_disp8_imm32(b, 20, 0) in
  let _ = mov_r64_mem_rbp(b, 0, 248) in
  let _ = cmp_rax_imm8(b, 0) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz0 = bytes_len(b) - 4 in
  /* ndigits=0 at [rbp-40]=216 */
  let _ = xor_rax_rax(b) in
  let _ = mov_mem_rbp_r64(b, 216, 0) in
  let dloop = bytes_len(b) in
  let _ = mov_r64_mem_rbp(b, 0, 248) in
  let _ = cmp_rax_imm8(b, 0) in
  let _ = jcc_rel32(b, 4, 0) in
  let jzd = bytes_len(b) - 4 in
  let _ = mov_rcx_imm(b, 10) in
  let _ = cqo(b) in
  let _ = idiv_rcx(b) in
  /* quot in rax, rem in rdx; save quot */
  let _ = mov_mem_rbp_r64(b, 248, 0) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 208) in
  let _ = add_rax_imm8(b, 48) in
  let _ = mov_r64_mem_rbp(b, 3, 216) in
  /* store digit at [rbp-48+ndigits] = rbp+208+ndigits: 88 44 1d d0 */
  let _ = e8(b, 136) in let _ = e8(b, 68) in let _ = e8(b, 29) in let _ = e8(b, 208) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 195) in
  let _ = mov_mem_rbp_r64(b, 216, 3) in
  let _ = jmp_rel32(b, 0) in
  let jbd = bytes_len(b) - 4 in
  let _ = apply_patch(b, jbd, dloop) in
  let digdone = bytes_len(b) in
  let _ = apply_patch(b, jzd, digdone) in
  /* reverse-copy into obj */
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rdi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 2, 216) in
  let cloop = bytes_len(b) in
  let _ = test_rdx_rdx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let jzc = bytes_len(b) - 4 in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 202) in
  let _ = e8(b, 138) in let _ = e8(b, 68) in let _ = e8(b, 21) in let _ = e8(b, 208) in
  let _ = e8(b, 136) in let _ = e8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 199) in
  let _ = jmp_rel32(b, 0) in
  let jbc = bytes_len(b) - 4 in
  let _ = apply_patch(b, jbc, cloop) in
  let cdone = bytes_len(b) in
  let _ = apply_patch(b, jzc, cdone) in
  let _ = e8(b, 198) in let _ = e8(b, 7) in let _ = e8(b, 0) in
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = mov_r64_mem_rbp(b, 3, 216) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 88) in let _ = e8(b, 24) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  let zpath = bytes_len(b) in
  let _ = apply_patch(b, jz0, zpath) in
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = mov_rax_disp8_imm32(b, 24, 1) in
  let _ = mov_rax_disp8_imm8(b, 32, 48) in
  let _ = mov_rax_disp8_imm8(b, 33, 0) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, acall + 1]

/* yac_str_slice(s rdi, start tagged rsi, len tagged rdx) -> STR */
let gen_str_slice(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 48) in
  let _ = mov_mem_rbp_rdi(b, 248) in
  let _ = mov_rax_rsi(b) in
  let _ = sar_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 240, 0) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 208) in
  let _ = sar_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  let _ = add_rax_imm32(b, 33) in
  let _ = e8(b, 72) in let _ = e8(b, 131) in let _ = e8(b, 192) in let _ = e8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 131) in let _ = e8(b, 224) in let _ = e8(b, 248) in
  let _ = mov_rdi_rax(b) in
  let acall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = and_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 224, 0) in
  let _ = mov_rax_disp8_imm32(b, 8, 0) in
  let _ = mov_rax_disp8_imm32(b, 16, 3) in
  let _ = mov_rax_disp8_imm32(b, 20, 0) in
  let _ = mov_r64_mem_rbp(b, 3, 232) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 88) in let _ = e8(b, 24) in
  let _ = mov_r64_mem_rbp(b, 0, 248) in
  let _ = and_rax_1(b) in
  let _ = add_rax_imm32(b, 32) in
  let _ = e8(b, 72) in let _ = e8(b, 3) in let _ = e8(b, 69) in let _ = e8(b, 240) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 0, 224) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rdi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 2, 232) in
  let loop = bytes_len(b) in
  let _ = test_rdx_rdx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz = bytes_len(b) - 4 in
  let _ = e8(b, 138) in let _ = e8(b, 6) in
  let _ = e8(b, 136) in let _ = e8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 198) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 199) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 202) in
  let _ = jmp_rel32(b, 0) in
  let jb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jb, loop) in
  let done = bytes_len(b) in
  let _ = apply_patch(b, jz, done) in
  let _ = e8(b, 198) in let _ = e8(b, 7) in let _ = e8(b, 0) in
  let _ = mov_r64_mem_rbp(b, 0, 224) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, acall + 1]

/* yac_bytes_to_str(bytes rdi) -> STR */
let gen_bytes_to_str(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 32) in
  let _ = mov_mem_rbp_rdi(b, 248) in
  let _ = mov_rax_rdi(b) in
  let _ = and_rax_1(b) in
  let _ = mov_rax_rax_disp8(b, 24) in
  let _ = mov_mem_rbp_r64(b, 240, 0) in
  let _ = add_rax_imm32(b, 33) in
  let _ = e8(b, 72) in let _ = e8(b, 131) in let _ = e8(b, 192) in let _ = e8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 131) in let _ = e8(b, 224) in let _ = e8(b, 248) in
  let _ = mov_rdi_rax(b) in
  let acall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = and_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  let _ = mov_rax_disp8_imm32(b, 8, 0) in
  let _ = mov_rax_disp8_imm32(b, 16, 3) in
  let _ = mov_rax_disp8_imm32(b, 20, 0) in
  let _ = mov_r64_mem_rbp(b, 3, 240) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 88) in let _ = e8(b, 24) in
  let _ = mov_r64_mem_rbp(b, 0, 248) in
  let _ = and_rax_1(b) in
  let _ = add_rax_imm32(b, 40) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rdi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 2, 240) in
  let loop = bytes_len(b) in
  let _ = test_rdx_rdx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz = bytes_len(b) - 4 in
  let _ = e8(b, 138) in let _ = e8(b, 6) in
  let _ = e8(b, 136) in let _ = e8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 198) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 199) in
  let _ = e8(b, 72) in let _ = e8(b, 255) in let _ = e8(b, 202) in
  let _ = jmp_rel32(b, 0) in
  let jb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jb, loop) in
  let done = bytes_len(b) in
  let _ = apply_patch(b, jz, done) in
  let _ = e8(b, 198) in let _ = e8(b, 7) in let _ = e8(b, 0) in
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, acall + 1]

/* emit one instruction; st = [bytes, cur, labelsRev, patchesRev]. */
let emit_insn(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  let len0 = bytes_len(b) in
  let done =
    if k == "prologue" then
      let nlocals = nth(insn, 1) in
      let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
      /* imm8 for sub/add rsp is signed (-128..127); frames >= 128 need imm32 */
      if is_entry then
        let _ = mov_rbp_rsp(b) in
        let nbytes = bshl(nlocals, 3) in
        let _ =
          if nbytes > 127 then sub_rsp_imm32(b, nbytes)
          else sub_rsp_imm8(b, band(nbytes, 255)) in
        [b, cur, labels, patches]
      else
        let _ = push_rbp(b) in
        let _ = mov_rbp_rsp(b) in
        let nbytes = bshl(nlocals, 3) in
        let _ =
          if nbytes > 127 then sub_rsp_imm32(b, nbytes)
          else sub_rsp_imm8(b, band(nbytes, 255)) in
        let storeparams(j) =
          if j >= nparams then 0
          else if j < 6 then
            let _ = emit_store_param(b, j, j + 1) in
            storeparams(j + 1)
          else
            /* stack arg: [rbp + 16 + 8*(j-6)] */
            let off = 16 + bshl(j - 6, 3) in
            let _ = mov_r64_mem_rbp32(b, 0, off) in
            let _ = emit_store_rax_slot(b, j + 1) in
            storeparams(j + 1) in
        let _ = storeparams(0) in
        [b, cur, labels, patches]
    else if k == "mov_imm" then
      /* tag: store n<<1 */
      let _ = mov_r64_imm(b, 0, nth(insn, 2)) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "mov" then
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "binop" then
      /* untag both operands, compute, retag */
      let op = nth(insn, 1) in
      let dst = nth(insn, 2) in
      let a = nth(insn, 3) in
      let bop = nth(insn, 4) in
      let _ = emit_load_rax_slot(b, a) in
      let _ = sar_rax_1(b) in
      let _ = emit_load_rbx_slot(b, bop) in
      let _ = sar_rbx_1(b) in
      let c =
        if op == "+" then add_rax_rbx(b)
        else if op == "-" then sub_rax_rbx(b)
        else if op == "*" then imul_rax_rbx(b)
        else if op == "&" then and_rax_rbx(b)
        else if op == "|" then or_rax_rbx(b)
        else if op == "<<" then
          let _ = mov_rcx_rbx(b) in
          shl_rax_cl(b)
        else if op == ">>" then
          let _ = mov_rcx_rbx(b) in
          shr_rax_cl(b)
        else if op == "and" then and_rax_rbx(b)
        else if op == "or" then or_rax_rbx(b)
        else if op == "/" then
          let _ = cqo(b) in
          idiv_rbx(b)
        else if op == "%" then
          let _ = cqo(b) in
          let _ = idiv_rbx(b) in
          mov_r64_r64(b, 0, 2)
        else 0 in
      let _ = c in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "cmp" then
      let op = nth(insn, 1) in
      let dst = nth(insn, 2) in
      let a = nth(insn, 3) in
      let bop = nth(insn, 4) in
      if (op == "==" or op == "!=") then
        let _ = emit_load_rax_slot(b, a) in
        let _ = push_r64(b, 0) in
        let _ = emit_load_rax_slot(b, bop) in
        let _ = push_r64(b, 0) in
        /* stack: [rsp]=b [rsp+8]=a */
        let _ = mov_rax_mem_rsp8(b) in
        let _ = test_rax_1(b) in
        let _ = jcc_rel32(b, 4, 0) in
        let jz1 = bytes_len(b) - 4 in
        let _ = mov_rax_mem_rsp(b) in
        let _ = test_rax_1(b) in
        let _ = jcc_rel32(b, 4, 0) in
        let jz2 = bytes_len(b) - 4 in
        let _ = mov_rax_mem_rsp8(b) in
        let _ = and_rax_1(b) in
        let _ = mov_rax_rax_disp8(b, 16) in
        let _ = cmp_rax_imm8(b, 3) in
        let _ = jcc_rel32(b, 5, 0) in
        let jne1 = bytes_len(b) - 4 in
        let _ = mov_rax_mem_rsp(b) in
        let _ = and_rax_1(b) in
        let _ = mov_rax_rax_disp8(b, 16) in
        let _ = cmp_rax_imm8(b, 3) in
        let _ = jcc_rel32(b, 5, 0) in
        let jne2 = bytes_len(b) - 4 in
        let _ = mov_rax_mem_rsp8(b) in
        let _ = mov_rdi_rax(b) in
        let _ = mov_rax_mem_rsp(b) in
        let _ = mov_rsi_rax(b) in
        let scall = bytes_len(b) in
        let _ = call_rel32(b, 0) in
        let _ = add_rsp_imm8(b, 16) in
        let _ =
          if op == "!=" then
            let _ = sar_rax_1(b) in
            let _ = e8(b, 72) in let _ = e8(b, 247) in let _ = e8(b, 208) in
            let _ = e8(b, 36) in let _ = e8(b, 1) in
            shl_rax_1(b)
          else 0 in
        let _ = jmp_rel32(b, 0) in
        let jdone = bytes_len(b) - 4 in
        let intp = bytes_len(b) in
        let _ = apply_patch(b, jz1, intp) in
        let _ = apply_patch(b, jz2, intp) in
        let _ = apply_patch(b, jne1, intp) in
        let _ = apply_patch(b, jne2, intp) in
        let _ = mov_rax_mem_rsp8(b) in
        let _ = sar_rax_1(b) in
        let _ = mov_rbx_mem_rsp(b) in
        let _ = sar_rbx_1(b) in
        let _ = cmp_rax_rbx(b) in
        let _ = setcc_r8(b, cc_of(op)) in
        let _ = movzx_eax_al(b) in
        let _ = shl_rax_1(b) in
        let _ = add_rsp_imm8(b, 16) in
        let done = bytes_len(b) in
        let _ = apply_patch(b, jdone, done) in
        let _ = emit_store_rax_slot(b, dst) in
        [b, cur, labels, cons([scall + 1, "yac_str_eq"], patches)]
      else
        let _ = emit_load_rax_slot(b, a) in
        let _ = sar_rax_1(b) in
        let _ = emit_load_rbx_slot(b, bop) in
        let _ = sar_rbx_1(b) in
        let _ = cmp_rax_rbx(b) in
        let _ = setcc_r8(b, cc_of(op)) in
        let _ = movzx_eax_al(b) in
        let _ = shl_rax_1(b) in
        let _ = emit_store_rax_slot(b, dst) in
        [b, cur, labels, patches]
    else if k == "label" then
      let nm = nth(insn, 1) in
      [b, cur, cons([nm, cur], labels), patches]
    else if k == "call" then
      /* call fn(argSlots...): load args to rdi,rsi,rdx,rcx,r8,r9; call; store. */
      let dst = nth(insn, 1) in
      let fn = nth(insn, 2) in
      let args = nth(insn, 3) in
      let nargs = len(args) in
      let loadarg(j) =
        if j >= nargs then 0
        else
          let _ = emit_load_rax_slot(b, nth(args, j)) in
          let _ =
            if j == 0 then mov_rdi_rax(b)
            else if j == 1 then mov_rsi_rax(b)
            else if j == 2 then mov_rdx_rax(b)
            else if j == 3 then mov_rcx_rax(b)
            else if j == 4 then mov_r8_rax(b)
            else mov_r9_rax(b) in
          loadarg(j + 1) in
      let _ = loadarg(0) in
      let callstart = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([callstart + 1, fn], patches)]
    else if k == "jmp" then
      /* jmp_rel32: e9 + rel32; rel32 field at len0+1 */
      let _ = jmp_rel32(b, 0) in
      [b, cur, labels, cons([len0 + 1, nth(insn, 1)], patches)]
    else if k == "br" then
      let cond = nth(insn, 1) in
      let tl = nth(insn, 2) in
      let fl = nth(insn, 3) in
      let _ = emit_load_rax_slot(b, cond) in
      let _ = test_rax_rax(b) in
      let jcc_at = bytes_len(b) in
      let _ = jcc_rel32(b, 4, 0) in  /* 0f 84 + rel32 */
      let jmp_at = bytes_len(b) in
      let _ = jmp_rel32(b, 0) in     /* e9 + rel32 */
      [b, cur, labels,
       cons([jcc_at + 2, fl], cons([jmp_at + 1, tl], patches))]
    else if k == "ret" then
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      if is_entry then let _ = ret(b) in [b, cur, labels, patches]
      else
        let _ = mov_rsp_rbp(b) in
        let _ = pop_rbp(b) in
        let _ = ret(b) in
        [b, cur, labels, patches]
    else if k == "exit" then
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      let _ = sar_rax_1(b) in   /* untag */
      let _ = mov_rdi_rax(b) in
      let _ = mov_r64_imm(b, 0, 60) in
      let _ = syscall(b) in
      [b, cur, labels, patches]
    else if k == "print" then
      /* print slot: load -> untag -> rdi; call print_int; write newline */
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      let _ = sar_rax_1(b) in
      let _ = mov_rdi_rax(b) in
      let callstart = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_newline(b) in
      [b, cur, labels, cons([callstart + 1, "print_int"], patches)]
    else if k == "closure" then
      /* closure dst fnName [capSlots]:
       * alloc object [next][mark][fnptr][nenv][env...], tag, store.
       * yac_alloc links the object into the global GC list (sets [next]).
       * Offsets: next=0 mark=8 fnptr=16 nenv=24 env=32. */
      let dst = nth(insn, 1) in
      let fnName = nth(insn, 2) in
      let caps = nth(insn, 3) in
      let nenv = len(caps) in
      let size = (4 + nenv) * 8 in
      let _ = mov_rdi_imm(b, size) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in    /* alloc returns raw ptr; ensure untagged */
      let _ = mov_rax_disp8_imm32(b, 8, 0) in   /* mark = 0 */
      let _ = mov_rax_disp8_imm32(b, 16, 0) in  /* fnptr placeholder */
      let fnpos = bytes_len(b) - 4 in
      let _ = mov_rax_disp8_imm32(b, 24, nenv) in
      let _ = mov_rax_disp8_imm32(b, 28, 0) in  /* clear high dword of nenv qword */
      let storecap(i) =
        if i >= nenv then 0
        else
          let _ = emit_load_rdi_slot(b, nth(caps, i)) in
          let _ = mov_rax_disp8_rdi(b, 32 + i * 8) in
          storecap(i + 1) in
      let _ = storecap(0) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels,
       cons([acall + 1, "yac_alloc"],
            cons(["closurefn", fnpos, fnName], patches))]
    else if k == "apply" then
      /* apply dst closSlot ncap [argSlots]:
       * ncap >= 0: load that many caps (compile-time).
       * ncap < 0: read nenv from the object at runtime (jump table). */
      let dst = nth(insn, 1) in
      let clos = nth(insn, 2) in
      let ncap = nth(insn, 3) in
      let args = nth(insn, 4) in
      let nargs = len(args) in
      if ncap >= 0 then
        let ntot = ncap + nargs in
        let nstack = if ntot > 6 then ntot - 6 else 0 in
        /* push stack args (indices ntot-1 .. 6), reloading clos as needed */
        let push_flat(i) =
          if i < 6 then 0
          else
            let _ =
              if i < ncap then
                let _ = emit_load_rax_slot(b, clos) in
                let _ = and_rax_1(b) in
                let _ = mov_rax_rax_disp8(b, 32 + i * 8) in
                push_r64(b, 0)
              else
                let _ = emit_load_rax_slot(b, nth(args, i - ncap)) in
                push_r64(b, 0) in
            push_flat(i - 1) in
        let _ = push_flat(ntot - 1) in
        let _ = emit_load_rax_slot(b, clos) in
        let _ = and_rax_1(b) in
        let _ = mov_rbx_rax_disp8(b, 16) in
        let _ = push_r64(b, 3) in
        let nreg = if ntot < 6 then ntot else 6 in
        let load_reg(i) =
          if i >= nreg then 0
          else if i < ncap then
            let _ = emit_load_rax_slot(b, clos) in
            let _ = and_rax_1(b) in
            let _ = mov_argreg_rax_disp8(b, i, 32 + i * 8) in
            load_reg(i + 1)
          else
            let _ = emit_load_rax_slot(b, nth(args, i - ncap)) in
            let _ = mov_rax_to_argreg(b, i) in
            load_reg(i + 1) in
        let _ = load_reg(0) in
        let _ = pop_r64(b, 3) in
        let _ = call_rbx(b) in
        let _ =
          if nstack == 0 then 0
          else if bshl(nstack, 3) > 127 then add_rsp_imm32(b, bshl(nstack, 3))
          else add_rsp_imm8(b, bshl(nstack, 3)) in
        let _ = emit_store_rax_slot(b, dst) in
        [b, cur, labels, patches]
      else
        /* dynamic nenv: build jump table and patch local labels immediately */
        let nargs = len(args) in
        let pushargs(j) =
          if j < 0 then 0
          else
            let _ = emit_load_rax_slot(b, nth(args, j)) in
            let _ = push_r64(b, 0) in
            pushargs(j - 1) in
        let _ = pushargs(nargs - 1) in
        let _ = emit_load_rax_slot(b, clos) in
        let _ = and_rax_1(b) in
        let _ = mov_rbx_rax_disp8(b, 16) in
        let _ = mov_r11d_rax_disp8(b, 24) in
        let loadcap(i) =
          if i >= 6 then 0
          else
            let _ = cmp_r11_imm8(b, i) in
            let _ = e8(b, 126) in
            let offpos = bytes_len(b) in
            let _ = e8(b, 0) in
            let m0 = bytes_len(b) in
            let _ = mov_argreg_rax_disp8(b, i, 32 + i * 8) in
            let m1 = bytes_len(b) in
            let _ = bytes_put(b, offpos, m1 - m0) in
            loadcap(i + 1) in
        let _ = loadcap(0) in
        /* record je/jmp patch sites (rel32 field positions) */
        let _ = cmp_r11_imm8(b, 0) in
        let _ = jcc_rel32(b, 4, 0) in
        let r0 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 1) in
        let _ = jcc_rel32(b, 4, 0) in
        let r1 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 2) in
        let _ = jcc_rel32(b, 4, 0) in
        let r2 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 3) in
        let _ = jcc_rel32(b, 4, 0) in
        let r3 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 4) in
        let _ = jcc_rel32(b, 4, 0) in
        let r4 = bytes_len(b) - 4 in
        let _ = jmp_rel32(b, 0) in
        let r5 = bytes_len(b) - 4 in
        let popusers(base) =
          let loop(j) =
            if j >= nargs then 0
            else
              let _ = pop_argreg(b, base + j) in
              loop(j + 1) in
          loop(0) in
        /* arms: pop then jmp to LC; record arm starts and jmp sites */
        let a0 = bytes_len(b) in
        let _ = popusers(0) in
        let _ = jmp_rel32(b, 0) in
        let j0 = bytes_len(b) - 4 in
        let a1 = bytes_len(b) in
        let _ = popusers(1) in
        let _ = jmp_rel32(b, 0) in
        let j1 = bytes_len(b) - 4 in
        let a2 = bytes_len(b) in
        let _ = popusers(2) in
        let _ = jmp_rel32(b, 0) in
        let j2 = bytes_len(b) - 4 in
        let a3 = bytes_len(b) in
        let _ = popusers(3) in
        let _ = jmp_rel32(b, 0) in
        let j3 = bytes_len(b) - 4 in
        let a4 = bytes_len(b) in
        let _ = popusers(4) in
        let _ = jmp_rel32(b, 0) in
        let j4 = bytes_len(b) - 4 in
        let a5 = bytes_len(b) in
        let _ = popusers(5) in
        let _ = jmp_rel32(b, 0) in
        let j5 = bytes_len(b) - 4 in
        let lc = bytes_len(b) in
        let _ = call_rbx(b) in
        let _ = emit_store_rax_slot(b, dst) in
        /* patch all local rel32s now */
        let _ = apply_patch(b, r0, a0) in
        let _ = apply_patch(b, r1, a1) in
        let _ = apply_patch(b, r2, a2) in
        let _ = apply_patch(b, r3, a3) in
        let _ = apply_patch(b, r4, a4) in
        let _ = apply_patch(b, r5, a5) in
        let _ = apply_patch(b, j0, lc) in
        let _ = apply_patch(b, j1, lc) in
        let _ = apply_patch(b, j2, lc) in
        let _ = apply_patch(b, j3, lc) in
        let _ = apply_patch(b, j4, lc) in
        let _ = apply_patch(b, j5, lc) in
        [b, cur, labels, patches]
    else if k == "nil" then
      /* nil = tagged null = 1 */
      let _ = mov_r64_imm(b, 0, 1) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "cons" then
      /* cons dst head tail: alloc [next][mark][kind=2][head][tail] */
      let dst = nth(insn, 1) in
      let hd = nth(insn, 2) in
      let tl = nth(insn, 3) in
      let _ = mov_rdi_imm(b, 40) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_disp8_imm32(b, 8, 0) in    /* mark */
      let _ = mov_rax_disp8_imm32(b, 16, 2) in   /* kind = LIST */
      let _ = mov_rax_disp8_imm32(b, 20, 0) in
      let _ = emit_load_rdi_slot(b, hd) in
      let _ = mov_rax_disp8_rdi(b, 24) in
      let _ = emit_load_rdi_slot(b, tl) in
      let _ = mov_rax_disp8_rdi(b, 32) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_alloc"], patches)]
    else if k == "len" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_len"], patches)]
    else if k == "nth" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_nth"], patches)]
    else if k == "tail" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_tail"], patches)]
    else if k == "append" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_append"], patches)]
    else if k == "list_rev" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_list_rev"], patches)]
    else if k == "list_new" then
      let dst = nth(insn, 1) in
      let _ = mov_r64_imm(b, 0, 1) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "list_push" then
      let dst = nth(insn, 1) in
      let _ = xor_rax_rax(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "strlit" then
      /* STR: [next][mark][kind=3][len][bytes...]; size 8-aligned */
      let dst = nth(insn, 1) in
      let s = nth(insn, 2) in
      let n = str_len(s) in
      let raw = 32 + n + 1 in
      let size = bshl(bshr(raw + 7, 3), 3) in
      let _ = mov_rdi_imm(b, size) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_disp8_imm32(b, 8, 0) in
      let _ = mov_rax_disp8_imm32(b, 16, 3) in
      let _ = mov_rax_disp8_imm32(b, 20, 0) in
      let _ = mov_rax_disp8_imm32(b, 24, n) in
      let _ = mov_rax_disp8_imm32(b, 28, 0) in
      let copy(i) =
        if i >= n then 0
        else
          let _ = mov_rax_disp8_imm8(b, 32 + i, str_ref(s, i)) in
          copy(i + 1) in
      let _ = copy(0) in
      let _ = mov_rax_disp8_imm8(b, 32 + n, 0) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_alloc"], patches)]
    else if k == "str_len" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_rax_disp8(b, 24) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "str_ref" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = mov_r64_r64(b, 2, 7) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 250) in
      let _ = add_rax_imm32(b, 32) in
      let _ = movzx_eax_rax_rdx(b) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_new" then
      /* BYTES: [next][mark][kind=4][len][cap][data...] initial cap=1048576 */
      let dst = nth(insn, 1) in
      let _ = mov_rdi_imm(b, 40 + 1048576) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_disp8_imm32(b, 8, 0) in
      let _ = mov_rax_disp8_imm32(b, 16, 4) in
      let _ = mov_rax_disp8_imm32(b, 20, 0) in
      let _ = mov_rax_disp8_imm32(b, 24, 0) in
      let _ = mov_rax_disp8_imm32(b, 28, 0) in
      let _ = mov_rax_disp8_imm32(b, 32, 1048576) in
      let _ = mov_rax_disp8_imm32(b, 36, 0) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_alloc"], patches)]
    else if k == "bytes_len" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_rax_disp8(b, 24) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_ref" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = mov_r64_r64(b, 2, 7) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 250) in
      let _ = add_rax_imm32(b, 40) in
      let _ = movzx_eax_rax_rdx(b) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_put" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = mov_r64_r64(b, 2, 7) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 250) in
      let _ = emit_load_rdi_slot(b, nth(insn, 4)) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 255) in
      let _ = add_rax_imm32(b, 40) in
      let _ = mov_rax_rdx_dil(b) in
      let _ = xor_rax_rax(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_append" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = push_r64(b, 0) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 255) in
      let _ = pop_r64(b, 0) in
      let _ = mov_rdx_rax_disp8(b, 24) in
      let _ = push_r64(b, 0) in
      let _ = add_rax_imm32(b, 40) in
      let _ = e8(b, 72) in let _ = e8(b, 1) in let _ = e8(b, 208) in
      let _ = e8(b, 64) in let _ = e8(b, 136) in let _ = e8(b, 56) in
      let _ = pop_r64(b, 0) in
      let _ = inc_mem_rax_disp8(b, 24) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "str_cat" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_str_cat"], patches)]
    else if k == "str_slice" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 4)) in
      let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_str_slice"], patches)]
    else if k == "int_to_str" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_int_to_str"], patches)]
    else if k == "bytes_to_str" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_bytes_to_str"], patches)]
    else if k == "drop" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_drop"], patches)]
    else if k == "foldl" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 4)) in
      let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_foldl"], patches)]
    else if k == "map" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_map"], patches)]
    else if k == "read_file" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_read_file"], patches)]
    else if k == "write_file" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_write_file"], patches)]
    else [b, cur, labels, patches] in
  /* update cur by the ACTUAL bytes appended */
  let newlen = bytes_len(b) in
  [nth(done, 0), cur + (newlen - len0), nth(done, 2), nth(done, 3)]

/* ---- program emission ---- */

let lookup_name(table, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(table)

let label_has(labels, name) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(nth(l, 0), 0) == name then true
    else rec(drop(l, 1)) in
  rec(labels)

/* Resolve patches that target labels defined in this function; keep the rest
 * (calls to other funs / runtime). Labels are not unique across functions. */
let resolve_local_labels(b, labels, patches) =
  let step(ps, keep) =
    if len(ps) == 0 then reverse(keep)
    else
      let p = nth(ps, 0) in
      let hd = nth(p, 0) in
      if hd == "closurefn" or hd == "gc_head" then
        step(drop(ps, 1), cons(p, keep))
      else if label_has(labels, nth(p, 1)) then
        let _ = apply_patch(b, nth(p, 0), lookup_name(labels, nth(p, 1))) in
        step(drop(ps, 1), keep)
      else step(drop(ps, 1), cons(p, keep)) in
  step(patches, [])

let emit_program(prog) =
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let glob = [out, 0, [], []] in
  let funOffsRev = [] in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = nth(st, 1) in
      /* fresh label table per function (LIF0 etc. collide otherwise) */
      let st0 = [nth(st, 0), nth(st, 1), [], nth(st, 3)] in
      let insns = nth(f, 4) in
      let run(j, s) =
        if j >= len(insns) then s
        else run(j + 1, emit_insn(s, nth(insns, j), is_entry)) in
      let s1 = run(0, st0) in
      let b = nth(s1, 0) in
      let kept = resolve_local_labels(b, nth(s1, 2), nth(s1, 3)) in
      let s2 = [b, nth(s1, 1), [], kept] in
      emit_fun(i + 1, s2, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, glob, []) in
  let st = nth(r1, 0) in
  let funOffsRev = nth(r1, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let b = nth(st, 0) in
  /* append runtime helpers (print_int, yac_alloc, gc_collect) and register offsets */
  let pi_off = bytes_len(b) in
  let _ = b_append(b, gen_print_int(0)) in
  let len_off = bytes_len(b) in
  let _ = b_append(b, gen_len(0)) in
  let nth_off = bytes_len(b) in
  let _ = b_append(b, gen_nth(0)) in
  let tail_off = bytes_len(b) in
  let _ = b_append(b, gen_tail(0)) in
  let lrr = gen_list_rev(0) in
  let lrev_off = bytes_len(b) in
  let _ = b_append(b, nth(lrr, 0)) in
  let alc_off = bytes_len(b) in
  let alcr = gen_alloc(0) in
  let _ = b_append(b, nth(alcr, 0)) in
  let alc_headaddr = nth(alcr, 1) in
  let gc_call_patch = nth(alcr, 2) in
  let appr = gen_append(0) in
  let app_off = bytes_len(b) in
  let _ = b_append(b, nth(appr, 0)) in
  let rfr = gen_read_file(0) in
  let rf_off = bytes_len(b) in
  let _ = b_append(b, nth(rfr, 0)) in
  let wf_off = bytes_len(b) in
  let _ = b_append(b, gen_write_file(0)) in
  let scr = gen_str_cat(0) in
  let sc_off = bytes_len(b) in
  let _ = b_append(b, nth(scr, 0)) in
  let drop_off = bytes_len(b) in
  let _ = b_append(b, gen_drop(0)) in
  let itr = gen_int_to_str(0) in
  let it_off = bytes_len(b) in
  let _ = b_append(b, nth(itr, 0)) in
  let ssr = gen_str_slice(0) in
  let ss_off = bytes_len(b) in
  let _ = b_append(b, nth(ssr, 0)) in
  let btr = gen_bytes_to_str(0) in
  let bt_off = bytes_len(b) in
  let _ = b_append(b, nth(btr, 0)) in
  let seq_off = bytes_len(b) in
  let _ = b_append(b, gen_str_eq(0)) in
  let a2_off = bytes_len(b) in
  let _ = b_append(b, gen_apply2(0)) in
  let a1_off = bytes_len(b) in
  let _ = b_append(b, gen_apply1(0)) in
  let flr = gen_foldl(0) in
  let fl_off = bytes_len(b) in
  let _ = b_append(b, nth(flr, 0)) in
  let mpr = gen_map(0) in
  let mp_off = bytes_len(b) in
  let _ = b_append(b, nth(mpr, 0)) in
  let gc_off = bytes_len(b) in
  let gcr = gen_gc(0) in
  let _ = b_append(b, nth(gcr, 0)) in
  let gc_headaddr = nth(gcr, 1) in
  let funOffsRev2 = cons(["gc_collect", gc_off],
                         cons(["yac_map", mp_off],
                              cons(["yac_foldl", fl_off],
                                   cons(["yac_apply1", a1_off],
                                        cons(["yac_apply2", a2_off],
                                             cons(["yac_str_eq", seq_off],
                                                  cons(["yac_bytes_to_str", bt_off],
                                                       cons(["yac_str_slice", ss_off],
                                                            cons(["yac_int_to_str", it_off],
                                                                 cons(["yac_drop", drop_off],
                                                                      cons(["yac_str_cat", sc_off],
                                                                           cons(["yac_write_file", wf_off],
                                                                                cons(["yac_read_file", rf_off],
                                                                                     cons(["yac_append", app_off],
                                                                                          cons(["yac_alloc", alc_off],
                                                                                               cons(["yac_list_rev", lrev_off],
                                                                                               cons(["yac_tail", tail_off],
                                                                                                    cons(["yac_nth", nth_off],
                                                                                                         cons(["yac_len", len_off],
                                                                                                              cons(["print_int", pi_off], funOffsRev)))))))))))))))))))) in
  let LOAD_VADDR = 4194304 in  /* 0x400000 */
  let TEXT_OFF = 120 in       /* ELF header + phdr size */
  /* append a small writable data area for GC globals (the linked-list head). */
  let data_start = bytes_len(b) in
  let _ = bytes_append(b, 0) in  /* 8 zero bytes: head = NULL */
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let GLOBALS_BASE = LOAD_VADDR + TEXT_OFF + data_start in
  let resolve(ps) =
    if len(ps) == 0 then 0
    else
      let p = nth(ps, 0) in
      let kind = nth(p, 0) in
      if kind == "closurefn" then
        let pos = nth(p, 1) in
        let tname = nth(p, 2) in
        let fo = lookup_name(funOffsRev2, tname) in
        let _ = apply_abs32(b, pos, LOAD_VADDR + TEXT_OFF + fo) in
        resolve(drop(ps, 1))
      else if kind == "gc_head" then
        let pos = nth(p, 1) in
        let _ = apply_u64(b, pos, GLOBALS_BASE) in
        resolve(drop(ps, 1))
      else
        let pos = nth(p, 0) in
        let tname = nth(p, 1) in
        let targ1 = lookup_name(labels, tname) in
        let targ2 = if targ1 == 0 then lookup_name(funOffsRev2, tname) else targ1 in
        let _ = apply_patch(b, pos, targ2) in
        resolve(drop(ps, 1)) in
  let extra = cons(["gc_head", gc_off + gc_headaddr],
                   cons(["gc_head", alc_off + alc_headaddr],
                        cons([alc_off + gc_call_patch, "gc_collect"],
                             cons([app_off + nth(appr, 1), "yac_append"],
                                  cons([app_off + nth(appr, 2), "yac_alloc"],
                                       cons([lrev_off + nth(lrr, 1), "yac_alloc"],
                                       cons([rf_off + nth(rfr, 1), "yac_alloc"],
                                            cons([sc_off + nth(scr, 1), "yac_alloc"],
                                                 cons([it_off + nth(itr, 1), "yac_alloc"],
                                                      cons([ss_off + nth(ssr, 1), "yac_alloc"],
                                                           cons([bt_off + nth(btr, 1), "yac_alloc"],
                                                                cons([fl_off + nth(flr, 1), "yac_apply2"],
                                                                     cons([mp_off + nth(mpr, 1), "yac_map"],
                                                                          cons([mp_off + nth(mpr, 2), "yac_apply1"],
                                                                               cons([mp_off + nth(mpr, 3), "yac_alloc"],
                                                                                    patches))))))))))))))) in
  let _ = resolve(extra) in
  [b, funOffsRev2]
