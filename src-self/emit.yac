/* emit.yac — shared emit helpers (all arches).
 *
 * Arch backends: emit_x86_64.yac, emit_arm64.yac, emit_riscv64.yac
 * LIR in, code bytes out; pack is a separate pass.
 *
 * Helpers: byte append, abs32/u64 patches, x86 rel32 patch, name maps,
 * patch-list extend. Instruction emit stays in emit_<arch>.yac.
 */

let reverse(xs) = list_rev(xs)

let b_append(dst, src) =
  let _ = bytes_extend(dst, src) in
  dst

let apply_patch(b, bytePos, target) =
  let rel = target - (bytePos + 4) in
  let _ = bytes_put(b, bytePos + 0, band(rel, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(rel, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(rel, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(rel, 24), 255)) in
  0

/* write a 32-bit absolute value at bytePos (for closure fnptr fields) */
let apply_abs32(b, bytePos, val) =
  let _ = bytes_put(b, bytePos + 0, band(val, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(val, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(val, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(val, 24), 255)) in
  0

/* write a 64-bit little-endian value at bytePos (for GC global addresses) */
let apply_u64(b, bytePos, val) =
  let _ = apply_abs32(b, bytePos, band(val, 4294967295)) in
  let _ = apply_abs32(b, bytePos + 4, band(bshr(val, 32), 4294967295)) in
  0

let lookup_name(table, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(table)

/* 256-bucket name->int map for O(1) avg fun-offset lookup during resolve. */
let emit_hash(s) =
  let n = str_len(s) in
  let loop(i, h) =
    if i >= n then h
    else loop(i + 1, (h * 31 + str_ref(s, i)) % 256) in
  loop(0, 0)

let emit_map_new(_) =
  let b = list_new() in
  let fill(i) =
    if i >= 256 then b
    else let _ = list_push(b, list_new()) in fill(i + 1) in
  fill(0)

let emit_map_put(m, k, v) =
  let bucket = nth(m, emit_hash(k)) in
  let _ = list_push(bucket, [k, v]) in
  0

let emit_map_get(m, k) =
  let bucket = nth(m, emit_hash(k)) in
  let n = len(bucket) in
  /* First put wins — same as lookup_name on funOffsRev. */
  let scan(i) =
    if i >= n then 0
    else if nth(nth(bucket, i), 0) == k then nth(nth(bucket, i), 1)
    else scan(i + 1) in
  scan(0)

let emit_map_from_list(xs) =
  let m = emit_map_new(0) in
  let n = len(xs) in
  let loop(i) =
    if i >= n then m
    else
      let e = nth(xs, i) in
      let _ = emit_map_put(m, nth(e, 0), nth(e, 1)) in
      loop(i + 1) in
  loop(0)

let label_has(labels, name) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(nth(l, 0), 0) == name then true
    else rec(drop(l, 1)) in
  rec(labels)

let patches_extend(dst, src) =
  let n = len(src) in
  let loop(i) =
    if i >= n then dst
    else let _ = list_push(dst, nth(src, i)) in loop(i + 1) in
  loop(0)
