/* emit.yac — translate LIR to x86-64 machine code (M3.2).
 *
 * Single-pass emission with deferred patch-up. Lengths are computed from the
 * ACTUAL number of bytes appended (bytes_len before/after), never hand-counted,
 * so cur always matches reality.
 *
 * - instructions append bytes; cur += bytes appended (real)
 * - labels record [name, cur]
 * - jmp/br write placeholder rel32 and record a patch [bytePos, target]
 *   where bytePos is the start of the rel32 field
 * After all code, patches are resolved: rel = target - (bytePos+4).
 *
 * Slot k -> [rbp - 8*k]. Entry (_start) sets rbp, no push/pop.
 *
 * Program: ["prog", [fun...], entryName]; fun = ["fun", name, nparams, [insn...]].
 * Returns [codeBytes, funOffsets].
 */

let reverse(xs) = foldl(fun (a, x) -> cons(x, a), [], xs)
let slot8(k) = band(0 - bshl(k, 3), 255)

/* append bytes `src` to bytes `dst` */
let b_append(dst, src) =
  let copy(i) =
    if i >= bytes_len(src) then 0
    else
      let _ = bytes_append(dst, bytes_ref(src, i)) in
      copy(i + 1) in
  let _ = copy(0) in
  dst

/* yac_alloc(n in rdi) -> rax: allocate n bytes on the heap via brk, link the
 * new object into the global GC list, then run a conservative gc_collect.
 * Returns the allocation start (current heap top).
 * New object layout: [next=old head][...rest caller fills...].
 * Global GC head lives at a data address patched via "gc_head".
 * Returns [bytes, headaddrPatchPos, gcCallPatchPos]. */
let gen_alloc(d) =
  let b = bytes_new() in
  let _ = e8(b, 87) in               /* push rdi (save n) */
  let _ = mov_r64_imm(b, 0, 12) in   /* rax = 12 (brk) */
  let _ = mov_rdi_imm(b, 0) in
  let _ = syscall(b) in              /* rax = cur heap top */
  let _ = mov_rbx_rax(b) in          /* rbx = cur */
  let _ = e8(b, 95) in               /* pop rdi (n) */
  let _ = lea_rdi_rbx_rdi(b) in      /* rdi = cur + n */
  let _ = mov_r64_imm(b, 0, 12) in
  let _ = syscall(b) in              /* brk(cur+n) */
  let _ = mov_rax_rbx(b) in          /* rax = cur (allocation start) */
  /* link into global list: mov rax,<&head>; mov rdx,[rax]; mov [rbx],rdx; mov [rax],rbx */
  let _ = mov_rax_imm64(b, 0) in     /* rax = &head (patched) */
  let headaddr = bytes_len(b) - 8 in
  let _ = mov_rdx_mem_rax(b) in      /* rdx = old head */
  let _ = mov_mem_rbx_rdx(b) in      /* [rbx+0] = old head (next) */
  let _ = mov_mem_rax_rbx(b) in      /* [rax] = rbx (head = new obj) */
  /* run gc_collect (conservative mark-sweep; keeps all live objects) */
  let _ = push_r64(b, 3) in          /* push rbx (save base) */
  let gcall = bytes_len(b) in
  let _ = call_rel32(b, 0) in        /* call gc_collect (patched) */
  let _ = pop_r64(b, 3) in           /* pop rbx */
  let _ = mov_rax_rbx(b) in          /* rax = base (return value) */
  let _ = ret(b) in
  [b, headaddr, gcall + 1]


/* write a single newline via syscall: push '\n'; rsi=rsp; write(1,"\n",1) */
let emit_newline(b) =
  let _ = e8(b, 106) in       /* push imm8 */
  let _ = e8(b, 10) in        /* '\n' */
  let _ = mov_rsi_rsp(b) in
  let _ = mov_rdx_imm(b, 1) in
  let _ = mov_rdi_imm(b, 1) in
  let _ = mov_r64_imm(b, 0, 1) in
  let _ = syscall(b) in
  let _ = e8(b, 72) in        /* add rsp, 8 (48 83 c4 08) */
  let _ = e8(b, 131) in
  let _ = e8(b, 196) in
  let _ = e8(b, 8) in
  0

/* print_int(n in rdi): recursively print decimal digits to stdout.
 * Fixed layout; recursive call rel32 is -41 (call to function start). */
let gen_print_int(d) =
  let b = bytes_new() in
  let _ = e8(b, 85) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 16) in
  let _ = mov_rax_rdi(b) in
  let _ = mov_rcx_imm(b, 10) in
  let _ = cqo(b) in
  let _ = idiv_rcx(b) in
  let _ = mov_mem_rbp8_rdx(b) in
  let _ = cmp_rax_imm8(b, 0) in
  let _ = jcc_rel8(b, 4, 8) in    /* je printdigit rel 0x08 */
  let _ = mov_rdi_rax(b) in
  let _ = call_rel32(b, -41) in   /* recurse; falls through to printdigit */
  let _ = mov_rax_mem_rbp8(b) in
  let _ = add_rax_imm8(b, 48) in
  let _ = sub_rsp_imm8(b, 8) in
  let _ = mov_mem_rsp_al(b) in
  let _ = mov_rsi_rsp(b) in
  let _ = mov_rdx_imm(b, 1) in
  let _ = mov_rdi_imm(b, 1) in
  let _ = mov_r64_imm(b, 0, 1) in
  let _ = syscall(b) in
  let _ = add_rsp_imm8(b, 8) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  b
let emit_load_rax_slot(b, k) = mov_r64_mem_rbp(b, 0, slot8(k))
let emit_load_rdi_slot(b, k) = mov_rdi_mem_rbp(b, slot8(k))
let emit_store_rax_slot(b, k) = mov_mem_rbp_r64(b, slot8(k), 0)

let cc_of(op) =
  if op == "<" then 12 else if op == "<=" then 14
  else if op == ">" then 15 else if op == ">=" then 13
  else if op == "==" then 4 else 5

let apply_patch(b, bytePos, target) =
  let rel = target - (bytePos + 4) in
  let _ = bytes_put(b, bytePos + 0, band(rel, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(rel, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(rel, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(rel, 24), 255)) in
  0

/* write a 32-bit absolute value at bytePos (for closure fnptr fields) */
let apply_abs32(b, bytePos, val) =
  let _ = bytes_put(b, bytePos + 0, band(val, 255)) in
  let _ = bytes_put(b, bytePos + 1, band(bshr(val, 8), 255)) in
  let _ = bytes_put(b, bytePos + 2, band(bshr(val, 16), 255)) in
  let _ = bytes_put(b, bytePos + 3, band(bshr(val, 24), 255)) in
  0

/* write a 64-bit little-endian value at bytePos (for GC global addresses) */
let apply_u64(b, bytePos, val) =
  let _ = apply_abs32(b, bytePos, band(val, 4294967295)) in
  let _ = apply_abs32(b, bytePos + 4, band(bshr(val, 32), 4294967295)) in
  0

/* gc_collect: conservative mark-sweep. Walks the global GC list: mark pass
 * sets every object's mark=1 (conservative root set = all objects, since no
 * stack maps yet); sweep pass resets marks. Nothing is reclaimed yet — this
 * keeps all live closures alive and is the safe first version (M3.5c).
 * Precise reclaim needs stack maps (M6). Clobbers rax, rbx; returns 0.
 * (Uses apply_patch for its internal rel32 patching.) */
let gen_gc(d) =
  let b = bytes_new() in
  let _ = mov_rax_imm64(b, 0) in     /* rax = &head (patched) */
  let headaddr = bytes_len(b) - 8 in
  let _ = mov_rbx_mem_rax(b) in      /* rbx = list head */
  /* mark pass */
  let marktest = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in      /* jz -> out */
  let markjz = bytes_len(b) - 4 in
  let _ = mov_mem_rbx_disp8_imm32(b, 8, 1) in   /* mark = 1 */
  let _ = mov_rbx_mem_rbx(b) in      /* next */
  let _ = jmp_rel32(b, 0) in         /* -> marktest */
  let markjmp = bytes_len(b) - 4 in
  /* sweep pass */
  let _ = mov_rbx_mem_rax(b) in      /* rbx = head */
  let sweeptest = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in      /* jz -> out */
  let sweepjz = bytes_len(b) - 4 in
  let _ = mov_mem_rbx_disp8_imm32(b, 8, 0) in   /* mark = 0 */
  let _ = mov_rbx_mem_rbx(b) in      /* next */
  let _ = jmp_rel32(b, 0) in         /* -> sweeptest */
  let sweepjmp = bytes_len(b) - 4 in
  /* exit */
  let out = bytes_len(b) in
  let _ = xor_rax_rax(b) in
  let _ = ret(b) in
  let _ = apply_patch(b, markjz, out) in
  let _ = apply_patch(b, sweepjz, out) in
  let _ = apply_patch(b, markjmp, marktest) in
  let _ = apply_patch(b, sweepjmp, sweeptest) in
  [b, headaddr]

/* yac_len(list in rdi) -> tagged count in rax */
let gen_len(d) =
  let b = bytes_new() in
  let _ = xor_rcx_rcx(b) in
  let _ = mov_rax_rdi(b) in
  let loop = bytes_len(b) in
  let _ = cmp_rax_imm8(b, 1) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz = bytes_len(b) - 4 in
  let _ = and_rax_1(b) in
  let _ = mov_rax_rax_disp8(b, 32) in
  let _ = inc_rcx(b) in
  let _ = jmp_rel32(b, 0) in
  let jback = bytes_len(b) - 4 in
  let done = bytes_len(b) in
  let _ = mov_rax_rcx(b) in
  let _ = shl_rax_1(b) in
  let _ = ret(b) in
  let _ = apply_patch(b, jz, done) in
  let _ = apply_patch(b, jback, loop) in
  b

/* yac_nth(list in rdi, idx tagged in rsi) -> element in rax */
let gen_nth(d) =
  let b = bytes_new() in
  let _ = sar_rsi_1(b) in
  let _ = mov_rax_rdi(b) in
  let loop = bytes_len(b) in
  let _ = cmp_rsi_imm8(b, 0) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz = bytes_len(b) - 4 in
  let _ = and_rax_1(b) in
  let _ = mov_rax_rax_disp8(b, 32) in
  let _ = dec_rsi(b) in
  let _ = jmp_rel32(b, 0) in
  let jback = bytes_len(b) - 4 in
  let found = bytes_len(b) in
  let _ = and_rax_1(b) in
  let _ = mov_rax_rax_disp8(b, 24) in
  let _ = ret(b) in
  let _ = apply_patch(b, jz, found) in
  let _ = apply_patch(b, jback, loop) in
  b

/* yac_tail(list in rdi) -> tail in rax (nil if nil) */
let gen_tail(d) =
  let b = bytes_new() in
  let _ = mov_rax_rdi(b) in
  let _ = cmp_rax_imm8(b, 1) in
  let _ = jcc_rel32(b, 4, 0) in
  let jz = bytes_len(b) - 4 in
  let _ = and_rax_1(b) in
  let _ = mov_rax_rax_disp8(b, 32) in
  let _ = ret(b) in
  let done = bytes_len(b) in
  let _ = mov_r64_imm(b, 0, 1) in
  let _ = ret(b) in
  let _ = apply_patch(b, jz, done) in
  b

/* emit one instruction; st = [bytes, cur, labelsRev, patchesRev]. */
let emit_insn(st, insn, is_entry) =
  let b = nth(st, 0) in
  let cur = nth(st, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let k = nth(insn, 0) in
  let len0 = bytes_len(b) in
  let done =
    if k == "prologue" then
      let nlocals = nth(insn, 1) in
      let nparams = if len(insn) > 2 then nth(insn, 2) else 0 in
      if is_entry then
        let _ = mov_rbp_rsp(b) in
        let _ = sub_rsp_imm8(b, band(bshl(nlocals, 3), 255)) in
        [b, cur, labels, patches]
      else
        let _ = push_rbp(b) in
        let _ = mov_rbp_rsp(b) in
        let _ = sub_rsp_imm8(b, band(bshl(nlocals, 3), 255)) in
        let storeparams(j) =
          if j >= nparams then 0
          else
            let _ =
              if j == 0 then mov_mem_rbp_rdi(b, slot8(j + 1))
              else if j == 1 then mov_mem_rbp_rsi(b, slot8(j + 1))
              else if j == 2 then mov_mem_rbp_rdx(b, slot8(j + 1))
              else if j == 3 then mov_mem_rbp_rcx(b, slot8(j + 1))
              else if j == 4 then mov_mem_rbp_r8(b, slot8(j + 1))
              else mov_mem_rbp_r9(b, slot8(j + 1)) in
            storeparams(j + 1) in
        let _ = storeparams(0) in
        [b, cur, labels, patches]
    else if k == "mov_imm" then
      /* tag: store n<<1 */
      let _ = mov_r64_imm(b, 0, nth(insn, 2)) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "mov" then
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "binop" then
      /* untag both operands, compute, retag */
      let op = nth(insn, 1) in
      let dst = nth(insn, 2) in
      let a = nth(insn, 3) in
      let bop = nth(insn, 4) in
      let _ = emit_load_rax_slot(b, a) in
      let _ = sar_rax_1(b) in
      let _ = mov_rbx_mem_rbp(b, slot8(bop)) in
      let _ = sar_rbx_1(b) in
      let c =
        if op == "+" then add_rax_rbx(b)
        else if op == "-" then sub_rax_rbx(b)
        else if op == "*" then imul_rax_rbx(b)
        else if op == "/" then
          let _ = cqo(b) in
          idiv_rbx(b)
        else if op == "%" then
          let _ = cqo(b) in
          let _ = idiv_rbx(b) in
          mov_r64_r64(b, 0, 2)
        else 0 in
      let _ = c in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "cmp" then
      let op = nth(insn, 1) in
      let dst = nth(insn, 2) in
      let a = nth(insn, 3) in
      let bop = nth(insn, 4) in
      let _ = emit_load_rax_slot(b, a) in
      let _ = sar_rax_1(b) in
      let _ = mov_rbx_mem_rbp(b, slot8(bop)) in
      let _ = sar_rbx_1(b) in
      let _ = cmp_rax_rbx(b) in
      let _ = setcc_r8(b, cc_of(op)) in
      let _ = movzx_eax_al(b) in
      let _ = shl_rax_1(b) in   /* tag the boolean */
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "label" then
      let nm = nth(insn, 1) in
      [b, cur, cons([nm, cur], labels), patches]
    else if k == "call" then
      /* call fn(argSlots...): load args to rdi,rsi,rdx,rcx,r8,r9; call; store. */
      let dst = nth(insn, 1) in
      let fn = nth(insn, 2) in
      let args = nth(insn, 3) in
      let nargs = len(args) in
      let loadarg(j) =
        if j >= nargs then 0
        else
          let _ = emit_load_rax_slot(b, nth(args, j)) in
          let _ =
            if j == 0 then mov_rdi_rax(b)
            else if j == 1 then mov_rsi_rax(b)
            else if j == 2 then mov_rdx_rax(b)
            else if j == 3 then mov_rcx_rax(b)
            else if j == 4 then mov_r8_rax(b)
            else mov_r9_rax(b) in
          loadarg(j + 1) in
      let _ = loadarg(0) in
      let callstart = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([callstart + 1, fn], patches)]
    else if k == "jmp" then
      /* jmp_rel32: e9 + rel32; rel32 field at len0+1 */
      let _ = jmp_rel32(b, 0) in
      [b, cur, labels, cons([len0 + 1, nth(insn, 1)], patches)]
    else if k == "br" then
      let cond = nth(insn, 1) in
      let tl = nth(insn, 2) in
      let fl = nth(insn, 3) in
      let _ = emit_load_rax_slot(b, cond) in
      let _ = test_rax_rax(b) in
      let _ = jcc_rel32(b, 4, 0) in  /* 0f 84 + rel32 */
      let _ = jmp_rel32(b, 0) in     /* e9 + rel32 */
      /* jz rel32 at len0+4+3+2; jmp rel32 at len0+4+3+6+1 */
      [b, cur, labels,
       cons([len0 + 9, fl], cons([len0 + 14, tl], patches))]
    else if k == "ret" then
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      if is_entry then let _ = ret(b) in [b, cur, labels, patches]
      else
        let _ = mov_rsp_rbp(b) in
        let _ = pop_rbp(b) in
        let _ = ret(b) in
        [b, cur, labels, patches]
    else if k == "exit" then
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      let _ = sar_rax_1(b) in   /* untag */
      let _ = mov_rdi_rax(b) in
      let _ = mov_r64_imm(b, 0, 60) in
      let _ = syscall(b) in
      [b, cur, labels, patches]
    else if k == "print" then
      /* print slot: load -> untag -> rdi; call print_int; write newline */
      let _ = emit_load_rax_slot(b, nth(insn, 1)) in
      let _ = sar_rax_1(b) in
      let _ = mov_rdi_rax(b) in
      let callstart = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_newline(b) in
      [b, cur, labels, cons([callstart + 1, "print_int"], patches)]
    else if k == "closure" then
      /* closure dst fnName [capSlots]:
       * alloc object [next][mark][fnptr][nenv][env...], tag, store.
       * yac_alloc links the object into the global GC list (sets [next]).
       * Offsets: next=0 mark=8 fnptr=16 nenv=24 env=32. */
      let dst = nth(insn, 1) in
      let fnName = nth(insn, 2) in
      let caps = nth(insn, 3) in
      let nenv = len(caps) in
      let size = (4 + nenv) * 8 in
      let _ = mov_rdi_imm(b, size) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in    /* alloc returns raw ptr; ensure untagged */
      let _ = mov_rax_disp8_imm32(b, 8, 0) in   /* mark = 0 */
      let _ = mov_rax_disp8_imm32(b, 16, 0) in  /* fnptr placeholder */
      let fnpos = bytes_len(b) - 4 in
      let _ = mov_rax_disp8_imm32(b, 24, nenv) in
      let _ = mov_rax_disp8_imm32(b, 28, 0) in  /* clear high dword of nenv qword */
      let storecap(i) =
        if i >= nenv then 0
        else
          let _ = emit_load_rdi_slot(b, nth(caps, i)) in
          let _ = mov_rax_disp8_rdi(b, 32 + i * 8) in
          storecap(i + 1) in
      let _ = storecap(0) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels,
       cons([acall + 1, "yac_alloc"],
            cons(["closurefn", fnpos, fnName], patches))]
    else if k == "apply" then
      /* apply dst closSlot ncap [argSlots]:
       * ncap >= 0: load that many caps (compile-time).
       * ncap < 0: read nenv from the object at runtime (jump table). */
      let dst = nth(insn, 1) in
      let clos = nth(insn, 2) in
      let ncap = nth(insn, 3) in
      let args = nth(insn, 4) in
      let nargs = len(args) in
      if ncap >= 0 then
        let _ = emit_load_rax_slot(b, clos) in
        let _ = and_rax_1(b) in
        let _ = mov_rbx_rax_disp8(b, 16) in
        let loadcap(i) =
          if i >= ncap then 0
          else
            let _ = mov_argreg_rax_disp8(b, i, 32 + i * 8) in
            loadcap(i + 1) in
        let _ = loadcap(0) in
        let loadarg(j) =
          if j >= nargs then 0
          else
            let _ = emit_load_rax_slot(b, nth(args, j)) in
            let _ = mov_rax_to_argreg(b, ncap + j) in
            loadarg(j + 1) in
        let _ = loadarg(0) in
        let _ = call_rbx(b) in
        let _ = emit_store_rax_slot(b, dst) in
        [b, cur, labels, patches]
      else
        /* dynamic nenv: build jump table and patch local labels immediately */
        let nargs = len(args) in
        let pushargs(j) =
          if j < 0 then 0
          else
            let _ = emit_load_rax_slot(b, nth(args, j)) in
            let _ = push_r64(b, 0) in
            pushargs(j - 1) in
        let _ = pushargs(nargs - 1) in
        let _ = emit_load_rax_slot(b, clos) in
        let _ = and_rax_1(b) in
        let _ = mov_rbx_rax_disp8(b, 16) in
        let _ = mov_r11d_rax_disp8(b, 24) in
        let loadcap(i) =
          if i >= 6 then 0
          else
            let _ = cmp_r11_imm8(b, i) in
            let _ = e8(b, 126) in
            let offpos = bytes_len(b) in
            let _ = e8(b, 0) in
            let m0 = bytes_len(b) in
            let _ = mov_argreg_rax_disp8(b, i, 32 + i * 8) in
            let m1 = bytes_len(b) in
            let _ = bytes_put(b, offpos, m1 - m0) in
            loadcap(i + 1) in
        let _ = loadcap(0) in
        /* record je/jmp patch sites (rel32 field positions) */
        let _ = cmp_r11_imm8(b, 0) in
        let _ = jcc_rel32(b, 4, 0) in
        let r0 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 1) in
        let _ = jcc_rel32(b, 4, 0) in
        let r1 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 2) in
        let _ = jcc_rel32(b, 4, 0) in
        let r2 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 3) in
        let _ = jcc_rel32(b, 4, 0) in
        let r3 = bytes_len(b) - 4 in
        let _ = cmp_r11_imm8(b, 4) in
        let _ = jcc_rel32(b, 4, 0) in
        let r4 = bytes_len(b) - 4 in
        let _ = jmp_rel32(b, 0) in
        let r5 = bytes_len(b) - 4 in
        let popusers(base) =
          let loop(j) =
            if j >= nargs then 0
            else
              let _ = pop_argreg(b, base + j) in
              loop(j + 1) in
          loop(0) in
        /* arms: pop then jmp to LC; record arm starts and jmp sites */
        let a0 = bytes_len(b) in
        let _ = popusers(0) in
        let _ = jmp_rel32(b, 0) in
        let j0 = bytes_len(b) - 4 in
        let a1 = bytes_len(b) in
        let _ = popusers(1) in
        let _ = jmp_rel32(b, 0) in
        let j1 = bytes_len(b) - 4 in
        let a2 = bytes_len(b) in
        let _ = popusers(2) in
        let _ = jmp_rel32(b, 0) in
        let j2 = bytes_len(b) - 4 in
        let a3 = bytes_len(b) in
        let _ = popusers(3) in
        let _ = jmp_rel32(b, 0) in
        let j3 = bytes_len(b) - 4 in
        let a4 = bytes_len(b) in
        let _ = popusers(4) in
        let _ = jmp_rel32(b, 0) in
        let j4 = bytes_len(b) - 4 in
        let a5 = bytes_len(b) in
        let _ = popusers(5) in
        let _ = jmp_rel32(b, 0) in
        let j5 = bytes_len(b) - 4 in
        let lc = bytes_len(b) in
        let _ = call_rbx(b) in
        let _ = emit_store_rax_slot(b, dst) in
        /* patch all local rel32s now */
        let _ = apply_patch(b, r0, a0) in
        let _ = apply_patch(b, r1, a1) in
        let _ = apply_patch(b, r2, a2) in
        let _ = apply_patch(b, r3, a3) in
        let _ = apply_patch(b, r4, a4) in
        let _ = apply_patch(b, r5, a5) in
        let _ = apply_patch(b, j0, lc) in
        let _ = apply_patch(b, j1, lc) in
        let _ = apply_patch(b, j2, lc) in
        let _ = apply_patch(b, j3, lc) in
        let _ = apply_patch(b, j4, lc) in
        let _ = apply_patch(b, j5, lc) in
        [b, cur, labels, patches]
    else if k == "nil" then
      /* nil = tagged null = 1 */
      let _ = mov_r64_imm(b, 0, 1) in
      let _ = emit_store_rax_slot(b, nth(insn, 1)) in
      [b, cur, labels, patches]
    else if k == "cons" then
      /* cons dst head tail: alloc [next][mark][kind=2][head][tail] */
      let dst = nth(insn, 1) in
      let hd = nth(insn, 2) in
      let tl = nth(insn, 3) in
      let _ = mov_rdi_imm(b, 40) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_disp8_imm32(b, 8, 0) in    /* mark */
      let _ = mov_rax_disp8_imm32(b, 16, 2) in   /* kind = LIST */
      let _ = mov_rax_disp8_imm32(b, 20, 0) in
      let _ = emit_load_rdi_slot(b, hd) in
      let _ = mov_rax_disp8_rdi(b, 24) in
      let _ = emit_load_rdi_slot(b, tl) in
      let _ = mov_rax_disp8_rdi(b, 32) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_alloc"], patches)]
    else if k == "len" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_len"], patches)]
    else if k == "nth" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_nth"], patches)]
    else if k == "tail" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_tail"], patches)]
    else [b, cur, labels, patches] in
  /* update cur by the ACTUAL bytes appended */
  let newlen = bytes_len(b) in
  [nth(done, 0), cur + (newlen - len0), nth(done, 2), nth(done, 3)]

/* ---- program emission ---- */

let lookup_name(table, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(table)

let emit_program(prog) =
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  let glob = [out, 0, [], []] in
  let funOffsRev = [] in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = nth(st, 1) in
      let insns = nth(f, 3) in
      let run(j, s) =
        if j >= len(insns) then s
        else run(j + 1, emit_insn(s, nth(insns, j), is_entry)) in
      let s1 = run(0, st) in
      emit_fun(i + 1, s1, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, glob, []) in
  let st = nth(r1, 0) in
  let funOffsRev = nth(r1, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let b = nth(st, 0) in
  /* append runtime helpers (print_int, yac_alloc, gc_collect) and register offsets */
  let pi_off = bytes_len(b) in
  let _ = b_append(b, gen_print_int(0)) in
  let len_off = bytes_len(b) in
  let _ = b_append(b, gen_len(0)) in
  let nth_off = bytes_len(b) in
  let _ = b_append(b, gen_nth(0)) in
  let tail_off = bytes_len(b) in
  let _ = b_append(b, gen_tail(0)) in
  let alc_off = bytes_len(b) in
  let alcr = gen_alloc(0) in
  let _ = b_append(b, nth(alcr, 0)) in
  let alc_headaddr = nth(alcr, 1) in
  let gc_call_patch = nth(alcr, 2) in
  let gc_off = bytes_len(b) in
  let gcr = gen_gc(0) in
  let _ = b_append(b, nth(gcr, 0)) in
  let gc_headaddr = nth(gcr, 1) in
  let funOffsRev2 = cons(["gc_collect", gc_off],
                         cons(["yac_alloc", alc_off],
                              cons(["yac_tail", tail_off],
                                   cons(["yac_nth", nth_off],
                                        cons(["yac_len", len_off],
                                             cons(["print_int", pi_off], funOffsRev)))))) in
  let LOAD_VADDR = 4194304 in  /* 0x400000 */
  let TEXT_OFF = 120 in       /* ELF header + phdr size */
  /* append a small writable data area for GC globals (the linked-list head). */
  let data_start = bytes_len(b) in
  let _ = bytes_append(b, 0) in  /* 8 zero bytes: head = NULL */
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let _ = bytes_append(b, 0) in
  let GLOBALS_BASE = LOAD_VADDR + TEXT_OFF + data_start in
  let resolve(ps) =
    if len(ps) == 0 then 0
    else
      let p = nth(ps, 0) in
      let kind = nth(p, 0) in
      if kind == "closurefn" then
        let pos = nth(p, 1) in
        let tname = nth(p, 2) in
        let fo = lookup_name(funOffsRev2, tname) in
        let _ = apply_abs32(b, pos, LOAD_VADDR + TEXT_OFF + fo) in
        resolve(drop(ps, 1))
      else if kind == "gc_head" then
        let pos = nth(p, 1) in
        let _ = apply_u64(b, pos, GLOBALS_BASE) in
        resolve(drop(ps, 1))
      else
        let pos = nth(p, 0) in
        let tname = nth(p, 1) in
        let targ1 = lookup_name(labels, tname) in
        let targ2 = if targ1 == 0 then lookup_name(funOffsRev2, tname) else targ1 in
        let _ = apply_patch(b, pos, targ2) in
        resolve(drop(ps, 1)) in
  let extra = cons(["gc_head", gc_off + gc_headaddr],
                   cons(["gc_head", alc_off + alc_headaddr],
                        cons([alc_off + gc_call_patch, "gc_collect"], patches))) in
  let _ = resolve(extra) in
  [b, funOffsRev2]
