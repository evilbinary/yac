/* emit_x86_64.yac — x86-64 emit of LIR.
 *
 * Shared maps/patches: emit.yac. Encoding: encode_x64.yac.
 *
 * Single-pass emission with deferred patch-up. Lengths come from
 * bytes_len before/after, never hand-counted.
 *
 * Slot k -> [rbp - 8*(k+1)]. Never [rbp+0] (saved rbp / _start argc).
 * Entry (_start) sets rbp, no push/pop.
 *
 * Program: ["prog", [fun...], entryName]; fun from l_fun in lir.yac.
 * Returns [codeBytes, funOffsets].
 */

/* slot k at [rbp - 8*(k+1)]; signed byte offset when |off| <= 128.
 * k=0 must not use [rbp+0]: that is saved rbp (or _start argc). */
let slot_off(k) = 0 - bshl(k + 1, 3)
let slot_fits8(k) =
  let off = slot_off(k) in
  off >= (0 - 128) and off <= 127

let emit_load_rax_slot(b, k) =
  if slot_fits8(k) then mov_r64_mem_rbp(b, 0, band(slot_off(k), 255))
  else mov_r64_mem_rbp32(b, 0, slot_off(k))
let emit_load_rdi_slot(b, k) =
  if slot_fits8(k) then mov_rdi_mem_rbp(b, band(slot_off(k), 255))
  else mov_r64_mem_rbp32(b, 7, slot_off(k))
let emit_store_rax_slot(b, k) =
  if slot_fits8(k) then mov_mem_rbp_r64(b, band(slot_off(k), 255), 0)
  else mov_mem_rbp32_r64(b, slot_off(k), 0)
let emit_load_rbx_slot(b, k) =
  if slot_fits8(k) then mov_rbx_mem_rbp(b, band(slot_off(k), 255))
  else mov_r64_mem_rbp32(b, 3, slot_off(k))
let emit_store_param(b, j, k) =
  /* store argreg j into slot k */
  let off = slot_off(k) in
  if slot_fits8(k) then
    let d = band(off, 255) in
    if j == 0 then mov_mem_rbp_rdi(b, d)
    else if j == 1 then mov_mem_rbp_rsi(b, d)
    else if j == 2 then mov_mem_rbp_rdx(b, d)
    else if j == 3 then mov_mem_rbp_rcx(b, d)
    else if j == 4 then mov_mem_rbp_r8(b, d)
    else mov_mem_rbp_r9(b, d)
  else
    if j == 0 then mov_mem_rbp32_r64(b, off, 7)
    else if j == 1 then mov_mem_rbp32_r64(b, off, 6)
    else if j == 2 then mov_mem_rbp32_r64(b, off, 2)
    else if j == 3 then mov_mem_rbp32_r64(b, off, 1)
    else if j == 4 then mov_mem_rbp32_r64(b, off, 8)
    else mov_mem_rbp32_r64(b, off, 9)

/* yac_alloc(n in rdi) -> rax raw ptr.
 * Size lives at [obj-8], not in mark. First-fit gc_free (gc_head+32), else brk n+8.
 * GLOBALS+40 is bytes-since-GC; when it exceeds 16MiB call yac_gc.
 * GLOBALS+48 is heap_lo for GC stack bitmap. GLOBALS+56 is prof cell. */
let gen_alloc(d) =
  let b = bytes_new() in
  let _ = e8(b, 87) in
  let _ = mov_rax_imm64(b, 0) in
  let bumpaddr = bytes_len(b) - 8 in
  let _ = add_rax_imm8(b, 40) in
  let _ = e8(b, 72) in let _ = e8(b, 1) in let _ = e8(b, 56) in
  let _ = e8(b, 72) in let _ = e8(b, 129) in let _ = e8(b, 56) in
  let _ = e32(b, 16777216) in
  let _ = jcc_rel32(b, 6, 0) in
  let pjbe = bytes_len(b) - 4 in
  let _ = e8(b, 80) in
  let gccall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = e8(b, 88) in
  let _ = e8(b, 72) in let _ = e8(b, 199) in let _ = e8(b, 0) in
  let _ = e32(b, 0) in
  let _ = apply_patch(b, pjbe, bytes_len(b)) in
  let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 60) in let _ = e8(b, 36) in
  let _ = mov_rax_imm64(b, 0) in
  let headaddr = bytes_len(b) - 8 in
  let _ = mov_rbx_rax(b) in
  let _ = add_rax_imm8(b, 32) in
  let _ = mov_rdx_mem_rax(b) in
  let _ = xor_rcx_rcx(b) in
  let jfl = bytes_len(b) in
  let _ = test_rdx_rdx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pmiss = bytes_len(b) - 4 in
  let _ = cmp_mem_rdx_m8_rdi(b) in
  let _ = jcc_rel32(b, 3, 0) in
  let phit = bytes_len(b) - 4 in
  let _ = mov_rcx_rdx(b) in
  let _ = mov_rdx_mem_rdx(b) in
  let _ = jmp_rel32(b, 0) in
  let jflb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jflb, jfl) in
  let hit = bytes_len(b) in
  let _ = apply_patch(b, phit, hit) in
  let _ = mov_rsi_mem_rdx(b) in
  let _ = test_rcx_rcx(b) in
  let _ = jcc_rel32(b, 5, 0) in
  let pnf = bytes_len(b) - 4 in
  let _ = mov_mem_rax_rsi(b) in
  let _ = jmp_rel32(b, 0) in
  let pgot = bytes_len(b) - 4 in
  let nf = bytes_len(b) in
  let _ = apply_patch(b, pnf, nf) in
  let _ = mov_mem_rcx_rsi(b) in
  let got = bytes_len(b) in
  let _ = apply_patch(b, pgot, got) in
  let _ = e8(b, 95) in
  let _ = mov_rsi_mem_rbx(b) in
  let _ = mov_mem_rdx_rsi(b) in
  let _ = mov_mem_rbx_rdx(b) in
  let _ = mov_rax_rdx(b) in
  let _ = ret(b) in
  let miss = bytes_len(b) in
  let _ = apply_patch(b, pmiss, miss) in
  let _ = mov_r64_imm(b, 0, 12) in
  let _ = mov_rdi_imm(b, 0) in
  let _ = syscall(b) in
  let _ = mov_rsi_rax(b) in
  /* kernel brk may be 2-mod-8 (ELF filesz); objects must be 8-aligned or GC untag is off-by-one. */
  let _ = add_rsi_imm8(b, 7) in
  let _ = and_rsi_imm8(b, 248) in
  /* GLOBALS+48 = heap_lo (first aligned brk); bitmap mark uses [lo, brk). */
  let _ = cmp_mem_rbx_disp8_0(b, 48) in
  let _ = jcc_rel32(b, 5, 0) in
  let psetlo = bytes_len(b) - 4 in
  let _ = mov_mem_rbx_disp8_rsi(b, 48) in
  let _ = apply_patch(b, psetlo, bytes_len(b)) in
  let _ = e8(b, 95) in
  let _ = e8(b, 87) in
  let _ = lea_rdi_rsi_rdi(b) in
  let _ = lea_rdi_rdi_disp8(b, 8) in
  let _ = mov_r64_imm(b, 0, 12) in
  let _ = syscall(b) in
  let _ = pop_r64(b, 1) in
  let _ = mov_mem_rsi_rcx(b) in
  let _ = lea_rdx_rsi_disp8(b, 8) in
  let _ = mov_rsi_mem_rbx(b) in
  let _ = mov_mem_rdx_rsi(b) in
  let _ = mov_mem_rbx_rdx(b) in
  let _ = mov_rax_rdx(b) in
  let _ = ret(b) in
  [b, headaddr, bumpaddr, gccall]

/* yac_gc: clear marks, conservative-mark tagged slots [rsp, stack_hi),
 * unlink unmarked from gc_head onto gc_free (head+32). Size stays at [obj-8].
 * Scan from rsp so the caller's locals (below their rbp) are roots.
 * With heap_lo, mmap a bitset of live object addresses (O(heap) build,
 * O(1) per stack word); else walk gc_head. */
let gen_gc(_) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 48) in
  let _ = push_r64(b, 3) in
  let _ = push_r64(b, 6) in
  let _ = mov_rax_imm64(b, 0) in
  let headpos = bytes_len(b) - 8 in
  let _ = mov_mem_rbp8_rax(b) in
  let _ = xor_rax_rax(b) in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  let _ = mov_rax_imm64(b, 0) in
  let shipos = bytes_len(b) - 8 in
  let _ = mov_rax_mem_rax(b) in
  let _ = mov_mem_rbp_r64(b, 240, 0) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_rbx_mem_rax(b) in
  let jcl = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pcl = bytes_len(b) - 4 in
  let _ = mov_mem_rbx_disp8_imm32(b, 8, 0) in
  let _ = mov_rbx_mem_rbx(b) in
  let _ = jmp_rel32(b, 0) in
  let jclb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jclb, jcl) in
  let cldone = bytes_len(b) in
  let _ = apply_patch(b, pcl, cldone) in
  /* Optional object bitmap: one bit per 8-byte heap slot. Stack mark is then
   * O(stack) instead of walking gc_head per word. mmap ANON; fallback = list. */
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_rax_rax_disp8(b, 48) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pnobm = bytes_len(b) - 4 in
  let _ = mov_mem_rbp_r64(b, 224, 0) in
  let _ = mov_r64_imm(b, 0, 12) in
  let _ = mov_rdi_imm(b, 0) in
  let _ = syscall(b) in
  let _ = mov_mem_rbp_r64(b, 216, 0) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 2, 224) in
  let _ = sub_rsi_rdx(b) in
  let _ = add_rsi_imm8(b, 63) in
  let _ = shr_rsi_imm8(b, 6) in
  let _ = test_rsi_rsi(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pnobm2 = bytes_len(b) - 4 in
  /* REX.W bts [addr],bit reads an 8-byte qword; pad so the last byte is safe. */
  let _ = add_rsi_imm8(b, 8) in
  let _ = mov_mem_rbp_r64(b, 208, 6) in
  let _ = mov_rdi_imm(b, 0) in
  let _ = mov_rdx_imm(b, 3) in
  let _ = mov_rax_imm64(b, 34) in
  let _ = mov_r10_rax(b) in
  let _ = mov_rax_imm64(b, 0 - 1) in
  let _ = mov_r8_rax(b) in
  let _ = xor_r9_r9(b) in
  let _ = mov_r64_imm(b, 0, 9) in
  let _ = syscall(b) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 8, 0) in
  let pnobm3 = bytes_len(b) - 4 in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_rbx_mem_rax(b) in
  let jfill = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pfilld = bytes_len(b) - 4 in
  let _ = mov_r64_r64(b, 1, 3) in
  let _ = cmp_rcx_mem_rbp(b, 224) in
  let _ = jcc_rel32(b, 2, 0) in
  let pfillsk0 = bytes_len(b) - 4 in
  let _ = cmp_rcx_mem_rbp(b, 216) in
  let _ = jcc_rel32(b, 3, 0) in
  let pfillsk1 = bytes_len(b) - 4 in
  let _ = mov_rdx_rbx(b) in
  let _ = sub_rdx_mem_rbp(b, 224) in
  let _ = shr_rdx_imm8(b, 3) in
  let _ = mov_rcx_rdx(b) in
  let _ = shr_rdx_imm8(b, 3) in
  let _ = and_ecx_7(b) in
  let _ = add_rdx_mem_rbp(b, 232) in
  let _ = bts_mem_rdx_rcx(b) in
  let fillnxt = bytes_len(b) in
  let _ = apply_patch(b, pfillsk0, fillnxt) in
  let _ = apply_patch(b, pfillsk1, fillnxt) in
  let _ = mov_rbx_mem_rbx(b) in
  let _ = jmp_rel32(b, 0) in
  let jfillb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jfillb, jfill) in
  let filldone = bytes_len(b) in
  let _ = apply_patch(b, pfilld, filldone) in
  let _ = apply_patch(b, pnobm, filldone) in
  let _ = apply_patch(b, pnobm2, filldone) in
  let _ = apply_patch(b, pnobm3, filldone) in
  let _ = lea_rsi_rsp(b) in
  let jsc = bytes_len(b) in
  let _ = mov_rdi_mem_rbp(b, 240) in
  let _ = cmp_rsi_rdi(b) in
  let _ = jcc_rel32(b, 3, 0) in
  let pscd = bytes_len(b) - 4 in
  let _ = mov_rax_mem_rsi(b) in
  let _ = push_r64(b, 6) in
  let cscan = bytes_len(b) + 1 in
  let _ = call_rel32(b, 0) in
  let _ = pop_r64(b, 6) in
  let _ = add_rsi_imm8(b, 8) in
  let _ = jmp_rel32(b, 0) in
  let jscb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jscb, jsc) in
  let scdone = bytes_len(b) in
  let _ = apply_patch(b, pscd, scdone) in
  let _ = xor_rcx_rcx(b) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_rbx_mem_rax(b) in
  let jsw = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pswd = bytes_len(b) - 4 in
  let _ = mov_rsi_mem_rbx(b) in
  let _ = mov_rax_rbx_disp8(b, 8) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pdead = bytes_len(b) - 4 in
  let _ = mov_rcx_rbx(b) in
  let _ = mov_rbx_rax(b) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 243) in
  let _ = jmp_rel32(b, 0) in
  let jliveb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jliveb, jsw) in
  let dead = bytes_len(b) in
  let _ = apply_patch(b, pdead, dead) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = add_rax_imm8(b, 32) in
  let _ = mov_rdx_mem_rax(b) in
  let _ = mov_mem_rbx_rdx(b) in
  let _ = mov_mem_rax_rbx(b) in
  let _ = test_rcx_rcx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pfirst = bytes_len(b) - 4 in
  let _ = mov_mem_rcx_rsi(b) in
  let _ = mov_rbx_rax(b) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 243) in
  let _ = jmp_rel32(b, 0) in
  let junlb = bytes_len(b) - 4 in
  let _ = apply_patch(b, junlb, jsw) in
  let firstd = bytes_len(b) in
  let _ = apply_patch(b, pfirst, firstd) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_mem_rax_rsi(b) in
  let _ = mov_rbx_rax(b) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 243) in
  let _ = jmp_rel32(b, 0) in
  let jfstb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jfstb, jsw) in
  let swdone = bytes_len(b) in
  let _ = apply_patch(b, pswd, swdone) in
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let punmap = bytes_len(b) - 4 in
  let _ = mov_rdi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 6, 208) in
  let _ = mov_r64_imm(b, 0, 11) in
  let _ = syscall(b) in
  let _ = apply_patch(b, punmap, bytes_len(b)) in
  let _ = pop_r64(b, 6) in
  let _ = pop_r64(b, 3) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = xor_rax_rax(b) in
  let _ = ret(b) in
  /* mark_fast: children of already-found objects skip the O(n) list walk. */
  let mark_fast = bytes_len(b) in
  let _ = test_rax_1(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pfe = bytes_len(b) - 4 in
  let _ = cmp_rax_imm8(b, 1) in
  let _ = jcc_rel32(b, 4, 0) in
  let pfe2 = bytes_len(b) - 4 in
  let _ = and_rax_1(b) in
  let _ = e8(b, 168) in let _ = e8(b, 7) in
  let _ = jcc_rel32(b, 5, 0) in
  let pfe3 = bytes_len(b) - 4 in
  let _ = mov_rbx_rax(b) in
  let _ = jmp_rel32(b, 0) in
  let pfh = bytes_len(b) - 4 in
  let mark = bytes_len(b) in
  let _ = apply_patch(b, cscan, mark) in
  let _ = test_rax_1(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pme = bytes_len(b) - 4 in
  let _ = cmp_rax_imm8(b, 1) in
  let _ = jcc_rel32(b, 4, 0) in
  let pme2 = bytes_len(b) - 4 in
  let _ = and_rax_1(b) in
  let _ = mov_rcx_rax(b) in
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pslow = bytes_len(b) - 4 in
  let _ = cmp_rcx_mem_rbp(b, 224) in
  let _ = jcc_rel32(b, 2, 0) in
  let pbm0 = bytes_len(b) - 4 in
  let _ = cmp_rcx_mem_rbp(b, 216) in
  let _ = jcc_rel32(b, 3, 0) in
  let pbm1 = bytes_len(b) - 4 in
  let _ = test_rcx_7(b) in
  let _ = jcc_rel32(b, 5, 0) in
  let pbm2 = bytes_len(b) - 4 in
  let _ = mov_rdx_rcx(b) in
  let _ = sub_rdx_mem_rbp(b, 224) in
  let _ = shr_rdx_imm8(b, 3) in
  let _ = mov_r64_r64(b, 6, 1) in
  let _ = mov_rcx_rdx(b) in
  let _ = shr_rdx_imm8(b, 3) in
  let _ = and_ecx_7(b) in
  let _ = add_rdx_mem_rbp(b, 232) in
  let _ = bt_mem_rdx_rcx(b) in
  let _ = jcc_rel32(b, 3, 0) in
  let pbm3 = bytes_len(b) - 4 in
  let _ = mov_r64_r64(b, 3, 6) in
  let _ = jmp_rel32(b, 0) in
  let pbhit = bytes_len(b) - 4 in
  let slowmk = bytes_len(b) in
  let _ = apply_patch(b, pslow, slowmk) in
  let _ = mov_rax_mem_rbp8(b) in
  let _ = mov_rbx_mem_rax(b) in
  let jmf = bytes_len(b) in
  let _ = test_rbx_rbx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pmf = bytes_len(b) - 4 in
  let _ = cmp_rbx_rcx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pmh = bytes_len(b) - 4 in
  let _ = mov_rbx_mem_rbx(b) in
  let _ = jmp_rel32(b, 0) in
  let jmfb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jmfb, jmf) in
  let mhit = bytes_len(b) in
  let _ = apply_patch(b, pmh, mhit) in
  let _ = apply_patch(b, pfh, mhit) in
  let _ = apply_patch(b, pbhit, mhit) in
  let _ = mov_rax_rbx_disp8(b, 8) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 5, 0) in
  let palr = bytes_len(b) - 4 in
  let _ = mov_mem_rbx_disp8_imm32(b, 8, 1) in
  let _ = mov_rax_rbx_disp8(b, 16) in
  let _ = cmp_rax_imm8(b, 2) in
  let _ = jcc_rel32(b, 4, 0) in
  let pcons = bytes_len(b) - 4 in
  let _ = cmp_rax_imm8(b, 5) in
  let _ = jcc_rel32(b, 4, 0) in
  let plbuf = bytes_len(b) - 4 in
  let _ = cmp_rax_imm8(b, 3) in
  let _ = jcc_rel32(b, 4, 0) in
  let pstr = bytes_len(b) - 4 in
  let _ = cmp_rax_imm8(b, 4) in
  let _ = jcc_rel32(b, 4, 0) in
  let pbyt = bytes_len(b) - 4 in
  let _ = mov_rax_rbx_disp8(b, 24) in
  let _ = mov_rcx_rax(b) in
  let _ = lea_rsi_rbx_disp8(b, 32) in
  let jcap = bytes_len(b) in
  let _ = test_rcx_rcx(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let pcapd = bytes_len(b) - 4 in
  let _ = push_r64(b, 3) in
  let _ = push_r64(b, 1) in
  let _ = push_r64(b, 6) in
  let _ = push_r64(b, 1) in
  let _ = mov_rax_mem_rsi(b) in
  let ccap = bytes_len(b) + 1 in
  let _ = call_rel32(b, 0) in
  let _ = pop_r64(b, 1) in
  let _ = pop_r64(b, 6) in
  let _ = pop_r64(b, 1) in
  let _ = pop_r64(b, 3) in
  let _ = add_rsi_imm8(b, 8) in
  let _ = dec_rcx(b) in
  let _ = jmp_rel32(b, 0) in
  let jcapb = bytes_len(b) - 4 in
  let _ = apply_patch(b, jcapb, jcap) in
  let _ = apply_patch(b, ccap, mark_fast) in
  let capd = bytes_len(b) in
  let _ = apply_patch(b, pcapd, capd) in
  let _ = jmp_rel32(b, 0) in
  let pmr1 = bytes_len(b) - 4 in
  let consa = bytes_len(b) in
  let _ = apply_patch(b, pcons, consa) in
  let _ = push_r64(b, 3) in
  let _ = push_r64(b, 3) in
  let _ = mov_rax_rbx_disp8(b, 24) in
  let ccar = bytes_len(b) + 1 in
  let _ = call_rel32(b, 0) in
  let _ = pop_r64(b, 3) in
  let _ = pop_r64(b, 3) in
  let _ = mov_rax_rbx_disp8(b, 32) in
  let _ = jmp_rel32(b, 0) in
  let ptail1 = bytes_len(b) - 4 in
  let lbufa = bytes_len(b) in
  let _ = apply_patch(b, plbuf, lbufa) in
  let _ = mov_rax_rbx_disp8(b, 32) in
  let _ = jmp_rel32(b, 0) in
  let ptail2 = bytes_len(b) - 4 in
  let byta = bytes_len(b) in
  let _ = apply_patch(b, pbyt, byta) in
  let _ = mov_rax_rbx_disp8(b, 40) in
  let _ = jmp_rel32(b, 0) in
  let ptail3 = bytes_len(b) - 4 in
  let mret = bytes_len(b) in
  let _ = apply_patch(b, pme, mret) in
  let _ = apply_patch(b, pme2, mret) in
  let _ = apply_patch(b, pbm0, mret) in
  let _ = apply_patch(b, pbm1, mret) in
  let _ = apply_patch(b, pbm2, mret) in
  let _ = apply_patch(b, pbm3, mret) in
  let _ = apply_patch(b, pfe, mret) in
  let _ = apply_patch(b, pfe2, mret) in
  let _ = apply_patch(b, pfe3, mret) in
  let _ = apply_patch(b, pmf, mret) in
  let _ = apply_patch(b, palr, mret) in
  let _ = apply_patch(b, pstr, mret) in
  let _ = apply_patch(b, pmr1, mret) in
  let _ = apply_patch(b, ccar, mark_fast) in
  let _ = apply_patch(b, ptail1, mark_fast) in
  let _ = apply_patch(b, ptail2, mark_fast) in
  let _ = apply_patch(b, ptail3, mark_fast) in
  let _ = ret(b) in
  [b, headpos, shipos]

/* write a single newline via syscall: push '\n'; rsi=rsp; write(1,"\n",1) */
let emit_newline(b) =
  let _ = e8(b, 106) in       /* push imm8 */
  let _ = e8(b, 10) in        /* '\n' */
  let _ = mov_rsi_rsp(b) in
  let _ = mov_rdx_imm(b, 1) in
  let _ = mov_rdi_imm(b, 1) in
  let _ = mov_r64_imm(b, 0, 1) in
  let _ = syscall(b) in
  let _ = e8(b, 72) in        /* add rsp, 8 (48 83 c4 08) */
  let _ = e8(b, 131) in
  let _ = e8(b, 196) in
  let _ = e8(b, 8) in
  0

let cc_of(op) =
  if op == "<" then 12 else if op == "<=" then 14
  else if op == ">" then 15 else if op == ">=" then 13
  else if op == "==" then 4 else 5

/* yac_argv: C char** from saved_argv. Not LIR — odd C pointers cannot be tagged ints. */
let gen_argv(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 48) in
  let _ = mov_rax_rdi(b) in
  let _ = sar_rax_1(b) in
  let _ = mov_rcx_rax(b) in
  let _ = mov_rax_imm64(b, 0) in
  let acpat = bytes_len(b) - 8 in
  let _ = mov_rax_mem_rax(b) in
  let _ = cmp_rcx_rax(b) in
  let _ = jcc_rel32(b, 3, 0) in   /* jae: fail if index >= argc */
  let jfail = bytes_len(b) - 4 in
  let _ = mov_rax_imm64(b, 0) in
  let avpat = bytes_len(b) - 8 in
  let _ = mov_rax_mem_rax(b) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_rax_mem_rsi_rcx8(b) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 4, 0) in
  let jnull = bytes_len(b) - 4 in
  let _ = mov_mem_rbp_r64(b, 248, 0) in
  let _ = xor_rdx_rdx(b) in
  let slen = bytes_len(b) in
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = e8(b, 128) in let _ = e8(b, 60) in let _ = e8(b, 23) in let _ = e8(b, 0) in
  let _ = jcc_rel32(b, 4, 0) in
  let jslen = bytes_len(b) - 4 in
  let _ = inc_rdx(b) in
  let _ = jmp_rel32(b, 0) in
  let jbslen = bytes_len(b) - 4 in
  let _ = apply_patch(b, jbslen, slen) in
  let slend = bytes_len(b) in
  let _ = apply_patch(b, jslen, slend) in
  let _ = mov_mem_rbp_r64(b, 240, 2) in
  let _ = mov_rdi_rdx(b) in
  let _ = add_rdi_imm32(b, 33) in
  let acall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = and_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  let _ = mov_rax_disp8_imm32(b, 8, 0) in
  let _ = mov_rax_disp8_imm32(b, 16, 3) in
  let _ = mov_rax_disp8_imm32(b, 20, 0) in
  let _ = mov_r64_mem_rbp(b, 2, 240) in
  let _ = mov_rax_disp8_rdx(b, 24) in
  let _ = xor_rdx_rdx(b) in
  let cpy = bytes_len(b) in
  let _ = mov_r64_mem_rbp(b, 1, 240) in   /* rcx = len (reg 1, not rdx=2) */
  let _ = cmp_rdx_rcx(b) in
  let _ = jcc_rel32(b, 3, 0) in          /* jae cpyend */
  let jcpy = bytes_len(b) - 4 in
  let _ = mov_r64_mem_rbp(b, 7, 248) in  /* rdi = src cstr */
  let _ = movzx_eax_rdi_rdx(b) in
  let _ = mov_r64_r64(b, 1, 0) in        /* rcx = al (save byte across rax clobber) */
  let _ = mov_r64_mem_rbp(b, 3, 232) in  /* rbx = dst obj */
  let _ = mov_r64_r64(b, 0, 3) in
  let _ = add_rax_imm32(b, 32) in
  let _ = e8(b, 136) in let _ = e8(b, 12) in let _ = e8(b, 16) in /* mov [rax+rdx], cl */
  let _ = inc_rdx(b) in
  let _ = jmp_rel32(b, 0) in
  let jbcpy = bytes_len(b) - 4 in
  let _ = apply_patch(b, jbcpy, cpy) in
  let cpyend = bytes_len(b) in
  let _ = apply_patch(b, jcpy, cpyend) in
  let _ = mov_r64_mem_rbp(b, 3, 232) in
  let _ = mov_r64_mem_rbp(b, 2, 240) in
  let _ = mov_r64_r64(b, 0, 3) in
  let _ = add_rax_imm32(b, 32) in
  let _ = e8(b, 198) in let _ = e8(b, 4) in let _ = e8(b, 16) in let _ = e8(b, 0) in /* mov [rax+rdx], 0 */
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  let fail = bytes_len(b) in
  let _ = apply_patch(b, jfail, fail) in
  let _ = apply_patch(b, jnull, fail) in
  let _ = xor_rax_rax(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, acpat, avpat, acall + 1]

/* yac_read_file(path STR in rdi) -> STR in rax.
 * Size via lseek(SEEK_END); no 64KiB cap. Returns [bytes, allocCallRelPos].
 * Frame: [rbp-8]=fd [rbp-16]=obj [rbp-24]=size. */
let gen_read_file(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 32) in
  /* rdi = tagged path → cstr at +32 */
  let _ = mov_rax_rdi(b) in
  let _ = and_rax_1(b) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rdi_rax(b) in
  let _ = xor_rax_rax(b) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_r64_imm(b, 0, 2) in
  let _ = syscall(b) in
  let _ = mov_mem_rbp_r64(b, 248, 0) in
  /* lseek(fd, 0, SEEK_END=2) */
  let _ = mov_rdi_rax(b) in
  let _ = xor_rax_rax(b) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_rdx_imm(b, 2) in
  let _ = mov_r64_imm(b, 0, 8) in
  let _ = syscall(b) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 9, 0) in
  let jns1 = bytes_len(b) - 4 in
  let _ = xor_rax_rax(b) in
  let ok1 = bytes_len(b) in
  let _ = apply_patch(b, jns1, ok1) in
  let _ = mov_mem_rbp_r64(b, 232, 0) in
  /* lseek(fd, 0, SEEK_SET=0) */
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = xor_rax_rax(b) in
  let _ = mov_rsi_rax(b) in
  let _ = xor_rdx_rdx(b) in
  let _ = mov_r64_imm(b, 0, 8) in
  let _ = syscall(b) in
  /* alloc 8-aligned (32 + size + 1) */
  let _ = mov_r64_mem_rbp(b, 0, 232) in
  let _ = add_rax_imm32(b, 33) in
  let _ = add_rax_imm8(b, 7) in
  let _ = e8(b, 72) in let _ = e8(b, 131) in let _ = e8(b, 224) in let _ = e8(b, 248) in
  let _ = mov_rdi_rax(b) in
  let acall = bytes_len(b) in
  let _ = call_rel32(b, 0) in
  let _ = and_rax_1(b) in
  let _ = mov_mem_rbp_r64(b, 240, 0) in
  let _ = mov_rax_disp8_imm32(b, 8, 0) in
  let _ = mov_rax_disp8_imm32(b, 16, 3) in
  let _ = mov_rax_disp8_imm32(b, 20, 0) in
  let _ = mov_rax_disp8_imm32(b, 24, 0) in
  let _ = mov_rax_disp8_imm32(b, 28, 0) in
  /* read(fd, obj+32, size) */
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rsi_rax(b) in
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = mov_r64_mem_rbp(b, 2, 232) in
  let _ = mov_r64_imm(b, 0, 0) in
  let _ = syscall(b) in
  let _ = test_rax_rax(b) in
  let _ = jcc_rel32(b, 9, 0) in
  let jns2 = bytes_len(b) - 4 in
  let _ = xor_rax_rax(b) in
  let ok2 = bytes_len(b) in
  let _ = apply_patch(b, jns2, ok2) in
  /* rbx=nread; [obj+24]=nread; NUL at obj+32+nread */
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 195) in
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 88) in let _ = e8(b, 24) in
  let _ = add_rax_imm32(b, 32) in
  let _ = add_rax_rbx(b) in
  let _ = mov_rax_disp8_imm8(b, 0, 0) in
  /* close(fd) */
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = mov_r64_imm(b, 0, 3) in
  let _ = syscall(b) in
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = or_rax_1(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  [b, acall + 1]

/* yac_write_file(path STR rdi, data BYTES|STR rsi) -> 0 */
let gen_write_file(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 32) in
  let _ = mov_mem_rbp_rsi(b, 240) in
  let _ = mov_rax_rdi(b) in
  let _ = and_rax_1(b) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rdi_rax(b) in
  /* open(path, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420) */
  let _ = e8(b, 72) in let _ = e8(b, 199) in let _ = e8(b, 198) in
  let _ = e32(b, 577) in
  let _ = mov_rdx_imm(b, 420) in
  let _ = mov_r64_imm(b, 0, 2) in
  let _ = syscall(b) in
  let _ = mov_mem_rbp_r64(b, 248, 0) in
  let _ = mov_r64_mem_rbp(b, 0, 240) in
  let _ = and_rax_1(b) in
  /* rbx = obj */
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 195) in
  let _ = mov_rax_rax_disp8(b, 16) in
  let _ = cmp_rax_imm8(b, 4) in
  let _ = jcc_rel32(b, 5, 0) in
  let jnestr = bytes_len(b) - 4 in
  /* BYTES path (kind==4): dataptr@40 is tagged STR blob, payload at +32 */
  let _ = mov_rax_rbx_disp8(b, 40) in
  let _ = and_rax_1(b) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rsi_rax(b) in
  let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 67) in let _ = e8(b, 24) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
  let _ = jmp_rel32(b, 0) in
  let jdo = bytes_len(b) - 4 in
  let dostr = bytes_len(b) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 216) in
  let _ = add_rax_imm32(b, 32) in
  let _ = mov_rsi_rax(b) in
  let _ = e8(b, 72) in let _ = e8(b, 139) in let _ = e8(b, 67) in let _ = e8(b, 24) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
  let dowrite = bytes_len(b) in
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = mov_r64_imm(b, 0, 1) in
  let _ = syscall(b) in
  let _ = mov_r64_mem_rbp(b, 7, 248) in
  let _ = mov_r64_imm(b, 0, 3) in
  let _ = syscall(b) in
  let _ = xor_rax_rax(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  let _ = apply_patch(b, jnestr, dostr) in
  let _ = apply_patch(b, jdo, dowrite) in
  b

/* yac_apply2(clos rdi, a0 rsi, a1 rdx) — dynamic nenv, 2 user args.
 * Returns nothing special; result in rax. */
let gen_apply2(d) =
  let b = bytes_new() in
  let _ = push_rbp(b) in
  let _ = mov_rbp_rsp(b) in
  let _ = sub_rsp_imm8(b, 32) in
  let _ = mov_mem_rbp_rsi(b, 248) in
  let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 85) in let _ = e8(b, 240) in
  let _ = mov_rax_rdi(b) in
  let _ = and_rax_1(b) in
  let _ = mov_rbx_rax_disp8(b, 16) in
  let _ = mov_r11d_rax_disp8(b, 24) in
  let loadcap(i) =
    if i >= 6 then 0
    else
      let _ = cmp_r11_imm8(b, i) in
      let _ = e8(b, 126) in
      let offpos = bytes_len(b) in
      let _ = e8(b, 0) in
      let m0 = bytes_len(b) in
      let _ = mov_argreg_rax_disp8(b, i, 32 + i * 8) in
      let m1 = bytes_len(b) in
      let _ = bytes_put(b, offpos, m1 - m0) in
      loadcap(i + 1) in
  let _ = loadcap(0) in
  let _ = cmp_r11_imm8(b, 0) in
  let _ = jcc_rel32(b, 4, 0) in
  let r0 = bytes_len(b) - 4 in
  let _ = cmp_r11_imm8(b, 1) in
  let _ = jcc_rel32(b, 4, 0) in
  let r1 = bytes_len(b) - 4 in
  let _ = cmp_r11_imm8(b, 2) in
  let _ = jcc_rel32(b, 4, 0) in
  let r2 = bytes_len(b) - 4 in
  let _ = cmp_r11_imm8(b, 3) in
  let _ = jcc_rel32(b, 4, 0) in
  let r3 = bytes_len(b) - 4 in
  let _ = cmp_r11_imm8(b, 4) in
  let _ = jcc_rel32(b, 4, 0) in
  let r4 = bytes_len(b) - 4 in
  let _ = jmp_rel32(b, 0) in
  let r5 = bytes_len(b) - 4 in
  let setusers(base) =
    let _ = mov_r64_mem_rbp(b, 0, 248) in
    let _ = mov_rax_to_argreg(b, base) in
    let _ = mov_r64_mem_rbp(b, 0, 240) in
    mov_rax_to_argreg(b, base + 1) in
  let a0 = bytes_len(b) in
  let _ = setusers(0) in
  let _ = jmp_rel32(b, 0) in
  let j0 = bytes_len(b) - 4 in
  let a1 = bytes_len(b) in
  let _ = setusers(1) in
  let _ = jmp_rel32(b, 0) in
  let j1 = bytes_len(b) - 4 in
  let a2 = bytes_len(b) in
  let _ = setusers(2) in
  let _ = jmp_rel32(b, 0) in
  let j2 = bytes_len(b) - 4 in
  let a3 = bytes_len(b) in
  let _ = setusers(3) in
  let _ = jmp_rel32(b, 0) in
  let j3 = bytes_len(b) - 4 in
  let a4 = bytes_len(b) in
  let _ = setusers(4) in
  let _ = jmp_rel32(b, 0) in
  let j4 = bytes_len(b) - 4 in
  let a5 = bytes_len(b) in
  let _ = setusers(5) in
  let _ = jmp_rel32(b, 0) in
  let j5 = bytes_len(b) - 4 in
  let lc = bytes_len(b) in
  let _ = call_rbx(b) in
  let _ = mov_rsp_rbp(b) in
  let _ = pop_rbp(b) in
  let _ = ret(b) in
  let _ = apply_patch(b, r0, a0) in
  let _ = apply_patch(b, r1, a1) in
  let _ = apply_patch(b, r2, a2) in
  let _ = apply_patch(b, r3, a3) in
  let _ = apply_patch(b, r4, a4) in
  let _ = apply_patch(b, r5, a5) in
  let _ = apply_patch(b, j0, lc) in
  let _ = apply_patch(b, j1, lc) in
  let _ = apply_patch(b, j2, lc) in
  let _ = apply_patch(b, j3, lc) in
  let _ = apply_patch(b, j4, lc) in
  let _ = apply_patch(b, j5, lc) in
  b

/* yac_apply1(clos rdi, a0 rsi) */
let gen_apply1(d) =
  let b = bytes_new() in
