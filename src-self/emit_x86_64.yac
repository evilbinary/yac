      let done = bytes_len(b) in
      let _ = apply_patch(b, jdone, done) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "str_ref" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = mov_r64_r64(b, 2, 7) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 250) in
      let _ = add_rax_imm32(b, 32) in
      let _ = movzx_eax_rax_rdx(b) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_new" then
      /* BYTES: [next][mark][kind=4][len][cap][data...] initial cap=1048576 */
      let dst = nth(insn, 1) in
      let _ = mov_rdi_imm(b, 40 + 1048576) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_disp8_imm32(b, 8, 0) in
      let _ = mov_rax_disp8_imm32(b, 16, 4) in
      let _ = mov_rax_disp8_imm32(b, 20, 0) in
      let _ = mov_rax_disp8_imm32(b, 24, 0) in
      let _ = mov_rax_disp8_imm32(b, 28, 0) in
      let _ = mov_rax_disp8_imm32(b, 32, 1048576) in
      let _ = mov_rax_disp8_imm32(b, 36, 0) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_alloc"], patches)]
    else if k == "bytes_len" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = mov_rax_rax_disp8(b, 24) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_ref" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = mov_rbx_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rdx_rax(b) in
      let _ = sar_rdx_1(b) in
      let _ = mov_rax_rbx(b) in
      let _ = add_rax_imm32(b, 40) in
      let _ = movzx_eax_rax_rdx(b) in
      let _ = shl_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_put" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = mov_rbx_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rdx_rax(b) in
      let _ = sar_rdx_1(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 4)) in
      let _ = mov_rdi_rax(b) in
      let _ = sar_rdi_1(b) in
      let _ = mov_rax_rbx(b) in
      let _ = add_rax_imm32(b, 40) in
      let _ = mov_rax_rdx_dil(b) in
      let _ = mov_rcx_rdx(b) in
      let _ = inc_rcx(b) in
      let _ = mov_rax_rbx_disp8(b, 24) in
      let _ = cmp_rcx_rax(b) in
      let _ = jcc_rel32(b, 6, 0) in
      let jskip = bytes_len(b) - 4 in
      let _ = mov_mem_rbx_disp8_rcx(b, 24) in
      let skip = bytes_len(b) in
      let _ = apply_patch(b, jskip, skip) in
      let _ = xor_rax_rax(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_append" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = and_rax_1(b) in
      let _ = push_r64(b, 0) in
      let _ = emit_load_rdi_slot(b, nth(insn, 3)) in
      let _ = e8(b, 72) in let _ = e8(b, 209) in let _ = e8(b, 255) in
      let _ = pop_r64(b, 0) in
      let _ = mov_rdx_rax_disp8(b, 24) in
      let _ = push_r64(b, 0) in
      let _ = add_rax_imm32(b, 40) in
      let _ = e8(b, 72) in let _ = e8(b, 1) in let _ = e8(b, 208) in
      let _ = e8(b, 64) in let _ = e8(b, 136) in let _ = e8(b, 56) in
      let _ = pop_r64(b, 0) in
      let _ = inc_mem_rax_disp8(b, 24) in
      let _ = or_rax_1(b) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, patches]
    else if k == "bytes_extend" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_bytes_extend"], patches)]
    else if k == "str_cat" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_str_cat"], patches)]
    else if k == "str_slice" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 4)) in
      let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_str_slice"], patches)]
    else if k == "int_to_str" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_int_to_str"], patches)]
    else if k == "bytes_to_str" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_bytes_to_str"], patches)]
    else if k == "drop" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_drop"], patches)]
    else if k == "foldl" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 4)) in
      let _ = e8(b, 72) in let _ = e8(b, 137) in let _ = e8(b, 194) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_foldl"], patches)]
    else if k == "map" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_map"], patches)]
    else if k == "read_file" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_read_file"], patches)]
    else if k == "write_file" then
      let dst = nth(insn, 1) in
      let _ = emit_load_rax_slot(b, nth(insn, 2)) in
      let _ = mov_rdi_rax(b) in
      let _ = emit_load_rax_slot(b, nth(insn, 3)) in
      let _ = mov_rsi_rax(b) in
      let acall = bytes_len(b) in
      let _ = call_rel32(b, 0) in
      let _ = emit_store_rax_slot(b, dst) in
      [b, cur, labels, cons([acall + 1, "yac_write_file"], patches)]
    else [b, cur, labels, patches] in
  /* update cur by the ACTUAL bytes appended */
  let newlen = bytes_len(b) in
  [nth(done, 0), cur + (newlen - len0), nth(done, 2), nth(done, 3)]


/* Resolve patches that target labels defined in this function; keep the rest
 * (calls to other funs / runtime). Labels are not unique across functions.
 * Index-based to avoid O(n²) drop. */
let resolve_local_labels(b, labels, patches) =
  let n = len(patches) in
  let keep = list_new() in
  let step(i) =
    if i >= n then keep
    else
      let p = nth(patches, i) in
      let hd = nth(p, 0) in
      let _ =
        if hd == "closurefn" or hd == "gc_head" or hd == "saved_argc" or hd == "saved_argv" then list_push(keep, p)
        else if label_has(labels, nth(p, 1)) then
          apply_patch(b, nth(p, 0), lookup_name(labels, nth(p, 1)))
        else list_push(keep, p) in
      step(i + 1) in
  step(0)

let emit_program_at(prog, load_vaddr, text_off) =
  let funs = nth(prog, 1) in
  let nfun = len(funs) in
  let _ = log_i("emit", "nfun", nfun) in
  let entry = nth(prog, 2) in
  let out = bytes_new() in
  /* [code, cur, labels, globalPatches]. Per-fun patches start empty so
   * resolve_local_labels is O(patches_in_fun), not O(total_patches). */
  let glob = [out, 0, [], list_new()] in
  let funOffsRev = [] in
  let emit_fun(i, st, fo) =
    if i >= nfun then [st, fo]
    else
      let _ =
        if i == 0 or ((i % 20) == 0) then log_i("emit", "fun", i) else 0 in
      let f = nth(funs, i) in
      let name = nth(f, 1) in
      let is_entry = name == entry in
      let fstart = nth(st, 1) in
      let st0 = [nth(st, 0), nth(st, 1), [], []] in
      let insns = nth(f, 4) in
      if len(insns) == 0 then emit_fun(i + 1, st, fo)
      else
        let run(j, s) =
        if j >= len(insns) then s
        else run(j + 1, emit_insn(s, nth(insns, j), is_entry)) in
      let s1 = run(0, st0) in
      let b = nth(s1, 0) in
      let kept = resolve_local_labels(b, nth(s1, 2), nth(s1, 3)) in
      let _ = patches_extend(nth(st, 3), kept) in
      let s2 = [b, nth(s1, 1), [], nth(st, 3)] in
      emit_fun(i + 1, s2, cons([name, fstart], fo)) in
  let r1 = emit_fun(0, glob, []) in
  let _ = log("emit", "funs done") in
  let st = nth(r1, 0) in
  let funOffsRev = nth(r1, 1) in
  let labels = nth(st, 2) in
  let patches = nth(st, 3) in
  let b = nth(st, 0) in
  let _ = log("emit", "helpers") in
  /* append runtime helpers (print_int, yac_alloc, gc_collect) and register offsets */
  let pi_off = bytes_len(b) in
  let _ = b_append(b, gen_print_int(0)) in
  let tm_off = bytes_len(b) in
  let _ = b_append(b, gen_time_ms(0)) in
  let tsr = gen_time_str(0) in
  let ts_off = bytes_len(b) in
  let _ = b_append(b, nth(tsr, 0)) in
  let ts_acall = nth(tsr, 1) in
  let alc_off = bytes_len(b) in
  let alcr = gen_alloc(0) in
  let _ = b_append(b, nth(alcr, 0)) in
  let alc_headaddr = nth(alcr, 1) in
  let gc_call_patch = nth(alcr, 2) in
  let rfr = gen_read_file(0) in
  let rf_off = bytes_len(b) in
  let _ = b_append(b, nth(rfr, 0)) in
  let wf_off = bytes_len(b) in
  let _ = b_append(b, gen_write_file(0)) in
  let a2_off = bytes_len(b) in
  let _ = b_append(b, gen_apply2(0)) in
  let a1_off = bytes_len(b) in
  let _ = b_append(b, gen_apply1(0)) in
  let gc_off = bytes_len(b) in
  let gcr = gen_gc(0) in
  let _ = b_append(b, nth(gcr, 0)) in
  let gc_headaddr = nth(gcr, 1) in
  let agr = gen_argc(0) in
  let ag_off = bytes_len(b) in
  let _ = b_append(b, nth(agr, 0)) in
  let avr = gen_argv(0) in
  let av_off = bytes_len(b) in
  let _ = b_append(b, nth(avr, 0)) in
  let funOffsRev2 = cons(["gc_collect", gc_off],
                         cons(["yac_apply1", a1_off],
                              cons(["yac_apply2", a2_off],
                                   cons(["yac_write_file", wf_off],
                                        cons(["yac_read_file", rf_off],
                                             cons(["yac_alloc", alc_off],
                                                  cons(["yac_argv", av_off],
                                                       cons(["yac_argc", ag_off],
                                                            cons(["time_str", ts_off],
                                                                 cons(["time_ms", tm_off],
                                                                      cons(["print_int", pi_off], funOffsRev))))))))))) in
  let LOAD_VADDR = load_vaddr in
  let TEXT_OFF = text_off in
  /* writable globals: gc head, saved_argc, saved_argv (8 bytes each). */
  let data_start = bytes_len(b) in
  let fill_data(i) =
    if i >= 24 then 0
    else let _ = bytes_append(b, 0) in fill_data(i + 1) in
  let _ = fill_data(0) in
  let GLOBALS_BASE = LOAD_VADDR + TEXT_OFF + data_start in
  let funOffsMap = emit_map_from_list(funOffsRev2) in
  let resolve(ps) =
    let n = len(ps) in
    let step(i) =
      if i >= n then 0
      else
        let p = nth(ps, i) in
        let kind = nth(p, 0) in
        let _ =
          if kind == "closurefn" then
            let pos = nth(p, 1) in
            let tname = nth(p, 2) in
            let fo = emit_map_get(funOffsMap, tname) in
            apply_abs32(b, pos, LOAD_VADDR + TEXT_OFF + fo)
          else if kind == "gc_head" then
            let pos = nth(p, 1) in
            apply_u64(b, pos, GLOBALS_BASE)
          else if kind == "saved_argc" then
            let pos = nth(p, 1) in
            apply_u64(b, pos, GLOBALS_BASE + 8)
          else if kind == "saved_argv" then
            let pos = nth(p, 1) in
            apply_u64(b, pos, GLOBALS_BASE + 16)
          else
            let pos = nth(p, 0) in
            let tname = nth(p, 1) in
            let targ1 = lookup_name(labels, tname) in
            let targ2 = if targ1 == 0 then emit_map_get(funOffsMap, tname) else targ1 in
            apply_patch(b, pos, targ2) in
        step(i + 1) in
    step(0) in
  let extra = list_new() in
  let _ = list_push(extra, ["gc_head", gc_off + gc_headaddr]) in
  let _ = list_push(extra, ["gc_head", alc_off + alc_headaddr]) in
  let _ = list_push(extra, [alc_off + gc_call_patch, "gc_collect"]) in
  let _ = list_push(extra, [rf_off + nth(rfr, 1), "yac_alloc"]) in
  let _ = list_push(extra, [ts_off + ts_acall, "yac_alloc"]) in
  let _ = list_push(extra, ["saved_argc", ag_off + nth(agr, 1)]) in
  let _ = list_push(extra, ["saved_argv", av_off + nth(avr, 2)]) in
  let _ = list_push(extra, ["saved_argc", av_off + nth(avr, 1)]) in
  let _ = list_push(extra, [av_off + nth(avr, 3), "yac_alloc"]) in
  let _ = patches_extend(extra, patches) in
  let _ = log("emit", "resolve") in
  let _ = resolve(extra) in
  let _ = log_i("emit", "code_len", bytes_len(b)) in
  let _ = log("emit", "done") in
  [b, funOffsRev2]

let emit_program(prog) = emit_program_at(prog, 4194304, 120)
