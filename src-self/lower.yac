/* lower.yac — translate ANF to LIR (M3.3).
 *
 * Input: list of top-level ANF items [bindings, tailExpr] from anf.yac.
 * Output: LIR via lir.yac constructors (shared by every emit-<arch>).
 *
 * Integer subset: arithmetic, comparisons, if, let, function calls, and
 * top-level recursive function definitions (letfun). Function values are
 * represented by name; recursion works by name.
 *
 * All state threaded explicitly:
 * [insns, env, counter, funs, funcnt, in_tail].
 * in_tail is "F" or the current function's gname (not bool — native drops
 * true in large frames). Only self-named tail calls become tailcall;
 * parse_expr jumping to nested parse_binloop must stay a call.
 */

let reverse(xs) = list_rev(xs)

/* Amortized O(1) insn emit (C list_push). Returns the same buffer. */
let insn_push(ins, x) =
  let _ = list_push(ins, x) in ins

let insn_extend(ins, xs) =
  let n = len(xs) in
  let loop(i) =
    if i >= n then ins
    else let _ = list_push(ins, nth(xs, i)) in loop(i + 1) in
  loop(0)

/* Maps:
 * - fmap: mutable open-addressing [vec, n, cap]. funs / profile.
 * - alist (append [k,v], last-put-wins scan): env / shadow / fv sset.
 *   Those need put history for gen/depth; do not overwrite.
 */
let hash_str_loop(s, n, i, h) =
  if i >= n then h
  else hash_str_loop(s, n, i + 1, band(h * 131 + str_ref(s, i), 16777215))

let hash_str(s) = hash_str_loop(s, str_len(s), 0, 0)

let fmap_fill(b, i, cap) =
  if i >= cap then b
  else
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    let _ = list_push(b, 0) in
    fmap_fill(b, i + 8, cap)

let fmap_new(_) =
  let m = list_new() in
  let _ = list_push(m, fmap_fill(list_new(), 0, 8)) in
  let _ = list_push(m, 0) in
  let _ = list_push(m, 8) in
  m

let fmap_probe(vec, k, i, mask) =
  if nth(vec, i) == 0 then i
  else if nth(nth(vec, i), 0) == k then i
  else fmap_probe(vec, k, band(i + 1, mask), mask)

let fmap_got(e) =
  if e == 0 then 0 else nth(e, 1)

let fmap_get(m, k) =
  fmap_got(nth(nth(m, 0), fmap_probe(nth(m, 0), k,
            band(hash_str(k), nth(m, 2) - 1), nth(m, 2) - 1)))

let fmap_fresh(m, i, k, v) =
  let _ = list_set(nth(m, 0), i, [k, v]) in
  list_set(m, 1, nth(m, 1) + 1)

let fmap_put_at(m, k, v, i) =
  if nth(nth(m, 0), i) == 0 then fmap_fresh(m, i, k, v)
  else list_set(nth(m, 0), i, [k, v])

let fmap_install(m, k, v) =
  fmap_put_at(m, k, v, fmap_probe(nth(m, 0), k,
              band(hash_str(k), nth(m, 2) - 1), nth(m, 2) - 1))

let fmap_rehash(oldv, m, i, oldc) =
  if i >= oldc then 0
  else if nth(oldv, i) == 0 then fmap_rehash(oldv, m, i + 1, oldc)
  else
    let _ = fmap_install(m, nth(nth(oldv, i), 0), nth(nth(oldv, i), 1)) in
    fmap_rehash(oldv, m, i + 1, oldc)

let fmap_grow_prep(m, oldc) =
  let _ = list_set(m, 0, fmap_fill(list_new(), 0, oldc * 2)) in
  let _ = list_set(m, 1, 0) in
  list_set(m, 2, oldc * 2)

let fmap_swap(oldv, m, oldc) =
  let _ = fmap_grow_prep(m, oldc) in
  fmap_rehash(oldv, m, 0, oldc)

let fmap_grow(m) = fmap_swap(nth(m, 0), m, nth(m, 2))

let fmap_maybe_grow(m) =
  if nth(m, 1) * 2 >= nth(m, 2) then fmap_grow(m) else 0

let fmap_put(m, k, v) =
  let _ = fmap_maybe_grow(m) in
  fmap_install(m, k, v)

/* Alist scan (also used by sset / sh). */
let fmap_scan(xs, k, i) =
  if i < 0 then 0
  else if nth(nth(xs, i), 0) == k then nth(nth(xs, i), 1)
  else fmap_scan(xs, k, i - 1)

let alist_new(_) = list_new()

let alist_put(m, k, v) =
  let _ = list_push(m, [k, v]) in
  0

let alist_get(m, k) = fmap_scan(m, k, len(m) - 1)

/* String set: alist, values unused. */
let sset_new(_) = alist_new(0)

let sset_put(m, k) =
  let _ = alist_put(m, k, 1) in
  m

let sset_has(m, k) =
  let e = fmap_scan(m, k, len(m) - 1) in
  if e == 0 then false else true

let sset_from_list(xs) =
  let m = sset_new(0) in
  let n = len(xs) in
  let loop(i) =
    if i >= n then m
    else let _ = sset_put(m, nth(xs, i)) in loop(i + 1) in
  loop(0)

/* Shadow env: [alist name->depth, depth]. Nested letfun uses enter/leave
 * without cloning; has() ignores bindings deeper than the current depth. */
let sh_new(_) = [alist_new(0), 1]

let sh_from_list(xs) =
  let sh = sh_new(0) in
  let n = len(xs) in
  let loop(i) =
    if i >= n then sh
    else
      let _ = alist_put(nth(sh, 0), nth(xs, i), nth(sh, 1)) in
      loop(i + 1) in
  loop(0)

let sh_put(sh, k) =
  let _ = alist_put(nth(sh, 0), k, nth(sh, 1)) in
  sh

/* Continue (not hit) first so both recurrences are tail like fmap_scan.
 * Native `!=` on strings is pointer inequality — use `==` then branch. */
let sh_has_scan(xs, k, dcur, i) =
  if i < 0 then 0
  else if nth(nth(xs, i), 0) == k then
    if nth(nth(xs, i), 1) > dcur then sh_has_scan(xs, k, dcur, i - 1)
    else 1
  else sh_has_scan(xs, k, dcur, i - 1)

let sh_has(sh, k) =
  sh_has_scan(nth(sh, 0), k, nth(sh, 1), len(nth(sh, 0)) - 1) != 0

let sh_enter(sh) = [nth(sh, 0), nth(sh, 1) + 1]
let sh_leave(sh) = [nth(sh, 0), nth(sh, 1) - 1]

/* Accumulator of free vars: [list_rev_order, sset] for O(1) membership. */
let fv_acc_new(_) = [[], sset_new(0)]
let fv_acc_list(a) = nth(a, 0)
let fv_acc_has(a, k) = sset_has(nth(a, 1), k)
let fv_acc_add(a, k) =
  if fv_acc_has(a, k) then a
  else let _ = sset_put(nth(a, 1), k) in [cons(k, nth(a, 0)), nth(a, 1)]

let funs_empty(nrt) = [[], fmap_new(0), nrt]
let funs_list(fs) = nth(fs, 0)
let funs_map(fs) = nth(fs, 1)

/* Fun records: ["fun", gname, ntot, ncap, insns, srcname] */
let fun_src(f) = if len(f) > 5 then nth(f, 5) else nth(f, 1)

let funs_cons(fs, f) =
  let m = funs_map(fs) in
  let idx =
    if len(nth(f, 4)) == 0 then 0 - 1
    else len(funs_list(fs)) in
  let _ = fmap_put(m, fun_src(f), [nth(f, 1), nth(f, 3), idx]) in
  [cons(f, funs_list(fs)), m, nth(fs, 2)]

let funs_has(fs, name) =
  let e = fmap_get(funs_map(fs), name) in
  if e == 0 then false else true

let fun_code_name(fs, name) =
  let e = fmap_get(funs_map(fs), name) in
  if e == 0 then name else nth(e, 0)

let fun_ncap(fs, name) =
  let e = fmap_get(funs_map(fs), name) in
  if e == 0 then 0 else nth(e, 1)

/* ---- int parsing ---- */
let str_to_int(s) =
  let n = str_len(s) in
  let isneg = if n > 0 then str_ref(s, 0) == 45 else false in
  let start = if isneg then 1 else 0 in
  let acc(i, v) =
    if i >= n then v
    else acc(i + 1, v * 10 + (str_ref(s, i) - 48)) in
  let v = acc(start, 0) in
  if isneg then 0 - v else v

/* Environment: 2-tuple [alist, [gen, parents]]. Bindings [slot, ncap, gen].
 * env_scan must not bind locals (native drops `let` in that frame; fmap_scan
 * style nth(nth(...)) is required). */
let env_new(_) =
  let ps = list_new() in
  let _ = list_push(ps, 0) in
  [alist_new(0), [0, ps], fmap_new(0)]

let env_enter(env) =
  let ps = nth(nth(env, 1), 1) in
  let _ = list_push(ps, nth(nth(env, 1), 0)) in
  [nth(env, 0), [len(ps) - 1, ps], nth(env, 2)]

let env_bind(env, name, slot, ncap) =
  let _ = alist_put(nth(env, 0), name, [slot, ncap, nth(nth(env, 1), 0)]) in
  let _ = fmap_put(nth(env, 2), name, 1) in
  env

let env_live(g, cur, parents) =
  if cur == g then true
  else if cur == 0 then false
  else env_live(g, nth(parents, cur), parents)

let env_scan(xs, k, cur, parents, i) =
  if i < 0 then 0
  else if nth(nth(xs, i), 0) == k then
    if env_live(nth(nth(nth(xs, i), 1), 2), cur, parents) then nth(nth(xs, i), 1)
    else env_scan(xs, k, cur, parents, i - 1)
  else env_scan(xs, k, cur, parents, i - 1)

let env_rec(env, name) =
  if fmap_get(nth(env, 2), name) == 0 then 0
  else env_scan(nth(env, 0), name, nth(nth(env, 1), 0), nth(nth(env, 1), 1),
                len(nth(env, 0)) - 1)

let env_lookup(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then 0 else nth(e, 0)

let env_ncap(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then 0 else nth(e, 1)

let env_has(env, name) =
  let e = env_rec(env, name) in
  if e == 0 then false else true

let is_cmp(op) =
  op == "<" or op == "<=" or op == ">" or op == ">=" or op == "==" or op == "!="

/* is name in list? */
let in_list_go(name, l) =
  if len(l) == 0 then false
  else if nth(l, 0) == name then true
  else in_list_go(name, drop(l, 1))

let in_list(name, lst) = in_list_go(name, lst)

let prim_names = ["cons", "len", "nth", "tail", "append", "print",
                  "map", "filter", "foldl", "foldr", "drop", "head",
                  "str_len", "str_cat", "str_ref", "str_slice", "int_to_str",
                  "time_ms", "time_ns", "time_str", "argc", "argv",
                  "bytes_new", "bytes_len", "bytes_append", "bytes_extend", "bytes_ref", "bytes_put",
                  "bytes_to_str", "list_new", "list_push", "list_set", "list_rev",
                  "box_new", "box_get", "box_set", "yac_prof_cell",
                  "read_file", "write_file", "system", "popen", "band", "bor", "bxor", "bnot", "bshl", "bshr",
                  "gc_collect"]
let is_prim_name(w) = in_list(w, prim_names)

/* collect vars in anf body. Prim / zero-capture global call targets are not
 * free; HO values and capturing call targets remain free (need apply).
 * accum = [list, sset]; shadow = [alist, depth]. */
let collect_anf_vars(anf, accum, shadow, funs) =
  let atom_vars(atom, acc, shdw) =
    let k = nth(atom, 0) in
    if k == "var" then
      let nm = nth(atom, 1) in
      if sh_has(shdw, nm) then acc
      else if funs_has(funs, nm) then
        if fun_ncap(funs, nm) == 0 then acc else fv_acc_add(acc, nm)
      else fv_acc_add(acc, nm)
    else if k == "fun" then
      let rr = collect_anf_vars(nth(atom, 2), acc, shdw, funs) in
      nth(rr, 0)
    else acc in
  let bindings = nth(anf, 0) in
  let tail = nth(anf, 1) in
  let nb = len(bindings) in
  let step(i, acc, shdw) =
    if i >= nb then [atom_vars(tail, acc, shdw), shdw]
    else
      let b = nth(bindings, i) in
      let k = nth(b, 0) in
      let r =
        if k == "let" then
          let a = nth(b, 2) in
          let acc2 = if nth(a, 0) == "var" then acc else atom_vars(a, acc, shdw) in
          [acc2, sh_put(shdw, nth(b, 1))]
        else if k == "letbin" then
          let acc2 = atom_vars(nth(b, 3), acc, shdw) in
          let acc3 = atom_vars(nth(b, 4), acc2, shdw) in
          [acc3, sh_put(shdw, nth(b, 1))]
        else if k == "letcall" then
          let fn = nth(b, 2) in
          let acc2 =
            if nth(fn, 0) == "var" then
              let fnm = nth(fn, 1) in
              if is_prim_name(fnm) then acc
              else if funs_has(funs, fnm) and fun_ncap(funs, fnm) == 0 then acc
              else atom_vars(fn, acc, shdw)
            else atom_vars(fn, acc, shdw) in
          let args = nth(b, 3) in
          let loop(j, a) =
            if j >= len(args) then a
            else loop(j + 1, atom_vars(nth(args, j), a, shdw)) in
          [loop(0, acc2), sh_put(shdw, nth(b, 1))]
        else if k == "letif" then
          let acc2 = atom_vars(nth(b, 2), acc, shdw) in
          let rr1 = collect_anf_vars(nth(b, 3), acc2, shdw, funs) in
          let acc3 = nth(rr1, 0) in
          let shdw2 = nth(rr1, 1) in
          let rr2 = collect_anf_vars(nth(b, 4), acc3, shdw2, funs) in
          [nth(rr2, 0), sh_put(nth(rr2, 1), nth(b, 1))]
        else if k == "letfun" then
          let p = nth(b, 2) in
          let shdw2 = sh_enter(shdw) in
          let _ = sh_put(shdw2, nth(b, 1)) in
          let np = len(p) in
          let addp(j) =
            if j >= np then 0
            else let _ = sh_put(shdw2, nth(p, j)) in addp(j + 1) in
          let _ = addp(0) in
          let rr = collect_anf_vars(nth(b, 3), acc, shdw2, funs) in
          [nth(rr, 0), sh_put(shdw, nth(b, 1))]
        else if k == "letprint" then
          [atom_vars(nth(b, 2), acc, shdw), sh_put(shdw, nth(b, 1))]
        else [acc, shdw] in
      step(i + 1, nth(r, 0), nth(r, 1)) in
  let res = step(0, accum, shadow) in
  [nth(res, 0), nth(res, 1)]

let free_vars(fnbody, params, funs) =
  let sh = sh_from_list(params) in
  let rr = collect_anf_vars(fnbody, fv_acc_new(0), sh, funs) in
  reverse(fv_acc_list(nth(rr, 0)))

/* let-free: native drops `let` in lower_atom's frame. */
let lower_var(atom, st) =
  if env_lookup(nth(st, 1), nth(atom, 1)) != 0 then
    [nth(st, 0), env_lookup(nth(st, 1), nth(atom, 1)),
     nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]
  else if funs_has(nth(st, 3), nth(atom, 1)) then
    [insn_push(nth(st, 0),
       l_closure(nth(st, 2), fun_code_name(nth(st, 3), nth(atom, 1)), [])),
     nth(st, 2), nth(st, 1), nth(st, 2) + 1, nth(st, 3), nth(st, 4)]
  else
    [nth(st, 0), 0, nth(st, 1), nth(st, 2), nth(st, 3), nth(st, 4)]

/* atomize a sub-expr to a slot. st = [insns, env, counter, funs, funcnt].
 * Returns [insns, slot, env, counter, funs, funcnt]. */
let lower_atom(atom, st) =
  let insns = nth(st, 0) in
  let env = nth(st, 1) in
  let ctr = nth(st, 2) in
  let funs = nth(st, 3) in
  let funcnt = nth(st, 4) in
  let k = nth(atom, 0) in
  if k == "int" then
    let slot = ctr in
    [insn_push(insns, l_mov_imm(slot, str_to_int(nth(atom, 1)))),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "nil" then
    let slot = ctr in
    [insn_push(insns, l_nil(slot)),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "str" then
    let slot = ctr in
    [insn_push(insns, l_strlit(slot, nth(atom, 1))),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "bool" then
    let slot = ctr in
    let v = if nth(atom, 1) == "true" then 1 else 0 in
    [insn_push(insns, l_mov_imm(slot, v)),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "unit" then
    let slot = ctr in
    [insn_push(insns, l_mov_imm(slot, 0)),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "var" then
    lower_var(atom, st)
  else
    [insns, 0, env, ctr, funs, funcnt]

/* Isolated from lower_body. info = [i, nb, tail, bname]; in_tail = nth(s, 5)
 * is "F" or this function's gname. */
let rest_is_tail(s, info) =
  if nth(s, 5) == "F" then false
  else if nth(info, 0) == nth(info, 1) - 1 then
    if nth(nth(info, 2), 0) == "var" then
      nth(nth(info, 2), 1) == nth(info, 3)
    else false
  else false

/* Denylist: native tailcall of parse_program does not finish the bundle
 * parse. lex/emit/skip_* still need self-TCO or they stack-overflow. */
let tco_name_ok(self) =
  if self == "parse_program" then false
  else if self == "parse_expr" then false
  else true

let maybe_tailcall(rest_tail, newinsn, dst, slots, self) =
  if not rest_tail then newinsn
  else if not tco_name_ok(self) then newinsn
  else if nth(newinsn, 0) == "fcall" then
    if nth(newinsn, 2) == self then
      if len(nth(newinsn, 3)) > 6 then newinsn
      else l_tcall(dst, nth(newinsn, 2), nth(newinsn, 3))
    else newinsn
  else if nth(newinsn, 0) == "call" then
    if nth(newinsn, 2) == self then
      if len(nth(newinsn, 3)) > 6 then newinsn
      else l_tcall(dst, nth(newinsn, 2), nth(newinsn, 3))
    else newinsn
  else newinsn

/* 2-arg wrapper: do not keep rest_tail live across lower_letcall's prim chain. */
let apply_tco(pack) =
  let s = nth(pack, 0) in
  let rt = rest_is_tail(s, nth(pack, 1)) in
  maybe_tailcall(rt, nth(pack, 2), nth(pack, 3), nth(pack, 4), nth(s, 5))

/* Build the 6-tuple in a *small* top-level fn (direct call, not nested apply). */
let cons_tail_yes(st5, self) =
  [nth(st5, 0), nth(st5, 1), nth(st5, 2), nth(st5, 3), nth(st5, 4), self]
let cons_tail_no(st5) =
  [nth(st5, 0), nth(st5, 1), nth(st5, 2), nth(st5, 3), nth(st5, 4), "F"]
let cons_tail_from(pack) =
  let s = nth(pack, 0) in
  let st5 = nth(pack, 1) in
  let info = nth(pack, 2) in
  let flag = if rest_is_tail(s, info) then nth(s, 5) else "F" in
  [nth(st5, 0), nth(st5, 1), nth(st5, 2), nth(st5, 3), nth(st5, 4), flag]
let pack_yes(st5, self) = [cons_tail_yes(st5, self), 0]
let pack_from(cf) = [cons_tail_from(cf), 0]
let pack_step(st, i) = [st, i]

/* p = [j, ins, env, ctr, funs]. Native max 6 args. */
let lower_loadargs(args, p, slots_rev) =
  if nth(p, 0) >= len(args) then
    [nth(p, 1), reverse(slots_rev), nth(p, 2), nth(p, 3)]
  else
    let r = lower_atom(nth(args, nth(p, 0)),
                       [nth(p, 1), nth(p, 2), nth(p, 3), nth(p, 4), 0]) in
    lower_loadargs(args,
      [nth(p, 0) + 1, nth(r, 0), nth(r, 2), nth(r, 3), nth(p, 4)],
      cons(nth(r, 1), slots_rev))

let lower_prim_list(fnname, dst, slots) =
  if fnname == "cons" then l_cons(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "len" then l_len(dst, nth(slots, 0))
  else if fnname == "nth" then l_nth(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "tail" then l_tail(dst, nth(slots, 0))
  else if fnname == "append" then l_append(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "drop" then l_drop(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "foldl" then
    l_foldl(dst, nth(slots, 0), nth(slots, 1), nth(slots, 2))
  else if fnname == "map" then l_map(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "list_new" then l_list_new(dst)
  else if fnname == "list_push" then
    l_list_push(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "list_set" then
    l_ccall(dst, "yac_list_set", [nth(slots, 0), nth(slots, 1), nth(slots, 2)])
  else if fnname == "list_rev" then l_list_rev(dst, nth(slots, 0))
  else 0

let lower_prim_str(fnname, dst, slots) =
  if fnname == "str_len" then l_str_len(dst, nth(slots, 0))
  else if fnname == "str_ref" then l_str_ref(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "str_cat" then l_str_cat(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "str_slice" then
    l_str_slice(dst, nth(slots, 0), nth(slots, 1), nth(slots, 2))
  else if fnname == "int_to_str" then l_int_to_str(dst, nth(slots, 0))
  else if fnname == "time_ms" then l_time_ms(dst)
  else if fnname == "time_ns" then l_ccall(dst, "time_ns", [])
  else if fnname == "time_str" then l_time_str(dst)
  else if fnname == "box_new" then l_ccall(dst, "yac_box_new", [])
  else if fnname == "box_get" then l_ccall(dst, "yac_box_get", [nth(slots, 0)])
  else if fnname == "box_set" then
    l_ccall(dst, "yac_box_set", [nth(slots, 0), nth(slots, 1)])
  else if fnname == "yac_prof_cell" then l_ccall(dst, "yac_prof_cell", [])
  else if fnname == "argc" then l_argc(dst)
  else if fnname == "argv" then l_argv(dst, nth(slots, 0))
  else 0

let lower_prim_bytes(fnname, dst, slots) =
  if fnname == "bytes_to_str" then l_bytes_to_str(dst, nth(slots, 0))
  else if fnname == "bytes_new" then l_bytes_new(dst)
  else if fnname == "bytes_len" then l_bytes_len(dst, nth(slots, 0))
  else if fnname == "bytes_ref" then
    l_bytes_ref(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bytes_put" then
    l_bytes_put(dst, nth(slots, 0), nth(slots, 1), nth(slots, 2))
  else if fnname == "bytes_append" then
    l_bytes_append(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bytes_extend" then
    l_bytes_extend(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "read_file" then l_read_file(dst, nth(slots, 0))
  else if fnname == "write_file" then
    l_write_file(dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "gc_collect" then l_ccall(dst, "gc_collect", [])
  else if fnname == "band" then l_binop("&", dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bor" then l_binop("|", dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bxor" then l_binop("^", dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bnot" then l_binop("~", dst, nth(slots, 0), nth(slots, 0))
  else if fnname == "bshl" then l_binop("<<", dst, nth(slots, 0), nth(slots, 1))
  else if fnname == "bshr" then l_binop(">>", dst, nth(slots, 0), nth(slots, 1))
  else 0

/* Slots 1..ncap already hold this frame's captures (letfun layout). */
let cap_slots_n(n, j, acc) =
  if j > n then acc
  else cap_slots_n(n, j + 1, append(acc, [j]))

let lower_user_call(fnname, dst, slots, env, funs0, self) =
  if env_has(env, fnname) then
    if env_ncap(env, fnname) > 0 then
      if fun_code_name(funs0, fnname) == self then
        if env_ncap(env, fnname) + len(slots) > 6 then
          l_apply(dst, env_lookup(env, fnname), env_ncap(env, fnname), slots)
        else
          l_fcall(dst, fun_code_name(funs0, fnname),
                  append(cap_slots_n(env_ncap(env, fnname), 1, []), slots))
      else
        l_apply(dst, env_lookup(env, fnname), env_ncap(env, fnname), slots)
    else if funs_has(funs0, fnname) then
      l_fcall(dst, fun_code_name(funs0, fnname), slots)
    else
      l_icall(dst, env_lookup(env, fnname), slots)
  else l_fcall(dst, fun_code_name(funs0, fnname), slots)

/* callι: Σ 哈希先于 env；env 先于 runtime 名。否则 `let len(n)=n+1` 会打成 yac_len。
 * env_rec 对从未 bind 的名字（nth/len/cons…）fmap miss，避免线性扫 alist。 */
let is_bound_fn(fnname, env, funs0) =
  if funs_has(funs0, fnname) then true
  else env_has(env, fnname)

let lower_call_insn(fnname, dst, slots, env, funs0, self) =
  if is_bound_fn(fnname, env, funs0) then
    lower_user_call(fnname, dst, slots, env, funs0, self)
  else
    let a = lower_prim_list(fnname, dst, slots) in
    if a == 0 then
      let b = lower_prim_str(fnname, dst, slots) in
      if b == 0 then
        let c = lower_prim_bytes(fnname, dst, slots) in
        if c == 0 then lower_user_call(fnname, dst, slots, env, funs0, self)
        else c
      else b
    else a

/* pack = [s, i, nb, tail]. */
let lower_letcall(b, pack) =
  let s = nth(pack, 0) in
  let lr = lower_loadargs(nth(b, 3),
            [0, nth(s, 0), nth(s, 1), nth(s, 2), nth(s, 3)], []) in
  let dst = nth(lr, 3) in
  let tagged = apply_tco(
    [s, [nth(pack, 1), nth(pack, 2), nth(pack, 3), nth(b, 1)],
     lower_call_insn(nth(nth(b, 2), 1), dst, nth(lr, 1), nth(s, 1), nth(s, 3),
                     nth(s, 5)),
     dst, nth(lr, 1)]) in
  [insn_push(nth(lr, 0), tagged),
   env_bind(nth(lr, 2), nth(b, 1), dst, 0), dst + 1,
   nth(s, 3), nth(s, 4), nth(s, 5)]

let lower_let(b, s) =
  let r = lower_atom(nth(b, 2), s) in
  [nth(r, 0), env_bind(nth(r, 2), nth(b, 1), nth(r, 1), 0), nth(r, 3),
   nth(r, 4), nth(r, 5), nth(s, 5)]

let lower_letbin(b, s) =
  let name = nth(b, 1) in
  let op = nth(b, 2) in
  let ra = lower_atom(nth(b, 3), s) in
  let rb = lower_atom(nth(b, 4), [nth(ra, 0), nth(ra, 2), nth(ra, 3),
                                  nth(ra, 4), nth(ra, 5)]) in
  let dst = nth(rb, 3) in
  let newinsn =
    if is_cmp(op) then l_cmp(op, dst, nth(ra, 1), nth(rb, 1))
    else l_binop(op, dst, nth(ra, 1), nth(rb, 1)) in
  [insn_push(nth(rb, 0), newinsn),
   env_bind(nth(rb, 2), name, dst, 0), dst + 1,
   nth(rb, 4), nth(rb, 5), nth(s, 5)]

let lower_letprint(b, s) =
  let ra = lower_atom(nth(b, 2), s) in
  let dst = nth(ra, 3) in
  let ins2 = insn_push(insn_push(nth(ra, 0), l_print(nth(ra, 1))),
                       l_mov_imm(dst, 0)) in
  [ins2,
   env_bind(nth(ra, 2), nth(b, 1), dst, 0), dst + 1,
   nth(ra, 4), nth(ra, 5), nth(s, 5)]

let lower_letfun_prep(b, s) =
  let env = nth(s, 1) in
  let name = nth(b, 1) in
  let params = nth(b, 2) in
  let body = nth(b, 3) in
  let nparams = len(params) in
  let uid = nth(s, 4) in
  let gname =
    if funs_has(nth(s, 3), name) then
      str_cat(name, str_cat("#", int_to_str(uid)))
    else name in
  let fvs_raw = free_vars(body, params, nth(s, 3)) in
  let is_rec = in_list(name, fvs_raw) in
  let fvs = free_vars(body, append([name], params), nth(s, 3)) in
  let ncap = len(fvs) in
  let need_self = is_rec and ncap > 0 in
  let build_cap(j, e) =
    if j >= ncap then e
    else
      let vn = nth(fvs, j) in
      build_cap(j + 1, env_bind(e, vn, j + 1, env_ncap(env, vn))) in
  let build_user(j, e) =
    if j >= nparams then e
    else build_user(j + 1, env_bind(e, nth(params, j), ncap + j + 1, 0)) in
  let self_slot = ncap + nparams + 1 in
  let p_env0 = build_user(0, build_cap(0, env_new(0))) in
  let p_env =
    if need_self then env_bind(p_env0, name, self_slot, ncap) else p_env0 in
  let ntot = ncap + nparams in
  let stub = l_fun(gname, ntot, ncap, list_new(), name) in
  let fs1 = funs_cons(nth(s, 3), stub) in
  let st5 = [list_new(), p_env,
             if need_self then self_slot + 1 else ntot + 1,
             fs1, uid + 1] in
  [body, st5, name, ncap, ntot, gname, fvs, need_self, self_slot]

let lower_letfun_finish(b, s, p, br) =
  let name = nth(p, 2) in
  let ncap = nth(p, 3) in
  let ntot = nth(p, 4) in
  let gname = nth(p, 5) in
  let fvs = nth(p, 6) in
  let need_self = nth(p, 7) in
  let self_slot = nth(p, 8) in
  let env = nth(s, 1) in
  let insns = nth(s, 0) in
  let ctr = nth(s, 2) in
  let nslots = nth(br, 3) in
  let self_caps(j, acc) =
    if j >= ncap then acc
    else self_caps(j + 1, append(acc, [j + 1])) in
  let f_insns0 = insn_push(list_new(), l_prologue(nslots, ntot)) in
  let f_insns1 =
    if need_self then
      insn_push(f_insns0, l_closure(self_slot, gname, self_caps(0, [])))
    else f_insns0 in
  let f_insns = insn_push(insn_extend(f_insns1, nth(br, 0)), l_ret(nth(br, 1))) in
  let f = l_fun(gname, ntot, ncap, f_insns, name) in
  let slot = ctr in
  let capslot_of(j, acc) =
    if j >= ncap then acc
    else capslot_of(j + 1, append(acc, [env_lookup(env, nth(fvs, j))])) in
  let funs1 = funs_cons(nth(br, 4), f) in
  [insn_push(insns, l_closure(slot, gname, capslot_of(0, []))),
   env_bind(env, name, slot, ncap),
   ctr + 1, funs1, nth(br, 5), nth(s, 5)]

let lower_letif_prep(b, s) =
  let cr = lower_atom(nth(b, 2), s) in
  let dst = nth(cr, 3) in
  [nth(b, 3), nth(b, 4), cr, dst, dst + 1, nth(b, 1)]

let lower_letif_finish(b, pack) =
  let s = nth(pack, 0) in
  let p = nth(pack, 1) in
  let thenr = nth(pack, 2) in
  let elser = nth(pack, 3) in
  let cr = nth(p, 2) in
  let dst = nth(p, 3) in
  let name = nth(p, 5) in
  let condslot = nth(cr, 1) in
  let thenslot = nth(thenr, 1) in
  let elseslot = nth(elser, 1) in
  let L = nth(elser, 5) in
  let L0 = str_cat("LIF", int_to_str(L)) in
  let L1 = str_cat("LIF", int_to_str(L + 1)) in
  let L2 = str_cat("LIF", int_to_str(L + 2)) in
  let nextctr =
    if nth(thenr, 3) > nth(elser, 3) then nth(thenr, 3) else nth(elser, 3) in
  let ib0 = insn_push(list_new(), l_br(condslot, L0, L1)) in
  let ib1 = insn_push(ib0, l_label(L0)) in
  let ib2 = insn_extend(ib1, nth(thenr, 0)) in
  let ib3 = insn_push(ib2, l_mov(dst, thenslot)) in
  let ib4 = insn_push(ib3, l_jmp(L2)) in
  let ib5 = insn_push(ib4, l_label(L1)) in
  let ib6 = insn_extend(ib5, nth(elser, 0)) in
  let ib7 = insn_push(ib6, l_mov(dst, elseslot)) in
  let ifbuf = insn_push(ib7, l_label(L2)) in
  [insn_extend(nth(cr, 0), ifbuf),
   env_bind(nth(elser, 2), name, dst, 0), nextctr,
   nth(elser, 4), L + 3, nth(s, 5)]

/* pack = [st, i]. pack_yes/pack_from build that pair in a *small* function so
 * the T flag is not a local of this (large) frame. */
let lower_body_loop(anf, pack) =
  let st = nth(pack, 0) in
  let i = nth(pack, 1) in
  let bindings = nth(anf, 0) in
  let tail = nth(anf, 1) in
  let nb = len(bindings) in
  if i >= nb then
    let tr = lower_atom(tail, st) in
    [nth(tr, 0), nth(tr, 1), nth(tr, 2), nth(tr, 3), nth(tr, 4), nth(tr, 5)]
  else
    let b = nth(bindings, i) in
    let k = nth(b, 0) in
    if k == "let" then
      lower_body_loop(anf, pack_step(lower_let(b, st), i + 1))
    else if k == "letbin" then
      lower_body_loop(anf, pack_step(lower_letbin(b, st), i + 1))
    else if k == "letprint" then
      lower_body_loop(anf, pack_step(lower_letprint(b, st), i + 1))
    else if k == "letcall" then
      lower_body_loop(anf, pack_step(lower_letcall(b, [st, i, nb, tail]), i + 1))
    else if k == "letfun" then
      let p = lower_letfun_prep(b, st) in
      let br = lower_body_loop(nth(p, 0), pack_yes(nth(p, 1), nth(p, 5))) in
      lower_body_loop(anf, pack_step(lower_letfun_finish(b, st, p, br), i + 1))
    else if k == "letif" then
      let p = lower_letif_prep(b, st) in
      let cr = nth(p, 2) in
      let ctr1 = nth(p, 4) in
      let info = [i, nb, tail, nth(b, 1)] in
      let thenr = lower_body_loop(nth(p, 0), pack_from([st, [list_new(), env_enter(nth(cr, 2)), ctr1, nth(cr, 4), nth(cr, 5)], info])) in
      let elser = lower_body_loop(nth(p, 1), pack_from([st, [list_new(), env_enter(nth(cr, 2)), ctr1, nth(thenr, 4), nth(thenr, 5)], info])) in
      lower_body_loop(anf, pack_step(lower_letif_finish(b, [st, p, thenr, elser]), i + 1))
    else lower_body_loop(anf, pack_step(st, i + 1))

let lower_body(anf, st) = lower_body_loop(anf, pack_step(st, 0))

let start_proc(nslots, result_slot, body) =
  l_fun("_start", 0, 0,
    insn_push(
      insn_push(
        insn_extend(insn_push(list_new(), l_local(nslots, 0)), body),
        l_untag(nslots, result_slot)),
      l_syscall(0, 60, [nslots])),
    "_start")

/* ---- public API ---- */
let compile_top(items) =
  let _ = log("lower", "compile_top begin") in
  let nitems = len(items) in
  let _ = log_i("lower", "nitems", nitems) in
  let iter(i, env, counter, funs, funcnt, entry_insns, result_slot) =
    if i >= nitems then [env, counter, funs, funcnt, entry_insns, result_slot]
    else
      let _ =
        if i == 0 or ((i % 50) == 0) then log_i("lower", "item", i) else 0 in
      let r = lower_body(nth(items, i), cons_tail_no([entry_insns, env, counter, funs, funcnt])) in
      iter(i + 1, nth(r, 2), nth(r, 3), nth(r, 4), nth(r, 5),
           nth(r, 0), nth(r, 1)) in
  let rt0 = runtime_funs(0) in
  let nrt = len(rt0) in
  let _ = log_i("lower", "nrt", nrt) in
  let st = iter(0, env_new(0), 1, funs_empty(nrt), 0, list_new(), 0) in
  let entry_insns = nth(st, 4) in
  let result_slot = nth(st, 5) in
  let fs = nth(st, 2) in
  let funs = funs_list(fs) in
  let _ = log_i("lower", "nfuns", len(funs)) in
  let nslots = nth(st, 1) in
  let entry = start_proc(nslots, result_slot, entry_insns) in
  let _ = log("lower", "compile_top done") in
  l_prog(cons(entry, append(rt0, reverse(funs))), "_start")
