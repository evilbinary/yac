/* lower.yac — translate ANF to LIR (M3.3).
 *
 * Input: list of top-level ANF items [bindings, tailExpr] from anf.yac.
 * Output: LIR program ["prog", [fun...], entryName].
 *
 * Integer subset: arithmetic, comparisons, if, let, function calls, and
 * top-level recursive function definitions (letfun). Function values are
 * represented by name; recursion works by name.
 *
 * All state threaded explicitly: [insns, env, counter, funs, funcnt].
 */

let reverse(xs) = foldl(fun (a, x) -> cons(x, a), [], xs)

/* ---- int parsing ---- */
let str_to_int(s) =
  let n = str_len(s) in
  let isneg = if n > 0 then str_ref(s, 0) == 45 else false in
  let start = if isneg then 1 else 0 in
  let acc(i, v) =
    if i >= n then v
    else acc(i + 1, v * 10 + (str_ref(s, i) - 48)) in
  let v = acc(start, 0) in
  if isneg then 0 - v else v

/* ---- environment ---- */
let env_lookup(env, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(env)

let is_cmp(op) =
  op == "<" or op == "<=" or op == ">" or op == ">=" or op == "==" or op == "!="

/* is name in list? */
let in_list(name, lst) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(l, 0) == name then true
    else rec(drop(l, 1)) in
  rec(lst)

let prim_names = ["cons", "len", "nth", "tail", "append", "print",
                  "map", "filter", "foldl", "foldr", "drop", "head",
                  "str_len", "str_cat", "str_ref", "str_slice", "int_to_str",
                  "bytes_new", "bytes_len", "bytes_append", "bytes_ref", "bytes_put",
                  "bytes_to_str",
                  "read_file", "write_file", "band", "bor", "bxor", "bshl", "bshr"]
let is_prim_name(w) = in_list(w, prim_names)

/* ---- environment ---- */
/* env entries are [name, slot, ncap] (ncap = number of captured vars; 0 for
 * plain named functions / non-function values). */
let env_lookup(env, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 1)
    else rec(drop(l, 1)) in
  rec(env)

let env_ncap(env, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 0) == name then nth(nth(l, 0), 2)
    else rec(drop(l, 1)) in
  rec(env)

/* true if name is bound in env (even if slot is 0) */
let env_has(env, name) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(nth(l, 0), 0) == name then true
    else rec(drop(l, 1)) in
  rec(env)

/* true if name is a known function symbol in the funs list */
let funs_has(funs, name) =
  let rec(l) =
    if len(l) == 0 then false
    else if nth(nth(l, 0), 1) == name then true
    else rec(drop(l, 1)) in
  rec(funs)

/* ncap at index 3: ["fun", name, ntot, ncap, insns] */
let fun_ncap(funs, name) =
  let rec(l) =
    if len(l) == 0 then 0
    else if nth(nth(l, 0), 1) == name then nth(nth(l, 0), 3)
    else rec(drop(l, 1)) in
  rec(funs)

/* collect vars in anf body. Prim / zero-capture global call targets are not
 * free; HO values and capturing call targets remain free (need apply). */
let collect_anf_vars(anf, accum, shadow, funs) =
  let atom_vars(atom, acc, shdw) =
    let k = nth(atom, 0) in
    if k == "var" then
      if in_list(nth(atom, 1), shdw) then acc
      else if in_list(nth(atom, 1), acc) then acc
      else cons(nth(atom, 1), acc)
    else if k == "fun" then collect_anf_vars(nth(atom, 2), acc, shdw, funs)
    else acc in
  let bindings = nth(anf, 0) in
  let tail = nth(anf, 1) in
  let nb = len(bindings) in
  let step(i, acc, shdw) =
    if i >= nb then [atom_vars(tail, acc, shdw), shdw]
    else
      let b = nth(bindings, i) in
      let k = nth(b, 0) in
      let r =
        if k == "let" then
          let a = nth(b, 2) in
          let acc2 = if nth(a, 0) == "var" then acc else atom_vars(a, acc, shdw) in
          [acc2, cons(nth(b, 1), shdw)]
        else if k == "letbin" then
          let acc2 = atom_vars(nth(b, 3), acc, shdw) in
          let acc3 = atom_vars(nth(b, 4), acc2, shdw) in
          [acc3, cons(nth(b, 1), shdw)]
        else if k == "letcall" then
          let fn = nth(b, 2) in
          let acc2 =
            if nth(fn, 0) == "var" then
              let fnm = nth(fn, 1) in
              if is_prim_name(fnm) then acc
              else if funs_has(funs, fnm) and fun_ncap(funs, fnm) == 0 then acc
              else atom_vars(fn, acc, shdw)
            else atom_vars(fn, acc, shdw) in
          let args = nth(b, 3) in
          let loop(j, a) =
            if j >= len(args) then a
            else loop(j + 1, atom_vars(nth(args, j), a, shdw)) in
          [loop(0, acc2), cons(nth(b, 1), shdw)]
        else if k == "letif" then
          let acc2 = atom_vars(nth(b, 2), acc, shdw) in
          let rr1 = collect_anf_vars(nth(b, 3), acc2, shdw, funs) in
          let acc3 = nth(rr1, 0) in
          let shdw2 = nth(rr1, 1) in
          let rr2 = collect_anf_vars(nth(b, 4), acc3, shdw2, funs) in
          [nth(rr2, 0), cons(nth(b, 1), nth(rr2, 1))]
        else if k == "letfun" then
          let p = nth(b, 2) in
          let shdw2 = append(p, shdw) in
          let rr = collect_anf_vars(nth(b, 3), acc, shdw2, funs) in
          [nth(rr, 0), cons(nth(b, 1), shdw)]
        else if k == "letprint" then
          [atom_vars(nth(b, 2), acc, shdw), cons(nth(b, 1), shdw)]
        else [acc, shdw] in
      step(i + 1, nth(r, 0), nth(r, 1)) in
  let res = step(0, accum, shadow) in
  [nth(res, 0), nth(res, 1)]

let free_vars(fnbody, params, funs) =
  reverse(nth(collect_anf_vars(fnbody, [], params, funs), 0))

/* atomize a sub-expr to a slot. st = [insns, env, counter, funs, funcnt].
 * Returns [insns, slot, env, counter, funs, funcnt]. */
let lower_atom(atom, st) =
  let insns = nth(st, 0) in
  let env = nth(st, 1) in
  let ctr = nth(st, 2) in
  let funs = nth(st, 3) in
  let funcnt = nth(st, 4) in
  let k = nth(atom, 0) in
  if k == "int" then
    let slot = ctr in
    [append(insns, [["mov_imm", slot, str_to_int(nth(atom, 1))]]),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "nil" then
    let slot = ctr in
    [append(insns, [["nil", slot]]),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "str" then
    let slot = ctr in
    [append(insns, [["strlit", slot, nth(atom, 1)]]),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "bool" then
    let slot = ctr in
    let v = if nth(atom, 1) == "true" then 1 else 0 in
    [append(insns, [["mov_imm", slot, v]]),
     slot, env, ctr + 1, funs, funcnt]
  else if k == "var" then
    [insns, env_lookup(env, nth(atom, 1)), env, ctr, funs, funcnt]
  else
    [insns, 0, env, ctr, funs, funcnt]

/* compile a full ANF body (bindings + tail). st as above.
 * Returns [insns, resultSlot, env, counter, funs, funcnt]. */
let lower_body(anf, st) =
  let bindings = nth(anf, 0) in
  let tail = nth(anf, 1) in
  let nb = len(bindings) in
  let step(i, s) =
    if i >= nb then
      let tr = lower_atom(tail, s) in
      [nth(tr, 0), nth(tr, 1), nth(tr, 2), nth(tr, 3), nth(tr, 4), nth(tr, 5)]
    else
      let b = nth(bindings, i) in
      let insns = nth(s, 0) in
      let env = nth(s, 1) in
      let ctr = nth(s, 2) in
      let k = nth(b, 0) in
      if k == "let" then
        let name = nth(b, 1) in
        let atom = nth(b, 2) in
        let r = lower_atom(atom, s) in
        let slot = nth(r, 1) in
        step(i + 1, [nth(r, 0), cons([name, slot, 0], nth(r, 2)), nth(r, 3),
                     nth(r, 4), nth(r, 5)])
      else if k == "letbin" then
        let name = nth(b, 1) in
        let op = nth(b, 2) in
        let a = nth(b, 3) in
        let bop = nth(b, 4) in
        let ra = lower_atom(a, s) in
        let rb = lower_atom(bop, [nth(ra, 0), nth(ra, 2), nth(ra, 3),
                                  nth(ra, 4), nth(ra, 5)]) in
        /* dst after atoms so it cannot alias an operand slot */
        let dst = nth(rb, 3) in
        let lop = if is_cmp(op) then "cmp" else "binop" in
        let newinsn = [lop, op, dst, nth(ra, 1), nth(rb, 1)] in
        step(i + 1, [append(nth(rb, 0), [newinsn]),
                     cons([name, dst, 0], nth(rb, 2)), dst + 1,
                     nth(rb, 4), nth(rb, 5)])
      else if k == "letprint" then
        let atom = nth(b, 2) in
        let ra = lower_atom(atom, s) in
        let newinsn = ["print", nth(ra, 1)] in
        step(i + 1, [append(nth(ra, 0), [newinsn]),
                     cons([nth(b, 1), 0, 0], nth(ra, 2)), nth(ra, 3),
                     nth(ra, 4), nth(ra, 5)])
      else if k == "letcall" then
        let name = nth(b, 1) in
        let fn = nth(b, 2) in
        let args = nth(b, 3) in
        let fnname = nth(fn, 1) in
        let nargs = len(args) in
        let funs0 = nth(s, 3) in
        let loadargs(j, ins, env2, ctr2, slots_rev) =
          if j >= nargs then [ins, reverse(slots_rev), env2, ctr2]
          else
            let r = lower_atom(nth(args, j), [ins, env2, ctr2, funs0, 0]) in
            loadargs(j + 1, nth(r, 0), nth(r, 2), nth(r, 3),
                     cons(nth(r, 1), slots_rev)) in
        /* allocate arg slots first so dst cannot alias an argument */
        let lr = loadargs(0, insns, env, ctr, []) in
        let slots = nth(lr, 1) in
        let dst = nth(lr, 3) in
        /* list / sequence prims */
        let newinsn =
          if fnname == "cons" then ["cons", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "len" then ["len", dst, nth(slots, 0)]
          else if fnname == "nth" then ["nth", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "tail" then ["tail", dst, nth(slots, 0)]
          else if fnname == "append" then
            ["append", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "str_len" then ["str_len", dst, nth(slots, 0)]
          else if fnname == "str_ref" then
            ["str_ref", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "str_cat" then
            ["str_cat", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "str_slice" then
            ["str_slice", dst, nth(slots, 0), nth(slots, 1), nth(slots, 2)]
          else if fnname == "int_to_str" then ["int_to_str", dst, nth(slots, 0)]
          else if fnname == "bytes_to_str" then ["bytes_to_str", dst, nth(slots, 0)]
          else if fnname == "drop" then
            ["drop", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "foldl" then
            ["foldl", dst, nth(slots, 0), nth(slots, 1), nth(slots, 2)]
          else if fnname == "map" then
            ["map", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "bytes_new" then ["bytes_new", dst]
          else if fnname == "bytes_len" then ["bytes_len", dst, nth(slots, 0)]
          else if fnname == "bytes_ref" then
            ["bytes_ref", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "bytes_put" then
            ["bytes_put", dst, nth(slots, 0), nth(slots, 1), nth(slots, 2)]
          else if fnname == "bytes_append" then
            ["bytes_append", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "read_file" then ["read_file", dst, nth(slots, 0)]
          else if fnname == "write_file" then
            ["write_file", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "band" then ["binop", "&", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "bor" then ["binop", "|", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "bshl" then ["binop", "<<", dst, nth(slots, 0), nth(slots, 1)]
          else if fnname == "bshr" then ["binop", ">>", dst, nth(slots, 0), nth(slots, 1)]
          else
            let fnslot = env_lookup(env, fnname) in
            let fncap = env_ncap(env, fnname) in
            if env_has(env, fnname) and fncap > 0 then
              ["apply", dst, fnslot, fncap, slots]
            else if env_has(env, fnname) and not funs_has(funs0, fnname) then
              ["apply", dst, fnslot, 0 - 1, slots]
            else ["call", dst, fnname, slots] in
        step(i + 1, [append(nth(lr, 0), [newinsn]),
                     cons([name, dst, 0], nth(lr, 2)), dst + 1,
                     nth(s, 3), nth(s, 4)])
      else if k == "letfun" then
        let name = nth(b, 1) in
        let params = nth(b, 2) in
        let body = nth(b, 3) in
        let nparams = len(params) in
        /* self-reference (recursion) resolves by direct call, not capture,
         * so the function's own name is added to the shadow. */
        let fvs = free_vars(body, append([name], params), nth(s, 3)) in
        let ncap = len(fvs) in
        /* captured (free) vars occupy slots 1..ncap; user params ncap+1.. */
        let build_cap(j, e) =
          if j >= ncap then e
          else
            let vn = nth(fvs, j) in
            build_cap(j + 1, cons([vn, j + 1, env_ncap(env, vn)], e)) in
        let build_user(j, e) =
          if j >= nparams then e
          else build_user(j + 1, cons([nth(params, j), ncap + j + 1, 0], e)) in
        let p_env = build_user(0, build_cap(0, [])) in
        let ntot = ncap + nparams in
        let br = lower_body(body, [[], p_env, ntot + 1, nth(s, 3), 0]) in
        /* pad frame so recursive calls cannot clobber live slots */
        let nslots = nth(br, 3) + 8 in
        let f_insns = append([["prologue", nslots, ntot]],
                             append(nth(br, 0), [["ret", nth(br, 1)]])) in
        let f = ["fun", name, ntot, ncap, f_insns] in
        let slot = ctr in
        /* Always allocate a closure object so the function is a first-class
         * value (needed for higher-order calls). ncap=0 still gets a heap
         * object with empty env. Nested lowering inherits parent funs. */
        let capslot_of(j, acc) =
          if j >= ncap then acc
          else capslot_of(j + 1, append(acc, [env_lookup(env, nth(fvs, j))])) in
        let capslots = capslot_of(0, []) in
        let clo = ["closure", slot, name, capslots] in
        let funs1 = cons(f, nth(br, 4)) in
        step(i + 1, [append(insns, [clo]), cons([name, slot, ncap], env),
                     ctr + 1, funs1, nth(s, 4) + 1 + nth(br, 5)])
      else if k == "letif" then
        let name = nth(b, 1) in
        let cond = nth(b, 2) in
        let thena = nth(b, 3) in  /* [bindings, tail] */
        let elsea = nth(b, 4) in
        let cr = lower_atom(cond, s) in
        let condslot = nth(cr, 1) in
        /* reserve if-result slot before branches so it cannot alias temps */
        let dst = nth(cr, 3) in
        let ctr1 = dst + 1 in
        /* compile branches independently (fresh insns, same env) */
        let thenr = lower_body(thena, [[], nth(cr, 2), ctr1,
                                       nth(cr, 4), nth(cr, 5)]) in
        /* else labels continue after then's label counter to avoid collisions */
        let elser = lower_body(elsea, [[], nth(cr, 2), ctr1,
                                       nth(cr, 4), nth(thenr, 5)]) in
        let thenslot = nth(thenr, 1) in
        let elseslot = nth(elser, 1) in
        let L = nth(elser, 5) in
        let L0 = str_cat("LIF", int_to_str(L)) in
        let L1 = str_cat("LIF", int_to_str(L + 1)) in
        let L2 = str_cat("LIF", int_to_str(L + 2)) in
        let nextctr =
          if nth(thenr, 3) > nth(elser, 3) then nth(thenr, 3) else nth(elser, 3) in
        let ifbody =
          append([["br", condslot, L0, L1], ["label", L0]],
                 append(nth(thenr, 0),
                        append([["mov", dst, thenslot], ["jmp", L2],
                                ["label", L1]],
                               append(nth(elser, 0),
                                      [["mov", dst, elseslot],
                                       ["label", L2]])))) in
        step(i + 1, [append(nth(cr, 0), ifbody),
                     cons([name, dst, 0], nth(elser, 2)), nextctr,
                     nth(elser, 4), L + 3])
      else step(i + 1, s) in
  step(0, st)

/* ---- public API ---- */
let compile_top(items) =
  let nitems = len(items) in
  let iter(i, env, counter, funs, funcnt, entry_insns, result_slot) =
    if i >= nitems then [env, counter, funs, funcnt, entry_insns, result_slot]
    else
      let r = lower_body(nth(items, i), [entry_insns, env, counter, funs, funcnt]) in
      iter(i + 1, nth(r, 2), nth(r, 3), nth(r, 4), nth(r, 5),
           nth(r, 0), nth(r, 1)) in
  let st = iter(0, [], 1, [], 0, [], 0) in
  let entry_insns = nth(st, 4) in
  let result_slot = nth(st, 5) in
  let funs = nth(st, 2) in
  let nslots = nth(st, 1) in
  let entry = ["fun", "_start", 0, 0,
               append([["prologue", nslots, 0]],
                      append(entry_insns, [["exit", result_slot]]))] in
  ["prog", cons(entry, reverse(funs)), "_start"]
