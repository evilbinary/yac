/* backend.yac — pipeline + image. lir_expr = ANF→LIR；lower_expr = LIR→emit. */

let backend_emit(t, ast) = nth(lower_expr(ast, t), 0)

let backend_pack(t, code) = pack_image(t, code)

let backend_compile(prog) = pack_elf(nth(lower_program(prog), 0))

let anf_top(item) =
  let r = anf_expr(item, 0) in
  [nth(r, 0), nth(r, 1)]

let anf_all(i, prog, acc, n) =
  if i >= n then acc
  else
    let _ = list_push(acc, anf_top(nth(prog, i))) in
    anf_all(i + 1, prog, acc, n)

let pass_lex(src) = tokenize(src)
let pass_parse(toks) = parse_program(toks, 0, [])
let pass_anf(prog) = anf_all(0, prog, list_new(), len(prog))

/* st = [env, ctr, Σ, uid, insns, slot] */
let lir_all(i, items, st, n) =
  if i >= n then st
  else
    let r = lir_expr(nth(items, i),
              st_no([nth(st, 4), nth(st, 0), nth(st, 1), nth(st, 2), nth(st, 3)])) in
    lir_all(i + 1, items,
      [nth(r, 2), nth(r, 3), nth(r, 4), nth(r, 5), nth(r, 0), nth(r, 1)], n)

let pass_lir(anf_list) =
  let rt0 = runtime_funs(0) in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_new(len(rt0)), 0, list_new(), 0],
             len(anf_list)) in
  let funs = sigma_list(nth(st, 2)) in
  let entry = start_proc(nth(st, 1), nth(st, 5), nth(st, 4)) in
  tco_prog(["prog", cons(entry, append(rt0, reverse(funs))), "_start"])

let pass_lir_eval(anf_list) =
  let rt0 = runtime_funs(0) in
  let st = lir_all(0, anf_list,
             [env_new(0), 1, sigma_new(len(rt0)), 0, list_new(), 0],
             len(anf_list)) in
  let funs = sigma_list(nth(st, 2)) in
  let entry = start_proc_eval(nth(st, 1), nth(st, 5), nth(st, 4)) in
  /* prog[2] is the Linux process entry (is_entry in emit). JIT jumps to
   * _eval by name; it must not be prog[2] or it would get _start's ABI. */
  tco_prog(["prog", cons(entry, append(rt0, reverse(funs))), "_start"])

let fun_off(fo, name) =
  if fo == [] then 0
  else if nth(nth(fo, 0), 0) == name then nth(nth(fo, 0), 1)
  else fun_off(drop(fo, 1), name)

let compile_jit(src, t) =
  let prog = pass_lir_eval(pass_anf(pass_parse(pass_lex(src)))) in
  let r = lower_expr(prog, t) in
  jit_run(nth(r, 0), fun_off(nth(r, 1), "_eval"))

let make_pipeline(t) =
  let pass_lower(ast) = nth(lower_expr(ast, t), 0) in
  let pass_pack(code) = pack_image(t, code) in
  [mk_pass("lex", pass_lex),
   mk_pass("parse", pass_parse),
   mk_pass("anf", pass_anf),
   mk_pass("lir", pass_lir),
   mk_pass("lower", pass_lower),
   mk_pass("pack", pass_pack)]

let dump_ast(src) =
  let _ = print(pass_parse(pass_lex(src))) in 0

let dump_anf(src) =
  let _ = print(pass_anf(pass_parse(pass_lex(src)))) in 0

let compile_src(src, outpath, t, profpath) =
  let t0 = time_ms() in
  let _ = if profpath == "" then 0 else yac_prof_enable(profpath) in
  let _ = log("yc", "start") in
  let _ = log_i("yc", "src_len", str_len(src)) in
  let bin = run_passes(make_pipeline(t), src) in
  let _ = log_i("yc", "bin_len", bytes_len(bin)) in
  let _ = log("yc", "write") in
  let _ = write_file(outpath, bin) in
  let _ = log_i("prof", "total", time_ms() - t0) in
  let _ = log("yc", "done") in
  let _ = if profpath == "" then 0 else yac_prof_dump(0) in
  0

let compile_file(inpath, outpath, t, profpath) =
  compile_src(read_file(inpath), outpath, t, profpath)
