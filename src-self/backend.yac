/* backend.yac — emit then pack_elf for emit/elf drivers.
 * yc.yac runs those as two PIPELINE passes instead of this helper.
 */
let backend_compile(prog) =
  let _ = log("backend", "emit begin") in
  let r = emit_program(prog) in
  let _ = log_i("backend", "code_len", bytes_len(nth(r, 0))) in
  let _ = log("backend", "pack") in
  let bin = pack_elf(nth(r, 0)) in
  let _ = log("backend", "done") in
  bin
