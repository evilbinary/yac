/* runtime.yac — arch-independent runtime as LIR (same emit_insn as user code).
 *
 * Kernel: obj_kind / obj_ld / obj_st / obj_sti / obj_st_int / tag / alloc
 * plus ordinary control LIR. cons still goes through emit (yac_alloc).
 * Layout (qword): next=0 mark=8 kind=16 car/len=24 cdr/head=32 (listbuf tail=40).
 * nil is tagged 1. kind 2 = cons, kind 5 = listbuf.
 */

let rt_tail_ins =
  [l_prologue(6, 1),
   l_nil(2),
   l_icmp("==", 3, 1, 2),
   l_br(3, "t_nil", "t_go"),
   l_label("t_nil"),
   l_ret(2),
   l_label("t_go"),
   l_obj_ld(4, 1, 32),
   l_ret(4)]

let rt_len_ins =
  [l_prologue(14, 1),
   l_nil(2),
   l_icmp("==", 3, 1, 2),
   l_br(3, "l_nil", "l_nz"),
   l_label("l_nil"),
   l_mov_imm(4, 0),
   l_ret(4),
   l_label("l_nz"),
   l_obj_kind(5, 1),
   l_mov_imm(6, 5),
   l_icmp("==", 7, 5, 6),
   l_br(7, "l_buf", "l_walk"),
   l_label("l_buf"),
   l_obj_ld(8, 1, 24),
   l_tag(4, 8),
   l_ret(4),
   l_label("l_walk"),
   l_mov(10, 1),
   l_mov_imm(11, 0),
   l_label("l_loop"),
   l_icmp("==", 3, 10, 2),
   l_br(3, "l_done", "l_more"),
   l_label("l_more"),
   l_obj_ld(10, 10, 32),
   l_mov_imm(12, 1),
   l_binop("+", 11, 11, 12),
   l_jmp("l_loop"),
   l_label("l_done"),
   l_ret(11)]

