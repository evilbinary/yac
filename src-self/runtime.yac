/* runtime.yac — arch-independent runtime as LIR (same emit_insn as user code).
 *
 * Kernel: obj_kind / obj_ld / obj_st / obj_sti / obj_st_int / tag / alloc
 * plus ordinary control LIR. cons still goes through emit (yac_alloc).
 * Layout (qword): next=0 mark=8 kind=16 car/len=24 cdr/head=32 (listbuf tail=40).
 * listbuf also: nth cursor i=48 cell=56; index vec@64 (STR blob of cell ptrs),
 * cap@72. nth is O(1) via ld64; GC marks head@32 and vec@64.
 * BYTES kind=4: len@24 cap@32 dataptr@40 (tagged STR blob, payload at +32).
 * Grow reallocs the blob only; the outer pointer stays (like C realloc).
 * nil is tagged 1. kind 2 = cons, kind 5 = listbuf.
 *
 * Insn lists are thunks (rt_*_ins(_)) so big cons literals are not built
 * inside yc's _start. A 33-element literal in that huge frame is mis-emitted
 * (yc_A bytes_to_str → SIGSEGV); the same literal in a small function is fine.
 */

let rt_tail_ins(_) =
  [l_prologue(6, 1),
   l_nil(2),
   l_icmp("==", 3, 1, 2),
   l_br(3, "t_nil", "t_go"),
   l_label("t_nil"),
   l_ret(2),
   l_label("t_go"),
   l_obj_ld(4, 1, 32),
   l_ret(4)]

