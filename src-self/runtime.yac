let runtime_funs(_) =
  [l_fun("yac_tail", 1, 0, rt_tail_ins, "yac_tail"),
   l_fun("yac_len", 1, 0, rt_len_ins, "yac_len"),
   l_fun("yac_nth", 2, 0, rt_nth_ins, "yac_nth"),
   l_fun("yac_list_rev", 1, 0, rt_list_rev_ins, "yac_list_rev"),
   l_fun("yac_append", 2, 0, rt_append_ins, "yac_append"),
   l_fun("yac_drop", 2, 0, rt_drop_ins, "yac_drop"),
   l_fun("yac_list_new", 0, 0, rt_list_new_ins, "yac_list_new"),
   l_fun("yac_list_push", 2, 0, rt_list_push_ins, "yac_list_push"),
   l_fun("yac_foldl", 3, 0, rt_foldl_ins, "yac_foldl"),
   l_fun("yac_map", 2, 0, rt_map_ins, "yac_map"),
   l_fun("yac_str_eq", 2, 0, rt_str_eq_ins, "yac_str_eq"),
   l_fun("yac_str_cat", 2, 0, rt_str_cat_ins, "yac_str_cat"),
   l_fun("yac_str_slice", 3, 0, rt_str_slice_ins, "yac_str_slice"),
   l_fun("yac_str_chr", 1, 0, rt_str_chr_ins, "yac_str_chr"),
   l_fun("yac_int_to_str", 1, 0, rt_int_to_str_ins, "yac_int_to_str"),
   l_fun("yac_bytes_extend", 2, 0, rt_bytes_extend_ins, "yac_bytes_extend"),
   l_fun("yac_bytes_to_str", 1, 0, rt_bytes_to_str_ins, "yac_bytes_to_str")]
