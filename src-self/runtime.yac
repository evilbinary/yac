   l_label("l_buf"),
   l_obj_ld(8, 1, 24),
   l_tag(4, 8),
   l_ret(4),
   l_label("l_walk"),
   l_mov(10, 1),
   l_mov_imm(11, 0),
   l_label("l_loop"),
   l_icmp("==", 3, 10, 2),
   l_br(3, "l_done", "l_more"),
   l_label("l_more"),
   l_obj_ld(10, 10, 32),
   l_mov_imm(12, 1),
   l_binop("+", 11, 11, 12),
   l_jmp("l_loop"),
   l_label("l_done"),
   l_ret(11)]

