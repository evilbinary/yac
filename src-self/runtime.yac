   l_obj_kind(5, 1),
   l_mov_imm(6, 5),
   l_icmp("==", 7, 5, 6),
   l_br(7, "n_buf", "n_cons"),
   l_label("n_buf"),
   l_obj_ld(8, 1, 32),
   l_jmp("n_join"),
   l_label("n_cons"),
   l_mov(8, 1),
   l_label("n_join"),
   l_mov(9, 2),
   l_label("n_loop"),
   l_mov_imm(10, 0),
   l_icmp("==", 11, 9, 10),
   l_br(11, "n_found", "n_step"),
   l_label("n_step"),
   l_obj_ld(8, 8, 32),
   l_mov_imm(12, 1),
   l_binop("-", 9, 9, 12),
   l_jmp("n_loop"),
   l_label("n_found"),
   l_obj_ld(13, 8, 24),
   l_ret(13)]

let rt_list_rev_ins =
  [l_prologue(12, 1),
