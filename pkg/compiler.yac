/* compiler.yac — host compile API for `import compiler`.
 *
 * These names are not linked into the guest. yc runs the calls while
 * compiling (same functions as backend.yac / jit.yac), then emits the
 * rest of the program. Arguments must be string literals.
 *
 *   compile_file(inpath, outpath)  write an image (guest target)
 *   compile(path)                  .yac → .yjit bytes (discarded unless used as rc)
 *   load(path)                     JIT-compile and run in this yc process
 *   compile_src                    same as yc internals (string source → bytes)
 */

 package compiler
 export compile_file, compile, load
 
 let compile_file(inpath, outpath, t, profpath) =
    let bin = compile_src(read_file(inpath), t) in
    if bin == 0 then 1 else let _ = write_file(outpath, bin) in 0


/* Same pipeline as `yc --repl` / `yc --format yjit -o` (in-process, no system). */
let load(path) =
    let src = read_file(path) in
    if src == 0 then 1
    else compile_jit(src, mk_jit_target(host_arch(0)), true)
  
let compile(src) =
    if src == 0 then 0
    else compile_src(src, mk_target(host_arch(0), "yjit", "exec"))
  