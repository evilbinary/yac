/* compiler.yac — host compile API for `import compiler`.
 *
 * These names are not linked into the guest. yc runs the calls while
 * compiling (same functions as backend.yac / jit.yac), then emits the
 * rest of the program. Arguments must be string literals.
 *
 *   compile_file(inpath, outpath)  write an image (guest target)
 *   compile(src)                 exp -> bin
 *   load(path)                   
 */

 package compiler
 export compile_file, compile, load
 import back.backend {compile_native}
 import back.pack.target {target_live}
 import back.jit {compile_jit}
 import back.pack.target {mk_jit_target, mk_target}
 import rt.os {host_arch, host_format}
 
 let compile_file(inpath, outpath, t, profpath) =
    let bin = compile_native(read_file(inpath), t) in
    if bin == 0 then 1 else let _ = write_file(outpath, bin) in 0


let load(path, t) =
    let src = read_file(path) in
    if src == 0 then 1
    else if target_live(t) then compile_jit(src, t, true)
    else compile_jit(src, mk_jit_target(host_arch(0)), true)

let compile(src, t) =
    if src == 0 then 0
    else if target_live(t) then compile_jit(src, t, false)
    else compile_native(src, mk_target(host_arch(0), host_format(0), "exec"))
