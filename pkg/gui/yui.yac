/* yui.yac — ccall bindings for the yui glue (glue/yui_glue.c, built from
 * E:\workspace\yui). Symbols are yui_*; objects cross as int handles. */

package gui.yui
import data.fmap { fmap_new, fmap_get, fmap_put }
export yui_open, yui_init, yui_tick, yui_set_text, yui_click_is, yui_shutdown, yui_game_boot, yui_key, yui_game_vel, yui_game_get, yui_game_pos, yui_game_spawn, yui_game_box, yui_game_hit, yui_game_cull, yui_game_burst, yui_rand,
  yui_sym2, yui_bridge_open, yui_bridge_boot, yui_bridge_create, yui_bridge_del,
  yui_bridge_put_text, yui_bridge_put_bg, yui_bridge_pump, yui_bridge_should_quit,
  yui_render_from_json, yui_set_bg, yui_get_text, yui_hide, yui_show, yui_update,
  yui_resize, yui_inspect_enable, yui_inspect_disable, yui_inspect_bounds,
  yui_inspect_info, yui_inspect_layer, yui_log, yui_theme_load,
  yui_theme_set_current, yui_theme_unload, yui_theme_apply_to_tree, yui_should_quit,
  yui_exit, yui_key_code, yui_focus, yui_focus_move, yui_focus_clear, yui_focus_get,
  yui_get_property, yui_render_json, yui_window_size, yui_spawn, yui_screenshot,
  yui_perf_enable, yui_perf_disable, yui_perf_reset, yui_perf_overlay,
  yui_perf_topn, yui_perf_watch, yui_perf_unwatch, yui_perf_clear_watch

/* ASCII prefix. */
let yui_has(s, p) =
  let n = str_len(p) in
  if str_len(s) < n then false
  else str_slice(s, 0, n) == p

/* Acc for zbuf. */
let yui_z_go(b, i, n) =
  if i >= n then bytes_to_str(b)
  else
    let _ = bytes_append(b, 0) in
    yui_z_go(b, i + 1, n)

/* n zero bytes. */
let yui_zstr(n) =
  if n <= 0 then ""
  else yui_z_go(bytes_new(), 0, n)

/* C string at 0. */
let yui_cstr0_go(s, i, n) =
  if i >= n then s
  else if str_ref(s, i) == 0 then str_slice(s, 0, i)
  else yui_cstr0_go(s, i + 1, n)

/* uname sysname. */
let yui_uname(_) =
  let buf = yui_zstr(256) in
  let _ = ccall("uname", buf) in
  yui_cstr0_go(buf, 0, str_len(buf))

/* Windows. */
let yui_is_win(_) =
  let sys = yui_uname(0) in
  if sys == "" then true
  else if yui_has(sys, "MINGW") then true
  else if yui_has(sys, "MSYS") then true
  else if yui_has(sys, "CYGWIN") then true
  else if yui_has(sys, "Windows") then true
  else false

/* Darwin. */
let yui_is_darwin(_) = yui_has(yui_uname(0), "Darwin")

/* dlopen NOW|GLOBAL. */
let yui_rtld(_) =
  if yui_is_darwin(0) then 2 + 8
  else 2 + 256

/* Load glue .so / .dll. 0 on failure. */
let yui_open(path) =
  if yui_is_win(0) then ccall("LoadLibraryA", path)
  else ccall("dlopen", path, yui_rtld(0))

/* Named symbol after a successful yui_open (dlsym 0 / PE stub). */
let yui_sym(name) = ccall("dlsym", 0, name)

let yui_h = box_new()          /* dlopen handle */
let _ = box_set(yui_h, 0)
let yui_symc = box_new()       /* sym cache: name -> fn ptr */
let _ = box_set(yui_symc, 0)

/* dlsym on the handle we dlopen'd. `yui_sym` uses handle 0 (the main module),
 * which never has these symbols -- the call then went to address 0 and the
 * program died with a null call (2026-10-28). */
let yui_sym2(name) =
  /* Lazy open: a program that only calls yui_init (the documented surface)
   * never calls yui_bridge_open, and every symbol then looked "missing"
   * (2026-10-29). The default path matches app/js. */
  let _ = if box_get(yui_h) == 0 then box_set(yui_h, yui_open("app/native/libyui_yac.so")) else 0 in
  let m = box_get(yui_symc) in
  let m2 = if m == 0 then fmap_new(0) else m in
  let _ = if m == 0 then box_set(yui_symc, m2) else 0 in
  let hit = fmap_get(m2, name) in
  if hit != 0 then hit
  else
    /* Windows has no dlsym: the PE host leaf ignores the handle, so look the
     * symbol up in the module returned by LoadLibraryA. On a Linux build swap
     * this for ccall("dlsym", box_get(yui_h), name). */
    let p = ccall("GetProcAddress", box_get(yui_h), name) in
    let _ = if p != 0 then fmap_put(m2, name, p) else 0 in
    p

let yui_bridge_open(path) =
  if box_get(yui_h) != 0 then box_get(yui_h)
  else
    let h = yui_open(path) in
    let _ = box_set(yui_h, h) in
    h

let yui_bridge_sym(name) = yui_sym2(name)

/* A symbol that failed to resolve must never be called: ccall(0, ...) jumps to
 * address 0 and the process dies with rip=0 and no output at all. That is what
 * `domtest` did when the .so exported only cJSON names (2026-10-28). */
let yui_missing(name) =
  let _ = print(str_cat("yui: symbol missing in libyui_yac.so: ", name)) in
  -1

let yui_c0(name) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p)
let yui_c1(name, a) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p, a)
let yui_c2(name, a, b) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p, a, b)
let yui_c3(name, a, b, c) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p, a, b, c)
let yui_c4(name, a, b, c, d) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p, a, b, c, d)
let yui_c5(name, a, b, c, d, e) =
  let p = yui_sym2(name) in
  if p == 0 then yui_missing(name) else ccall(p, a, b, c, d, e)

/* yui_init(json_path, assets): boot the window, 0 = ok. */
let yui_init(json, assets) = yui_c2("yui_yac_init", json, assets)

/* Pump one frame (YUI.tick). */
let yui_tick(_) = yui_c0("yui_yac_tick")

/* Set widget text (YUI.setText). */
let yui_set_text(id, text) = yui_c2("yui_yac_set_text", id, text)

/* Nonzero if id was clicked since the last poll. */
let yui_click_is(id) = yui_c1("yui_yac_click_is", id)

/* Tear down. */
let yui_shutdown(_) = yui_c0("yui_yac_shutdown")

/* ---- game API (yui_yac_game_*) -----------------------------------------
 * These used to go through yui_sym (dlsym on the main module), which finds
 * nothing on Windows: the call went to address 0. They also named symbols
 * that no longer exist (yui_boot / yui_rand). */

/* Load a game scene JSON. */
let yui_game_boot(path) = yui_c1("yui_yac_game_boot", path)

/* Key down? */
let yui_key(name) = yui_c1("yui_yac_game_key", name)

/* Set velocity. */
let yui_game_vel(id, vx, vy) = yui_c3("yui_yac_game_vel", id, vx, vy)

/* Field which of entity id. */
let yui_game_get(id, which) = yui_c2("yui_yac_game_get", id, which)

/* Set position. */
let yui_game_pos(id, x, y) = yui_c3("yui_yac_game_pos", id, x, y)

/* Spawn entity. */
let yui_game_spawn(id, tag, x, y, rgb) = yui_c5("yui_yac_game_spawn", id, tag, x, y, rgb)

/* Hit box. */
let yui_game_box(id, w, h) = yui_c3("yui_yac_game_box", id, w, h)

/* Overlap with tag. */
let yui_game_hit(id, tag) = yui_c2("yui_yac_game_hit", id, tag)

/* Drop tagged ents past ymax. */
let yui_game_cull(tag, ymax) = yui_c2("yui_yac_game_cull", tag, ymax)

/* Burst at x,y. */
let yui_game_burst(x, y, rgb) = yui_c3("yui_yac_game_burst", x, y, rgb)

/* Random 0..n-1. */
let yui_rand(n) = yui_c1("yui_yac_rand", n)

/* ---- DOM bridge (app/native/yui_yac.c: yui_dom_*) ------------------------
 * DOM elements become real yui layers addressed by ID STRINGS (ccall cannot
 * return pointers or strings, so ids are minted by browser.yac and carried in
 * the JSON fragment). If native/libyui_yac.so is missing every call degrades
 * to a no-op and the stubs keep working. ---- */

/* ---- YUI.* surface -------------------------------------------------------
 * Mirrors yui/docs/yui-js-api.md and lib/jsmodule-quickjs, where the engine
 * exposes YUI.setText/getText/setBgColor/hide/show/renderFromJson/update/
 * resize/inspect.* and resolves an id to a Layer inside the binding. Here the
 * id-addressed entry points are the yui_yac_* / yui_dom_* exports of
 * app/native/yui_yac.c (the library's yui_set_text/yui_set_visible/yui_update
 * take a Layer*, so they cannot be called from yac directly).
 * ccall can only marshal numbers and C strings IN; anything that returns a
 * string comes back as a host pointer (see yui_get_text). ---- */

/* YUI.renderFromJson(layerId, json): build children of layerId. 0 = ok. */
let yui_render_from_json(layer_id, json) = yui_c2("yui_dom_create", layer_id, json)

/* YUI.setBgColor / YUI.getText. setText lives above (yui_set_text). getText
 * returns a HOST char* (0 when the layer is missing), not a yac string. */
let yui_set_bg(id, hex) = yui_c2("yui_dom_set_bg", id, hex)
let yui_get_text(id) = yui_c1("yui_yac_get_text", id)

/* YUI.hide / YUI.show. */
let yui_hide(id) = yui_c2("yui_yac_set_visible", id, 0)
let yui_show(id) = yui_c2("yui_yac_set_visible", id, 1)

/* YUI.update(json): incremental update of the layer tree. */
let yui_update(json) = yui_c1("yui_yac_update_json", json)

/* YUI resize + inspect toggles (they are ints, i.e. booleans here). */
let yui_resize(w, h) = yui_c2("yui_yac_resize", w, h)
let yui_inspect_enable(_) = yui_c1("yui_yac_inspect", 1)
let yui_inspect_disable(_) = yui_c1("yui_yac_inspect", 0)
let yui_inspect_bounds(show) = yui_c1("yui_yac_inspect_bounds", show)
let yui_inspect_info(show) = yui_c1("yui_yac_inspect_info", show)
let yui_inspect_layer(id, enabled) = yui_c2("yui_yac_inspect_layer", id, enabled)

/* YUI.log(msg): yui_log is variadic, the glue passes ("%s", msg). */
let yui_log(msg) = yui_c1("yui_yac_log", msg)

/* ---- theme API (theme_manager_*, id/layer addressed in the glue) ---- */
let yui_theme_load(path) = yui_c1("yui_yac_theme_load", path)
let yui_theme_set_current(name) = yui_c1("yui_yac_theme_current", name)
let yui_theme_unload(name) = yui_c1("yui_yac_theme_unload", name)
let yui_theme_apply_to_tree(_) = yui_c0("yui_yac_theme_apply")

/* ---- parity with lib/jsmodule-mquickjs (the doc is behind the code) ------
 * Registered there but missing from docs/yui-js-api.md: exit, keyCode,
 * focus/focusMove/focusClear/focusGet, getProperty, renderFromJson's append
 * flag, getWindowSize, spawn, screenshot, perf.*. readFile/listDir/resizeRoot
 * and call/dump are engine/fs helpers -- use pkg/fs and yui_resize instead. */
let yui_exit(_) = yui_c0("yui_yac_exit")
let yui_key_code(_) = yui_c0("yui_yac_key_code")

let yui_focus(id) = yui_c1("yui_yac_focus", id)
let yui_focus_move(dir) = yui_c1("yui_yac_focus_move", dir)
let yui_focus_clear(_) = yui_c0("yui_yac_focus_clear")
let yui_focus_get(_) = yui_c0("yui_yac_focus_get")

/* JSON text of a layer property (host char*, 0-length string when absent). */
let yui_get_property(id, key) = yui_c2("yui_yac_get_property", id, key)

/* YUI.renderFromJson(layer_id, json, append?) -- append defaults to 0, i.e.
 * REPLACE, and an empty/unknown layer_id means the root (mquickjs behaviour). */
let yui_render_json(id, json, append) = yui_c3("yui_yac_render_json", id, json, append)

/* (width << 16) | height */
let yui_window_size(_) = yui_c0("yui_yac_window_size")

let yui_spawn(cmd) = yui_c1("yui_yac_spawn", cmd)
let yui_screenshot(path) = yui_c1("yui_yac_screenshot", path)

let yui_perf_enable(_) = yui_c1("yui_yac_perf", 1)
let yui_perf_disable(_) = yui_c1("yui_yac_perf", 0)
let yui_perf_reset(_) = yui_c0("yui_yac_perf_reset")
let yui_perf_overlay(on) = yui_c1("yui_yac_perf_overlay", on)
let yui_perf_topn(n) = yui_c1("yui_yac_perf_topn", n)
let yui_perf_watch(id) = yui_c1("yui_yac_perf_watch", id)
let yui_perf_unwatch(id) = yui_c1("yui_yac_perf_unwatch", id)
let yui_perf_clear_watch(_) = yui_c0("yui_yac_perf_clear_watch")

/* YUI window lifecycle: yui_tick/yui_init are above (same C entry points).
 * There is no should_quit export in the .so -- quitting is reported by
 * yui_tick's RETURN VALUE (backend_should_quit inside yui_yac_tick). Kept as 0
 * so a caller polling it never mistakes "not available" for "quit now". */
let yui_should_quit(_) = 0

/* ---- DOM bridge entry points (browser.yac) -------------------------------
 * Same C functions, kept under the names the DOM stubs already use. */
let yui_bridge_boot(json_path, assets) = yui_c2("yui_yac_init", json_path, assets)
let yui_bridge_create(parent_id, json) = yui_render_from_json(parent_id, json)
let yui_bridge_del(parent_id, child_id) = yui_c2("yui_dom_remove", parent_id, child_id)
let yui_bridge_put_text(id, text) = yui_set_text(id, text)
let yui_bridge_put_bg(id, hex) = yui_set_bg(id, hex)
let yui_bridge_pump(_) = yui_tick(0)
let yui_bridge_should_quit(_) = yui_should_quit(0)
