/* env.yac — process environment. Miss / empty on Windows is 0. */

package env
export get, get_or

/* ASCII prefix. */
let env_has(s, p) =
  let n = str_len(p) in
  if str_len(s) < n then false
  else str_slice(s, 0, n) == p

/* Acc for zbuf. */
let env_z_go(b, i, n) =
  if i >= n then bytes_to_str(b)
  else
    let _ = bytes_append(b, 0) in
    env_z_go(b, i + 1, n)

/* n zero bytes as a C buffer. */
let env_zstr(n) =
  if n <= 0 then ""
  else env_z_go(bytes_new(), 0, n)

/* C string at off. */
let env_cstr_go(s, off, i, n) =
  if off + i >= n then str_slice(s, off, n - off)
  else if str_ref(s, off + i) == 0 then str_slice(s, off, i)
  else env_cstr_go(s, off, i + 1, n)

/* Bytes until NUL from off. */
let env_cstr_at(s, off) =
  let n = str_len(s) in
  if off >= n then ""
  else env_cstr_go(s, off, 0, n)

/* uname sysname. */
let env_uname(_) =
  let buf = env_zstr(256) in
  let _ = ccall("uname", buf) in
  env_cstr_at(buf, 0)

/* Windows. */
let env_is_win(_) =
  let sys = env_uname(0) in
  if sys == "" then true
  else if env_has(sys, "MINGW") then true
  else if env_has(sys, "MSYS") then true
  else if env_has(sys, "CYGWIN") then true
  else if env_has(sys, "Windows") then true
  else false

/* Windows GetEnvironmentVariableA; grow if PATH is longer than cap. */
let get_win(name, cap) =
  let buf = env_zstr(cap) in
  let n = ccall("GetEnvironmentVariableA", name, buf, cap) in
  if n == 0 then 0
  else if n >= cap then get_win(name, n + 16)
  else env_cstr_at(buf, 0)

/* Value of name, or 0 if unset (Windows empty looks unset). */
let get(name) =
  if env_is_win(0) then get_win(name, 256)
  else
    let p = ccall("getenv", name) in
    if p == 0 then 0
    else
      let buf = env_zstr(4096) in
      let _ = ccall("strncpy", buf, p, 4095) in
      env_cstr_at(buf, 0)

/* get(name), or d if missing. */
let get_or(name, d) =
  let v = get(name) in
  if v == 0 then d
  else v
