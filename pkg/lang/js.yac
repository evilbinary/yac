/* js.yac — JavaScript subset -> yac source (guest translator).
 * js_to_yac(src) -> yac source string, or "error: ..." on failure.
 *
 * Core subset: literals (num/string/bool/null/undefined, array, object),
 * arithmetic / compare / logic, ternary, member / index / call, assignment
 * (incl. compound), let/const/var, if/else, while, for(;;), return, function
 * declarations, console.log, Math.*.
 *
 * Mapping notes:
 *   - JS variables are mutable, so each binding becomes a box
 *     (box_new / box_set / box_get).
 *   - Loops become self-recursive lets; `return` uses a per-call flag box so
 *     it short-circuits out of nested if / loop bodies.
 *   - Arrays use list_new + list_push / list_set, objects use data.fmap.
 *   - `a + b` becomes str_cat when either side is a string literal, else `+`.
 *
 * State is threaded explicitly as `st` = [err, ns, use_fmap, use_math,
 * use_str] (all boxes). It is created inside js_to_yac, NOT as a package-level
 * binding: a package-scope function reading a same-package top-level box is
 * unsupported and crashes in the REPL/JIT link path
 * (docs/BOOTSTRAP_LINK.md §12.10).
 *
 * Known limitations (by design, not bugs):
 *   - No function expressions, classes / this / prototypes, try/catch, break /
 *     continue, async, regexp, getters.
 *   - Function declarations are hoisted within their block, but a function may
 *     only call itself or functions already declared before it (yac has no
 *     forward references across top-level lets, so no mutual recursion).
 *   - `.length` is str_len only for a string LITERAL; for a variable it is
 *     `len` (strings have no type predicate to branch on).
 *   - `if` needs a boolean condition; JS truthiness of a raw value is not
 *     emulated. */

package lang.js
export js_to_yac

/* ---- character classes ------------------------------------------------ */

let js_sp(c) = c == 32 or c == 9 or c == 10 or c == 13
let js_digit(c) = c >= 48 and c <= 57
let js_alpha(c) = (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

/* Identifier start / continue: letters, `_`, `$`, then digits. */
let js_id0(c) = js_alpha(c) or c == 95 or c == 36
let js_idc(c) = js_id0(c) or js_digit(c)

/* ---- lexer ------------------------------------------------------------ */

/* Skip whitespace, `//` line comments and block comments; return next index. */
let js_skip(src, i, n) =
  let rec(k) =
    if k >= n then k
    else
      let c = str_ref(src, k) in
      if js_sp(c) then rec(k + 1)
      else if c == 47 and k + 1 < n then
        let d = str_ref(src, k + 1) in
        if d == 47 then
          let rec2(j) =
            if j >= n then j
            else if str_ref(src, j) == 10 then j
            else rec2(j + 1) in
          rec(rec2(k + 2))
        else if d == 42 then
          let rec3(j) =
            if j + 1 >= n then n
            else if str_ref(src, j) == 42 and str_ref(src, j + 1) == 47 then j + 2
            else rec3(j + 1) in
          rec(rec3(k + 2))
        else k
      else k in
  rec(i)

/* String literal starting after quote `q`; decodes \n \t \r \0 and \\ \q.
 * Returns [decoded, next-index]. */
let js_lex_str(src, i, n, q) =
  let rec(j, acc) =
    if j >= n then [acc, j]
    else
      let c = str_ref(src, j) in
      if c == q then [acc, j + 1]
      else if c == 92 then
        if j + 1 >= n then [acc, j]
        else
          let e = str_ref(src, j + 1) in
          let bit =
            if e == 110 then "\n"
            else if e == 116 then "\t"
            else if e == 114 then str_chr(13)
            else if e == 48 then str_chr(0)
            else str_slice(src, j + 1, 1) in
          rec(j + 2, str_cat(acc, bit))
      else rec(j + 1, str_cat(acc, str_slice(src, j, 1))) in
  rec(i, "")

/* Template literal body after the opening backtick. `${…}` is kept verbatim
 * for the parser; escapes are decoded (`\`` -> backtick, `\$` -> `$`).
 * Returns [raw, next-index]. */
let js_lex_tmpl(src, i, n) =
  let rec(j, acc) =
    if j >= n then [acc, j]
    else
      let c = str_ref(src, j) in
      if c == 96 then [acc, j + 1]
      else if c == 92 then
        if j + 1 >= n then [acc, j]
        else
          let e = str_ref(src, j + 1) in
          let bit =
            if e == 110 then "\n"
            else if e == 116 then "\t"
            else if e == 114 then str_chr(13)
            else str_slice(src, j + 1, 1) in
          rec(j + 2, str_cat(acc, bit))
      else rec(j + 1, str_cat(acc, str_slice(src, j, 1))) in
  rec(i, "")

/* Number literal: digits with at most one `.`; returns [text, next-index]. */
let js_lex_num(src, i, n) =
  let rec(j, dot) =
    if j >= n then j
    else
      let c = str_ref(src, j) in
      if js_digit(c) then rec(j + 1, dot)
      else if c == 46 and dot == false then rec(j + 1, true)
      else j in
  let e = rec(i, false) in
  [str_slice(src, i, e - i), e]

/* Identifier / keyword text; returns [text, next-index]. */
let js_lex_id(src, i, n) =
  let rec(j) =
    if j >= n then j
    else if js_idc(str_ref(src, j)) then rec(j + 1)
    else j in
  let e = rec(i) in
  [str_slice(src, i, e - i), e]

/* True for the two-character operators the lexer recognises. */
let js_op2(s) =
  s == "==" or s == "!=" or s == "<=" or s == ">=" or s == "&&" or s == "||" or s == "+=" or s == "-=" or s == "*=" or s == "/=" or s == "%=" or s == "++" or s == "--" or s == "<<" or s == ">>" or s == "&=" or s == "|=" or s == "^=" or s == "=>" or s == "**"

let js_op3(s) = s == ">>>" or s == "<<=" or s == ">>=" or s == "**="

let js_op4(s) = s == ">>>="

/* True for a single-character operator / punctuation code. */
let js_op1c(c) =
  c == 43 or c == 45 or c == 42 or c == 47 or c == 37 or c == 61 or c == 60 or c == 62 or c == 33 or c == 63 or c == 58 or c == 46 or c == 44 or c == 59 or c == 40 or c == 41 or c == 123 or c == 125 or c == 91 or c == 93 or c == 38 or c == 94 or c == 124 or c == 126

/* Tokenize into a listbuf of [kind, text]; kind ∈ str/num/id/p/eof/unk. */
let js_lex(src) =
  let n = str_len(src) in
  let acc = list_new() in
  let rec(i) =
    let j = js_skip(src, i, n) in
    if j >= n then
      let _ = list_push(acc, ["eof", ""]) in acc
    else
      let c = str_ref(src, j) in
      if c == 34 or c == 39 then
        let r = js_lex_str(src, j + 1, n, c) in
        let _ = list_push(acc, ["str", nth(r, 0)]) in rec(nth(r, 1))
      else if c == 96 then
        let r = js_lex_tmpl(src, j + 1, n) in
        let _ = list_push(acc, ["tmpl", nth(r, 0)]) in rec(nth(r, 1))
      else if js_digit(c) then
        let r = js_lex_num(src, j, n) in
        let _ = list_push(acc, ["num", nth(r, 0)]) in rec(nth(r, 1))
      else if js_id0(c) then
        let r = js_lex_id(src, j, n) in
        let _ = list_push(acc, ["id", nth(r, 0)]) in rec(nth(r, 1))
      else if (j + 3 <= n) and (str_slice(src, j, 3) == "===") then
        let _ = list_push(acc, ["p", "==="]) in rec(j + 3)
      else if (j + 3 <= n) and (str_slice(src, j, 3) == "!==") then
        let _ = list_push(acc, ["p", "!=="]) in rec(j + 3)
      else if (j + 4 <= n) and js_op4(str_slice(src, j, 4)) then
        let _ = list_push(acc, ["p", str_slice(src, j, 4)]) in rec(j + 4)
      else if (j + 3 <= n) and js_op3(str_slice(src, j, 3)) then
        let _ = list_push(acc, ["p", str_slice(src, j, 3)]) in rec(j + 3)
      else if (j + 2 <= n) and js_op2(str_slice(src, j, 2)) then
        let _ = list_push(acc, ["p", str_slice(src, j, 2)]) in rec(j + 2)
      else if js_op1c(c) then
        let _ = list_push(acc, ["p", str_slice(src, j, 1)]) in rec(j + 1)
      else
        let _ = list_push(acc, ["unk", str_slice(src, j, 1)]) in rec(j + 1) in
  rec(0)

/* ---- token access ----------------------------------------------------- */

let js_k(t) = nth(t, 0)
let js_t(t) = nth(t, 1)
let js_at(toks, i) = if i >= len(toks) then ["eof", ""] else nth(toks, i)
let js_is(toks, i, s) = js_t(js_at(toks, i)) == s

/* ---- errors (state is threaded; see header) --------------------------- */

let st_err(st) = nth(st, 0)
let st_ns(st) = nth(st, 1)
let st_fmap(st) = nth(st, 2)
let st_math(st) = nth(st, 3)
let st_str(st) = nth(st, 4)
let st_bool(st) = nth(st, 5)
let st_typeof(st) = nth(st, 6)
let st_lib(st) = nth(st, 7)
let st_strpkg(st) = nth(st, 8)
let st_obj(st) = nth(st, 9)
let st_jslib(st) = nth(st, 10)
let st_truth(st) = nth(st, 11)

/* Record msg if no error yet; returns "0" so it can stand in for an expr. */
let js_fail(st, msg) =
  let e = st_err(st) in
  let cur = box_get(e) in
  let _ = if cur == "" then box_set(e, msg) else 0 in
  "0"

/* Error AST node (also records the message). */
let js_bad(st, msg) =
  let _ = js_fail(st, msg) in
  ["err", msg]

/* ---- operator precedence --------------------------------------------- */

/* Binary precedence: assignment (1) < `?` (2) < `||` < `&&` < eq < rel <
 * add < mul. Everything lower than the current min stops the climb. */
let js_prec2(op) =
  if op == "||" then 3
  else if op == "&&" then 4
  else if op == "|" then 5
  else if op == "^" then 6
  else if op == "&" then 7
  else if op == "==" or op == "!=" or op == "===" or op == "!==" then 8
  else if op == "<" or op == "<=" or op == ">" or op == ">=" or op == "in" or op == "instanceof" then 9
  else if op == "<<" or op == ">>" or op == ">>>" then 10
  else if op == "+" or op == "-" then 11
  else if op == "*" or op == "/" or op == "%" then 12
  else if op == "**" then 13
  else 0

let js_assign_op(op) =
  op == "=" or op == "+=" or op == "-=" or op == "*=" or op == "/=" or op == "%="
    or op == "&=" or op == "|=" or op == "^=" or op == "<<=" or op == ">>=" or op == ">>>="
    or op == "**="

/* Function-expression bodies are statement lists, but js_parse_stmts is defined
 * after js_parse_expr (no forward references across top-level lets). Reach it
 * through a box that js_to_yac fills in. */
let js_stmts_parse_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let js_parse_stmts_v(toks, i, mode, st) = (box_get(js_stmts_parse_box))(toks, i, mode, st)

/* ---- expression parser (Pratt) --------------------------------------- */

/* If toks[i] is `(` starting an arrow parameter list `(a, b) =>`, return
 * [params, body-start-index] (index just past `=>`); else 0. Plain identifiers
 * only (no defaults/rest/destructuring yet). */
let js_arrow_params(toks, i) =
  let go(j, acc) =
    let t = js_at(toks, j) in
    if js_k(t) == "id" then
      let j2 = j + 1 in
      if js_is(toks, j2, ",") then go(j2 + 1, cons(js_t(t), acc))
      else if js_is(toks, j2, ")") and js_is(toks, j2 + 1, "=>") then
        [list_rev(cons(js_t(t), acc)), j2 + 2]
      else 0
    else 0 in
  if js_is(toks, i + 1, ")") and js_is(toks, i + 2, "=>") then [[], i + 3]
  else go(i + 1, [])

/* Parse one expression at minimum precedence `min`. Self-recursive for
 * prefix / grouping / args / infix, so it needs no forward references.
 * A node is a tagged list:
 *   ["num"|"str"/"bool", text] ["null"] ["undef"] ["id", name]
 *   ["arr", xs] ["obj", [[key,val],…]]
 *   ["un", op, e] ["bin", op, l, r] ["cond", c, a, b]
 *   ["assign", op, target, value] ["call", callee, args]
 *   ["idx", obj, i] ["mem", obj, name] ["err", msg]
 * Returns [node, next-index]. */
let js_parse_expr(toks, i, min, st) =
  let tk = js_at(toks, i) in
  let tx = js_t(tk) in
  let kk = js_k(tk) in
  let arrow_body(j) =
    if js_is(toks, j, "{") then
      let bd = js_parse_stmts_v(toks, j + 1, ["list", "}"], st) in
      [nth(bd, 0), nth(bd, 1)]
    else
      let r = js_parse_expr(toks, j, 0, st) in
      [[["ret", nth(r, 0)]], nth(r, 1)] in
  let pdef(jj, acc) =
    if js_is(toks, jj, ")") then [list_rev(acc), jj + 1]
    else
      let nm = js_t(js_at(toks, jj)) in
      let j2 = jj + 1 in
      if js_is(toks, j2, "=") then
        let r = js_parse_expr(toks, j2 + 1, 0, st) in
        let j3 = nth(r, 1) in
        let a2 = cons([nm, nth(r, 0)], acc) in
        if js_is(toks, j3, ",") then pdef(j3 + 1, a2) else [list_rev(a2), j3 + 1]
      else if js_is(toks, j2, ",") then pdef(j2 + 1, cons(nm, acc))
      else [list_rev(cons(nm, acc)), j2 + 1] in
  let tmpl_parts(raw) =
    let n = str_len(raw) in
    let find(j, depth, instr, q) =
      if j >= n then n
      else
        let d = str_ref(raw, j) in
        if instr then
          (if d == 92 then find(j + 2, depth, instr, q)
           else if d == q then find(j + 1, depth, false, q)
           else find(j + 1, depth, instr, q))
        else if d == 39 or d == 34 then find(j + 1, depth, true, d)
        else if d == 123 then find(j + 1, depth + 1, false, q)
        else if d == 125 then (if depth == 0 then j else find(j + 1, depth - 1, false, q))
        else find(j + 1, depth, false, q) in
    let go(i, acc) =
      if i >= n then list_rev(acc)
      else if str_ref(raw, i) == 36 and i + 1 < n and str_ref(raw, i + 1) == 123 then
        let j0 = i + 2 in
        let e = find(j0, 0, false, 0) in
        let ex = str_slice(raw, j0, e - j0) in
        let rt = js_parse_expr(js_lex(ex), 0, 0, st) in
        go(e + 1, cons(nth(rt, 0), acc))
      else
        let lit(k) =
          if k >= n then k
          else if str_ref(raw, k) == 36 and k + 1 < n and str_ref(raw, k + 1) == 123 then k
          else lit(k + 1) in
        let k2 = lit(i) in
        go(k2, cons(["str", str_slice(raw, i, k2 - i)], acc)) in
    go(0, [])
  in
  let pre =
    /* Literals first: a string token whose text is "!" / "-" / "function" ...
     * must NOT be mistaken for an operator or keyword. */
    if kk == "tmpl" then [["tmpl", tmpl_parts(tx)], i + 1]
    else if kk == "num" then [["num", tx], i + 1]
    else if kk == "str" then [["str", tx], i + 1]
    else if kk == "id" then
      if tx == "typeof" then
        let r = js_parse_expr(toks, i + 1, 13, st) in [["typeof", nth(r, 0)], nth(r, 1)]
      else if tx == "void" then
        let r = js_parse_expr(toks, i + 1, 13, st) in [["un", "void", nth(r, 0)], nth(r, 1)]
      else if tx == "delete" then
        let r = js_parse_expr(toks, i + 1, 13, st) in [["del", nth(r, 0)], nth(r, 1)]
      else if tx == "function" then
        let jn = i + 1 in
        let nm = if js_k(js_at(toks, jn)) == "id" then js_t(js_at(toks, jn)) else "" in
        let jparen = if nm == "" then jn else jn + 1 in
        let j2 = if js_is(toks, jparen, "(") then jparen + 1 else jparen in
        let pr = pdef(j2, []) in
        let bd = js_parse_stmts_v(toks, nth(pr, 1) + 1, ["list", "}"], st) in
        [["funexpr", nm, nth(pr, 0), nth(bd, 0)], nth(bd, 1)]
      else if tx == "true" or tx == "false" then [["bool", tx], i + 1]
      else if tx == "null" then [["null"], i + 1]
      else if tx == "undefined" then [["undef"], i + 1]
      else if tx == "this" then [["this"], i + 1]
      else if tx == "new" then
        let r = js_parse_expr(toks, i + 1, 13, st) in [["new", nth(r, 0)], nth(r, 1)]
      else [["id", tx], i + 1]
    else if tx == "!" then
      let r = js_parse_expr(toks, i + 1, 13, st) in [["un", "!", nth(r, 0)], nth(r, 1)]
    else if tx == "~" then
      let r = js_parse_expr(toks, i + 1, 13, st) in [["un", "~", nth(r, 0)], nth(r, 1)]
    else if tx == "-" then
      let r = js_parse_expr(toks, i + 1, 13, st) in [["un", "-", nth(r, 0)], nth(r, 1)]
    else if tx == "+" then js_parse_expr(toks, i + 1, 13, st)
    else if tx == "++" or tx == "--" then
      let r = js_parse_expr(toks, i + 1, 13, st) in [["prefix", tx, nth(r, 0)], nth(r, 1)]
    else if tx == "(" then
      let ap = js_arrow_params(toks, i) in
      if ap != 0 then
        let bd = arrow_body(nth(ap, 1)) in
        [["funexpr", "", nth(ap, 0), nth(bd, 0)], nth(bd, 1)]
      else
        let r = js_parse_expr(toks, i + 1, 0, st) in
        if js_is(toks, nth(r, 1), ")") then [nth(r, 0), nth(r, 1) + 1]
        else [js_bad(st, "expected ')'"), nth(r, 1)]
    else if tx == "[" then
      /* Array literal: comma-separated expressions until `]`. */
      let go(j, acc) =
        if js_is(toks, j, "]") then [["arr", list_rev(acc)], j + 1]
        else
          let r = js_parse_expr(toks, j, 0, st) in
          let j2 = nth(r, 1) in
          if js_is(toks, j2, ",") then go(j2 + 1, cons(nth(r, 0), acc))
          else if js_is(toks, j2, "]") then [["arr", list_rev(cons(nth(r, 0), acc))], j2 + 1]
          else [js_bad(st, "expected ',' or ']' in array"), j2] in
      go(i + 1, [])
    else if tx == "{" then
      /* Object literal: `key: value`, shorthand `key`, method `m(){}`, and
       * computed `[expr]: value`, comma-separated. */
      let go(j, acc) =
        if js_is(toks, j, "}") then [["obj", list_rev(acc)], j + 1]
        else
          let pair =
            if js_is(toks, j, "[") then
              let kr = js_parse_expr(toks, j + 1, 0, st) in
              let j2 = nth(kr, 1) in
              let j3 = if js_is(toks, j2, "]") then j2 + 1 else j2 in
              let j4 = if js_is(toks, j3, ":") then j3 + 1 else j3 in
              let r = js_parse_expr(toks, j4, 0, st) in
              [nth(kr, 0), nth(r, 0), nth(r, 1)]
            else
              let kt = js_at(toks, j) in
              let key =
                if js_k(kt) == "id" then ["str", js_t(kt)]
                else if js_k(kt) == "str" then kt
                else if js_k(kt) == "num" then ["str", js_t(kt)]
                else ["str", ""] in
              let j2 = j + 1 in
              if js_is(toks, j2, "(") then
                let pr = pdef(j2 + 1, []) in
                let bd = js_parse_stmts_v(toks, nth(pr, 1) + 1, ["list", "}"], st) in
                [key, ["funexpr", "", nth(pr, 0), nth(bd, 0)], nth(bd, 1)]
              else if js_is(toks, j2, ":") then
                let r = js_parse_expr(toks, j2 + 1, 0, st) in
                [key, nth(r, 0), nth(r, 1)]
              else
                [key, ["id", js_t(kt)], j2] in
          let k2 = nth(pair, 0) in
          let v2 = nth(pair, 1) in
          let j3 = nth(pair, 2) in
          if js_is(toks, j3, ",") then go(j3 + 1, cons([k2, v2], acc))
          else if js_is(toks, j3, "}") then [["obj", list_rev(cons([k2, v2], acc))], j3 + 1]
          else [js_bad(st, "expected ',' or '}' in object"), j3] in
      go(i + 1, [])
    else [js_bad(st, str_cat("unexpected token '", str_cat(tx, "'"))), i + 1] in
  /* Postfix (`.x` `[i]` `(args)`) binds tightest; then infix by precedence,
   * with ternary and right-associative assignment handled specially. */
  let loop(lhs, j) =
    let t2 = js_at(toks, j) in
    let x2 = js_t(t2) in
    let k2 = js_k(t2) in
    if k2 == "p" and x2 == "." then
      let nt = js_at(toks, j + 1) in
      loop(["mem", lhs, js_t(nt)], j + 2)
    else if k2 == "p" and x2 == "[" then
      let r = js_parse_expr(toks, j + 1, 0, st) in
      if js_is(toks, nth(r, 1), "]") then loop(["idx", lhs, nth(r, 0)], nth(r, 1) + 1)
      else [js_bad(st, "expected ']'"), nth(r, 1)]
    else if k2 == "p" and x2 == "(" then
      let args(jj, acc) =
        if js_is(toks, jj, ")") then [list_rev(acc), jj + 1]
        else
          let r = js_parse_expr(toks, jj, 0, st) in
          let j2 = nth(r, 1) in
          if js_is(toks, j2, ",") then args(j2 + 1, cons(nth(r, 0), acc))
          else if js_is(toks, j2, ")") then [list_rev(cons(nth(r, 0), acc)), j2 + 1]
          else [0, j2] in
      let ar = args(j + 1, []) in
      loop(["call", lhs, nth(ar, 0)], nth(ar, 1))
    else if k2 == "p" and x2 == "=>" then
      let ps = if nth(lhs, 0) == "id" then [nth(lhs, 1)] else [] in
      let bd = arrow_body(j + 1) in
      [["funexpr", "", ps, nth(bd, 0)], nth(bd, 1)]
    else if k2 == "p" and (x2 == "++" or x2 == "--") then loop(["postfix", lhs, x2], j + 1)
    else if k2 == "p" and (x2 == "?") and (min <= 2) then
      let a = js_parse_expr(toks, j + 1, 0, st) in
      if js_is(toks, nth(a, 1), ":") then
        let b = js_parse_expr(toks, nth(a, 1) + 1, 2, st) in
        loop(["cond", lhs, nth(a, 0), nth(b, 0)], nth(b, 1))
      else [js_bad(st, "expected ':' in conditional"), nth(a, 1)]
    else if k2 == "p" and js_assign_op(x2) and (min <= 1) then
      let r = js_parse_expr(toks, j + 1, 1, st) in
      loop(["assign", x2, lhs, nth(r, 0)], nth(r, 1))
    else
      /* Infix operators: punctuation, or the keyword operators in / instanceof.
       * Any other token kind ends the climb. */
      let isop = k2 == "p" or (k2 == "id" and (x2 == "in" or x2 == "instanceof")) in
      let p = if isop then js_prec2(x2) else 0 in
      if p == 0 or p < min then [lhs, j]
      else
        let pn = if x2 == "**" then p else p + 1 in
        let r = js_parse_expr(toks, j + 1, pn, st) in
        loop(["bin", x2, lhs, nth(r, 0)], nth(r, 1)) in
  loop(nth(pre, 0), nth(pre, 1))

/* ---- statement parser ------------------------------------------------- */

/* Parse statements. mode is either ["one"] (one statement) or ["list", stop]
 * (until `}` when stop=="}" or EOF). Statements:
 *   ["let", kind, name, init] ["expr", e] ["ret", e|null] ["block", xs]
 *   ["if", c, thenXs, elseXs] ["while", c, bodyXs]
 *   ["for", init, test, update, bodyXs] ["func", name, params, bodyXs]
 * Returns [stmt(s), next-index]. */
/* Parse a binding pattern: id, array `[p, …]`, object `{k: p, …}` (shorthand
 * `{a}` binds a). Returns [node, next-index]. No nested defaults yet. */
let js_pat_parse(toks, i, st) =
  if js_k(js_at(toks, i)) == "id" then [["id", js_t(js_at(toks, i))], i + 1]
  else if js_is(toks, i, "[") then
    let go(j, acc) =
      if js_is(toks, j, "]") then [["arrpat", list_rev(acc)], j + 1]
      else if js_is(toks, j, ",") then go(j + 1, cons(0, acc))
      else
        let r = js_pat_parse(toks, j, st) in
        let j2 = nth(r, 1) in
        if js_is(toks, j2, ",") then go(j2 + 1, cons(nth(r, 0), acc))
        else if js_is(toks, j2, "]") then [["arrpat", list_rev(cons(nth(r, 0), acc))], j2 + 1]
        else [js_bad(st, "expected ',' or ']' in pattern"), j2] in
    go(i + 1, [])
  else if js_is(toks, i, "{") then
    let go(j, acc) =
      if js_is(toks, j, "}") then [["objpat", list_rev(acc)], j + 1]
      else
        let kt = js_at(toks, j) in
        let key = js_t(kt) in
        let j2 = j + 1 in
        if js_is(toks, j2, ":") then
          let r = js_pat_parse(toks, j2 + 1, st) in
          let j3 = nth(r, 1) in
          let a2 = cons([key, nth(r, 0)], acc) in
          if js_is(toks, j3, ",") then go(j3 + 1, a2)
          else if js_is(toks, j3, "}") then [["objpat", list_rev(a2)], j3 + 1]
          else [js_bad(st, "expected ',' or '}' in pattern"), j3]
        else
          let a2 = cons([key, ["id", key]], acc) in
          if js_is(toks, j2, ",") then go(j2 + 1, a2)
          else if js_is(toks, j2, "}") then [["objpat", list_rev(a2)], j2 + 1]
          else [js_bad(st, "expected ',' or '}' in pattern"), j2] in
    go(i + 1, [])
  else [js_bad(st, "expected binding pattern"), i + 1]

/* Flatten a pattern against an access expression into [[name, access], …]. */
let js_pat_flat(pat, ae) =
  if nth(pat, 0) == "id" then [[nth(pat, 1), ae]]
  else if nth(pat, 0) == "arrpat" then
    let xs = nth(pat, 1) in
    let n = len(xs) in
    let go(i, acc) =
      if i >= n then acc
      else
        let e = nth(xs, i) in
        if e == 0 then go(i + 1, acc)
        else
          let ae2 = str_cat("nth(", str_cat(ae, str_cat(", ", str_cat(int_to_str(i), ")")))) in
          go(i + 1, append(acc, js_pat_flat(e, ae2))) in
    go(0, [])
  else
    let ps = nth(pat, 1) in
    let n = len(ps) in
    let go(i, acc) =
      if i >= n then acc
      else
        let pr = nth(ps, i) in
        let ae2 = str_cat("_js_get(", str_cat(ae, str_cat(", \"", str_cat(nth(pr, 0), "\")")))) in
        go(i + 1, append(acc, js_pat_flat(nth(pr, 1), ae2))) in
    go(0, [])

let js_pat_names(flat) =
  let n = len(flat) in
  let go(i, acc) = if i >= n then list_rev(acc) else go(i + 1, cons(nth(nth(flat, i), 0), acc)) in
  go(0, [])

let js_pat_has_obj(pat) =
  if nth(pat, 0) == "objpat" then true
  else if nth(pat, 0) == "arrpat" then
    let xs = nth(pat, 1) in
    let n = len(xs) in
    let go(i) =
      if i >= n then false
      else if nth(xs, i) == 0 then go(i + 1)
      else if js_pat_has_obj(nth(xs, i)) then true
      else go(i + 1) in
    go(0)
  else false

/* Returns [stmt(s), next-index]. */
let js_parse_stmts(toks, i, mode, st) =
  let one(j) =
    let tk = js_at(toks, j) in
    let tx = js_t(tk) in
  let kk = js_k(tk) in
    /* A string/number literal can never start a keyword statement; token text
     * like "if" inside a string must not be read as syntax. */
    if kk == "str" or kk == "num" then
      let r = js_parse_expr(toks, j, 0, st) in
      let j2 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
      [["expr", nth(r, 0)], j2]
    else if tx == "let" or tx == "const" or tx == "var" then
      let nt = js_at(toks, j + 1) in
      if js_is(toks, j + 1, "[") or js_is(toks, j + 1, "{") then
        /* Destructuring declaration. */
        let pr = js_pat_parse(toks, j + 1, st) in
        let j2 = nth(pr, 1) in
        let r = if js_is(toks, j2, "=") then js_parse_expr(toks, j2 + 1, 0, st) else [["undef"], j2] in
        let j3 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
        [["dlet", nth(pr, 0), nth(r, 0)], j3]
      else if js_k(nt) != "id" then [js_bad(st, "expected identifier after declaration"), j + 1]
      else
        let nm = js_t(nt) in
        let j2 = j + 2 in
        let r =
          if js_is(toks, j2, "=") then js_parse_expr(toks, j2 + 1, 0, st)
          else [["null"], j2] in
        let j3 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
        [["let", tx, nm, nth(r, 0)], j3]
    else if tx == "class" then
      /* class Name [extends Base] { constructor(){} m(){} static s(){} } */
      let nm = js_t(js_at(toks, j + 1)) in
      let j0 = j + 2 in
      let superName = if js_is(toks, j0, "extends") then js_t(js_at(toks, j0 + 1)) else "" in
      let j1 = if superName == "" then j0 else j0 + 2 in
      let cdef(jj, acc) =
        if js_is(toks, jj, ")") then [list_rev(acc), jj + 1]
        else
          let pt = js_at(toks, jj) in
          let j3 = jj + 1 in
          if js_is(toks, j3, "=") then
            let r = js_parse_expr(toks, j3 + 1, 0, st) in
            let j4 = nth(r, 1) in
            let a2 = cons([js_t(pt), nth(r, 0)], acc) in
            if js_is(toks, j4, ",") then cdef(j4 + 1, a2) else [list_rev(a2), j4 + 1]
          else if js_is(toks, j3, ",") then cdef(j3 + 1, cons(js_t(pt), acc))
          else [list_rev(cons(js_t(pt), acc)), j3 + 1] in
      let mgo(k, acc) =
        if js_is(toks, k, "}") then [list_rev(acc), k + 1]
        else if js_is(toks, k, ";") then mgo(k + 1, acc)
        else
          let is_static = js_is(toks, k, "static") in
          let k1 = if is_static then k + 1 else k in
          let mname = js_t(js_at(toks, k1)) in
          let pr = cdef(k1 + 2, []) in
          let bd = js_parse_stmts(toks, nth(pr, 1) + 1, ["list", "}"], st) in
          let kind = if is_static then "static" else if mname == "constructor" then "ctor" else "method" in
          mgo(nth(bd, 1), cons([kind, mname, nth(pr, 0), nth(bd, 0)], acc)) in
      let mem = mgo(j1 + 1, []) in
      [["class", nm, nth(mem, 0), superName], nth(mem, 1)]
    else if tx == "if" then
      let c = js_parse_expr(toks, j + 2, 0, st) in
      let j2 = if js_is(toks, nth(c, 1), ")") then nth(c, 1) + 1 else nth(c, 1) in
      let th = js_parse_stmts(toks, j2, ["one"], st) in
      let j3 = nth(th, 1) in
      if js_is(toks, j3, "else") then
        let el = js_parse_stmts(toks, j3 + 1, ["one"], st) in
        [["if", nth(c, 0), [nth(th, 0)], [nth(el, 0)]], nth(el, 1)]
      else [["if", nth(c, 0), [nth(th, 0)], []], j3]
    else if tx == "while" then
      let c = js_parse_expr(toks, j + 2, 0, st) in
      let j2 = if js_is(toks, nth(c, 1), ")") then nth(c, 1) + 1 else nth(c, 1) in
      let b = js_parse_stmts(toks, j2, ["one"], st) in
      [["while", nth(c, 0), [nth(b, 0)]], nth(b, 1)]
    else if tx == "for" then
      /* for ( init ; test ; update ) body — each clause may be empty. */
      let j0 = j + 2 in
      /* for ( [let|var|const] k in obj ) body */
      let forin_target = js_k(js_at(toks, j0)) == "id" and (js_t(js_at(toks, j0)) == "let" or js_t(js_at(toks, j0)) == "var" or js_t(js_at(toks, j0)) == "const") in
      let jn0 = if forin_target then j0 + 1 else j0 in
      if (forin_target or js_k(js_at(toks, j0)) == "id") and js_is(toks, jn0 + 1, "in") then
        let nm = js_t(js_at(toks, jn0)) in
        let it = js_parse_expr(toks, jn0 + 2, 0, st) in
        let j2 = if js_is(toks, nth(it, 1), ")") then nth(it, 1) + 1 else nth(it, 1) in
        let b = js_parse_stmts(toks, j2, ["one"], st) in
        [["forin", nm, nth(it, 0), [nth(b, 0)]], nth(b, 1)]
      else
      let init =
        if js_is(toks, j0, ";") then [["null"], j0 + 1]
        else if js_t(js_at(toks, j0)) == "let" or js_t(js_at(toks, j0)) == "var" or js_t(js_at(toks, j0)) == "const" then
          let nm = js_t(js_at(toks, j0 + 1)) in
          let j2 = j0 + 2 in
          let r = if js_is(toks, j2, "=") then js_parse_expr(toks, j2 + 1, 0, st) else [["null"], j2] in
          let j3 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
          [["let", "let", nm, nth(r, 0)], j3]
        else
          let r = js_parse_expr(toks, j0, 0, st) in
          let j3 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
          [["expr", nth(r, 0)], j3] in
      let j1 = nth(init, 1) in
      let test =
        if js_is(toks, j1, ";") then [["bool", "true"], j1 + 1]
        else
          let r = js_parse_expr(toks, j1, 0, st) in
          let j3 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
          [nth(r, 0), j3] in
      let j2 = nth(test, 1) in
      let upd =
        if js_is(toks, j2, ")") then [["null"], j2 + 1]
        else
          let r = js_parse_expr(toks, j2, 0, st) in
          let j3 = if js_is(toks, nth(r, 1), ")") then nth(r, 1) + 1 else nth(r, 1) in
          [nth(r, 0), j3] in
      let j3 = nth(upd, 1) in
      let b = js_parse_stmts(toks, j3, ["one"], st) in
      [["for", nth(init, 0), nth(test, 0), nth(upd, 0), [nth(b, 0)]], nth(b, 1)]
    else if tx == "return" then
      let r =
        if js_is(toks, j + 1, ";") or js_is(toks, j + 1, "}") or js_k(js_at(toks, j + 1)) == "eof" then [["null"], j + 1]
        else js_parse_expr(toks, j + 1, 0, st) in
      let j2 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
      [["ret", nth(r, 0)], j2]
    else if tx == "function" then
      /* function name(params) { … } — body is the braces' interior. */
      let nm = js_t(js_at(toks, j + 1)) in
      let j2 = j + 3 in
      let pdef(jj, acc) =
        if js_is(toks, jj, ")") then [list_rev(acc), jj + 1]
        else
          let pt = js_at(toks, jj) in
          let j3 = jj + 1 in
          if js_is(toks, j3, "=") then
            let r = js_parse_expr(toks, j3 + 1, 0, st) in
            let j4 = nth(r, 1) in
            let a2 = cons([js_t(pt), nth(r, 0)], acc) in
            if js_is(toks, j4, ",") then pdef(j4 + 1, a2) else [list_rev(a2), j4 + 1]
          else if js_is(toks, j3, ",") then pdef(j3 + 1, cons(js_t(pt), acc))
          else [list_rev(cons(js_t(pt), acc)), j3 + 1] in
      let pr = pdef(j2, []) in
      let body = js_parse_stmts(toks, nth(pr, 1) + 1, ["list", "}"], st) in
      [["func", nm, nth(pr, 0), nth(body, 0)], nth(body, 1)]
    else if tx == "{" then
      let r = js_parse_stmts(toks, j + 1, ["list", "}"], st) in
      [["block", nth(r, 0)], nth(r, 1)]
    else if tx == ";" then [["block", []], j + 1]
    else if tx == "break" or tx == "continue" then
      let j2 = if js_is(toks, j + 1, ";") then j + 2 else j + 1 in
      [(if tx == "break" then ["break"] else ["continue"]), j2]
    else if tx == "do" then
      /* do body while (test); */
      let b = js_parse_stmts(toks, j + 1, ["one"], st) in
      let j2 = if js_is(toks, nth(b, 1), "while") then nth(b, 1) + 2 else nth(b, 1) in
      let c = js_parse_expr(toks, j2, 0, st) in
      let j3 = if js_is(toks, nth(c, 1), ")") then nth(c, 1) + 1 else nth(c, 1) in
      let j4 = if js_is(toks, j3, ";") then j3 + 1 else j3 in
      [["do", [nth(b, 0)], nth(c, 0)], j4]
    else if tx == "switch" then
      /* switch (disc) { case k: ... default: ... } -> ["switch", disc, clauses]
       * clause = [testOrNull(default), [stmts]]. Fallthrough is not emulated:
       * each clause is exclusive. */
      let disc = js_parse_expr(toks, j + 2, 0, st) in
      let j2 = if js_is(toks, nth(disc, 1), ")") then nth(disc, 1) + 1 else nth(disc, 1) in
      let j3 = if js_is(toks, j2, "{") then j2 + 1 else j2 in
      let body(jb, accb) =
        if js_is(toks, jb, "case") or js_is(toks, jb, "default") or js_is(toks, jb, "}") or js_k(js_at(toks, jb)) == "eof" then
          [list_rev(accb), jb]
        else
          let r = js_parse_stmts(toks, jb, ["one"], st) in
          body(nth(r, 1), cons(nth(r, 0), accb)) in
      let clauses(jj, acc) =
        if js_is(toks, jj, "}") then [list_rev(acc), jj + 1]
        else if js_k(js_at(toks, jj)) == "eof" then [list_rev(acc), jj]
        else if js_is(toks, jj, "case") then
          let k = js_parse_expr(toks, jj + 1, 0, st) in
          let jk = if js_is(toks, nth(k, 1), ":") then nth(k, 1) + 1 else nth(k, 1) in
          let bd = body(jk, []) in
          clauses(nth(bd, 1), cons([nth(k, 0), nth(bd, 0)], acc))
        else if js_is(toks, jj, "default") then
          let jd = if js_is(toks, jj + 1, ":") then jj + 2 else jj + 1 in
          let bd = body(jd, []) in
          clauses(nth(bd, 1), cons([["null"], nth(bd, 0)], acc))
        else
          let r = js_parse_stmts(toks, jj, ["one"], st) in
          clauses(nth(r, 1), acc) in
      let cs = clauses(j3, []) in
      [["switch", nth(disc, 0), nth(cs, 0)], nth(cs, 1)]
    else if tx == "throw" then
      let r = js_parse_expr(toks, j + 1, 0, st) in
      let j2 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
      [["throw", nth(r, 0)], j2]
    else if tx == "try" then
      let blk = js_parse_stmts(toks, j + 1, ["one"], st) in
      let tryXs = if nth(nth(blk, 0), 0) == "block" then nth(nth(blk, 0), 1) else [nth(blk, 0)] in
      let j2 = nth(blk, 1) in
      let c =
        if js_is(toks, j2, "catch") then
          let nm = if js_k(js_at(toks, j2 + 2)) == "id" then js_t(js_at(toks, j2 + 2)) else "" in
          let jr = if js_is(toks, j2 + 3, ")") then j2 + 4 else j2 + 3 in
          let cb = js_parse_stmts(toks, jr, ["one"], st) in
          let cs = if nth(nth(cb, 0), 0) == "block" then nth(nth(cb, 0), 1) else [nth(cb, 0)] in
          [(if nm == "" then ["null"] else ["str", nm]), cs, nth(cb, 1)]
        else [["null"], [], j2] in
      let j3 = nth(c, 2) in
      let f =
        if js_is(toks, j3, "finally") then
          let fb = js_parse_stmts(toks, j3 + 1, ["one"], st) in
          let fs = if nth(nth(fb, 0), 0) == "block" then nth(nth(fb, 0), 1) else [nth(fb, 0)] in
          [fs, nth(fb, 1)]
        else [[], j3] in
      [["try", tryXs, nth(c, 0), nth(c, 1), nth(f, 0)], nth(f, 1)]
    else if js_k(tk) == "eof" then [["block", []], j]
    else if js_k(tk) == "unk" then [js_bad(st, str_cat("unexpected character '", str_cat(tx, "'"))), j + 1]
    else
      let r = js_parse_expr(toks, j, 0, st) in
      let j2 = if js_is(toks, nth(r, 1), ";") then nth(r, 1) + 1 else nth(r, 1) in
      [["expr", nth(r, 0)], j2] in
  let m0 = nth(mode, 0) in
  if m0 == "list" then
    let stop = nth(mode, 1) in
    let go(j, acc) =
      let tk = js_at(toks, j) in
      if js_k(tk) == "eof" then [list_rev(acc), j]
      else if stop == "}" and js_t(tk) == "}" then [list_rev(acc), j + 1]
      else
        let r = one(j) in
        go(nth(r, 1), cons(nth(r, 0), acc)) in
    go(i, [])
  else one(i)

/* ---- emit helpers ----------------------------------------------------- */

/* Fresh-name counter: `_<prefix><n>`, unique across the whole program. */
let js_fresh(st, p) =
  let b = st_ns(st) in
  let n = box_get(b) in
  let _ = box_set(b, n + 1) in
  str_cat("_", str_cat(p, int_to_str(n)))

/* Join xs[i..] with sep, seeding the accumulator with xs[0]. */
let js_join(xs, sep, i, acc) =
  if i >= len(xs) then acc
  else if i == 0 then js_join(xs, sep, 1, nth(xs, 0))
  else js_join(xs, sep, i + 1, str_cat(acc, str_cat(sep, nth(xs, i))))

/* Concatenate a list of fragments (avoids deep str_cat nesting). */
let js_cat(xs) = js_join(xs, "", 0, "")

/* Wrap an expression in the JS-truthiness helper and mark jsrt for import. */
let js_truth(x, st) =
  let _ = box_set(st_truth(st), 1) in
  js_cat(["_js_truth(", x, ")"])

/* Escape a string for use inside a generated yac `"…"` literal. */
let js_esc(s) =
  let n = str_len(s) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(s, i) in
      let bit =
        if c == 34 then "\\\""
        else if c == 92 then "\\\\"
        else if c == 10 then "\\n"
        else if c == 9 then "\\t"
        else if c == 13 then "\\r"
        else if c == 0 then "\\0"
        else str_slice(s, i, 1) in
      rec(i + 1, str_cat(acc, bit)) in
  rec(0, "")

/* JS name -> yac name: `v_` prefix (avoids kernel/keyword clashes), `$` ->
 * `_ds_`. Deterministic, so every reference to a name agrees. */
let js_mangle(s) =
  let n = str_len(s) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(s, i) in
      let bit = if c == 36 then "_ds_" else str_slice(s, i, 1) in
      rec(i + 1, str_cat(acc, bit)) in
  str_cat("v_", rec(0, ""))

/* Membership in a name list (scopes are small). */
let js_in(xs, x) =
  let rec(i) =
    if i >= len(xs) then false
    else if nth(xs, i) == x then true
    else rec(i + 1) in
  rec(0)

let js_str_lit(e) = nth(e, 0) == "str"

/* True when a node is statically boolean-valued: a `true`/`false` literal, a
 * comparison / equality / `&&` / `||`, or `!`. yac prints such a value as
 * 1/0, so console.log and string concatenation route it through _js_bool to
 * get JS's "true"/"false". */
let js_is_boolish(e) =
  let t = nth(e, 0) in
  if t == "bool" then true
  else if t == "un" then nth(e, 1) == "!"
  else if t == "bin" then
    let op = nth(e, 1) in
    if op == "&&" or op == "||" then
      /* JS returns an operand, so the result is boolean only if both are. */
      js_is_boolish(nth(e, 2)) and js_is_boolish(nth(e, 3))
    else
      op == "==" or op == "!=" or op == "==="
        or op == "!==" or op == "<" or op == "<=" or op == ">" or op == ">="
        or op == "in" or op == "instanceof"
  else if t == "call" then
    let c = nth(e, 1) in
    if nth(c, 0) == "mem" then
      let m = nth(c, 2) in
      m == "startsWith" or m == "endsWith" or m == "includes" or m == "isArray"
    else if nth(c, 0) == "id" then
      let f = nth(c, 1) in
      f == "isNaN" or f == "isFinite"
    else false
  else false

/* True when a node is statically known to be a string: a string literal, a
 * `+` with a string operand, a String(...) call, or an id in `strs` (the
 * names currently known to hold strings). Lets `s + x` / `s += x` on a string
 * variable concatenate instead of adding. */
let js_is_str_expr(e, strs) =
  let t = nth(e, 0) in
  if t == "str" then true
  else if t == "tmpl" then true
  else if t == "id" then js_in(strs, nth(e, 1))
  else if t == "bin" then
    if nth(e, 1) == "+" then
      js_is_str_expr(nth(e, 2), strs) or js_is_str_expr(nth(e, 3), strs)
    else false
  else if t == "call" then
    let callee = nth(e, 1) in
    if nth(callee, 0) == "id" then nth(callee, 1) == "String"
    else false
  else false

/* Object key node (id/str/num) -> raw key text. */
let js_lit_quote(e) =
  if nth(e, 0) == "str" then nth(e, 1)
  else if nth(e, 0) == "id" then nth(e, 1)
  else if nth(e, 0) == "num" then nth(e, 1)
  else ""

/* ---- expression emitter ---------------------------------------------- */

/* js_emit_stmts is defined after js_emit_expr (function bodies need it), so it
 * is reached through a box that js_to_yac fills in. */
let js_stmts_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let js_call_stmts(stmts, ctx, k, st) = (box_get(js_stmts_box))(stmts, ctx, k, st)

/* js_emit_expr is defined after js_func_body (needed there for param default
 * expressions), so it too is reached through a box filled by js_to_yac. */
let js_expr_box =
  let b = box_new() in
  let _ = box_set(b, 0) in
  b

let js_call_expr(e, ctx, st) = (box_get(js_expr_box))(e, ctx, st)

/* Param node: a plain name (string, kind 3) or [name, defaultExpr]. */
let js_pname(p) = if kind(p) == 3 then p else nth(p, 0)

let js_pnames(ps) =
  let n = len(ps) in
  let go(i, acc) = if i >= n then list_rev(acc) else go(i + 1, cons(js_pname(nth(ps, i)), acc)) in
  go(0, [])

/* Bind each param to a fresh box, create fresh return flag/value boxes (flag
 * initialised to false), then the body. Returns [param-signature, body-expr].
 * Shared by function declarations and function expressions; a function has no
 * enclosing loop, so its loop-status box is 0. */
let js_func_body(ps, body, ctx, st) =
  let retf2 = js_fresh(st, "retf") in
  let retv2 = js_fresh(st, "retv") in
  let ctx3 = [append(nth(ctx, 0), js_pnames(ps)), nth(ctx, 1), retf2, retv2, nth(ctx, 4), 0] in
  let b0 = js_call_stmts(body, ctx3, "0", st) in
  let b1 = js_cat(["(let ", retv2, " = box_new() in ", b0, ")"]) in
  let b2 = js_cat(["(let ", retf2, " = box_new() in (let _ = box_set(", retf2, ", false) in ", b1, "))"]) in
  let pnames =
    let n = len(ps) in
    if n == 0 then ["_"]
    else
      let pn(i, acc) = if i >= n then list_rev(acc) else pn(i + 1, cons(str_cat("_p", int_to_str(i)), acc)) in
      pn(0, []) in
  let wrap(i, inner) =
    if i < 0 then inner
    else
      let p = nth(ps, i) in
      let m = js_mangle(js_pname(p)) in
      let pv = nth(pnames, i) in
      let binder =
        if kind(p) == 3 then pv
        else
          let dv = js_call_expr(nth(p, 1), ctx3, st) in
          let tmp = str_cat("_def", int_to_str(i)) in
          js_cat(["(let ", tmp, " = ", pv, " in if ", tmp, " == 0 then ", dv, " else ", tmp, ")"]) in
      wrap(i - 1, js_cat(["(let ", m, " = box_new() in (let _ = box_set(", m, ", ", binder, ") in ", inner, "))"])) in
  [js_join(pnames, ", ", 0, ""), wrap(len(ps) - 1, b2)]

/* ---- expression emitter ---------------------------------------------- */

/* ctx = [vars, funcs, retf, retv]: boxed variable names, declared function
 * names, and the enclosing function's return flag/value boxes (0 at top
 * level). Emits a yac expression string. Self-recursive. */
let js_emit_expr(e, ctx, st) =
  let vars = nth(ctx, 0) in
  let funcs = nth(ctx, 1) in
  let tag = nth(e, 0) in
  /* Stringify a value for console.log / `+` / String(): boolean-valued nodes
   * go through _js_bool so they read "true"/"false"; anything else through
   * _js_str (int -> decimal, string -> itself). */
  let str_of(x) =
    if nth(x, 0) == "null" then "\"null\""
    else if nth(x, 0) == "undef" then "\"undefined\""
    else if nth(x, 0) == "un" and nth(x, 1) == "void" then "\"undefined\""
    else if js_is_boolish(x) then
      let _ = box_set(st_bool(st), 1) in
      js_cat(["_js_bool(", js_emit_expr(x, ctx, st), ")"])
    else
      let _ = box_set(st_str(st), 1) in
      js_cat(["_js_str(", js_emit_expr(x, ctx, st), ")"])
  in
  /* Read / store an assignment target (`x`, `o.k`, `a[i]`); store returns the
   * stored value. Shared by `=`, `+=`, and `x++` / `++x`. */
  let rd_tgt(tgt) =
    let t = nth(tgt, 0) in
    if t == "id" then js_cat(["box_get(", js_mangle(nth(tgt, 1)), ")"])
    else if t == "mem" then
      let _ = box_set(st_fmap(st), 1) in
      js_cat(["fmap_get(nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", 1), \"", js_esc(nth(tgt, 2)), "\")"])
    else if t == "idx" then js_cat(["nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", ", js_emit_expr(nth(tgt, 2), ctx, st), ")"])
    else "0"
  in
  let st_tgt(tgt, vs) =
    let t = nth(tgt, 0) in
    if t == "id" then js_cat(["(let _ = box_set(", js_mangle(nth(tgt, 1)), ", ", vs, ") in ", vs, ")"])
    else if t == "mem" then
      let _ = box_set(st_fmap(st), 1) in
      js_cat(["(let _ = fmap_put(nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", 1), \"", js_esc(nth(tgt, 2)), "\", ", vs, ") in ", vs, ")"])
    else if t == "idx" then
      js_cat(["(let _ = list_set(", js_emit_expr(nth(tgt, 1), ctx, st), ", ", js_emit_expr(nth(tgt, 2), ctx, st), ", ", vs, ") in ", vs, ")"])
    else vs
  in
  /* Comma-joined emitted args, or the dummy 0 for a zero-arg call. */
  let emit_args(args) =
    let go(i) =
      if i >= len(args) then ""
      else if i == len(args) - 1 then js_emit_expr(nth(args, i), ctx, st)
      else js_cat([js_emit_expr(nth(args, i), ctx, st), ", ", go(i + 1)]) in
    if len(args) == 0 then "0" else go(0)
  in
  /* A callee object name in UpperCamelCase is a JS built-in object (JSON,
   * Date, String, Number, RegExp, …). Method calls on it are dispatched
   * through lang.jslib's `js_native`, so adding an object/method library needs
   * no change here -- only a branch in js_native. `Math` and `Object` keep
   * their inline fast paths. */
  let builtin_name(obj) =
    let nm = if nth(obj, 0) == "id" then nth(obj, 1) else "" in
    if nm == "" then ""
    else
      let c = str_ref(nm, 0) in
      if c >= 65 and c <= 90 then nm else ""
  in
  /* `[a, b, …]` for js_native's argument list. */
  let args_arr(args) =
    let go(i) =
      if i >= len(args) then ""
      else if i == len(args) - 1 then js_emit_expr(nth(args, i), ctx, st)
      else js_cat([js_emit_expr(nth(args, i), ctx, st), ", ", go(i + 1)]) in
    if len(args) == 0 then "[]" else js_cat(["[", go(0), "]"])
  in
  /* Method dispatch for `obj.m(args)`. String vs array is decided statically
   * (string literal or a name known to hold a string); else assume array.
   * Array/string library calls: helpers via _js_* (st_lib) and text.str
   * (st_strpkg). */
  let mcall(callee, args) =
    let obj = nth(callee, 1) in
    let m = nth(callee, 2) in
    let o = js_emit_expr(obj, ctx, st) in
    let a0 = if len(args) > 0 then js_emit_expr(nth(args, 0), ctx, st) else "0" in
    let a1 = if len(args) > 1 then js_emit_expr(nth(args, 1), ctx, st) else "0" in
    let is_str =
      if js_str_lit(obj) then true
      else if nth(obj, 0) == "id" then js_in(nth(ctx, 4), nth(obj, 1))
      else false in
    let failm(m2) =
      let _ = js_fail(st, js_cat(["unsupported method '", js_cat(m2, "'")])) in
      "0" in
    /* Unknown (user) method: look it up on the prototype chain, bind `this`,
     * call, then restore `this`. */
    let dyn_call(_) =
      let _ = box_set(st_obj(st), 1) in
      let _ = box_set(st_fmap(st), 1) in
      js_cat(["(let _o = ", o, " in (let _f = _js_get(_o, \"", js_esc(m), "\") in (let _s = box_get(_js_this) in (let _ = box_set(_js_this, _o) in (let _r = (_f)(", emit_args(args), ") in (let _ = box_set(_js_this, _s) in _r))))))"]) in
    if is_str then
      if m == "charAt" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_char_at(", o, ", ", a0, ")"]))
      else if m == "charCodeAt" then js_cat(["str_ref(", o, ", ", a0, ")"])
      else if m == "slice" or m == "substring" then
        (if len(args) == 0 then o
         else if len(args) == 1 then js_cat(["str_slice(", o, ", ", a0, ", str_len(", o, ") - ", a0, ")"])
         else js_cat(["str_slice(", o, ", ", a0, ", ", a1, " - ", a0, ")"]))
      else if m == "substr" then
        (if len(args) == 0 then o
         else if len(args) == 1 then js_cat(["str_slice(", o, ", ", a0, ", str_len(", o, ") - ", a0, ")"])
         else js_cat(["str_slice(", o, ", ", a0, ", ", a1, ")"]))
      else if m == "toUpperCase" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_upper(", o, ")"]))
      else if m == "toLowerCase" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_lower(", o, ")"]))
      else if m == "trim" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["trim(", o, ")"]))
      else if m == "split" then
        (let _ = box_set(st_strpkg(st), 1) in
         if len(args) == 0 then js_cat(["[", o, "]"]) else js_cat(["split(", o, ", ", a0, ")"]))
      else if m == "startsWith" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["starts_with(", o, ", ", a0, ")"]))
      else if m == "endsWith" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["ends_with(", o, ", ", a0, ")"]))
      else if m == "includes" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["contains(", o, ", ", a0, ")"]))
      else if m == "indexOf" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["find(", o, ", ", a0, ")"]))
      else if m == "concat" then js_cat(["str_cat(", o, ", ", a0, ")"])
      else if m == "repeat" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_repeat(", o, ", ", a0, ")"]))
      else if m == "replace" then
        (let _ = box_set(st_lib(st), 1) in
         let _ = box_set(st_strpkg(st), 1) in
         js_cat(["_js_str_replace(", o, ", ", a0, ", ", a1, ")"]))
      else if m == "search" then (let _ = box_set(st_strpkg(st), 1) in js_cat(["find(", o, ", ", a0, ")"]))
      else if m == "toString" or m == "valueOf" then o
      else dyn_call(0)
    else
      let is_obj =
        if nth(obj, 0) == "id" then nth(obj, 1) == "Object" else false in
      let bn = builtin_name(obj) in
      let is_builtin =
        if bn == "" then false
        else if bn == "Object" then false
        else if bn == "Math" then false
        else true in
      if is_builtin then
        (let _ = box_set(st_jslib(st), 1) in
         js_cat(["js_native(\"", bn, "\", \"", js_esc(m), "\", ", args_arr(args), ")"]))
      else if is_obj then
        (let _ = box_set(st_obj(st), 1) in
         let _ = box_set(st_fmap(st), 1) in
         if m == "keys" then js_cat(["_js_keys(", a0, ")"])
         else if m == "create" then js_cat(["_js_obj(", a0, ")"])
         else failm(m))
      else if m == "join" then
        (let _ = box_set(st_lib(st), 1) in
         if len(args) == 0 then js_cat(["_js_arr_join(", o, ", \",\")"]) else js_cat(["_js_arr_join(", o, ", ", a0, ")"]))
      else if m == "concat" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_arr_concat(", o, ", ", a0, ")"]))
      else if m == "reverse" then js_cat(["list_rev(", o, ")"])
      else if m == "slice" then
        (let _ = box_set(st_lib(st), 1) in
         if len(args) < 2 then js_cat(["_js_arr_slice(", o, ", ", a0, ", len(", o, "))"])
         else js_cat(["_js_arr_slice(", o, ", ", a0, ", ", a1, ")"]))
      else if m == "indexOf" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_arr_index(", o, ", ", a0, ")"]))
      else if m == "map" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_arr_map(", o, ", ", a0, ")"]))
      else if m == "forEach" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_arr_each(", o, ", ", a0, ")"]))
      else if m == "filter" then (let _ = box_set(st_lib(st), 1) in js_cat(["_js_arr_filter(", o, ", ", a0, ")"]))
      else if m == "reduce" then
        (let _ = box_set(st_lib(st), 1) in
         if len(args) >= 2 then js_cat(["_js_arr_reduce(", o, ", ", a0, ", ", a1, ")"])
         else js_cat(["_js_arr_reduce(", o, ", ", a0, ", 0)"]))
      else if m == "sort" then
        (let _ = box_set(st_lib(st), 1) in
         if len(args) == 0 then js_cat(["_js_arr_sort(", o, ", fun(_a, _b) -> _a - _b)"])
         else js_cat(["_js_arr_sort(", o, ", ", a0, ")"]))
      else if m == "push" then js_cat(["list_push(", o, ", ", a0, ")"])
      else dyn_call(0)
  in
  if tag == "num" then nth(e, 1)
  else if tag == "str" then str_cat("\"", str_cat(js_esc(nth(e, 1)), "\""))
  else if tag == "bool" then nth(e, 1)
  else if tag == "null" then "0"
  else if tag == "undef" then "0"
  else if tag == "err" then "0"
  else if tag == "id" then
    /* Function -> direct name; boxed var -> box_get; else assume global fn. */
    let nm = nth(e, 1) in
    if nm == "console" or nm == "Math" then "0"
    else if js_in(funcs, nm) then js_mangle(nm)
    else if js_in(vars, nm) then js_cat(["box_get(", js_mangle(nm), ")"])
    else js_mangle(nm)
  else if tag == "arr" then
    /* Array literal: a fresh listbuf plus one list_push per element. */
    let a = js_fresh(st, "arr") in
    let go(ys, acc) =
      if len(ys) == 0 then js_cat(["(let ", a, " = list_new() in ", acc, a, ")"])
      else go(tail(ys), js_cat([acc, "let _ = list_push(", a, ", ", js_emit_expr(nth(ys, 0), ctx, st), ") in "])) in
    go(nth(e, 1), "")
  else if tag == "obj" then
    /* Object literal: a tagged object (["$o", fmap]), one fmap_put per pair. */
    let o = js_fresh(st, "obj") in
    let _ = box_set(st_fmap(st), 1) in
    let _ = box_set(st_obj(st), 1) in
    let go(ys, acc) =
      if len(ys) == 0 then js_cat(["(let ", o, " = _js_obj(0) in ", acc, o, ")"])
      else
        let pair = nth(ys, 0) in
        let kn = nth(pair, 0) in
        let ke =
          if nth(kn, 0) == "str" then js_cat(["\"", js_esc(js_lit_quote(kn)), "\""])
          else js_emit_expr(kn, ctx, st) in
        let vs = js_emit_expr(nth(pair, 1), ctx, st) in
        go(tail(ys), js_cat([acc, "let _ = fmap_put(nth(", o, ", 1), ", ke, ", ", vs, ") in "])) in
    go(nth(e, 1), "")
  else if tag == "tmpl" then
    /* Template literal: str_cat of literal segments and stringified exprs. */
    let parts = nth(e, 1) in
    let seg(p) =
      if nth(p, 0) == "str" then js_cat(["\"", js_esc(nth(p, 1)), "\""])
      else str_of(p) in
    let go(i) =
      if i >= len(parts) then ""
      else if i == len(parts) - 1 then seg(nth(parts, i))
      else js_cat(["str_cat(", seg(nth(parts, i)), ", ", go(i + 1), ")"]) in
    if len(parts) == 0 then "\"\"" else go(0)
  else if tag == "un" then
    let op = nth(e, 1) in
    let a = js_emit_expr(nth(e, 2), ctx, st) in
    if op == "!" then js_cat(["(not ", js_truth(a, st), ")"])
    else if op == "-" then js_cat(["(0 - ", a, ")"])
    else if op == "~" then js_cat(["bxor(", a, ", 0 - 1)"])
    else if op == "void" then js_cat(["(let _ = ", a, " in 0)"])
    else a
  else if tag == "typeof" then
    /* Infer where static; otherwise the _js_typeof helper (int vs object). */
    let t = nth(e, 1) in
    if nth(t, 0) == "num" then "\"number\""
    else if nth(t, 0) == "str" then "\"string\""
    else if nth(t, 0) == "bool" or js_is_boolish(t) then "\"boolean\""
    else if nth(t, 0) == "null" then "\"object\""
    else if nth(t, 0) == "undef" then "\"undefined\""
    else if nth(t, 0) == "arr" or nth(t, 0) == "obj" then "\"object\""
    else if nth(t, 0) == "id" then
      if js_in(funcs, nth(t, 1)) then "\"function\""
      else if js_in(nth(ctx, 4), nth(t, 1)) then "\"string\""
      else
        let _ = box_set(st_typeof(st), 1) in
        js_cat(["_js_typeof(", js_emit_expr(t, ctx, st), ")"])
    else
      let _ = box_set(st_typeof(st), 1) in
      js_cat(["_js_typeof(", js_emit_expr(t, ctx, st), ")"])
  else if tag == "del" then
    let _ = js_fail(st, "unsupported 'delete'") in
    "0"
  else if tag == "funexpr" then
    let fb = js_func_body(nth(e, 2), nth(e, 3), ctx, st) in
    js_cat(["fun (", nth(fb, 0), ") -> ", nth(fb, 1)])
  else if tag == "this" then
    let _ = box_set(st_obj(st), 1) in
    "box_get(_js_this)"
  else if tag == "new" then
    let inner = nth(e, 1) in
    let is_call = nth(inner, 0) == "call" in
    let c = if is_call then nth(inner, 1) else inner in
    let args = if is_call then nth(inner, 2) else [] in
    let cname = if nth(c, 0) == "id" then nth(c, 1) else "" in
    let _ = box_set(st_obj(st), 1) in
    let _ = box_set(st_fmap(st), 1) in
    js_cat(["(let _o = _js_obj(_js_proto(\"", js_esc(cname), "\")) in (let _s = box_get(_js_this) in (let _ = box_set(_js_this, _o) in (let _ = (", js_emit_expr(c, ctx, st), ")(", emit_args(args), ") in (let _ = box_set(_js_this, _s) in _o)))))"])
  else if tag == "postfix" then
    /* x++ / x--: value is the OLD value; store old ± 1. */
    let tgt = nth(e, 1) in
    let op0 = if nth(e, 2) == "++" then "+" else "-" in
    js_cat(["(let _old = ", rd_tgt(tgt), " in (let _ = ", st_tgt(tgt, js_cat(["(_old ", op0, " 1)"])), " in _old))"])
  else if tag == "prefix" then
    /* ++x / --x: value is the NEW value. */
    let tgt = nth(e, 2) in
    let op0 = if nth(e, 1) == "++" then "+" else "-" in
    js_cat(["(let _v = (", rd_tgt(tgt), " ", op0, " 1) in (let _ = ", st_tgt(tgt, "_v"), " in _v))"])
  else if tag == "bin" then
    /* `+` with a string operand concatenates; everything else is the same
     * operator in yac (===/!== collapse to ==/!=). */
    let op = nth(e, 1) in
    let l = nth(e, 2) in
    let r = nth(e, 3) in
    if op == "+" and (js_str_lit(l) or js_str_lit(r) or js_is_str_expr(l, nth(ctx, 4)) or js_is_str_expr(r, nth(ctx, 4))) then
      let _ = box_set(st_str(st), 1) in
      let ls = if js_str_lit(l) then js_emit_expr(l, ctx, st) else str_of(l) in
      let rs = if js_str_lit(r) then js_emit_expr(r, ctx, st) else str_of(r) in
      js_cat(["str_cat(", ls, ", ", rs, ")"])
    else
      let ls = js_emit_expr(l, ctx, st) in
      let rs = js_emit_expr(r, ctx, st) in
      if op == "&&" then
        /* Short-circuit: evaluate the LHS once, yield RHS iff LHS is truthy. */
        let t = js_fresh(st, "and") in
        js_cat(["(let ", t, " = ", ls, " in if ", js_truth(t, st), " then ", rs, " else ", t, ")"])
      else if op == "||" then
        let t = js_fresh(st, "or") in
        js_cat(["(let ", t, " = ", ls, " in if ", js_truth(t, st), " then ", t, " else ", rs, ")"])
      else if op == "===" then js_cat(["(", ls, " == ", rs, ")"])
      else if op == "!==" then js_cat(["(", ls, " != ", rs, ")"])
      else if op == "**" then (let _ = box_set(st_math(st), 1) in js_cat(["powf(", ls, ", ", rs, ")"]))
      else if op == "&" then js_cat(["band(", ls, ", ", rs, ")"])
      else if op == "|" then js_cat(["bor(", ls, ", ", rs, ")"])
      else if op == "^" then js_cat(["bxor(", ls, ", ", rs, ")"])
      else if op == "<<" then js_cat(["bshl(", ls, ", ", rs, ")"])
      else if op == ">>" then js_cat(["bshr(", ls, ", ", rs, ")"])
      else if op == ">>>" then js_cat(["bshr(", ls, ", ", rs, ")"])
      else if op == "in" then
        let _ = box_set(st_obj(st), 1) in
        js_cat(["_js_get(", rs, ", ", ls, ") != 0"])
      else if op == "instanceof" then "0"
      else js_cat(["(", ls, " ", op, " ", rs, ")"])
  else if tag == "cond" then
    let c = js_emit_expr(nth(e, 1), ctx, st) in
    js_cat(["(if ", js_truth(c, st), " then ", js_emit_expr(nth(e, 2), ctx, st), " else ", js_emit_expr(nth(e, 3), ctx, st), ")"])
  else if tag == "idx" then
    /* A string-typed index (literal or a string variable / for-in key) is an
     * object lookup along the prototype chain; otherwise it is a list slot. */
    let ix = nth(e, 2) in
    let is_str_ix =
      if js_str_lit(ix) then true
      else if nth(ix, 0) == "id" then js_in(nth(ctx, 4), nth(ix, 1))
      else false in
    if is_str_ix then
      let _ = box_set(st_obj(st), 1) in
      let _ = box_set(st_fmap(st), 1) in
      js_cat(["_js_get(", js_emit_expr(nth(e, 1), ctx, st), ", ", js_emit_expr(ix, ctx, st), ")"])
    else js_cat(["nth(", js_emit_expr(nth(e, 1), ctx, st), ", ", js_emit_expr(nth(e, 2), ctx, st), ")"])
  else if tag == "mem" then
    /* `.length` -> str_len (string literal) or len; other members are fmap
     * lookups. */
    let obj = nth(e, 1) in
    let nm = nth(e, 2) in
    if nm == "length" then
      let isstr =
        if js_str_lit(obj) then true
        else if nth(obj, 0) == "id" then js_in(nth(ctx, 4), nth(obj, 1))
        else false in
      if isstr then js_cat(["str_len(", js_emit_expr(obj, ctx, st), ")"])
      else js_cat(["len(", js_emit_expr(obj, ctx, st), ")"])
    else if nm == "prototype" then
      let isfn = if nth(obj, 0) == "id" then js_in(nth(ctx, 1), nth(obj, 1)) else false in
      if isfn then
        let _ = box_set(st_obj(st), 1) in
        let _ = box_set(st_fmap(st), 1) in
        js_cat(["_js_proto(\"", js_esc(nth(obj, 1)), "\")"])
      else
        let _ = box_set(st_obj(st), 1) in
        let _ = box_set(st_fmap(st), 1) in
        js_cat(["_js_get(", js_emit_expr(obj, ctx, st), ", \"", js_esc(nm), "\")"])
    else
      let is_math = if nth(obj, 0) == "id" then nth(obj, 1) == "Math" else false in
      if is_math and (nm == "PI" or nm == "E") then
        let _ = box_set(st_math(st), 1) in
        (if nm == "PI" then "pi" else "e")
      else
        let _ = box_set(st_obj(st), 1) in
        let _ = box_set(st_fmap(st), 1) in
        js_cat(["_js_get(", js_emit_expr(obj, ctx, st), ", \"", js_esc(nm), "\")"])
  else if tag == "assign" then
    /* Target is a box (id), fmap slot (mem) or list slot (idx). Compound ops
     * read the target, apply the base operator, then store. */
    let op = nth(e, 1) in
    let tgt = nth(e, 2) in
    let val = nth(e, 3) in
    let v = js_emit_expr(val, ctx, st) in
    let t = nth(tgt, 0) in
    let base =
      if t == "id" then js_cat(["box_get(", js_mangle(nth(tgt, 1)), ")"])
      else if t == "mem" then
        let _ = box_set(st_fmap(st), 1) in
        js_cat(["fmap_get(nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", 1), \"", js_esc(nth(tgt, 2)), "\")"])
      else if t == "idx" then js_cat(["nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", ", js_emit_expr(nth(tgt, 2), ctx, st), ")"])
      else "0" in
    let rhs =
      if op == "=" then v
      else if op == "**=" then (let _ = box_set(st_math(st), 1) in js_cat(["powf(", base, ", ", v, ")"]))
      else
        let bitop =
          if op == "&=" then "band"
          else if op == "|=" then "bor"
          else if op == "^=" then "bxor"
          else if op == "<<=" then "bshl"
          else if op == ">>=" then "bshr"
          else if op == ">>>=" then "bshr"
          else "" in
        if bitop != "" then js_cat([bitop, "(", base, ", ", v, ")"])
        else
          let op0 =
            if op == "+=" then "+"
            else if op == "-=" then "-"
            else if op == "*=" then "*"
            else if op == "/=" then "/"
            else "%" in
          if op0 == "+" and (js_str_lit(val) or js_is_boolish(val) or js_is_str_expr(val, nth(ctx, 4)) or (t == "id" and js_in(nth(ctx, 4), nth(tgt, 1)))) then
            js_cat(["str_cat(", base, ", ", str_of(val), ")"])
          else js_cat(["(", base, " ", op0, " ", v, ")"]) in
    if t == "id" then
      js_cat(["(let _v = ", rhs, " in (let _ = box_set(", js_mangle(nth(tgt, 1)), ", _v) in _v))"])
    else if t == "mem" then
      let _ = box_set(st_fmap(st), 1) in
      js_cat(["(let _v = ", rhs, " in (let _ = fmap_put(nth(", js_emit_expr(nth(tgt, 1), ctx, st), ", 1), \"", js_esc(nth(tgt, 2)), "\", _v) in _v))"])
    else if t == "idx" then
      js_cat(["(let _v = ", rhs, " in (let _ = list_set(", js_emit_expr(nth(tgt, 1), ctx, st), ", ", js_emit_expr(nth(tgt, 2), ctx, st), ", _v) in _v))"])
    else js_cat(["(let _v = ", rhs, " in _v)"])
  else if tag == "call" then
    /* Builtins: console.log, Math.*, arr.push, String/Number/parseInt. Any
     * other callee becomes an (indirect) yac call. */
    let callee = nth(e, 1) in
    let args = nth(e, 2) in
    let ctag = nth(callee, 0) in
    let cobj = if ctag == "mem" then nth(callee, 1) else ["err", ""] in
    let cnm = if ctag == "mem" then nth(callee, 2) else "" in
    let is_console = ctag == "mem" and cnm == "log" and nth(cobj, 0) == "id" and nth(cobj, 1) == "console" in
    let is_math = ctag == "mem" and nth(cobj, 0) == "id" and nth(cobj, 1) == "Math" in
    if is_console then
      if len(args) == 0 then "print(\"\")"
      else if len(args) == 1 then js_cat(["print(", str_of(nth(args, 0)), ")"])
      else
        /* Multi-arg: space-joined via the _js_str / _js_bool helpers. */
        let go(i) =
          if i == len(args) - 1 then str_of(nth(args, i))
          else js_cat(["str_cat(", str_of(nth(args, i)), ", str_cat(\" \", ", go(i + 1), "))"]) in
        js_cat(["print(", go(0), ")"])
    else if is_math then
      let _ = box_set(st_math(st), 1) in
      if cnm == "floor" or cnm == "ceil" or cnm == "round" or cnm == "trunc" then
        if len(args) == 0 then "0" else js_emit_expr(nth(args, 0), ctx, st)
      else if cnm == "random" then "0"
      else
        let go(i) =
          if i >= len(args) then ""
          else if i == len(args) - 1 then js_emit_expr(nth(args, i), ctx, st)
          else js_cat([js_emit_expr(nth(args, i), ctx, st), ", ", go(i + 1)]) in
        let as = if len(args) == 0 then "0" else go(0) in
        js_cat([cnm, "(", as, ")"])
    else if ctag == "mem" then mcall(callee, args)
    else if ctag == "id" and nth(callee, 1) == "String" then
      if len(args) == 0 then "\"\"" else str_of(nth(args, 0))
    else if ctag == "id" and nth(callee, 1) == "Number" then
      if len(args) == 0 then "0" else js_emit_expr(nth(args, 0), ctx, st)
    else if ctag == "id" and (nth(callee, 1) == "parseInt" or nth(callee, 1) == "parseFloat") then
      (let _ = box_set(st_jslib(st), 1) in
       let f = if nth(callee, 1) == "parseInt" then "js_parse_int" else "js_parse_float" in
       if len(args) == 0 then "0" else js_cat([f, "(", js_emit_expr(nth(args, 0), ctx, st), ")"]))
    else if ctag == "id" and (nth(callee, 1) == "isNaN" or nth(callee, 1) == "isFinite") then
      (let _ = box_set(st_jslib(st), 1) in
       let f = if nth(callee, 1) == "isNaN" then "js_is_nan" else "js_is_finite" in
       if len(args) == 0 then "false" else js_cat([f, "(", js_emit_expr(nth(args, 0), ctx, st), ")"]))
    else
      /* Indirect call: `(callee)(args)`; a 0-arg call passes the dummy 0. */
      let cf = js_emit_expr(callee, ctx, st) in
      let go(i) =
        if i >= len(args) then ""
        else if i == len(args) - 1 then js_emit_expr(nth(args, i), ctx, st)
        else js_cat([js_emit_expr(nth(args, i), ctx, st), ", ", go(i + 1)]) in
      let as = if len(args) == 0 then "0" else go(0) in
      js_cat(["(", cf, ")(", as, ")"])
  else
    let _ = js_fail(st, js_cat(["unsupported expression '", tag, "'"])) in
    "0"

/* ---- statement emitter ------------------------------------------------ */

/* Compile a statement list to a yac expression whose value is that of the
 * last statement (or the supplied continuation k). ctx as in js_emit_expr.
 * - `let` adds a box and extends the scope for the rest of the list.
 * - `if` / `while` / `for` bodies reuse js_emit_stmts.
 * - `for` lowers to a self-recursive loop; when a `return` fires, the
 *   per-function flag short-circuits the loop through the guard.
 * Self-recursive; function bodies recurse through a fresh js_emit_stmts. */
let js_emit_stmts(stmts, ctx, k, st) =
  let retf = nth(ctx, 2) in
  let retv = nth(ctx, 3) in
  let brk = nth(ctx, 5) in
  /* ctx with a different innermost loop-status box (index 5). */
  let with_brk(c, b) = [nth(c, 0), nth(c, 1), nth(c, 2), nth(c, 3), nth(c, 4), b] in
  /* After a loop body: a fired return wins, a break (status 1) stops, anything
   * else (normal / continue=2) runs `nxt` (next iteration, update included). */
  let after_loop(sc, nxt) =
    let stop = js_cat(["(if box_get(_js_exc) != 0 then 0 else (if box_get(", sc, ") == 1 then 0 else ", nxt, "))"]) in
    if retf == 0 then stop
    else js_cat(["(if box_get(", retf, ") then box_get(", retv, ") else ", stop, ")"]) in
  /* One statement, with its own continuation k2 (only loops use k2). */
  let sstmt(s, ctx2, k2) =
    let tag = nth(s, 0) in
    if tag == "expr" then js_emit_expr(nth(s, 1), ctx2, st)
    else if tag == "block" then js_emit_stmts(nth(s, 1), ctx2, "0", st)
    else if tag == "if" then
      let c = js_emit_expr(nth(s, 1), ctx2, st) in
      js_cat(["(if ", js_truth(c, st), " then ", js_emit_stmts(nth(s, 2), ctx2, "0", st), " else ", js_emit_stmts(nth(s, 3), ctx2, "0", st), ")"])
    else if tag == "while" then
      let w = js_fresh(st, "w") in
      let sc = js_fresh(st, "sc") in
      let c3 = with_brk(ctx2, sc) in
      let body = js_emit_stmts(nth(s, 2), c3, "0", st) in
      let c = js_emit_expr(nth(s, 1), c3, st) in
      let loopbody = js_cat(["(if ", js_truth(c, st), " then (let _ = box_set(", sc, ", 0) in (let _ = ", body, " in ", after_loop(sc, js_cat([w, "(0)"])), ")) else 0)"]) in
      js_cat(["(let ", sc, " = box_new() in (let ", w, "(_) = ", loopbody, " in ", w, "(0)))"])
    else if tag == "do" then
      let w = js_fresh(st, "w") in
      let sc = js_fresh(st, "sc") in
      let c3 = with_brk(ctx2, sc) in
      let body = js_emit_stmts(nth(s, 1), c3, "0", st) in
      let c = js_emit_expr(nth(s, 2), c3, st) in
      let nxt = js_cat(["(if ", js_truth(c, st), " then ", w, "(0) else 0)"]) in
      let loopbody = js_cat(["(let _ = box_set(", sc, ", 0) in (let _ = ", body, " in ", after_loop(sc, nxt), "))"]) in
      js_cat(["(let ", sc, " = box_new() in (let ", w, "(_) = ", loopbody, " in ", w, "(0)))"])
    else if tag == "for" then
      let init = nth(s, 1) in
      let test = nth(s, 2) in
      let upd = nth(s, 3) in
      let body = nth(s, 4) in
      let w = js_fresh(st, "w") in
      let sc = js_fresh(st, "sc") in
      let cvar =
        if nth(init, 0) == "let" then
          let nm = nth(init, 2) in
          let strs3 = if js_is_str_expr(nth(init, 3), nth(ctx2, 4)) then cons(nm, nth(ctx2, 4)) else nth(ctx2, 4) in
          [cons(nm, nth(ctx2, 0)), nth(ctx2, 1), nth(ctx2, 2), nth(ctx2, 3), strs3, nth(ctx2, 5)]
        else ctx2 in
      let c3 = with_brk(cvar, sc) in
      let nxt =
        if nth(upd, 0) == "null" then js_cat([w, "(0)"])
        else js_cat(["(let _ = ", js_emit_expr(upd, c3, st), " in ", w, "(0))"]) in
      let body_e = js_emit_stmts(body, c3, "0", st) in
      let testc = js_emit_expr(test, c3, st) in
      let loopbody = js_cat(["(if ", js_truth(testc, st), " then (let _ = box_set(", sc, ", 0) in (let _ = ", body_e, " in ", after_loop(sc, nxt), ")) else 0)"]) in
      let loop = js_cat(["(let ", sc, " = box_new() in (let ", w, "(_) = ", loopbody, " in ", w, "(0)))"]) in
      if nth(init, 0) == "let" then
        let m = js_mangle(nth(init, 2)) in
        js_cat(["(let ", m, " = box_new() in (let _ = box_set(", m, ", ", js_emit_expr(nth(init, 3), ctx2, st), ") in ", loop, "))"])
      else if nth(init, 0) == "expr" then js_emit_stmts([init], ctx2, loop, st)
      else loop
    else if tag == "break" then
      if brk == 0 then (let _ = js_fail(st, "'break' outside loop or switch") in "0")
      else js_cat(["(let _ = box_set(", brk, ", 1) in 0)"])
    else if tag == "continue" then
      if brk == 0 then (let _ = js_fail(st, "'continue' outside loop") in "0")
      else js_cat(["(let _ = box_set(", brk, ", 2) in 0)"])
    else if tag == "switch" then
      /* JS fallthrough: the matched case runs its body then every later case's
       * body in source order (a `break` stops it via the status box). For each
       * clause i, body_i is the concatenation of bodies[i..]; the chain tests
       * non-default clauses in order, and `default` (wherever it sits) is only
       * the no-match fallback with body_default. */
      let d = js_fresh(st, "d") in
      let sc = js_fresh(st, "sc") in
      let c3 = with_brk(ctx2, sc) in
      let cls = nth(s, 2) in
      let n = len(cls) in
      let is_def(cl) = nth(nth(cl, 0), 0) == "null" in
      let suffix(i) = if i >= n then [] else append(nth(nth(cls, i), 1), suffix(i + 1)) in
      let body(i) = js_emit_stmts(suffix(i), c3, "0", st) in
      let defidx =
        let fnd(i) = if i >= n then 0 - 1 else if is_def(nth(cls, i)) then i else fnd(i + 1) in
        fnd(0) in
      let fallback = if defidx < 0 then "0" else body(defidx) in
      let chain(i) =
        if i >= n then fallback
        else if is_def(nth(cls, i)) then chain(i + 1)
        else
          let cl = nth(cls, i) in
          js_cat(["(if ", d, " == (", js_emit_expr(nth(cl, 0), c3, st), ") then ", body(i), " else ", chain(i + 1), ")"]) in
      js_cat(["(let ", sc, " = box_new() in (let ", d, " = ", js_emit_expr(nth(s, 1), ctx2, st), " in ", chain(0), "))"])
    else if tag == "throw" then
      /* Record the value in the global exception box; the guard after this
       * statement (and in every enclosing body / loop) stops the rest. */
      js_cat(["(let _ = box_set(_js_exc, ", js_emit_expr(nth(s, 1), ctx2, st), ") in 0)"])
    else if tag == "try" then
      let tryXs = nth(s, 1) in
      let cn = nth(s, 2) in
      let cxs = nth(s, 3) in
      let fxs = nth(s, 4) in
      let tryE = js_emit_stmts(tryXs, ctx2, "0", st) in
      let finE = if len(fxs) > 0 then js_emit_stmts(fxs, ctx2, "0", st) else "0" in
      let cpart =
        if nth(cn, 0) == "str" then
          let nm = nth(cn, 1) in
          let m = js_mangle(nm) in
          let cctx = [cons(nm, nth(ctx2, 0)), nth(ctx2, 1), nth(ctx2, 2), nth(ctx2, 3), nth(ctx2, 4), nth(ctx2, 5)] in
          let cE = js_emit_stmts(cxs, cctx, "0", st) in
          js_cat(["(if box_get(_js_exc) != 0 then (let ", m, " = box_new() in (let _ = box_set(", m, ", box_get(_js_exc)) in (let _ = box_set(_js_exc, 0) in ", cE, "))) else 0)"])
        else "0" in
      js_cat(["(let _ = box_set(_js_exc, 0) in (let _ = ", tryE, " in (let _ = ", cpart, " in (let _ = ", finE, " in 0))))"])
    else if tag == "forin" then
      let nm = nth(s, 1) in
      let obj = nth(s, 2) in
      let body = nth(s, 3) in
      let _ = box_set(st_obj(st), 1) in
      let _ = box_set(st_fmap(st), 1) in
      let ks = js_fresh(st, "ks") in
      let w = js_fresh(st, "w") in
      let m = js_mangle(nm) in
      let sc = js_fresh(st, "sc") in
      let p = js_fresh(st, "i") in
      let c3 = [cons(nm, nth(ctx2, 0)), nth(ctx2, 1), nth(ctx2, 2), nth(ctx2, 3), cons(nm, nth(ctx2, 4)), sc] in
      let bodyE = js_emit_stmts(body, c3, "0", st) in
      js_cat(["(let ", ks, " = _js_keys(", js_emit_expr(obj, ctx2, st), ") in (let ", m, " = box_new() in (let ", sc, " = box_new() in (let ", w, "(", p, ") = (if ", p, " < len(", ks, ") then (let _ = box_set(", m, ", nth(", ks, ", ", p, ")) in (let _ = box_set(", sc, ", 0) in (let _ = ", bodyE, " in (if box_get(_js_exc) != 0 then 0 else (if box_get(", sc, ") == 1 then 0 else ", w, "(", p, " + 1)))))) else 0) in ", w, "(0)))))"])
    else if tag == "ret" then
      /* Set the flag + value boxes; the guard after each statement unwinds. */
      let v = js_emit_expr(nth(s, 1), ctx2, st) in
      if retf == 0 then v
      else js_cat(["(let _ = box_set(", retf, ", true) in (let _ = box_set(", retv, ", ", v, ") in ", retv, "))"])
    else "0" in
  /* Function declarations use the shared js_func_body. */
  /* Walk the list, threading scope and continuation. Every non-declaration
   * statement is followed by a guard so an early return / break stops the rest
   * of the list. */
  let go(xs, vars2, funcs2, strs2, brk2, k2) =
    if len(xs) == 0 then k2
    else
      let s = nth(xs, 0) in
      let rest = tail(xs) in
      let tag = nth(s, 0) in
      if tag == "func" then
        let nm = nth(s, 1) in
        let ps = nth(s, 2) in
        let body = nth(s, 3) in
        let m = js_mangle(nm) in
        let funcs3 = cons(nm, funcs2) in
        let fb = js_func_body(ps, body, [vars2, funcs3, retf, retv, strs2, brk2], st) in
        js_cat(["(let ", m, "(", nth(fb, 0), ") = ", nth(fb, 1), " in ", go(rest, vars2, funcs3, strs2, brk2, k2), ")"])
      else if tag == "dlet" then
        /* Destructuring declaration: bind a temp to the initialiser, then one
         * boxed let per name (array slots via nth, object keys via _js_get).
         * The names are added to the var list before the continuation so the
         * rest of the block sees them. */
        let pat = nth(s, 1) in
        let ie = js_emit_expr(nth(s, 2), [vars2, funcs2, retf, retv, strs2, brk2], st) in
        let _ = if js_pat_has_obj(pat) then box_set(st_obj(st), 1) else 0 in
        let o = js_fresh(st, "d") in
        let flat = js_pat_flat(pat, js_cat(["box_get(", o, ")"])) in
        let extvars = append(js_pat_names(flat), vars2) in
        let cont = go(rest, extvars, funcs2, strs2, brk2, k2) in
        let n = len(flat) in
        let wrap(i, inner) =
          if i < 0 then inner
          else
            let nm = nth(nth(flat, i), 0) in
            let ae = nth(nth(flat, i), 1) in
            let m = js_mangle(nm) in
            wrap(i - 1, js_cat(["(let ", m, " = box_new() in (let _ = box_set(", m, ", ", ae, ") in ", inner, "))"])) in
        js_cat(["(let ", o, " = box_new() in (let _ = box_set(", o, ", ", ie, ") in ", wrap(n - 1, cont), "))"])
      else if tag == "let" then
        let nm = nth(s, 2) in
        let m = js_mangle(nm) in
        let ie = js_emit_expr(nth(s, 3), [vars2, funcs2, retf, retv, strs2, brk2], st) in
        let vars3 = cons(nm, vars2) in
        let strs3 = if js_is_str_expr(nth(s, 3), strs2) then cons(nm, strs2) else strs2 in
        js_cat(["(let ", m, " = box_new() in (let _ = box_set(", m, ", ", ie, ") in ", go(rest, vars3, funcs2, strs3, brk2, k2), "))"])
      else
        let se = sstmt(s, [vars2, funcs2, retf, retv, strs2, brk2], k2) in
        let cont = go(rest, vars2, funcs2, strs2, brk2, k2) in
        let inner = if brk2 == 0 then cont
                    else js_cat(["(if box_get(", brk2, ") != 0 then 0 else ", cont, ")"]) in
        let inner2 = js_cat(["(if box_get(_js_exc) != 0 then 0 else ", inner, ")"]) in
        let guard =
          if retf == 0 then inner2
          else js_cat(["(if box_get(", retf, ") then box_get(", retv, ") else ", inner2, ")"]) in
        js_cat(["(let _ = ", se, " in ", guard, ")"]) in
  go(stmts, nth(ctx, 0), nth(ctx, 1), nth(ctx, 4), nth(ctx, 5), k)

/* ---- entry point ------------------------------------------------------ */

/* Translate a whole JS program. Allocates the per-translation state, lexes /
 * parses / emits, and prepends only the imports and helpers the program
 * actually needs. Returns "error: …" if the front end recorded a problem. */
let js_to_yac(src) =
  let err = box_new() in
  let _ = box_set(err, "") in
  let ns = box_new() in
  let _ = box_set(ns, 0) in
  let ufmap = box_new() in
  let _ = box_set(ufmap, 0) in
  let umath = box_new() in
  let _ = box_set(umath, 0) in
  let ustr = box_new() in
  let _ = box_set(ustr, 0) in
  let ubool = box_new() in
  let _ = box_set(ubool, 0) in
  let utype = box_new() in
  let _ = box_set(utype, 0) in
  let ulib = box_new() in
  let _ = box_set(ulib, 0) in
  let ustrpkg = box_new() in
  let _ = box_set(ustrpkg, 0) in
  let uobj = box_new() in
  let _ = box_set(uobj, 0) in
  let ujslib = box_new() in
  let _ = box_set(ujslib, 0) in
  let utruth = box_new() in
  let _ = box_set(utruth, 0) in
  let ubuiltin = box_new() in
  let _ = box_set(ubuiltin, 0) in
  let st = [err, ns, ufmap, umath, ustr, ubool, utype, ulib, ustrpkg, uobj, ujslib, utruth, ubuiltin] in
  let _ = box_set(js_stmts_parse_box, js_parse_stmts) in
  let _ = box_set(js_stmts_box, js_emit_stmts) in
  let _ = box_set(js_expr_box, js_emit_expr) in
  let toks = js_lex(src) in
  let r = js_parse_stmts(toks, 0, ["list", 0], st) in
  let body = js_emit_stmts(nth(r, 0), [[], [], 0, 0, [], 0], "0", st) in
  let e = box_get(err) in
  if e != "" then js_cat(["error: ", e])
  else
    let h0 = "let _js_exc = box_new()\n" in
    let h1 = if box_get(ufmap) == 1 or box_get(uobj) == 1 then "import data.fmap { fmap_new, fmap_get, fmap_put }\n" else "" in
    let h2 = if box_get(umath) == 1 then "import num.math { abs, min, max, pow, sqrt, pi, e, sin, cos, exp, log, log2, powf }\n" else "" in
    let h6 = if box_get(ustrpkg) == 1 then "import text.str { split, starts_with, ends_with, join, trim, find, contains }\n" else "" in
    let h8 =
      if box_get(uobj) == 1 then
        "let _js_this = box_new()\nlet _js_protos = box_new()\nlet _js_obj(proto) =\n  let m = fmap_new(0) in\n  let _ = fmap_put(m, \"__proto__\", proto) in\n  [\"$o\", m]\nlet _js_get(o, k) =\n  if o == 0 then 0\n  else\n    let m = nth(o, 1) in\n    let v = fmap_get(m, k) in\n    if v != 0 then v\n    else\n      let p = fmap_get(m, \"__proto__\") in\n      if p == 0 then 0 else _js_get(p, k)\nlet _js_keys(o) =\n  if is_int(o) then list_new()\n  else\n    let m = nth(o, 1) in\n    let vec = nth(m, 0) in\n    let cap = nth(m, 2) in\n    let r = list_new() in\n    let rec(i) =\n      if i >= cap then r\n      else\n        let e = nth(vec, i) in\n        let _ =\n          if e == 0 then 0\n          else\n            let kk = nth(e, 0) in\n            if kk == \"__proto__\" then 0 else list_push(r, kk) in\n        rec(i + 1) in\n    rec(0)\nlet _js_proto(nm) =\n  let m = box_get(_js_protos) in\n  let m2 = if m == 0 then (let x = fmap_new(0) in (let _ = box_set(_js_protos, x) in x)) else m in\n  let p = fmap_get(m2, nm) in\n  if p == 0 then (let x = _js_obj(0) in (let _ = fmap_put(m2, nm, x) in x)) else p\n"
      else "" in
    let h10 = if box_get(ujslib) == 1 then "import lang.jslib { js_parse_int, js_parse_float, js_is_nan, js_is_finite, js_native }\n" else "" in
    let hjsrt =
      if box_get(ustr) == 1 or box_get(ubool) == 1 or box_get(utype) == 1 or box_get(ulib) == 1 or box_get(utruth) == 1 then
        "import lang.jsrt { _js_str, _js_bool, _js_typeof, _js_truth, _js_char_at, _js_upper, _js_lower, _js_repeat, _js_arr_slice, _js_arr_index, _js_arr_map, _js_arr_filter, _js_arr_each, _js_arr_reduce, _js_arr_join, _js_arr_concat, _js_arr_sort, _js_str_replace, _js_isnan }\n"
      else "" in
    js_cat([h0, h1, h2, h6, h10, hjsrt, h8, body, "\n"])
