/* jslib.yac — JavaScript standard library for lang.js output.
 *
 * Global functions (parseInt / parseFloat / isNaN / isFinite) and host-backed
 * built-in objects (Date.now, String.fromCharCode) live here, plus the JSON
 * object. Math maps onto num.math directly (see js.yac). Kept separate from
 * jsrt.yac (stateless value/array/string helpers). */
package lang.jslib
export js_parse_int, js_parse_float, js_is_nan, js_is_finite, js_date_now, js_from_char_code,
  js_native, js_json_stringify, js_json_parse, js_str_pad, js_str_trim_start, js_str_trim_end,
  js_install
import data.fmap { fmap_new, fmap_get, fmap_put }
import num.math { ftoi, log, exp, powf, abs, pow, sqrt, sin, cos, log2, sign }
import lang.jsrt { _js_iter, _js_str }

/* Decimal integer parse: optional leading '-', then digits (stops at the first
 * non-digit, like parseInt without a radix). */
let js_parse_int(s) =
  let n = str_len(s) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(s, i) in
      if c >= 48 and c <= 57 then rec(i + 1, acc * 10 + (c - 48))
      else acc in
  if n > 0 then
    if str_ref(s, 0) == 45 then 0 - rec(1, 0) else rec(0, 0)
  else 0

/* Float parse falls back to the integer parser (integers are the supported
 * numeric literals for arithmetic in this subset). */
let js_parse_float(s) = js_parse_int(s)

let js_is_nan(x) = x != x

let js_is_finite(x) = x == x

/* Date.now() -- milliseconds since the epoch. */
let js_date_now(_) = time_ms()

/* String.fromCharCode(c) -- code point to a one-char string. */
let js_from_char_code(c) = str_chr(c)

/* ---- JSON.stringify --------------------------------------------------- */

/* Objects are tagged ["$o", fmap]; arrays are cons/listbufs. */
let js_json_is_obj(x) =
  let k = kind(x) in
  (k == 2 or k == 5) and len(x) > 0 and nth(x, 0) == "$o"

let js_json_quote(s) =
  let b = bytes_new() in
  let _ = bytes_append(b, 34) in
  let n = str_len(s) in
  let rec(i) =
    if i >= n then 0
    else
      let c = str_ref(s, i) in
      let _ =
        if c == 34 then (let _ = bytes_append(b, 92) in bytes_append(b, 34))
        else if c == 92 then (let _ = bytes_append(b, 92) in bytes_append(b, 92))
        else if c == 10 then (let _ = bytes_append(b, 92) in bytes_append(b, 110))
        else if c == 9 then (let _ = bytes_append(b, 92) in bytes_append(b, 116))
        else bytes_append(b, c) in
      rec(i + 1) in
  let _ = rec(0) in
  let _ = bytes_append(b, 34) in
  bytes_to_str(b)

/* Value -> JSON text. int/string/float are leaves; bool and null share the int
 * representation, so they stringify as numbers (a known limitation). */
let js_json_stringify(x) =
  let arr_go(a, i, n) =
    if i >= n then ""
    else if i == 0 then str_cat(js_json_stringify(nth(a, i)), arr_go(a, i + 1, n))
    else str_cat(",", str_cat(js_json_stringify(nth(a, i)), arr_go(a, i + 1, n))) in
  let obj_go(m, i, cap, first) =
    if i >= cap then ""
    else
      let e = nth(nth(m, 0), i) in
      if e == 0 then obj_go(m, i + 1, cap, first)
      else
        let kk = nth(e, 0) in
        if kk == "__proto__" then obj_go(m, i + 1, cap, first)
        else
          let piece = str_cat(js_json_quote(kk), str_cat(":", js_json_stringify(nth(e, 1)))) in
          if first == 1 then str_cat(piece, obj_go(m, i + 1, cap, 0))
          else str_cat(",", str_cat(piece, obj_go(m, i + 1, cap, 0))) in
  let k = kind(x) in
  if k == 3 then js_json_quote(x)
  else if k == 0 then int_to_str(x)
  else if k == 7 then _js_str(x)
  else if js_json_is_obj(x) then
    str_cat("{", str_cat(obj_go(nth(x, 1), 0, nth(nth(x, 1), 2), 1), "}"))
  else if k == 2 or k == 5 then str_cat("[", str_cat(arr_go(x, 0, len(x)), "]"))
  else "null"

/* ---- JSON.parse ------------------------------------------------------- */

let jw_ws(c) = c == 32 or c == 9 or c == 10 or c == 13

let jw_skip(s, i) =
  if i >= str_len(s) then i
  else if jw_ws(str_ref(s, i)) then jw_skip(s, i + 1)
  else i

let jw_str_go(s, i, acc) =
  let n = str_len(s) in
  if i >= n then 0
  else
    let c = str_ref(s, i) in
    if c == 34 then [bytes_to_str(acc), i + 1]
    else if c == 92 then
      if i + 1 >= n then 0
      else
        let e = str_ref(s, i + 1) in
        let ch = if e == 110 then 10 else if e == 116 then 9 else if e == 34 then 34 else if e == 92 then 92 else e in
        let _ = bytes_append(acc, ch) in
        jw_str_go(s, i + 2, acc)
    else
      let _ = bytes_append(acc, c) in
      jw_str_go(s, i + 1, acc)

let jw_str(s, i) =
  if i >= str_len(s) then 0
  else if str_ref(s, i) != 34 then 0
  else jw_str_go(s, i + 1, bytes_new())

let jw_skip_digits(s, i) =
  let n = str_len(s) in
  if i < n and str_ref(s, i) >= 48 and str_ref(s, i) <= 57 then jw_skip_digits(s, i + 1) else i

/* Integer part; a fraction/exponent is skipped (truncated to int). */
let jw_num_go(s, i, acc, started) =
  let n = str_len(s) in
  if i >= n then (if started == 0 then 0 else [acc, i])
  else
    let c = str_ref(s, i) in
    if c >= 48 and c <= 57 then jw_num_go(s, i + 1, acc * 10 + (c - 48), 1)
    else if c == 46 then jw_num_go(s, jw_skip_digits(s, i + 1), acc, started)
    else if c == 101 or c == 69 then
      let k = i + 1 in
      let k2 = if k < n and (str_ref(s, k) == 43 or str_ref(s, k) == 45) then k + 1 else k in
      jw_num_go(s, jw_skip_digits(s, k2), acc, started)
    else if started == 0 then 0
    else [acc, i]

let jw_num(s, i) =
  if i >= str_len(s) then 0
  else if str_ref(s, i) == 45 then
    (let r = jw_num_go(s, i + 1, 0, 0) in
     if r == 0 then 0 else [0 - nth(r, 0), nth(r, 1)])
  else jw_num_go(s, i, 0, 0)

let jw_word(s, i, w) =
  let m = str_len(w) in
  if i + m > str_len(s) then 0 - 1
  else if str_slice(s, i, m) == w then i + m
  else 0 - 1

let jw_putall(m, ps) =
  if len(ps) == 0 then 0
  else
    let p = nth(ps, 0) in
    let _ = fmap_put(m, nth(p, 0), nth(p, 1)) in
    jw_putall(m, tail(ps))

/* op 0=value, 1=array body, 2=object body. Self-recursive. */
let jw_work(op, s, i, acc) =
  let n = str_len(s) in
  if op == 0 then
    let j = jw_skip(s, i) in
    if j >= n then 0
    else
      let c = str_ref(s, j) in
      if c == 34 then jw_str(s, j)
      else if c == 91 then jw_work(1, s, j + 1, [])
      else if c == 123 then jw_work(2, s, j + 1, [])
      else if c == 116 then (let k = jw_word(s, j, "true") in if k < 0 then 0 else [true, k])
      else if c == 102 then (let k = jw_word(s, j, "false") in if k < 0 then 0 else [false, k])
      else if c == 110 then (let k = jw_word(s, j, "null") in if k < 0 then 0 else [0, k])
      else jw_num(s, j)
  else if op == 1 then
    let j = jw_skip(s, i) in
    if j >= n then 0
    else if str_ref(s, j) == 93 then [list_rev(acc), j + 1]
    else
      let r = jw_work(0, s, j, 0) in
      if r == 0 then 0
      else
        let k = jw_skip(s, nth(r, 1)) in
        if k >= n then 0
        else if str_ref(s, k) == 44 then jw_work(1, s, k + 1, cons(nth(r, 0), acc))
        else if str_ref(s, k) == 93 then [list_rev(cons(nth(r, 0), acc)), k + 1]
        else 0
  else
    let j = jw_skip(s, i) in
    if j >= n then 0
    else if str_ref(s, j) == 125 then
      (let m = fmap_new(0) in (let _ = jw_putall(m, list_rev(acc)) in [["$o", m], j + 1]))
    else
      let kr = jw_str(s, j) in
      if kr == 0 then 0
      else
        let c = jw_skip(s, nth(kr, 1)) in
        if c >= n then 0
        else if str_ref(s, c) != 58 then 0
        else
          let vr = jw_work(0, s, c + 1, 0) in
          if vr == 0 then 0
          else
            let pair = [nth(kr, 0), nth(vr, 0)] in
            let k = jw_skip(s, nth(vr, 1)) in
            if k >= n then 0
            else if str_ref(s, k) == 44 then jw_work(2, s, k + 1, cons(pair, acc))
            else if str_ref(s, k) == 125 then
              (let m = fmap_new(0) in (let _ = jw_putall(m, list_rev(cons(pair, acc))) in [["$o", m], k + 1]))
            else 0

let js_json_parse(s) =
  let r = jw_work(0, s, 0, 0) in
  if r == 0 then 0
  else
    let k = jw_skip(s, nth(r, 1)) in
    if k == str_len(s) then nth(r, 0) else 0

/* ---- extra built-in object helpers ------------------------------------ */

/* Object.defineProperty(o, k, {get,set,value}): accessor if get/set present. */
let js_obj_defprop(o, k, d) =
  let g = fmap_get(nth(d, 1), "get") in
  let s = fmap_get(nth(d, 1), "set") in
  let v = fmap_get(nth(d, 1), "value") in
  if g != 0 or s != 0 then (let _ = fmap_put(nth(o, 1), k, ["$acc", g, s]) in o)
  else (let _ = fmap_put(nth(o, 1), k, v) in o)

/* Own enumerable keys of a tagged object (skips prototype link). */
let js_keys_of(o) =
  if kind(o) != 2 and kind(o) != 5 then list_new()
  else
    let m = nth(o, 1) in
    let vec = nth(m, 0) in
    let cap = nth(m, 2) in
    let r = list_new() in
    let rec(i) =
      if i >= cap then r
      else
        let e = nth(vec, i) in
        let _ =
          if e == 0 then 0
          else
            let kk = nth(e, 0) in
            if kk == "__proto__" then 0 else list_push(r, kk) in
        rec(i + 1) in
    rec(0)

/* Object.assign(target, ...sources) — mutates + returns target. */
let js_obj_assign(tgt, srcs) =
  let n = len(srcs) in
  let rec(i) =
    if i >= n then tgt
    else
      let s = nth(srcs, i) in
      let ks = js_keys_of(s) in
      let kn = len(ks) in
      let rec2(j) =
        if j >= kn then 0
        else
          let kk = nth(ks, j) in
          let _ = fmap_put(nth(tgt, 1), kk, fmap_get(nth(s, 1), kk)) in
          rec2(j + 1) in
      let _ = rec2(0) in
      rec(i + 1) in
  rec(0)

let js_obj_values(o) =
  let ks = js_keys_of(o) in
  let n = len(ks) in
  let r = list_new() in
  let rec(i) = if i >= n then r else (let _ = list_push(r, fmap_get(nth(o, 1), nth(ks, i))) in rec(i + 1)) in
  rec(0)

let js_obj_entries(o) =
  let ks = js_keys_of(o) in
  let n = len(ks) in
  let r = list_new() in
  let rec(i) =
    if i >= n then r
    else (let _ = list_push(r, [nth(ks, i), fmap_get(nth(o, 1), nth(ks, i))]) in rec(i + 1)) in
  rec(0)

/* Array.from/Array.of — copy a list of elements (args is already a list). */
let js_arr_copy(xs) =
  let n = len(xs) in
  let r = list_new() in
  let rec(i) = if i >= n then r else (let _ = list_push(r, nth(xs, i)) in rec(i + 1)) in
  rec(0)

/* Array.from(x, mapFn): x may be an iterable (array/string/Map/Set). */
let js_array_from(x, f) =
  let it = _js_iter(x) in
  let n = len(it) in
  let r = list_new() in
  let rec(i) =
    if i >= n then r
    else
      let v = nth(it, i) in
      let _ = list_push(r, (if f == 0 then v else f(v))) in
      rec(i + 1) in
  rec(0)

let js_num_is_nan(x) = x != x
let js_num_is_finite(x) = x == x
let js_num_is_integer(x) = is_int(x) or (kind(x) == 7 and ftoi(x) == x)

let js_str_pad(s, target, fill, left) =
  let fill1 = if str_len(fill) == 0 then " " else fill in
  let need = target - str_len(s) in
  if need <= 0 then s
  else
    let grow(p) = if str_len(p) >= need then p else grow(str_cat(p, fill1)) in
    let p = str_slice(grow(""), 0, need) in
    if left then str_cat(p, s) else str_cat(s, p)

let js_str_ws(c) = c == 32 or c == 9 or c == 10 or c == 13

let js_str_trim_start(s) =
  let n = str_len(s) in
  let i0 = (let rec(i) = if i >= n then i else if js_str_ws(str_ref(s, i)) then rec(i + 1) else i in rec(0)) in
  str_slice(s, i0, n - i0)

let js_str_trim_end(s) =
  let n = str_len(s) in
  let j0 = (let rec(j) = if j <= 0 then j else if js_str_ws(str_ref(s, j - 1)) then rec(j - 1) else j in rec(n)) in
  str_slice(s, 0, j0)

/* ---- built-in object dispatch ----------------------------------------- */

/* `js_native("JSON", "stringify", [x])` etc. Generated code routes every
 * UpperCamelCase object method here, so adding an object or method is a change
 * to this one function; a new object needs no translator registration beyond
 * being UpperCamelCase. Math / Object keep their inline fast paths. */
/* Math.max/min/hypot over an argument list. */
let js_maxg(args) =
  let n = len(args) in
  let rec(i, acc) = if i >= n then acc else rec(i + 1, if nth(args, i) > acc then nth(args, i) else acc) in
  if n == 0 then 0 else rec(1, nth(args, 0))

let js_ming(args) =
  let n = len(args) in
  let rec(i, acc) = if i >= n then acc else rec(i + 1, if nth(args, i) < acc then nth(args, i) else acc) in
  if n == 0 then 0 else rec(1, nth(args, 0))

let js_hypotg(args) =
  let n = len(args) in
  let ss = box_new() in
  let _ = box_set(ss, 0) in
  let rec(i) =
    if i >= n then 0
    else (let x = nth(args, i) in (let _ = box_set(ss, box_get(ss) + x * x) in rec(i + 1))) in
  let _ = rec(0) in
  sqrt(box_get(ss))

let js_math(m, args) =
  if m == "floor" or m == "ceil" or m == "round" or m == "trunc" then
    (if len(args) == 0 then 0 else nth(args, 0))
  else if m == "random" then 0
  else if m == "abs" then abs(nth(args, 0))
  else if m == "sqrt" then sqrt(nth(args, 0))
  else if m == "sin" then sin(nth(args, 0))
  else if m == "cos" then cos(nth(args, 0))
  else if m == "exp" then exp(nth(args, 0))
  else if m == "log" then log(nth(args, 0))
  else if m == "log2" then log2(nth(args, 0))
  else if m == "sign" then sign(nth(args, 0))
  else if m == "pow" then pow(nth(args, 0), nth(args, 1))
  else if m == "cbrt" then powf(nth(args, 0), 1.0 / 3.0)
  else if m == "log10" then log(nth(args, 0)) / log(10.0)
  else if m == "log1p" then log(1.0 + nth(args, 0))
  else if m == "expm1" then exp(nth(args, 0)) - 1.0
  else if m == "imul" then nth(args, 0) * nth(args, 1)
  else if m == "clz32" then 0
  else if m == "fround" then nth(args, 0)
  else if m == "max" then js_maxg(args)
  else if m == "min" then js_ming(args)
  else if m == "hypot" then js_hypotg(args)
  else if m == "sinh" then (exp(nth(args, 0)) - exp(0.0 - nth(args, 0))) / 2.0
  else if m == "cosh" then (exp(nth(args, 0)) + exp(0.0 - nth(args, 0))) / 2.0
  else if m == "tanh" then (let e = exp(2.0 * nth(args, 0)) in (e - 1.0) / (e + 1.0))
  else if m == "asinh" then (let x = nth(args, 0) in log(x + sqrt(x * x + 1.0)))
  else if m == "acosh" then (let x = nth(args, 0) in log(x + sqrt(x * x - 1.0)))
  else if m == "atanh" then (let x = nth(args, 0) in 0.5 * log((1.0 + x) / (1.0 - x)))
  else 0

let js_native(obj, m, args) =
  if obj == "Date" then
    (if m == "now" then js_date_now(0) else 0)
  else if obj == "String" then
    (if m == "fromCharCode" then js_from_char_code(nth(args, 0)) else 0)
  else if obj == "JSON" then
    (if m == "stringify" then js_json_stringify(nth(args, 0))
     else if m == "parse" then js_json_parse(nth(args, 0))
     else 0)
  else if obj == "Array" then
    (if m == "isArray" then
       (let x = nth(args, 0) in
        let k = kind(x) in
        if (k == 2 or k == 5) and not js_json_is_obj(x) then true else false)
     else if m == "from" then js_array_from(nth(args, 0), (if len(args) > 1 then nth(args, 1) else 0))
     else if m == "of" then js_arr_copy(args)
     else 0)
  else if obj == "Object" then
    (if m == "assign" then js_obj_assign(nth(args, 0), drop(args, 1))
     else if m == "values" then js_obj_values(nth(args, 0))
     else if m == "entries" then js_obj_entries(nth(args, 0))
     else if m == "keys" then js_keys_of(nth(args, 0))
     else if m == "getOwnPropertyNames" then js_keys_of(nth(args, 0))
     else if m == "create" then
       (let o = ["$o", fmap_new(0)] in (let _ = fmap_put(nth(o, 1), "__proto__", nth(args, 0)) in o))
     else if m == "getPrototypeOf" then fmap_get(nth(nth(args, 0), 1), "__proto__")
     else if m == "defineProperty" then js_obj_defprop(nth(args, 0), nth(args, 1), nth(args, 2))
     else if m == "freeze" or m == "seal" or m == "preventExtensions" then nth(args, 0)
     else if m == "is" then nth(args, 0) == nth(args, 1)
     else if m == "setPrototypeOf" then
       (let o = nth(args, 0) in (let _ = fmap_put(nth(o, 1), "__proto__", nth(args, 1)) in o))
     else 0)
  else if obj == "Math" then js_math(m, args)
  else if obj == "Number" then
    (if m == "isNaN" then js_num_is_nan(nth(args, 0))
     else if m == "isFinite" then js_num_is_finite(nth(args, 0))
     else if m == "isInteger" then js_num_is_integer(nth(args, 0))
     else if m == "parseInt" then js_parse_int(nth(args, 0))
     else if m == "parseFloat" then js_parse_float(nth(args, 0))
     else 0)
  else 0

/* ---- Map / Set (object model: instance is ["$o", fmap], data in "$data") -- */

let js_map_data(self) =
  let d = fmap_get(nth(self, 1), "$data") in
  if d == 0 then (let nd = list_new() in (let _ = fmap_put(nth(self, 1), "$data", nd) in nd)) else d

let js_map(self, op, args) =
  let d = js_map_data(self) in
  if op == "set" then
    (let k = nth(args, 0) in (let v = nth(args, 1) in
     (let n = len(d) in
      (let rec(i) = (if i >= n then (let _ = list_push(d, [k, v]) in 0) else (if nth(nth(d, i), 0) == k then (let _ = list_set(d, i, [k, v]) in 0) else rec(i + 1))) in
       (let _ = rec(0) in (let _ = fmap_put(nth(self, 1), "size", len(d)) in self))))))
  else if op == "get" then
    (let k = nth(args, 0) in
     (let n = len(d) in
      (let rec(i) = (if i >= n then 0 else (if nth(nth(d, i), 0) == k then nth(nth(d, i), 1) else rec(i + 1))) in rec(0))))
  else if op == "has" then
    (let k = nth(args, 0) in
     (let n = len(d) in
      (let rec(i) = (if i >= n then false else (if nth(nth(d, i), 0) == k then true else rec(i + 1))) in rec(0))))
  else if op == "delete" then
    (let k = nth(args, 0) in
     (let n = len(d) in (let nd = list_new() in
      (let rec(i) = (if i >= n then 0 else (let _ = if nth(nth(d, i), 0) == k then 0 else list_push(nd, nth(d, i)) in rec(i + 1))) in
       (let _ = rec(0) in (let _ = fmap_put(nth(self, 1), "$data", nd) in (let _ = fmap_put(nth(self, 1), "size", len(nd)) in (len(nd) != n))))))))
  else if op == "keys" or op == "values" or op == "entries" then
    (let r = list_new() in (let n = len(d) in
     (let rec(i) = (if i >= n then 0 else (let e = nth(d, i) in (let _ = list_push(r, (if op == "keys" then nth(e, 0) else if op == "values" then nth(e, 1) else e)) in rec(i + 1)))) in
      (let _ = rec(0) in r))))
  else if op == "forEach" then
    (let f = nth(args, 0) in (let n = len(d) in
     (let rec(i) = (if i >= n then 0 else (let e = nth(d, i) in (let _ = f(nth(e, 1), nth(e, 0)) in rec(i + 1)))) in
      (let _ = rec(0) in 0))))
  else 0

let js_set(self, op, args) =
  let d = js_map_data(self) in
  if op == "add" then
    (let v = nth(args, 0) in
     (let n = len(d) in
      (let rec(i) = (if i >= n then (let _ = list_push(d, v) in 0) else (if nth(d, i) == v then 0 else rec(i + 1))) in
       (let _ = rec(0) in (let _ = fmap_put(nth(self, 1), "size", len(d)) in self)))))
  else if op == "has" then
    (let v = nth(args, 0) in
     (let n = len(d) in
      (let rec(i) = (if i >= n then false else (if nth(d, i) == v then true else rec(i + 1))) in rec(0))))
  else if op == "delete" then
    (let v = nth(args, 0) in
     (let n = len(d) in (let nd = list_new() in
      (let rec(i) = (if i >= n then 0 else (let _ = if nth(d, i) == v then 0 else list_push(nd, nth(d, i)) in rec(i + 1))) in
       (let _ = rec(0) in (let _ = fmap_put(nth(self, 1), "$data", nd) in (let _ = fmap_put(nth(self, 1), "size", len(nd)) in (len(nd) != n))))))))
  else if op == "forEach" then
    (let f = nth(args, 0) in (let n = len(d) in
     (let rec(i) = (if i >= n then 0 else (let _ = f(nth(d, i)) in rec(i + 1))) in
      (let _ = rec(0) in 0))))
  else 0

/* Register Map/Set prototype methods. `this` is the generated program`s
 * _js_this box and `proto` its _js_proto function (closure captures both). */
let js_install(this, proto) =
  let mp = proto("Map") in
  let sp = proto("Set") in
  let _ = fmap_put(nth(mp, 1), "set", fun(a, b) -> js_map(box_get(this), "set", [a, b])) in
  let _ = fmap_put(nth(mp, 1), "get", fun(a) -> js_map(box_get(this), "get", [a])) in
  let _ = fmap_put(nth(mp, 1), "has", fun(a) -> js_map(box_get(this), "has", [a])) in
  let _ = fmap_put(nth(mp, 1), "delete", fun(a) -> js_map(box_get(this), "delete", [a])) in
  let _ = fmap_put(nth(mp, 1), "keys", fun(_) -> js_map(box_get(this), "keys", [])) in
  let _ = fmap_put(nth(mp, 1), "values", fun(_) -> js_map(box_get(this), "values", [])) in
  let _ = fmap_put(nth(mp, 1), "entries", fun(_) -> js_map(box_get(this), "entries", [])) in
  let _ = fmap_put(nth(mp, 1), "forEach", fun(f) -> js_map(box_get(this), "forEach", [f])) in
  let _ = fmap_put(nth(sp, 1), "add", fun(a) -> js_set(box_get(this), "add", [a])) in
  let _ = fmap_put(nth(sp, 1), "has", fun(a) -> js_set(box_get(this), "has", [a])) in
  let _ = fmap_put(nth(sp, 1), "delete", fun(a) -> js_set(box_get(this), "delete", [a])) in
  let _ = fmap_put(nth(sp, 1), "forEach", fun(f) -> js_set(box_get(this), "forEach", [f])) in
  0
