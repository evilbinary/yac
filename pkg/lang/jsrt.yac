/* jsrt.yac — lang.js runtime helpers (stateless).
 *
 * A program translated by lang.js imports the helpers it needs from here via
 * the `_js_*` names the translator emits, instead of inlining them into every
 * generated source. Only genuinely shared mutable state stays in the generated
 * program (the exception box, `this`, and the prototype registry); everything
 * here is a pure/loop helper over the kernel prims.
 *
 * `_js_str_replace` needs text.str.find, so this package pulls text.str. */

package lang.jsrt
export _js_str, _js_bool, _js_typeof, _js_truth, _js_char_at, _js_upper, _js_lower, _js_repeat,
  _js_arr_slice, _js_arr_index, _js_arr_map, _js_arr_filter, _js_arr_each,
  _js_arr_reduce, _js_arr_join, _js_arr_concat, _js_arr_sort, _js_arr_find,
  _js_arr_findindex, _js_arr_fill, _js_arr_includes, _js_str_replace, _js_isnan, _js_iter,
  _js_arr_lastindex, _js_arr_copywithin
import text.str {find}
import data.fmap { fmap_get }

/* Stringify a JS value for console.log / `+`: int -> decimal, else as-is. */
let _js_str(x) = if is_int(x) then int_to_str(x) else x

/* Boolean -> "true"/"false" (yac's own bool prints as 1/0). */
let _js_bool(x) = if x then "true" else "false"

/* typeof for the dynamic case, using the total `kind` prim:
 *   0 int, 1 nil, 2 cons, 3 str, 4 bytes, 5 listbuf, 6 other, 7 float.
 * Functions are not distinguishable at runtime (they are heap closures), so a
 * dynamic function value still reports "object"; static positions cover the
 * common `typeof f` for a declared function. */
let _js_typeof(x) =
  let k = kind(x) in
  if k == 3 then "string"
  else if k == 7 then "number"
  else if k == 0 then "number"
  else "object"

/* JavaScript truthiness: 0, "", NaN, null/undefined are falsy; everything else
 * (including objects/lists and non-empty strings) is truthy. `kind` lets the
 * string and float cases be told apart; nil/undef are 0. */
let _js_truth(x) =
  let k = kind(x) in
  if k == 3 then str_len(x) > 0
  else if k == 7 then x == x and x != 0.0
  else x != 0

let _js_char_at(s, i) = str_chr(str_ref(s, i))

let _js_upper(s) =
  let n = str_len(s) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(s, i) in
      let c2 = if c >= 97 and c <= 122 then c - 32 else c in
      rec(i + 1, str_cat(acc, str_chr(c2))) in
  rec(0, "")

let _js_lower(s) =
  let n = str_len(s) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let c = str_ref(s, i) in
      let c2 = if c >= 65 and c <= 90 then c + 32 else c in
      rec(i + 1, str_cat(acc, str_chr(c2))) in
  rec(0, "")

let _js_repeat(s, n) =
  let rec(i, acc) = if i >= n then acc else rec(i + 1, str_cat(acc, s)) in
  rec(0, "")

/* Array.slice(a, s, e) -> a new listbuf of a[s..e). */
let _js_arr_slice(a, s, e) =
  let b = list_new() in
  let rec(i) = if i >= e then b else (let _ = list_push(b, nth(a, i)) in rec(i + 1)) in
  if s >= e then b else rec(s)

let _js_arr_index(a, x) =
  let n = len(a) in
  let rec(i) = if i >= n then 0 - 1 else if nth(a, i) == x then i else rec(i + 1) in
  rec(0)

let _js_arr_map(a, f) =
  let r = list_new() in
  let n = len(a) in
  let rec(i) = if i >= n then r else (let _ = list_push(r, f(nth(a, i))) in rec(i + 1)) in
  rec(0)

let _js_arr_filter(a, f) =
  let r = list_new() in
  let n = len(a) in
  let rec(i) =
    if i >= n then r
    else
      let v = nth(a, i) in
      let _ = if f(v) then list_push(r, v) else 0 in
      rec(i + 1) in
  rec(0)

let _js_arr_each(a, f) =
  let n = len(a) in
  let rec(i) = if i >= n then 0 else (let _ = f(nth(a, i)) in rec(i + 1)) in
  rec(0)

let _js_arr_reduce(a, f, init) =
  let n = len(a) in
  let rec(i, acc) = if i >= n then acc else rec(i + 1, f(acc, nth(a, i))) in
  rec(0, init)

let _js_arr_join(a, sep) =
  let n = len(a) in
  let rec(i, acc) =
    if i >= n then acc
    else
      let v = nth(a, i) in
      let s = if is_int(v) then int_to_str(v) else v in
      let acc2 = if i == 0 then s else str_cat(acc, str_cat(sep, s)) in
      rec(i + 1, acc2) in
  rec(0, "")

let _js_arr_concat(a, b) =
  let r = list_new() in
  let na = len(a) in
  let nb = len(b) in
  let rec(ia) = if ia >= na then 0 else (let _ = list_push(r, nth(a, ia)) in rec(ia + 1)) in
  let _ = rec(0) in
  let rec2(ib) = if ib >= nb then 0 else (let _ = list_push(r, nth(b, ib)) in rec2(ib + 1)) in
  let _ = rec2(0) in
  r

/* In-place bubble sort; f(x, y) > 0 means swap. */
let _js_arr_sort(a, f) =
  let n = len(a) in
  let go(pass) =
    if pass >= n then a
    else
      let inr(i) =
        if i >= n - 1 then 0
        else
          let x = nth(a, i) in
          let y = nth(a, i + 1) in
          let _ = if f(x, y) > 0 then (let _ = list_set(a, i, y) in list_set(a, i + 1, x)) else 0 in
          inr(i + 1) in
      let _ = inr(0) in
      go(pass + 1) in
  let _ = go(0) in
  a

/* First literal occurrence of a replaced by b. */
let _js_str_replace(s, a, b) =
  let i = find(s, a) in
  if i < 0 then s
  else str_cat(str_slice(s, 0, i), str_cat(b, str_slice(s, i + str_len(a), str_len(s) - i - str_len(a))))

let _js_isnan(x) = x != x

let _js_arr_find(a, f) =
  let n = len(a) in
  let rec(i) =
    if i >= n then 0
    else
      let v = nth(a, i) in
      if _js_truth(f(v)) then v else rec(i + 1) in
  rec(0)

let _js_arr_findindex(a, f) =
  let n = len(a) in
  let rec(i) =
    if i >= n then 0 - 1
    else if _js_truth(f(nth(a, i))) then i
    else rec(i + 1) in
  rec(0)

let _js_arr_fill(a, v, s, e) =
  let rec(i) = if i >= e then a else (let _ = list_set(a, i, v) in rec(i + 1)) in
  rec(s)

let _js_arr_includes(a, v) =
  let n = len(a) in
  let rec(i) = if i >= n then false else if nth(a, i) == v then true else rec(i + 1) in
  rec(0)

/* for...of normalisation: strings -> char list, Map -> entries, Set -> values,
 * arrays (and anything else) unchanged. */
let _js_str_chars(s) =
  let n = str_len(s) in
  let r = list_new() in
  let rec(i) = if i >= n then r else (let _ = list_push(r, str_chr(str_ref(s, i))) in rec(i + 1)) in
  rec(0)

let _js_iter(x) =
  let k = kind(x) in
  if k == 3 then _js_str_chars(x)
  else if k == 2 or k == 5 then
    (if len(x) > 0 and nth(x, 0) == "$o" then
       (let m = nth(x, 1) in
        (let kd = fmap_get(m, "$kind") in
         (if kd == "Map" or kd == "Set" then
            (let d = fmap_get(m, "$data") in (if d == 0 then list_new() else d))
          else x)))
     else x)
  else x

let _js_arr_lastindex(a, v) =
  let rec(i) = if i < 0 then 0 - 1 else if nth(a, i) == v then i else rec(i - 1) in
  rec(len(a) - 1)

let _js_arr_copywithin(a, target, s, e) =
  let n = e - s in
  let rec(i) =
    if i >= n then a
    else (let _ = list_set(a, target + i, nth(a, s + i)) in rec(i + 1)) in
  rec(0)
