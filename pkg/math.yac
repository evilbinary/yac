/* math.yac — integer helpers plus IEEE f64 (range-reduced, few rec calls). */

package math
export abs, min, max, clamp, sign, gcd, lcm, even, odd, pow, fact,
  isqrt, sqrt, hypot, pi, e, ln2, sin, cos, exp, exp_fast, log, log2, powf, ftoi,
  f64s, fget, fset

let abs(n) = if n < 0 then 0 - n else n

let min(a, b) = if a < b then a else b

let max(a, b) = if a > b then a else b

let clamp(x, lo, hi) =
  if x < lo then lo
  else if x > hi then hi
  else x

let sign(n) =
  if n < 0 then 0 - 1
  else if n == 0 then 0
  else 1

let gcd_go(a, b) =
  if b == 0 then a else gcd_go(b, a % b)

let gcd(a, b) = gcd_go(abs(a), abs(b))

let lcm(a, b) =
  if a == 0 then 0
  else if b == 0 then 0
  else abs(a / gcd(a, b) * b)

let even(n) = n % 2 == 0

let odd(n) = n % 2 != 0

/* Integer power: O(log e) squaring, not e multiplies. */
let pow(b, e) =
  if e < 0 then 0
  else if e == 0 then 1
  else if e % 2 == 0 then
    let h = pow(b, e / 2) in
    h * h
  else b * pow(b, e - 1)

let fact(n) =
  if n <= 1 then 1
  else n * fact(n - 1)

let isqrt_go(n, lo, hi, ans) =
  if lo > hi then ans
  else
    let mid = lo + (hi - lo) / 2 in
    let sq = mid * mid in
    if sq == n then mid
    else if sq < n then isqrt_go(n, mid + 1, hi, mid)
    else isqrt_go(n, lo, mid - 1, ans)

let isqrt(n) =
  if n <= 0 then 0
  else isqrt_go(n, 1, n, 0)

let pi(_) = 3.141592653589793

let e(_) = 2.718281828459045

let ln2(_) = 0.6931471805599453

/* 1/ln2, for exp range reduction. */
let inv_ln2(_) = 1.4426950408889634

/* n 个 IEEE f64，连续 bytes。k=16。 */
let f64s(n) =
  let b = bytes_new() in
  if n <= 0 then b
  else
    let _ = bytes_put(b, n * 8 - 1, 0) in
    b

let fget(b, i) = mem_ref(b, i * 8, 16)

let fset(b, i, x) = mem_put(b, i * 8, 16, x)

/* Grow hi until hi > x; cap so mid*mid in isqrt-like searches stay in int. */
let ftoi_hi(x, h) =
  if h > 1073741823 then h
  else if h * 1.0 > x then h
  else ftoi_hi(x, h + h)

let ftoi_bin(x, lo, hi) =
  if hi - lo <= 1 then
    if hi * 1.0 <= x then hi else lo
  else
    let mid = lo + (hi - lo) / 2 in
    if mid * 1.0 <= x then ftoi_bin(x, mid, hi)
    else ftoi_bin(x, lo, mid)

let ftoi_pos(x) =
  if x < 1.0 then 0
  else ftoi_bin(x, 0, ftoi_hi(x, 1))

let ftoi(x) =
  if x < 0.0 then 0 - ftoi_pos(0.0 - x)
  else ftoi_pos(x)

let iround(x) =
  if x >= 0.0 then ftoi(x + 0.5)
  else 0 - ftoi(0.0 - x + 0.5)

/* 2^n as f64; binary exponentiation. */
let exp2i(n) =
  if n == 0 then 1.0
  else if n > 0 then
    if n % 2 == 0 then
      let h = exp2i(n / 2) in
      h * h
    else 2.0 * exp2i(n - 1)
  else 0.5 * exp2i(n + 1)

/* Horner e^r for |r| ≲ 0.4 after reduction. */
let exp_small(r) =
  1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * 0.001388888888888889)))))

/* Accurate exp: x = k ln2 + r, e^x = 2^k e^r. */
let exp(x) =
  if x > 700.0 then exp(700.0)
  else if x < 0.0 - 700.0 then 0.0
  else
    let k = iround(x * inv_ln2(0)) in
    let r = x - k * ln2(0) in
    exp_small(r) * exp2i(k)

/* Softmax hot path: (1+x/16)^16, four squares. Clamp so it cannot explode. */
let exp_fast(x) =
  if x < 0.0 - 20.0 then 0.0
  else if x > 16.0 then exp_fast(16.0)
  else
    let y = 1.0 + x / 16.0 in
    let y2 = y * y in
    let y4 = y2 * y2 in
    let y8 = y4 * y4 in
    y8 * y8

/* ln(1+u) = u − u²/2 + u³/3 − … ; next term flips sign via −uk·u. */
let log_series(u, k, uk, acc) =
  if k > 8 then acc
  else log_series(u, k + 1, 0.0 - uk * u, acc + uk / (k * 1.0))

let log_at(p) = log_series(p - 1.0, 1, p - 1.0, 0.0)

let log_red(p, k) =
  if p < 0.000000000001 then log_red(0.000000000001, k)
  else if p < 0.7071067811865476 then log_red(p * 2.0, k - 1)
  else if p >= 1.4142135623730951 then log_red(p / 2.0, k + 1)
  else log_at(p) + k * ln2(0)

let log(p) = log_red(p, 0)

let log2(p) = log(p) * inv_ln2(0)

/* a^n for integer n ≥ 0. */
let powf(a, n) =
  if n <= 0 then 1.0
  else if n % 2 == 0 then
    let h = powf(a, n / 2) in
    h * h
  else a * powf(a, n - 1)

/* Five unrolled Newton steps from 1; no 16-deep rec. */
let sqrt(x) =
  if x < 0.0 then 0.0
  else if x == 0.0 then 0.0
  else
    let g1 = 0.5 * (1.0 + x) in
    let g2 = 0.5 * (g1 + x / g1) in
    let g3 = 0.5 * (g2 + x / g2) in
    let g4 = 0.5 * (g3 + x / g3) in
    0.5 * (g4 + x / g4)

let hypot(a, b) = sqrt(a * a + b * b)

let wrap(x, p) =
  if x < 0.0 then wrap(x + p, p)
  else if x >= p then wrap(x - p, p)
  else x

let sin_go(x2, k, term, acc) =
  if k >= 10 then acc
  else
    let den = (2.0 * k) * (2.0 * k + 1.0) in
    let t2 = 0.0 - term * x2 / den in
    sin_go(x2, k + 1, t2, acc + t2)

let sin(x) =
  let y = wrap(x, pi(0) * 2.0) in
  sin_go(y * y, 1, y, y)

let cos_go(x2, k, term, acc) =
  if k >= 10 then acc
  else
    let den = (2.0 * k - 1.0) * (2.0 * k) in
    let t2 = 0.0 - term * x2 / den in
    cos_go(x2, k + 1, t2, acc + t2)

let cos(x) =
  let y = wrap(x, pi(0) * 2.0) in
  cos_go(y * y, 1, 1.0, 1.0)
